    <!-- What a company is to a named one, in the order of RelationRole.typeIndex: owns, merged with, partner of,
         buys advertising space from, anything else. -->
    <string-array name="rel_as_subject">
        <item>Owns %1$s</item>
        <item>Merged with %1$s</item>
        <item>Partner of %1$s</item>
        <item>Buys advertising space from %1$s</item>
        <item>Connected to %1$s</item>
    </string-array>
    <string-array name="rel_as_object">
        <item>Owned by %1$s</item>
        <item>Merged with %1$s</item>
        <item>Partner of %1$s</item>
        <item>Sells advertising space to %1$s</item>
        <item>Connected to %1$s</item>
    </string-array>
    <!-- A documented connection as a sentence: the first company, the verb, the second. -->
    <string-array name="rel_sentence">
        <item>%1$s owns %2$s</item>
        <item>%1$s merged with %2$s</item>
        <item>%1$s is a partner of %2$s</item>
        <item>%1$s buys advertising space from %2$s</item>
        <item>%1$s is connected to %2$s</item>
    </string-array>

    <!-- In the order of CompanyType: advertising, attribution, social, analytics, identity, infrastructure, unknown. -->
