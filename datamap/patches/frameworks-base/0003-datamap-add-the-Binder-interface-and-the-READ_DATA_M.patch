diff --git a/core/java/com/android/internal/datamap/DataMapEntry.aidl b/core/java/com/android/internal/datamap/DataMapEntry.aidl
new file mode 100644
index 0000000..15fb886
--- /dev/null
+++ b/core/java/com/android/internal/datamap/DataMapEntry.aidl
@@ -0,0 +1,24 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.datamap;
+
+/** One service an app contacted, aggregated: when first and last, how often. */
+parcelable DataMapEntry {
+    String packageName;
+    /** The service key: the classifier suffix, a registrable domain, or ip:<address>. */
+    String serviceKey;
+    /** The owner id of the service in the classifier, or an empty string if it is unknown. */
+    String ownerId;
+    /** One of the Category codes: 0 unknown, 1 core, 2 cdn, 3 analytics, 4 advertising,
+        5 attribution, 6 social, 7 identity. */
+    int category;
+    long firstSeenWallMs;
+    long lastSeenWallMs;
+    int count;
+    int foregroundCount;
+    int backgroundCount;
+    /** The service came with a DNS answer for the app. False for a connect to a bare address. */
+    boolean viaDns;
+}
diff --git a/core/java/com/android/internal/datamap/DataMapLink.aidl b/core/java/com/android/internal/datamap/DataMapLink.aidl
new file mode 100644
index 0000000..3d77f45
--- /dev/null
+++ b/core/java/com/android/internal/datamap/DataMapLink.aidl
@@ -0,0 +1,17 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.datamap;
+
+/** Two apps that could be linked, and why. Never "are linked": that is not visible. */
+parcelable DataMapLink {
+    String packageA;
+    String packageB;
+    /** 1: both contacted the same service. 2: different services of the same owner. */
+    int kind;
+    /** Service keys for kind 1, owner ids for kind 2. */
+    String[] evidence;
+    /** Kind 1 only: both contacted a shared service within the same window of each other. */
+    boolean stronger;
+}
