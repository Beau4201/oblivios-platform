diff --git a/core/java/com/android/internal/datamap/DataMapSnapshot.aidl b/core/java/com/android/internal/datamap/DataMapSnapshot.aidl
new file mode 100644
index 0000000..ddb794c
--- /dev/null
+++ b/core/java/com/android/internal/datamap/DataMapSnapshot.aidl
@@ -0,0 +1,27 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.datamap;
+
+import com.android.internal.datamap.DataMapEntry;
+import com.android.internal.datamap.DataMapLink;
+import com.android.internal.datamap.DataMapOwner;
+import com.android.internal.datamap.DataMapPublisher;
+import com.android.internal.datamap.DataMapRelation;
+
+/** Everything the Data Map app draws, for the calling user. */
+parcelable DataMapSnapshot {
+    DataMapEntry[] entries;
+    DataMapOwner[] owners;
+    DataMapRelation[] relations;
+    DataMapPublisher[] publishers;
+    DataMapLink[] links;
+    /** Collecting is on for this user. */
+    boolean collecting;
+    boolean historyOn;
+    int historyDays;
+    /** Names the service refused as not valid host names since the user started. */
+    int invalidCount;
+    long nowWallMs;
+}
diff --git a/core/java/com/android/internal/datamap/IDataMapObserver.aidl b/core/java/com/android/internal/datamap/IDataMapObserver.aidl
new file mode 100644
index 0000000..f117f16
--- /dev/null
+++ b/core/java/com/android/internal/datamap/IDataMapObserver.aidl
@@ -0,0 +1,13 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.datamap;
+
+/**
+ * Tells the Data Map app that there is something new to read. It carries no data: the app calls
+ * getSnapshot.
+ */
+oneway interface IDataMapObserver {
+    void onChanged();
+}
diff --git a/core/java/com/android/internal/datamap/IDataMapService.aidl b/core/java/com/android/internal/datamap/IDataMapService.aidl
new file mode 100644
index 0000000..ed3cb28
--- /dev/null
+++ b/core/java/com/android/internal/datamap/IDataMapService.aidl
@@ -0,0 +1,40 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.datamap;
+
+import com.android.internal.datamap.DataMapSnapshot;
+import com.android.internal.datamap.IDataMapObserver;
+
+/**
+ * The Binder interface of the Data Map service. Every call acts on the calling user; there is no
+ * user argument. Each call needs org.sovereignos.permission.READ_DATA_MAP, which only the Data Map
+ * app holds.
+ *
+ * <p>The transaction order is part of the contract with the app, which compiles its own copy of
+ * this file: new methods are added at the end.
+ */
+interface IDataMapService {
+    /**
+     * The aggregates of the calling user, the owners and publishers they refer to, the documented
+     * relations between owners, and the apps that could be linked.
+     *
+     * @param packages the installed packages the caller wants publishers for (at most 2000).
+     */
+    DataMapSnapshot getSnapshot(in String[] packages);
+
+    /** The observer is told, at most twice a second, that there is something new to read. */
+    void registerObserver(IDataMapObserver observer);
+
+    void unregisterObserver(IDataMapObserver observer);
+
+    /** Names and counts are collected, or not at all. Applies to the calling user. */
+    void setCollecting(boolean collecting);
+
+    /** A history of 1 to 90 days is kept on this phone, encrypted, or none. */
+    void setHistory(boolean enabled, int days);
+
+    /** Deletes everything collected for the calling user, in memory and on disk. */
+    void clear();
+}
