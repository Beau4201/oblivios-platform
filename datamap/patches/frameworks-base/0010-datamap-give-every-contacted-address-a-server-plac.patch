diff --git a/services/core/java/com/android/server/datamap/ServerPlace.java b/services/core/java/com/android/server/datamap/ServerPlace.java
new file mode 100644
index 0000000..4a33ea8
--- /dev/null
+++ b/services/core/java/com/android/server/datamap/ServerPlace.java
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.datamap;
+
+/**
+ * What the Data Map knows about the server that answered, from the address alone (ADR-161): a hosting country and
+ * network operator, a city when the data has one, and whether the address can be placed at all. It says where an
+ * address lies in the data, not where a company is based. The address itself is never kept.
+ */
+final class ServerPlace {
+    /** Nothing is known, or the data does not say. */
+    static final int NONE = 0;
+    /** A city, in a country that two sources agree on. */
+    static final int CITY = 1;
+    /** Only the country is known; the point is the country's anchor. */
+    static final int COUNTRY = 2;
+    /** The two sources name different countries: no place. */
+    static final int UNCERTAIN = 3;
+    /** The address lies in an anycast prefix: it answers from many places, so it has none. */
+    static final int ANYCAST = 4;
+    /** The operator steers by DNS to unicast addresses: the country is that of the registration, not of the edge. */
+    static final int STEERED = 5;
+
+    static final ServerPlace NOTHING = new ServerPlace(NONE, "", "", 0f, 0f, 0, "");
+
+    final int kind;
+    /** Two capital letters, or an empty string. */
+    final String country;
+    final String city;
+    final float lat;
+    final float lon;
+    final int asn;
+    final String operator;
+
+    ServerPlace(int kind, String country, String city, float lat, float lon, int asn, String operator) {
+        this.kind = kind;
+        this.country = country;
+        this.city = city;
+        this.lat = lat;
+        this.lon = lon;
+        this.asn = asn;
+        this.operator = operator;
+    }
+
+    /** Whether the point (lat, lon) is a place to draw. */
+    boolean placed() {
+        return kind == CITY || kind == COUNTRY;
+    }
+
+    /** A value is worth keeping when it says anything at all. */
+    boolean known() {
+        return kind != NONE || asn != 0 || !country.isEmpty();
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!(o instanceof ServerPlace)) {
+            return false;
+        }
+        ServerPlace p = (ServerPlace) o;
+        return kind == p.kind && country.equals(p.country) && city.equals(p.city) && lat == p.lat && lon == p.lon
+                && asn == p.asn && operator.equals(p.operator);
+    }
+
+    @Override
+    public int hashCode() {
+        return ((kind * 31 + country.hashCode()) * 31 + city.hashCode()) * 31 + asn;
+    }
+}
