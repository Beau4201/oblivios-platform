+    private final ByteBuffer mBuf;
+    private final int[] mOff = new int[SECTIONS];
+    private final int[] mLen = new int[SECTIONS];
+
+    /** Maps the file read-only. The mapping outlives the channel; pages are read when a lookup touches them. */
+    static IpMap open(java.io.File file, long maxBytes) throws java.io.IOException, FormatException {
+        try (java.io.RandomAccessFile raf = new java.io.RandomAccessFile(file, "r");
+                java.nio.channels.FileChannel ch = raf.getChannel()) {
+            long size = ch.size();
+            if (size > maxBytes || size > Integer.MAX_VALUE) {
