+    /**
+     * The address of a DNS answer that the server place is looked up from: the first IPv4 address, otherwise the
+     * first address, looking at no more than {@code max}. The city data is IPv4 only (ADR-161, D6). Null when the
+     * answer has none.
+     */
+    static String preferredAddress(String[] addresses, int max) {
+        String first = null;
+        if (addresses == null) {
+            return null;
+        }
+        for (int i = 0; i < addresses.length && i < max; i++) {
+            String a = addresses[i];
+            if (a == null || a.isEmpty()) {
+                continue;
+            }
+            if (a.indexOf(':') < 0) {
+                return a;
+            }
+            if (first == null) {
+                first = a;
+            }
+        }
+        return first;
+    }
