diff --git a/services/core/java/com/android/server/datamap/IpMap.java b/services/core/java/com/android/server/datamap/IpMap.java
new file mode 100644
index 0000000..c93cc8f
--- /dev/null
+++ b/services/core/java/com/android/server/datamap/IpMap.java
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.datamap;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Reads ipmap.bin (the layout is in tools/build-ipmap.py of the datamap package) and says what it knows about an
+ * address: country, operator, city, and whether the address is anycast or steered by DNS (ADR-161). It only reads:
+ * a lookup is a few binary searches over a mapped buffer and allocates one {@link ServerPlace}. It never throws on
+ * input, never resolves a name and never keeps the address.
+ */
+final class IpMap {
+    /** The file is not ours, or damaged. */
+    static final class FormatException extends Exception {
+        private static final long serialVersionUID = 1L;
+
+        FormatException(String message) {
+            super(message);
+        }
+    }
+
+    private static final int CC4 = 0;
+    private static final int ASN4 = 1;
+    private static final int CITY4 = 2;
+    private static final int LOC = 3;
+    private static final int CC6 = 4;
+    private static final int ASN6 = 5;
+    private static final int ORG = 6;
+    private static final int NAMES = 7;
+    private static final int ANY4 = 8;
+    private static final int ANY6 = 9;
+    private static final int STEER = 10;
+    private static final int ANCHOR = 11;
+    private static final int SOURCES = 12;
+    private static final int SECTIONS = 13;
+    /** The record size of each section; 0 where the section is not an array. */
+    private static final int[] STRIDE = {6, 8, 8, 10, 10, 12, 8, 0, 4, 8, 4, 10, 0};
+    private static final int HEADER = 8 + 8 * SECTIONS;
+    private static final long NONE32 = 0xFFFFFFFFL;
+
+    private final ByteBuffer mBuf;
+    private final int[] mOff = new int[SECTIONS];
+    private final int[] mLen = new int[SECTIONS];
+
+    /** Maps the file read-only. The mapping outlives the channel; pages are read when a lookup touches them. */
+    static IpMap open(java.io.File file, long maxBytes) throws java.io.IOException, FormatException {
+        try (java.io.RandomAccessFile raf = new java.io.RandomAccessFile(file, "r");
+                java.nio.channels.FileChannel ch = raf.getChannel()) {
+            long size = ch.size();
+            if (size > maxBytes || size > Integer.MAX_VALUE) {
+                throw new FormatException("file too large");
+            }
+            return new IpMap(ch.map(java.nio.channels.FileChannel.MapMode.READ_ONLY, 0, size));
+        }
+    }
+
+    IpMap(ByteBuffer buffer) throws FormatException {
+        mBuf = buffer.duplicate();
+        mBuf.order(java.nio.ByteOrder.BIG_ENDIAN);
+        int size = mBuf.limit();
+        if (size < HEADER || mBuf.get(0) != 'D' || mBuf.get(1) != 'M' || mBuf.get(2) != 'I' || mBuf.get(3) != 'P'
+                || mBuf.getShort(4) != 1) {
+            throw new FormatException("not an ipmap file");
+        }
+        long end = HEADER;
+        for (int i = 0; i < SECTIONS; i++) {
+            long off = mBuf.getInt(8 + 8 * i) & 0xFFFFFFFFL;
+            long len = mBuf.getInt(12 + 8 * i) & 0xFFFFFFFFL;
+            if (off != end || off + len > size || (STRIDE[i] != 0 && len % STRIDE[i] != 0)) {
+                throw new FormatException("section " + i + " is out of place");
+            }
+            mOff[i] = (int) off;
+            mLen[i] = (int) len;
+            end = off + len;
+        }
+        if (end != size) {
+            throw new FormatException("bytes after the last section");
+        }
+    }
+
+    /** What the file was made from, as written by the build tool. */
+    String sources() {
+        byte[] b = new byte[mLen[SOURCES]];
+        for (int i = 0; i < b.length; i++) {
+            b[i] = mBuf.get(mOff[SOURCES] + i);
+        }
+        return new String(b, StandardCharsets.UTF_8);
+    }
+
+    /** @return what is known about the address, or null when {@code text} is not an IP address literal */
+    ServerPlace lookup(String text) {
+        long[] a = parse(text);
+        if (a == null) {
+            return null;
+        }
+        int cc;
+        int asn;
+        long loc = NONE32;
+        boolean anycast;
+        if (a[0] == 4) {
+            long n = a[1];
+            cc = (int) value32(CC4, 6, n, 2);
+            asn = (int) value32(ASN4, 8, n, 4);
+            loc = value32(CITY4, 8, n, 4);
+            anycast = member32(ANY4, n >>> 8);
+        } else {
+            long hi = a[1];
+            cc = (int) value64(CC6, 10, hi, 2);
+            asn = (int) value64(ASN6, 12, hi, 4);
+            anycast = member64(ANY6, hi >>> 16);
+        }
+        String operator = asn == 0 ? "" : org(asn);
+        String country = unpackCc(cc);
+        if (anycast) {
+            return new ServerPlace(ServerPlace.ANYCAST, country, "", 0f, 0f, asn, operator);
+        }
+        if (asn != 0 && member32(STEER, asn & 0xFFFFFFFFL)) {
+            return new ServerPlace(ServerPlace.STEERED, country, "", 0f, 0f, asn, operator);
+        }
+        if (loc != NONE32) {
+            if (loc * 10 + 10 > mLen[LOC]) {
+                return ServerPlace.NOTHING;
+            }
+            int at = mOff[LOC] + (int) loc * 10;
+            int lcc = mBuf.getShort(at) & 0xFFFF;
+            if (cc == 0 || lcc == cc) {
+                return new ServerPlace(ServerPlace.CITY, unpackCc(lcc), name(mBuf.getInt(at + 6) & 0xFFFFFFFFL),
+                        mBuf.getShort(at + 2) / 100f, mBuf.getShort(at + 4) / 100f, asn, operator);
+            }
+            return new ServerPlace(ServerPlace.UNCERTAIN, country, "", 0f, 0f, asn, operator);
+        }
+        if (cc == 0) {
+            return new ServerPlace(ServerPlace.NONE, "", "", 0f, 0f, asn, operator);
+        }
+        int n = mLen[ANCHOR] / 10;
+        int lo = 0;
+        int hi = n - 1;
+        while (lo <= hi) {
+            int mid = (lo + hi) >>> 1;
+            int at = mOff[ANCHOR] + mid * 10;
+            int k = mBuf.getShort(at) & 0xFFFF;
+            if (k == cc) {
+                return new ServerPlace(ServerPlace.COUNTRY, country, "", mBuf.getShort(at + 2) / 100f,
+                        mBuf.getShort(at + 4) / 100f, asn, operator);
+            }
+            if (k < cc) {
+                lo = mid + 1;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        return new ServerPlace(ServerPlace.NONE, country, "", 0f, 0f, asn, operator);
+    }
+
+    // -------------------------------------------------------------------------------------- the file
+
+    /** The value of the last record whose start is not after {@code key}, or 0 before the first. */
+    private long value32(int sec, int stride, long key, int width) {
+        int i = floor32(sec, stride, key);
+        return i < 0 ? (width == 4 && sec == CITY4 ? NONE32 : 0) : readValue(mOff[sec] + i * stride + 4, width);
+    }
+
+    private long value64(int sec, int stride, long key, int width) {
+        int n = mLen[sec] / stride;
+        int lo = 0;
+        int hi = n - 1;
+        int best = -1;
+        while (lo <= hi) {
+            int mid = (lo + hi) >>> 1;
+            if (Long.compareUnsigned(mBuf.getLong(mOff[sec] + mid * stride), key) <= 0) {
+                best = mid;
+                lo = mid + 1;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        return best < 0 ? 0 : readValue(mOff[sec] + best * stride + 8, width);
+    }
+
+    private long readValue(int at, int width) {
+        return width == 2 ? mBuf.getShort(at) & 0xFFFFL : mBuf.getInt(at) & 0xFFFFFFFFL;
+    }
+
+    private int floor32(int sec, int stride, long key) {
+        int n = mLen[sec] / stride;
+        int lo = 0;
+        int hi = n - 1;
+        int best = -1;
+        while (lo <= hi) {
+            int mid = (lo + hi) >>> 1;
+            if ((mBuf.getInt(mOff[sec] + mid * stride) & 0xFFFFFFFFL) <= key) {
+                best = mid;
+                lo = mid + 1;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        return best;
+    }
+
+    private boolean member32(int sec, long key) {
+        int i = floor32(sec, 4, key);
+        return i >= 0 && (mBuf.getInt(mOff[sec] + i * 4) & 0xFFFFFFFFL) == key;
+    }
+
+    private boolean member64(int sec, long key) {
+        int n = mLen[sec] / 8;
+        int lo = 0;
+        int hi = n - 1;
+        while (lo <= hi) {
+            int mid = (lo + hi) >>> 1;
+            int c = Long.compareUnsigned(mBuf.getLong(mOff[sec] + mid * 8), key);
+            if (c == 0) {
+                return true;
+            }
+            if (c < 0) {
+                lo = mid + 1;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        return false;
+    }
+
+    private String org(int asn) {
+        long key = asn & 0xFFFFFFFFL;
+        int i = floor32(ORG, 8, key);
+        if (i < 0 || (mBuf.getInt(mOff[ORG] + i * 8) & 0xFFFFFFFFL) != key) {
+            return "";
+        }
+        return name(mBuf.getInt(mOff[ORG] + i * 8 + 4) & 0xFFFFFFFFL);
+    }
+
+    private String name(long offset) {
+        if (offset >= mLen[NAMES]) {
+            return "";
+        }
+        int at = mOff[NAMES] + (int) offset;
+        int n = mBuf.get(at) & 0xFF;
+        if (offset + 1 + n > mLen[NAMES]) {
+            return "";
+        }
+        byte[] b = new byte[n];
+        for (int i = 0; i < n; i++) {
+            b[i] = mBuf.get(at + 1 + i);
+        }
+        return new String(b, StandardCharsets.UTF_8);
+    }
+
+    private static String unpackCc(int v) {
+        return v == 0 ? "" : "" + (char) (v >> 8) + (char) (v & 0xFF);
+    }
+
+    // ------------------------------------------------------------------------------------- the address
+
+    /**
+     * @return {4, address} or {6, first 64 bits}, or null for anything that is not an IP address literal. An IPv4-mapped
+     *         IPv6 address is an IPv4 address. No name is ever resolved.
+     */
+    static long[] parse(String text) {
+        if (text == null || text.isEmpty() || text.length() > 64) {
+            return null;
+        }
+        String s = text;
+        int zone = s.indexOf('%');
+        if (zone >= 0) {
+            s = s.substring(0, zone);
+        }
+        if (s.indexOf(':') < 0) {
+            long v4 = parse4(s);
+            return v4 < 0 ? null : new long[] {4, v4};
+        }
+        int[] g = parse6(s);
+        if (g == null) {
+            return null;
+        }
+        if (g[0] == 0 && g[1] == 0 && g[2] == 0 && g[3] == 0 && g[4] == 0 && g[5] == 0xFFFF) {
+            return new long[] {4, ((long) g[6] << 16) | g[7]};
+        }
+        long hi = ((long) g[0] << 48) | ((long) g[1] << 32) | ((long) g[2] << 16) | g[3];
+        return new long[] {6, hi};
+    }
+
+    private static long parse4(String s) {
+        String[] p = s.split("\\.", -1);
+        if (p.length != 4) {
+            return -1;
+        }
+        long v = 0;
+        for (String part : p) {
+            if (part.isEmpty() || part.length() > 3 || (part.length() > 1 && part.charAt(0) == '0')) {
+                return -1;
+            }
+            int n = 0;
+            for (int i = 0; i < part.length(); i++) {
+                char c = part.charAt(i);
+                if (c < '0' || c > '9') {
+                    return -1;
+                }
+                n = n * 10 + (c - '0');
+            }
+            if (n > 255) {
+                return -1;
+            }
+            v = (v << 8) | n;
+        }
+        return v;
+    }
+
+    private static int[] parse6(String s) {
+        int dbl = s.indexOf("::");
+        if (dbl >= 0 && s.indexOf("::", dbl + 1) >= 0) {
+            return null;
+        }
+        String head = dbl >= 0 ? s.substring(0, dbl) : s;
+        String tail = dbl >= 0 ? s.substring(dbl + 2) : "";
+        int[] a = groups(head, dbl < 0);
+        int[] b = dbl >= 0 ? groups(tail, true) : new int[0];
+        if (a == null || b == null) {
+            return null;
+        }
+        int total = a.length + b.length;
+        if (dbl < 0 ? total != 8 : total > 7) {
+            return null;
+        }
+        int[] out = new int[8];
+        System.arraycopy(a, 0, out, 0, a.length);
+        System.arraycopy(b, 0, out, 8 - b.length, b.length);
+        return out;
+    }
+
+    /** The groups of one side of the address; the last may be a dotted IPv4 when {@code allowTail4}. */
+    private static int[] groups(String s, boolean allowTail4) {
+        if (s.isEmpty()) {
+            return new int[0];
+        }
+        String[] p = s.split(":", -1);
+        int[] out = new int[p.length + 1];
+        int n = 0;
+        for (int i = 0; i < p.length; i++) {
+            String part = p[i];
+            if (part.indexOf('.') >= 0) {
+                long v4 = i == p.length - 1 ? parse4(part) : -1;
+                if (v4 < 0 || !allowTail4) {
+                    return null;
+                }
+                out[n++] = (int) (v4 >>> 16);
+                out[n++] = (int) (v4 & 0xFFFF);
+                continue;
+            }
+            if (part.isEmpty() || part.length() > 4) {
+                return null;
+            }
+            int v = 0;
+            for (int k = 0; k < part.length(); k++) {
+                int d = Character.digit(part.charAt(k), 16);
+                if (d < 0) {
+                    return null;
+                }
+                v = (v << 4) | d;
+            }
+            out[n++] = v;
+        }
+        int[] r = new int[n];
+        System.arraycopy(out, 0, r, 0, n);
+        return r;
+    }
+}
