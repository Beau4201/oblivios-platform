+    @Override
+    public void setServerHistory(boolean enabled) {
+        int user = enforceCaller();
+        UserSettings next = mSettings.compute(user, (k, cur) ->
+                (cur == null ? UserSettings.defaults() : cur).withServerHistory(enabled));
+        mHistoryGeneration.incrementAndGet();
+        // the choice needs the history (UserSettings.withServerHistory): with the history off it stays off and nothing is written
+        final boolean keep = next.serverHistory;
+        if (keep) {
+            mPurgePlaces.remove(user);
+        } else {
+            mPurgePlaces.add(user);   // until a write has taken the places out of the file
+        }
+        mHandler.post(() -> {
+            if (!saveServerHistory(user, keep)) {
+                Slog.w(TAG, "the choice to keep server places is not saved");
+            }
+            if (next.history) {
+                writeHistory(user);   // writes the file again, with the places or without them
+            } else {
+                mPurgePlaces.remove(user);   // no history, no file
+            }
+        });
+    }
