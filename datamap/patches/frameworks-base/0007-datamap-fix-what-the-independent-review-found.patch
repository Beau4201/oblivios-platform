+    /**
+     * What the store keeps for a contact: a name as its service key, so that a random label does not
+     * make a new entry; an address key as it is.
+     */
+    static String storageKey(String key, boolean viaDns, Classifier classifier) {
+        return viaDns ? keyFor(key, classifier) : key;
+    }
+
+    /**
+     * An IPv4 address as netd reports it for a Java socket (always an IPv6 socket) is
+     * {@code ::ffff:a.b.c.d}; the DNS answer for the same address is {@code a.b.c.d}. Both give the
+     * same text here. Anything else is only lower-cased.
+     */
+    static String normalizeIp(String ip) {
+        String s = ip.toLowerCase(java.util.Locale.ROOT);
+        if (s.startsWith("::ffff:")) {
+            String v4 = s.substring(7);
+            int dots = 0;
+            boolean ok = !v4.isEmpty();
+            for (int i = 0; i < v4.length() && ok; i++) {
+                char c = v4.charAt(i);
+                if (c == '.') {
+                    dots++;
+                } else if (c < '0' || c > '9') {
+                    ok = false;
+                }
+            }
+            if (ok && dots == 3) {
+                return v4;
+            }
+        }
+        return s;
+    }
+
