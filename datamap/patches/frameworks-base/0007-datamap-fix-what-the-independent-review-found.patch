+    /**
+     * The reply to the app is bounded (a Binder transaction is about 1 MB): when there are more rows
+     * than {@code max}, the ones seen most recently are kept, in their order.
+     */
+    static List<Row> newest(List<Row> rows, int max) {
+        if (rows.size() <= max) {
+            return rows;
+        }
+        List<Row> byLast = new ArrayList<>(rows);
+        Collections.sort(byLast, new Comparator<Row>() {
+            @Override
+            public int compare(Row a, Row b) {
+                return Long.compare(b.lastWall, a.lastWall);
+            }
+        });
+        java.util.Set<Row> keep = Collections.newSetFromMap(new java.util.IdentityHashMap<Row, Boolean>());
+        keep.addAll(byLast.subList(0, max));
+        List<Row> out = new ArrayList<>(max);
+        for (Row r : rows) {
+            if (keep.contains(r)) {
+                out.add(r);
+            }
+        }
+        return out;
+    }
