-        return map.get(uid + "|" + ip);
+        LinkedHashMap<String, String> m = byUid.get(uid);
+        return m == null ? null : m.get(ServiceKeys.normalizeIp(ip));
+    }
+
+    /** Forgets every answer of the apps of one user. */
+    synchronized void clearUser(int userId) {
+        Iterator<Map.Entry<Integer, LinkedHashMap<String, String>>> it = byUid.entrySet().iterator();
+        while (it.hasNext()) {
+            if (it.next().getKey() / 100000 == userId) {
