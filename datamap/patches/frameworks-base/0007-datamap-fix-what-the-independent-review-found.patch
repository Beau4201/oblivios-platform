     }
 
     synchronized void put(int uid, String ip, String host) {
-        map.put(uid + "|" + ip, host);
+        LinkedHashMap<String, String> m = byUid.get(uid);
+        if (m == null) {
+            m = new LinkedHashMap<>(16, 0.75f, true);
+            byUid.put(uid, m);
+        }
+        m.put(ServiceKeys.normalizeIp(ip), host);
+        if (m.size() > maxPerUid) {
+            Iterator<String> it = m.keySet().iterator();
+            it.next();
+            it.remove();
