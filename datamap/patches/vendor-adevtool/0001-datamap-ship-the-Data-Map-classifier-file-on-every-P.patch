From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@oblivios.local>
Date: Sun, 11 Oct 2026 15:35:45 +0200
Subject: [PATCH] datamap: ship the Data Map classifier file on every Pixel
 target via device-common.mk

---
 config/mk/google_devices/common/device-common.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -99,3 +99,9 @@ PRODUCT_PACKAGES_DEBUG += \
 # 55% of the time and 100% never, at the same physical zram (docs/research/
 # stallion-memory-pressure-investigation.md, "Zram capacity").
 PRODUCT_PRODUCT_PROPERTIES += mmd.zram.size=100%
+
+# ObliviOS Data Map (ADR-157): the read-only classifier file that the Data Map service reads from
+# /system/etc/datamap. The module is defined in vendor/oblivios/datamap. Kept in the common file like AirPods, so every
+# Pixel target carries it.
+PRODUCT_PACKAGES += \
+    datamap-classifier.tsv
