From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@oblivios.local>
Date: Sun, 11 Oct 2026 18:52:44 +0200
Subject: [PATCH] datamap: ship DataMapApp on every Pixel target via
 device-common.mk

---
 config/mk/google_devices/common/device-common.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -105,3 +105,8 @@ PRODUCT_PRODUCT_PROPERTIES += mmd.zram.size=100%
 # Pixel target carries it.
 PRODUCT_PACKAGES += \
     datamap-classifier.tsv
+
+# ObliviOS Data Map (ADR-157): the app that shows the data. It is privileged and holds
+# READ_DATA_MAP; DataMapApp pulls in its privapp-permissions and sysconfig files itself ("required").
+PRODUCT_PACKAGES += \
+    DataMapApp
