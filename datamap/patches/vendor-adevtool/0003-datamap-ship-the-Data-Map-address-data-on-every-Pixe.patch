From 8a3f55a02c090a03dde213c8e8fd346ab3117150 Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@oblivios.local>
Date: Tue, 13 Oct 2026 17:29:24 +0200
Subject: [PATCH] datamap: ship the Data Map address data on every Pixel target
 via device-common.mk

---
 config/mk/google_devices/common/device-common.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
index 1992526..f26b070 100644
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -111,6 +111,11 @@ PRODUCT_PRODUCT_PROPERTIES += mmd.zram.size=100%
 PRODUCT_PACKAGES += \
     datamap-classifier.tsv
 
+# ObliviOS Data Map (ADR-161): the read-only address data that gives a contacted address a hosting country, a city and
+# an operator, read by the Data Map service from /system/etc/datamap. The module is defined in vendor/oblivios/datamap.
+PRODUCT_PACKAGES += \
+    datamap-ipmap.bin
+
 # ObliviOS Data Map (ADR-157): the app that shows the data. It is privileged and holds
 # READ_DATA_MAP; DataMapApp pulls in its privapp-permissions and sysconfig files itself ("required").
 PRODUCT_PACKAGES += \
-- 
2.56.0

