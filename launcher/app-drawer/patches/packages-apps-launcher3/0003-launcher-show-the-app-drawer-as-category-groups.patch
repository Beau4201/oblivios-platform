+        }
+        int category = ApplicationInfo.CATEGORY_UNDEFINED;
+        try {
+            LauncherApps launcherApps =
+                    mActivityContext.asContext().getSystemService(LauncherApps.class);
+            category = launcherApps.getApplicationInfo(info.getTargetPackage(), 0, info.user)
+                    .category;
+        } catch (PackageManager.NameNotFoundException e) {
+            Log.d(TAG, "No application info for " + info.getTargetPackage());
+        }
+        if (category != ApplicationInfo.CATEGORY_UNDEFINED) {
+            mCategoryCache.put(key, category);
+        }
+        return category;
+    }
