+package com.android.launcher3.allapps.category
+
+import android.content.Context
+import com.android.launcher3.R
+import com.android.launcher3.allapps.BaseAllAppsAdapter
+import com.android.launcher3.model.data.AppInfo
+import java.text.Collator
+
+/** The adapter item of one drawer group: a container with the group's apps. */
+class CategoryGroupItem(val group: AppGroup, val title: String, val apps: List<AppInfo>) :
+    BaseAllAppsAdapter.AdapterItem(BaseAllAppsAdapter.VIEW_TYPE_CATEGORY_GROUP) {
+
+    override fun isSameAs(other: BaseAllAppsAdapter.AdapterItem?): Boolean =
+        other is CategoryGroupItem && other.group == group
+
+    override fun isContentSame(other: BaseAllAppsAdapter.AdapterItem): Boolean =
+        other is CategoryGroupItem &&
+            other.title == title &&
+            other.apps.size == apps.size &&
+            apps.indices.all {
+                apps[it].componentName == other.apps[it].componentName &&
+                    apps[it].user == other.apps[it].user
+            }
+}
+
+/** Builds the drawer group items: grouping, localized titles, cards sorted by title, Other last. */
+object CategoryGroups {
+
+    @JvmStatic
+    fun titleRes(group: AppGroup): Int =
+        when (group) {
+            AppGroup.GAMES -> R.string.topic_category_games
+            AppGroup.MEDIA -> R.string.app_group_media
+            AppGroup.SOCIAL -> R.string.topic_category_social
+            AppGroup.NEWS -> R.string.topic_category_news
+            AppGroup.MAPS -> R.string.topic_category_maps
+            AppGroup.PRODUCTIVITY -> R.string.topic_category_productivity
+            AppGroup.ACCESSIBILITY -> R.string.topic_category_accessibility
+            AppGroup.OTHER -> R.string.topic_category_other
+        }
+
+    @JvmStatic
+    fun build(
+        context: Context,
+        apps: List<AppInfo>,
+        categoryOf: (AppInfo) -> Int,
+    ): List<CategoryGroupItem> {
+        val collator = Collator.getInstance(context.resources.configuration.locales[0])
+        return AppGrouper.group(apps, categoryOf) { it.targetPackage.orEmpty() }
+            .map { CategoryGroupItem(it.group, context.getString(titleRes(it.group)), it.apps) }
+            .sortedWith(
+                compareBy<CategoryGroupItem> { it.group == AppGroup.OTHER }
+                    .thenComparator { a, b -> collator.compare(a.title, b.title) }
+            )
+    }
+}
