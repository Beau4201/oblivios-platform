+package com.android.launcher3.allapps.category
+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.Color
+import android.graphics.Rect
+import android.graphics.RenderEffect
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.graphics.drawable.ColorDrawable
+import android.graphics.drawable.GradientDrawable
+import android.util.AttributeSet
+import android.util.Pair
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.LayoutInflater
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewGroup
+import android.view.ViewParent
+import android.view.ViewTreeObserver
+import android.view.animation.AnimationUtils
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import com.android.launcher3.AbstractFloatingView
+import com.android.launcher3.BubbleTextView
+import com.android.launcher3.R
+import com.android.launcher3.allapps.ActivityAllAppsContainerView
+import com.android.launcher3.util.Themes
+import com.android.launcher3.views.BaseDragLayer
+import kotlin.math.min
+
+/**
+ * The opened drawer group: a frosted card in the middle of the display over a blurred, dimmed
+ * drawer. It grows out of the tapped container and back with the stock folder timing (200 ms,
+ * Material standard curve). Tap outside, back and home close it.
+ */
+class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
+    AbstractFloatingView(context, attrs) {
+
+    private val scrim = ColorDrawable(Color.BLACK).apply { alpha = 0 }
+    private val card = CardLayout(context)
+    private val titleView = TextView(context)
+    private val scroll = ScrollView(context)
+    private val rows = LinearLayout(context)
+    private val origin = Rect()
+    private var backdrop: View? = null
+    private var animator: ValueAnimator? = null
+    private var progress = 0f
+
+    init {
+        gravity = Gravity.CENTER
+        background = scrim
+        val res = resources
+        val surface = Themes.getAttrColor(context, R.attr.allAppsSurfaceHighest)
+        val text = Themes.getAttrColor(context, android.R.attr.textColorPrimary)
+        val pad = res.getDimensionPixelSize(R.dimen.app_group_sheet_padding)
+        card.id = R.id.category_group_card
+        card.orientation = LinearLayout.VERTICAL
+        card.setPadding(pad, pad, pad, pad)
+        card.background =
+            GradientDrawable(
+                    GradientDrawable.Orientation.TL_BR,
+                    intArrayOf(withAlpha(surface, 0xE0), withAlpha(surface, 0xB0), withAlpha(surface, 0xD0)),
+                )
+                .apply {
+                    cornerRadius = res.getDimension(R.dimen.app_group_sheet_radius)
+                    setStroke(res.getDimensionPixelSize(R.dimen.app_group_sheet_stroke), withAlpha(text, 0x30))
+                }
+        card.elevation = res.getDimension(R.dimen.app_group_sheet_elevation)
+        titleView.apply {
+            gravity = Gravity.CENTER
+            typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
+            setTextSize(TypedValue.COMPLEX_UNIT_PX, res.getDimension(R.dimen.app_group_sheet_title_size))
+            setTextColor(text)
+            setPadding(0, res.getDimensionPixelSize(R.dimen.app_group_sheet_title_padding), 0,
+                res.getDimensionPixelSize(R.dimen.app_group_sheet_title_padding))
+        }
+        rows.orientation = LinearLayout.VERTICAL
+        scroll.isVerticalScrollBarEnabled = false
+        scroll.addView(rows)
+        card.addView(titleView, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        card.addView(scroll, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        val metrics = res.displayMetrics
+        val cardWidth =
+            min(
+                metrics.widthPixels - 2 * res.getDimensionPixelSize(R.dimen.app_group_sheet_margin),
+                res.getDimensionPixelSize(R.dimen.app_group_sheet_max_width),
+            )
+        addView(card, LayoutParams(cardWidth, LayoutParams.WRAP_CONTENT))
+    }
+
+    private fun bind(source: CategoryGroupView, item: CategoryGroupItem, backdrop: View?) {
+        this.backdrop = backdrop
+        titleView.text = item.title
+        val cardWidth = card.layoutParams.width - card.paddingLeft - card.paddingRight
+        val cellWidth = cardWidth / COLUMNS
+        val cellHeight = resources.getDimensionPixelSize(R.dimen.app_group_sheet_cell_height)
+        val inflater = LayoutInflater.from(context)
+        item.apps.chunked(COLUMNS).forEach { chunk ->
+            val row = LinearLayout(context)
+            row.gravity = Gravity.CENTER_HORIZONTAL
+            chunk.forEach { app ->
+                val icon = inflater.inflate(R.layout.category_group_icon, row, false) as BubbleTextView
+                icon.reset()
+                icon.applyFromApplicationInfo(app)
+                icon.setOnClickListener(closingAfter(source.iconClickListener()))
+                icon.setOnLongClickListener(source.iconLongClickListener())
+                icon.customActionsListener = source.customActionsListener()
+                row.addView(icon, LinearLayout.LayoutParams(cellWidth, cellHeight))
+            }
+            rows.addView(row, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        }
+    }
+
+    /** Runs [click] (it starts the app) and then closes the group without an animation. */
+    private fun closingAfter(click: OnClickListener?) =
+        OnClickListener { v ->
+            click?.onClick(v)
+            close(false)
+        }
+
+    private fun startOpen() {
+        mIsOpen = true
+        viewTreeObserver.addOnPreDrawListener(
+            object : ViewTreeObserver.OnPreDrawListener {
+                override fun onPreDraw(): Boolean {
+                    viewTreeObserver.removeOnPreDrawListener(this)
+                    apply(0f)
+                    animateTo(1f) {}
+                    return true
+                }
+            }
+        )
+    }
+
+    /** [p] is 0 when the card is the tapped container and 1 when it is fully open. */
+    private fun apply(p: Float) {
+        progress = p
+        scrim.alpha = (SCRIM_ALPHA * p).toInt()
+        val cardWidth = card.width.toFloat()
+        val cardHeight = card.height.toFloat()
+        if (cardWidth > 0f && cardHeight > 0f) {
+            card.pivotX = cardWidth / 2f
+            card.pivotY = cardHeight / 2f
+            card.scaleX = lerp(origin.width() / cardWidth, 1f, p)
+            card.scaleY = lerp(origin.height() / cardHeight, 1f, p)
+            card.translationX = lerp(origin.exactCenterX() - (card.left + cardWidth / 2f), 0f, p)
+            card.translationY = lerp(origin.exactCenterY() - (card.top + cardHeight / 2f), 0f, p)
+        }
+        card.alpha = min(1f, p * 3f)
+        val content = ((p - 0.3f) / 0.7f).coerceIn(0f, 1f)
+        titleView.alpha = content
+        scroll.alpha = content
+        val radius = resources.getDimension(R.dimen.app_group_sheet_blur) * p
+        backdrop?.setRenderEffect(
+            if (radius < 1f) null
+            else RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP)
+        )
+    }
+
+    private fun animateTo(target: Float, onDone: () -> Unit) {
+        animator?.cancel()
+        val a = ValueAnimator.ofFloat(progress, target)
+        a.duration = resources.getInteger(R.integer.config_materialFolderExpandDuration).toLong()
+        a.interpolator = AnimationUtils.loadInterpolator(context, R.interpolator.standard_interpolator)
+        a.addUpdateListener { apply(it.animatedValue as Float) }
+        a.addListener(
+            object : AnimatorListenerAdapter() {
+                private var cancelled = false
+
+                override fun onAnimationCancel(animation: Animator) {
+                    cancelled = true
+                }
+
+                override fun onAnimationEnd(animation: Animator) {
+                    if (!cancelled) onDone()
+                }
+            }
+        )
+        animator = a
+        a.start()
+    }
+
+    override fun handleClose(animate: Boolean) {
+        mIsOpen = false
+        if (animate) {
+            animateTo(0f) { finish() }
+        } else {
+            animator?.cancel()
+            finish()
+        }
+    }
+
+    private fun finish() {
+        backdrop?.setRenderEffect(null)
+        (parent as? ViewGroup)?.removeView(this)
+    }
+
+    override fun isOfType(type: Int): Boolean = (type and TYPE_CATEGORY_GROUP) != 0
+
+    override fun getAccessibilityTarget(): Pair<View, String>? =
+        Pair.create(card, titleView.text.toString())
+
+    override fun onControllerInterceptTouchEvent(ev: MotionEvent): Boolean {
+        if (ev.action == MotionEvent.ACTION_DOWN) {
+            val dragLayer = parent as? BaseDragLayer<*> ?: return false
+            if (!dragLayer.isEventOverView(card, ev)) {
+                close(true)
+                return true
+            }
+        }
+        return false
+    }
+
+    /** Caps the card at 80 % of the display height; the apps scroll inside the card. */
+    private class CardLayout(context: Context) : LinearLayout(context) {
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            val max = (resources.displayMetrics.heightPixels * MAX_HEIGHT_FRACTION).toInt()
+            super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(max, MeasureSpec.AT_MOST))
+        }
+    }
+
+    companion object {
+        private const val COLUMNS = 3
+        private const val SCRIM_ALPHA = 115 // about 45 %
+        private const val MAX_HEIGHT_FRACTION = 0.8f
+
+        private fun lerp(a: Float, b: Float, t: Float) = a + (b - a) * t
+
+        private fun withAlpha(color: Int, alpha: Int) = (color and 0x00FFFFFF) or (alpha shl 24)
+
+        /** Opens the group of [item] over the drawer that holds [source]. */
+        @JvmStatic
+        fun show(source: CategoryGroupView, item: CategoryGroupItem) {
+            val ancestors = generateSequence<ViewParent>(source.parent) { (it as? View)?.parent }
+            val dragLayer = ancestors.filterIsInstance<BaseDragLayer<*>>().firstOrNull() ?: return
+            val sheet = CategoryGroupSheet(source.context, null)
+            sheet.bind(source, item, ancestors.filterIsInstance<ActivityAllAppsContainerView<*>>().firstOrNull())
+            dragLayer.getDescendantRectRelativeToSelf(source.blockView, sheet.origin)
+            dragLayer.addView(
+                sheet,
+                BaseDragLayer.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT).apply {
+                    ignoreInsets = true
+                },
+            )
+            sheet.startOpen()
+        }
+    }
+}
