From b0ce8fe2691445f0620d061e1959a0e85694771a Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 11 Oct 2026 03:47:51 +0200
Subject: [PATCH 12/12] launcher: close the opened drawer group when an icon is
 dragged out

The card stayed open over the home screen after a drag started from one of
its icons. It now listens for the start of a drag and closes, as the stock
icon menu does, and its view is removed when the drag ends.
---
 .../allapps/category/CategoryGroupSheet.kt    | 26 ++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt b/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt
index 64fbb6d50e..3f1d2352e2 100644
--- a/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt
+++ b/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt
@@ -43,8 +43,12 @@ import android.widget.ScrollView
 import android.widget.TextView
 import com.android.launcher3.AbstractFloatingView
 import com.android.launcher3.BubbleTextView
+import com.android.launcher3.DropTarget
+import com.android.launcher3.Launcher
 import com.android.launcher3.R
 import com.android.launcher3.allapps.ActivityAllAppsContainerView
+import com.android.launcher3.dragndrop.DragController
+import com.android.launcher3.dragndrop.DragOptions
 import com.android.launcher3.util.Themes
 import com.android.launcher3.views.BaseDragLayer
 import kotlin.math.min
@@ -72,6 +76,24 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
     // would start one of them.
     private var interactive = false
 
+    // sovereignos: an icon dragged out of the card closes it, as the stock icon menu does (the card
+    // otherwise stayed over the home screen). Its view stays until the drag ends, as the menu's
+    // does: removing it in the middle of the gesture interferes with the touch events.
+    private var dragging = false
+    private val dragListener =
+        object : DragController.DragListener {
+            override fun onDragStart(dragObject: DropTarget.DragObject, options: DragOptions) {
+                dragging = true
+                // The event may come more than once per drag session.
+                if (mIsOpen) close(true)
+            }
+
+            override fun onDragEnd() {
+                dragging = false
+                if (!mIsOpen) (parent as? ViewGroup)?.removeView(this@CategoryGroupSheet)
+            }
+        }
+
     init {
         gravity = Gravity.CENTER
         background = scrim
@@ -245,6 +267,7 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
         // Removed in any way other than finish(): leave no animation and no blur behind.
         animator?.cancel()
         backdrop?.setRenderEffect(null)
+        Launcher.getLauncher(context).dragController?.removeDragListener(dragListener)
         super.onDetachedFromWindow()
     }
 
@@ -261,7 +284,7 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
 
     private fun finish() {
         backdrop?.setRenderEffect(null)
-        (parent as? ViewGroup)?.removeView(this)
+        if (!dragging) (parent as? ViewGroup)?.removeView(this)
     }
 
     override fun isOfType(type: Int): Boolean = (type and TYPE_CATEGORY_GROUP) != 0
@@ -313,6 +336,7 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
                     ignoreInsets = true
                 },
             )
+            Launcher.getLauncher(source.context).dragController?.addDragListener(sheet.dragListener)
             sheet.startOpen()
         }
     }
-- 
