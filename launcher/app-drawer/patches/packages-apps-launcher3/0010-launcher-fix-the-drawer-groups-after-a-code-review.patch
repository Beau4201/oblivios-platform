From 448d8cbc2ac43d25b1ef0c5670b6dd4af01c20cb Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Wed, 7 Oct 2026 01:35:22 +0200
Subject: [PATCH] launcher: fix the drawer groups after a code review

Accessibility: a group counts as a row and an item, and a group row has two columns. The pre-draw listener of the opened card is removed from the observer it was added to and does not open a card that is already closed. The card ignores touches while it opens and closes, announces itself when it is open, clears its blur when it is removed in any way and is never opened twice. The category of a system app is no longer read.
---
 .../launcher3/allapps/AllAppsGridAdapter.java | 10 +++++-
 .../launcher3/allapps/category/AppGrouper.kt  |  4 ++-
 .../allapps/category/CategoryGroupSheet.kt    | 33 +++++++++++++++++--
 .../allapps/category/CategoryGroups.kt        |  3 ++
 .../allapps/category/AppGrouperTest.kt        |  9 +++++
 5 files changed, 54 insertions(+), 5 deletions(-)

diff --git a/src/com/android/launcher3/allapps/AllAppsGridAdapter.java b/src/com/android/launcher3/allapps/AllAppsGridAdapter.java
index d1163332e0..a24ea471b4 100644
--- a/src/com/android/launcher3/allapps/AllAppsGridAdapter.java
+++ b/src/com/android/launcher3/allapps/AllAppsGridAdapter.java
@@ -125,6 +125,12 @@ public class AllAppsGridAdapter extends BaseAllAppsAdapter {
         @Override
         public int getColumnCountForAccessibility(RecyclerView.Recycler recycler,
                 RecyclerView.State state) {
+            // sovereignos: category groups sit two to a row, whatever the icon column count is.
+            for (AdapterItem item : mApps.getAdapterItems()) {
+                if (item.viewType == VIEW_TYPE_CATEGORY_GROUP) {
+                    return CATEGORY_GROUPS_PER_ROW;
+                }
+            }
             return mAppsPerRow;
         }
 
@@ -157,7 +163,9 @@ public class AllAppsGridAdapter extends BaseAllAppsAdapter {
             adapterPosition = Math.max(adapterPosition, items.size() - 1);
             int extraRows = 0;
             for (int i = 0; i <= adapterPosition && i < items.size(); i++) {
-                if (!isViewType(items.get(i).viewType, VIEW_TYPE_MASK_ICON)) {
+                // sovereignos: a category group is a row of the collection, not an extra row.
+                if (!isViewType(items.get(i).viewType, VIEW_TYPE_MASK_ICON)
+                        && items.get(i).viewType != VIEW_TYPE_CATEGORY_GROUP) {
                     extraRows++;
                 }
             }
diff --git a/src/com/android/launcher3/allapps/category/AppGrouper.kt b/src/com/android/launcher3/allapps/category/AppGrouper.kt
index c4a89ffdfe..e57c99e85b 100644
--- a/src/com/android/launcher3/allapps/category/AppGrouper.kt
+++ b/src/com/android/launcher3/allapps/category/AppGrouper.kt
@@ -67,7 +67,9 @@ object AppGrouper {
     ): List<GroupedApps<T>> {
         val buckets = EnumMap<AppGroup, MutableList<T>>(AppGroup::class.java)
         for (app in apps) {
-            buckets.getOrPut(groupOf(categoryOf(app), isSystemOf(app))) { ArrayList() }.add(app)
+            // A system app is in System whatever its category, so its category is not read at all.
+            val group = if (isSystemOf(app)) AppGroup.SYSTEM else groupOf(categoryOf(app))
+            buckets.getOrPut(group) { ArrayList() }.add(app)
         }
         return buckets.map { (group, members) -> GroupedApps(group, members) }
     }
diff --git a/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt b/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt
index b0c4559a59..64fbb6d50e 100644
--- a/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt
+++ b/src/com/android/launcher3/allapps/category/CategoryGroupSheet.kt
@@ -67,6 +67,11 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
     private var animator: ValueAnimator? = null
     private var progress = 0f
 
+    // Touches reach the apps in the card only while it is fully open: during the 200 ms of the
+    // open and close animation they are invisible or leaving, and a second tap on the container
+    // would start one of them.
+    private var interactive = false
+
     init {
         gravity = Gravity.CENTER
         background = scrim
@@ -164,12 +169,20 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
 
     private fun startOpen() {
         mIsOpen = true
-        viewTreeObserver.addOnPreDrawListener(
+        // Remove the listener from the observer it was added to: after a detach, viewTreeObserver
+        // is another one and the listener would stay on the root and fire on every frame.
+        val observer = viewTreeObserver
+        observer.addOnPreDrawListener(
             object : ViewTreeObserver.OnPreDrawListener {
                 override fun onPreDraw(): Boolean {
-                    viewTreeObserver.removeOnPreDrawListener(this)
+                    if (observer.isAlive) observer.removeOnPreDrawListener(this)
+                    // Closed or removed before its first frame: do not open (and blur) it again.
+                    if (!mIsOpen || !isAttachedToWindow) return true
                     apply(0f)
-                    animateTo(1f) {}
+                    animateTo(1f) {
+                        interactive = true
+                        announceAccessibilityChanges()
+                    }
                     return true
                 }
             }
@@ -224,8 +237,20 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
         a.start()
     }
 
+    override fun onInterceptTouchEvent(ev: MotionEvent): Boolean = !interactive
+
+    override fun onTouchEvent(event: MotionEvent): Boolean = true
+
+    override fun onDetachedFromWindow() {
+        // Removed in any way other than finish(): leave no animation and no blur behind.
+        animator?.cancel()
+        backdrop?.setRenderEffect(null)
+        super.onDetachedFromWindow()
+    }
+
     override fun handleClose(animate: Boolean) {
         mIsOpen = false
+        interactive = false
         if (animate) {
             animateTo(0f) { finish() }
         } else {
@@ -277,6 +302,8 @@ class CategoryGroupSheet(context: Context, attrs: AttributeSet?) :
         fun show(source: CategoryGroupView, item: CategoryGroupItem) {
             val ancestors = generateSequence<ViewParent>(source.parent) { (it as? View)?.parent }
             val dragLayer = ancestors.filterIsInstance<BaseDragLayer<*>>().firstOrNull() ?: return
+            // One card at a time: a second tap before the first card is laid out must not add another.
+            if ((0 until dragLayer.childCount).any { dragLayer.getChildAt(it) is CategoryGroupSheet }) return
             val sheet = CategoryGroupSheet(source.context, null)
             sheet.bind(source, item, ancestors.filterIsInstance<ActivityAllAppsContainerView<*>>().firstOrNull())
             dragLayer.getDescendantRectRelativeToSelf(source.blockView, sheet.origin)
diff --git a/src/com/android/launcher3/allapps/category/CategoryGroups.kt b/src/com/android/launcher3/allapps/category/CategoryGroups.kt
index edba67e29a..0f4f3289a9 100644
--- a/src/com/android/launcher3/allapps/category/CategoryGroups.kt
+++ b/src/com/android/launcher3/allapps/category/CategoryGroups.kt
@@ -27,6 +27,9 @@ import java.text.Collator
 class CategoryGroupItem(val group: AppGroup, val title: String, val apps: List<AppInfo>) :
     BaseAllAppsAdapter.AdapterItem(BaseAllAppsAdapter.VIEW_TYPE_CATEGORY_GROUP) {
 
+    // Counted like an app, so the accessibility row and item counts include the group.
+    override fun isCountedForAccessibility(): Boolean = true
+
     override fun isSameAs(other: BaseAllAppsAdapter.AdapterItem?): Boolean =
         other is CategoryGroupItem && other.group == group
 
diff --git a/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt b/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt
index 355977fef9..0aae3dadd7 100644
--- a/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt
+++ b/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt
@@ -95,6 +95,15 @@ class AppGrouperTest {
         assertEquals(AppGroup.SOCIAL, AppGrouper.groupOf(ApplicationInfo.CATEGORY_SOCIAL, isSystem = false))
     }
 
+    @Test
+    fun theCategoryOfASystemAppIsNeverRead() {
+        // Reading a category is a binder call in the drawer, and a system app does not need it.
+        val read = mutableListOf<String>()
+        val apps = listOf(App("sys", ApplicationInfo.CATEGORY_SOCIAL), App("user", ApplicationInfo.CATEGORY_SOCIAL))
+        AppGrouper.group(apps, { read.add(it.pkg); it.category }, { it.pkg == "sys" })
+        assertEquals(listOf("user"), read)
+    }
+
     @Test
     fun groupDecidesPerAppWhetherItIsASystemApp() {
         val apps = listOf(App("sys", ApplicationInfo.CATEGORY_SOCIAL), App("user", ApplicationInfo.CATEGORY_SOCIAL))
