From 7f66f4b3cd1b9a5f1035d94d331a38d3a41b1bc6 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Tue, 6 Oct 2026 19:26:48 +0200
Subject: [PATCH] launcher: group every preinstalled app in System

Every preinstalled app goes to the System group whatever category it declares. The fixed per-package groups for Camera, PDF Viewer and Auditor are no longer needed. Nine unit tests; eight mutations of the logic each fail them.
---
 res/values/sovereignos_app_drawer.xml         |  3 ++
 .../launcher3/allapps/category/AppGrouper.kt  | 22 ++++-------
 .../allapps/category/CategoryGroups.kt        |  6 ++-
 .../allapps/category/AppGrouperTest.kt        | 38 +++++++++----------
 4 files changed, 35 insertions(+), 34 deletions(-)

diff --git a/res/values/sovereignos_app_drawer.xml b/res/values/sovereignos_app_drawer.xml
index 9f0baf4ca0..6ae66436cb 100644
--- a/res/values/sovereignos_app_drawer.xml
+++ b/res/values/sovereignos_app_drawer.xml
@@ -5,6 +5,9 @@
     <!-- Name of the group that holds audio, video and image apps. -->
     <string name="app_group_media">Media</string>
 
+    <!-- Name of the group that holds every preinstalled app. -->
+    <string name="app_group_system">System</string>
+
     <!-- Id of the opened group card, so a device check can read its bounds. -->
     <item type="id" name="category_group_card" />
 
diff --git a/src/com/android/launcher3/allapps/category/AppGrouper.kt b/src/com/android/launcher3/allapps/category/AppGrouper.kt
index b203135e05..c4a89ffdfe 100644
--- a/src/com/android/launcher3/allapps/category/AppGrouper.kt
+++ b/src/com/android/launcher3/allapps/category/AppGrouper.kt
@@ -28,6 +28,7 @@ enum class AppGroup {
     MAPS,
     PRODUCTIVITY,
     ACCESSIBILITY,
+    SYSTEM,
     OTHER,
 }
 
@@ -36,18 +37,12 @@ class GroupedApps<T>(val group: AppGroup, val apps: List<T>)
 
 /** Puts apps in the drawer groups. No Android state: it only maps a category to a group. */
 object AppGrouper {
-    // sovereignos: preinstalled apps that declare no ApplicationInfo.category. Used only when the
-    // manifest and the installer give none, so a declared category always wins.
-    private val UNDECLARED_OVERRIDES =
-        mapOf(
-            "app.grapheneos.camera" to AppGroup.MEDIA,
-            "org.grapheneos.pdfviewer" to AppGroup.PRODUCTIVITY,
-            "app.attestation.auditor" to AppGroup.PRODUCTIVITY,
-        )
-
+    // sovereignos: every preinstalled app is in System, whatever category it declares. That also
+    // places the preinstalled apps that declare none (Camera, PDF Viewer, Auditor), so no fixed
+    // per-package groups are needed.
     @JvmStatic
-    fun groupOf(category: Int, packageName: String): AppGroup =
-        when (category) {
+    fun groupOf(category: Int, isSystem: Boolean = false): AppGroup =
+        if (isSystem) AppGroup.SYSTEM else when (category) {
             ApplicationInfo.CATEGORY_GAME -> AppGroup.GAMES
             ApplicationInfo.CATEGORY_AUDIO,
             ApplicationInfo.CATEGORY_VIDEO,
@@ -57,7 +52,6 @@ object AppGrouper {
             ApplicationInfo.CATEGORY_MAPS -> AppGroup.MAPS
             ApplicationInfo.CATEGORY_PRODUCTIVITY -> AppGroup.PRODUCTIVITY
             ApplicationInfo.CATEGORY_ACCESSIBILITY -> AppGroup.ACCESSIBILITY
-            ApplicationInfo.CATEGORY_UNDEFINED -> UNDECLARED_OVERRIDES[packageName] ?: AppGroup.OTHER
             else -> AppGroup.OTHER
         }
 
@@ -69,11 +63,11 @@ object AppGrouper {
     fun <T> group(
         apps: List<T>,
         categoryOf: (T) -> Int,
-        packageOf: (T) -> String,
+        isSystemOf: (T) -> Boolean = { false },
     ): List<GroupedApps<T>> {
         val buckets = EnumMap<AppGroup, MutableList<T>>(AppGroup::class.java)
         for (app in apps) {
-            buckets.getOrPut(groupOf(categoryOf(app), packageOf(app))) { ArrayList() }.add(app)
+            buckets.getOrPut(groupOf(categoryOf(app), isSystemOf(app))) { ArrayList() }.add(app)
         }
         return buckets.map { (group, members) -> GroupedApps(group, members) }
     }
diff --git a/src/com/android/launcher3/allapps/category/CategoryGroups.kt b/src/com/android/launcher3/allapps/category/CategoryGroups.kt
index 11f473861a..edba67e29a 100644
--- a/src/com/android/launcher3/allapps/category/CategoryGroups.kt
+++ b/src/com/android/launcher3/allapps/category/CategoryGroups.kt
@@ -20,6 +20,7 @@ import android.content.Context
 import com.android.launcher3.R
 import com.android.launcher3.allapps.BaseAllAppsAdapter
 import com.android.launcher3.model.data.AppInfo
+import com.android.launcher3.model.data.ItemInfoWithIcon
 import java.text.Collator
 
 /** The adapter item of one drawer group: a container with the group's apps. */
@@ -47,6 +48,7 @@ object CategoryGroups {
             AppGroup.MAPS -> R.string.topic_category_maps
             AppGroup.PRODUCTIVITY -> R.string.topic_category_productivity
             AppGroup.ACCESSIBILITY -> R.string.topic_category_accessibility
+            AppGroup.SYSTEM -> R.string.app_group_system
             AppGroup.OTHER -> R.string.topic_category_other
         }
 
@@ -57,7 +59,9 @@ object CategoryGroups {
         categoryOf: (AppInfo) -> Int,
     ): List<CategoryGroupItem> {
         val collator = Collator.getInstance(context.resources.configuration.locales[0])
-        return AppGrouper.group(apps, categoryOf) { it.targetPackage.orEmpty() }
+        return AppGrouper.group(apps, categoryOf) {
+                (it.runtimeStatusFlags and ItemInfoWithIcon.FLAG_SYSTEM_YES) != 0
+            }
             .map { CategoryGroupItem(it.group, context.getString(titleRes(it.group)), it.apps) }
             .sortedWith(
                 compareBy<CategoryGroupItem> { it.group == AppGroup.OTHER }
diff --git a/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt b/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt
index 43fc066200..355977fef9 100644
--- a/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt
+++ b/tests/multivalentTests/src/com/android/launcher3/allapps/category/AppGrouperTest.kt
@@ -25,7 +25,7 @@ class AppGrouperTest {
 
     private data class App(val pkg: String, val category: Int)
 
-    private fun group(apps: List<App>) = AppGrouper.group(apps, { it.category }, { it.pkg })
+    private fun group(apps: List<App>) = AppGrouper.group(apps, { it.category })
 
     private fun groupsOf(apps: List<App>) = group(apps).associate { it.group to it.apps.map { a -> a.pkg } }
 
@@ -83,26 +83,26 @@ class AppGrouperTest {
     }
 
     @Test
-    fun overrideAppliesOnlyWhenNoCategoryIsDeclared() {
-        assertEquals(
-            AppGroup.MEDIA,
-            AppGrouper.groupOf(ApplicationInfo.CATEGORY_UNDEFINED, "app.grapheneos.camera"),
-        )
-        assertEquals(
-            AppGroup.PRODUCTIVITY,
-            AppGrouper.groupOf(ApplicationInfo.CATEGORY_UNDEFINED, "org.grapheneos.pdfviewer"),
-        )
-        assertEquals(
-            AppGroup.PRODUCTIVITY,
-            AppGrouper.groupOf(ApplicationInfo.CATEGORY_UNDEFINED, "app.attestation.auditor"),
-        )
-        // A declared category always wins over the override.
+    fun anAppWithoutACategoryIsOther() {
+        assertEquals(AppGroup.OTHER, AppGrouper.groupOf(ApplicationInfo.CATEGORY_UNDEFINED))
+    }
+
+    @Test
+    fun aSystemAppIsInSystemWhateverItsCategory() {
+        for (category in intArrayOf(-1, 0, 1, 2, 3, 4, 5, 6, 7, 8, 42)) {
+            assertEquals(AppGroup.SYSTEM, AppGrouper.groupOf(category, isSystem = true))
+        }
+        assertEquals(AppGroup.SOCIAL, AppGrouper.groupOf(ApplicationInfo.CATEGORY_SOCIAL, isSystem = false))
+    }
+
+    @Test
+    fun groupDecidesPerAppWhetherItIsASystemApp() {
+        val apps = listOf(App("sys", ApplicationInfo.CATEGORY_SOCIAL), App("user", ApplicationInfo.CATEGORY_SOCIAL))
+        val grouped = AppGrouper.group(apps, { it.category }, { it.pkg == "sys" })
         assertEquals(
-            AppGroup.SOCIAL,
-            AppGrouper.groupOf(ApplicationInfo.CATEGORY_SOCIAL, "app.grapheneos.camera"),
+            mapOf(AppGroup.SOCIAL to listOf("user"), AppGroup.SYSTEM to listOf("sys")),
+            grouped.associate { it.group to it.apps.map { a -> a.pkg } },
         )
-        // An unknown package without a category is Other.
-        assertEquals(AppGroup.OTHER, AppGrouper.groupOf(ApplicationInfo.CATEGORY_UNDEFINED, "com.example"))
     }
 
     @Test
-- 
2.39.5

