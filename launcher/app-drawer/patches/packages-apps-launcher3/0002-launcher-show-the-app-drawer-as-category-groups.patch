+                    .category;
+        } catch (PackageManager.NameNotFoundException e) {
+            Log.d(TAG, "No application info for " + info.getTargetPackage());
+        }
+        if (category != ApplicationInfo.CATEGORY_UNDEFINED) {
+            mCategoryCache.put(key, category);
+        }
+        return category;
+    }
