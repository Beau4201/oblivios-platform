+ * limitations under the License.
+ */
+
+package com.android.launcher3.allapps.category
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Typeface
+import android.text.TextUtils
+import android.util.AttributeSet
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.android.launcher3.LauncherAppState
+import com.android.launcher3.LauncherSettings.Favorites
+import com.android.launcher3.R
+import com.android.launcher3.icons.BitmapInfo
+import com.android.launcher3.icons.FastBitmapDrawable
+import com.android.launcher3.model.data.AppInfo
+import com.android.launcher3.touch.CustomActionsListener
+import com.android.launcher3.util.Themes
+
+/**
+ * One group in the app drawer: a rounded tonal container with the first four apps of the group as
+ * themed icons, and the group name under it. A tap opens the group in a [CategoryGroupSheet].
+ */
+class CategoryGroupView @JvmOverloads constructor(context: Context, attrs: AttributeSet? = null) :
+    LinearLayout(context, attrs) {
+
+    private val block = Block(context)
+    private val label = TextView(context)
+    private var item: CategoryGroupItem? = null
+    private var iconClick: OnClickListener? = null
+    private var iconLongClick: OnLongClickListener? = null
+    private var customActions: CustomActionsListener? = null
+
+    /** The rounded container, used as the origin of the open animation. */
+    val blockView: View
+        get() = block
+
+    init {
+        orientation = VERTICAL
+        val margin = resources.getDimensionPixelSize(R.dimen.app_group_block_margin)
+        addView(
+            block,
+            LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT).apply {
+                // The drawer clips its list a little below the first row, as stock icons start lower
+                // inside their cells. The space above also separates a label from the next container.
+                setMargins(margin, 2 * margin, margin, 0)
+            },
+        )
+        label.apply {
+            gravity = Gravity.CENTER_HORIZONTAL
+            isSingleLine = true
+            ellipsize = TextUtils.TruncateAt.END
+            typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
+            setTextSize(
+                TypedValue.COMPLEX_UNIT_PX,
+                resources.getDimension(R.dimen.app_group_label_text_size),
+            )
+            setTextColor(Themes.getAttrColor(context, android.R.attr.textColorPrimary))
+            setPadding(0, resources.getDimensionPixelSize(R.dimen.app_group_label_padding_top), 0, 0)
+        }
+        addView(label, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        isClickable = true
+        isFocusable = true
+        setOnClickListener { item?.let { CategoryGroupSheet.show(this, it) } }
+    }
+
+    fun bind(
+        item: CategoryGroupItem,
+        iconClick: OnClickListener?,
+        iconLongClick: OnLongClickListener?,
+        customActions: CustomActionsListener?,
+    ) {
+        this.item = item
+        this.iconClick = iconClick
+        this.iconLongClick = iconLongClick
+        this.customActions = customActions
+        label.text = item.title
+        label.setPadding(
+            0,
+            resources.getDimensionPixelSize(R.dimen.app_group_label_padding_top),
+            0,
+            if (item.inLastRow) 2 * resources.getDimensionPixelSize(R.dimen.app_group_block_margin) else 0,
+        )
+        contentDescription = item.title
+        block.setApps(item.apps)
+    }
+
+    internal fun iconClickListener() = iconClick
+
+    internal fun iconLongClickListener() = iconLongClick
+
+    internal fun customActionsListener() = customActions
+
+    private class Block(context: Context) : View(context) {
+        private val paint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = Themes.getAttrColor(context, R.attr.groupHighlight)
+            }
+        private val radius =
+            resources.getDimension(R.dimen.all_apps_recycler_view_decorator_group_radius)
+        private val padding = resources.getDimensionPixelSize(R.dimen.app_group_block_padding)
+        private val gap = resources.getDimensionPixelSize(R.dimen.app_group_block_gap)
+        private var icons: List<FastBitmapDrawable> = emptyList()
+        private var bound: List<AppInfo> = emptyList()
+
+        fun setApps(apps: List<AppInfo>, loadHighRes: Boolean = true) {
+            bound = apps
+            val current = apps.take(ICONS_SHOWN)
+            icons = current.map { it.newIcon(context, BitmapInfo.FLAG_THEMED) }
+            layoutIcons()
+            invalidate()
+            // An app whose themed icon is not cached yet (a generated one, for an app without a
+            // monochrome icon) is loaded in the background, as BubbleTextView.verifyHighRes and the
+            // folder preview do, and the icons are made again when it arrives. Once per binding, so
+            // a cache that cannot give the icon does not start requests in a loop.
+            if (!loadHighRes) return
+            for (app in current) {
+                if (app.matchingLookupFlag.isVisuallyLessThan(Favorites.DESKTOP_ICON_FLAG)) {
+                    LauncherAppState.getInstance(context)
+                        .iconCache
+                        .updateIconInBackground(
+                            context.mainExecutor,
+                            { if (bound === apps) setApps(apps, loadHighRes = false) },
+                            app,
+                            Favorites.DESKTOP_ICON_FLAG,
+                        )
+                }
+            }
+        }
+
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            val size = MeasureSpec.getSize(widthMeasureSpec)
+            setMeasuredDimension(size, size)
+        }
+
+        override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+            super.onSizeChanged(w, h, oldw, oldh)
+            layoutIcons()
+        }
+
+        private fun layoutIcons() {
+            val cell = (width - 2 * padding - gap) / 2
+            icons.forEachIndexed { i, icon ->
+                val left = padding + (i % 2) * (cell + gap)
+                val top = padding + (i / 2) * (cell + gap)
+                icon.setBounds(left, top, left + cell, top + cell)
+            }
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            canvas.drawRoundRect(0f, 0f, width.toFloat(), height.toFloat(), radius, radius, paint)
+            icons.forEach { it.draw(canvas) }
+        }
+
+        private companion object {
+            const val ICONS_SHOWN = 4
+        }
+    }
+}
