+package com.android.launcher3.allapps.category
+
+import android.content.pm.ApplicationInfo
+import java.util.EnumMap
+
+/** The groups of the app drawer. The declaration order is the order a caller can rely on. */
+enum class AppGroup {
+    GAMES,
+    MEDIA,
+    SOCIAL,
+    NEWS,
+    MAPS,
+    PRODUCTIVITY,
+    ACCESSIBILITY,
+    OTHER,
+}
+
+/** One group with its apps, in the order the caller passed them. */
+class GroupedApps<T>(val group: AppGroup, val apps: List<T>)
+
+/** Puts apps in the drawer groups. No Android state: it only maps a category to a group. */
+object AppGrouper {
+    // freeholdos: preinstalled apps that declare no ApplicationInfo.category. Used only when the
+    // manifest and the installer give none, so a declared category always wins.
+    private val UNDECLARED_OVERRIDES =
+        mapOf(
+            "app.grapheneos.camera" to AppGroup.MEDIA,
+            "org.grapheneos.pdfviewer" to AppGroup.PRODUCTIVITY,
+            "app.attestation.auditor" to AppGroup.PRODUCTIVITY,
+        )
+
+    @JvmStatic
+    fun groupOf(category: Int, packageName: String): AppGroup =
+        when (category) {
+            ApplicationInfo.CATEGORY_GAME -> AppGroup.GAMES
+            ApplicationInfo.CATEGORY_AUDIO,
+            ApplicationInfo.CATEGORY_VIDEO,
+            ApplicationInfo.CATEGORY_IMAGE -> AppGroup.MEDIA
+            ApplicationInfo.CATEGORY_SOCIAL -> AppGroup.SOCIAL
+            ApplicationInfo.CATEGORY_NEWS -> AppGroup.NEWS
+            ApplicationInfo.CATEGORY_MAPS -> AppGroup.MAPS
+            ApplicationInfo.CATEGORY_PRODUCTIVITY -> AppGroup.PRODUCTIVITY
+            ApplicationInfo.CATEGORY_ACCESSIBILITY -> AppGroup.ACCESSIBILITY
+            ApplicationInfo.CATEGORY_UNDEFINED -> UNDECLARED_OVERRIDES[packageName] ?: AppGroup.OTHER
+            else -> AppGroup.OTHER
+        }
+
+    /**
+     * Groups [apps]. Every app lands in exactly one group, the apps of a group keep their input
+     * order, groups without apps are left out and the groups come in [AppGroup] declaration order.
+     */
+    @JvmStatic
+    fun <T> group(
+        apps: List<T>,
+        categoryOf: (T) -> Int,
+        packageOf: (T) -> String,
+    ): List<GroupedApps<T>> {
+        val buckets = EnumMap<AppGroup, MutableList<T>>(AppGroup::class.java)
+        for (app in apps) {
+            buckets.getOrPut(groupOf(categoryOf(app), packageOf(app))) { ArrayList() }.add(app)
+        }
+        return buckets.map { (group, members) -> GroupedApps(group, members) }
+    }
+}
