From ee170a0d8755d3139c1b334eb8bdb90a08016578 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Tue, 6 Oct 2026 19:14:10 +0200
Subject: [PATCH] launcher: rebind the drawer groups on every update

A group draws its icons itself and compared equal when only an icon changed, so it kept the icons of its first binding, unthemed and in the default shape. Stock icon items always rebind; a group now does too.
---
 .../launcher3/allapps/category/CategoryGroups.kt      | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/src/com/android/launcher3/allapps/category/CategoryGroups.kt b/src/com/android/launcher3/allapps/category/CategoryGroups.kt
index 8d5f0a9ae6..11f473861a 100644
--- a/src/com/android/launcher3/allapps/category/CategoryGroups.kt
+++ b/src/com/android/launcher3/allapps/category/CategoryGroups.kt
@@ -29,14 +29,9 @@ class CategoryGroupItem(val group: AppGroup, val title: String, val apps: List<A
     override fun isSameAs(other: BaseAllAppsAdapter.AdapterItem?): Boolean =
         other is CategoryGroupItem && other.group == group
 
-    override fun isContentSame(other: BaseAllAppsAdapter.AdapterItem): Boolean =
-        other is CategoryGroupItem &&
-            other.title == title &&
-            other.apps.size == apps.size &&
-            apps.indices.all {
-                apps[it].componentName == other.apps[it].componentName &&
-                    apps[it].user == other.apps[it].user
-            }
+    // Always rebound, as the stock icon items are: the container draws the icons itself, and the
+    // icons of an app (loaded late, or themed after a theme change) are not part of what is compared.
+    override fun isContentSame(other: BaseAllAppsAdapter.AdapterItem): Boolean = false
 }
 
 /** Builds the drawer group items: grouping, localized titles, cards sorted by title, Other last. */
-- 
