+<?xml version="1.0" encoding="utf-8"?>
+<!-- SovereignOS keyboard restyle (ADR-146). Licensed under the Apache License, Version 2.0, as the rest of this package. -->
+<resources>
+    <!-- A key is a rounded cap with a darker bottom edge. The edge is drawn below the key
+         rectangle (the drawable padding), so a label centred on the key is centred on the cap. -->
+    <dimen name="sovereignos_key_corner_radius">10dp</dimen>
+    <dimen name="sovereignos_key_edge">1.5dp</dimen>
+    <dimen name="sovereignos_keyboard_top_radius">16dp</dimen>
+    <dimen name="sovereignos_popup_corner_radius">14dp</dimen>
+    <dimen name="sovereignos_popup_selected_radius">10dp</dimen>
+    <dimen name="sovereignos_suggestion_pill_radius">8dp</dimen>
+    <color name="sovereignos_keyboard_background_light">#CFD8DC</color>
+    <color name="sovereignos_key_cap_light">#FFFFFF</color>
+    <color name="sovereignos_key_cap_functional_light">#B0BEC5</color>
+    <color name="sovereignos_key_edge_light">#90A4AE</color>
+    <color name="sovereignos_popup_light">#FFFFFF</color>
+    <color name="sovereignos_suggestion_divider_light">#4D37474F</color>
+    <color name="sovereignos_keyboard_background_dark">#263238</color>
+    <color name="sovereignos_key_cap_dark">#455A64</color>
+    <color name="sovereignos_key_cap_functional_dark">#37474F</color>
+    <color name="sovereignos_key_edge_dark">#1B2327</color>
+    <color name="sovereignos_popup_dark">#455A64</color>
+    <color name="sovereignos_suggestion_divider_dark">#4DFFFFFF</color>
+</resources>
