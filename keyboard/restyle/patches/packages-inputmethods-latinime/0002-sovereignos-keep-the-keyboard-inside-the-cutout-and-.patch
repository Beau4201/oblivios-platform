+package com.android.inputmethod.latin;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.drawable.Drawable;
+
+/**
+ * The keyboard background as the background of the whole input method window. The window is as
+ * tall as the screen, so the background is drawn only from {@link #setTop} down, and over the whole
+ * window width, which includes the margin under the display cutout. Nothing is drawn until the
+ * first {@link #setTop}.
+ */
+final class KeyboardWindowBackground extends Drawable {
+    private final Drawable mBackground;
+    private int mTop = Integer.MAX_VALUE;
+
+    KeyboardWindowBackground(final Drawable background) {
+        mBackground = background;
+    }
+
+    /** Sets the top of the keyboard in window coordinates. */
+    void setTop(final int top) {
+        if (top != mTop) {
+            mTop = top;
+            invalidateSelf();
+        }
+    }
+
+    @Override
+    public void draw(final Canvas canvas) {
+        final Rect bounds = getBounds();
+        final int top = Math.max(bounds.top, mTop);
+        if (top >= bounds.bottom) {
+            return;
+        }
+        mBackground.setBounds(bounds.left, top, bounds.right, bounds.bottom);
+        mBackground.draw(canvas);
+    }
+
+    @Override
+    public void setAlpha(final int alpha) {
+        mBackground.setAlpha(alpha);
+    }
+
+    @Override
+    public void setColorFilter(final ColorFilter colorFilter) {
+        mBackground.setColorFilter(colorFilter);
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
