+package com.android.inputmethod.latin.utils;
+
+import android.view.View;
+
+import com.android.inputmethod.latin.common.CoordinateUtils;
+
+/**
+ * sovereignos: the key previews, the more-keys and more-suggestions panels and the gesture trail are
+ * added to {@code android.R.id.content}, but upstream places them from
+ * {@link View#getLocationInWindow}. The two coordinate systems differ by the padding that the
+ * platform applies to the content root of the window (display cutout and system bars), which is
+ * zero as long as the window is laid out inside the cutout and not zero once it is laid out under it.
+ */
+public final class WindowContentOrigin {
+    // Used on the UI thread only.
+    private static final int[] sContentOrigin = CoordinateUtils.newInstance();
+
+    private WindowContentOrigin() {
+        // This utility class is not publicly instantiable.
+    }
+
+    /** Like {@link View#getLocationInWindow}, but relative to the content view of the window. */
+    public static void locate(final View view, final int[] outCoords) {
+        view.getLocationInWindow(outCoords);
+        final View content = view.getRootView().findViewById(android.R.id.content);
+        if (content == null) {
+            return;
+        }
+        content.getLocationInWindow(sContentOrigin);
+        CoordinateUtils.set(outCoords,
+                CoordinateUtils.x(outCoords) - CoordinateUtils.x(sContentOrigin),
+                CoordinateUtils.y(outCoords) - CoordinateUtils.y(sContentOrigin));
+    }
+}
