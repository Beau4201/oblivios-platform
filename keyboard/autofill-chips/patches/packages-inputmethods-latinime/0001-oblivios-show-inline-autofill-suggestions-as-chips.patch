diff --git a/java/src/com/android/inputmethod/latin/suggestions/AutofillChipController.java b/java/src/com/android/inputmethod/latin/suggestions/AutofillChipController.java
new file mode 100644
index 0000000..06779a4
--- /dev/null
+++ b/java/src/com/android/inputmethod/latin/suggestions/AutofillChipController.java
@@ -0,0 +1,124 @@
+package com.android.inputmethod.latin.suggestions;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.util.Size;
+import android.view.ViewGroup;
+import android.view.inputmethod.InlineSuggestion;
+import android.view.inputmethod.InlineSuggestionsResponse;
+import android.widget.inline.InlineContentView;
+
+import com.android.inputmethod.latin.R;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.Executor;
+import java.util.function.Consumer;
+
+/**
+ * oblivios: puts the inline suggestions of the autofill service into the suggestion strip as chips. The content of a
+ * chip is drawn by the system in another process; this class holds only the surface views it gets back. It never
+ * reads the info of a suggestion (hints, type, source, pinned), never logs a suggestion, and gives every chip an exact
+ * size so that the width of a chip tells nothing about its text.
+ */
+final class AutofillChipController {
+    interface Listener {
+        void onAutofillChipsChanged(boolean shown);
+    }
+
+    private final Context mContext;
+    private final AutofillChipRow mRow;
+    private final Listener mListener;
+    private final Executor mExecutor;
+    private final AutofillChipPolicy mPolicy = new AutofillChipPolicy();
+    private boolean mShown;
+
+    AutofillChipController(final Context context, final AutofillChipRow row, final Listener listener) {
+        mContext = context;
+        mRow = row;
+        mListener = listener;
+        mExecutor = context.getMainExecutor();
+    }
+
+    boolean hasChips() {
+        return mShown;
+    }
+
+    /** A request was made for a field that got focus: the offer starts again and the old chips go. */
+    void onNewRequest() {
+        mPolicy.onNewRequest();
+        show(Collections.<InlineContentView>emptyList());
+    }
+
+    /** A character was typed or deleted: the chips go and stay away until the next request. */
+    void onTyped() {
+        mPolicy.onTyped();
+        show(Collections.<InlineContentView>emptyList());
+    }
+
+    /** The keyboard went away or the editor changed. */
+    void clear() {
+        mPolicy.onCleared();
+        show(Collections.<InlineContentView>emptyList());
+    }
+
+    void onResponse(final InlineSuggestionsResponse response) {
+        final List<InlineSuggestion> suggestions = response.getInlineSuggestions();
+        final int shown = AutofillChipPolicy.visibleCount(suggestions.size());
+        final int token = mPolicy.begin(shown);
+        if (token == AutofillChipPolicy.NONE) {
+            show(Collections.<InlineContentView>emptyList());
+            return;
+        }
+        final InlineContentView[] views = new InlineContentView[shown];
+        final int[] pending = {shown};
+        for (int i = 0; i < shown; i++) {
+            final int index = i;
+            inflate(suggestions.get(i), shown, view -> {
+                if (!mPolicy.isCurrent(token)) {
+                    return;
+                }
+                views[index] = view;
+                if (--pending[0] == 0) {
+                    final List<InlineContentView> ready = new ArrayList<>(shown);
+                    for (final InlineContentView v : views) {
+                        if (v != null) {
+                            ready.add(v);
+                        }
+                    }
+                    show(ready);
+                }
+            });
+        }
+    }
+
+    private void inflate(final InlineSuggestion suggestion, final int shown,
+            final Consumer<InlineContentView> done) {
+        final Resources res = mContext.getResources();
+        final Size exact = new Size(
+                res.getDimensionPixelSize(AutofillChipPolicy.alone(shown)
+                        ? R.dimen.oblivios_autofill_chip_width_alone
+                        : R.dimen.oblivios_autofill_chip_width_shared),
+                res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_height));
+        try {
+            suggestion.inflate(mContext, exact, mExecutor, done);
+        } catch (final IllegalArgumentException e) {
+            // oblivios: the bounds of this provider do not allow the fixed size; its content decides then.
+            suggestion.inflate(mContext, new Size(ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ViewGroup.LayoutParams.WRAP_CONTENT), mExecutor, done);
+        } catch (final IllegalStateException e) {
+            // This suggestion was inflated before; there is nothing to show for it.
+            mExecutor.execute(() -> done.accept(null));
+        }
+    }
+
+    private void show(final List<InlineContentView> chips) {
+        mRow.setChips(chips);
+        final boolean shown = !chips.isEmpty();
+        if (shown != mShown) {
+            mShown = shown;
+            mListener.onAutofillChipsChanged(shown);
+        }
+    }
+}
diff --git a/java/src/com/android/inputmethod/latin/suggestions/AutofillChipPolicy.java b/java/src/com/android/inputmethod/latin/suggestions/AutofillChipPolicy.java
new file mode 100644
index 0000000..16ae6d3
--- /dev/null
+++ b/java/src/com/android/inputmethod/latin/suggestions/AutofillChipPolicy.java
@@ -0,0 +1,62 @@
+package com.android.inputmethod.latin.suggestions;
+
+/**
+ * oblivios: the rules for the autofill chips in the suggestion strip, without any Android class so that the host
+ * checks can run them. The state is two things: whether the user has typed in the field of the current request, and
+ * a generation number that identifies the response whose chips may still be put on the screen.
+ */
+final class AutofillChipPolicy {
+    /** Chips a response may show. The platform documents five as the most that is useful. */
+    static final int MAX_CHIPS = 5;
+    /** The token of a response that shows nothing. */
+    static final int NONE = -1;
+
+    private boolean mTyped;
+    private int mGeneration;
+
+    /** A new request means a field got focus: the offer starts again and what was in flight is dropped. */
+    void onNewRequest() {
+        mTyped = false;
+        mGeneration++;
+    }
+
+    /** A character was typed or deleted: the offer ends for this field until the next request. */
+    void onTyped() {
+        mTyped = true;
+        mGeneration++;
+    }
+
+    /** The chips were cleared (the keyboard went away, or the response is empty): what was in flight is dropped. */
+    void onCleared() {
+        mGeneration++;
+    }
+
+    /** True after the user typed in this field. */
+    boolean typed() {
+        return mTyped;
+    }
+
+    /** How many chips a response of {@code count} suggestions shows. */
+    static int visibleCount(final int count) {
+        return Math.min(Math.max(count, 0), MAX_CHIPS);
+    }
+
+    /** One chip alone is wider than several that share the strip. */
+    static boolean alone(final int shown) {
+        return shown == 1;
+    }
+
+    /**
+     * Starts the inflation of a response with {@code shown} chips and returns its token, or {@link #NONE} when nothing
+     * is to be shown (no chip, or the user typed). Either way, what was in flight is dropped.
+     */
+    int begin(final int shown) {
+        mGeneration++;
+        return (mTyped || shown <= 0) ? NONE : mGeneration;
+    }
+
+    /** True while {@code token} is the latest response and nothing has cleared or replaced it since. */
+    boolean isCurrent(final int token) {
+        return token == mGeneration;
+    }
+}
diff --git a/java/src/com/android/inputmethod/latin/suggestions/AutofillChipRow.java b/java/src/com/android/inputmethod/latin/suggestions/AutofillChipRow.java
new file mode 100644
index 0000000..885ef56
--- /dev/null
+++ b/java/src/com/android/inputmethod/latin/suggestions/AutofillChipRow.java
@@ -0,0 +1,81 @@
+package com.android.inputmethod.latin.suggestions;
+
+import android.content.Context;
+import android.graphics.Rect;
+import android.util.AttributeSet;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.HorizontalScrollView;
+import android.widget.LinearLayout;
+import android.widget.inline.InlineContentView;
+
+import com.android.inputmethod.latin.R;
+
+import java.util.List;
+
+/**
+ * oblivios: the row of autofill chips in the suggestion strip. A chip is a surface that another process draws, and
+ * such a surface is not clipped by its parent, so every chip is clipped to the visible part of this row by hand
+ * (the same approach as InlineContentClipView of the AutofillKeyboard sample of the tree).
+ */
+public final class AutofillChipRow extends HorizontalScrollView {
+    private final LinearLayout mRow;
+    private final Rect mClip = new Rect();
+    private final int mGap;
+
+    public AutofillChipRow(final Context context, final AttributeSet attrs) {
+        super(context, attrs);
+        mGap = context.getResources().getDimensionPixelSize(R.dimen.oblivios_autofill_chip_gap);
+        mRow = new LinearLayout(context);
+        mRow.setOrientation(LinearLayout.HORIZONTAL);
+        mRow.setGravity(Gravity.CENTER);
+        addView(mRow, new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.MATCH_PARENT));
+        setFillViewport(true);
+        setOverScrollMode(OVER_SCROLL_NEVER);
+        setHorizontalScrollBarEnabled(false);
+        setFocusable(false);
+    }
+
+    int getChipCount() {
+        return mRow.getChildCount();
+    }
+
+    /** Replaces the chips; an empty list removes them. */
+    void setChips(final List<InlineContentView> chips) {
+        if (chips.isEmpty() && mRow.getChildCount() == 0) {
+            return;
+        }
+        mRow.removeAllViews();
+        scrollTo(0, 0);
+        for (int i = 0; i < chips.size(); i++) {
+            final InlineContentView chip = chips.get(i);
+            final LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(chip.getLayoutParams());
+            if (i > 0) {
+                lp.setMarginStart(mGap);
+            }
+            mRow.addView(chip, lp);
+        }
+    }
+
+    @Override
+    protected void onLayout(final boolean changed, final int l, final int t, final int r, final int b) {
+        super.onLayout(changed, l, t, r, b);
+        clipChips();
+    }
+
+    @Override
+    protected void onScrollChanged(final int l, final int t, final int oldl, final int oldt) {
+        super.onScrollChanged(l, t, oldl, oldt);
+        clipChips();
+    }
+
+    private void clipChips() {
+        final int scrollX = getScrollX();
+        for (int i = 0; i < mRow.getChildCount(); i++) {
+            final View chip = mRow.getChildAt(i);
+            mClip.set(scrollX - chip.getLeft(), -chip.getTop(),
+                    scrollX + getWidth() - chip.getLeft(), getHeight() - chip.getTop());
+            chip.setClipBounds(mClip);
+        }
+    }
+}
