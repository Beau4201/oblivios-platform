+import androidx.autofill.inline.v1.InlineSuggestionUi;
+
+import com.android.inputmethod.latin.R;
+
+import java.util.Collections;
+
+/**
+ * oblivios: the request that asks the autofill service for chips and carries the look of a chip. The system draws
+ * the content of a chip in another process from the style built here, so this keyboard never sees the text. API 30
+ * and newer; the image that carries this keyboard is newer than that.
+ */
+public final class AutofillChipStyle {
+    private AutofillChipStyle() {}
+
+    public static InlineSuggestionsRequest buildRequest(final Context context, final boolean dark) {
+        final Resources res = context.getResources();
+        final int height = res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_height);
+        final int textColor = context.getColor(dark ? R.color.oblivios_autofill_chip_text_dark
+                : R.color.oblivios_autofill_chip_text_light);
+        final Icon background = Icon.createWithResource(context, dark
+                ? R.drawable.oblivios_autofill_chip_dark : R.drawable.oblivios_autofill_chip_light);
+        final int icon = res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_icon_size);
+        final InlineSuggestionUi.Style style = InlineSuggestionUi.newStyleBuilder()
+                .setLayoutDirection(res.getConfiguration().getLayoutDirection())
+                .setChipStyle(new ViewStyle.Builder()
+                        .setBackground(background)
+                        .setPadding(res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_padding_start), 0,
+                                res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_padding_end), 0)
+                        .build())
+                .setStartIconStyle(new ImageViewStyle.Builder()
+                        .setTintList(ColorStateList.valueOf(textColor))
+                        .setMaxWidth(icon)
+                        .setMaxHeight(icon)
+                        .setLayoutMargin(0, 0,
+                                res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_icon_gap), 0)
+                        .build())
+                .setTitleStyle(new TextViewStyle.Builder()
+                        .setTextColor(textColor)
+                        .setTextSize(TypedValue.COMPLEX_UNIT_PX,
+                                res.getDimension(R.dimen.oblivios_autofill_chip_text_size))
+                        .setTypeface("sans-serif-medium", Typeface.NORMAL)
+                        .build())
+                .build();
+        final Bundle styles = UiVersions.newStylesBuilder().addStyle(style).build();
+        final InlinePresentationSpec spec = new InlinePresentationSpec.Builder(
+                new Size(res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_min_width), height),
+                new Size(res.getDimensionPixelSize(R.dimen.oblivios_autofill_chip_width_alone), height))
+                .setStyle(styles)
+                .build();
+        return new InlineSuggestionsRequest.Builder(Collections.singletonList(spec))
+                .setMaxSuggestionCount(AutofillChipPolicy.MAX_CHIPS)
+                .build();
+    }
+}
