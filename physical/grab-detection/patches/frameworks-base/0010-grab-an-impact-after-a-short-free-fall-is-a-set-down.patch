             this.impactPeak = impactPeak;
             this.peak = peak;
             this.touchWindowMs = touchWindowMs;
@@ -79,6 +101,8 @@ public final class GrabDetector {
         public final float energy;
         /** True when the verdict came from {@code impactPeak} alone, not from the pull rule. */
