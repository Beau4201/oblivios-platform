diff --git a/services/core/java/com/android/server/grab/GrabDetector.java b/services/core/java/com/android/server/grab/GrabDetector.java
index d42ac7d..b3c70b6 100644
--- a/services/core/java/com/android/server/grab/GrabDetector.java
+++ b/services/core/java/com/android/server/grab/GrabDetector.java
@@ -22,6 +22,13 @@ public final class GrabDetector {
     /** Standard gravity in m/s^2. */
     public static final float GRAVITY = 9.80665f;
 
+    /** An acceleration magnitude below this (m/s^2, gravity included) is a phone in free fall. */
+    public static final float FREE_FALL_MAX = 4f;
+    /** A free fall counts for an impact when it ended at most this long before it. */
+    public static final long FREE_FALL_WINDOW_MS = 400;
+    /** After an impact that did not lock, the rest of the same pulse is not judged again. */
+    private static final long IMPACT_QUIET_MS = 250;
+
     private static final long NEVER = Long.MIN_VALUE;
 
     /** Tunable thresholds. Accelerations are in m/s^2, times in milliseconds. */
@@ -45,6 +52,13 @@ public final class GrabDetector {
          * phone does afterwards. Zero or less turns this route off.
          */
         public final float impactPeak;
+        /**
+         * An impact after a free fall shorter than this does not lock: a phone that is set down
+         * falls freely for a moment, a grab has no free fall (measured on lynx, 2026-10-25). An
+         * impact after no free fall, or after one at least this long (a real fall), locks. Zero or
