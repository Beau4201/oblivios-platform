@@ -112,6 +142,17 @@ public final class GrabDetector {
     private int mCount;
     private long mIgnoreUntilMs = NEVER;
     private long mNoTouchReportUntilMs = NEVER;
+    private long mImpactQuietUntilMs = NEVER;
+
+    // free fall: the run of samples below FREE_FALL_MAX that is going on (mFall*), and the longest
+    // finished run that ended inside the window (mBest*)
+    private long mLastSampleMs = NEVER;
+    private boolean mInFall;
+    private long mFallStartMs;
+    private long mFallEndMs;
+    private long mFallLenMs;
+    private long mBestEndMs = NEVER;
+    private long mBestLenMs;
 
     public GrabDetector(Params params) {
         mParams = params;
@@ -125,6 +166,11 @@ public final class GrabDetector {
         mPending = false;
         mIgnoreUntilMs = NEVER;
         mNoTouchReportUntilMs = NEVER;
+        mImpactQuietUntilMs = NEVER;
+        mLastSampleMs = NEVER;
+        mInFall = false;
+        mBestEndMs = NEVER;
+        mBestLenMs = 0;
     }
 
     /** {@code contact} is true while a finger is on the screen, false when none is left. */
@@ -156,19 +202,34 @@ public final class GrabDetector {
      *         finished; or, at most once per cool-down, the report of a peak with no recent touch
      */
     public Decision onAccel(long tMs, float x, float y, float z) {
+        final double mag = Math.sqrt((double) x * x + (double) y * y + (double) z * z);
+        // before the cool-down check: a fall that ends inside a cool-down still counts for the next impact
+        trackFreeFall(tMs, mag);
         if (mIgnoreUntilMs != NEVER && tMs < mIgnoreUntilMs) {
             return null;
         }
-        final double dev = Math.abs(
-                Math.sqrt((double) x * x + (double) y * y + (double) z * z) - (double) GRAVITY);
+        final double dev = Math.abs(mag - (double) GRAVITY);
 
         // A hard impact while the phone is in use triggers at once. A grab that ends with the
         // thief standing still, or without a finger on the screen, never meets the pull rule below
-        // (measured on lynx, 2026-10-18); locking after a drop or a hard set-down is accepted.
-        if (mParams.impactPeak > 0 && dev >= mParams.impactPeak) {
-            mPending = false;
-            mIgnoreUntilMs = tMs + mParams.cooldownMs;
-            return new Decision(true, touchedRecently(tMs), (float) dev, false, 0, 0f, true);
+        // (measured on lynx, 2026-10-18). A phone that is set down falls freely for a moment first
+        // and a grab does not (12 grabs, 29 set-downs, 2026-10-25): an impact after a free fall
+        // shorter than freeFallLongMs is a set-down and does not lock.
+        if (mParams.impactPeak > 0 && dev >= mParams.impactPeak
+                && (mImpactQuietUntilMs == NEVER || tMs >= mImpactQuietUntilMs)) {
+            final long fall = freeFallBefore(tMs);
+            // freeFallLongMs of zero or less: every fall is long enough, so every impact locks
+            final boolean lock = fall == 0 || fall >= mParams.freeFallLongMs;
+            if (lock) {
+                mPending = false;
+                mIgnoreUntilMs = tMs + mParams.cooldownMs;
+            } else {
+                // not a cool-down: a pull candidate that is pending keeps being measured, and the
+                // pulse of the same set-down is not reported a second time as a peak without touch
+                mImpactQuietUntilMs = tMs + IMPACT_QUIET_MS;
+                mNoTouchReportUntilMs = tMs + IMPACT_QUIET_MS;
+            }
+            return new Decision(lock, touchedRecently(tMs), (float) dev, false, 0, 0f, true, fall);
         }
 
         if (!mPending) {
@@ -206,6 +267,41 @@ public final class GrabDetector {
                 (float) energy);
     }
 
+    private void trackFreeFall(long tMs, double mag) {
+        final long dt = mLastSampleMs == NEVER ? 0 : tMs - mLastSampleMs;
+        mLastSampleMs = tMs;
+        if (mag < FREE_FALL_MAX) {
+            if (!mInFall) {
+                mInFall = true;
+                mFallStartMs = tMs;
+            }
+            mFallEndMs = tMs;
+            // a run of k samples spans k sample intervals
+            mFallLenMs = tMs - mFallStartMs + dt;
+        } else if (mInFall) {
+            mInFall = false;
+            // keep the longer of this run and an earlier one that is still inside the window
+            if (mFallLenMs >= mBestLenMs || tMs - mBestEndMs > FREE_FALL_WINDOW_MS) {
+                mBestLenMs = mFallLenMs;
+                mBestEndMs = mFallEndMs;
+            }
+        }
+    }
+
+    /** The longest free fall that ended at most FREE_FALL_WINDOW_MS before tMs; 0 if none. */
+    private long freeFallBefore(long tMs) {
+        long best = 0;
+        if (mInFall) {
+            // the impact sample itself is in free fall (an impact peak below FREE_FALL_MAX's
+            // deviation): the run that is going on ends at this sample
+            best = mFallLenMs;
+        }
+        if (mBestEndMs != NEVER && tMs - mBestEndMs <= FREE_FALL_WINDOW_MS) {
+            best = Math.max(best, mBestLenMs);
+        }
+        return best;
+    }
+
     private boolean touchedRecently(long tMs) {
         return mInContact
                 || (mLastContactMs != NEVER && tMs - mLastContactMs <= mParams.touchWindowMs);
