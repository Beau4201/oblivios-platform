From 2674e81186ac1603280708a8332fe151bb0b403c Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 15 Oct 2026 04:54:37 +0200
Subject: [PATCH 7/7] grab: @hide tags on their own line, one message text for
 every credential type

---
 core/java/android/provider/Settings.java      | 40 +++++++++++++++----
 .../SystemUI/res-keyguard/values/strings.xml  |  2 +-
 2 files changed, 33 insertions(+), 9 deletions(-)

diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 1f8b701..e9d6cb9 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -14460,28 +14460,52 @@ public final class Settings {
         // ObliviOS grab detection (ADR-169). Not @Protected on purpose: `adb shell settings
         // put global` must work on a user build to tune the shadow mode and to switch back to it.
 
-        /** 0 off, 1 shadow (log only), 2 active @hide */
+        /**
+         * 0 off, 1 shadow (log only), 2 active
+         * @hide
+         */
         public static final String GRAB_DETECTION_MODE = "grab_detection_mode";
 
-        /** Deviation of the acceleration from gravity that counts as a pull, in 0.1 m/s^2 @hide */
+        /**
+         * Deviation of the acceleration from gravity that counts as a pull, in 0.1 m/s^2
+         * @hide
+         */
         public static final String GRAB_PEAK_DMS2 = "grab_peak_dms2";
 
-        /** The screen must have been touched at most this long before the pull @hide */
+        /**
+         * The screen must have been touched at most this long before the pull
+         * @hide
+         */
         public static final String GRAB_TOUCH_WINDOW_MS = "grab_touch_window_ms";
 
-        /** The touch must end within this long before or after the pull @hide */
+        /**
+         * The touch must end within this long before or after the pull
+         * @hide
+         */
         public static final String GRAB_TOUCH_LOSS_MS = "grab_touch_loss_ms";
 
-        /** Time after the pull that is not measured @hide */
+        /**
+         * Time after the pull that is not measured
+         * @hide
+         */
         public static final String GRAB_SETTLE_MS = "grab_settle_ms";
 
-        /** Length of the window in which the movement after the pull is measured @hide */
+        /**
+         * Length of the window in which the movement after the pull is measured
+         * @hide
+         */
         public static final String GRAB_SUSTAIN_MS = "grab_sustain_ms";
 
-        /** Mean deviation in that window that counts as continued movement, in 0.1 m/s^2 @hide */
+        /**
+         * Mean deviation in that window that counts as continued movement, in 0.1 m/s^2
+         * @hide
+         */
         public static final String GRAB_SUSTAIN_ENERGY_DMS2 = "grab_sustain_energy_dms2";
 
-        /** 1 from a grab lock until the next unlock; read by the message above the PIN entry @hide */
+        /**
+         * 1 from a grab lock until the next unlock; read by the message above the PIN entry
+         * @hide
+         */
         public static final String GRAB_DETECTION_TRIGGERED = "grab_detection_triggered";
 
         /** @hide */
diff --git a/packages/SystemUI/res-keyguard/values/strings.xml b/packages/SystemUI/res-keyguard/values/strings.xml
index 1568422..584299e 100644
--- a/packages/SystemUI/res-keyguard/values/strings.xml
+++ b/packages/SystemUI/res-keyguard/values/strings.xml
@@ -202,7 +202,7 @@
     <string name="kg_prompt_after_user_lockdown_pin">PIN is required after lockdown</string>
     <!-- ObliviOS grab detection (ADR-169): shown above the PIN entry after the phone locked
          itself because it was pulled out of a hand. 60 matches the restart timer of the service. -->
-    <string name="kg_prompt_after_grab">Sudden movement detected. Enter your PIN within 60 seconds or the phone restarts</string>
+    <string name="kg_prompt_after_grab">Sudden movement detected. Unlock within 60 seconds or the phone restarts</string>
 
     <!-- Message shown for pin/pattern/password when we are on bouncer after user triggered lockdown.  [CHAR LIMIT=70] -->
     <string name="kg_prompt_after_user_lockdown_password">Password is required after lockdown</string>
-- 
2.56.0

