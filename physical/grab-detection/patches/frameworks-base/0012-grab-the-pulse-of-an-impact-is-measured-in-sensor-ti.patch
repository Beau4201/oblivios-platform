From 09c2fc9e1af25a8725e7f7dd634fd1d5d8c9482f Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Wed, 4 Nov 2026 20:40:05 +0100
Subject: [PATCH] grab: the pulse of an impact is measured in sensor time, not
 in the time the callback ran

onSensorChanged passed uptimeMillis() of the callback to the detector, so a stalled or batched delivery stretched or squeezed the pulse that frameworks-base/0011 counts (the logged pulseMs of 130 to 150 are not multiples of the 20 ms period). The sample's own timestamp, moved by the sleep, is used; a missing one falls back to the callback time. Host test and two mutants added.
---
 .../com/android/server/grab/GrabDetectionService.java  |  5 +++--
 .../java/com/android/server/grab/GrabDetector.java     | 10 ++++++++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/grab/GrabDetectionService.java b/services/core/java/com/android/server/grab/GrabDetectionService.java
index 2dc0c53..0f6f6c0 100644
--- a/services/core/java/com/android/server/grab/GrabDetectionService.java
+++ b/services/core/java/com/android/server/grab/GrabDetectionService.java
@@ -274,9 +274,10 @@ public class GrabDetectionService extends SystemService {
             if (d == null) {
                 return;
             }
-            // both clocks of the detector are uptimeMillis: the touch event time and this one
+            // both clocks of the detector are uptimeMillis: the touch event time and the time of the sample itself
             try {
-                final GrabDetector.Decision x = d.onAccel(SystemClock.uptimeMillis(),
+                final GrabDetector.Decision x = d.onAccel(GrabDetector.sensorUptimeMs(event.timestamp,
+                        SystemClock.elapsedRealtime(), SystemClock.uptimeMillis()),
                         event.values[0], event.values[1], event.values[2]);
                 if (x != null) {
                     onDecision(x);
diff --git a/services/core/java/com/android/server/grab/GrabDetector.java b/services/core/java/com/android/server/grab/GrabDetector.java
index ce1e684..b5066ac 100644
--- a/services/core/java/com/android/server/grab/GrabDetector.java
+++ b/services/core/java/com/android/server/grab/GrabDetector.java
@@ -322,6 +322,16 @@ public final class GrabDetector {
                 (float) energy);
     }
 
+    /**
+     * The time of a sensor sample on the uptime clock of the touch events: its own timestamp, which is elapsed-realtime
+     * nanoseconds, moved by the time the phone slept. The moment the callback runs is not the sample time: a stalled or
+     * batched delivery would stretch a pulse, or squeeze a real one to nothing. A missing timestamp falls back to the
+     * callback time.
+     */
+    public static long sensorUptimeMs(long eventTimeNs, long elapsedMs, long uptimeMs) {
+        return eventTimeNs > 0 ? eventTimeNs / 1_000_000L - (elapsedMs - uptimeMs) : uptimeMs;
+    }
+
     /**
      * One sample while an impact waits for its pulse (also the one that started the wait): lock when
      * the pulse is long enough, give up when the window ends. The sample that started the wait adds
