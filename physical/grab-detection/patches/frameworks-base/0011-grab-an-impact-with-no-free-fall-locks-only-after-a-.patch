         public Params(float peak, long touchWindowMs, long touchLossMs, long settleMs,
                 long sustainMs, float sustainEnergy, long cooldownMs) {
@@ -75,6 +89,14 @@ public final class GrabDetector {
         public Params(float peak, long touchWindowMs, long touchLossMs, long settleMs,
                 long sustainMs, float sustainEnergy, long cooldownMs, float impactPeak,
                 long freeFallLongMs) {
+            this(peak, touchWindowMs, touchLossMs, settleMs, sustainMs, sustainEnergy, cooldownMs,
