From a0741cb37cff0095ae2a4a9d9fe88f49b9fbff12 Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Fri, 30 Oct 2026 00:15:17 +0100
Subject: [PATCH] grab: an impact with no free fall locks only after a pulse of
 120 ms

Picking the phone up from a table locked it in active mode (owner, 2026-10-29: a deviation of 30.4 m/s^2, no free fall,
the same signature as a grab at its first sample). The recordings on lynx separate them: the 12 grabs are 171 to 310 ms
above 15 m/s^2 and the spikes of 8 pickups and bumps 4 to 13 ms. An impact that comes with no free fall now waits for a
pulse of 120 ms (the rise before the first sample over impactPeak counts, the rest is summed within 400 ms) and locks then;
a spike is refused like a set-down. An impact after a real fall locks at once as before. The impact line of the log gets
pulseMs, so that the next shadow measurement shows the width of every impact. Replayed over the recordings at 50 Hz in
five phases: 12 of 12 grabs lock, the pickup spikes that locked in two of five and one of five phases lock in none.
---
 .../server/grab/GrabDetectionService.java     | 10 ++-
 .../com/android/server/grab/GrabDetector.java | 85 +++++++++++++++++++
 2 files changed, 92 insertions(+), 3 deletions(-)

diff --git a/services/core/java/com/android/server/grab/GrabDetectionService.java b/services/core/java/com/android/server/grab/GrabDetectionService.java
index 7faa24cd3faf..2dc0c53c78f6 100644
--- a/services/core/java/com/android/server/grab/GrabDetectionService.java
+++ b/services/core/java/com/android/server/grab/GrabDetectionService.java
@@ -67,6 +67,9 @@ public class GrabDetectionService extends SystemService {
     // 2). 250 ms is a fall of about 30 cm. Measured set-downs: 16 to 163 ms at 50 Hz, 3 cm to a hard
     // push (2026-10-25); a fall from above 30 cm locks.
     private static final long FREE_FALL_LONG_MS = 250;
+    // an impact with no free fall locks only after a pulse this long (GrabDetector.Params.minPulseMs): a pickup from a table is a
+    // spike of 4 to 13 ms, a grab pulls for 171 ms and more; halfway between the longest pickup (84 ms) and the shortest grab
+    private static final long MIN_PULSE_MS = 120;
     // level 2: the impact peak is this many times the setting, for running (not measured)
     private static final float RELAXED_PEAK_FACTOR = 2f;
     private static final long VIBRATION_MS = 400;
@@ -217,7 +220,8 @@ public class GrabDetectionService extends SystemService {
                 ExtSettings.GRAB_SUSTAIN_ENERGY.get(c) / 10f,
                 COOLDOWN_MS,
                 impactPeak,
-                freeFallLongMs));
+                freeFallLongMs,
+                MIN_PULSE_MS));
         if (!mSensorManager.registerListener(mSensorListener, mAccelerometer,
                 SensorManager.SENSOR_DELAY_GAME, mHandler)) {
             Slog.w(TAG, "accelerometer not registered, not armed");
@@ -293,8 +297,8 @@ public class GrabDetectionService extends SystemService {
         // values in m/s^2, the settings keys take tenths of them
         if (x.impact) {
             Slog.i(TAG, String.format(Locale.ROOT,
-                    "impact peak=%.1f touched=%b fallMs=%d locks=%b level=%d mode=%d",
-                    x.peak, x.touched, x.freeFallMs, x.trigger, mImpactLevel, mode));
+                    "impact peak=%.1f touched=%b fallMs=%d pulseMs=%d locks=%b level=%d mode=%d",
+                    x.peak, x.touched, x.freeFallMs, x.pulseMs, x.trigger, mImpactLevel, mode));
         } else if (!x.touched) {
             Slog.i(TAG, String.format(Locale.ROOT, "peak without touch peak=%.1f mode=%d",
                     x.peak, mode));
diff --git a/services/core/java/com/android/server/grab/GrabDetector.java b/services/core/java/com/android/server/grab/GrabDetector.java
