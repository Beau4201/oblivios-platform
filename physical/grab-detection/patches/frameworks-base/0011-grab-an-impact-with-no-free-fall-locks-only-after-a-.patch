+            this.pulseMs = pulseMs;
             this.freeFallMs = freeFallMs;
             this.impact = impact;
             this.trigger = trigger;
@@ -144,6 +174,15 @@ public final class GrabDetector {
     private long mNoTouchReportUntilMs = NEVER;
     private long mImpactQuietUntilMs = NEVER;
 
+    // an impact with no free fall that waits for its minimum pulse (Params.minPulseMs)
+    private boolean mPulseWait;
+    private long mPulseStartMs;
+    private long mPulseLastMs;
+    private long mPulseSumMs;
+    private double mPulsePeak;
+    /** How long the magnitude has been at or above PULSE_MAG without a sample below it, up to the last sample. */
+    private long mAboveRunMs;
+
     // free fall: the run of samples below FREE_FALL_MAX that is going on (mFall*), and the longest
     // finished run that ended inside the window (mBest*)
     private long mLastSampleMs = NEVER;
@@ -167,6 +206,8 @@ public final class GrabDetector {
         mIgnoreUntilMs = NEVER;
         mNoTouchReportUntilMs = NEVER;
         mImpactQuietUntilMs = NEVER;
+        mPulseWait = false;
+        mAboveRunMs = 0;
         mLastSampleMs = NEVER;
         mInFall = false;
         mBestEndMs = NEVER;
@@ -205,6 +246,9 @@ public final class GrabDetector {
         final double mag = Math.sqrt((double) x * x + (double) y * y + (double) z * z);
         // before the cool-down check: a fall that ends inside a cool-down still counts for the next impact
         trackFreeFall(tMs, mag);
+        if (mPulseWait) {
+            return pulseSample(tMs, mag);
+        }
         if (mIgnoreUntilMs != NEVER && tMs < mIgnoreUntilMs) {
             return null;
         }
@@ -220,6 +264,17 @@ public final class GrabDetector {
             final long fall = freeFallBefore(tMs);
             // freeFallLongMs of zero or less: every fall is long enough, so every impact locks
             final boolean lock = fall == 0 || fall >= mParams.freeFallLongMs;
+            // fall == 0 is always a lock: freeFallLongMs only holds back an impact after a short fall
+            if (fall == 0 && mParams.minPulseMs > 0) {
+                // a grab has a pulse of 100 ms and more, a pickup or a bump is over in a few: the verdict waits for it
+                mPulseWait = true;
+                mPulseStartMs = tMs;
+                mPulseLastMs = tMs;
+                // the pulse began before the first sample over impactPeak: the rise counts
+                mPulseSumMs = mAboveRunMs;
+                mPulsePeak = dev;
+                return mPulseSumMs >= mParams.minPulseMs ? pulseSample(tMs, mag) : null;
+            }
             if (lock) {
                 mPending = false;
                 mIgnoreUntilMs = tMs + mParams.cooldownMs;
@@ -267,9 +322,39 @@ public final class GrabDetector {
                 (float) energy);
     }
 
+    /**
+     * One sample while an impact waits for its pulse (also the one that started the wait): lock when
+     * the pulse is long enough, give up when the window ends. The sample that started the wait adds
+     * nothing, its time is in the run before it.
+     */
+    private Decision pulseSample(long tMs, double mag) {
+        final long dt = tMs - mPulseLastMs;
+        mPulseLastMs = tMs;
+        mPulsePeak = Math.max(mPulsePeak, Math.abs(mag - (double) GRAVITY));
+        if (mag >= PULSE_MAG) {
+            mPulseSumMs += dt;
+        }
+        final boolean longEnough = mPulseSumMs >= mParams.minPulseMs;
+        if (!longEnough && tMs - mPulseStartMs < PULSE_WINDOW_MS) {
+            return null;
+        }
+        mPulseWait = false;
+        if (longEnough) {
+            mPending = false;
+            mIgnoreUntilMs = tMs + mParams.cooldownMs;
+        } else {
+            // as a set-down: not a cool-down, and the rest of the pulse is not reported again
+            mImpactQuietUntilMs = tMs + IMPACT_QUIET_MS;
+            mNoTouchReportUntilMs = tMs + IMPACT_QUIET_MS;
+        }
+        return new Decision(longEnough, touchedRecently(tMs), (float) mPulsePeak, false, 0, 0f, true,
+                0L, mPulseSumMs);
+    }
+
     private void trackFreeFall(long tMs, double mag) {
         final long dt = mLastSampleMs == NEVER ? 0 : tMs - mLastSampleMs;
         mLastSampleMs = tMs;
+        mAboveRunMs = mag >= PULSE_MAG ? mAboveRunMs + dt : 0;
         if (mag < FREE_FALL_MAX) {
             if (!mInFall) {
                 mInFall = true;
