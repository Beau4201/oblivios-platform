     public static final class Params {
@@ -59,6 +63,16 @@ public final class GrabDetector {
          * less turns the rule off: every impact locks.
          */
         public final long freeFallLongMs;
+        /**
+         * An impact that came with no free fall locks only when the magnitude has been at or above
+         * {@link #PULSE_MAG} for this long: the rise before the first sample over impactPeak counts,
+         * and the time after it is summed within {@link #PULSE_WINDOW_MS}. A grab pulls the phone for
