 3 files changed, 21 insertions(+)

diff --git a/packages/SystemUI/res-keyguard/values/strings.xml b/packages/SystemUI/res-keyguard/values/strings.xml
index 9efbb58..1568422 100644
--- a/packages/SystemUI/res-keyguard/values/strings.xml
+++ b/packages/SystemUI/res-keyguard/values/strings.xml
@@ -200,6 +200,9 @@
 
     <!-- Message shown for pin/pattern/password when we are on bouncer after user triggered lockdown.  [CHAR LIMIT=70] -->
     <string name="kg_prompt_after_user_lockdown_pin">PIN is required after lockdown</string>
+    <!-- FreeholdOS grab detection (ADR-169): shown above the PIN entry after the phone locked
+         itself because it was pulled out of a hand. 60 matches the restart timer of the service. -->
+    <string name="kg_prompt_after_grab">Sudden movement detected. Enter your PIN within 60 seconds or the phone restarts</string>
 
     <!-- Message shown for pin/pattern/password when we are on bouncer after user triggered lockdown.  [CHAR LIMIT=70] -->
     <string name="kg_prompt_after_user_lockdown_password">Password is required after lockdown</string>
