From f107e3be8c5d1fce037ee57b45383b8146bbf9a7 Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Wed, 21 Oct 2026 16:24:26 +0200
Subject: [PATCH] passwords: ship PasswordsApp on every Pixel target via
 device-common.mk

---
 config/mk/google_devices/common/device-common.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
index e9b9850..f83bad1 100644
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -129,3 +129,9 @@ PRODUCT_PACKAGES += \
 # is defined in vendor/freeholdos/exit; it pulls in its privapp allow-list through "required".
 PRODUCT_PACKAGES_DEBUG += \
     ExitProbe
+
+# FreeholdOS Passwords app (ADR-185): the local password manager, autofill service and credential provider. It is
+# unprivileged. The module is defined in vendor/freeholdos/passwords and pulls in the prebuilt Rust core libvault_core.
+# Kept in the common file like Guardian, AirPods and the Data Map, so every Pixel target carries it.
+PRODUCT_PACKAGES += \
+    PasswordsApp
-- 
2.56.0

