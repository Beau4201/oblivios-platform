From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@oblivios.local>
Date: Thu, 22 Oct 2026 18:10:56 +0200
Subject: [PATCH] passwords: ship PasswordsApp on every Pixel target via
 device-common.mk

---
 config/mk/google_devices/common/device-common.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -130,3 +130,9 @@ PRODUCT_PACKAGES_DEBUG += \
 PRODUCT_PACKAGES += \
     exitd \
     ExitApp
+
+# ObliviOS Passwords app (ADR-185): the local password manager, autofill service and credential provider. It is
+# unprivileged. The module is defined in vendor/oblivios/passwords and pulls in the prebuilt Rust core libvault_core.
+# Kept in the common file like AirPods and the Data Map, so every Pixel target carries it.
+PRODUCT_PACKAGES += \
+    PasswordsApp
