From 2db888e531c234eb8c8f107c6cfe5279e8c6b00d Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@oblivios.local>
Date: Wed, 21 Oct 2026 16:24:26 +0200
Subject: [PATCH] passwords: make the Passwords app the default autofill
 service and credential provider

---
 core/res/res/values/config.xml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index 9124ee9..16126c6 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -5128,7 +5128,7 @@
          without explicit consent of the user. If no autofill service with the
           specified name exists on the device, autofill will be disabled by default.
     -->
-    <string name="config_defaultAutofillService" translatable="false"></string>
+    <string name="config_defaultAutofillService" translatable="false">org.oblivios.passwords/org.oblivios.passwords.fill.PasswordsAutofillService</string>
 
     <!-- The component name, flattened to a string, for the default field classification service
          to  enabled for a user. This service must be trusted, as it can be activated
@@ -5416,6 +5416,7 @@
      See android.credentials.CredentialManager
     -->
     <string-array name="config_enabledCredentialProviderService" translatable="false">
+        <item>org.oblivios.passwords/org.oblivios.passwords.fill.PasswordsCredentialProviderService</item>
     </string-array>
 
     <!-- The component name(s), flattened to a string, for the system's primary credential manager
@@ -5426,6 +5427,7 @@
      See android.credentials.CredentialManager
     -->
     <string-array name="config_primaryCredentialProviderService" translatable="false">
+        <item>org.oblivios.passwords/org.oblivios.passwords.fill.PasswordsCredentialProviderService</item>
     </string-array>
 
     <!-- The package name for the system's smartspace service.
-- 
2.56.0

