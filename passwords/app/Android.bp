// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ADR-185. Not platform-signed and not platform_apis: the app uses only the system SDK. No network permission
// (tools/check-static.sh). The Compose libraries are added with the screens (Task 14); the services and the defaults
// with Tasks 13 and 16.
android_app {
    name: "PasswordsApp",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    // The logo pack (logos/domains.tsv, logos/icons.tsv) is built by passwords/logos/build-pack.py; without it the app
    // shows the generated patterns only.
    asset_dirs: ["assets"],
    srcs: ["src/main/kotlin/**/*.kt"],
    sdk_version: "system_current",
    jni_libs: ["libvault_core"],
    static_libs: [
        "androidx.credentials_credentials",
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.navigationevent_navigationevent",
        "androidx.navigationevent_navigationevent-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-geometry",
        "androidx.compose.ui_ui-unit",
        "androidx.compose.ui_ui-text",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.compose.material3_material3",
        "androidx.lifecycle_lifecycle-common",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.savedstate_savedstate",
    ],
    optimize: {
        enabled: false,
    },
}
