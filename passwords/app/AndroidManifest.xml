<!--
  Passwords app (ADR-185). It declares no network permission and no radio permission (check-static.sh fails the build
  otherwise), is not backed up, and keeps every component in its own process.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.oblivios.passwords">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- The icons of the apps an entry is linked to (apps that have a launcher entry); no broad package permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The browsers: which package may report a website is decided on them (fill/Origin.kt), and the settings list them. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="org.oblivios.passwords.PasswordsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/pm_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/pm_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Passwords">

        <activity
            android:name="org.oblivios.passwords.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|fontScale|density|layoutDirection|locale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.oblivios.passwords.fill.FillAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Passwords.Transparent" />

        <activity
            android:name="org.oblivios.passwords.fill.SaveAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Passwords.Transparent" />

        <service
            android:name="org.oblivios.passwords.fill.PasswordsAutofillService"
            android:exported="true"
            android:label="@string/pm_app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/pm_autofill_service" />
        </service>

        <activity
            android:name="org.oblivios.passwords.fill.CredentialAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Passwords.Transparent" />

        <service
            android:name="org.oblivios.passwords.fill.PasswordsCredentialProviderService"
            android:exported="true"
            android:label="@string/pm_app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/pm_credential_provider" />
        </service>
    </application>
</manifest>
