<!-- The launcher icon: a password field as it looks while typing, in fixed neutral greys (light grey ground, slate field), the
     same on every wallpaper (docs/design/app-logos-2026-10-29.html in oblivios-foundation, ADR-203). The themed form is the
     same drawing in one colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
