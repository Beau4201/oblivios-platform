From 6ebe8024291a5c003f0615a896574afbb9cbf29b Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Mon, 28 Sep 2026 17:42:30 +0200
Subject: [PATCH] guardian: ship on every Pixel target via device-common.mk

The lynx-only PRODUCT_PACKAGES entry left stallion without Guardian.
device-common.mk is included by every Pixel platform (gs101 directly, the
rest through device-common-gs201-plus.mk), so one entry covers them all.
---
 config/mk/google_devices/common/device-common.mk | 7 +++++++
 config/mk/google_devices/device/lynx/device.mk   | 5 -----
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
index 20355048..3ad95440 100644
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -65,3 +65,10 @@ ifeq ($(filter lynx tangorpro,$(TARGET_PRODUCT)),)
 endif
 
 PRODUCT_PACKAGES += restrict-pixel-health-association
+
+# SovereignOS: Guardian REVOKE_BACKGROUND_LOCATION ships on every Pixel target
+# (real hardware, no test fixture). Kept here, not per device: the per-device
+# entry for lynx silently left stallion without Guardian (2026-09-28).
+PRODUCT_PACKAGES += \
+    GuardianApp \
+    privapp-permissions-org.sovereignos.guardian.xml
diff --git a/config/mk/google_devices/device/lynx/device.mk b/config/mk/google_devices/device/lynx/device.mk
index a7a4bb81..a2c74f94 100644
--- a/config/mk/google_devices/device/lynx/device.mk
+++ b/config/mk/google_devices/device/lynx/device.mk
@@ -4,8 +4,3 @@ TARGET_KERNEL_DIR ?= $(RELEASE_KERNEL_LYNX_DIR)
 TARGET_BOARD_KERNEL_HEADERS ?= $(RELEASE_KERNEL_LYNX_DIR)/kernel-headers
 
 include vendor/adevtool/config/mk/google_devices/platform/gs201/device.mk
-
-# SovereignOS: Guardian REVOKE_BACKGROUND_LOCATION (real hardware, no test fixture)
-PRODUCT_PACKAGES += \
-    GuardianApp \
-    privapp-permissions-org.sovereignos.guardian.xml
-- 
2.39.5

