From a271270e7c39b0c88c2ffa980c5bf546c7143c75 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 6 Aug 2026 02:44:10 +0200
Subject: [PATCH 2/3] sovereignos: allow Guardian artifacts past generic_system.mk
 path requirement

sdk_phone64_x86_64 relaxes PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS but
still rejects unlisted files inside generic_system.mk own requirement.
Found by Task 7 real build (soong_build error: internal error: Device
makefile produces files inside build/make/target/product/generic_system.mk
artifact path requirement).
---
 product/base_phone.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/product/base_phone.mk b/product/base_phone.mk
index 2e227ef0..83fb6b68 100644
--- a/product/base_phone.mk
+++ b/product/base_phone.mk
@@ -32,6 +32,13 @@ PRODUCT_PACKAGES += \
     GuardianLocationFixture \
     privapp-permissions-org.sovereignos.guardian.xml
 
+# generic_system.mk's artifact path requirement otherwise rejects these --
+# real Soong error found by Task 7's build, not a general GSI assumption.
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/priv-app/GuardianApp/% \
+    system/app/GuardianLocationFixture/% \
+    system/etc/permissions/privapp-permissions-org.sovereignos.guardian.xml
+
 PRODUCT_COPY_FILES += \
     device/generic/goldfish/phone/overlay/frameworks/base/packages/overlays/GoldfishSkinConfig/readme.txt:$(TARGET_COPY_OUT_DATA)/misc/GoldfishSkinConfig \
     device/generic/goldfish/data/etc/handheld_core_hardware.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/handheld_core_hardware.xml \
-- 
2.39.5

