package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_import {
    name: "guardian-core-prebuilt",
    jars: ["../core/guardian-core.jar"],
}

android_app {
    name: "GuardianApp",
    manifest: "AndroidManifest.xml",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "../core/GuardianUiController.kt",
        "../core/GuardianUiState.kt",
    ],
    static_libs: [
        "guardian-core-prebuilt",
        // Confirmed against packages/apps/EyeDropper/Android.bp (the smallest of ten
        // in-tree Compose consumers) for Task 6's Jetpack Compose UI port.
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-geometry",
        "androidx.compose.ui_ui-unit",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.lifecycle_lifecycle-common",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.savedstate_savedstate",
        // NOT independently SSH-confirmed against the real tree (unlike the list
        // above) — inferred by the same "<mavenGroupId>_<artifactId>" naming pattern
        // evidenced by every entry above, because Guardian's ported UI directly
        // imports androidx.compose.animation(.core) and androidx.compose.ui.text
        // symbols (button press/hover spring animation, disclosure expand/collapse,
        // FontWeight/TextAlign/TextDecoration) that EyeDropper's own confirmed list
        // does not cover. If Task 7's real Soong build reports these module names
        // wrong, re-run Step 1's grep against a Compose consumer that also animates
        // and styles text, not just EyeDropper.
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.compose.ui_ui-text",
    ],
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-org.aegisos.guardian.xml",
    src: "privapp-permissions-org.aegisos.guardian.xml",
    sub_dir: "permissions",
}
