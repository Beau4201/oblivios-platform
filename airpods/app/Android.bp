// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ADR-118: AirPodsApp is deliberately NOT platform-signed and NOT platform_apis.
// - The only privileged Bluetooth call it needs (BluetoothDevice#setAirPodsIdentity,
//   and later setAirPodsMetadata) is a @SystemApi, so system_current is enough.
// - Its one hidden-API use (the BluetoothSocket L2CAP constructor) is covered by a
//   single-package sysconfig entry (hidden-api-whitelisted-app-*.xml below), not by
//   a platform signature, so a compromise of this app does not inherit the platform
//   key's identity. No `certificate:` line: the default development certificate is
//   replaced by the release key at signing, never by the platform key.
android_app {
    name: "AirPodsApp",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "src/**/*.aidl",
    ],
    // The DeviceSettings contract of the Settings Bluetooth page is vendored under
    // src/com/android/settingslib/bluetooth/devicesettings/ (40 files, byte-identical to the
    // build tree): SettingsLib is a platform-API module and Soong refuses it as a static
    // dependency of a system_current app (build/soong/java/base.go, sdkLinkType check).
    aidl: {
        local_include_dirs: ["src"],
    },
    static_libs: [
        "airpods-core-prebuilt",
        "androidx.annotation_annotation",
        "guava",
        "SettingsLibSettingsTheme",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibPreference",
        "SettingsLibSegmentedButtonPreference",
        "SettingsLibSliderPreference",
        "SettingsLibFooterPreference",
        "androidx.preference_preference",
        "androidx.fragment_fragment",
    ],
    sdk_version: "system_current",
    privileged: true,
    required: [
        "default-permissions-org.freeholdos.airpods.xml",
    ],
}

// The default grant of BLUETOOTH_CONNECT (the app has no screen that asks for it). Read from
// /system/etc/default-permissions by DefaultPermissionGrantPolicy, as for PrintRecommendationService.
prebuilt_etc {
    name: "default-permissions-org.freeholdos.airpods.xml",
    src: "default-permissions-org.freeholdos.airpods.xml",
    sub_dir: "default-permissions",
}

prebuilt_etc {
    name: "privapp-permissions-org.freeholdos.airpods.xml",
    src: "privapp-permissions-org.freeholdos.airpods.xml",
    sub_dir: "permissions",
}

// Read by SystemConfig only from /system/etc/sysconfig on purpose: the /product
// path is flagged by upstream for removal (b/157203468), see
// the internal record "airpods nonsdk api exemption investigation" (not published).
prebuilt_etc {
    name: "hidden-api-whitelisted-app-org.freeholdos.airpods.xml",
    src: "hidden-api-whitelisted-app-org.freeholdos.airpods.xml",
    sub_dir: "sysconfig",
}
