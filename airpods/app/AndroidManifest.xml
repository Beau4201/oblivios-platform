<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sovereignos.airpods">

    <!-- Every permission here is justified in
         docs/research/airpods-platform-api-verification.md (sovereignos-foundation).
         Deliberately absent: BLUETOOTH_PRIVILEGED (ADR-117), any network
         permission, and every Guardian permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY" />
    <!-- The session runs in a foreground service of type connectedDevice so the process is not
         frozen as a cached app (a cached app does not run). The service is started from the
         broadcast receiver and at process start, both in the background, which needs the privileged
         START_FOREGROUND_SERVICES_FROM_BACKGROUND (named in the privapp allow-list). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!-- Needed to hand Settings a persistable read grant on the icon URIs (package visibility). -->
    <queries>
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".app.AirPodsApplication"
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Bound by Settings (system uid, which may bind unexported components). -->
        <service
            android:name=".app.AirPodsConfigService"
            android:exported="false" />
        <service
            android:name=".app.AirPodsSettingsService"
            android:exported="false" />

        <!-- Keeps the process alive while the recognised AirPods are connected; not exported. -->
        <service
            android:name=".app.AirPodsSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- Ring icons for Settings; Settings gets a persistable read grant, nobody else can read. -->
        <provider
            android:name=".app.AirPodsIconProvider"
            android:authorities="org.sovereignos.airpods.icons"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Starts the process, the AirPods session and the retry of pending metadata writes when an
             AirPods' link comes up or goes away or its bond changes. All three are protected
             broadcasts (only the system can send them); the
             Bluetooth process sends them as its own uid, so the receiver must be exported. -->
        <receiver
            android:name=".app.ConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.BOND_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
