<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.sovereignos.airpods">

    <!-- Every permission here is justified in
         docs/research/airpods-platform-api-verification.md (sovereignos-foundation).
         Deliberately absent: BLUETOOTH_PRIVILEGED (ADR-117), any network
         permission, and every Guardian permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- POST_NOTIFICATIONS is deliberately absent: the app shows no notification, not even the one the
         foreground service below must carry (the owner wants none; a service without the grant keeps
         running and its notification is not shown). The connection sheet uses no notification and no
         full-screen intent (ADR-137). -->
    <!-- The session runs in a foreground service of type connectedDevice so the process is not
         frozen as a cached app (a cached app does not run). The service is started from the
         broadcast receiver and at process start, both in the background, which needs the privileged
         START_FOREGROUND_SERVICES_FROM_BACKGROUND (named in the privapp allow-list). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!-- ADR-136: ConnectionSheetTrigger starts the app's own sheet when the case opens and the phone is unlocked. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />

    <!-- Needed to hand Settings a persistable read grant on the icon URIs (package visibility). -->
    <queries>
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".app.AirPodsApplication"
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Bound by Settings (system uid, which may bind unexported components). -->
        <service
            android:name=".app.AirPodsConfigService"
            android:exported="false" />
        <service
            android:name=".app.AirPodsSettingsService"
            android:exported="false" />

        <!-- Brought in by the androidx libraries of SettingsLib: exported and not needed (no baseline profile is installed
             at run time). Removed so that the only exported component of the app stays ConnectionReceiver. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- Our own AirPods page. Not exported: Settings (system uid) opens it with an explicit intent
             from the "All AirPods settings" row of its device page. -->
        <activity
            android:name=".app.AllSettingsActivity"
            android:exported="false"
            android:label="@string/airpods_page_title"
            android:theme="@style/Theme.SubSettingsBase.Expressive" />

        <!-- The connection sheet: not exported; started only by ConnectionSheetTrigger on an unlocked phone (ADR-136,
             ADR-137). It is not shown over the lock screen. -->
        <activity
            android:name=".app.ConnectionSheetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.AirPodsSheet" />

        <!-- Keeps the process alive while the recognised AirPods are connected; not exported. -->
        <service
            android:name=".app.AirPodsSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- Ring icons for Settings; Settings gets a persistable read grant, nobody else can read. -->
        <provider
            android:name=".app.AirPodsIconProvider"
            android:authorities="org.sovereignos.airpods.icons"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Starts the process, the AirPods session and the retry of pending metadata writes when an
             AirPods' link comes up or goes away or its bond changes, and once after boot (the
             process then finds a link that came up while the phone was still locked: those
             broadcasts are not delivered before the first unlock). All four are protected
             broadcasts (only the system can send them); the Bluetooth process sends the first three
             as its own uid, so the receiver must be exported. -->
        <receiver
            android:name=".app.ConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.BOND_STATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
