<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sovereignos.airpods.debugharness">

    <!-- Userdebug/eng only (PRODUCT_PACKAGES_DEBUG), ADR-120. Holds the identity permission:
         the positive paths of AIR-029..031 and AIR-036. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">
        <provider
            android:name="org.sovereignos.airpods.debugharness.HarnessProvider"
            android:authorities="org.sovereignos.airpods.debugharness"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
