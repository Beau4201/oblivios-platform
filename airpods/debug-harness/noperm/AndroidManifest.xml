<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sovereignos.airpods.debugharness.noperm">

    <!-- Userdebug/eng only, ADR-120. Holds BLUETOOTH_CONNECT and nothing else, so a refusal
         is attributable to MANAGE_AIRPODS_IDENTITY (AIR-032, AIR-036). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">
        <provider
            android:name="org.sovereignos.airpods.debugharness.HarnessProvider"
            android:authorities="org.sovereignos.airpods.debugharness.noperm"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
