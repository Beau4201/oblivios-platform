package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ADR-120: userdebug-only validation harness for AIR-029..032 and AIR-036. Wired through
// PRODUCT_PACKAGES_DEBUG (vendor/adevtool patch 0002), so a `user` image never contains
// it; tools/build-vm/check-required-packages.sh enforces that. Same sources, three
// permission sets. All three are priv-apps with the same single-package hidden-API
// exemption as AirPodsApp, so a refusal is caused by the permission and not by app class.

android_app {
    name: "AirPodsDebugHarness",
    manifest: "holder/AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    sdk_version: "system_current",
    privileged: true,
    required: [
        "privapp-permissions-org.sovereignos.airpods.debugharness.xml",
        "hidden-api-whitelisted-app-org.sovereignos.airpods.debugharness.xml",
    ],
}

android_app {
    name: "AirPodsProbeNoPerm",
    manifest: "noperm/AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    sdk_version: "system_current",
    privileged: true,
    required: ["hidden-api-whitelisted-app-org.sovereignos.airpods.debugharness.xml"],
}

android_app {
    name: "AirPodsProbeBtPriv",
    manifest: "btpriv/AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    sdk_version: "system_current",
    privileged: true,
    required: [
        "privapp-permissions-org.sovereignos.airpods.debugharness.xml",
        "hidden-api-whitelisted-app-org.sovereignos.airpods.debugharness.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-org.sovereignos.airpods.debugharness.xml",
    src: "privapp-permissions-org.sovereignos.airpods.debugharness.xml",
    sub_dir: "permissions",
}

// Same mechanism and same /system/etc/sysconfig location as AirPodsApp (ADR-118): all three
// apps get the same hidden-API standing, so only the permission set differs between them.
prebuilt_etc {
    name: "hidden-api-whitelisted-app-org.sovereignos.airpods.debugharness.xml",
    src: "hidden-api-whitelisted-app-org.sovereignos.airpods.debugharness.xml",
    sub_dir: "sysconfig",
}
