<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sovereignos.airpods.debugharness.btpriv">

    <!-- Userdebug/eng only, ADR-120. Holds BLUETOOTH_PRIVILEGED but NOT our permission, to
         prove the broad permission is not enough (AIR-032, AIR-036). Never ship this. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">
        <provider
            android:name="org.sovereignos.airpods.debugharness.HarnessProvider"
            android:authorities="org.sovereignos.airpods.debugharness.btpriv"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
