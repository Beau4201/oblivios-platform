From d0e538f28aacfb999e303852e9d8ef68eaa3fc51 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Fri, 2 Oct 2026 12:54:56 +0200
Subject: [PATCH] sovereignos: let a label inside a segmented button wrap to
 two lines

At font scale 1.3 "Transparency" was cut to "Transparen..." and at 2.0 to "Transp...", because
a button in labelInsideButton mode was single-line. It may now use two lines, hyphenate a word
that is wider than the button, and the buttons of the row take the height of the tallest one so
the row stays even. Stock icon-only rendering is unchanged.
---
 .../settingslib/widget/SegmentedButtonPreference.kt | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/packages/SettingsLib/SegmentedButtonPreference/src/com/android/settingslib/widget/SegmentedButtonPreference.kt b/packages/SettingsLib/SegmentedButtonPreference/src/com/android/settingslib/widget/SegmentedButtonPreference.kt
index a3240e2a77e6..dae2e8114eba 100644
--- a/packages/SettingsLib/SegmentedButtonPreference/src/com/android/settingslib/widget/SegmentedButtonPreference.kt
+++ b/packages/SettingsLib/SegmentedButtonPreference/src/com/android/settingslib/widget/SegmentedButtonPreference.kt
@@ -19,8 +19,10 @@ package com.android.settingslib.widget
 import android.content.Context
 import android.graphics.Typeface
 import android.graphics.drawable.Drawable
+import android.text.Layout
 import android.util.AttributeSet
 import android.view.View
+import android.view.ViewGroup
 import android.widget.TextView
 import androidx.annotation.DrawableRes
 import androidx.core.view.isGone
@@ -191,6 +193,14 @@ class SegmentedButtonPreference @JvmOverloads constructor(
                 val density = it.resources.displayMetrics.density
                 val padding = (LABEL_INSIDE_PADDING_DP * density).toInt()
                 it.setPaddingRelative(padding, it.paddingTop, padding, it.paddingBottom)
+                // At a large font scale one line is not enough: "Transparency" was cut to
+                // "Transparen..." at 1.3 and "Transp..." at 2.0 (seen on a Pixel 7a). Allow two
+                // lines and hyphenation for a word that is wider than the button, and let the
+                // buttons of the row share the height of the tallest one so the row stays even.
+                it.isSingleLine = false
+                it.maxLines = LABEL_INSIDE_MAX_LINES
+                it.hyphenationFrequency = Layout.HYPHENATION_FREQUENCY_NORMAL
+                it.layoutParams = it.layoutParams.apply { height = ViewGroup.LayoutParams.MATCH_PARENT }
             }
         } else {
             button?.text = null
@@ -248,5 +258,8 @@ class SegmentedButtonPreference @JvmOverloads constructor(
     private companion object {
         // SovereignOS: horizontal padding of a button that shows its label (labelInsideButton).
         const val LABEL_INSIDE_PADDING_DP = 8
+
+        // SovereignOS: lines a label may use before it is cut (labelInsideButton).
+        const val LABEL_INSIDE_MAX_LINES = 2
     }
 }
-- 
