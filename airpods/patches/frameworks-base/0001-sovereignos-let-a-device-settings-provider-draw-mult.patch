--- a/packages/SettingsLib/SegmentedButtonPreference/src/com/android/settingslib/widget/SegmentedButtonPreference.kt
+++ b/packages/SettingsLib/SegmentedButtonPreference/src/com/android/settingslib/widget/SegmentedButtonPreference.kt
@@ -19,8 +19,10 @@ package com.android.settingslib.widget
 import android.content.Context
 import android.graphics.Typeface
 import android.graphics.drawable.Drawable
+import android.text.Layout
 import android.util.AttributeSet
 import android.view.View
+import android.view.ViewGroup
 import android.widget.TextView
 import androidx.annotation.DrawableRes
 import androidx.core.view.isGone
@@ -49,6 +51,11 @@ class SegmentedButtonPreference @JvmOverloads constructor(
     // Default checked button
     private var checkedIndex: Int = -1
 
+    // SovereignOS: opt-in. Draw the label inside each button (no icon) and hide the separate label
+    // row below the group. The approved AirPods design shows the listening-mode text in the
+    // buttons.
+    private var labelInsideButton: Boolean = false
+
     // Internal button click listener to handle the button checked programmatically.
     private val internalButtonClickListener =
         object : MaterialButtonToggleGroup.OnButtonCheckedListener {
@@ -79,6 +86,8 @@ class SegmentedButtonPreference @JvmOverloads constructor(
         buttonLabels.add(1, holder.findViewById(R.id.button_2_text) as TextView)
         buttonLabels.add(2, holder.findViewById(R.id.button_3_text) as TextView)
         buttonLabels.add(3, holder.findViewById(R.id.button_4_text) as TextView)
+        // SovereignOS: always assign so a recycled holder resets when the mode changes.
+        holder.findViewById(R.id.button_group_text)?.isGone = labelInsideButton
 
         // Apply stored data
         applyButtonSetupData()
@@ -105,6 +114,14 @@ class SegmentedButtonPreference @JvmOverloads constructor(
         notifyChanged()
     }
 
+    fun setLabelInsideButton(inside: Boolean) {
+        if (inside == labelInsideButton) {
+            return
+        }
+        labelInsideButton = inside
+        notifyChanged()
+    }
+
     fun setButtonVisibility(index: Int, visible: Boolean) {
         buttonVisibilityData.put(index, visible)
         notifyChanged()
@@ -164,12 +181,33 @@ class SegmentedButtonPreference @JvmOverloads constructor(
     }
 
     private fun applyButtonSetupData(index: Int, text: String, icon: SegmentedButtonIcon) {
-        when (icon) {
-            is SegmentedButtonIcon.ResourceIcon ->
-                (buttonGroup?.getChildAt(index) as? MaterialButton)?.setIconResource(icon.resId)
-
-            is SegmentedButtonIcon.DrawableIcon ->
-                (buttonGroup?.getChildAt(index) as? MaterialButton)?.icon = icon.drawable
+        val button = buttonGroup?.getChildAt(index) as? MaterialButton
+        if (labelInsideButton) {
+            // SovereignOS: the label is the button content; the provider's icon is not shown.
+            button?.icon = null
+            button?.text = text
+            // The default text-button padding (24 dp on each side) cuts a label such as
+            // "Transparency" to "Transpare..." when three buttons share one row; the approved
+            // design shows the whole label.
+            button?.let {
+                val density = it.resources.displayMetrics.density
+                val padding = (LABEL_INSIDE_PADDING_DP * density).toInt()
+                it.setPaddingRelative(padding, it.paddingTop, padding, it.paddingBottom)
+                // At a large font scale one line is not enough: "Transparency" was cut to
+                // "Transparen..." at 1.3 and "Transp..." at 2.0 (seen on a Pixel 7a). Allow two
+                // lines and hyphenation for a word that is wider than the button, and let the
+                // buttons of the row share the height of the tallest one so the row stays even.
+                it.isSingleLine = false
+                it.maxLines = LABEL_INSIDE_MAX_LINES
+                it.hyphenationFrequency = Layout.HYPHENATION_FREQUENCY_NORMAL
+                it.layoutParams = it.layoutParams.apply { height = ViewGroup.LayoutParams.MATCH_PARENT }
+            }
+        } else {
+            button?.text = null
+            when (icon) {
+                is SegmentedButtonIcon.ResourceIcon -> button?.setIconResource(icon.resId)
+                is SegmentedButtonIcon.DrawableIcon -> button?.icon = icon.drawable
+            }
         }
         // Set content description to avoid the button label is not read by TalkBack.
         buttonGroup?.getChildAt(index)?.contentDescription = text
@@ -216,4 +254,12 @@ class SegmentedButtonPreference @JvmOverloads constructor(
 
         data class ResourceIcon(@param:DrawableRes val resId: Int) : SegmentedButtonIcon
     }
+
+    private companion object {
+        // SovereignOS: horizontal padding of a button that shows its label (labelInsideButton).
+        const val LABEL_INSIDE_PADDING_DP = 8
+
+        // SovereignOS: lines a label may use before it is cut (labelInsideButton).
+        const val LABEL_INSIDE_MAX_LINES = 2
+    }
 }
