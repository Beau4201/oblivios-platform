 .../devicesettings/DeviceSettingContract.kt   |  7 +++
 .../repository/DeviceSettingRepository.kt     |  6 +-
 .../shared/model/DeviceSettingModel.kt        |  8 ++-
 .../repository/DeviceSettingRepositoryTest.kt | 17 ++++++
