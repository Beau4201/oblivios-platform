+package com.android.bluetooth.btservice;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * SovereignOS ADR-135: what {@link AdapterService#setAirPodsAlias} may write. The rule is the one of
+ * the AirPods app's {@code AapCodec.isValidName}: 1 to {@value #MAX_BYTES} UTF-8 bytes of visible text,
+ * no leading or trailing white space, and none of the control, format, private-use, surrogate,
+ * unassigned, line-separator or paragraph-separator characters. Also refused: a name that starts or ends in
+ * a space separator (String#strip leaves a no-break space) and the code points that draw nothing (Hangul
+ * fillers, Khmer inherent vowels, the Braille blank).
+ */
+final class AirPodsAliasPolicy {
+    static final int MAX_BYTES = 32;
+
+    private AirPodsAliasPolicy() {}
+
+    static boolean isAllowed(String alias) {
+        if (alias == null) {
+            return false;
+        }
+        int bytes = alias.getBytes(StandardCharsets.UTF_8).length;
+        if (bytes < 1 || bytes > MAX_BYTES || !alias.equals(alias.strip())) {
+            return false;
+        }
+        if (Character.getType(alias.codePointAt(0)) == Character.SPACE_SEPARATOR
+                || Character.getType(alias.codePointBefore(alias.length()))
+                        == Character.SPACE_SEPARATOR) {
+            return false;
+        }
+        for (int i = 0; i < alias.length(); i += Character.charCount(alias.codePointAt(i))) {
+            if (isBlankLooking(alias.codePointAt(i))) {
+                return false;
+            }
+            switch (Character.getType(alias.codePointAt(i))) {
+                case Character.CONTROL,
+                        Character.FORMAT,
+                        Character.PRIVATE_USE,
+                        Character.SURROGATE,
+                        Character.UNASSIGNED,
+                        Character.LINE_SEPARATOR,
+                        Character.PARAGRAPH_SEPARATOR -> {
+                    return false;
+                }
+                default -> {}
+            }
+        }
+        return true;
+    }
+
+    private static boolean isBlankLooking(int cp) {
+        return cp == 0x115F
+                || cp == 0x1160
+                || cp == 0x17B4
+                || cp == 0x17B5
+                || cp == 0x2800
+                || cp == 0x3164
+                || cp == 0xFFA0;
+    }
+}
diff --git a/android/app/tests/unit/src/com/android/bluetooth/btservice/AdapterServiceBinderTest.kt b/android/app/tests/unit/src/com/android/bluetooth/btservice/AdapterServiceBinderTest.kt
index bb4e7d5..1e662fa 100644
--- a/android/app/tests/unit/src/com/android/bluetooth/btservice/AdapterServiceBinderTest.kt
+++ b/android/app/tests/unit/src/com/android/bluetooth/btservice/AdapterServiceBinderTest.kt
@@ -534,7 +534,34 @@ class AdapterServiceBinderTest {
         verify(service).setAirPodsMusicDuck(device, false, 0, token)
     }
 
+    @Test
+    fun setAirPodsAlias_serviceUnavailable_returnsFalse() {
+        doReturn(false).whenever(service).isAvailable
+        assertThat(binder.setAirPodsAlias(device, AIRPODS_ALIAS, source)).isFalse()
+        verify(service, never()).setAirPodsAlias(any(), any())
+    }
+
+    @Test
+    fun setAirPodsAlias_withoutIdentityPermission_throwsSecurityException() {
+        doThrow(SecurityException("MANAGE_AIRPODS_IDENTITY permission required"))
+            .whenever(service)
+            .enforceCallingOrSelfPermission(eq(MANAGE_AIRPODS_IDENTITY), anyOrNull())
+        assertThrows(SecurityException::class.java) {
+            binder.setAirPodsAlias(device, AIRPODS_ALIAS, source)
+        }
+        verify(service, never()).setAirPodsAlias(any(), any())
+    }
+
+    @Test
+    fun setAirPodsAlias_withIdentityPermission_forwardsToService() {
+        doReturn(true).whenever(service).setAirPodsAlias(device, AIRPODS_ALIAS)
+        assertThat(binder.setAirPodsAlias(device, AIRPODS_ALIAS, source)).isTrue()
+        verify(service).setAirPodsAlias(device, AIRPODS_ALIAS)
+    }
+
     companion object {
+        // SovereignOS ADR-135
+        private const val AIRPODS_ALIAS = "AirPods Test"
         // Transport constants from BluetoothDevice
         private const val INVALID_TRANSPORT_NEGATIVE = -1
         private const val INVALID_TRANSPORT_POSITIVE = 3
