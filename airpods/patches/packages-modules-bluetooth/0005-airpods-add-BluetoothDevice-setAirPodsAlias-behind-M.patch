+package com.android.bluetooth.btservice;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** Tests for {@link AirPodsAliasPolicy} (ADR-135). */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class AirPodsAliasPolicyTest {
+    @Test
+    public void acceptsVisibleTextOfOneToThirtyTwoBytes() {
+        assertTrue(AirPodsAliasPolicy.isAllowed("AirPods Test"));
+        assertTrue(AirPodsAliasPolicy.isAllowed("A"));
+        assertTrue(AirPodsAliasPolicy.isAllowed("x".repeat(32)));
+        assertTrue(AirPodsAliasPolicy.isAllowed("é".repeat(16)));
+        assertTrue(AirPodsAliasPolicy.isAllowed("a b"));
+    }
+
+    @Test
+    public void refusesWhatIsOutsideTheRule() {
+        assertFalse(AirPodsAliasPolicy.isAllowed(null));
+        assertFalse(AirPodsAliasPolicy.isAllowed(""));
+        assertFalse(AirPodsAliasPolicy.isAllowed("x".repeat(33)));
+        assertFalse(AirPodsAliasPolicy.isAllowed("é".repeat(17)));
+        assertFalse(AirPodsAliasPolicy.isAllowed(" a"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a "));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\tb"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\nb"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a​b"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a b"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("ab"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\ud800b"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u00a0"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\u00a0"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u00a0a"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u3164"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u2800"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\u3164b"));
+    }
+}
