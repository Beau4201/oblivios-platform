diff --git a/framework/java/android/bluetooth/BluetoothDevice.java b/framework/java/android/bluetooth/BluetoothDevice.java
index 33c024c..0ae4f46 100644
--- a/framework/java/android/bluetooth/BluetoothDevice.java
+++ b/framework/java/android/bluetooth/BluetoothDevice.java
@@ -3497,6 +3497,34 @@ public final class BluetoothDevice implements Parcelable, Attributable {
         }
     }
 
+    /**
+     * Sets the alias of this <em>bonded</em> device, which must currently be registered as an AirPods
+     * accessory through {@link #setAirPodsIdentity} (ADR-135). The name must be 1 to 32 UTF-8 bytes of
+     * visible text without leading or trailing white space; anything else is refused.
+     *
+     * <p>Requires {@code BLUETOOTH_CONNECT} and the signature|privileged permission {@code
+     * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY}, enforced in the Bluetooth service. Does
+     * not require {@code BLUETOOTH_PRIVILEGED} or a companion device association.
+     *
+     * @param alias the new name
+     * @return true when the alias now equals {@code alias}; false when refused or on error
+     */
+    @Hide
+    @SystemApi
+    @RequiresBluetoothConnectPermission
+    @RequiresPermission(BLUETOOTH_CONNECT)
+    public boolean setAirPodsAlias(@NonNull String alias) {
+        if (DBG) log("setAirPodsAlias()");
+        requireNonNull(alias);
+        try {
+            return callServiceIfEnabled(
+                    s -> s.setAirPodsAlias(this, alias, mAttributionSource), false);
+        } catch (SecurityException se) {
+            GmsCompat.catchOrRethrow(se);
+            return false;
+        }
+    }
+
