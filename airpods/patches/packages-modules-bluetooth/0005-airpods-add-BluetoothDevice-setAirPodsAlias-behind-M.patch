diff --git a/android/app/src/com/android/bluetooth/btservice/AdapterService.java b/android/app/src/com/android/bluetooth/btservice/AdapterService.java
index f33d01f..454bdc4 100644
--- a/android/app/src/com/android/bluetooth/btservice/AdapterService.java
+++ b/android/app/src/com/android/bluetooth/btservice/AdapterService.java
@@ -2493,6 +2493,32 @@ public class AdapterService extends Service {
         }
     }
 
+    /**
+     * Sets the alias of a bonded device that the AirPods app has registered (ADR-135). The caller
+     * (AdapterServiceBinder) has already enforced org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY.
+     *
+     * @return true when the alias now equals {@code alias}; false when the name is outside {@link
+     *     AirPodsAliasPolicy}, the device is not bonded or not registered, or its properties are not
+     *     known.
+     */
+    public boolean setAirPodsAlias(BluetoothDevice device, String alias) {
+        if (!AirPodsAliasPolicy.isAllowed(alias)) {
+            Log.w(TAG, "setAirPodsAlias: rejected alias");
+            return false;
+        }
+        return mAirPodsIdentity.runIfRegistered(
+                device.getAddress(),
+                () -> getBondState(device) == BOND_BONDED,
+                () -> {
+                    DeviceProperties properties = mRemoteDevices.getDeviceProperties(device);
+                    if (properties == null) {
+                        return false;
+                    }
+                    properties.setAlias(device, alias);
+                    return true;
+                });
+    }
+
     private void logManufacturerInfo(BluetoothDevice device, int key, byte[] bytesValue) {
         String callingApp = getPackageManager().getNameForUid(Binder.getCallingUid());
         String manufacturerName = "";
