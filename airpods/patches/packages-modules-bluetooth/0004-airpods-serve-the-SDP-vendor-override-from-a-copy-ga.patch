+
+// ---- SovereignOS ADR-115: sdpu_airpods_vendor_view ----------------------------
+
+TEST_F(StackSdpUtilsTest, sdpu_airpods_vendor_view_ordinary_peer_is_untouched) {
+  uint8_t value[2] = {0x00, 0xE0};
+  tSDP_ATTRIBUTE attr = {};
+  attr.len = 2;
+  attr.value_ptr = value;
+  attr.id = ATTR_ID_VENDOR_ID;
+  attr.type = UINT_DESC_TYPE;
+  tSDP_ATTRIBUTE scratch = {};
+  uint8_t scratch_value[2] = {0, 0};
+
+  ASSERT_EQ(&attr, sdpu_airpods_vendor_view(&attr, false, &scratch, scratch_value));
+  ASSERT_EQ(0x00, value[0]);
+  ASSERT_EQ(0xE0, value[1]);
+}
+
+TEST_F(StackSdpUtilsTest, sdpu_airpods_vendor_view_serves_a_copy_and_never_mutates_the_record) {
+  uint8_t value[2] = {0x00, 0xE0};
+  tSDP_ATTRIBUTE attr = {};
+  attr.len = 2;
+  attr.value_ptr = value;
+  attr.id = ATTR_ID_VENDOR_ID;
+  attr.type = UINT_DESC_TYPE;
+  tSDP_ATTRIBUTE scratch = {};
+  uint8_t scratch_value[2] = {0, 0};
+
+  const tSDP_ATTRIBUTE* view = sdpu_airpods_vendor_view(&attr, true, &scratch, scratch_value);
+
+  ASSERT_EQ(&scratch, view);
+  ASSERT_EQ(scratch_value, view->value_ptr);
+  ASSERT_EQ(0x00, view->value_ptr[0]);  // 0x004C, Apple, big-endian
+  ASSERT_EQ(0x4C, view->value_ptr[1]);
+  ASSERT_EQ(attr.id, view->id);
+  ASSERT_EQ(attr.type, view->type);
+  ASSERT_EQ(attr.len, view->len);
+  // Regression for the shared-record mutation: the real record is unchanged, so
+  // the next (non-AirPods) peer still sees the ordinary identity.
+  ASSERT_EQ(0x00, value[0]);
+  ASSERT_EQ(0xE0, value[1]);
+  ASSERT_NE(attr.value_ptr, view->value_ptr);
+}
+
+TEST_F(StackSdpUtilsTest, sdpu_airpods_vendor_view_other_attributes_are_untouched) {
+  uint8_t value[2] = {0x12, 0x34};
+  tSDP_ATTRIBUTE attr = {};
+  attr.len = 2;
+  attr.value_ptr = value;
+  attr.id = ATTR_ID_VENDOR_ID_SOURCE;
