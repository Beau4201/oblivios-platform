+  ASSERT_EQ(0x12, value[0]);
+  ASSERT_EQ(0x34, value[1]);
+}
+
+TEST_F(StackSdpUtilsTest, sdpu_airpods_vendor_view_wrong_length_or_type_is_untouched) {
+  uint8_t value[4] = {0x00, 0xE0, 0x00, 0x00};
+  tSDP_ATTRIBUTE attr = {};
+  attr.len = 4;
+  attr.value_ptr = value;
+  attr.id = ATTR_ID_VENDOR_ID;
+  attr.type = UINT_DESC_TYPE;
+  tSDP_ATTRIBUTE scratch = {};
+  uint8_t scratch_value[2] = {0, 0};
+
+  ASSERT_EQ(&attr, sdpu_airpods_vendor_view(&attr, true, &scratch, scratch_value));
+
+  attr.len = 2;
+  attr.type = TEXT_STR_DESC_TYPE;
+  ASSERT_EQ(&attr, sdpu_airpods_vendor_view(&attr, true, &scratch, scratch_value));
+  ASSERT_EQ(0x00, value[0]);
+  ASSERT_EQ(0xE0, value[1]);
+}
