+    /**
+     * SovereignOS ADR-125: the AirPods are out of the ears. If {@code device} is the active A2DP
+     * and/or HFP device, make no device active for that profile, so the audio (and a call) plays on
+     * the phone. Never selects another device. Remembers exactly what it removed so
+     * {@link #routeAirPodsBack} restores that and nothing else.
+     *
+     * @return true when everything that had to be removed was removed (also when nothing had to be)
+     */
+    boolean routeAirPodsAway(BluetoothDevice device) {
+        synchronized (mLock) {
+            AirPodsRouteTracker.Change change =
+                    mAirPodsRoute.away(
+                            device.getAddress(),
+                            Objects.equals(mA2dpActiveDevice, device),
+                            Objects.equals(mHfpActiveDevice, device));
+            boolean ok = true;
+            if (change.hfp) {
+                ok &= setHfpActiveDevice(null);
+            }
+            if (change.a2dp) {
+                ok &= setA2dpActiveDevice(null, /* stopAudio= */ false);
+            }
+            return ok;
+        }
+    }
+
+    /**
+     * SovereignOS ADR-125: the AirPods are in an ear again (or the app is gone). Make the device
+     * active again on exactly the profiles {@link #routeAirPodsAway} removed it from, and only
+     * where the slot is still free: no other classic device, LE Audio device or hearing aid has taken
+     * it since. HFP first, as in {@link #setActiveDevice}.
+     */
+    boolean routeAirPodsBack(BluetoothDevice device) {
+        synchronized (mLock) {
+            boolean othersIdle = mLeAudioActiveDevice == null && !isAnyHearingAidDeviceActive();
+            AirPodsRouteTracker.Change change =
+                    mAirPodsRoute.back(
+                            device.getAddress(),
+                            othersIdle && mA2dpActiveDevice == null,
+                            othersIdle && mHfpActiveDevice == null);
+            boolean ok = true;
+            if (change.hfp) {
+                ok &= setHfpActiveDevice(device);
+            }
+            if (change.a2dp) {
+                ok &= setA2dpActiveDevice(device, /* stopAudio= */ false);
+            }
+            return ok;
+        }
+    }
+
+    void forgetAirPodsRoute(String address) {
+        mAirPodsRoute.forget(address);
+    }
+
