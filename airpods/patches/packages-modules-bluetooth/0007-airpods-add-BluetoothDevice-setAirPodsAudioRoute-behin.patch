+package com.android.bluetooth.btservice;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** SovereignOS ADR-125: what the AirPods route tracker removes and restores. */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class AirPodsRouteTrackerTest {
+    private static final String A = "AA:BB:CC:DD:EE:01";
+    private static final String B = "AA:BB:CC:DD:EE:02";
+
+    private final AirPodsRouteTracker mTracker = new AirPodsRouteTracker();
+
+    private static void assertChange(AirPodsRouteTracker.Change c, boolean a2dp, boolean hfp) {
+        assertThat(c.a2dp).isEqualTo(a2dp);
+        assertThat(c.hfp).isEqualTo(hfp);
+    }
+
+    @Test
+    public void away_whenActiveOnBoth_removesBoth() {
+        assertChange(mTracker.away(A, true, true), true, true);
+        assertThat(mTracker.isRouted(A)).isTrue();
+    }
+
+    @Test
+    public void away_whenOnlyA2dpActive_removesOnlyA2dp() {
+        assertChange(mTracker.away(A, true, false), true, false);
+        assertChange(mTracker.back(A, true, true), true, false);
+    }
+
+    @Test
+    public void away_whenNotActiveAnywhere_removesNothingAndRemembersNothing() {
+        assertChange(mTracker.away(A, false, false), false, false);
+        assertThat(mTracker.isRouted(A)).isFalse();
+        assertChange(mTracker.back(A, true, true), false, false);
+    }
+
+    @Test
+    public void away_twice_secondRemovesNothingButTheFirstIsRemembered() {
+        mTracker.away(A, true, true);
+        assertChange(mTracker.away(A, false, false), false, false);
+        assertChange(mTracker.back(A, true, true), true, true);
+    }
+
+    @Test
+    public void away_secondCallWithAnotherProfile_mergesTheRecord() {
+        mTracker.away(A, true, false);
+        assertChange(mTracker.away(A, false, true), false, true);
+        assertChange(mTracker.back(A, true, true), true, true);
+    }
+
+    @Test
+    public void back_restoresExactlyWhatWasRemoved() {
+        mTracker.away(A, true, true);
+        assertChange(mTracker.back(A, true, true), true, true);
+    }
+
+    @Test
+    public void back_skipsAProfileThatAnotherDeviceTook() {
+        mTracker.away(A, true, true);
+        assertChange(mTracker.back(A, false, true), false, true);
+    }
+
+    @Test
+    public void back_withoutAway_doesNothing() {
+        assertChange(mTracker.back(A, true, true), false, false);
+    }
+
+    @Test
+    public void back_clearsTheRecord() {
+        mTracker.away(A, true, true);
+        mTracker.back(A, true, true);
+        assertThat(mTracker.isRouted(A)).isFalse();
+        assertChange(mTracker.back(A, true, true), false, false);
+    }
+
+    @Test
+    public void forget_dropsTheRecordOfThatAddressOnly() {
+        mTracker.away(A, true, true);
+        mTracker.away(B, true, true);
+        mTracker.forget(A);
+        assertThat(mTracker.isRouted(A)).isFalse();
+        assertThat(mTracker.isRouted(B)).isTrue();
+        assertChange(mTracker.back(A, true, true), false, false);
+    }
+
+    @Test
+    public void clear_dropsEverything() {
+        mTracker.away(A, true, true);
+        mTracker.away(B, true, false);
+        mTracker.clear();
+        assertThat(mTracker.isRouted(A)).isFalse();
+        assertThat(mTracker.isRouted(B)).isFalse();
+    }
+
+    @Test
+    public void addresses_areIndependent() {
+        mTracker.away(A, true, false);
+        assertChange(mTracker.back(B, true, true), false, false);
+        assertChange(mTracker.back(A, true, true), true, false);
+    }
+}
