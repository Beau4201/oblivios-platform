@@ -321,6 +321,10 @@ public class AdapterService extends Service {
     // SovereignOS ADR-115/ADR-117: which bonded peers the AirPods app has registered.
     private final AirPodsIdentityTracker mAirPodsIdentity = new AirPodsIdentityTracker();
 
+    // SovereignOS ADR-125: one death recipient per AirPods address that was routed away, so the
+    // route is restored if the calling process dies.
+    private final Map<String, IBinder.DeathRecipient> mAirPodsRouteWatch = new HashMap<>();
+
     /**
      * Predicate that tests if the given {@link BluetoothDevice} is well-known to be used for
      * physical location.
@@ -2382,6 +2386,68 @@ public class AdapterService extends Service {
                                 || setMetadata(device, key, value));
     }
 
+    /**
+     * SovereignOS ADR-125: takes the registered AirPods out of the active A2DP/HFP slots
+     * ({@code away}) or puts them back. The caller (AdapterServiceBinder) has already enforced
+     * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY. Only a bonded, registered device is
+     * accepted, under the same lock as register and unbond. {@code token} is a binder of the
+     * calling process: if it dies while the AirPods are routed away, the route is restored.
+     *
+     * @return true when the request was applied or there was nothing to do; false when refused
+     */
+    public boolean setAirPodsAudioRoute(BluetoothDevice device, boolean away, IBinder token) {
+        final String address = device.getAddress();
+        return mAirPodsIdentity.runIfRegistered(
+                address,
+                () -> getBondState(device) == BOND_BONDED,
+                () -> {
+                    if (away) {
+                        return watchAirPodsRoute(device, token)
+                                && mActiveDeviceManager.routeAirPodsAway(device);
+                    }
+                    unwatchAirPodsRoute(address, token);
+                    return mActiveDeviceManager.routeAirPodsBack(device);
+                });
+    }
+
+    private boolean watchAirPodsRoute(BluetoothDevice device, IBinder token) {
+        final String address = device.getAddress();
+        synchronized (mAirPodsRouteWatch) {
+            if (mAirPodsRouteWatch.containsKey(address)) {
+                return true;
+            }
+            IBinder.DeathRecipient recipient =
+                    () -> {
+                        synchronized (mAirPodsRouteWatch) {
+                            mAirPodsRouteWatch.remove(address);
+                        }
+                        Log.i(TAG, "AirPods route: caller died, restoring");
+                        mActiveDeviceManager.routeAirPodsBack(device);
+                    };
+            try {
+                token.linkToDeath(recipient, 0);
+            } catch (RemoteException e) {
+                Log.w(TAG, "AirPods route: caller already dead, not routing away");
+                return false;
+            }
+            mAirPodsRouteWatch.put(address, recipient);
+            return true;
+        }
+    }
+
+    private void unwatchAirPodsRoute(String address, IBinder token) {
+        synchronized (mAirPodsRouteWatch) {
+            IBinder.DeathRecipient recipient = mAirPodsRouteWatch.remove(address);
+            if (recipient != null) {
+                try {
+                    token.unlinkToDeath(recipient, 0);
+                } catch (java.util.NoSuchElementException e) {
+                    // linked through another proxy of the same binder; the death callback is then a no-op
+                }
+            }
+        }
+    }
+
     private void logManufacturerInfo(BluetoothDevice device, int key, byte[] bytesValue) {
         String callingApp = getPackageManager().getNameForUid(Binder.getCallingUid());
         String manufacturerName = "";
