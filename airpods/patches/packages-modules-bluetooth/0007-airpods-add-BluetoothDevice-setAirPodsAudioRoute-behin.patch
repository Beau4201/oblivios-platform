+package com.android.bluetooth.btservice;
+
+import com.android.internal.annotations.GuardedBy;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * SovereignOS ADR-125: the record of which active-device slots (A2DP, HFP) were taken away from a
+ * registered AirPods device because the pods are out of the ears. It decides nothing about Bluetooth
+ * state; {@link ActiveDeviceManager} passes in what is active and acts on the answer. The record is
+ * what lets the restore touch only what this feature removed. In memory only; bounded by the
+ * registry of AirPods peers (at most 16 addresses can ever be registered).
+ */
+final class AirPodsRouteTracker {
+    /** Which profiles to change now. */
+    static final class Change {
+        static final Change NONE = new Change(false, false);
+
+        final boolean a2dp;
+        final boolean hfp;
+
+        Change(boolean a2dp, boolean hfp) {
+            this.a2dp = a2dp;
+            this.hfp = hfp;
+        }
+    }
+
+    private final Object mLock = new Object();
+
+    @GuardedBy("mLock")
+    private final Map<String, Change> mRemoved = new HashMap<>();
+
+    /**
+     * Records and returns what must be removed now: exactly the profiles on which this address is
+     * the active device. A profile removed by an earlier call stays in the record.
+     */
+    Change away(String address, boolean a2dpActive, boolean hfpActive) {
+        synchronized (mLock) {
+            Change before = mRemoved.getOrDefault(address, Change.NONE);
+            Change after = new Change(before.a2dp || a2dpActive, before.hfp || hfpActive);
+            if (after.a2dp || after.hfp) {
+                mRemoved.put(address, after);
+            }
+            return new Change(a2dpActive, hfpActive);
+        }
+    }
+
+    /**
+     * Ends the record and returns what to restore: the profiles this feature removed, and only
+     * those whose slot is still free.
+     */
+    Change back(String address, boolean a2dpFree, boolean hfpFree) {
+        synchronized (mLock) {
+            Change before = mRemoved.remove(address);
+            if (before == null) {
+                return Change.NONE;
+            }
+            return new Change(before.a2dp && a2dpFree, before.hfp && hfpFree);
+        }
+    }
+
+    void forget(String address) {
+        synchronized (mLock) {
+            mRemoved.remove(address);
+        }
+    }
+
+    void clear() {
+        synchronized (mLock) {
+            mRemoved.clear();
+        }
+    }
+
+    boolean isRouted(String address) {
+        synchronized (mLock) {
+            return mRemoved.containsKey(address);
+        }
+    }
+}
