+    /**
+     * Sets one metadata value on this <em>bonded</em> device, which must currently be registered as
+     * an AirPods accessory through {@link #setAirPodsIdentity} (ADR-117). Only the keys Settings
+     * reads for the AirPods header and device page are accepted: the untethered and main icon,
+     * battery, charging and low-battery-threshold keys, {@link #METADATA_IS_UNTETHERED_HEADSET}
+     * and {@link #METADATA_FAST_PAIR_CUSTOMIZED_FIELDS}. Any other key is refused. An empty value
+     * clears the key. The metadata is removed by the platform when the bond is removed.
+     *
+     * <p>Requires {@code BLUETOOTH_CONNECT} and the signature|privileged permission {@code
+     * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY}, enforced in the Bluetooth service. Does
+     * not require {@code BLUETOOTH_PRIVILEGED}.
+     *
+     * @param key one of the accepted keys above
+     * @param value the data to store, at most {@link #METADATA_MAX_LENGTH} bytes
+     * @return true when the stored value now equals {@code value} (including when it already did);
+     *     false when refused (key, value, bond or registration) or on error
+     */
+    @Hide
+    @SystemApi
+    @RequiresBluetoothConnectPermission
+    @RequiresPermission(BLUETOOTH_CONNECT)
+    public boolean setAirPodsMetadata(@MetadataKey int key, @NonNull byte[] value) {
+        if (DBG) log("setAirPodsMetadata()");
+        requireNonNull(value);
+        try {
+            return callServiceIfEnabled(
+                    s -> s.setAirPodsMetadata(this, key, value, mAttributionSource), false);
+        } catch (SecurityException se) {
+            GmsCompat.catchOrRethrow(se);
+            return false;
+        }
+    }
