+package com.android.bluetooth.btservice;
+
+import android.bluetooth.BluetoothDevice;
+
+import java.util.Arrays;
+
+/**
+ * SovereignOS ADR-117: what {@link AdapterService#setAirPodsMetadata} may write.
+ *
+ * <p>The allow-list is the set of keys Settings reads to draw the AirPods rings and device page
+ * (icons, battery, charging, low-battery threshold for left, right, case and main, the
+ * untethered-headset flag, and the fast-pair fields that carry the DeviceSettings provider tags).
+ * Deliberately absent: ENHANCED_SETTINGS_UI_URI (makes Settings launch a URI), COMPANION_APP,
+ * DEVICE_TYPE (redundant with IS_UNTETHERED_HEADSET), and the manufacturer, model and version keys.
+ */
+final class AirPodsMetadataPolicy {
+    private AirPodsMetadataPolicy() {}
+
+    static boolean isAllowedKey(int key) {
+        return switch (key) {
+            case BluetoothDevice.METADATA_FAST_PAIR_CUSTOMIZED_FIELDS,
+                    BluetoothDevice.METADATA_IS_UNTETHERED_HEADSET,
+                    BluetoothDevice.METADATA_MAIN_ICON,
+                    BluetoothDevice.METADATA_MAIN_BATTERY,
+                    BluetoothDevice.METADATA_MAIN_CHARGING,
+                    BluetoothDevice.METADATA_MAIN_LOW_BATTERY_THRESHOLD,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_ICON,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_ICON,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_ICON,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_BATTERY,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_BATTERY,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_BATTERY,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_CHARGING,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_CHARGING,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_CHARGING,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_LOW_BATTERY_THRESHOLD,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_LOW_BATTERY_THRESHOLD,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_LOW_BATTERY_THRESHOLD -> true;
+            default -> false;
+        };
+    }
+
+    /** A value is writable when it is non-null and within the platform's metadata size limit. */
+    static boolean isAllowedValue(byte[] value) {
+        return value != null && value.length <= BluetoothDevice.METADATA_MAX_LENGTH;
+    }
+
+    /** Storage reports an empty value as {@code null}; both mean "nothing stored". */
+    static boolean isSameValue(byte[] current, byte[] requested) {
+        return Arrays.equals(current == null ? new byte[0] : current, requested);
+    }
+}
