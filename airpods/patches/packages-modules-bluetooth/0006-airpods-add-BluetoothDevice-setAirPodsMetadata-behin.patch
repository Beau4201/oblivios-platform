+
     companion object {
         // Transport constants from BluetoothDevice
         private const val INVALID_TRANSPORT_NEGATIVE = -1
         private const val INVALID_TRANSPORT_POSITIVE = 3
+
+        // SovereignOS ADR-117
+        private const val MANAGE_AIRPODS_IDENTITY =
+            "org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY"
+        private const val AIRPODS_KEY = BluetoothDevice.METADATA_UNTETHERED_LEFT_BATTERY
+        private val AIRPODS_VALUE = "82".toByteArray()
     }
 }
diff --git a/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsIdentityTrackerTest.java b/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsIdentityTrackerTest.java
new file mode 100644
index 0000000000..fa56f08ae5
--- /dev/null
+++ b/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsIdentityTrackerTest.java
@@ -0,0 +1,235 @@
+/*
