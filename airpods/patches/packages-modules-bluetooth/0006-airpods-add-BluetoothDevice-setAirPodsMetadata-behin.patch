+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.bluetooth.btservice;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/** Tests for {@link AirPodsIdentityTracker} (ADR-115, ADR-117). */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class AirPodsIdentityTrackerTest {
+    private static final String A = "AA:BB:CC:DD:EE:01";
+    private static final String B = "AA:BB:CC:DD:EE:02";
+
+    private final AirPodsIdentityTracker mTracker = new AirPodsIdentityTracker();
+    private final AtomicInteger mNativeCalls = new AtomicInteger();
+    private final AtomicInteger mWrites = new AtomicInteger();
+
+    private boolean register(String address, boolean bonded, boolean nativeResult) {
+        return mTracker.setIdentity(
+                address,
+                true,
+                () -> bonded,
+                () -> {
+                    mNativeCalls.incrementAndGet();
+                    return nativeResult;
+                });
+    }
+
+    private boolean clear(String address, boolean bonded, boolean nativeResult) {
+        return mTracker.setIdentity(
+                address,
+                false,
+                () -> bonded,
+                () -> {
+                    mNativeCalls.incrementAndGet();
+                    return nativeResult;
+                });
+    }
+
+    private boolean write(String address, boolean bonded, boolean actionResult) {
+        return mTracker.runIfRegistered(
+                address,
+                () -> bonded,
+                () -> {
+                    mWrites.incrementAndGet();
+                    return actionResult;
+                });
+    }
+
+    @Test
+    public void register_notBonded_isRefused_andNeverReachesNative() {
+        assertFalse(register(A, false, true));
+        assertEquals(0, mNativeCalls.get());
+        assertFalse(write(A, true, true));
+        assertEquals(0, mWrites.get());
+    }
+
+    @Test
+    public void register_bonded_thenWriteRuns_andReturnsTheActionResult() {
+        assertTrue(register(A, true, true));
+        assertTrue(write(A, true, true));
+        assertFalse(write(A, true, false));
+        assertEquals(2, mWrites.get());
+    }
+
+    @Test
+    public void register_nativeRefuses_leavesTheAddressUnregistered() {
+        assertFalse(register(A, true, false));
+        assertFalse(write(A, true, true));
+        assertEquals(0, mWrites.get());
+    }
+
+    @Test
+    public void register_isPerAddress() {
+        assertTrue(register(A, true, true));
+        assertFalse(write(B, true, true));
+        assertEquals(0, mWrites.get());
+    }
+
+    @Test
+    public void write_afterBondLost_isRefused_evenIfStillRegistered() {
+        assertTrue(register(A, true, true));
+        assertFalse(write(A, false, true));
+        assertEquals(0, mWrites.get());
+    }
+
+    @Test
+    public void clear_worksWithoutABond_andAlwaysDropsTheEntry() {
+        assertTrue(register(A, true, true));
+        assertTrue(clear(A, false, true));
+        assertEquals(2, mNativeCalls.get());
+        assertFalse(write(A, true, true));
+    }
+
+    @Test
+    public void clear_dropsTheEntryEvenWhenNativeReportsFailure() {
+        assertTrue(register(A, true, true));
+        assertFalse(clear(A, true, false));
+        assertFalse(write(A, true, true));
+        assertEquals(0, mWrites.get());
+    }
+
+    @Test
+    public void unbond_callsNativeClear_andDropsTheEntry() {
+        assertTrue(register(A, true, true));
+        AtomicInteger cleared = new AtomicInteger();
+        mTracker.onUnbond(A, cleared::incrementAndGet);
+        assertEquals(1, cleared.get());
+        assertFalse(write(A, true, true));
+    }
+
+    @Test
+    public void unbond_dropsTheEntryEvenWhenNativeClearThrows() {
+        assertTrue(register(A, true, true));
+        assertThrows(
+                IllegalStateException.class,
+                () ->
+                        mTracker.onUnbond(
+                                A,
+                                () -> {
+                                    throw new IllegalStateException("native failed");
+                                }));
+        assertFalse(write(A, true, true));
+    }
+
+    @Test
+    public void unbond_ofAnUnregisteredAddress_stillClearsNative() {
+        AtomicInteger cleared = new AtomicInteger();
+        mTracker.onUnbond(B, cleared::incrementAndGet);
+        assertEquals(1, cleared.get());
+    }
+
+    /**
+     * Deterministic: a write is held inside its action; onUnbond must not return until the write
+     * finishes (they share one lock). Without the lock onUnbond would return at once and the
+     * write would observe it.
+     */
+    @Test(timeout = 20000)
+    public void unbond_waitsForAWriteInProgress() throws Exception {
+        assertTrue(register(A, true, true));
+        CountDownLatch inAction = new CountDownLatch(1);
+        AtomicBoolean unbondReturned = new AtomicBoolean();
+        AtomicBoolean unbondReturnedDuringWrite = new AtomicBoolean();
+        Thread writer =
+                new Thread(
+                        () ->
+                                mTracker.runIfRegistered(
+                                        A,
+                                        () -> true,
+                                        () -> {
+                                            inAction.countDown();
+                                            long deadline = System.nanoTime() + 200_000_000L;
+                                            while (System.nanoTime() < deadline
+                                                    && !unbondReturned.get()) {
+                                                Thread.onSpinWait();
+                                            }
+                                            unbondReturnedDuringWrite.set(unbondReturned.get());
+                                            return true;
+                                        }));
+        writer.start();
+        inAction.await();
+        mTracker.onUnbond(A, () -> {});
+        unbondReturned.set(true);
+        writer.join();
+        assertFalse(
+                "onUnbond returned while a write was still running",
+                unbondReturnedDuringWrite.get());
+        assertFalse(write(A, true, true));
+    }
+
+    /** Stress: no write may start after onUnbond has returned. */
+    @Test(timeout = 20000)
+    public void concurrentUnbond_noWriteRunsAfterItReturns() throws Exception {
+        for (int round = 0; round < 200; round++) {
+            AirPodsIdentityTracker tracker = new AirPodsIdentityTracker();
+            assertTrue(tracker.setIdentity(A, true, () -> true, () -> true));
+            AtomicBoolean unbondReturned = new AtomicBoolean();
+            AtomicBoolean violation = new AtomicBoolean();
+            CountDownLatch go = new CountDownLatch(1);
+            Thread writer =
+                    new Thread(
+                            () -> {
+                                try {
+                                    go.await();
+                                } catch (InterruptedException e) {
+                                    return;
+                                }
+                                for (int i = 0; i < 2000; i++) {
+                                    tracker.runIfRegistered(
+                                            A,
+                                            () -> true,
+                                            () -> {
+                                                if (unbondReturned.get()) {
+                                                    violation.set(true);
+                                                }
+                                                return true;
+                                            });
+                                }
+                            });
+            writer.start();
+            go.countDown();
+            tracker.onUnbond(A, () -> {});
+            unbondReturned.set(true);
+            writer.join();
+            assertFalse("a write ran after unbond returned, round " + round, violation.get());
+        }
+    }
+}
