+package com.android.bluetooth.btservice;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.bluetooth.BluetoothDevice;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.util.Set;
+
+/** Tests for {@link AirPodsMetadataPolicy} (ADR-117). */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class AirPodsMetadataPolicyTest {
+    private static final Set<Integer> ALLOWED =
+            Set.of(
+                    BluetoothDevice.METADATA_FAST_PAIR_CUSTOMIZED_FIELDS,
+                    BluetoothDevice.METADATA_IS_UNTETHERED_HEADSET,
+                    BluetoothDevice.METADATA_MAIN_ICON,
+                    BluetoothDevice.METADATA_MAIN_BATTERY,
+                    BluetoothDevice.METADATA_MAIN_CHARGING,
+                    BluetoothDevice.METADATA_MAIN_LOW_BATTERY_THRESHOLD,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_ICON,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_ICON,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_ICON,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_BATTERY,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_BATTERY,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_BATTERY,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_CHARGING,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_CHARGING,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_CHARGING,
+                    BluetoothDevice.METADATA_UNTETHERED_LEFT_LOW_BATTERY_THRESHOLD,
+                    BluetoothDevice.METADATA_UNTETHERED_RIGHT_LOW_BATTERY_THRESHOLD,
+                    BluetoothDevice.METADATA_UNTETHERED_CASE_LOW_BATTERY_THRESHOLD);
+
+    @Test
+    public void allowedKeys_areExactlyTheEighteenAirPodsKeys() {
+        assertEquals(18, ALLOWED.size());
+        for (int key = -8; key <= 64; key++) {
+            assertEquals(
+                    "key " + key, ALLOWED.contains(key), AirPodsMetadataPolicy.isAllowedKey(key));
+        }
+    }
+
+    @Test
+    public void keysThatReachOtherSurfaces_areRefused() {
+        int[] refused = {
+            BluetoothDevice.METADATA_ENHANCED_SETTINGS_UI_URI,
+            BluetoothDevice.METADATA_COMPANION_APP,
+            BluetoothDevice.METADATA_DEVICE_TYPE,
+            BluetoothDevice.METADATA_MANUFACTURER_NAME,
+            BluetoothDevice.METADATA_MODEL_NAME,
+            BluetoothDevice.METADATA_SOFTWARE_VERSION,
+            BluetoothDevice.METADATA_HARDWARE_VERSION,
+            BluetoothDevice.METADATA_SPATIAL_AUDIO,
+            BluetoothDevice.METADATA_LE_AUDIO,
+            BluetoothDevice.METADATA_GMCS_CCCD,
+            BluetoothDevice.METADATA_GTBS_CCCD,
+            BluetoothDevice.METADATA_EXCLUSIVE_MANAGER,
+            BluetoothDevice.METADATA_ZOOMED_IN_ICON,
+        };
+        for (int key : refused) {
+            assertFalse("key " + key, AirPodsMetadataPolicy.isAllowedKey(key));
+        }
+    }
+
+    @Test
+    public void extremeKeys_areRefused() {
+        assertFalse(AirPodsMetadataPolicy.isAllowedKey(Integer.MIN_VALUE));
+        assertFalse(AirPodsMetadataPolicy.isAllowedKey(Integer.MAX_VALUE));
+    }
+
+    @Test
+    public void value_nullIsRefused_emptyAndMaxLengthAreAllowed_overMaxIsRefused() {
+        assertFalse(AirPodsMetadataPolicy.isAllowedValue(null));
+        assertTrue(AirPodsMetadataPolicy.isAllowedValue(new byte[0]));
+        assertTrue(
+                AirPodsMetadataPolicy.isAllowedValue(
+                        new byte[BluetoothDevice.METADATA_MAX_LENGTH]));
+        assertFalse(
+                AirPodsMetadataPolicy.isAllowedValue(
+                        new byte[BluetoothDevice.METADATA_MAX_LENGTH + 1]));
+    }
+
+    @Test
+    public void sameValue_treatsStoredNullAsEmpty() {
+        assertTrue(AirPodsMetadataPolicy.isSameValue(null, new byte[0]));
+        assertTrue(AirPodsMetadataPolicy.isSameValue(new byte[0], new byte[0]));
+        assertTrue(AirPodsMetadataPolicy.isSameValue(new byte[] {1, 2}, new byte[] {1, 2}));
+        assertFalse(AirPodsMetadataPolicy.isSameValue(null, new byte[] {1}));
+        assertFalse(AirPodsMetadataPolicy.isSameValue(new byte[] {1, 2}, new byte[] {1, 3}));
+        assertFalse(AirPodsMetadataPolicy.isSameValue(new byte[] {1}, new byte[] {1, 0}));
+        assertFalse(AirPodsMetadataPolicy.isSameValue(new byte[] {1}, null));
+    }
+}
