+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.bluetooth.btservice;
+
+import com.android.internal.annotations.GuardedBy;
+
+import java.util.HashSet;
+import java.util.Set;
+import java.util.function.BooleanSupplier;
+
+/**
+ * SovereignOS ADR-115/ADR-117: the Java-side record of which bonded addresses the AirPods app has
+ * registered as AirPods (the native registry has no getter). One lock makes register, unbond and
+ * metadata write atomic with respect to each other, so a write can never run against an address
+ * whose unbond has already completed.
+ *
+ * <p>The set is bounded by the native registry, which refuses more than 16 peers. It is in memory
+ * only. If it and the native registry ever disagree (for example after a Bluetooth restart), the
+ * metadata path fails closed: writes are refused until the app registers again.
+ */
+final class AirPodsIdentityTracker {
+    private final Object mLock = new Object();
+
+    @GuardedBy("mLock")
+    private final Set<String> mAddresses = new HashSet<>();
+
+    /**
+     * Registers or clears an address. Registering requires a current bond and native acceptance;
+     * clearing always drops the Java entry, whatever the native result.
+     *
+     * @return the native result, or false when registering without a bond
+     */
+    boolean setIdentity(
+            String address,
+            boolean recognized,
+            BooleanSupplier isBonded,
+            BooleanSupplier nativeSet) {
+        synchronized (mLock) {
+            if (recognized && !isBonded.getAsBoolean()) {
+                return false;
+            }
+            boolean accepted = nativeSet.getAsBoolean();
+            if (recognized) {
+                if (accepted) {
+                    mAddresses.add(address);
+                }
+            } else {
+                mAddresses.remove(address);
+            }
+            return accepted;
+        }
+    }
+
+    /** Clears the native registration and the Java entry, the entry even if native throws. */
+    void onUnbond(String address, Runnable nativeClear) {
+        synchronized (mLock) {
+            try {
+                nativeClear.run();
+            } finally {
+                mAddresses.remove(address);
+            }
+        }
+    }
+
+    /**
+     * Runs {@code action} only while the address is registered and bonded, holding the lock for
+     * the whole action so an unbond cannot slip in between the check and the write.
+     */
+    boolean runIfRegistered(String address, BooleanSupplier isBonded, BooleanSupplier action) {
+        synchronized (mLock) {
+            if (!mAddresses.contains(address) || !isBonded.getAsBoolean()) {
+                return false;
+            }
+            return action.getAsBoolean();
+        }
+    }
+}
