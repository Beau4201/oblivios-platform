From 70c30814dc83351159b7dcffaa18b4a6c557ec3d Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 7 Oct 2026 02:25:55 +0200
Subject: [PATCH] airpods: refuse an alias that ends in a no-break space or
 draws nothing

String.strip() leaves a no-break space in place, and the Hangul fillers and the Braille blank are letters or symbols, so the alias policy accepted names that look empty. Same rule as AapCodec.isValidName in the AirPods app.
---
 .../btservice/AirPodsAliasPolicy.java         | 22 ++++++++++++++++++-
 .../btservice/AirPodsAliasPolicyTest.java     |  6 +++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/android/app/src/com/android/bluetooth/btservice/AirPodsAliasPolicy.java b/android/app/src/com/android/bluetooth/btservice/AirPodsAliasPolicy.java
index 2a7b09684d..664fed59a2 100644
--- a/android/app/src/com/android/bluetooth/btservice/AirPodsAliasPolicy.java
+++ b/android/app/src/com/android/bluetooth/btservice/AirPodsAliasPolicy.java
@@ -22,7 +22,9 @@ import java.nio.charset.StandardCharsets;
  * SovereignOS ADR-135: what {@link AdapterService#setAirPodsAlias} may write. The rule is the one of
  * the AirPods app's {@code AapCodec.isValidName}: 1 to {@value #MAX_BYTES} UTF-8 bytes of visible text,
  * no leading or trailing white space, and none of the control, format, private-use, surrogate,
- * unassigned, line-separator or paragraph-separator characters.
+ * unassigned, line-separator or paragraph-separator characters. Also refused: a name that starts or ends in
+ * a space separator (String#strip leaves a no-break space) and the code points that draw nothing (Hangul
+ * fillers, Khmer inherent vowels, the Braille blank).
  */
 final class AirPodsAliasPolicy {
     static final int MAX_BYTES = 32;
@@ -37,7 +39,15 @@ final class AirPodsAliasPolicy {
         if (bytes < 1 || bytes > MAX_BYTES || !alias.equals(alias.strip())) {
             return false;
         }
+        if (Character.getType(alias.codePointAt(0)) == Character.SPACE_SEPARATOR
+                || Character.getType(alias.codePointBefore(alias.length()))
+                        == Character.SPACE_SEPARATOR) {
+            return false;
+        }
         for (int i = 0; i < alias.length(); i += Character.charCount(alias.codePointAt(i))) {
+            if (isBlankLooking(alias.codePointAt(i))) {
+                return false;
+            }
             switch (Character.getType(alias.codePointAt(i))) {
                 case Character.CONTROL,
                         Character.FORMAT,
@@ -53,4 +63,14 @@ final class AirPodsAliasPolicy {
         }
         return true;
     }
+
+    private static boolean isBlankLooking(int cp) {
+        return cp == 0x115F
+                || cp == 0x1160
+                || cp == 0x17B4
+                || cp == 0x17B5
+                || cp == 0x2800
+                || cp == 0x3164
+                || cp == 0xFFA0;
+    }
 }
diff --git a/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsAliasPolicyTest.java b/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsAliasPolicyTest.java
index 92d1387523..d6265b1824 100644
--- a/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsAliasPolicyTest.java
+++ b/android/app/tests/unit/src/com/android/bluetooth/btservice/AirPodsAliasPolicyTest.java
@@ -52,5 +52,11 @@ public class AirPodsAliasPolicyTest {
         assertFalse(AirPodsAliasPolicy.isAllowed("a b"));
         assertFalse(AirPodsAliasPolicy.isAllowed("ab"));
         assertFalse(AirPodsAliasPolicy.isAllowed("a\ud800b"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u00a0"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\u00a0"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u00a0a"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u3164"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("\u2800"));
+        assertFalse(AirPodsAliasPolicy.isAllowed("a\u3164b"));
     }
 }
