+
+/*************************************************************************************
+**
+** Function        sdp_dynamic_change_airpods_vendor
+**
+** Description     Overrides the outgoing PNP Information (Device ID) vendor
+**                 attribute in this one SDP response to Apple's registered
+**                 Bluetooth SIG company ID (ADR-108) -- but ONLY when the
+**                 requesting peer's BD_ADDR is one this project has itself
+**                 registered (AdapterService#setAirPodsIdentity, gated by
+**                 org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY, held
+**                 only by SovereignOS's own signed AirPods app after a real
+**                 airpods-core protocol handshake against an already-bonded
+**                 device). Every other peer's SDP query is unaffected, and
+**                 the local Device-ID record BTA_DmSetLocalDiRecord sets is
+**                 never touched -- this is a per-response, per-peer override
+**                 only, never a device-wide identity change.
+**
+** Returns         BOOLEAN
+**
++***************************************************************************************/
+bool sdp_dynamic_change_airpods_vendor(const tSDP_ATTRIBUTE* p_attr,
+                                       const RawAddress& remote_address) {
+  if ((p_attr->id != ATTR_ID_VENDOR_ID) || (p_attr->len < 2)) {
+    return false;
+  }
+  if (!interop_match_addr_or_name(INTEROP_AIRPODS_IDENTITY, remote_address,
+                                  &btif_storage_get_remote_device_property)) {
+    return false;
+  }
+  uint8_t* p_temp = p_attr->value_ptr;
+  uint16_t apple_vendor_id = LMP_COMPID_APPLE;
+  UINT16_TO_BE_STREAM(p_temp, apple_vendor_id);
+  log::verbose("SDP Device-ID vendor overridden to Apple for recognized AirPods peer {}",
+              remote_address);
+  return true;
+}
