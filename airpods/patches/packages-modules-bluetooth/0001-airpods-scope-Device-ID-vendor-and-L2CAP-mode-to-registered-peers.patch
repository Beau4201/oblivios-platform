diff --git a/android/app/src/com/android/bluetooth/btservice/AdapterService.java b/android/app/src/com/android/bluetooth/btservice/AdapterService.java
index 8ac1bbf215..951721b56d 100644
--- a/android/app/src/com/android/bluetooth/btservice/AdapterService.java
+++ b/android/app/src/com/android/bluetooth/btservice/AdapterService.java
@@ -2330,6 +2330,27 @@ public class AdapterService extends Service {
         return status;
     }
 
+    /**
+     * Registers or clears the given bonded device as a recognized AirPods
+     * accessory (ADR-108). Only the confirmed bonded BD_ADDR is ever
+     * scoped this way -- never a device-wide identity change. The caller
+     * (AdapterServiceBinder) has already enforced
+     * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY before this is
+     * reached.
+     *
+     * @return true always; native interop registration is fire-and-forget,
+     *     matching interop_database_add's own existing void return shape.
+     */
+    public boolean setAirPodsIdentity(BluetoothDevice device, boolean recognized) {
+        if (getBondState(device) != BOND_BONDED) {
+            Log.w(TAG, "setAirPodsIdentity: refusing to register a non-bonded device");
+            return false;
+        }
+        mNativeInterface.interopDatabaseAddRemoveAddr(
+                recognized, "INTEROP_AIRPODS_IDENTITY", device.getAddress(), 6);
+        return true;
+    }
+
     private void logManufacturerInfo(BluetoothDevice device, int key, byte[] bytesValue) {
         String callingApp = getPackageManager().getNameForUid(Binder.getCallingUid());
         String manufacturerName = "";
diff --git a/android/app/src/com/android/bluetooth/btservice/AdapterServiceBinder.java b/android/app/src/com/android/bluetooth/btservice/AdapterServiceBinder.java
index 6c14a6290f..f250486a59 100644
--- a/android/app/src/com/android/bluetooth/btservice/AdapterServiceBinder.java
+++ b/android/app/src/com/android/bluetooth/btservice/AdapterServiceBinder.java
@@ -1449,6 +1449,27 @@ class AdapterServiceBinder extends IBluetooth.Stub {
         return service.setMetadata(device, key, value);
     }
 
+    /**
+     * Registers or clears a bonded device as a recognized AirPods accessory
+     * (ADR-108). Scoped to the caller holding
+     * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY -- SovereignOS's own
+     * signed AirPods app only, never a general BLUETOOTH_PRIVILEGED holder.
+     */
+    @Override
+    public boolean setAirPodsIdentity(
+            BluetoothDevice device, boolean recognized, AttributionSource source) {
+        requireNonNull(device);
+        var service = getServiceAndEnforceCallerUserAndConnect(source, "setAirPodsIdentity");
+        if (service == null) {
+            return false;
+        }
+
+        service.enforceCallingOrSelfPermission(
+                "org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY", null);
+
+        return service.setAirPodsIdentity(device, recognized);
+    }
+
     @Override
     public byte[] getMetadata(BluetoothDevice device, int key, AttributionSource source) {
         requireNonNull(device);
