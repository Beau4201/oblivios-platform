From 98c91e16d3ba08fa269c76dedb664e1c1f9e0478 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Tue, 29 Sep 2026 15:28:15 +0200
Subject: [PATCH 3/5] airpods: register identity through a dedicated btif call
 and clear it on unbond

---
 ...oid_bluetooth_btservice_AdapterService.cpp | 34 +++++++++++++++++++
 .../btservice/AdapterNativeInterface.java     |  6 ++++
 .../bluetooth/btservice/AdapterService.java   | 16 +++++----
 system/btif/src/bluetooth.cc                  | 16 +++++++++
 system/include/hardware/bluetooth.h           |  7 ++++
 5 files changed, 73 insertions(+), 6 deletions(-)

diff --git a/android/app/jni/com_android_bluetooth_btservice_AdapterService.cpp b/android/app/jni/com_android_bluetooth_btservice_AdapterService.cpp
index 05a2cc4fef..296816f840 100644
--- a/android/app/jni/com_android_bluetooth_btservice_AdapterService.cpp
+++ b/android/app/jni/com_android_bluetooth_btservice_AdapterService.cpp
@@ -1736,6 +1736,38 @@ static void interopDatabaseAddRemoveAddrNative(JNIEnv* env, jclass /* clazz */,
   env->ReleaseStringUTFChars(feature_name, feature_name_str);
 }
 
+static jboolean setAirPodsIdentityNative(JNIEnv* env, jclass /* clazz */, jstring address,
+                                         jboolean recognized) {
+  if (!sBluetoothInterface) {
+    log::warn("sBluetoothInterface is null.");
+    return JNI_FALSE;
+  }
+
+  if (address == nullptr) {
+    log::warn("address is null.");
+    return JNI_FALSE;
+  }
+
+  const char* tmp_addr = env->GetStringUTFChars(address, NULL);
+  if (!tmp_addr) {
+    log::warn("address is null.");
+    return JNI_FALSE;
+  }
+
+  auto bdaddr = RawAddress::FromString(tmp_addr);
+
+  env->ReleaseStringUTFChars(address, tmp_addr);
+
+  if (!bdaddr.has_value()) {
+    log::warn("address is invalid.");
+    return JNI_FALSE;
+  }
+
+  return sBluetoothInterface->set_airpods_identity(bdaddr.value(), recognized == JNI_TRUE)
+                 ? JNI_TRUE
+                 : JNI_FALSE;
+}
+
 static void interopDatabaseAddRemoveNameNative(JNIEnv* env, jclass /* clazz */, jboolean do_add,
                                                jstring feature_name, jstring name) {
   log::verbose("");
@@ -1933,6 +1965,8 @@ static int register_com_android_bluetooth_btservice_AdapterService(JNIEnv* env)
            reinterpret_cast<void*>(interopDatabaseAddRemoveAddrNative)},
           {"interopDatabaseAddRemoveNameNative", "(ZLjava/lang/String;Ljava/lang/String;)V",
            reinterpret_cast<void*>(interopDatabaseAddRemoveNameNative)},
+          {"setAirPodsIdentityNative", "(Ljava/lang/String;Z)Z",
+           reinterpret_cast<void*>(setAirPodsIdentityNative)},
           {"getRemotePbapPceVersionNative", "(Ljava/lang/String;)I",
            reinterpret_cast<void*>(getRemotePbapPceVersionNative)},
           {"pbapPseDynamicVersionUpgradeIsEnabledNative", "()Z",
diff --git a/android/app/src/com/android/bluetooth/btservice/AdapterNativeInterface.java b/android/app/src/com/android/bluetooth/btservice/AdapterNativeInterface.java
index 94e8834c85..26931d5c76 100644
--- a/android/app/src/com/android/bluetooth/btservice/AdapterNativeInterface.java
+++ b/android/app/src/com/android/bluetooth/btservice/AdapterNativeInterface.java
@@ -237,6 +237,10 @@ public class AdapterNativeInterface {
         interopDatabaseAddRemoveAddrNative(doAdd, featureName, address, length);
     }
 
+    boolean setAirPodsIdentity(String address, boolean recognized) {
+        return setAirPodsIdentityNative(address, recognized);
+    }
+
     int getRemotePbapPceVersion(String address) {
         return getRemotePbapPceVersionNative(address);
     }
@@ -381,6 +385,8 @@ public class AdapterNativeInterface {
     private native void interopDatabaseAddRemoveAddrNative(
             boolean doAdd, String featureName, String address, int length);
 
+    private native boolean setAirPodsIdentityNative(String address, boolean recognized);
+
     private native void interopDatabaseAddRemoveNameNative(
             boolean doAdd, String featureName, String name);
 
diff --git a/android/app/src/com/android/bluetooth/btservice/AdapterService.java b/android/app/src/com/android/bluetooth/btservice/AdapterService.java
index 951721b56d..15151c2499 100644
--- a/android/app/src/com/android/bluetooth/btservice/AdapterService.java
+++ b/android/app/src/com/android/bluetooth/btservice/AdapterService.java
@@ -2338,17 +2338,16 @@ public class AdapterService extends Service {
      * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY before this is
      * reached.
      *
-     * @return true always; native interop registration is fire-and-forget,
-     *     matching interop_database_add's own existing void return shape.
+     * @return true on success; false when the device is not bonded (register
+     *     only) or the native registry is full.
      */
     public boolean setAirPodsIdentity(BluetoothDevice device, boolean recognized) {
-        if (getBondState(device) != BOND_BONDED) {
+        // Only registering needs a current bond; clearing must always be possible.
+        if (recognized && getBondState(device) != BOND_BONDED) {
             Log.w(TAG, "setAirPodsIdentity: refusing to register a non-bonded device");
             return false;
         }
-        mNativeInterface.interopDatabaseAddRemoveAddr(
-                recognized, "INTEROP_AIRPODS_IDENTITY", device.getAddress(), 6);
-        return true;
+        return mNativeInterface.setAirPodsIdentity(device.getAddress(), recognized);
     }
 
     private void logManufacturerInfo(BluetoothDevice device, int key, byte[] bytesValue) {
@@ -4540,6 +4539,11 @@ public class AdapterService extends Service {
 
         mStorage.onBondStateChanged(device, fromState, toState);
 
+        // SovereignOS ADR-115: an AirPods identity registration never outlives the bond.
+        if (toState == BluetoothDevice.BOND_NONE) {
+            mNativeInterface.setAirPodsIdentity(device.getAddress(), false);
+        }
+
         // Remove the bond caller info when bonding is concluded
         if (toState != BOND_BONDING) {
             CallerInfo callerInfo = mBondAttemptCallerInfo.remove(device.getAddress());
diff --git a/system/btif/src/bluetooth.cc b/system/btif/src/bluetooth.cc
index 52d5c1adbb..c92f5e5638 100644
--- a/system/btif/src/bluetooth.cc
+++ b/system/btif/src/bluetooth.cc
@@ -93,6 +93,7 @@
 #include "btif/include/stack_manager_t.h"
 #include "common/address_obfuscator.h"
 #include "common/os_utils.h"
+#include "device/include/airpods_identity.h"
 #include "device/include/device_iot_config.h"
 #include "device/include/esco_parameters.h"
 #include "device/include/interop.h"
@@ -122,6 +123,7 @@
 #include "stack/include/bnep_api.h"
 #include "stack/include/bt_name.h"
 #include "stack/include/btm_client_interface.h"
+#include "stack/include/btm_sec_api.h"
 #include "stack/include/btm_status.h"
 #include "stack/include/gatt_api.h"
 #include "stack/include/hcidefs.h"
@@ -1201,6 +1203,19 @@ static void interop_database_add_remove_addr(bool do_add, const char* feature_na
   }
 }
 
+// SovereignOS ADR-115: the current-bond check consulted by the AirPods identity
+// scope at use time, so a registration alone is never sufficient (covers a bond
+// that disappears without a per-device bond-state event, e.g. a factory reset).
+static bool airpods_identity_is_bonded(const RawAddress& addr) {
+  return get_security_client_interface().BTM_IsBonded(addr, BT_TRANSPORT_AUTO);
+}
+
+static bool set_airpods_identity(RawAddress addr, bool recognized) {
+  // Idempotent; installed before any registration can exist.
+  airpods_identity_set_bond_checker(&airpods_identity_is_bonded);
+  return airpods_identity_set(addr, recognized);
+}
+
 static void interop_database_add_remove_name(bool do_add, const char* feature_name,
                                              const char* name) {
   if (feature_name == NULL || name == NULL) {
@@ -1281,6 +1296,7 @@ EXPORT_SYMBOL bt_interface_t bluetoothInterface = {
         .interop_database_add_remove_name = interop_database_add_remove_name,
         .get_remote_pbap_pce_version = get_remote_pbap_pce_version,
         .pbap_pse_dynamic_version_upgrade_is_enabled = pbap_pse_dynamic_version_upgrade_is_enabled,
+        .set_airpods_identity = set_airpods_identity,
 };
 
 // callback reporting helpers
diff --git a/system/include/hardware/bluetooth.h b/system/include/hardware/bluetooth.h
index e095340d03..cc2ddc5269 100644
--- a/system/include/hardware/bluetooth.h
+++ b/system/include/hardware/bluetooth.h
@@ -1165,6 +1165,13 @@ typedef struct {
 
   /** check if pbap pse dynamic version upgrade is enable */
   bool (*pbap_pse_dynamic_version_upgrade_is_enabled)();
+
+  /**
+   * SovereignOS (ADR-115): register (recognized == true) or unregister an
+   * exact bonded peer as a recognized AirPods accessory. Returns false when
+   * the registry is full.
+   */
+  bool (*set_airpods_identity)(RawAddress addr, bool recognized);
 } bt_interface_t;
 
 #define BLUETOOTH_INTERFACE_STRING "bluetoothInterface"
-- 
