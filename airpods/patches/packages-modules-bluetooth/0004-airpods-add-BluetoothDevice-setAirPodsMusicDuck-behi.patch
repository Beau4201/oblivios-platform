+
+    private boolean isAirPodsA2dpActive(BluetoothDevice device) {
+        synchronized (mLock) {
+            return Objects.equals(mA2dpActiveDevice, device);
+        }
+    }
+
+    /**
+     * FreeholdOS ADR-127: lowers the music stream to {@code percent} (10 to 90) of its
+     * current volume while {@code device} is the active A2DP device, one index at a time. Never
+     * raises the volume and never goes below the stream minimum. The audio hardening ignores this
+     * from an app; this runs in the Bluetooth process, which it exempts by uid.
+     *
+     * @return true when the request was applied or there was nothing to do; false when refused
+     */
+    boolean duckAirPodsMusic(BluetoothDevice device, int percent) {
+        synchronized (mAirPodsDuckLock) {
+            if (!AirPodsDuckTracker.isValidPercent(percent) || !isAirPodsA2dpActive(device)) {
+                return false;
+            }
+            int current = mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
+            int min = mAudioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC);
+            int target = mAirPodsDuck.duck(device.getAddress(), current, min, percent);
+            if (target != AirPodsDuckTracker.NONE) {
+                fadeAirPodsMusic(current, target);
+            }
+            return true;
+        }
+    }
+
+    /**
+     * FreeholdOS ADR-127: gives the lowered music volume back, only if {@code device} is still the
+     * active A2DP device and the volume is still the value {@link #duckAirPodsMusic} set. Otherwise
+     * the record is dropped and the volume is left as it is (the owner's change wins, and the
+     * stream volume of another output is none of ours).
+     */
+    boolean restoreAirPodsMusic(BluetoothDevice device) {
+        synchronized (mAirPodsDuckLock) {
+            if (!isAirPodsA2dpActive(device)) {
+                mAirPodsDuck.forget(device.getAddress());
+                return true;
+            }
+            int current = mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
+            int original = mAirPodsDuck.restore(device.getAddress(), current);
+            if (original != AirPodsDuckTracker.NONE) {
+                fadeAirPodsMusic(current, original);
+            }
+            return true;
+        }
+    }
+
+    /** One index at a time, so the change is a short fade; stops if the owner changed the volume. */
+    private void fadeAirPodsMusic(int from, int to) {
+        int step = to > from ? 1 : -1;
+        int expected = from;
+        while (expected != to) {
+            if (mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC) != expected) {
+                return;
+            }
+            expected += step;
+            mAudioManager.setStreamVolume(AudioManager.STREAM_MUSIC, expected, 0);
+            SystemClock.sleep(AIRPODS_FADE_STEP_MS);
+        }
     }
 
     @VisibleForTesting
