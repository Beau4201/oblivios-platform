+package com.android.bluetooth.btservice;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** FreeholdOS ADR-127: what the AirPods duck tracker lowers and restores. */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class AirPodsDuckTrackerTest {
+    private static final String A = "AA:BB:CC:DD:EE:01";
+    private static final String B = "AA:BB:CC:DD:EE:02";
+    private static final int NONE = AirPodsDuckTracker.NONE;
+
+    private final AirPodsDuckTracker mTracker = new AirPodsDuckTracker();
+
+    @Test
+    public void duck_goesToTheShareOfTheCurrentVolume() {
+        assertThat(mTracker.duck(A, 10, 0, 50)).isEqualTo(5);
+        assertThat(mTracker.isDucked(A)).isTrue();
+    }
+
+    @Test
+    public void duck_roundsToTheNearestIndex() {
+        assertThat(mTracker.duck(A, 11, 0, 35)).isEqualTo(4); // 3.85
+        assertThat(mTracker.duck(B, 6, 0, 70)).isEqualTo(4); // 4.2
+    }
+
+    @Test
+    public void duck_neverGoesBelowTheMinimum() {
+        assertThat(mTracker.duck(A, 3, 1, 20)).isEqualTo(1); // 0.6 rounds to 1, min 1
+        assertThat(mTracker.duck(B, 4, 2, 20)).isEqualTo(2); // 0.8 rounds to 1, min 2
+    }
+
+    @Test
+    public void duck_neverRaisesAndNeverRecordsAnUnchangedVolume() {
+        assertThat(mTracker.duck(A, 1, 1, 50)).isEqualTo(NONE);
+        assertThat(mTracker.isDucked(A)).isFalse();
+        assertThat(mTracker.duck(A, 2, 2, 20)).isEqualTo(NONE);
+        assertThat(mTracker.isDucked(A)).isFalse();
+    }
+
+    @Test
+    public void duck_refusesAPercentOutsideTheSliderRange() {
+        for (int bad : new int[] {Integer.MIN_VALUE, -1, 0, 1, 9, 91, 99, 100, 101, Integer.MAX_VALUE}) {
+            assertThat(mTracker.duck(A, 10, 0, bad)).isEqualTo(NONE);
+            assertThat(AirPodsDuckTracker.isValidPercent(bad)).isFalse();
+        }
+        assertThat(mTracker.isDucked(A)).isFalse();
+    }
+
+    @Test
+    public void duck_acceptsEveryPercentOfTheSliderRange() {
+        for (int ok = 10; ok <= 90; ok++) {
+            assertThat(AirPodsDuckTracker.isValidPercent(ok)).isTrue();
+        }
+        assertThat(mTracker.duck(A, 100, 0, 10)).isEqualTo(10);
+        assertThat(mTracker.restore(A, 10)).isEqualTo(100);
+        assertThat(mTracker.duck(A, 100, 0, 63)).isEqualTo(63);
+        assertThat(mTracker.restore(A, 63)).isEqualTo(100);
+        assertThat(mTracker.duck(A, 100, 0, 90)).isEqualTo(90);
+        assertThat(mTracker.restore(A, 90)).isEqualTo(100);
+    }
+
+    @Test
+    public void duck_whileDucked_changesNothing() {
+        mTracker.duck(A, 10, 0, 50);
+        assertThat(mTracker.duck(A, 5, 0, 20)).isEqualTo(NONE);
+        assertThat(mTracker.restore(A, 5)).isEqualTo(10);
+    }
+
+    @Test
+    public void restore_returnsTheOriginalWhenTheVolumeIsStillOurs() {
+        mTracker.duck(A, 10, 0, 50);
+        assertThat(mTracker.restore(A, 5)).isEqualTo(10);
+        assertThat(mTracker.isDucked(A)).isFalse();
+    }
+
+    @Test
+    public void restore_leavesAnOwnersChangeAlone() {
+        mTracker.duck(A, 10, 0, 50);
+        assertThat(mTracker.restore(A, 7)).isEqualTo(NONE);
+        assertThat(mTracker.isDucked(A)).isFalse();
+    }
+
+    @Test
+    public void restore_withoutDuckDoesNothing() {
+        assertThat(mTracker.restore(A, 5)).isEqualTo(NONE);
+    }
+
+    @Test
+    public void restore_endsTheRecord() {
+        mTracker.duck(A, 10, 0, 50);
+        mTracker.restore(A, 5);
+        assertThat(mTracker.restore(A, 5)).isEqualTo(NONE);
+        assertThat(mTracker.duck(A, 8, 0, 50)).isEqualTo(4);
+    }
+
+    @Test
+    public void forget_dropsThatAddressOnly() {
+        mTracker.duck(A, 10, 0, 50);
+        mTracker.duck(B, 10, 0, 50);
+        mTracker.forget(A);
+        assertThat(mTracker.isDucked(A)).isFalse();
+        assertThat(mTracker.isDucked(B)).isTrue();
+        assertThat(mTracker.restore(A, 5)).isEqualTo(NONE);
+    }
+
+    @Test
+    public void clear_dropsEverything() {
+        mTracker.duck(A, 10, 0, 50);
+        mTracker.duck(B, 10, 0, 50);
+        mTracker.clear();
+        assertThat(mTracker.isDucked(A)).isFalse();
+        assertThat(mTracker.isDucked(B)).isFalse();
+    }
+
+    @Test
+    public void addresses_areIndependent() {
+        mTracker.duck(A, 10, 0, 50);
+        assertThat(mTracker.restore(B, 5)).isEqualTo(NONE);
+        assertThat(mTracker.restore(A, 5)).isEqualTo(10);
+    }
+}
