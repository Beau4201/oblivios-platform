+package com.android.bluetooth.btservice;
+
+import com.android.internal.annotations.GuardedBy;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * FreeholdOS ADR-127: the record of a music volume that was lowered for a registered AirPods
+ * device while the owner speaks. It decides nothing about audio; {@link ActiveDeviceManager} passes
+ * in the current volume and acts on the answer. The record is what lets a restore touch only what
+ * this feature lowered, and only while the volume is still the value this feature set (an owner's
+ * change wins). In memory only; one record per address.
+ */
+final class AirPodsDuckTracker {
+    /** The lowest and the highest share of the current volume that may stay, in percent (the owner's slider). */
+    static final int MIN_PERCENT = 10;
+    static final int MAX_PERCENT = 90;
+
+    static boolean isValidPercent(int percent) {
+        return percent >= MIN_PERCENT && percent <= MAX_PERCENT;
+    }
+
+    /** No volume change. */
+    static final int NONE = -1;
+
+    private static final class Ducked {
+        final int original;
+        final int lowered;
+
+        Ducked(int original, int lowered) {
+            this.original = original;
+            this.lowered = lowered;
+        }
+    }
+
+    private final Object mLock = new Object();
+
+    @GuardedBy("mLock")
+    private final Map<String, Ducked> mDucked = new HashMap<>();
+
+    /**
+     * Records and returns the volume index to go to, or {@link #NONE} when nothing is to be done:
+     * an invalid percent, a record that exists already, or a target that is not below the current
+     * volume. The target is that share of the current volume, rounded, and never below {@code min}.
+     */
+    int duck(String address, int current, int min, int percent) {
+        if (!isValidPercent(percent)) {
+            return NONE;
+        }
+        synchronized (mLock) {
+            if (mDucked.containsKey(address)) {
+                return NONE;
+            }
+            int target = Math.max(min, (current * percent + 50) / 100);
+            if (target >= current) {
+                return NONE;
+            }
+            mDucked.put(address, new Ducked(current, target));
+            return target;
+        }
+    }
+
+    /**
+     * Ends the record and returns the index to restore, or {@link #NONE}: there is no record, or the
+     * volume is no longer the value this feature set (the owner changed it, which wins).
+     */
+    int restore(String address, int current) {
+        synchronized (mLock) {
+            Ducked record = mDucked.remove(address);
+            if (record == null || current != record.lowered) {
+                return NONE;
+            }
+            return record.original;
+        }
+    }
+
+    boolean isDucked(String address) {
+        synchronized (mLock) {
+            return mDucked.containsKey(address);
+        }
+    }
+
+    void forget(String address) {
+        synchronized (mLock) {
+            mDucked.remove(address);
+        }
+    }
+
+    void clear() {
+        synchronized (mLock) {
+            mDucked.clear();
+        }
+    }
+}
