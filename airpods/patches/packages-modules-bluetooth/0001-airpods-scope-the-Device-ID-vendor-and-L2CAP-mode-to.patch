diff --git a/system/device/include/airpods_identity.h b/system/device/include/airpods_identity.h
new file mode 100644
index 0000000..85a6656
--- /dev/null
+++ b/system/device/include/airpods_identity.h
@@ -0,0 +1,89 @@
+/*
+ * ObliviOS ADR-115 (amends ADR-108): exact-match, in-memory registry of
+ * bonded peers that ObliviOS's own signed AirPods app has validated as
+ * AirPods accessories.
+ *
+ * Deliberately NOT the interop database: that API asserts
+ * length < sizeof(RawAddress) (so it cannot hold a full 6-byte address and
+ * would only prefix-match), persists entries to disk, and also matches by
+ * device name. None of that is acceptable for a per-peer identity scope.
+ *
+ * Header-only on purpose: sdp_server.cc is compiled into several unit-test
+ * targets, and this adds no link dependency to any of them. The current-bond
+ * check is injected by btif (airpods_identity_set_bond_checker); with no
+ * checker installed airpods_identity_applies() is false (fail closed).
+ */
+#pragma once
+
+#include <bluetooth/types/address.h>
+
+#include <cstddef>
+#include <mutex>
+#include <set>
+
+constexpr size_t AIRPODS_IDENTITY_MAX_PEERS = 16;
+
+namespace airpods_identity_internal {
+
+struct State {
+  std::mutex lock;
+  std::set<RawAddress> peers;
+  bool (*is_bonded)(const RawAddress&) = nullptr;
+};
+
+inline State& state() {
+  static State s;
+  return s;
+}
+
+}  // namespace airpods_identity_internal
+
+// Adds (recognized == true) or removes an exact peer. Adding returns false when
+// the registry is full and the peer is not already present; removing always
+// returns true.
+inline bool airpods_identity_set(const RawAddress& addr, bool recognized) {
+  auto& s = airpods_identity_internal::state();
+  std::lock_guard<std::mutex> guard(s.lock);
+  if (!recognized) {
+    s.peers.erase(addr);
+    return true;
+  }
+  if (s.peers.count(addr) == 0 && s.peers.size() >= AIRPODS_IDENTITY_MAX_PEERS) {
+    return false;
+  }
+  s.peers.insert(addr);
+  return true;
+}
+
+inline bool airpods_identity_is_registered(const RawAddress& addr) {
+  auto& s = airpods_identity_internal::state();
+  std::lock_guard<std::mutex> guard(s.lock);
+  return s.peers.count(addr) != 0;
+}
+
+inline void airpods_identity_set_bond_checker(bool (*is_bonded)(const RawAddress&)) {
+  auto& s = airpods_identity_internal::state();
+  std::lock_guard<std::mutex> guard(s.lock);
+  s.is_bonded = is_bonded;
+}
+
+// True only for a peer that is registered AND currently bonded. The bond
+// checker runs outside the registry lock (BTM takes its own locks).
+inline bool airpods_identity_applies(const RawAddress& addr) {
+  auto& s = airpods_identity_internal::state();
+  bool (*is_bonded)(const RawAddress&) = nullptr;
+  {
+    std::lock_guard<std::mutex> guard(s.lock);
+    if (s.peers.count(addr) == 0) {
+      return false;
+    }
+    is_bonded = s.is_bonded;
+  }
+  return is_bonded != nullptr && is_bonded(addr);
+}
+
+inline void airpods_identity_clear() {
+  auto& s = airpods_identity_internal::state();
+  std::lock_guard<std::mutex> guard(s.lock);
+  s.peers.clear();
+}
diff --git a/system/device/test/airpods_identity_test.cc b/system/device/test/airpods_identity_test.cc
new file mode 100644
index 0000000..c9d0b3f
--- /dev/null
+++ b/system/device/test/airpods_identity_test.cc
@@ -0,0 +1,98 @@
+/*
+ * Tests for the AirPods identity registry (ADR-115).
+ */
+#include <gtest/gtest.h>
+
+#include <cstdio>
+
+#include "device/include/airpods_identity.h"
+
+namespace {
+
+const RawAddress kPeer = RawAddress::FromString("11:22:33:44:55:66").value();
+// Differs from kPeer only in the last byte: must never match (the interop
+// database this replaces could only prefix-match up to 5 bytes).
+const RawAddress kNeighbour = RawAddress::FromString("11:22:33:44:55:67").value();
+
+bool g_bonded = false;
+int g_checker_calls = 0;
+bool FakeIsBonded(const RawAddress& /*addr*/) {
+  g_checker_calls++;
+  return g_bonded;
+}
+
+class AirPodsIdentityTest : public ::testing::Test {
+protected:
+  void SetUp() override {
+    airpods_identity_clear();
+    airpods_identity_set_bond_checker(nullptr);
+    g_bonded = false;
+    g_checker_calls = 0;
+  }
+  void TearDown() override {
+    airpods_identity_clear();
+    airpods_identity_set_bond_checker(nullptr);
+  }
+};
+
+TEST_F(AirPodsIdentityTest, nothing_registered_by_default) {
+  EXPECT_FALSE(airpods_identity_is_registered(kPeer));
+  EXPECT_FALSE(airpods_identity_applies(kPeer));
+}
+
+TEST_F(AirPodsIdentityTest, registration_is_exact_six_byte_match) {
+  ASSERT_TRUE(airpods_identity_set(kPeer, true));
+  EXPECT_TRUE(airpods_identity_is_registered(kPeer));
+  EXPECT_FALSE(airpods_identity_is_registered(kNeighbour));
+}
+
+TEST_F(AirPodsIdentityTest, remove_unregisters_and_is_idempotent) {
+  ASSERT_TRUE(airpods_identity_set(kPeer, true));
+  EXPECT_TRUE(airpods_identity_set(kPeer, false));
+  EXPECT_FALSE(airpods_identity_is_registered(kPeer));
+  EXPECT_TRUE(airpods_identity_set(kPeer, false));
+}
+
+TEST_F(AirPodsIdentityTest, applies_fails_closed_without_bond_checker) {
+  ASSERT_TRUE(airpods_identity_set(kPeer, true));
+  EXPECT_FALSE(airpods_identity_applies(kPeer));
+}
+
+TEST_F(AirPodsIdentityTest, applies_requires_current_bond) {
+  airpods_identity_set_bond_checker(FakeIsBonded);
+  ASSERT_TRUE(airpods_identity_set(kPeer, true));
+
+  g_bonded = false;
+  EXPECT_FALSE(airpods_identity_applies(kPeer));
+
+  g_bonded = true;
+  EXPECT_TRUE(airpods_identity_applies(kPeer));
+}
+
+TEST_F(AirPodsIdentityTest, applies_does_not_consult_bond_checker_for_unregistered_peer) {
+  airpods_identity_set_bond_checker(FakeIsBonded);
+  g_bonded = true;
+  EXPECT_FALSE(airpods_identity_applies(kNeighbour));
+  EXPECT_EQ(0, g_checker_calls);
+}
+
+// Built from a string so the test does not depend on which RawAddress constructors exist.
+RawAddress Addr(unsigned hi, unsigned lo) {
+  char buf[18];
+  snprintf(buf, sizeof(buf), "02:00:00:00:%02x:%02x", hi & 0xFF, lo & 0xFF);
+  return RawAddress::FromString(buf).value();
+}
+
+TEST_F(AirPodsIdentityTest, registry_is_bounded) {
+  for (size_t i = 0; i < AIRPODS_IDENTITY_MAX_PEERS; i++) {
+    ASSERT_TRUE(airpods_identity_set(Addr(0, i), true)) << "peer " << i;
+  }
+  RawAddress overflow = Addr(1, 0);
+  EXPECT_FALSE(airpods_identity_set(overflow, true));
+  EXPECT_FALSE(airpods_identity_is_registered(overflow));
+
+  // Re-adding an already registered peer at capacity is not an overflow.
+  EXPECT_TRUE(airpods_identity_set(Addr(0, 0), true));
+}
