+static jboolean setAirPodsIdentityNative(JNIEnv* env, jclass /* clazz */, jstring address,
+                                         jboolean recognized) {
+  if (!sBluetoothInterface) {
+    log::warn("sBluetoothInterface is null.");
+    return JNI_FALSE;
+  }
+
+  if (address == nullptr) {
+    log::warn("address is null.");
+    return JNI_FALSE;
+  }
+
+  const char* tmp_addr = env->GetStringUTFChars(address, NULL);
+  if (!tmp_addr) {
+    log::warn("address is null.");
+    return JNI_FALSE;
+  }
+
+  auto bdaddr = RawAddress::FromString(tmp_addr);
+
+  env->ReleaseStringUTFChars(address, tmp_addr);
+
+  if (!bdaddr.has_value()) {
+    log::warn("address is invalid.");
+    return JNI_FALSE;
+  }
+
+  return sBluetoothInterface->set_airpods_identity(bdaddr.value(), recognized == JNI_TRUE)
+                 ? JNI_TRUE
+                 : JNI_FALSE;
+}
