+/*******************************************************************************
+ *
+ * Function         sdpu_airpods_vendor_view
+ *
+ * Description      ObliviOS ADR-115. Returns the attribute to serialize for
+ *                  this one SDP response. For a peer the AirPods identity scope
+ *                  applies to, the Device-ID vendor attribute is served from a
+ *                  caller-owned copy carrying Apple's Bluetooth SIG company ID.
+ *                  The shared SDP record (p_attr->value_ptr points into it) is
+ *                  never written, so no other peer, present or future, can see
+ *                  the override and nothing needs restoring on any early return.
+ *
+ * Returns          p_attr, or scratch when the override applies
+ *
+ ******************************************************************************/
+const tSDP_ATTRIBUTE* sdpu_airpods_vendor_view(const tSDP_ATTRIBUTE* p_attr, bool airpods_peer,
+                                               tSDP_ATTRIBUTE* scratch,
+                                               uint8_t (&scratch_value)[2]) {
+  if (!airpods_peer || p_attr->id != ATTR_ID_VENDOR_ID || p_attr->type != UINT_DESC_TYPE ||
+      p_attr->len != sizeof(scratch_value)) {
+    return p_attr;
+  }
+  scratch_value[0] = static_cast<uint8_t>(LMP_COMPID_APPLE >> 8);
+  scratch_value[1] = static_cast<uint8_t>(LMP_COMPID_APPLE & 0xFF);
+  *scratch = *p_attr;
+  scratch->value_ptr = scratch_value;
+  return scratch;
+}
