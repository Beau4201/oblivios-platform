From b86ac07d9f3a81d450cb1bd8ff4e68f41a7545b2 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Tue, 29 Sep 2026 15:29:34 +0200
Subject: [PATCH 5/5] airpods: add BluetoothDevice#setAirPodsIdentity for the
 AirPods app

---
 framework/api/system-current.txt              |  1 +
 .../android/bluetooth/BluetoothDevice.java    | 28 +++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/framework/api/system-current.txt b/framework/api/system-current.txt
index 8bd1691ca3..7db50a62cc 100644
--- a/framework/api/system-current.txt
+++ b/framework/api/system-current.txt
@@ -272,6 +272,7 @@ package android.bluetooth {
     method @RequiresPermission(allOf={android.Manifest.permission.BLUETOOTH_CONNECT, android.Manifest.permission.BLUETOOTH_PRIVILEGED}, conditional=true) public boolean removeBond();
     method @RequiresPermission(allOf={android.Manifest.permission.BLUETOOTH_CONNECT, android.Manifest.permission.BLUETOOTH_PRIVILEGED}) public int requestAudioPolicyAsSink(@NonNull android.bluetooth.BluetoothSinkAudioPolicy);
     method @RequiresPermission(allOf={android.Manifest.permission.BLUETOOTH_CONNECT, android.Manifest.permission.BLUETOOTH_PRIVILEGED}) public int setActiveAudioDevicePolicy(int);
+    method @RequiresPermission(android.Manifest.permission.BLUETOOTH_CONNECT) public boolean setAirPodsIdentity(boolean);
     method @RequiresPermission(allOf={android.Manifest.permission.BLUETOOTH_CONNECT, android.Manifest.permission.BLUETOOTH_PRIVILEGED}) public boolean setLowLatencyAudioAllowed(boolean);
     method @RequiresPermission(allOf={android.Manifest.permission.BLUETOOTH_CONNECT, android.Manifest.permission.BLUETOOTH_PRIVILEGED}) public boolean setMessageAccessPermission(int);
     method @RequiresPermission(allOf={android.Manifest.permission.BLUETOOTH_CONNECT, android.Manifest.permission.BLUETOOTH_PRIVILEGED}) public boolean setMetadata(int, @NonNull byte[]);
diff --git a/framework/java/android/bluetooth/BluetoothDevice.java b/framework/java/android/bluetooth/BluetoothDevice.java
index 2b15548270..f88ce3d3ba 100644
--- a/framework/java/android/bluetooth/BluetoothDevice.java
+++ b/framework/java/android/bluetooth/BluetoothDevice.java
@@ -3364,6 +3364,34 @@ public final class BluetoothDevice implements Parcelable, Attributable {
         }
     }
 
+    /**
+     * Registers ({@code recognized == true}) or clears this <em>bonded</em> device as a
+     * recognized AirPods accessory, scoping SovereignOS's Device-ID and L2CAP-mode
+     * presentation to this one peer only (ADR-106/ADR-108/ADR-115). Registration is held in
+     * memory by the Bluetooth stack, is refused for a device that is not bonded, and is cleared
+     * automatically when the bond is removed.
+     *
+     * <p>Requires {@code BLUETOOTH_CONNECT} and the signature|privileged permission {@code
+     * org.sovereignos.permission.MANAGE_AIRPODS_IDENTITY}, enforced in the Bluetooth service.
+     *
+     * @param recognized true to register, false to clear
+     * @return true on success, false on error, when not bonded, or when the registry is full
+     */
+    @Hide
+    @SystemApi
+    @RequiresBluetoothConnectPermission
+    @RequiresPermission(BLUETOOTH_CONNECT)
+    public boolean setAirPodsIdentity(boolean recognized) {
+        if (DBG) log("setAirPodsIdentity()");
+        try {
+            return callServiceIfEnabled(
+                    s -> s.setAirPodsIdentity(this, recognized, mAttributionSource), false);
+        } catch (SecurityException se) {
+            GmsCompat.catchOrRethrow(se);
+            return false;
+        }
+    }
+
     /**
      * Get a keyed metadata for this {@link BluetoothDevice} as {@link String}
      *
-- 
