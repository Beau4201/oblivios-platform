From 9b0e6172643f76714f76b1be8c6ad986ae4dde35 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 1 Oct 2026 16:38:05 +0200
Subject: [PATCH] airpods: install the validation harness in userdebug and eng
 builds only

Adds the three harness apps to PRODUCT_PACKAGES_DEBUG so a user build never carries
them. The privapp allow-list and the hidden-API exemption ride along through the
apps' own required: lists.
---
 config/mk/google_devices/common/device-common.mk | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
index 333d7715..30d2fc16 100644
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -80,3 +80,12 @@ PRODUCT_PACKAGES += \
     AirPodsApp \
     privapp-permissions-org.sovereignos.airpods.xml \
     hidden-api-whitelisted-app-org.sovereignos.airpods.xml
+
+# SovereignOS: AirPods validation harness (ADR-120). PRODUCT_PACKAGES_DEBUG is installed
+# for userdebug and eng builds only, never for user builds (build/make/core/main.mk).
+# Each app pulls in the privapp allow-list and the hidden-API exemption it needs through
+# its own required: list.
+PRODUCT_PACKAGES_DEBUG += \
+    AirPodsDebugHarness \
+    AirPodsProbeNoPerm \
+    AirPodsProbeBtPriv
-- 
