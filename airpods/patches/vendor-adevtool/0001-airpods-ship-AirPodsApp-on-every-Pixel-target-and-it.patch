From e2cf1c7dc7cf7be073d674c32469c0d33cd82b64 Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Tue, 29 Sep 2026 17:19:37 +0200
Subject: [PATCH] airpods: ship AirPodsApp on every Pixel target and its
 validation harness in debug builds

airpods: ship AirPodsApp on every Pixel target via device-common.mk

Adds AirPodsApp and its two sysconfig modules (privapp allow-list and the
single-package hidden-API entry) to PRODUCT_PACKAGES next to Guardian, so
every Pixel platform carries them.

airpods: install the validation harness in userdebug and eng builds only

Adds the three harness apps to PRODUCT_PACKAGES_DEBUG so a user build never carries
them. The privapp allow-list and the hidden-API exemption ride along through the
apps' own required: lists.
---
 .../mk/google_devices/common/device-common.mk   | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/config/mk/google_devices/common/device-common.mk b/config/mk/google_devices/common/device-common.mk
index 3ad9544..30d2fc1 100644
--- a/config/mk/google_devices/common/device-common.mk
+++ b/config/mk/google_devices/common/device-common.mk
@@ -72,3 +72,20 @@ PRODUCT_PACKAGES += restrict-pixel-health-association
 PRODUCT_PACKAGES += \
     GuardianApp \
     privapp-permissions-org.freeholdos.guardian.xml
+
+# FreeholdOS: AirPods compatibility app (ADR-118). Kept next to Guardian in the
+# common file so every Pixel target ships it. The two XML modules are the privapp
+# allow-list and the single-package hidden-API entry; the app needs both.
+PRODUCT_PACKAGES += \
+    AirPodsApp \
+    privapp-permissions-org.freeholdos.airpods.xml \
+    hidden-api-whitelisted-app-org.freeholdos.airpods.xml
+
+# FreeholdOS: AirPods validation harness (ADR-120). PRODUCT_PACKAGES_DEBUG is installed
+# for userdebug and eng builds only, never for user builds (build/make/core/main.mk).
+# Each app pulls in the privapp allow-list and the hidden-API exemption it needs through
+# its own required: list.
+PRODUCT_PACKAGES_DEBUG += \
+    AirPodsDebugHarness \
+    AirPodsProbeNoPerm \
+    AirPodsProbeBtPriv
