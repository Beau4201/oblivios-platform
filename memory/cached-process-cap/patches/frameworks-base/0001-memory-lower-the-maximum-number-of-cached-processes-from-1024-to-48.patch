From eb4138d4688d328d7358adc8e6c6c22c44224146 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sat, 10 Oct 2026 03:48:20 +0200
Subject: [PATCH] memory: lower the maximum number of cached processes from
 1024 to 48

Secure app spawning makes every app process about 43 MB larger and not shareable with the
zygote, and nothing removes a cached process until lmkd must. On lynx a cap of 48 kept all
twelve recently used apps and took the anon demand from 5451 to 4643 MB (ADR-151). The
value is read from this resource unless a vendor overlay or the DeviceConfig flag sets it;
the Pixel vendor overlay is no longer carried (vendor/adevtool).
---
 core/res/res/values/config.xml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index d7a4004a27d6..fe141dfd5b35 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -7150,7 +7150,11 @@
     </string-array>
 
     <!-- the number of the max cached processes in the system. -->
-    <integer name="config_customizedMaxCachedProcesses">1024</integer>
+    <!-- SovereignOS: 48 instead of 1024. Secure app spawning makes every app process about 43 MB
+         larger and not shareable with the zygote, so a long tail of cached processes fills the
+         swap. 48 keeps the twelve most recent apps (cached limit 24, empty limit 24). The Pixel
+         vendor overlay of 1024 is not carried (vendor/adevtool overlay-inclusion.yml). -->
+    <integer name="config_customizedMaxCachedProcesses">48</integer>
 
     <!-- Whether this device should support taking app snapshots on closure -->
     <bool name="config_disableTaskSnapshots">false</bool>
-- 
2.39.5

