From 9828c7386b17ce80f2ef0c89e14b6d07d7ddc1aa Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Wed, 14 Oct 2026 05:26:09 +0200
Subject: [PATCH] memory: exclude the stock zram size by key

Dropping the value from sysprop-inclusion.yml left it an unknown entry, and
adevtool includes unknown entries: generate-all on tag 2026100600 put
mmd.zram.size=50% back into product.prop, a second value that fails
post_process_props.py. Put it on the exclusion list.
---
 config/device/common/sysprop-exclusion.yml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/config/device/common/sysprop-exclusion.yml b/config/device/common/sysprop-exclusion.yml
index 88bcc2c07..ee21abded 100644
--- a/config/device/common/sysprop-exclusion.yml
+++ b/config/device/common/sysprop-exclusion.yml
@@ -1,4 +1,8 @@
 sysprop_exclusions:
+  # SovereignOS (ADR-150): device-common.mk sets mmd.zram.size; a second value fails post_process_props.py.
+  # Leaving the value out of sysprop-inclusion.yml is not enough: an unknown entry is included.
+  - mmd.zram.size = 3221225472
+  - mmd.zram.size = 50%
   - android.transparency.enabled = true
   - android.transparency.prevalence_url = androidbinarytransparency.googleapis.com
   - apexd.config.compressed_apex = true
-- 
2.56.0

