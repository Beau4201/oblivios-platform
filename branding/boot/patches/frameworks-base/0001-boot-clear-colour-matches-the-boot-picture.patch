From c2a7deebfece4669f2f31b5d83cfabaded3a178a Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 11 Oct 2026 12:00:00 +0200
Subject: [PATCH 1/3] sovereignos: boot clear colour matches the boot picture
 (ADR-152)

The picture's top and bottom rows are #030706. A display taller than the 1080 x 2400 mask shows the clear colour
above and below it, so the clear colour has to be the same colour or a seam shows.
---
 cmds/bootanimation/BootAnimation.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/cmds/bootanimation/BootAnimation.cpp b/cmds/bootanimation/BootAnimation.cpp
index ea42566..cd59c30 100644
--- a/cmds/bootanimation/BootAnimation.cpp
+++ b/cmds/bootanimation/BootAnimation.cpp
@@ -800,7 +800,8 @@ bool BootAnimation::android(const Display& display) {
     glDisable(GL_SCISSOR_TEST);
     glUseProgram(mImageShader);
 
-    glClearColor(0,0,0,1);
+    // SovereignOS: clear to the colour of the boot picture's top and bottom rows (ADR-152), so a taller display shows no seam.
+    glClearColor(3.0f / 255.0f, 7.0f / 255.0f, 6.0f / 255.0f, 1.0f);
     glClear(GL_COLOR_BUFFER_BIT);
     eglSwapBuffers(mEgl, display.eglSurface);
 
