From fa4586a64b7354c123915edf480d2cc69efc5204 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 18 Oct 2026 03:18:23 +0200
Subject: [PATCH] sepolicy: hide more unit and batch properties from apps

ro.boot.hardware.{ddr,ufs}, ro.boot.{ddr_info,primary_panel_drv,warranty.sku}
and ro.boot.hw.soc.{rev,pkg_mode,sec-ar,nonsec-ar} move to unit_boot_prop,
which every domain except the apps and the app zygotes may read. The only
reader found in the tree is perfetto, which logs an error and goes on.

persist.init.svc.last_fatal_reboot_epoch gets its own type. Its old type is
readable by coredomain, which includes every app, and the value is a
timestamp that survives reboots and is equal in every app. init may set any
property type; no other domain may set the new one.
---
 private/property.te       |  3 +++
 private/property_contexts | 15 ++++++++++++++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/private/property.te b/private/property.te
index a054d9d21..a38966397 100644
--- a/private/property.te
+++ b/private/property.te
@@ -36,6 +36,8 @@ system_internal_prop(dmesgd_start_prop)
 system_internal_prop(fastbootd_protocol_prop)
 system_internal_prop(gsid_prop)
 system_internal_prop(hsum_boot_strategy_prop)
+# ObliviOS: epoch of the last fatal reboot, readable by init only (see property_contexts).
+system_internal_prop(init_fatal_reboot_epoch_prop)
 system_internal_prop(init_mnt_ns_prop)
 system_internal_prop(init_perf_lsm_hooks_prop)
 system_internal_prop(init_service_status_private_prop)
@@ -672,6 +674,7 @@ neverallow {
   domain
   -init
 } {
+  init_fatal_reboot_epoch_prop
   init_service_status_private_prop
   init_service_status_prop
 }:property_service set;
diff --git a/private/property_contexts b/private/property_contexts
index 670a3746c..046bd635c 100644
--- a/private/property_contexts
+++ b/private/property_contexts
@@ -1038,7 +1038,9 @@ init.svc.tombstoned     u:object_r:init_service_status_prop:s0 exact string
 init.svc.zygote         u:object_r:init_service_status_prop:s0 exact string
 
 # Epoch time at which last fatal reboot was performed
-persist.init.svc.last_fatal_reboot_epoch u:object_r:init_service_status_private_prop:s0 exact int
+# ObliviOS: its own type. init_service_status_private_prop is readable by coredomain, which includes
+# every app, and this value is a timestamp that survives reboots and is the same in every app.
+persist.init.svc.last_fatal_reboot_epoch u:object_r:init_fatal_reboot_epoch_prop:s0 exact int
 
 libc.debug.malloc.options u:object_r:libc_debug_prop:s0 exact string
 libc.debug.malloc.program u:object_r:libc_debug_prop:s0 exact string
@@ -1112,6 +1114,17 @@ ro.boot.hardware.devcfg         u:object_r:unit_boot_prop:s0 exact string
 ro.boot.hardware.pcbcfg         u:object_r:unit_boot_prop:s0 exact string
 ro.boot.hw.soc.id               u:object_r:unit_boot_prop:s0 exact string
 ro.boot.vbmeta.device           u:object_r:unit_boot_prop:s0 exact string
+# ObliviOS: supply-chain and batch level values. No app reads them; the only reader found in the
+# tree is perfetto, which logs an error and goes on (docs/research/linkability-catalogue.md).
+ro.boot.ddr_info                u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hardware.ddr            u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hardware.ufs            u:object_r:unit_boot_prop:s0 exact string
+ro.boot.primary_panel_drv       u:object_r:unit_boot_prop:s0 exact string
+ro.boot.warranty.sku            u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hw.soc.rev              u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hw.soc.pkg_mode         u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hw.soc.sec-ar           u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hw.soc.nonsec-ar        u:object_r:unit_boot_prop:s0 exact string
 # Properties specific to virtualized deployments of Android
 ro.boot.hypervisor.protected_vm.supported   u:object_r:hypervisor_prop:s0 exact bool
 ro.boot.hypervisor.version                  u:object_r:hypervisor_prop:s0 exact string
-- 
2.39.5

