From 27c497cb16ba5efe72a88d00cead0e4c1ab08958 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Wed, 14 Oct 2026 16:13:32 +0200
Subject: [PATCH] sepolicy: keep apps from reading the unit-specific boot
 properties

private/domain.te lets every domain read every ro.boot.* property. Five of
them identify a unit or a production batch and no app needs them. They get
their own type, readable by every domain except appdomain, so the system,
the HALs and init keep their access and an app reads an empty value.
---
 private/domain.te         | 2 ++
 private/property.te       | 2 ++
 private/property_contexts | 6 ++++++
 3 files changed, 10 insertions(+)

diff --git a/private/domain.te b/private/domain.te
index 4c49bef..a3b628a 100644
--- a/private/domain.te
+++ b/private/domain.te
@@ -517,6 +517,8 @@ get_prop(domain, apexd_select_prop)
 get_prop(domain, arm64_memtag_prop)
 get_prop(domain, bluetooth_config_prop)
 get_prop(domain, bootloader_prop)
+# SovereignOS (ADR-167): every domain except the apps; an app can tell devices apart by these.
+get_prop({ domain -appdomain }, unit_boot_prop)
 get_prop(domain, build_odm_prop)
 get_prop(domain, build_prop)
 get_prop(domain, build_vendor_prop)
diff --git a/private/property.te b/private/property.te
index 384cd3c..c0617ab 100644
--- a/private/property.te
+++ b/private/property.te
@@ -111,6 +111,8 @@ system_restricted_prop(pm_16kb_app_compat_prop)
 system_restricted_prop(service_sf_present_timestamp_prop)
 system_restricted_prop(statsd_atoms_list_version_prop)
 system_restricted_prop(trusty_coverage_prop)
+# SovereignOS (ADR-167): ro.boot.* values that identify a unit or a production batch.
+system_restricted_prop(unit_boot_prop)
 system_restricted_prop(pcc_audit_mode_client_prop)
 system_restricted_prop(dumpstate_last_id_prop)
 
diff --git a/private/property_contexts b/private/property_contexts
index 3839fa0..74df868 100644
--- a/private/property_contexts
+++ b/private/property_contexts
@@ -1106,6 +1106,12 @@ ro.boot.vbmeta.avb_version u:object_r:bootloader_prop:s0 exact string
 ro.boot.vbmeta.public_key_digest  u:object_r:bootloader_prop:s0 exact string
 ro.boot.verifiedbootstate  u:object_r:bootloader_prop:s0 exact string
 ro.boot.veritymode         u:object_r:bootloader_prop:s0 exact string
+# SovereignOS (ADR-167): no app reads these; the system, the HALs and init keep their access.
+ro.boot.cdt_hwid                u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hardware.devcfg         u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hardware.pcbcfg         u:object_r:unit_boot_prop:s0 exact string
+ro.boot.hw.soc.id               u:object_r:unit_boot_prop:s0 exact string
+ro.boot.vbmeta.device           u:object_r:unit_boot_prop:s0 exact string
 # Properties specific to virtualized deployments of Android
 ro.boot.hypervisor.protected_vm.supported   u:object_r:hypervisor_prop:s0 exact bool
 ro.boot.hypervisor.version                  u:object_r:hypervisor_prop:s0 exact string
-- 
