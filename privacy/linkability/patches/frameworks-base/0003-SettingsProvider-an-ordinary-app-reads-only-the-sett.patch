+    /**
+     * ObliviOS (ADR-173): true if this read must answer as if the key were unset: the caller is
+     * an ordinary app and the key is not one of {@link SettingsHardening#isAllowedForApps}.
+     */
+    private boolean isHiddenFromCaller(String name) {
+        return !SettingsHardening.isAllowedForApps(name) && isHardenedCaller();
+    }
+
+    /**
+     * ObliviOS (ADR-173): true if the caller reads the hardened view of the settings. That is
+     * every ordinary app (not a system app, not platform-signed, not test-only), unless the
+     * global setting oblivios_settings_open is 1 or the package is named in
+     * oblivios_settings_real_packages.
+     */
+    private boolean isHardenedCaller() {
+        if (UserHandle.getAppId(Binder.getCallingUid()) < Process.FIRST_APPLICATION_UID) {
+            return false;
+        }
+        final ApplicationInfo ai = getCallingApplicationInfoOrThrow();
+        if (ai.isSystemApp() || ai.isSignedWithPlatformKey()
+                || (ai.flags & ApplicationInfo.FLAG_TEST_ONLY) != 0) {
+            return false;
+        }
+        if ("1".equals(getFreeholdGlobalValue(SettingsHardening.OPEN_SETTING))) {
+            return false;
+        }
+        return !SettingsHardening.listContains(
+                getFreeholdGlobalValue(SettingsHardening.REAL_PACKAGES_SETTING), ai.packageName);
+    }
+
+    private String getFreeholdGlobalValue(String key) {
+        synchronized (mLock) {
+            final Setting setting = mSettingsRegistry.getSettingLocked(SETTINGS_TYPE_GLOBAL,
+                    UserHandle.USER_SYSTEM, Context.DEVICE_ID_DEFAULT, key);
+            return setting == null || setting.isNull() ? null : setting.getValue();
+        }
+    }
+
     private void enforceSettingReadable(String settingName, int settingsType, int userId) {
         checkProtectedSettingAccess(/* isRead */ true, settingName, getProtectedSettings(settingsType));
 
