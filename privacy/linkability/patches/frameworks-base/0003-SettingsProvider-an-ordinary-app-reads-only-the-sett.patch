From a54ca18e43dea70f251291e57af438be9cbc8aed Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 18 Oct 2026 04:17:40 +0200
Subject: [PATCH] SettingsProvider: an ordinary app reads only the settings it
 needs, and the settings the framework reads in-process

Squash of former patches:

- 0003 SettingsProvider: an ordinary app reads only the settings it needs
- 0005 SettingsProvider: let apps read show_ime_with_hard_keyboard
- 0006 SettingsProvider: let apps read the settings the framework reads in-process
- 0010 SettingsProvider: let an app read accessibility_enabled and its own entry of the list settings
---
 .../providers/settings/SettingsHardening.java | 111 ++++++++++++++++++
 .../providers/settings/SettingsProvider.java  | 103 ++++++++++++++++
 2 files changed, 214 insertions(+)
 create mode 100644 packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java

diff --git a/packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java b/packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java
new file mode 100644
index 00000000..1919b72a
--- /dev/null
+++ b/packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java
@@ -0,0 +1,111 @@
+package com.android.providers.settings;
+
+import java.util.Set;
+
+/**
+ * ObliviOS (ADR-173): which settings an ordinary app may read. A settings table holds the
+ * configuration of one phone; read together, its values identify the phone and the person who
+ * configured it, and two apps that read the same values can be linked by them. An app that is not
+ * a system app therefore sees the keys below and nothing else: every other key reads as unset,
+ * the answer an app already gets for a key that does not exist.
+ *
+ * The keys are those that the framework itself reads inside the app process to lay out and
+ * format the app (view timeouts, text scale and animation scales, rotation, date and time format,
+ * password echo, whether a hard keyboard hides the soft one, whether the device is set up, the
+ * speech engine, the typing aids and the caption style) and the per-app android_id. Each has few
+ * values and keeps its default for most people; a key whose absence only returns the default of an
+ * optional feature is left hidden. The keys are matched by name only; none of them exists in two
+ * tables.
+ */
+final class SettingsHardening {
+    /** Global setting: 1 switches the hardening off for every app. */
+    static final String OPEN_SETTING = "oblivios_settings_open";
+    /** Global setting: comma-separated package names that read the real settings. */
+    static final String REAL_PACKAGES_SETTING = "oblivios_settings_real_packages";
+
+    private static final Set<String> ALLOWED_FOR_APPS = Set.of(
+            "airplane_mode_on", "animator_duration_scale", "transition_animation_scale",
+            "window_animation_scale", "android_id", "long_press_timeout", "multi_press_timeout",
+            "speak_password", "show_password", "font_scale", "time_12_24", "date_format",
+            "accelerometer_rotation", "user_rotation", "show_ime_with_hard_keyboard",
+            // TextView (Share, smart selection) and PhoneFallbackEventHandler read these in the
+            // app process; hidden they read 0 and every app loses those actions. 1 after setup.
+            "device_provisioned", "user_setup_complete",
+            // TtsEngines and TextToSpeechService: without them the engine, locale, rate and pitch
+            // the user chose are ignored in every app.
+            "tts_default_synth", "tts_default_locale", "tts_default_rate", "tts_default_pitch",
+            // TextKeyListener, ShowSecretsSetting, ViewConfiguration: typing and key-repeat aids.
+            "auto_caps", "auto_replace", "auto_punctuate", "show_password_touch",
+            "show_password_physical", "key_repeat_timeout", "key_repeat_delay",
+            "accessibility_text_cursor_blink_interval_ms",
+            // ConfirmationPrompt reads it in the app process to refuse a prompt while an
+            // accessibility service runs; hidden, the read fails and the prompt goes ahead. Also
+            // answered by AccessibilityManager.isEnabled(), so it adds nothing to the fingerprint.
+            "accessibility_enabled",
+            // CaptioningManager: how an app draws the captions the user asked for.
+            "accessibility_captioning_enabled", "accessibility_captioning_locale",
+            "accessibility_captioning_easy_reader_enabled", "accessibility_captioning_preset",
+            "accessibility_captioning_background_color",
+            "accessibility_captioning_foreground_color", "accessibility_captioning_edge_type",
+            "accessibility_captioning_edge_color", "accessibility_captioning_window_color",
+            "accessibility_captioning_typeface", "accessibility_captioning_font_scale");
+
+    /**
+     * List settings in which an app reads its own entries and no others: which notification
+     * listeners, accessibility services and input methods are enabled, and which input method is
+     * the default. Apps and libraries read them to see whether they were granted access or
+     * enabled as a keyboard; hidden, they show a "grant access" screen for ever. The whole value
+     * names the other apps of the user and stays hidden.
+     */
+    private static final Set<String> OWN_ENTRY_KEYS = Set.of("enabled_notification_listeners",
+            "enabled_accessibility_services", "enabled_input_methods", "default_input_method");
+
+    private SettingsHardening() {}
+
+    /** True if a hardened app reads the entries of the key that name its own package. */
+    static boolean isOwnEntryKey(String name) {
+        return name != null && OWN_ENTRY_KEYS.contains(name);
+    }
+
+    /**
+     * The entries of a colon-separated component list (package/class, an input method with its
+     * subtype ids after semicolons) whose package is exactly packageName, joined with a colon;
+     * null if there is none.
+     */
+    static String ownEntries(String value, String packageName) {
+        if (value == null || packageName == null || packageName.isEmpty()) {
+            return null;
+        }
+        StringBuilder own = null;
+        for (String entry : value.split(":")) {
+            final int slash = entry.indexOf('/');
+            if (slash >= 0 && entry.substring(0, slash).equals(packageName)) {
+                if (own == null) {
+                    own = new StringBuilder();
+                } else {
+                    own.append(':');
+                }
+                own.append(entry);
+            }
+        }
+        return own == null ? null : own.toString();
+    }
+
+    /** True if a hardened app may read the key. */
+    static boolean isAllowedForApps(String name) {
+        return name != null && ALLOWED_FOR_APPS.contains(name);
+    }
+
+    /** True if the comma-separated list names the package exactly. */
+    static boolean listContains(String commaSeparated, String packageName) {
+        if (commaSeparated == null || packageName == null) {
+            return false;
+        }
+        for (String entry : commaSeparated.split(",")) {
+            if (entry.trim().equals(packageName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
