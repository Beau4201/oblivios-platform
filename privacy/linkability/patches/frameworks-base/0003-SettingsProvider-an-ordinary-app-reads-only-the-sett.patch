From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 18 Oct 2026 04:17:40 +0200
Subject: [PATCH 3/5] SettingsProvider: an ordinary app reads only the settings
 it needs

All 262 readable settings were readable by any app, together a
fingerprint of the phone and its owner, with boot_count and device_name
among them. An app that is not a system app, platform-signed or test-only
now sees 14 keys that the framework reads inside the app process; every
other key reads as unset. freeholdos_settings_open = 1 switches this off
and freeholdos_settings_real_packages names the packages that read the
real settings.
---
 .../providers/settings/SettingsHardening.java | 48 +++++++++++++
 .../providers/settings/SettingsProvider.java  | 71 +++++++++++++++++++
 2 files changed, 119 insertions(+)
 create mode 100644 packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java

diff --git a/packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java b/packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java
new file mode 100644
index 0000000..3ecbb23
--- /dev/null
+++ b/packages/SettingsProvider/src/com/android/providers/settings/SettingsHardening.java
@@ -0,0 +1,48 @@
+package com.android.providers.settings;
+
+import java.util.Set;
+
+/**
+ * FreeholdOS (ADR-173): which settings an ordinary app may read. A settings table holds the
+ * configuration of one phone; read together, its values identify the phone and the person who
+ * configured it, and two apps that read the same values can be linked by them. An app that is not
+ * a system app therefore sees the keys below and nothing else: every other key reads as unset,
+ * the answer an app already gets for a key that does not exist.
+ *
+ * The keys are those that the framework itself reads inside the app process to lay out and
+ * format the app (view timeouts, text scale and animation scales, rotation, date and time format,
+ * password echo) and the per-app android_id. The keys are matched by name only; none of them
+ * exists in two tables.
+ */
+final class SettingsHardening {
+    /** Global setting: 1 switches the hardening off for every app. */
+    static final String OPEN_SETTING = "freeholdos_settings_open";
+    /** Global setting: comma-separated package names that read the real settings. */
+    static final String REAL_PACKAGES_SETTING = "freeholdos_settings_real_packages";
+
+    private static final Set<String> ALLOWED_FOR_APPS = Set.of(
+            "airplane_mode_on", "animator_duration_scale", "transition_animation_scale",
+            "window_animation_scale", "android_id", "long_press_timeout", "multi_press_timeout",
+            "speak_password", "show_password", "font_scale", "time_12_24", "date_format",
+            "accelerometer_rotation", "user_rotation");
+
+    private SettingsHardening() {}
+
+    /** True if a hardened app may read the key. */
+    static boolean isAllowedForApps(String name) {
+        return name != null && ALLOWED_FOR_APPS.contains(name);
+    }
+
+    /** True if the comma-separated list names the package exactly. */
+    static boolean listContains(String commaSeparated, String packageName) {
+        if (commaSeparated == null || packageName == null) {
+            return false;
+        }
+        for (String entry : commaSeparated.split(",")) {
+            if (entry.trim().equals(packageName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
