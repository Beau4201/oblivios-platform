+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.os;
+
+/**
+ * FreeholdOS (ADR-173): the rounding that {@link VibratorInfo#withCoarseCalibration} applies to the
+ * measured calibration of the motor, apart from VibratorInfo so that a host test can run it.
+ */
+final class VibratorCoarse {
+    private VibratorCoarse() {}
+
+    /**
+     * Rounds to a multiple of step. NaN and the infinities stay as they are:
+     * Math.round(Infinity) is Integer.MAX_VALUE and would turn an infinite value into a large
+     * finite one.
+     */
+    static float coarse(float value, float step) {
+        if (Float.isNaN(value) || Float.isInfinite(value)) {
+            return value;
+        }
+        return Math.round(value / step) * step;
+    }
+
+    /**
+     * The resonant frequency an app gets: rounded to 10 Hz, or NaN when the rounded value is not
+     * positive (a frequency profile with a resonant frequency of zero or less is invalid).
+     */
+    static float resonant(float resonantHz) {
+        final float rounded = coarse(resonantHz, 10f);
+        return rounded > 0f ? rounded : Float.NaN;
+    }
+}
diff --git a/core/java/android/os/VibratorInfo.java b/core/java/android/os/VibratorInfo.java
index acf7bd8a8929..80eb7080936e 100644
--- a/core/java/android/os/VibratorInfo.java
+++ b/core/java/android/os/VibratorInfo.java
@@ -151,27 +151,22 @@ public class VibratorInfo implements Parcelable {
      * the Q factor are measured per unit at the factory, to many decimals, and the frequency to
      * acceleration curve is measured the same way, so together they identify the phone to every
      * app that reads them. The copy keeps the resonant frequency to 10 Hz and the Q factor to 0.5,
-     * which is enough to pick a haptic waveform, and drops the curve.
+     * which is enough to pick a haptic waveform, and replaces the curve by a flat one.
      *
      * @hide
      */
     @NonNull
     public VibratorInfo withCoarseCalibration() {
         return new VibratorInfo(mId, mCapabilities, mSupportedEffects, mSupportedPrimitives,
-                mPrimitiveDelayMax, mCompositionSizeMax, coarse(mQFactor, 0.5f),
+                mPrimitiveDelayMax, mCompositionSizeMax, VibratorCoarse.coarse(mQFactor, 0.5f),
                 new FrequencyProfileLegacy(
-                        coarse(mFrequencyProfileLegacy.mResonantFrequencyHz, 10f),
+                        VibratorCoarse.resonant(mFrequencyProfileLegacy.mResonantFrequencyHz),
                         Float.NaN, Float.NaN, null),
-                new FrequencyProfile(coarse(mFrequencyProfile.mResonantFrequencyHz, 10f),
-                        null, null),
+                mFrequencyProfile.withCoarseCalibration(),
                 mMaxEnvelopeEffectSize, mMinEnvelopeEffectControlPointDurationMillis,
                 mMaxEnvelopeEffectControlPointDurationMillis);
     }
 
-    private static float coarse(float value, float step) {
-        return Float.isNaN(value) ? value : Math.round(value / step) * step;
-    }
-
     @Override
     public void writeToParcel(Parcel dest, int flags) {
         dest.writeInt(mId);
@@ -666,6 +661,25 @@ public class VibratorInfo implements Parcelable {
             return mFrequenciesHz == null;
         }
 
+        /**
+         * FreeholdOS (ADR-173): a copy that keeps the range an app can use (the lowest and highest
+         * frequency to 10 Hz, the resonant frequency to 10 Hz) and replaces the measured curve of
+         * the unit by a flat one at the maximum acceleration to 0.5 G. An empty profile has no
+         * per-unit data and is returned as it is.
+         *
+         * @hide
+         */
+        FrequencyProfile withCoarseCalibration() {
+            if (isEmpty()) {
+                return this;
+            }
+            final float acceleration = VibratorCoarse.coarse(mMaxOutputAccelerationGs, 0.5f);
+            return new FrequencyProfile(VibratorCoarse.resonant(mResonantFrequencyHz),
+                    new float[] {VibratorCoarse.coarse(mMinFrequencyHz, 10f),
+                            VibratorCoarse.coarse(mMaxFrequencyHz, 10f)},
+                    new float[] {acceleration, acceleration});
+        }
+
         /**
          * Returns a list of available frequencies.
          */
