From e34cd91a4b732288674d325763a6185bfb239112 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 18 Oct 2026 05:35:04 +0200
Subject: [PATCH 7/7] Clipboard: let the owner and a paste-grant holder hear a
 clip change

The listener condition used only the persistent read switch, which is now
off by default, so the app that set a clip and a clipboard manager that
holds a paste grant stopped hearing changes. Use the same access decision
as a read: a listener hears a change unless its read would be denied.
---
 .../server/clipboard/ClipboardService.java        | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/services/core/java/com/android/server/clipboard/ClipboardService.java b/services/core/java/com/android/server/clipboard/ClipboardService.java
index 1eec110..b35778a 100644
--- a/services/core/java/com/android/server/clipboard/ClipboardService.java
+++ b/services/core/java/com/android/server/clipboard/ClipboardService.java
@@ -1173,8 +1173,9 @@ public class ClipboardService extends SystemService {
                             clipboard.primaryClipListeners.getBroadcastCookie(i);
 
                     // FreeholdOS: a listener hears that a clip changed only if it may read the
-                    // clip. The moment a clip is set is otherwise a message from the app that
-                    // set it to any focused app that listens.
+                    // clip: the app that set it, an app holding a paste grant or an app with the
+                    // read switch on. The moment a clip is set is otherwise a message from the
+                    // app that set it to any focused app that listens.
                     if (clipboardAccessAllowed(
                             AppOpsManager.OP_READ_CLIPBOARD,
                             li.mPackageName,
@@ -1182,9 +1183,13 @@ public class ClipboardService extends SystemService {
                             li.mUid,
                             UserHandle.getUserId(li.mUid),
                             clipboard.deviceId)
-                            && mAccess.clipboardReadAllowedForPackage(li.mPackageName, li.mUid,
-                                    UserHandle.getUserId(li.mUid),
-                                    isDefaultIme(UserHandle.getUserId(li.mUid), li.mPackageName))) {
+                            && mAccess.getPayloadReadAccessLocked(
+                                    mAccess.clipboardReadAllowedForPackage(li.mPackageName,
+                                            li.mUid, UserHandle.getUserId(li.mUid),
+                                            isDefaultIme(UserHandle.getUserId(li.mUid),
+                                                    li.mPackageName)),
+                                    li.mUid, UserHandle.getUserId(li.mUid), clipboard.deviceId)
+                                    != ClipboardAccess.PayloadReadAccess.DENIED) {
                         clipboard.primaryClipListeners.getBroadcastItem(i)
                                 .dispatchPrimaryClipChanged();
                     }
