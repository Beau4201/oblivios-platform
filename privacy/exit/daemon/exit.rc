# SPDX-License-Identifier: Apache-2.0
# The services of Compartments (ADR-184, ADR-186): the exit daemon and the route helper, one executable in two domains.

on post-fs-data
    mkdir /data/misc/exitd 0700 2961 2961
    mkdir /data/misc/exitd/state 0700 2961 2961
    mkdir /data/misc/exitd/cache 0700 2961 2961

# The exit daemon: Arti and the packet layer. It runs from boot with a Tor client that has contacted nobody and starts it
# when the exit app first sends a table with a Tor or masked class. The uid is in the OEM range [assumption: unused on the
# device, checked by NET-009]. It has NET_ADMIN for the tun and sock_diag and nothing else. Not oneshot: init starts it again
# after an exit, a panic (the Android standard library of the tree aborts) or the shutdown that ends the Tor client.
# The control socket is world-connectable on purpose: the SELinux policy lets only exit_app connect and the daemon reads the
# peer's SELinux context before it reads a byte. There is no memcg.limit_in_bytes line: init refuses a service with a memory
# control unless ro.config.per_app_memcg is set, which it is not on a phone (createProcessGroup returns -EINVAL, so neither
# service started on image 2026102301; NET-009), and the hard limit of D-K (160 MiB) is open until another mechanism is chosen.
# The Arti quota (--memory-max, 64 MiB) is the only cap. stdio_to_kmsg sends the few fixed lines that the services print (never
# a name or a destination) to the kernel log, where userdebug builds keep them.
# The group inet (3003) is what lets a native uid open an AF_INET socket: with only its own gid, bind() on 127.0.0.1 failed
# with EACCES (no SELinux denial) and the self-check ended the daemon before Arti could start; with the same uid and gid and
# only the group 3003 it succeeded [measured: NET-009, lynx image 2026102302]. exitd_route has no inet socket and gets no group.
# The group vpn (1016) is what lets it open /dev/net/tun, which is system:vpn 0660 on the device: without it open() returns EACCES
# before SELinux is asked and the daemon ends with `tunnel could not be created` [measured: NET-009, lynx image 2026102303].
service exitd /system/bin/exitd --state-dir /data/misc/exitd/state --cache-dir /data/misc/exitd/cache --memory-max 67108864 --control-fd-env ANDROID_SOCKET_exitd --peer-context exit_app --mask-list /system/etc/oblivios/exit-mask-list.tsv
    class main
    user 2961
    group 2961 inet vpn
    capabilities NET_ADMIN
    socket exitd stream+listen 0666 2961 2961
    stdio_to_kmsg

# The route helper: the only writer of policy rules and routes, in the closed language of routes/spec.rs. NET_ADMIN, one
# NETLINK_ROUTE socket, no internet, no file. Its label is named here because it shares the executable with the daemon.
service exitd_route /system/bin/exitd --routes --control-fd-env ANDROID_SOCKET_exitd_route --peer-context exit_app
    class main
    user 2962
    group 2962
    capabilities NET_ADMIN
    seclabel u:r:exitd_route:s0
    socket exitd_route stream+listen 0666 2962 2962
    stdio_to_kmsg
