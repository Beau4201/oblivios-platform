diff --git a/private/exit_app.te b/private/exit_app.te
new file mode 100644
index 0000000..280d068
--- /dev/null
+++ b/private/exit_app.te
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: Apache-2.0
+# The exit app of Compartments (ADR-184, ADR-186): a platform-signed, privileged app that owns the policy. It registers a
+# network for the daemon's tun, sets the network preference of the apps on Tor, and drives the daemon and the route helper
+# over their sockets. It has no INTERNET permission, no netlink socket and no tun access. An app domain like logviewer_app.
+type exit_app, domain;
+typeattribute exit_app coredomain;
+
+app_domain(exit_app)
+untrusted_app_domain(exit_app)
+
+# The control sockets of the two services, created by init.
+unix_socket_connect(exit_app, exitd, exitd)
+unix_socket_connect(exit_app, exitd_route, exitd_route)
+
+# Only the exit app may connect to them: no other app domain, privileged apps and the shell included.
+neverallow { domain -exit_app } exitd:unix_stream_socket connectto;
+neverallow { domain -exit_app } exitd_route:unix_stream_socket connectto;
diff --git a/private/exitd.te b/private/exitd.te
new file mode 100644
index 0000000..043e58e
--- /dev/null
+++ b/private/exitd.te
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: Apache-2.0
+# The exit daemon of Compartments (ADR-184, ADR-186): Arti, the Tor client, and a user-space packet layer, in Rust. It
+# creates the tun interface, finds the owner uid of a flow with sock_diag, talks to the Tor network over ordinary sockets
+# and answers the DNS questions of the masked apps. It writes no route and no rule: the route helper (exitd_route) does,
+# and it has no inet socket. The exit app is its only peer.
+type exitd, domain;
+typeattribute exitd coredomain;
+type exitd_exec, system_file_type, exec_type, file_type;
+type exitd_socket, file_type, coredomain_socket;
+type exitd_data_file, file_type, data_file_type, core_data_file_type;
+
+init_daemon_domain(exitd)
+# Ordinary tcp and udp sockets to the Tor network and the upstream resolver.
+net_domain(exitd)
+
+# The tun interface: create it and carry packets, nothing else of the ioctls.
+allow exitd tun_device:chr_file rw_file_perms;
+allowxperm exitd tun_device:chr_file ioctl { TUNGETIFF TUNSETIFF };
+allow exitd self:capability net_admin;
+
+# sock_diag, to find the uid that owns a flow (the same rules as network_stack has for its tcp lookups).
+allow exitd self:netlink_tcpdiag_socket create_socket_perms_no_ioctl;
+# For kernel < 6.13
+allow exitd self:netlink_tcpdiag_socket { nlmsg_read nlmsg_write };
+# For kernel >= 6.13
+allow exitd self:netlink_tcpdiag_socket nlmsg;
+
+# The Tor state and the directory cache.
+allow exitd exitd_data_file:dir create_dir_perms;
+allow exitd exitd_data_file:file create_file_perms;
+
+# The daemon reads the peer's SELinux context to check that it is the exit app.
+allow exitd self:unix_stream_socket getopt;
+
+# What the daemon must never be able to do: change routing (it has the NETLINK_ROUTE socket of every network domain, which can
+# read, and not nlmsg_write) or touch the packet filter.
+neverallow exitd self:netlink_route_socket { nlmsg_write nlmsg_readpriv };
+neverallow exitd self:netlink_netfilter_socket *;
diff --git a/private/exitd_route.te b/private/exitd_route.te
new file mode 100644
index 0000000..5c0b930
--- /dev/null
+++ b/private/exitd_route.te
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: Apache-2.0
+# The route helper of Compartments (ADR-186): `exitd --routes`, the same binary as the exit daemon in its own domain. It
+# is the only part of the exit service that writes policy rules and routes, and it can write only the closed language of
+# routes/spec.rs: no inet socket, no file, no other domain. The exit app is its only peer.
+type exitd_route, domain;
+typeattribute exitd_route coredomain;
+type exitd_route_socket, file_type, coredomain_socket;
+
+# init starts it with `seclabel u:r:exitd_route:s0` from the same executable as the daemon; the transition has no
+# type_transition of its own, so the daemon's remains the default for exitd_exec.
+domain_trans(init, exitd_exec, exitd_route)
+
+# One NETLINK_ROUTE socket, to add the tun address, bring the link up, and write the rules and the default routes.
+allow exitd_route self:capability net_admin;
+allow exitd_route self:netlink_route_socket create_socket_perms_no_ioctl;
+# For kernel < 6.13
+allow exitd_route self:netlink_route_socket { nlmsg_read nlmsg_write };
+# For kernel >= 6.13
+allow exitd_route self:netlink_route_socket nlmsg;
+allowxperm exitd_route self:netlink_route_socket nlmsg {
+  RTM_NEWRULE RTM_DELRULE RTM_GETRULE
+  RTM_NEWROUTE RTM_DELROUTE RTM_GETROUTE
+  RTM_NEWADDR RTM_NEWLINK RTM_GETLINK
+};
+
+# It reads the peer's SELinux context before it reads a byte.
+allow exitd_route self:unix_stream_socket getopt;
+
+# No internet of any kind, and no file but its own binary.
+neverallow exitd_route self:{ tcp_socket udp_socket rawip_socket packet_socket } *;
+neverallow exitd_route self:netlink_tcpdiag_socket *;
