<!-- ADR-184, ADR-186. Only the permissions that the platform treats as privileged need to be listed; the others are granted
     to a platform-signed app by signature. check-static.sh compares this list with the manifest. -->
<permissions>
    <privapp-permissions package="org.freeholdos.exit">
        <permission name="android.permission.NETWORK_FACTORY"/>
        <permission name="android.permission.CONTROL_OEM_PAID_NETWORK_PREFERENCE"/>
        <permission name="android.permission.MANAGE_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
    </privapp-permissions>
</permissions>
