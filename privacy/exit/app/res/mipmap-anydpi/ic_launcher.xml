<!-- The launcher icon: one flat mark in three tones of the system accent, so that it takes the wallpaper colours like the system apps
     (docs/design/app-logos-2026-10-29.html in freeholdos-foundation, ADR-200). The themed form is the same drawing in one colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/system_accent1_100"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
