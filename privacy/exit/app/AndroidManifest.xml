<!-- Compartments exit app (ADR-184, ADR-186): owns the policy and drives the exit daemon and the route helper. It has no
     INTERNET permission: it talks to its two services over local sockets and registers a network for the daemon's tun. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.freeholdos.exit">

    <uses-permission android:name="android.permission.NETWORK_FACTORY" />
    <uses-permission android:name="android.permission.CONTROL_OEM_PAID_NETWORK_PREFERENCE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The users of the device, to mask the apps of every user: UserManager.getUserHandles needs MANAGE_USERS or CREATE_USERS
         [verified-in-source: UserManagerService.getUsers calls checkCreateUsersPermission]; QUERY_USERS, which this app asked for
         before, answers none of the calls that list users, so every pass of the controller ended in a SecurityException and no
         preference or rule was ever set (NET-009, lynx image 2026102303). -->
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The policy service of the profiles (ADR-208) checks this permission on every call but getProfile; only this app holds it. -->
    <uses-permission android:name="org.freeholdos.permission.MANAGE_COMPARTMENTS" />

    <!-- Persistent and direct-boot aware: the process starts at boot, before the first unlock, and the apps on Tor lose the
         default network from that moment (F11). -->
    <application
        android:name=".ExitApplication"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:icon="@mipmap/ic_launcher"
        android:defaultToDeviceProtectedStorage="true"
        android:theme="@style/Theme.SubSettingsBase"
        android:allowBackup="false">

        <!-- The main page of Compartments. The row "Compartments" under Network & internet is a preference of the Settings app
             itself (the patch packages-apps-Settings/0002 of privacy/exit), not an injected tile, because Settings search does not
             index the tiles that other apps inject (an injected "Compartments", "Atlas" or "Guardian" found nothing on lynx image
             2026102304); a preference in the XML of that page is found by its title and keywords. The row starts this activity by
             its component, so it needs the permission that only Settings holds, like the page of one app. It is built with the
             theme and widgets of SettingsLib and stays out of the recents list like the pages of Settings, so that it is not
             taken for an app of its own. -->
        <activity
            android:name=".ExitSettingsActivity"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:permission="android.permission.NETWORK_SETTINGS"
            android:exported="true" />

        <!-- The page of one app (the package is the data of the intent). The "Compartments" row of the app's info page in
             Settings and the list of apps start it; only the platform's Settings app holds NETWORK_SETTINGS, so no other app
             can open it, and a package that is not installed closes it. -->
        <activity
            android:name=".ExitAppActivity"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:permission="android.permission.NETWORK_SETTINGS"
            android:exported="true" />

        <!-- The two sub-pages, started by the rows of the main page only. -->
        <activity
            android:name=".ExitAppsActivity"
            android:label="@string/apps_title"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".ExitOverridesActivity"
            android:label="@string/overrides_title"
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- The radio page of the device identity (ADR-209): one app, or the default for new apps; started by the pages of
             Compartments only. -->
        <activity
            android:name=".ExitIdentityActivity"
            android:label="@string/identity_title"
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- What stays visible (ADR-206, ADR-208): read-only, started by a row of the main page only. -->
        <activity
            android:name=".ExitVisibleActivity"
            android:label="@string/identity_visible_title"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- The place of the persona of one app (ADR-208): opened by the page of the app, so not exported. -->
        <activity
            android:name=".ExitPlaceActivity"
            android:label="@string/place_title"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- The buttons of the notification. Not exported: only the pending intents of this app reach it. -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />
    </application>
</manifest>
