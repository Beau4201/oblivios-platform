// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ADR-184, NET-001b. Userdebug-only and throwaway: the probe rides PRODUCT_PACKAGES_DEBUG (patch 0001 of
// vendor-adevtool) and is on the FORBIDDEN list of check-required-packages.sh for user builds, as the AirPods
// harness (ADR-120). It is platform-signed because NETWORK_FACTORY and CONTROL_OEM_PAID_NETWORK_PREFERENCE are
// signature permissions; the exit app of milestone 4 replaces it.
android_app {
    name: "ExitProbe",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    // TestNetworkManager and NetworkAgent are in the module-lib stubs of Connectivity; "module_current" alone does not put
    // android.net.* on the class path (the first module build failed with 46 "cannot find symbol" errors) and Soong refuses
    // a direct dependency on the java_sdk_library itself, so the module-lib stubs are named.
    sdk_version: "module_current",
    libs: ["framework-connectivity.stubs.module_lib"],
    certificate: "platform",
    privileged: true,
    required: ["privapp-permissions-org.oblivios.exitprobe.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-org.oblivios.exitprobe.xml",
    src: "privapp-permissions-org.oblivios.exitprobe.xml",
    sub_dir: "permissions",
}
