From f833f89222e50b2940248066990f94f516bcab0b Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Mon, 2 Nov 2026 13:40:04 +0100
Subject: [PATCH] telephony: answer an app with a persona but no place with no
 cell

An Isolated app for which no place can be chosen (no place data on the image, or no country to choose a place in) had
no entry in the persona file, so the Wi-Fi, Bluetooth, connectivity and telephony code gave it the real surroundings
while its page said it had a persona. The file now lists such an app on a line "n APPID", and the readers ask
hasPersona(), which is true for both a place line and an n line. Review item P8 (rest).

PersonaCells.hasPersona() decides; an app without a place is given no cell and no cell location instead of the real radio.
---
 src/com/android/phone/PersonaCells.java       |  7 +-
 src/com/android/phone/PersonaFile.java        | 68 ++++++++++++++++---
 src/com/android/phone/PersonaReader.java      | 18 ++++-
 .../android/phone/PhoneInterfaceManager.java  | 25 +++----
 4 files changed, 92 insertions(+), 26 deletions(-)

diff --git a/src/com/android/phone/PersonaCells.java b/src/com/android/phone/PersonaCells.java
index 61424f4..fcebf4e 100644
--- a/src/com/android/phone/PersonaCells.java
+++ b/src/com/android/phone/PersonaCells.java
@@ -35,11 +35,16 @@ final class PersonaCells {
     private boolean mRead;
     private CellSubset mCells;
 
-    /** The place of the app of this uid, 0 when it has no persona. */
+    /** The place of the app of this uid, 0 when it has none: no persona, or a persona without a place (see {@link #hasPersona}). */
     int placeOf(int uid) {
         return mReader.placeOf(uid);
     }
 
+    /** Whether the app of this uid has a persona; one without a place is answered with no cells at all. */
+    boolean hasPersona(int uid) {
+        return mReader.hasPersona(uid);
+    }
+
     /** The cells of the place, the first one serving; an empty list for a place without cells. */
     List<CellInfo> infos(int placeId) {
         List<CellSubset.Cell> cells = cellsFor(placeId);
diff --git a/src/com/android/phone/PersonaFile.java b/src/com/android/phone/PersonaFile.java
