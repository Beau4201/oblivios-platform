diff --git a/src/com/android/phone/CellSubset.java b/src/com/android/phone/CellSubset.java
new file mode 100644
index 0000000..84f1c78
--- /dev/null
+++ b/src/com/android/phone/CellSubset.java
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.phone;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/**
+ * The cell towers of the persona (ADR-208): a few towers per place of {@link Places}, with the operator codes of the country,
+ * read once from a read-only file of the image. Parsed strictly, like {@link Places}. Pure Java.
+ *
+ * <p>Format: one line per cell, five tab-separated decimal fields and a newline after every line: {@code placeId mcc mnc tac
+ * cid}. The mcc is 200 to 799, the mnc 0 to 999, the tac 0 to 65535 and the cid 0 to 2^32-1. At most 64 lines belong to one
+ * place, and {@link #cellsFor} returns the first 8 of them.
+ */
+final class CellSubset {
+    static final int MAX_LINES = 1000000;
+    static final int MAX_PER_PLACE = 64;
+    static final int RETURNED = 8;
+    private static final Pattern NUMBER = Pattern.compile("0|[1-9][0-9]{0,9}");
+
+    static final class Cell {
+        final int mcc;
+        final int mnc;
+        final int tac;
+        final long cid;
+
+        Cell(int mcc, int mnc, int tac, long cid) {
+            this.mcc = mcc;
+            this.mnc = mnc;
+            this.tac = tac;
+            this.cid = cid;
+        }
+    }
+
+    private final Map<Integer, List<Cell>> byPlace;
+
+    private CellSubset(Map<Integer, List<Cell>> byPlace) {
+        this.byPlace = byPlace;
+    }
+
+    /** @throws IllegalArgumentException for any text that is not exactly a file of the format */
+    static CellSubset parse(String tsv) {
+        if (tsv == null || tsv.isEmpty() || tsv.charAt(tsv.length() - 1) != '\n') {
+            throw new IllegalArgumentException("not a cell file");
+        }
+        Map<Integer, List<Cell>> out = new HashMap<>();
+        int start = 0;
+        int lines = 0;
+        while (start < tsv.length()) {
+            int end = tsv.indexOf('\n', start);
+            if (++lines > MAX_LINES) {
+                throw new IllegalArgumentException("too many lines");
+            }
+            String[] f = tsv.substring(start, end).split("\t", -1);
+            start = end + 1;
+            if (f.length != 5) {
+                throw new IllegalArgumentException("a line has " + f.length + " fields");
+            }
+            long place = number(f[0]);
+            long mcc = number(f[1]);
+            long mnc = number(f[2]);
+            long tac = number(f[3]);
+            long cid = number(f[4]);
+            if (place < 1 || place > Integer.MAX_VALUE || mcc < 200 || mcc > 799 || mnc > 999 || tac > 65535 || cid > 4294967295L) {
+                throw new IllegalArgumentException("a value is out of range");
+            }
+            List<Cell> list = out.computeIfAbsent((int) place, k -> new ArrayList<>());
+            if (list.size() >= MAX_PER_PLACE) {
+                throw new IllegalArgumentException("too many cells for one place");
+            }
+            list.add(new Cell((int) mcc, (int) mnc, (int) tac, cid));
+        }
+        return new CellSubset(out);
+    }
+
+    private static long number(String s) {
+        if (!NUMBER.matcher(s).matches()) {
+            throw new IllegalArgumentException("not a number");
+        }
+        return Long.parseLong(s);
+    }
+
+    /**
+     * The numeric operator of the first cell of the place, as a real operator property holds it: the mcc and the mnc, the mnc
+     * with two digits below 100 and three otherwise; "" for a place without cells.
+     */
+    String operatorFor(int placeId) {
+        List<Cell> all = byPlace.get(placeId);
+        if (all == null) {
+            return "";
+        }
+        Cell first = all.get(0);
+        return first.mcc + String.format("%02d", first.mnc);
+    }
+
+    /** At most 8 cells of the place in file order; empty for a place without cells. */
+    List<Cell> cellsFor(int placeId) {
+        List<Cell> all = byPlace.get(placeId);
+        if (all == null) {
+            return Collections.emptyList();
+        }
+        return Collections.unmodifiableList(new ArrayList<>(all.subList(0, Math.min(RETURNED, all.size()))));
+    }
+}
diff --git a/src/com/android/phone/PersonaCells.java b/src/com/android/phone/PersonaCells.java
new file mode 100644
index 0000000..2e1191a
--- /dev/null
+++ b/src/com/android/phone/PersonaCells.java
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.phone;
+
+import android.os.SystemClock;
+import android.telephony.CellConfigLte;
+import android.telephony.CellIdentity;
+import android.telephony.CellIdentityGsm;
+import android.telephony.CellIdentityLte;
+import android.telephony.CellInfo;
+import android.telephony.CellInfoLte;
+import android.telephony.CellSignalStrengthLte;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * The cells of the place of an app with a persona (ADR-208): what the Telephony app answers to such an app instead of the
+ * serving and neighbouring cells of the real radio. The place comes from the persona file ({@link PersonaReader}), the cells
+ * from the read-only data of the image ({@link CellSubset}). Every signal value is one fixed, plausible number, so that nothing
+ * of the real radio is in the answer.
+ */
+final class PersonaCells {
+    static final String CELLS_FILE = "/product/etc/compartments/cells.tsv";
+    private static final int MAX_FILE_BYTES = 16 * 1024 * 1024;
+    private static final int LTE_CI_MASK = 0x0FFFFFFF;
+    private static final int LTE_PCI_COUNT = 504;
+
+    private final PersonaReader mReader = new PersonaReader();
+    private final Object mLock = new Object();
+    private boolean mRead;
+    private CellSubset mCells;
+
+    /** The place of the app of this uid, 0 when it has no persona. */
+    int placeOf(int uid) {
+        return mReader.placeOf(uid);
+    }
+
+    /** The cells of the place, the first one serving; an empty list for a place without cells. */
+    List<CellInfo> infos(int placeId) {
+        List<CellSubset.Cell> cells = cellsFor(placeId);
+        List<CellInfo> out = new ArrayList<>(cells.size());
+        long now = SystemClock.elapsedRealtimeNanos();
+        for (int i = 0; i < cells.size(); i++) {
+            out.add(new CellInfoLte(i == 0 ? CellInfo.CONNECTION_PRIMARY_SERVING : CellInfo.CONNECTION_NONE, i == 0, now,
+                    identity(cells.get(i)), new CellSignalStrengthLte(-65, -95, -10, 10, 10, 0), new CellConfigLte(false)));
+        }
+        return out;
+    }
+
+    /** The identity of the first cell of the place; the empty identity of a phone without service for a place without cells. */
+    CellIdentity location(int placeId) {
+        List<CellSubset.Cell> cells = cellsFor(placeId);
+        return cells.isEmpty() ? new CellIdentityGsm() : identity(cells.get(0));
+    }
+
+    private static CellIdentityLte identity(CellSubset.Cell c) {
+        int ci = (int) (c.cid & LTE_CI_MASK);
+        return new CellIdentityLte(ci, ci % LTE_PCI_COUNT, c.tac, CellInfo.UNAVAILABLE, new int[0], CellInfo.UNAVAILABLE,
+                String.valueOf(c.mcc), String.format("%02d", c.mnc), "", "", Collections.<String>emptyList(), null);
+    }
+
+    private List<CellSubset.Cell> cellsFor(int placeId) {
+        CellSubset cells;
+        synchronized (mLock) {
+            if (!mRead) {
+                mCells = read();
+                mRead = true;
+            }
+            cells = mCells;
+        }
+        return cells == null ? Collections.<CellSubset.Cell>emptyList() : cells.cellsFor(placeId);
+    }
+
+    /** The cell data of the image; no cells at all when it has none or the file is not exactly a file of the format. */
+    private static CellSubset read() {
+        File f = new File(CELLS_FILE);
+        try {
+            if (f.isFile() && f.length() <= MAX_FILE_BYTES) {
+                return CellSubset.parse(new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8));
+            }
+        } catch (IOException | RuntimeException e) {
+            // no cell data: the persona then has no cells
+        }
+        return null;
+    }
+}
diff --git a/src/com/android/phone/PersonaFile.java b/src/com/android/phone/PersonaFile.java
new file mode 100644
index 0000000..92d80ed
--- /dev/null
+++ b/src/com/android/phone/PersonaFile.java
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.phone;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.regex.Pattern;
+
+/**
+ * The file that tells the processes which place an Isolated app is in (ADR-208). The system server writes it; the telephony,
+ * Wi-Fi and Bluetooth code read it, each with its own copy of this class, because they are other class loaders or processes
+ * (a check of the package keeps the copies equal). Pure Java, no import beyond {@code java.util}.
+ *
+ * <p>Format: {@code s} and the 16 lower-case hex digits of the salt, then one line {@code p APPID PLACE} for each app that has a
+ * persona, in app id order, every line ended by a newline, at most 8192 lines. An app id is of an ordinary app (10000 to 19999)
+ * and a place is a positive number of {@link Places}. A reader that gets anything else refuses the whole file.
+ */
+final class PersonaFile {
+    static final int MAX_LINES = 8192;
+    private static final int FIRST_APP_ID = 10000;
+    private static final int LAST_APP_ID = 19999;
+    private static final int USER_OFFSET = 100000;
+    private static final int SANDBOX_OFFSET = 10000;
+    private static final Pattern SALT = Pattern.compile("s [0-9a-f]{16}");
+    private static final Pattern LINE = Pattern.compile("p (0|[1-9][0-9]{0,9}) (0|[1-9][0-9]{0,9})");
+
+    private final long salt;
+    private final Map<Integer, Integer> places;
+
+    private PersonaFile(long salt, Map<Integer, Integer> places) {
+        this.salt = salt;
+        this.places = places;
+    }
+
+    /** The text of the file for the apps (by app id) that have a place. */
+    static String format(long salt, Map<Integer, Integer> appIdToPlace) {
+        if (appIdToPlace == null || appIdToPlace.size() > MAX_LINES - 1) {
+            throw new IllegalArgumentException("too many apps");
+        }
+        Map<Integer, Integer> sorted = new TreeMap<>();
+        for (Map.Entry<Integer, Integer> e : appIdToPlace.entrySet()) {
+            Integer appId = e.getKey();
+            Integer place = e.getValue();
+            if (appId == null || place == null || appId < FIRST_APP_ID || appId > LAST_APP_ID || place < 1) {
+                throw new IllegalArgumentException("an app id or a place is out of range");
+            }
+            sorted.put(appId, place);
+        }
+        StringBuilder b = new StringBuilder(String.format("s %016x\n", salt));
+        for (Map.Entry<Integer, Integer> e : sorted.entrySet()) {
+            b.append("p ").append(e.getKey()).append(' ').append(e.getValue()).append('\n');
+        }
+        return b.toString();
+    }
+
+    /** @throws IllegalArgumentException for any text that is not exactly a file of the format */
+    static PersonaFile parse(String text) {
+        if (text == null || text.isEmpty() || text.charAt(text.length() - 1) != '\n') {
+            throw new IllegalArgumentException("not a persona file");
+        }
+        Map<Integer, Integer> out = new HashMap<>();
+        long salt = 0;
+        int start = 0;
+        int lines = 0;
+        while (start < text.length()) {
+            int end = text.indexOf('\n', start);
+            String line = text.substring(start, end);
+            start = end + 1;
+            if (++lines > MAX_LINES) {
+                throw new IllegalArgumentException("too many lines");
+            }
+            if (lines == 1) {
+                if (!SALT.matcher(line).matches()) {
+                    throw new IllegalArgumentException("the salt line must come first");
+                }
+                salt = Long.parseUnsignedLong(line.substring(2), 16);
+                continue;
+            }
+            if (!LINE.matcher(line).matches()) {
+                throw new IllegalArgumentException("not a place line");
+            }
+            int space = line.indexOf(' ', 2);
+            long appId = Long.parseLong(line.substring(2, space));
+            long place = Long.parseLong(line.substring(space + 1));
+            if (appId < FIRST_APP_ID || appId > LAST_APP_ID || place < 1 || place > Integer.MAX_VALUE) {
+                throw new IllegalArgumentException("an app id or a place is out of range");
+            }
+            if (out.put((int) appId, (int) place) != null) {
+                throw new IllegalArgumentException("an app id is repeated");
+            }
+        }
+        return new PersonaFile(salt, Collections.unmodifiableMap(out));
+    }
+
+    long salt() {
+        return salt;
+    }
+
+    /**
+     * The place of the app that this uid belongs to (the same app in every user, and its SDK sandbox, 20000 to 29999, answers
+     * for the app 10000 below it), or 0 when the app has no persona.
+     */
+    int placeOf(int uid) {
+        if (uid < 0) {
+            return 0;
+        }
+        int appId = uid % USER_OFFSET;
+        if (appId >= FIRST_APP_ID + SANDBOX_OFFSET && appId <= LAST_APP_ID + SANDBOX_OFFSET) {
+            appId -= SANDBOX_OFFSET;
+        }
+        Integer place = places.get(appId);
+        return place == null ? 0 : place;
+    }
+}
diff --git a/src/com/android/phone/PersonaReader.java b/src/com/android/phone/PersonaReader.java
new file mode 100644
index 0000000..03bc2d3
--- /dev/null
+++ b/src/com/android/phone/PersonaReader.java
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.phone;
+
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.StructStat;
+
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Reads the persona file of the system server for another process (ADR-208): the Telephony app, the Wi-Fi code and the
+ * Bluetooth app each have a copy of this class and of {@link PersonaFile}, and ask which place an app is in. The rules are those
+ * of the sensor service for {@code sensor_modes}: the file is opened without following a link, it must be a regular file owned
+ * by the system user and not writable by group or others, it must not be larger than {@link #MAX_BYTES}, and it is parsed
+ * strictly. A file that cannot be used means no persona for anyone (the answer is 0, the real data). The file is looked at
+ * again at most once a second, however often the question is asked.
+ */
+public final class PersonaReader {
+    static final String PATH = "/data/system/compartments/persona";
+    static final int SYSTEM_UID = 1000;
+    static final long INTERVAL_MS = 1000;
+    static final int MAX_BYTES = 262144;
+
+    private final String mPath;
+    private final int mOwnerUid;
+    private PersonaFile mFile;
+    private long mLoadedAtMs;
+    private boolean mLoaded;
+
+    public PersonaReader() {
+        this(PATH, SYSTEM_UID);
+    }
+
+    PersonaReader(String path, int ownerUid) {
+        mPath = path;
+        mOwnerUid = ownerUid;
+    }
+
+    /** The place of the app of this uid, or 0 when it has none or the file cannot be used. */
+    public int placeOf(int uid) {
+        return placeOf(uid, System.nanoTime() / 1_000_000L);
+    }
+
+    synchronized int placeOf(int uid, long nowMs) {
+        if (!mLoaded || nowMs - mLoadedAtMs >= INTERVAL_MS) {
+            mFile = load();
+            mLoadedAtMs = nowMs;
+            mLoaded = true;
+        }
+        return mFile == null ? 0 : mFile.placeOf(uid);
+    }
+
+    private PersonaFile load() {
+        FileDescriptor fd = null;
+        try {
+            fd = Os.open(mPath, OsConstants.O_RDONLY | OsConstants.O_NOFOLLOW | OsConstants.O_CLOEXEC, 0);
+            StructStat st = Os.fstat(fd);
+            if (!OsConstants.S_ISREG(st.st_mode) || st.st_uid != mOwnerUid || (st.st_mode & 0022) != 0
+                    || st.st_size < 0 || st.st_size > MAX_BYTES) {
+                return null;
+            }
+            byte[] buf = new byte[(int) st.st_size];
+            int n = 0;
+            while (n < buf.length) {
+                int r = Os.read(fd, buf, n, buf.length - n);
+                if (r <= 0) {
+                    return null;
+                }
+                n += r;
+            }
+            return PersonaFile.parse(new String(buf, StandardCharsets.UTF_8));
+        } catch (ErrnoException | IOException | RuntimeException e) {
+            return null;
+        } finally {
+            if (fd != null) {
+                try {
+                    Os.close(fd);
+                } catch (ErrnoException ignored) {
+                    // nothing to do for a descriptor that did not close
+                }
+            }
+        }
+    }
+}
