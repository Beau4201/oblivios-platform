@@ -720,6 +799,19 @@ public class PermissionMonitor {
         final Handler handler = new Handler(mThread.getLooper());
         final Context userAllContext = mContext.createContextAsUser(UserHandle.ALL, 0 /* flags */);
 
+        // FreeholdOS (ADR-208): the apps that the user lets onto the loopback interface; read now and on every change.
+        mDeps.registerContentObserver(
+                userAllContext,
+                Settings.Global.getUriFor(LOOPBACK_APP_IDS_SETTING),
