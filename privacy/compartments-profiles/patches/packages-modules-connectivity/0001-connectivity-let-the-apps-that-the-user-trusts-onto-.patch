     private final boolean mUseBroadcastReceiveHelper;
     private final boolean mIsLoopbackPermissionEnabled;
 
+    // FreeholdOS (ADR-208): an app that the user sets to "Other apps on this phone: Can reach" (the profile Trusted) may use the
+    // loopback interface although it does not declare USE_LOOPBACK_INTERFACE, which a runtime grant needs. The policy service of
+    // Compartments lists the app ids of those apps in this global setting (LoopbackAppIds), and the bit is added to the uid of
+    // each of them in every user.
+    private static final String LOOPBACK_APP_IDS_SETTING = "freeholdos_loopback_app_ids";
+    private final Object mLoopbackLock = new Object();
+    // Both guarded by mLoopbackLock, which is also held while the map is written, so that two writers cannot leave the older
+    // value in it: the app ids of the setting, and the permission bits as the permission service sent them last for each uid,
+    // which a change of the setting needs without asking the permission service again.
+    private Set<Integer> mLoopbackAppIds = Collections.emptySet();
+    private final SparseIntArray mRawPermissionBits = new SparseIntArray();
+
     private final BroadcastReceiver mIntentReceiver = new BroadcastReceiver() {
         @Override
         public void onReceive(Context context, Intent intent) {
@@ -278,6 +291,66 @@ public class PermissionMonitor {
     // It does not have a corresponding functional bit in the BPF map.
     public static final int PERMISSION_BPF_MAP_BIT_ACCESS_NETWORK_STATE = 1 << 9;
 
+    /**
+     * FreeholdOS (ADR-208): the permission bits of the BPF map for {@code uid}, plus the loopback bit when the user lets the app
+     * onto the loopback interface. The caller holds mLoopbackLock.
+     */
+    private int withLoopbackGrant(int uid, int chunkPermissions) {
+        if (!mIsLoopbackPermissionEnabled || !mLoopbackAppIds.contains(UserHandle.getAppId(uid))) {
+            return chunkPermissions;
+        }
+        return chunkPermissions | PERMISSION_BIT_USE_LOOPBACK_INTERFACE;
+    }
+
+    /** Drops what is remembered of the uids of an app id (appId >= 0) or of a user (userId >= 0). */
+    private void forgetRawPermissionBits(int appId, int userId) {
+        synchronized (mLoopbackLock) {
+            for (int i = mRawPermissionBits.size() - 1; i >= 0; i--) {
+                final int uid = mRawPermissionBits.keyAt(i);
+                if ((appId >= 0 && UserHandle.getAppId(uid) == appId)
+                        || (userId >= 0 && UserHandle.getUserId(uid) == userId)) {
+                    mRawPermissionBits.removeAt(i);
+                }
+            }
+        }
+    }
+
+    /**
+     * FreeholdOS (ADR-208): reads the list of app ids again and writes the bits of the uids whose app id entered or left it. An
+     * unreadable or damaged setting is an empty list: no app gets the bit that way.
+     */
+    private void onLoopbackAppIdsChanged() {
+        Set<Integer> next;
+        try {
+            next = LoopbackAppIds.parse(
+                    Settings.Global.getString(mContext.getContentResolver(), LOOPBACK_APP_IDS_SETTING));
+        } catch (RuntimeException e) {
+            next = Collections.emptySet();
+        }
+        synchronized (mLoopbackLock) {
+            final Set<Integer> before = mLoopbackAppIds;
+            mLoopbackAppIds = next;
+            final SparseIntArray changed = new SparseIntArray();
+            for (int i = 0; i < mRawPermissionBits.size(); i++) {
+                final int uid = mRawPermissionBits.keyAt(i);
+                final int appId = UserHandle.getAppId(uid);
+                if (before.contains(appId) == next.contains(appId)) continue;
+                final int chunkPermissions = withLoopbackGrant(uid,
+                        convertToChunkPermissionBits(mRawPermissionBits.valueAt(i)));
+                changed.put(uid, chunkPermissions);
+                if (hasSdkSandbox(uid)) {
+                    changed.put(Process.toSdkSandboxUid(uid), chunkPermissions);
+                }
+            }
+            if (changed.size() == 0) return;
+            try {
+                mBpfNetMaps.setChunkPermListForUids(changed);
+            } catch (ServiceSpecificException e) {
+                Log.e(TAG, "Send loopback uid permission failed." + e);
+            }
+        }
+    }
+
     private int convertToChunkPermissionBits(int permissionBits) {
         int chunkPermissions = PERMISSION_BIT_NONE;
         if ((permissionBits & PERMISSION_BPF_MAP_BIT_ACCESS_LOCAL_NETWORK) != 0
@@ -490,17 +563,21 @@ public class PermissionMonitor {
                         long startTimeNanos = SystemClock.elapsedRealtimeNanos();
