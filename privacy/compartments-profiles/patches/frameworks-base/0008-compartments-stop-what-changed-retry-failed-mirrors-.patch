-    private static void writeAtomic(AtomicFile file, byte[] bytes) {
+    /**
+     * Writes the file through its temporary name. {@code mode} (not -1) is set on the temporary file before finishWrite renames it
+     * over the old one, so that a reader in another process never meets the file under its name with the mode of system_server's
+     * umask (0600), which the radio and Bluetooth processes cannot open.
+     */
+    private static void writeAtomic(AtomicFile file, byte[] bytes, int mode) {
         FileOutputStream out = null;
         try {
             out = file.startWrite();
             out.write(bytes);
+            if (mode >= 0) {
+                Os.fchmod(out.getFD(), mode);
+            }
             file.finishWrite(out);
-        } catch (IOException e) {
+        } catch (IOException | ErrnoException e) {
