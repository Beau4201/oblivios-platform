@@ -49,6 +49,7 @@ import java.nio.charset.StandardCharsets;
 import java.nio.file.Files;
 import java.security.SecureRandom;
 import java.util.ArrayList;
+import java.util.Collection;
 import java.util.Collections;
 import java.util.List;
 import java.util.Locale;
@@ -409,7 +410,7 @@ public final class CompartmentsPolicyService extends ICompartmentsPolicy.Stub {
 
     /** The sensor file with the activity of the phone now; the caller holds mLock. */
     private void writeSensorFile(PolicyStore s) {
-        String file = MirrorPlan.sensorModeFile(s, this::ownerUidOf, mSalt, mActivity);
+        String file = MirrorPlan.sensorModeFile(s, mResolver, mSalt, mActivity);
         writeAtomic(mSensorFile, file.getBytes(StandardCharsets.US_ASCII), 0644);
