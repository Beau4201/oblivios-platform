@@ -426,13 +427,13 @@ public final class CompartmentsPolicyService extends ICompartmentsPolicy.Stub {
         double lat = mRealLat;
         double lon = mRealLon;
         PersonaFile last = mPersona;
-        String file = MirrorPlan.personaFile(next, this::ownerUidOf, mSalt, places, country, lat, lon, previous, last);
+        String file = MirrorPlan.personaFile(next, mResolver, mSalt, places, country, lat, lon, previous, last);
