From 988c2fdf67f1ca23a51e90854276d786abeda742 Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Fri, 30 Oct 2026 15:05:08 +0100
Subject: [PATCH] compartments: let the Settings app hold
 READ_COMPARTMENT_PROFILE

The permission is signature|privileged, so the privileged Settings app needs it in
the privapp allowlist of the platform as well as in its manifest, or the boot
check refuses the grant.
---
 data/etc/privapp-permissions-platform.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/data/etc/privapp-permissions-platform.xml b/data/etc/privapp-permissions-platform.xml
index 593c84d..635e86a 100644
--- a/data/etc/privapp-permissions-platform.xml
+++ b/data/etc/privapp-permissions-platform.xml
@@ -777,6 +777,7 @@ applications that come with the platform
         <permission name="android.permission.SEND_SAFETY_CENTER_UPDATE" />
         <permission name="android.permission.READ_SYSTEM_GRAMMATICAL_GENDER"/>
         <permission name="android.permission.CONTROL_SIM_AUTO_PIN_MANAGEMENT"/>
+        <permission name="org.freeholdos.permission.READ_COMPARTMENT_PROFILE"/>
     </privapp-permissions>
 
     <privapp-permissions package="com.android.bips">
-- 
2.56.0

