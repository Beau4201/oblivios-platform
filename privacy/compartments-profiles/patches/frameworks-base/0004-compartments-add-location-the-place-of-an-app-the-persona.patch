+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.compartments;
+
+/**
+ * What the other services of the system server ask the Compartments policy service (ADR-208): the persona of an app. It is
+ * registered with {@code LocalServices}, so it is never a Binder interface and no app can call it.
+ */
+public interface CompartmentsInternal {
+    /**
+     * The persona of the app that this uid belongs to (the same app in every user), or null when the app has none or the uid is
+     * not an app uid. An app has a persona when its location is substituted and a place can be chosen for it.
+     */
+    PersonaView personaFor(int uid);
+
+    /** The place of one app and the track that moves its real fixes there. The values never change after the view is made. */
+    final class PersonaView {
+        public final int placeId;
+        public final double lat;
+        public final double lon;
+        public final String timeZone;
+        public final String country;
+        public final int mcc;
+        /** The one track of this app: the same object for every call until the place of the app changes. */
+        public final PersonaTrack track;
+
+        PersonaView(int placeId, double lat, double lon, String timeZone, String country, int mcc, PersonaTrack track) {
+            this.placeId = placeId;
+            this.lat = lat;
+            this.lon = lon;
+            this.timeZone = timeZone;
+            this.country = country;
+            this.mcc = mcc;
+            this.track = track;
+        }
+    }
+}
