+        /**
+         * ObliviOS (ADR-214): notes that a real fix has reached this registration, before the filters of the request decide
+         * whether the app is given it, so that an app that asks for a fix every minute is not given standing fixes between them.
+         */
+        @GuardedBy("mMultiplexerLock")
+        final void noteRealArrival(@Nullable LocationResult fineLocationResult) {
+            CompartmentsInternal.PersonaView persona =
+                    fineLocationResult == null ? null : personaOf(getIdentity());
+            if (persona != null) {
+                Location last = fineLocationResult.getLastLocation();
+                persona.track.noteReal(last.getElapsedRealtimeNanos(), last.hasSpeed() ? last.getSpeed() : Float.NaN);
+            }
+        }
+
+        @GuardedBy("mMultiplexerLock")
+        private void startStanding() {
+            mStandingActiveMs = SystemClock.elapsedRealtime();
+            mStandingLastMs = Long.MIN_VALUE;
+            scheduleStanding();
+        }
+
+        @GuardedBy("mMultiplexerLock")
+        private void stopStanding() {
+            if (mStandingScheduled) {
+                mStandingScheduled = false;
+                mAlarmHelper.cancel(mStandingAlarm);
+            }
+        }
+
+        /**
+         * ObliviOS (ADR-214): wakes this registration when the next standing fix of its app is due. The passive provider and a
+         * passive request get none: they are given what the other requests get, and a standing fix is no report of a provider.
+         */
+        @GuardedBy("mMultiplexerLock")
+        private void scheduleStanding() {
+            long intervalMs = getRequest().getIntervalMillis();
+            if (mPassiveManager == null || intervalMs == LocationRequest.PASSIVE_INTERVAL || !isRegistered() || !isActive()) {
+                return;
+            }
+            CompartmentsInternal.PersonaView persona = personaOf(getIdentity());
+            if (persona == null) {
+                return;
+            }
+            long delayMs = persona.track.standingDelayMs(
+                    SystemClock.elapsedRealtime(), mStandingActiveMs, mStandingLastMs, intervalMs);
+            mStandingScheduled = true;
+            // like the expiry alarm: a wakeup alarm, so that a request for fixes with the screen off is served as a receiver would
+            mAlarmHelper.setDelayedAlarm(max(delayMs, 1), mStandingAlarm, null);
+        }
+
+        private void onStandingAlarm() {
+            // outside the lock: the emergency state is a call into telephony (b/426562854)
+            boolean inEmergency = mEmergencyHelper.isInEmergency(0);
+            synchronized (mMultiplexerLock) {
+                mStandingScheduled = false;
+                if (!isRegistered() || !isActive()) {
+                    return;
+                }
+                CompartmentsInternal.PersonaView persona = personaOf(getIdentity());
+                if (persona == null) {
+                    return;
+                }
+                long nowMs = SystemClock.elapsedRealtime();
+                // in an emergency the real position is what the app needs: no standing fix, and the alarm goes on
+                if (!inEmergency && persona.track.standingDelayMs(nowMs, mStandingActiveMs, mStandingLastMs,
+                        getRequest().getIntervalMillis()) <= 0) {
+                    mStandingLastMs = nowMs;
+                    StandingFix.Fix fix = persona.track.stand(
+                            SystemClock.elapsedRealtimeNanos(), System.currentTimeMillis(), standingSource());
+                    executeOperation(acceptStandingFix(LocationResult.wrap(standingLocation(fix))));
+                }
+                scheduleStanding();
+            }
+        }
