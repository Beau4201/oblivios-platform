+        android:description="@string/permdesc_freeholdosManageCompartments"
+        android:protectionLevel="signature|privileged" />
+
+    <!-- Allows the Settings app to read the Compartments profile of one app, for its App info page.
+         Only that app holds it (ADR-208).
+         @hide -->
+    <permission android:name="org.freeholdos.permission.READ_COMPARTMENT_PROFILE"
+        android:label="@string/permlab_freeholdosReadCompartmentProfile"
+        android:description="@string/permdesc_freeholdosReadCompartmentProfile"
+        android:protectionLevel="signature|privileged" />
+
     <!-- Allows an app to update the verification status of E2EE contact keys owned by other apps.
