@@ -526,13 +551,26 @@ public final class CompartmentsPolicyService extends ICompartmentsPolicy.Stub {
             return;
         }
         PackageManager pm = mContext.getPackageManager();
+        // The background permission last: the permission service may insist on the foreground one being there.
+        owed.sort((a, b) -> {
+            int c = Boolean.compare(BACKGROUND_LOCATION.equals(a.permission), BACKGROUND_LOCATION.equals(b.permission));
+            return c != 0 ? c : a.compareTo(b);
