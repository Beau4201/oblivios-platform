+    /** Whether the package of the entry still asks for its permission; false for a package that is gone. */
+    private boolean requests(RevokedLedger.Entry e) {
+        try {
+            PackageInfo info = mContext.getPackageManager().getPackageInfoAsUser(e.pkg, PackageManager.GET_PERMISSIONS, e.user);
+            return info.requestedPermissions != null && Arrays.asList(info.requestedPermissions).contains(e.permission);
+        } catch (PackageManager.NameNotFoundException | RuntimeException x) {
+            return false;
+        }
+    }
+
+    /** The location permissions with the background one first, the order to take them in. */
+    private static String[] backgroundFirst() {
+        String[] out = LOCATION_PERMISSIONS.clone();
+        Arrays.sort(out, (a, b) -> Boolean.compare(!BACKGROUND_LOCATION.equals(a), !BACKGROUND_LOCATION.equals(b)));
+        return out;
+    }
+
     private void saveLedger() {
