     private void applyPersona(PolicyStore previous, PolicyStore next) {
-        Places places = places();
+        Places places = placesForAutomatic();
         String country = realCountry();
         double lat = mRealLat;
         double lon = mRealLon;
@@ -843,6 +846,31 @@ public final class CompartmentsPolicyService extends ICompartmentsPolicy.Stub {
         return mPlaces;
     }
 
+    /**
+     * The places for the automatic choice of a place: those that have cell towers come first ({@link Places#preferring}), so that
+     * an app is not put in a place where the phone would have no cell identity at all; the plain places when the image has no
+     * usable cell data. Built once, after both files are read, and without holding the lock of either.
+     */
+    private Places placesForAutomatic() {
+        Places base = places();
+        if (base == null) {
+            return null;
+        }
+        Places preferring = mPreferring;
+        if (preferring == null) {
+            synchronized (mPreferringLock) {
+                preferring = mPreferring;
+                if (preferring == null) {
+                    operatorOf(0);  // reads the cell data once
+                    CellSubset cells = mCells;
+                    preferring = cells == null ? base : base.preferring(cells.placeIds());
+                    mPreferring = preferring;
+                }
+            }
+        }
+        return preferring;
+    }
+
     /** The numeric operator of a place from the cell data, "" when the image has none or the place has no cell. */
     private String operatorOf(int placeId) {
         if (!mCellsRead) {
