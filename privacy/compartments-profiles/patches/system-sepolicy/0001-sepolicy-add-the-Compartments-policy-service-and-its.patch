From 7d37c40bc665b2e98bb06d6403227d33a88ffd87 Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Fri, 30 Oct 2026 14:47:08 +0100
Subject: [PATCH] sepolicy: add the Compartments policy service and its data
 file type (ADR-208)

The service compartments in system_server, found only by the exit app and by
system_app (the Settings app); system_server writes /data/system/compartments
under its own type. traceur_app and shell keep their broad service lists
without the new service, as for the Data Map service.
---
 build/soong/service_fuzzer_bindings.go |  1 +
 private/compartments_service.te        | 18 ++++++++++++++++++
 private/file_contexts                  |  1 +
 private/service.te                     |  1 +
 private/service_contexts               |  1 +
 private/shell.te                       |  1 +
 private/traceur_app.te                 |  1 +
 7 files changed, 24 insertions(+)
 create mode 100644 private/compartments_service.te

diff --git a/build/soong/service_fuzzer_bindings.go b/build/soong/service_fuzzer_bindings.go
index cff8582..274983a 100644
--- a/build/soong/service_fuzzer_bindings.go
+++ b/build/soong/service_fuzzer_bindings.go
@@ -275,6 +275,7 @@ var (
 		"com.android.net.IProxyService":                                        EXCEPTION_NO_FUZZER,
 		"companiondevice":                                                      EXCEPTION_NO_FUZZER,
 		"communal":                                                             EXCEPTION_NO_FUZZER,
+		"compartments":                                                         EXCEPTION_NO_FUZZER,
 		"platform_compat":                                                      EXCEPTION_NO_FUZZER,
 		"platform_compat_native":                                               EXCEPTION_NO_FUZZER,
 		"connectivity":                                                         EXCEPTION_NO_FUZZER,
diff --git a/private/compartments_service.te b/private/compartments_service.te
new file mode 100644
index 0000000..8945f98
--- /dev/null
+++ b/private/compartments_service.te
@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: Apache-2.0
+# The policy service of Compartments (ADR-208) in system_server, and the files it keeps in /data/system/compartments:
+# the store, the salt and the file that the sensor service reads (the sensor service runs inside system_server).
+type compartments_data_file, file_type, data_file_type, core_data_file_type;
+
+# system_server creates the directory with its own type instead of the type of /data/system, so no restorecon is needed.
+type_transition system_server system_data_file:dir compartments_data_file "compartments";
+allow system_server compartments_data_file:dir create_dir_perms;
+allow system_server compartments_data_file:file create_file_perms;
+
+# Only the exit app sets the policy and only the Settings app (system_app) reads one label: the permissions of the
+# service say which of them, and SELinux keeps every other app domain from finding the service at all.
+allow exit_app compartments_service:service_manager find;
+allow system_app compartments_service:service_manager find;
+neverallow { appdomain -exit_app -system_app } compartments_service:service_manager find;
+
+# Nothing but system_server writes the files.
+neverallow { domain -system_server } compartments_data_file:file { write append create unlink rename setattr };
