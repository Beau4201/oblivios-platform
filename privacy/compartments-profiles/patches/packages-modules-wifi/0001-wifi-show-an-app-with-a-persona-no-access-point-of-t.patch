@@ -5552,6 +5561,10 @@ public class WifiServiceImpl extends IWifiManager.Stub {
         try {
             mWifiPermissionsUtil.enforceCanAccessScanResults(callingPackage, callingFeatureId,
                     uid, null);
+            // FreeholdOS (ADR-208): an app with a persona sees no access point of the real place
