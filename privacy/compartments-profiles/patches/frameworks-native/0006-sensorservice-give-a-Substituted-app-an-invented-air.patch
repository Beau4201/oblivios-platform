From 3279e3820c7998010ea7beefb187e0b394bc8232 Mon Sep 17 00:00:00 2001
From: FreeholdOS Build <build@freeholdos.local>
Date: Sun, 1 Nov 2026 20:50:49 +0100
Subject: [PATCH] sensorservice: give a Substituted app an invented air
 pressure, reduce the phase in double, read the table without a lock

The air pressure of a Substituted app was the real reading (HRV-002 on lynx 2026110101: within 0.02
hPa of the truth in both probe apps), and gave away the height and the weather of the place the
persona has left. SUBSTITUTE now replaces it with the standard atmosphere at a height fixed per
seed (0 to 600 m), a weather swing of 6 hPa over 6 h and 0.03 hPa of noise, with no link to the
real reading, and refuses a direct channel for it; BLOCKED still delivers the real pressure, as it
withholds the motion and not the environment.

Also in this patch, from the review fixes of 2026-10-31 that the package held but that never reached
the build tree: the phase of the invented streams is reduced in double (a float of seconds has 24
bits, so after a day of uptime a 3.6 Hz sine stepped in 8 ms jumps, SN4), and the table is read
through an atomic fast path, so concurrent sendEvents calls do not meet on a mutex (SN5).
---
 services/sensorservice/SensorModeSource.h | 21 ++++++++-----
 services/sensorservice/SensorModes.h      | 11 +++++--
 services/sensorservice/SubstituteStream.h | 38 ++++++++++++++++++-----
 3 files changed, 53 insertions(+), 17 deletions(-)

diff --git a/services/sensorservice/SensorModeSource.h b/services/sensorservice/SensorModeSource.h
index cb8f011..2354426 100644
--- a/services/sensorservice/SensorModeSource.h
+++ b/services/sensorservice/SensorModeSource.h
@@ -6,7 +6,8 @@
  * owned by anyone but the required owner or writable by group or others is not read. Before a first table was read every app
  * is on the folded events of ADR-167; after it, a file that cannot be used leaves the table that was read last (falling back
  * to the folded events would hand an app that is substituted or blocked its real motion data until the file is usable again).
- * The file is looked at once per second at most, so the event path costs a lock and a clock read.
+ * The file is looked at once per second at most; between two looks the event path costs a clock read and an atomic load, so
+ * concurrent sendEvents calls do not meet on a mutex (SN5).
  */
 #ifndef ANDROID_SENSOR_MODE_SOURCE_H
 #define ANDROID_SENSOR_MODE_SOURCE_H
@@ -17,10 +18,12 @@
 #include <sys/stat.h>
 #include <unistd.h>
 
+#include <atomic>
 #include <chrono>
 #include <functional>
 #include <memory>
 #include <mutex>
+#include <limits>
 #include <string>
 
 namespace android {
@@ -37,13 +40,17 @@ public:
 
     // The current table. Never null; the status quo (every app folded) until a file has been read.
     std::shared_ptr<const SensorModeTable> table() {
-        std::lock_guard<std::mutex> lock(mLock);
         const auto now = mClock();
-        if (now >= mNextCheck) {
-            mNextCheck = now + std::chrono::seconds(1);
+        if (now.time_since_epoch().count() < mNextCheckTicks.load(std::memory_order_acquire)) {
+            return std::atomic_load(&mTable);
+        }
+        std::lock_guard<std::mutex> lock(mLock);
+        // another thread may have looked while this one waited for the lock
+        if (now.time_since_epoch().count() >= mNextCheckTicks.load(std::memory_order_relaxed)) {
             reloadLocked();
+            mNextCheckTicks.store((now + std::chrono::seconds(1)).time_since_epoch().count(), std::memory_order_release);
         }
-        return mTable;
+        return std::atomic_load(&mTable);
     }
 
 private:
@@ -72,14 +79,14 @@ private:
         mSec = st.st_mtim.tv_sec;
         mNsec = st.st_mtim.tv_nsec;
         mSize = st.st_size;
-        mTable = std::move(next);
+        std::atomic_store(&mTable, std::shared_ptr<const SensorModeTable>(std::move(next)));
     }
 
     const std::string mPath;
     const uid_t mOwner;
     const Clock mClock;
     std::mutex mLock;
-    std::chrono::steady_clock::time_point mNextCheck{};
+    std::atomic<std::chrono::steady_clock::rep> mNextCheckTicks{std::numeric_limits<std::chrono::steady_clock::rep>::min()};
     bool mHaveSignature = false;
     time_t mSec = 0;
     long mNsec = 0;
diff --git a/services/sensorservice/SensorModes.h b/services/sensorservice/SensorModes.h
index 5732b1c..ae2672b 100644
--- a/services/sensorservice/SensorModes.h
+++ b/services/sensorservice/SensorModes.h
@@ -51,6 +51,12 @@ inline bool isMotionType(int32_t type) {
            type == SENSOR_TYPE_GYROSCOPE_UNCALIBRATED || type == SENSOR_TYPE_MAGNETIC_FIELD_UNCALIBRATED;
 }
 
+// The one environment sensor that SUBSTITUTE replaces: the air pressure gives away the height and the weather of the real place,
+// which the persona has left. BLOCKED delivers it as it is (BLOCKED withholds the motion, not the environment).
+inline bool isPressureType(int32_t type) {
+    return type == SENSOR_TYPE_PRESSURE;
+}
+
 // The types that the HAL derives from the same real motion (gravity, linear acceleration, the rotation vectors, the old
 // orientation, the steps and the detectors): the stream that SUBSTITUTE invents has no counterpart for them, and the real values
 // would contradict it, so SUBSTITUTE and BLOCKED both deliver none of them.
@@ -63,11 +69,12 @@ inline bool isDerivedMotionType(int32_t type) {
 }
 
 // A direct channel hands the HAL's own events to the app, so it must not exist where the app is not meant to see them:
-// for a folded app the uncalibrated types (ADR-167), for a substituted or blocked app every motion type.
+// for a folded app the uncalibrated types (ADR-167), for a blocked app every motion type, for a substituted app those and the
+// air pressure.
 inline bool directChannelRefused(SensorMode m, int32_t type) {
     switch (m) {
         case SensorMode::FOLDED: return eventCarriesBias(type);
-        case SensorMode::SUBSTITUTE:
+        case SensorMode::SUBSTITUTE: return isMotionType(type) || isDerivedMotionType(type) || isPressureType(type);
         case SensorMode::BLOCKED: return isMotionType(type) || isDerivedMotionType(type);
         default: return false;
     }
diff --git a/services/sensorservice/SubstituteStream.h b/services/sensorservice/SubstituteStream.h
index ee19e65..d4ccd46 100644
--- a/services/sensorservice/SubstituteStream.h
+++ b/services/sensorservice/SubstituteStream.h
@@ -32,25 +32,45 @@ inline float noise(uint64_t seed, int64_t t, uint32_t channel) {
     return static_cast<float>(static_cast<double>(h >> 11) / 4503599627370496.0 - 1.0);
 }
 
+// The phase in radians of a sine of `hz` Hertz at event time `ts` (nanoseconds). The cycles are reduced in double before the
+// float conversion: a float of seconds has 24 bits, so after a day of uptime a 3.6 Hz sine would step in 8 ms jumps (SN4).
+inline float phase(int64_t ts, double hz) {
+    const double cycles = std::fmod(static_cast<double>(ts) * 1e-9 * hz, 1.0);
+    return static_cast<float>(2.0 * static_cast<double>(kPi) * cycles);
+}
+
 // A float in [lo, hi) fixed for a seed.
 inline float perSeed(uint64_t seed, uint32_t slot, float lo, float hi) {
     const float u = noise(seed, 0, 0xF0 + slot) * 0.5f + 0.5f;
     return lo + (hi - lo) * u;
 }
 
+// The air pressure in hPa of an invented place: the standard atmosphere at a height fixed for the seed (0 to 600 m), a slow swing
+// of a few hPa for the weather, and the noise of a real sensor. It is no function of the real reading, so it says nothing of the
+// real place. ponytail: no link to the height of the persona's city (the sensor file holds no place), add when places.tsv gets one.
+inline float pressure(uint64_t seed, int64_t ts) {
+    const float height = perSeed(seed, 6, 0.0f, 600.0f);
+    const float standard = 1013.25f * std::pow(1.0f - height / 44330.0f, 5.255f);
+    const float weather = 6.0f * std::sin(phase(ts, 1.0 / 21600.0) + perSeed(seed, 7, 0.0f, 6.28f));
+    return standard + weather + 0.03f * noise(seed, ts, 10);
+}
+
 }  // namespace substitute_detail
 
 // The type of events that substituteEvent writes.
 inline bool substitutes(int32_t type) {
-    return isMotionType(type);
+    return isMotionType(type) || isPressureType(type);
 }
 
-// Writes the first three values of an event of a motion type (and zero as the bias of an uncalibrated one); the rest of the
-// event is left as it is. Returns false, touching nothing, for any other type.
+// Writes the first three values of an event of a motion type (and zero as the bias of an uncalibrated one), or the one value of
+// an air pressure event; the rest of the event is left as it is. Returns false, touching nothing, for any other type.
 inline bool substituteEvent(sensors_event_t* e, uint64_t seed, Activity a) {
     using namespace substitute_detail;
     if (!substitutes(e->type)) return false;
-    const float t = static_cast<float>(static_cast<double>(e->timestamp) * 1e-9);
+    if (isPressureType(e->type)) {
+        e->data[0] = pressure(seed, e->timestamp);
+        return true;
+    }
     const float walk = (a == Activity::WALKING) ? 1.0f : 0.0f;
     const float drive = (a == Activity::DRIVING) ? 1.0f : 0.0f;
     float v[3];
@@ -60,8 +80,8 @@ inline bool substituteEvent(sensors_event_t* e, uint64_t seed, Activity a) {
             const float tx = perSeed(seed, 0, -0.08f, 0.08f);   // tilt of a held phone, radians
             const float ty = perSeed(seed, 1, -0.08f, 0.08f);
             const float sigma = 0.035f + 0.4f * drive + 0.6f * walk;
-            const float step = 2.5f * std::sin(2.0f * kPi * 1.8f * t) + 1.0f * std::sin(2.0f * kPi * 3.6f * t);
-            const float sway = 0.8f * std::sin(2.0f * kPi * 0.25f * t);
+            const float step = 2.5f * std::sin(phase(e->timestamp, 1.8)) + 1.0f * std::sin(phase(e->timestamp, 3.6));
+            const float sway = 0.8f * std::sin(phase(e->timestamp, 0.25));
             v[0] = kGravity * std::sin(ty) + sigma * noise(seed, e->timestamp, 1) + drive * sway;
             v[1] = -kGravity * std::sin(tx) * std::cos(ty) + sigma * noise(seed, e->timestamp, 2);
             v[2] = kGravity * std::cos(tx) * std::cos(ty) + sigma * noise(seed, e->timestamp, 3) + walk * step;
@@ -70,7 +90,7 @@ inline bool substituteEvent(sensors_event_t* e, uint64_t seed, Activity a) {
         case SENSOR_TYPE_GYROSCOPE:
         case SENSOR_TYPE_GYROSCOPE_UNCALIBRATED: {
             const float sigma = 0.002f + 0.03f * drive + 0.05f * walk;
-            const float swing = 0.4f * std::sin(2.0f * kPi * 1.8f * t + perSeed(seed, 2, 0.0f, 6.28f));
+            const float swing = 0.4f * std::sin(phase(e->timestamp, 1.8) + perSeed(seed, 2, 0.0f, 6.28f));
             v[0] = sigma * noise(seed, e->timestamp, 4) + walk * swing;
             v[1] = sigma * noise(seed, e->timestamp, 5) + walk * 0.5f * swing;
             v[2] = sigma * noise(seed, e->timestamp, 6);
@@ -119,8 +139,10 @@ inline bool modeTouches(SensorMode m, int32_t type) {
     switch (m) {
         case SensorMode::RAW: return false;
         case SensorMode::FOLDED: return eventCarriesBias(type);
-        default: return isMotionType(type) || isDerivedMotionType(type);
+        case SensorMode::SUBSTITUTE: return isMotionType(type) || isDerivedMotionType(type) || isPressureType(type);
+        case SensorMode::BLOCKED: return isMotionType(type) || isDerivedMotionType(type);
     }
+    return false;
 }
 
 // Copies n events from in to out, applies the mode to each copy and leaves out the events that are not to be delivered.
-- 
