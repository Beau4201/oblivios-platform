From 7a4c68e35ce594dfd0355b4a2bf73e2aac04574e Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 16 Aug 2026 02:52:44 +0200
Subject: [PATCH] sovereignos: add the private SELinux type for duress-dummy
 metadata storage

sovereignos: add SELinux type for duress-dummy metadata storage

sovereignos: add test-data coverage for duress-dummy metadata context

plat_file_contexts_data_test (checkfc) requires every file_contexts
type mapping to be exercised by an entry in file_contexts_test_data,
enforced only by a full droid build (not exercised by the emulator
build used to verify this branch previously). Add the missing entry
for duress_dummy_metadata_file introduced in a99b535ec4.

sovereignos: make duress-dummy metadata type private, not public

se_freeze_test rejects any new type added to system/sepolicy/public
after vendor API freeze (202604), since public types are part of the
Treble system/vendor compatibility surface. duress_dummy_metadata_file
has no vendor or device-tree consumer (only system_server, itself a
private/ domain, accesses it) - it never needed to be public. Move
the declaration to private/file.te where it belongs.
---
 contexts/file_contexts_test_data | 2 ++
 private/file.te                  | 3 +++
 private/file_contexts            | 1 +
 private/system_server.te         | 2 ++
 4 files changed, 8 insertions(+)

diff --git a/contexts/file_contexts_test_data b/contexts/file_contexts_test_data
index 20a06c7..a00bd98 100644
--- a/contexts/file_contexts_test_data
+++ b/contexts/file_contexts_test_data
@@ -1334,6 +1334,8 @@
 /metadata/gsi/ota/test                                            ota_metadata_file
 /metadata/password_slots                                          password_slot_metadata_file
 /metadata/password_slots/test                                     password_slot_metadata_file
+/metadata/duress-dummy                                            duress_dummy_metadata_file
+/metadata/duress-dummy/test                                       duress_dummy_metadata_file
 /metadata/ota                                                     ota_metadata_file
 /metadata/ota/test                                                ota_metadata_file
 /metadata/bootstat                                                metadata_bootstat_file
diff --git a/private/file.te b/private/file.te
index c7310e1..89445b6 100644
--- a/private/file.te
+++ b/private/file.te
@@ -274,6 +274,9 @@ type prefetch_metadata_file, file_type;
 # /metadata/libprocessgroup files
 type libprocessgroup_metadata_file, file_type;
 
+# /metadata/duress-dummy files
+type duress_dummy_metadata_file, file_type;
+
 type exp_partition_data_file, file_type, data_file_type, core_data_file_type;
 
 # statsd service stores list of atoms in use
diff --git a/private/file_contexts b/private/file_contexts
index d9987aa..1e9cfe9 100644
--- a/private/file_contexts
+++ b/private/file_contexts
@@ -941,6 +941,7 @@
 /metadata/staged-install(/.*)?    u:object_r:staged_install_file:s0
 /metadata/watchdog(/.*)?    u:object_r:watchdog_metadata_file:s0
 /metadata/repair-mode(/.*)?    u:object_r:repair_mode_metadata_file:s0
+/metadata/duress-dummy(/.*)?    u:object_r:duress_dummy_metadata_file:s0
 /metadata/aconfig(/.*)?    u:object_r:aconfig_storage_metadata_file:s0
 /metadata/aconfig/flags(/.*)?    u:object_r:aconfig_storage_flags_metadata_file:s0
 /metadata/tradeinmode(/.*)?    u:object_r:tradeinmode_metadata_file:s0
diff --git a/private/system_server.te b/private/system_server.te
index 1e2dd95..39eb3e7 100644
--- a/private/system_server.te
+++ b/private/system_server.te
@@ -1676,6 +1676,8 @@ allow system_server staged_install_file:file create_file_perms;
 
 allow system_server watchdog_metadata_file:dir rw_dir_perms;
 allow system_server watchdog_metadata_file:file create_file_perms;
+allow system_server duress_dummy_metadata_file:dir rw_dir_perms;
+allow system_server duress_dummy_metadata_file:file create_file_perms;
 
 # allow system_server write to aconfigd socket
 unix_socket_connect(system_server, aconfigd, aconfigd);
-- 
