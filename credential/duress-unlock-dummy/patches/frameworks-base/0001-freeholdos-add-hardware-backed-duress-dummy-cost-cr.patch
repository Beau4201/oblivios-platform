 .../locksettings/LockSettingsService.java     |   1 +
 .../locksettings/LockSettingsStorage.java     |  22 ++++
 .../SyntheticPasswordManager.java             | 120 ++++++++++++++++++
 4 files changed, 154 insertions(+)

diff --git a/core/java/com/android/internal/widget/LockPatternUtils.java b/core/java/com/android/internal/widget/LockPatternUtils.java
index 15f5f0b..fccfb4c 100644
--- a/core/java/com/android/internal/widget/LockPatternUtils.java
+++ b/core/java/com/android/internal/widget/LockPatternUtils.java
@@ -199,6 +199,14 @@ public class LockPatternUtils {
      */
     public static final int USER_REPAIR_MODE = UserHandle.USER_NULL + 2;
 
+    /**
+     * Special user id for FreeholdOS's duress-unlock dummy-cost credential check. Never a real
+     * device user; provisioned once at boot with a random credential nobody knows, and verified
+     * on every failed real-credential attempt so that a real per-profile check and this dummy
+     * check cost the same, whether or not an FreeholdOS decoy profile is registered.
+     */
+    public static final int USER_DURESS_DUMMY = UserHandle.USER_NULL + 3;
+
     public final static String PASSWORD_TYPE_KEY = "lockscreen.password_type";
     public final static String LOCK_PASSWORD_SALT_KEY = "lockscreen.password_salt";
     public final static String DISABLE_LOCKSCREEN_KEY = "lockscreen.disabled";
@@ -2144,6 +2152,9 @@ public class LockPatternUtils {
             case USER_REPAIR_MODE:
                 if (checkDeviceSupported) return isRepairModeSupported(context);
                 return true;
+
+            case USER_DURESS_DUMMY:
+                return true;
         }
         return false;
     }
