diff --git a/services/core/java/com/android/server/locksettings/LockSettingsStorage.java b/services/core/java/com/android/server/locksettings/LockSettingsStorage.java
index 52dd01f..dd62616 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsStorage.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsStorage.java
@@ -96,6 +96,9 @@ class LockSettingsStorage {
     private static final String REPAIR_MODE_DIRECTORY = "repair-mode/";
     private static final String REPAIR_MODE_PERSISTENT_FILE = "pst";
 
+    private static final String DURESS_DUMMY_DIRECTORY = "duress-dummy/";
+    private static final String DURESS_DUMMY_PERSISTENT_FILE = "pst";
+
     private static final Object DEFAULT = new Object();
 
     private static final String[] SETTINGS_TO_BACKUP = new String[] {
@@ -417,6 +420,25 @@ class LockSettingsStorage {
                 PersistentData.toBytes(persistentType, userId, /* qualityForUi= */0, payload));
     }
 
+    @VisibleForTesting
+    File getDuressDummyPersistentDataFile() {
+        final File directory = new File(Environment.getMetadataDirectory(), DURESS_DUMMY_DIRECTORY);
+        return new File(directory, DURESS_DUMMY_PERSISTENT_FILE);
+    }
+
+    public PersistentData readDuressDummyPersistentData() {
+        final byte[] data = readFile(getDuressDummyPersistentDataFile());
+        if (data == null) {
+            return PersistentData.NONE;
+        }
+        return PersistentData.fromBytes(data);
+    }
+
+    public void writeDuressDummyPersistentData(int persistentType, int userId, byte[] payload) {
+        writeFile(getDuressDummyPersistentDataFile(),
+                PersistentData.toBytes(persistentType, userId, /* qualityForUi= */0, payload));
+    }
+
     public void deleteRepairModePersistentData() {
         deleteFile(getRepairModePersistentDataFile());
     }
diff --git a/services/core/java/com/android/server/locksettings/SyntheticPasswordManager.java b/services/core/java/com/android/server/locksettings/SyntheticPasswordManager.java
index 34f6e9f..5cfebf3 100644
--- a/services/core/java/com/android/server/locksettings/SyntheticPasswordManager.java
+++ b/services/core/java/com/android/server/locksettings/SyntheticPasswordManager.java
@@ -22,6 +22,7 @@ import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_NONE;
 import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PASSWORD_OR_PIN;
 import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PIN;
 import static com.android.internal.widget.LockPatternUtils.PIN_LENGTH_UNAVAILABLE;
+import static com.android.internal.widget.LockPatternUtils.USER_DURESS_DUMMY;
 import static com.android.internal.widget.LockPatternUtils.USER_FRP;
 import static com.android.internal.widget.LockPatternUtils.USER_REPAIR_MODE;
 import static com.android.internal.widget.LockPatternUtils.pinOrPasswordQualityToCredentialType;
@@ -920,9 +921,128 @@ class SyntheticPasswordManager {
         if (userId == USER_REPAIR_MODE) {
             return mStorage.readRepairModePersistentData();
         }
+        if (userId == USER_DURESS_DUMMY) {
+            return mStorage.readDuressDummyPersistentData();
+        }
         throw new IllegalArgumentException("Unknown special user id " + userId);
     }
 
+    /**
+     * Fixed placeholder Gatekeeper "user id" input used only for FreeholdOS's duress-dummy
+     * enrollment when Weaver is unavailable. Real Android user ids are only ever allocated
+     * starting at UserHandle.MIN_SECONDARY_USER_ID (10) by UserManagerService's real allocator
+     * (confirmed via source: services/core/java/com/android/server/pm/UserManagerService.java's
+     * scanNextAvailableIdLU() scans from MIN_USER_ID upward and never recycles ids), and id 0 is
+     * always the real primary/system user. Any fixed value in [1, 9] is therefore provably never
+     * a real Android user id on this device, so fakeUserId(DURESS_DUMMY_FAKE_USER_ID, Primary)
+     * can never collide with any real user's own Gatekeeper enrollment under the same domain.
+     */
+    private static final int DURESS_DUMMY_FAKE_USER_ID = 9;
+
+    /**
+     * Provisions, if not already provisioned, a real hardware-backed dummy credential check for
+     * FreeholdOS's duress-unlock feature (see
+     * docs/superpowers/specs/2026-08-15-duress-dummy-candidate-b-design.md in the
+     * freeholdos-foundation repository). Idempotent -- a no-op if already provisioned. Deliberately
+     * does not create a synthetic-password blob (unnecessary: verifySpecialUserCredential only
+     * ever reads PersistentData, never an SP blob) and deliberately never calls
+     * synchronizeGatekeeperFrpPassword/synchronizeWeaverFrpPassword, so this can never write to
+     * the real FRP persistent-data-block.
+     */
+    void provisionDuressDummyIfNeeded(IGateKeeperService gatekeeper) {
+        if (getSpecialUserPersistentData(USER_DURESS_DUMMY).type != PersistentData.TYPE_NONE) {
+            return;
+        }
+        final LockscreenCredential dummyCredential = generateRandomDummyCredential();
+        try {
+            final PasswordData pwd = PasswordData.create(dummyCredential.getType(),
+                    PIN_LENGTH_UNAVAILABLE);
+            final byte[] stretchedLskf = stretchLskf(dummyCredential, pwd);
+            final IWeaver weaver = getWeaverService();
+            if (weaver != null) {
+                final int weaverSlot = getNextAvailableWeaverSlot();
+                Slog.i(TAG, "Enrolling FreeholdOS duress dummy into Weaver slot " + weaverSlot);
+                final byte[] weaverSecret = weaverEnroll(weaver, weaverSlot,
+                        stretchedLskfToWeaverKey(stretchedLskf), null);
+                if (weaverSecret == null) {
+                    Slog.e(TAG, "Failed to enroll FreeholdOS duress dummy under Weaver");
+                    return;
+                }
+                mStorage.writeDuressDummyPersistentData(
+                        PersistentData.TYPE_SP_WEAVER, weaverSlot, pwd.toBytes());
+                // writeDuressDummyPersistentData() cannot report a failed write back to its
+                // caller: LockSettingsStorage#writeFile only logs on IOException, and it
+                // unconditionally updates its in-memory read cache regardless of whether the
+                // underlying AtomicFile write actually reached disk -- so re-reading via
+                // readDuressDummyPersistentData() in this same process would not reveal a
+                // failure. (This is the exact real failure mode this feature previously hit via
+                // an SELinux permission bug: a silent write failure left PersistentData at
+                // TYPE_NONE, causing re-enrollment under the same fixed Weaver slot on every
+                // later boot with no clearing of the earlier attempt.) Check the real on-disk
+                // file directly instead, bypassing that cache, so a failed write leaves the
+                // Weaver slot unmarked rather than falsely claimed as in-use with no persisted
+                // record pointing at it. This is a heuristic, not a perfect guarantee (it would
+                // not catch a write that silently corrupted an already-existing file in place),
+                // but it correctly detects the real failure mode above, where the file did not
+                // exist before this call.
+                //
+                // There is no established mechanism elsewhere in this file to erase/reclaim a
+                // *specific* previously leaked Weaver slot after the fact: destroyWeaverSlot()
+                // only works for protector-based slots recorded via saveWeaverSlot() /
+                // WEAVER_SLOT_NAME, which this fixed, non-protector duress-dummy enrollment
+                // deliberately does not use, so a prior failed attempt's slot number is not
+                // recoverable here. On a genuine persistence failure the underlying hardware
+                // Weaver slot may remain enrolled and unmarked in mPasswordSlotManager; this is
+                // a known, accepted residual, not a full fix.
+                if (mStorage.getDuressDummyPersistentDataFile().exists()) {
+                    mPasswordSlotManager.markSlotInUse(weaverSlot);
+                } else {
+                    Slog.e(TAG, "Failed to persist FreeholdOS duress dummy Weaver enrollment; "
+                            + "not marking Weaver slot " + weaverSlot + " in use");
+                }
+            } else {
+                // In case a previous enrollment attempt left persistent state around (in RPMB)
+                // -- e.g. because writeDuressDummyPersistentData() below silently failed after a
+                // successful enroll() on an earlier boot, causing this method to retry under the
+                // same fixed id here -- clear it first, mirroring createLskfBasedProtector()'s
+                // own real Gatekeeper enrollment pattern, to prevent stale state from
+                // accumulating.
+                try {
+                    gatekeeper.clearSecureUserId(fakeUserId(DURESS_DUMMY_FAKE_USER_ID, Primary));
+                } catch (RemoteException ignore) {
+                    Slog.w(TAG, "Failed to clear SID from gatekeeper");
+                }
+                Slog.i(TAG, "Enrolling FreeholdOS duress dummy into Gatekeeper");
+                GateKeeperResponse response;
+                try {
+                    response = gatekeeper.enroll(fakeUserId(DURESS_DUMMY_FAKE_USER_ID, Primary),
+                            null, null, stretchedLskfToGkPassword(stretchedLskf));
+                } catch (RemoteException e) {
+                    Slog.e(TAG, "Failed to enroll FreeholdOS duress dummy under Gatekeeper", e);
+                    return;
+                }
+                if (response.getResponseCode() != GateKeeperResponse.RESPONSE_OK) {
+                    Slog.e(TAG, "Gatekeeper rejected FreeholdOS duress dummy enrollment");
+                    return;
+                }
+                pwd.passwordHandle = response.getPayload();
+                mStorage.writeDuressDummyPersistentData(PersistentData.TYPE_SP_GATEKEEPER,
+                        DURESS_DUMMY_FAKE_USER_ID, pwd.toBytes());
+            }
+        } finally {
+            dummyCredential.zeroize();
+        }
+    }
+
+    private static LockscreenCredential generateRandomDummyCredential() {
+        final java.security.SecureRandom random = new java.security.SecureRandom();
+        final char[] dummyChars = new char[32];
+        for (int i = 0; i < dummyChars.length; i++) {
+            dummyChars[i] = (char) ('0' + random.nextInt(10));
+        }
+        return LockscreenCredential.createPassword(new String(dummyChars));
+    }
+
     /**
      * Creates a new synthetic password (SP) for the given user.
      * <p>
