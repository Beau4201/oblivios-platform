From b51bc3e0d4d9273164194eed5c97c1119ecc1710 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Mon, 24 Aug 2026 11:39:54 +0200
Subject: [PATCH 01/89] sovereignos: add USER_TYPE_FULL_SOVEREIGNOS_DECOY user type

Implements the decoy-profile user type from the owner-approved
2026-08-21 decoy user switch design (amends ADR-039). FLAG_FULL with
delayed locking enabled, matching the design's requirement that a
silent switch into the decoy avoid a full FBE-key-rederivation cost.
---
 core/java/android/os/UserManager.java           | 11 +++++++++++
 .../com/android/server/pm/UserTypeFactory.java  | 17 +++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/core/java/android/os/UserManager.java b/core/java/android/os/UserManager.java
index 80126b7d1c77..60e51af2b009 100644
--- a/core/java/android/os/UserManager.java
+++ b/core/java/android/os/UserManager.java
@@ -153,6 +153,17 @@ public class UserManager {
      */
     @SystemApi
     public static final String USER_TYPE_FULL_SECONDARY = "android.os.usertype.full.SECONDARY";
+    /**
+     * User type for SovereignOS's duress-unlock decoy profile. A real, full user (not a
+     * Private-Space-style profile: {@link UserController#switchUser} requires
+     * {@code FLAG_FULL}, confirmed via source — see
+     * docs/superpowers/specs/2026-08-21-duress-decoy-user-switch-design.md in the
+     * sovereignos-foundation repository), with delayed locking enabled so a silent switch into it
+     * does not pay a full FBE-key-rederivation cost.
+     * @hide
+     */
+    @SystemApi
+    public static final String USER_TYPE_FULL_SOVEREIGNOS_DECOY = "org.sovereignos.usertype.full.DECOY";
 
     /**
      * User type representing a guest user that may be transient.
diff --git a/services/core/java/com/android/server/pm/UserTypeFactory.java b/services/core/java/com/android/server/pm/UserTypeFactory.java
index 1941d2a2a54f..99ac5286ab5a 100644
--- a/services/core/java/com/android/server/pm/UserTypeFactory.java
+++ b/services/core/java/com/android/server/pm/UserTypeFactory.java
@@ -27,6 +27,7 @@ import static android.content.pm.UserInfo.FLAG_PRIMARY;
 import static android.content.pm.UserInfo.FLAG_PROFILE;
 import static android.content.pm.UserInfo.FLAG_RESTRICTED;
 import static android.content.pm.UserInfo.FLAG_SYSTEM;
+import static android.os.UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY;
 import static android.os.UserManager.USER_TYPE_FULL_DEMO;
 import static android.os.UserManager.USER_TYPE_FULL_GUEST;
 import static android.os.UserManager.USER_TYPE_FULL_RESTRICTED;
@@ -115,6 +116,7 @@ public final class UserTypeFactory {
         builders.put(USER_TYPE_PROFILE_MANAGED, getDefaultTypeProfileManaged());
         builders.put(USER_TYPE_FULL_SYSTEM, getDefaultTypeFullSystem());
         builders.put(USER_TYPE_FULL_SECONDARY, getDefaultTypeFullSecondary());
+        builders.put(USER_TYPE_FULL_SOVEREIGNOS_DECOY, getDefaultTypeFullSovereignosDecoy());
         builders.put(USER_TYPE_FULL_GUEST, getDefaultTypeFullGuest());
         builders.put(USER_TYPE_FULL_DEMO, getDefaultTypeFullDemo());
         builders.put(USER_TYPE_FULL_RESTRICTED, getDefaultTypeFullRestricted());
@@ -396,6 +398,21 @@ public final class UserTypeFactory {
                 .setDefaultRestrictions(getDefaultSecondaryUserRestrictions());
     }
 
+    /**
+     * Returns the Builder for SovereignOS's {@link UserManager#USER_TYPE_FULL_SOVEREIGNOS_DECOY} user
+     * type. See docs/superpowers/specs/2026-08-21-duress-decoy-user-switch-design.md in the
+     * sovereignos-foundation repository.
+     */
+    private static UserTypeDetails.Builder getDefaultTypeFullSovereignosDecoy() {
+        return new UserTypeDetails.Builder()
+                .setName(USER_TYPE_FULL_SOVEREIGNOS_DECOY)
+                .setBaseType(FLAG_FULL)
+                .setMaxAllowed(1)
+                .setDefaultRestrictions(getDefaultSecondaryUserRestrictions())
+                .setDefaultUserProperties(new UserProperties.Builder()
+                        .setAllowStoppingUserWithDelayedLocking(true));
+    }
+
     /**
      * Returns the Builder for the default {@link UserManager#USER_TYPE_FULL_GUEST} configuration.
      */
-- 
2.39.5

