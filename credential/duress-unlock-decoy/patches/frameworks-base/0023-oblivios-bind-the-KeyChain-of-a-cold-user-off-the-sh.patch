From f56a6f4ce4f3344470068b3a14b9d740add8c5fb Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 17:34:45 +0100
Subject: [PATCH] oblivios: bind the KeyChain of a cold user off the shared
 SystemUI background thread

---
 .../statusbar/policy/SecurityControllerImpl.java      | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/policy/SecurityControllerImpl.java b/packages/SystemUI/src/com/android/systemui/statusbar/policy/SecurityControllerImpl.java
index 928951dc..0ae9aca3 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/policy/SecurityControllerImpl.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/policy/SecurityControllerImpl.java
@@ -72,6 +72,7 @@ import java.io.IOException;
 import java.io.PrintWriter;
 import java.util.ArrayList;
 import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
 
 import javax.inject.Inject;
 import javax.inject.Provider;
@@ -105,6 +106,14 @@ public class SecurityControllerImpl implements SecurityController {
     private final UserManager mUserManager;
     private final Executor mMainExecutor;
     private final Executor mBgExecutor;
+    // ObliviOS: the KeyChain bind below blocks until the user's KeyChain process is up, 1.6 s for a cold user (the
+    // Duress decoy, lynx 2026-11-13), and the shared SysUiBg thread also runs UserTracker's user switch observer, so
+    // the switch waited behind it. Own daemon thread, created on first use.
+    private final Executor mCaCertExecutor = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "SecurityController-CACerts");
+        t.setDaemon(true);
+        return t;
+    });
 
     @GuardedBy("mCallbacks")
     private final ArrayList<SecurityControllerCallback> mCallbacks = new ArrayList<>();
@@ -483,7 +492,7 @@ public class SecurityControllerImpl implements SecurityController {
     }
 
     private void refreshCACerts(int userId) {
-        mBgExecutor.execute(() -> {
+        mCaCertExecutor.execute(() -> {
             Pair<Integer, Boolean> idWithCert = null;
             try (KeyChain.KeyChainConnection conn = KeyChain.bindAsUser(mContext,
                     UserHandle.of(userId))) {
-- 
