From cddafe435ebb1f78911bd366f965a988bdaecc94 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 30 Aug 2026 17:09:51 +0200
Subject: [PATCH 25/89] sovereignos: treat decoy user as main-user-equivalent for
 Wallet QS tile

Wallet role availability was gated to UserHandle.USER_SYSTEM only.
RoleManager.isRoleAvailable(ROLE_WALLET) is a device-capability check,
not per-user, so this raw comparison was the only thing hiding the
tile from every non-main user, including the decoy. An ordinary
secondary user losing this tile is expected Android behavior, but the
owner wants the decoy session to look like a normal single-owner phone
rather than an ordinary secondary profile, so the decoy is now treated
as main-user-equivalent for this gate specifically.

Product decision, not a security fix: this tile was never an
identity-leak vector (RoleManager state is per-caller already), just a
cosmetic inconsistency the design doc had explicitly left open.
---
 .../qs/tiles/QuickAccessWalletTile.java       | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/QuickAccessWalletTile.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/QuickAccessWalletTile.java
index 73a9a923e31f..0a47549ab1a8 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/tiles/QuickAccessWalletTile.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/QuickAccessWalletTile.java
@@ -30,10 +30,12 @@ import static com.android.systemui.wallet.util.WalletCardUtilsKt.getPaymentCards
 
 import android.content.Intent;
 import android.content.pm.PackageManager;
+import android.content.pm.UserInfo;
 import android.graphics.drawable.Drawable;
 import android.os.Handler;
 import android.os.Looper;
 import android.os.UserHandle;
+import android.os.UserManager;
 import android.service.quickaccesswallet.GetWalletCardsError;
 import android.service.quickaccesswallet.GetWalletCardsResponse;
 import android.service.quickaccesswallet.QuickAccessWalletClient;
@@ -83,6 +85,7 @@ public class QuickAccessWalletTile extends QSTileImpl<QSTile.State> {
     private final PackageManager mPackageManager;
     private final SecureSettings mSecureSettings;
     private final QuickAccessWalletController mController;
+    private final UserManager mUserManager;
 
     @Nullable
     private WalletCard mSelectedCard;
@@ -104,13 +107,15 @@ public class QuickAccessWalletTile extends QSTileImpl<QSTile.State> {
             KeyguardStateController keyguardStateController,
             PackageManager packageManager,
             SecureSettings secureSettings,
-            QuickAccessWalletController quickAccessWalletController) {
+            QuickAccessWalletController quickAccessWalletController,
+            UserManager userManager) {
         super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
                 statusBarStateController, activityStarter, qsLogger);
         mController = quickAccessWalletController;
         mKeyguardStateController = keyguardStateController;
         mPackageManager = packageManager;
         mSecureSettings = secureSettings;
+        mUserManager = userManager;
     }
 
 
@@ -206,7 +211,24 @@ public class QuickAccessWalletTile extends QSTileImpl<QSTile.State> {
     }
 
     private boolean isWalletRoleAvailable() {
-        return mHost.getUserId() == UserHandle.USER_SYSTEM && mController.isWalletRoleAvailable();
+        return (mHost.getUserId() == UserHandle.USER_SYSTEM || isDecoySession())
+                && mController.isWalletRoleAvailable();
+    }
+
+    /**
+     * True when the current session is an SovereignOS Duress Unlock decoy user. The decoy is an
+     * ordinary secondary profile, so it fails the main-user check above like any other
+     * secondary user by default -- but a decoy session is meant to be indistinguishable from a
+     * normal single-owner phone, so this tile is exempted too. Reuses
+     * {@link UserManager#getUsersForUiDisplay}, the same identity-aware primitive every other
+     * Component B fix in this feature uses: when the calling user is the decoy, that call
+     * returns a singleton list containing only the caller's own {@link UserInfo}.
+     */
+    private boolean isDecoySession() {
+        List<UserInfo> usersForUiDisplay = mUserManager.getUsersForUiDisplay(true);
+        return usersForUiDisplay.size() == 1
+                && UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(
+                        usersForUiDisplay.get(0).userType);
     }
 
     @Nullable
