From 6afaf7131c977acc285e5990608956cd0949a1fa Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Wed, 16 Sep 2026 01:27:41 +0200
Subject: [PATCH 72/85] test: add coverage for the return-direction switch
 authorization

---
 .../android/server/am/UserControllerTest.java | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
index 43ce9bf78a29..cf9a4889941a 100644
--- a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
@@ -2723,6 +2723,74 @@ public class UserControllerTest {
         assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
     }
 
+    // AegisOS: authorizeRealUserSwitchKeyguardSkip is the return-direction mirror of
+    // authorizeDecoySwitchKeyguardSkip above -- same one mint, same three grants, same
+    // consumeDecoySwitchAuthorizationFor* methods, just always targeting UserHandle.USER_SYSTEM
+    // and gated on the caller being a genuine decoy rather than the target being one.
+
+    @Test
+    public void testRealUserSwitchAuthorization_mintedForDecoyCaller_targetsSystemUser() {
+        assertThat(mUserController.authorizeRealUserSwitchKeyguardSkip(TEST_DECOY_USER_ID))
+                .isTrue();
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isFalse();
+    }
+
+    @Test
+    public void testRealUserSwitchAuthorization_notMintedForNonDecoyCaller() {
+        assertThat(mUserController.authorizeRealUserSwitchKeyguardSkip(TEST_ORDINARY_USER_ID))
+                .isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isFalse();
+    }
+
+    @Test
+    public void testRealUserSwitchAuthorization_wrongUserIdDoesNotConsume() {
+        mUserController.authorizeRealUserSwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+        // The authorization must survive an attempt against the wrong id, not be silently burned.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isTrue();
+    }
+
+    @Test
+    public void testRealUserSwitchAuthorization_allThreeGrantsConsumableFromOneMint() {
+        mUserController.authorizeRealUserSwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                UserHandle.USER_SYSTEM)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                UserHandle.USER_SYSTEM)).isTrue();
+    }
+
+    @Test
+    public void testRealUserSwitchAuthorization_expiredIsNotHonoured() {
+        mUserController.authorizeRealUserSwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isFalse();
+    }
+
+    @Test
+    public void testRealUserSwitchAuthorization_freshMintOverwritesOutboundMint() {
+        // Only one pending authorization can exist at a time -- an outbound mint left outstanding
+        // must not let a stale grant for the decoy id be redeemed after a return-direction mint
+        // supersedes it.
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        mUserController.authorizeRealUserSwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(UserHandle.USER_SYSTEM))
+                .isTrue();
+    }
+
     // AegisOS: the bouncer-skip grant below is the second, independent single-use consumption
     // point derived from the same mint as the forced-lock-skip grant above. See the class-level
     // javadoc on mForcedLockSkipConsumed/mBouncerSkipConsumed in UserController for why one mint
