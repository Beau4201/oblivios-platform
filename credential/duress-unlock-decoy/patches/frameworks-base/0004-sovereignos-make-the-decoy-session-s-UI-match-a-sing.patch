From 700144f2f32a9796c3993909ec571c3b76943a67 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 3 Sep 2026 03:20:50 +0200
Subject: [PATCH] sovereignos: make the decoy session's UI match a single-owner
 device

Squash of former patches:

- 0029 sovereignos: add UserManager.isMainForUiDisplay primitive
- 0030 sovereignos: suppress End session affordance for decoy session
- 0031 sovereignos: hide user-switcher-enabled state for the decoy's own current-user view
- 0032 sovereignos: route SystemUI user-switcher-enabled state through UserManager
- 0033 sovereignos: refresh lockscreen multi-user avatar visibility on enabled-state change
- 0034 sovereignos: use owner's default-avatar color for a decoy's own SystemUI icon
- 0035 sovereignos: use owner's default-avatar color in SettingsLib.Utils#getUserIcon
---
 core/java/android/os/IUserManager.aidl        |  1 +
 core/java/android/os/UserManager.java         | 13 ++++++
 .../src/com/android/settingslib/Utils.java    |  9 +++-
 .../phone/KeyguardStatusBarView.java          |  7 +++
 .../user/data/repository/UserIconProvider.kt  | 13 +++++-
 .../data/repository/UserRepositoryImpl.kt     | 19 +++-----
 .../android/server/pm/UserManagerService.java | 45 +++++++++++++++++++
 7 files changed, 92 insertions(+), 15 deletions(-)

diff --git a/core/java/android/os/IUserManager.aidl b/core/java/android/os/IUserManager.aidl
index b40400f45..eea8c522a 100644
--- a/core/java/android/os/IUserManager.aidl
+++ b/core/java/android/os/IUserManager.aidl
@@ -67,6 +67,7 @@ interface IUserManager {
     int getPreviousUserToEnterForeground();
     List<UserInfo> getUsers(boolean excludeDying);
     List<UserInfo> getUsersForUiDisplay(boolean excludeDying);
+    boolean isMainForUiDisplay(int userId);
     List<UserInfo> getProfiles(int userId, boolean enabledOnly);
     int[] getProfileIds(int userId, boolean enabledOnly);
     boolean isUserTypeSupportedIncludingSystem(in String userType);
diff --git a/core/java/android/os/UserManager.java b/core/java/android/os/UserManager.java
index 6be5df13d..58f595163 100644
--- a/core/java/android/os/UserManager.java
+++ b/core/java/android/os/UserManager.java
@@ -5274,6 +5274,19 @@ public class UserManager {
         }
     }
 
+    /**
+     * @hide
+     * @see IUserManager#isMainForUiDisplay(int)
+     */
+    @RequiresPermission(android.Manifest.permission.MANAGE_USERS)
+    public boolean isMainForUiDisplay(@UserIdInt int userId) {
+        try {
+            return mService.isMainForUiDisplay(userId);
+        } catch (RemoteException re) {
+            throw re.rethrowFromSystemServer();
+        }
+    }
+
     /**
      * Returns information for all users on this device, based on the filtering parameters.
      *
diff --git a/packages/SettingsLib/src/com/android/settingslib/Utils.java b/packages/SettingsLib/src/com/android/settingslib/Utils.java
index 65ab1b3d3..268cc5182 100644
--- a/packages/SettingsLib/src/com/android/settingslib/Utils.java
+++ b/packages/SettingsLib/src/com/android/settingslib/Utils.java
@@ -211,10 +211,17 @@ public class Utils {
                 return new UserIconDrawable(iconSize).setIcon(icon).bake();
             }
         }
+        // The default icon's color is picked from a fixed palette by userId, so an SovereignOS
+        // Duress Unlock decoy's own arbitrary real userId would otherwise produce a different
+        // color than what a genuine single, fresh-out-of-box owner (always userId 0) shows for
+        // the same "no custom photo yet" case -- reachable from this shared helper's own several
+        // real callers (Settings' Running services, Battery usage, Storage, About phone) whenever
+        // any of them renders before the decoy's own Settings > Users row ever has.
+        int colorSourceUserId = um.isMainForUiDisplay(user.id) ? UserHandle.USER_SYSTEM : user.id;
         return new UserIconDrawable(iconSize)
                 .setIconDrawable(
                         UserIcons.getDefaultUserIcon(
-                                context.getResources(), user.id, /* light= */ false))
+                                context.getResources(), colorSourceUserId, /* light= */ false))
                 .bake();
     }
 
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/KeyguardStatusBarView.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/KeyguardStatusBarView.java
index 13cfa8064..922a02edf 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/KeyguardStatusBarView.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/KeyguardStatusBarView.java
@@ -188,6 +188,13 @@ public class KeyguardStatusBarView extends RelativeLayout {
 
     public void setUserSwitcherEnabled(boolean enabled) {
         mIsUserSwitcherEnabled = enabled;
+        // Without this, a change is only applied the next time updateVisibilities() happens to
+        // run for an unrelated reason (e.g. this view's own setVisibility(VISIBLE)), which can
+        // race behind the async UserManager call in
+        // KeyguardStatusBarViewController#updateUserSwitcher() and leave mMultiUserAvatar
+        // showing a stale state — including across an SovereignOS Duress Unlock decoy switch, whose
+        // whole point is that isUserSwitcherEnabled()'s answer changes mid-session.
+        updateVisibilities();
     }
 
     private void updateKeyguardStatusBarHeight() {
diff --git a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserIconProvider.kt b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserIconProvider.kt
index 8926418d6..979e71cdb 100644
--- a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserIconProvider.kt
+++ b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserIconProvider.kt
@@ -61,10 +61,21 @@ constructor(
                     Icon.scaleDownIfNecessary(bitmap, iconSize, iconSize)
                 }
                     ?: run {
+                        // The default icon's color is picked from a fixed palette by userId, so
+                        // an SovereignOS Duress Unlock decoy's own arbitrary real userId would
+                        // otherwise produce a different color than what a genuine single,
+                        // fresh-out-of-box owner (always userId 0) shows for the same "no custom
+                        // photo" case -- a standalone identity tell.
+                        val colorSourceUserId =
+                            if (userManager.isMainForUiDisplay(userId)) {
+                                android.os.UserHandle.USER_SYSTEM
+                            } else {
+                                userId
+                            }
                         val defaultIcon =
                             UserIcons.getDefaultUserIcon(
                                 appContext.resources,
-                                userId,
+                                colorSourceUserId,
                                 /* light= */ false,
                             )
                         defaultIcon.toBitmap(iconSize, iconSize)
diff --git a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
index f236b3b6d..500017a9f 100644
--- a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
+++ b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
@@ -333,19 +333,12 @@ constructor(
                 val isAddUsersFromLockscreen =
                     globalSettings.getInt(Settings.Global.ADD_USERS_WHEN_LOCKED, 0) != 0
 
-                val isUserSwitcherEnabled =
-                    globalSettings.getInt(
-                        Settings.Global.USER_SWITCHER_ENABLED,
-                        if (
-                            appContext.resources.getBoolean(
-                                com.android.internal.R.bool.config_showUserSwitcherByDefault
-                            )
-                        ) {
-                            1
-                        } else {
-                            0
-                        },
-                    ) != 0
+                // Delegates to UserManager rather than reading the raw setting directly: the
+                // raw Settings.Global value alone can't reflect an SovereignOS Duress Unlock decoy
+                // session (UserManagerService#isUserSwitcherEnabled additionally hides the
+                // switcher for the decoy's own current-user view without touching the
+                // device-wide setting itself).
+                val isUserSwitcherEnabled = manager.isUserSwitcherEnabled()
                 UserSwitcherSettingsModel(
                     isSimpleUserSwitcher = isSimpleUserSwitcher,
                     isAddUsersFromLockscreen = isAddUsersFromLockscreen,
diff --git a/services/core/java/com/android/server/pm/UserManagerService.java b/services/core/java/com/android/server/pm/UserManagerService.java
index e746495d6..ea62ab8d6 100644
--- a/services/core/java/com/android/server/pm/UserManagerService.java
+++ b/services/core/java/com/android/server/pm/UserManagerService.java
@@ -1775,6 +1775,38 @@ public class UserManagerService extends IUserManager.Stub {
         return getUsers(excludeDying);
     }
 
+    /**
+     * Returns whether {@code userId} should be treated as the device's one true primary user
+     * for UI-DISPLAY purposes only. Real capability checks -- {@link #isAdminUser},
+     * {@link UserInfo#isMain()}, and this class's own {@link #getUserLogoutability}'s direct
+     * {@link UserHandle#USER_SYSTEM} comparison among them -- must keep using their existing,
+     * unchanged logic; this method exists only for call sites that decide what to *show* (a
+     * label, an icon, whether a menu entry appears), never one that decides whether a real
+     * action may be *performed*. Returns true for {@code userId}'s own real main-user or
+     * system-user status, or for an SovereignOS Duress Unlock decoy user when {@code userId} is the
+     * device's actual current (foreground) user. Deliberately keyed off the actual current user
+     * rather than the Binder calling user, for the same reason {@link #getUsersForUiDisplay} is
+     * -- see that method's own doc comment.
+     */
+    @Override
+    public boolean isMainForUiDisplay(@UserIdInt int userId) {
+        checkManageUsersPermission("query main-user-for-display status");
+        UserInfo targetInfo;
+        synchronized (mUsersLock) {
+            targetInfo = getUserInfoLU(userId);
+        }
+        if (targetInfo == null) {
+            return false;
+        }
+        if (targetInfo.isMain() || targetInfo.id == UserHandle.USER_SYSTEM) {
+            return true;
+        }
+        if (userId != getCurrentUserId()) {
+            return false;
+        }
+        return UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(targetInfo.userType);
+    }
+
     // Used by cmd users
     // TODO(b/419086491): remove once user_filter_refactoring flag is ramped  up
     /**
@@ -3411,6 +3443,15 @@ public class UserManagerService extends IUserManager.Stub {
 
     @VisibleForTesting
     boolean isUserSwitcherEnabled(@UserIdInt int userId) {
+        UserInfo currentUserInfo;
+        synchronized (mUsersLock) {
+            currentUserInfo = getUserInfoLU(getCurrentUserId());
+        }
+        if (currentUserInfo != null
+                && UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(currentUserInfo.userType)) {
+            return false;
+        }
+
         boolean multiUserSettingOn = Settings.Global.getInt(mContext.getContentResolver(),
                 Settings.Global.USER_SWITCHER_ENABLED,
                 getContextResources().getBoolean(com.android.internal
@@ -3434,6 +3475,10 @@ public class UserManagerService extends IUserManager.Stub {
             return UserManager.LOGOUTABILITY_STATUS_CANNOT_LOGOUT_SYSTEM_USER;
         }
 
+        if (isMainForUiDisplay(userId)) {
+            return UserManager.LOGOUTABILITY_STATUS_CANNOT_LOGOUT_SYSTEM_USER;
+        }
+
         if (getUserSwitchability(userId) != UserManager.SWITCHABILITY_STATUS_OK) {
             return UserManager.LOGOUTABILITY_STATUS_CANNOT_SWITCH;
         }
