From c6200da6f61c22d062986a9b960af42305b3c9d6 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Fri, 18 Sep 2026 13:10:31 +0200
Subject: [PATCH 88/89] aegisos: make RealUserQuiescer report real per-process
 freeze failure

---
 .../android/app/ActivityManagerInternal.java  | 13 ++++++----
 .../server/am/ActivityManagerService.java     |  3 +--
 .../android/server/am/RealUserQuiescer.java   | 24 +++++++++++++++----
 3 files changed, 30 insertions(+), 10 deletions(-)

diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index e882cc2a6676..89aa12b21de3 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1549,10 +1549,15 @@ public abstract class ActivityManagerInternal {
     public abstract boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId);
 
     /**
-     * Best-effort freezes userId's app processes and installs a notification-suppression flag
-     * for it. Returns whether the notification-suppression flag was installed (freeze failures
-     * never affect this return value -- see docs/superpowers/specs/2026-08-27
-     * -duress-real-user-quiescing-and-return-design.md's asymmetric error-handling rule).
+     * Best-effort freezes userId's app processes and marks it quiesced for notification
+     * suppression (consulted separately via isUserQuiescedForDuress(), unaffected by the return
+     * value below). Returns whether every eligible process was successfully handed to the
+     * freezer -- any single process failing to freeze counts as a failure (owner's explicit
+     * threshold, see docs/superpowers/specs/2026-09-17-duress-unlock-final-closure-design.md,
+     * Component 3, in the aegisos-foundation repository). userId is still marked quiesced
+     * regardless of this return value; callers must treat a false return as a soft signal to
+     * record for later visibility, never as a reason to block or unwind a user switch that has
+     * already happened.
      */
     public abstract boolean quiesceUserApps(int userId);
 
diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index 7966b12bcc9e..28a2d3b958da 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -17650,8 +17650,7 @@ public class ActivityManagerService extends IActivityManager.Stub
 
         @Override
         public boolean quiesceUserApps(int userId) {
-            mRealUserQuiescer.quiesce(userId);
-            return true;
+            return mRealUserQuiescer.quiesce(userId);
         }
 
         @Override
diff --git a/services/core/java/com/android/server/am/RealUserQuiescer.java b/services/core/java/com/android/server/am/RealUserQuiescer.java
index dbc15d113689..640fe91a9bc4 100644
--- a/services/core/java/com/android/server/am/RealUserQuiescer.java
+++ b/services/core/java/com/android/server/am/RealUserQuiescer.java
@@ -14,9 +14,12 @@ import java.util.Set;
  * /UserController.java:1323-1324. See docs/superpowers/specs/2026-08-27-duress-real-user
  * -quiescing-and-return-design.md in the aegisos-foundation repository.
  *
- * Freezing is always best-effort: a process that resists freezing is logged, not escalated.
- * This class does not touch notification state; NotificationManagerService consults
- * isQuiesced() directly via ActivityManagerInternal.
+ * Freezing is always best-effort: a process that resists freezing is logged AND reported back to
+ * the caller via quiesce()'s return value (any single process failing to freeze counts as a
+ * quiesce failure), but never escalated beyond that -- a still-unfrozen process does not undo or
+ * block the user switch that already happened. This class does not touch notification state;
+ * NotificationManagerService consults isQuiesced() directly via ActivityManagerInternal, and
+ * that membership check is unaffected by freeze failures (see quiesce()'s own javadoc).
  */
 class RealUserQuiescer {
     private static final String TAG = "SessionQuiescer";
@@ -34,8 +37,19 @@ class RealUserQuiescer {
      * Freezes userId's currently-running, non-persistent app processes (best-effort) and marks
      * userId as quiesced. Callers should invoke this only after userId has actually stopped
      * being the foreground user -- a still-foreground process generally cannot be frozen.
+     *
+     * Returns whether every eligible process was successfully handed to the freezer: any single
+     * process throwing counts as a failure (owner's explicit threshold, not "all processes
+     * failed" or "majority failed"). userId is still marked quiesced regardless of this return
+     * value -- the processes that did freeze successfully still need to be tracked for eventual
+     * unfreezing, and notification suppression (via isQuiesced()) is unaffected by a partial
+     * freeze failure. The return value exists purely so the caller can record that protection was
+     * incomplete; it must never be used to block or unwind the user switch that already
+     * happened, since freezing is a best-effort battery/CPU optimization, not the mechanism that
+     * keeps the previous user's notifications off screen.
      */
-    void quiesce(int userId) {
+    boolean quiesce(int userId) {
+        boolean allSucceeded = true;
         synchronized (mAm) {
             synchronized (mAm.mProcLock) {
                 for (ProcessRecord app : mAm.mProcessList.getLruProcessesLOSP()) {
@@ -47,6 +61,7 @@ class RealUserQuiescer {
                     } catch (RuntimeException e) {
                         Slog.e(TAG, "Failed to freeze process " + app.processName
                                 + " for quiesced user " + userId, e);
+                        allSucceeded = false;
                     }
                 }
             }
@@ -54,6 +69,7 @@ class RealUserQuiescer {
         synchronized (mQuiescedUserIds) {
             mQuiescedUserIds.add(userId);
         }
+        return allSucceeded;
     }
 
     /**
-- 
