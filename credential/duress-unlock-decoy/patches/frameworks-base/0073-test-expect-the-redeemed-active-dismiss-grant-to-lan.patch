From 490a9759a4abdc4b4415f0eec2bc760e07c3207c Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 16 Sep 2026 01:48:08 +0200
Subject: [PATCH 75/89] test: expect the redeemed active-dismiss grant to land
 without a swipe

---
 .../systemui/keyguard/KeyguardViewMediatorTest.java | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index 0d284395b8b7..28383978d3ca 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -597,14 +597,19 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         verify(onSwitchResult).run();
         verify(mStatusBarKeyguardViewManager, never()).dismissAndCollapse();
 
-        // Unlike testUserSwitchToSecureUserShowsBouncer, the authorized grant means the
-        // otherwise-unconditional post-switch dismiss()/bouncer re-arm must never fire, even
-        // after the same 500ms delay elapses.
+        // SovereignOS: the authorized grant means the automatic bouncer *re-arm* above never fires
+        // (verified immediately above, before any delay), but dismiss() still runs once, on the
+        // same 500ms delay as the unauthorized case -- this is what redeems the still-outstanding
+        // third (active-dismiss) grant from the same mint, landing without a swipe, instead of
+        // leaving that grant to be redeemed by chance on the user's own next gesture. This is
+        // the one call site both the outbound (owner-to-decoy) and return (decoy-to-owner)
+        // directions share, since consumeDecoySwitchAuthorizationForBouncerSkip is generic on
+        // target user id.
         mViewMediator.handleUserSwitchComplete(nextUserId);
         TestableLooper.get(this).moveTimeForward(600);
         processAllMessagesAndBgExecutorMessages();
 
-        verify(mStatusBarKeyguardViewManager, never()).dismissAndCollapse();
+        verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
     }
 
     @Test
