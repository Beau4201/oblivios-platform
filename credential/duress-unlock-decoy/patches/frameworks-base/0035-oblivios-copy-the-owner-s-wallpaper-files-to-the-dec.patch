diff --git a/services/core/java/com/android/server/locksettings/DecoyWallpaperFiles.java b/services/core/java/com/android/server/locksettings/DecoyWallpaperFiles.java
new file mode 100644
index 00000000..22654542
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyWallpaperFiles.java
@@ -0,0 +1,79 @@
+package com.android.server.locksettings;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+
+/**
+ * ObliviOS: copies the owner's wallpaper files to the decoy user's, file by file.
+ *
+ * <p>The wallpaper service keeps four image files and one metadata file per user in that user's
+ * system directory (WallpaperUtils): the source image and its crop for the home screen, the same
+ * pair for a separate lock screen wallpaper, and wallpaper_info.xml, which names the component, the
+ * crop and the colours. A copy through WallpaperManager#setStream only writes the source image: the
+ * service finishes such a set (the crop, the metadata, the binding) in a file observer that it
+ * starts for the current and for an unlocked user only, so for the decoy, which is neither while the
+ * owner is on screen, the set was never finished and its home screen stayed black (lynx
+ * 2026-11-14). The service loads the files of a user when that user becomes current, so the files
+ * are all it needs.
+ *
+ * <p>Plain java.io on purpose: no Android classes, so the rules are tested on the JVM.
+ */
+final class DecoyWallpaperFiles {
+    /** The files, the metadata last: a copy cut short never names an image the decoy lacks. */
+    static final String[] NAMES = {
+        "wallpaper_orig", "wallpaper", "wallpaper_lock_orig", "wallpaper_lock", "wallpaper_info.xml"
+    };
+
+    /** The lock screen files exist only while the owner has a separate lock screen wallpaper. */
+    private static final String[] LOCK_NAMES = {"wallpaper_lock_orig", "wallpaper_lock"};
+
+    private DecoyWallpaperFiles() {}
+
+    /**
+     * Copies each file the owner has to the decoy's directory unless the decoy's copy has the same
+     * size and modification time, and removes a lock screen file the owner no longer has.
+     *
+     * @return the number of files written or removed
+     * @throws IOException when a file cannot be copied; the files before it stay copied
+     */
+    static int copy(File ownerDir, File decoyDir) throws IOException {
+        int changed = 0;
+        for (String name : NAMES) {
+            final File src = new File(ownerDir, name);
+            final File dst = new File(decoyDir, name);
+            if (!src.isFile()) {
+                if (isLockName(name) && dst.delete()) {
+                    changed++;
+                }
+                continue;
+            }
+            if (dst.isFile() && dst.length() == src.length()
+                    && dst.lastModified() == src.lastModified()) {
+                continue;
+            }
+            // Written beside the target and moved over it, so the service never reads half a file.
+            final File tmp = new File(decoyDir, name + ".tmp");
+            try {
+                Files.copy(src.toPath(), tmp.toPath(), StandardCopyOption.REPLACE_EXISTING);
+                tmp.setLastModified(src.lastModified());
+                Files.move(tmp.toPath(), dst.toPath(), StandardCopyOption.REPLACE_EXISTING,
+                        StandardCopyOption.ATOMIC_MOVE);
+            } finally {
+                tmp.delete();
+            }
+            changed++;
+        }
+        return changed;
+    }
+
+    private static boolean isLockName(String name) {
+        for (String lock : LOCK_NAMES) {
+            if (lock.equals(name)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoyWallpaperFilesTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoyWallpaperFilesTest.java
new file mode 100644
index 00000000..ff5d72ed
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoyWallpaperFilesTest.java
@@ -0,0 +1,138 @@
+package com.android.server.locksettings;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+public class DecoyWallpaperFilesTest {
+    @Rule public TemporaryFolder tmp = new TemporaryFolder();
+
+    private File owner() throws IOException {
+        return tmp.newFolder("owner");
+    }
+
+    private File decoy() throws IOException {
+        return tmp.newFolder("decoy");
+    }
+
+    private static void write(File dir, String name, String text, long mtime) throws IOException {
+        File f = new File(dir, name);
+        Files.write(f.toPath(), text.getBytes(StandardCharsets.UTF_8));
+        assertTrue(f.setLastModified(mtime));
+    }
+
+    private static String read(File dir, String name) throws IOException {
+        return new String(Files.readAllBytes(new File(dir, name).toPath()), StandardCharsets.UTF_8);
+    }
+
+    @Test
+    public void copiesEveryFileTheOwnerHas() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper_orig", "orig", 1000);
+        write(o, "wallpaper", "crop", 1000);
+        write(o, "wallpaper_info.xml", "info", 1000);
+
+        assertEquals(3, DecoyWallpaperFiles.copy(o, d));
+
+        assertEquals("orig", read(d, "wallpaper_orig"));
+        assertEquals("crop", read(d, "wallpaper"));
+        assertEquals("info", read(d, "wallpaper_info.xml"));
+        assertFalse(new File(d, "wallpaper_lock").exists());
+    }
+
+    @Test
+    public void copiesTheMetadataLast() {
+        String[] names = DecoyWallpaperFiles.NAMES;
+        // A copy cut short must never leave metadata that names an image the decoy does not have.
+        assertEquals("wallpaper_info.xml", names[names.length - 1]);
+    }
+
+    @Test
+    public void skipsFilesThatDidNotChange() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "crop", 1000);
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+
+        assertEquals(0, DecoyWallpaperFiles.copy(o, d));
+    }
+
+    @Test
+    public void copiesAgainWhenTheOwnerChangedTheImage() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "old", 1000);
+        DecoyWallpaperFiles.copy(o, d);
+
+        write(o, "wallpaper", "new", 2000);
+
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+        assertEquals("new", read(d, "wallpaper"));
+    }
+
+    @Test
+    public void copiesAgainWhenOnlyTheSizeDiffers() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "old", 1000);
+        DecoyWallpaperFiles.copy(o, d);
+
+        write(o, "wallpaper", "longer", 1000);
+
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+        assertEquals("longer", read(d, "wallpaper"));
+    }
+
+    @Test
+    public void removesALockWallpaperTheOwnerNoLongerHas() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "crop", 1000);
+        write(o, "wallpaper_lock", "lock", 1000);
+        DecoyWallpaperFiles.copy(o, d);
+        assertTrue(new File(d, "wallpaper_lock").exists());
+
+        assertTrue(new File(o, "wallpaper_lock").delete());
+
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+        assertFalse(new File(d, "wallpaper_lock").exists());
+        assertEquals("crop", read(d, "wallpaper"));
+    }
+
+    @Test
+    public void leavesNoTemporaryFileBehind() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "crop", 1000);
+
+        DecoyWallpaperFiles.copy(o, d);
+
+        String[] names = d.list();
+        java.util.Arrays.sort(names);
+        assertArrayEquals(new String[] {"wallpaper"}, names);
+    }
+
+    @Test
+    public void leavesTheDecoyAloneWhenTheOwnerHasNoWallpaperFiles() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(d, "wallpaper", "keep", 1000);
+        write(d, "wallpaper_info.xml", "keep", 1000);
+
+        // Removing the decoy's copies would be a change of the decoy the owner never made: only a
+        // lock wallpaper the owner had and dropped is removed (above), and that needs a copy first.
+        assertEquals(0, DecoyWallpaperFiles.copy(o, d));
+        assertEquals("keep", read(d, "wallpaper"));
+    }
+}
