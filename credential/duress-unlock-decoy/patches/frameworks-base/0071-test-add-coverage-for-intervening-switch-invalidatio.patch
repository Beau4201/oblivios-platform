From 7568e491414d373b2c2e53b9f9c24ea54fcda4ce Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Fri, 11 Sep 2026 01:39:09 +0200
Subject: [PATCH 1/2] test: add coverage for intervening-switch invalidation of
 decoy grants

A review finding on Task 11c's active-dismiss grant identified that a
second, distinct switch event targeting the same already-authorized
decoy user id -- through a route that never goes through
authorizeDecoySwitchKeyguardSkip's own credential check, e.g. the
lock-screen avatar switcher or am switch-user over adb -- could still
redeem grants left outstanding from an earlier, unrelated mint.

These tests exercise noteForegroundSwitchInitiatedForTests, a
test-only hook that does not exist yet; they are expected to fail to
compile until the next commit adds it.
---
 .../android/server/am/UserControllerTest.java | 91 +++++++++++++++++++
 1 file changed, 91 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
index fe72f6177375..43ce9bf78a29 100644
--- a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
@@ -2936,6 +2936,97 @@ public class UserControllerTest {
                 TEST_DECOY_USER_ID)).isTrue();
     }
 
+    // AegisOS: a review finding after this mechanism first shipped found the three grants above
+    // could remain outstanding (and honourable) even after a second, wholly separate switch
+    // event retargeted the device away from the decoy and back again through a route that never
+    // goes through authorizeDecoySwitchKeyguardSkip's own credential check -- e.g. the
+    // lock-screen avatar switcher, or `am switch-user` over adb. Narrower than ADR-061 since it
+    // can only ever re-enter the same already-once-authorized decoy session, but still a real
+    // widening of "one verified credential authorizes exactly one thing". The tests below
+    // exercise the fix: mSwitchSequenceNumber/mSwitchAuthorizedAtSequence, driven through
+    // noteForegroundSwitchInitiatedForTests, the test-only entry point that performs the exact
+    // same bookkeeping switchUser()/switchToUserSilently() perform for a real switch.
+
+    @Test
+    public void testDecoySwitchAuthorization_authorizedSwitchInitiationDoesNotInvalidateGrants() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        // This mirrors the real production order exactly: DecoyProfileHelper mints, then --
+        // moments later, on its own posted runnable -- calls switchToUserSilently for the exact
+        // same target. That one, single, authorized switch must never itself count as an
+        // "intervening" switch against its own mint, or every real decoy switch would
+        // immediately invalidate its own grants.
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_interveningSwitchInvalidatesAllOutstandingGrants() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        // The switch this mint actually authorizes happens first, exactly as in production.
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_DECOY_USER_ID);
+
+        // A second, distinct switch event -- to an unrelated user, never authorized by any mint
+        // -- starts before any of the three grants above have been redeemed. This is the exact
+        // gap found in review: nothing about this second switch goes through
+        // authorizeDecoySwitchKeyguardSkip, yet without this fix the still-outstanding grants
+        // from the *first* mint would remain honourable for whoever's bouncer asks next.
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_OTHER_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_switchAwayFromDecoyAndBackStillInvalidatesGrants() {
+        // The literal scenario from the review finding: something switches away from the
+        // already-authorized decoy session and back to the exact same decoy user id again,
+        // within the 30-second window, before the swipe-time active-dismiss grant is consumed --
+        // e.g. via the lock-screen avatar switcher or `am switch-user` over adb, neither of which
+        // ever calls authorizeDecoySwitchKeyguardSkip.
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_DECOY_USER_ID);
+
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_OTHER_USER_ID); // switch away
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_DECOY_USER_ID); // switch back
+
+        // Even though the target id matches the original mint exactly, this second re-entry was
+        // never itself authorized -- the outstanding grant from the first mint must not be
+        // redeemable against it.
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_expiryStillAppliesEvenWithNoInterveningSwitch() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_DECOY_USER_ID);
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        // The sequence still matches perfectly (no other switch was ever initiated) -- this
+        // proves expiry is checked independently of, and not subsumed by, the new sequence gate.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_interveningSwitchInvalidatesEvenWellWithinTimeWindow() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_DECOY_USER_ID);
+        mUserController.noteForegroundSwitchInitiatedForTests(TEST_OTHER_USER_ID);
+
+        // No time has elapsed at all -- this proves the sequence gate is checked independently
+        // of, and not subsumed by, the existing time-based expiry check.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
     @Test
     public void testForegroundSwitch_authorizedDecoy_doesNotForceKeyguard() throws Exception {
         setUserSecure(TEST_DECOY_USER_ID, true);
