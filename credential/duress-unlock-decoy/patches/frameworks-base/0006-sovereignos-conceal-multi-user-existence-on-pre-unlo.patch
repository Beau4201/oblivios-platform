@@ -3463,6 +3475,38 @@ public class UserManagerService extends IUserManager.Stub {
                 && multiUserSettingOn;
     }
 
+    /**
+     * SovereignOS: true if any non-removing user on this device is of the decoy type. Read from this
+     * service's own user list, so this adds no cross-service dependency.
+     */
+    private boolean hasDecoyUser() {
+        synchronized (mUsersLock) {
+            for (int i = mUsers.size() - 1; i >= 0; i--) {
+                UserInfo ui = mUsers.valueAt(i).info;
+                if (ui != null && !mRemovingUserIds.get(ui.id)
+                        && UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(ui.userType)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * SovereignOS: true while the device is locked. Deliberately queried outside mUsersLock -- see
+     * this plan's Task 1 findings for the lock-ordering analysis behind that.
+     */
+    private boolean isDeviceCurrentlyLocked() {
+        WindowManagerInternal wmInternal =
+                LocalServices.getService(WindowManagerInternal.class);
+        if (wmInternal == null) {
+            // Called before WindowManagerService has published its local service: too early for
+            // a keyguard to be showing, so this cannot be a pre-unlock surface.
+            return false;
+        }
+        return wmInternal.isKeyguardShowing();
+    }
