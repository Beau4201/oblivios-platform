+    // SovereignOS: pre-unlock concealment (isUserSwitcherEnabled must not advertise a second user
+    // while the device is locked, but only when a decoy actually exists on the device).
+    //
+    // These tests force USER_SWITCHER_ENABLED on so the assertions below actually discriminate
+    // this code path: on a stock instrumented-test device this setting is otherwise unset, and
+    // this build's own config_showUserSwitcherByDefault resolves to false for it, which would
+    // make isUserSwitcherEnabled() return false regardless of decoy/lock state -- a test that
+    // could pass identically whether or not the concealment code exists proves nothing. Forcing
+    // the setting on establishes a known, deterministic "true" baseline so the decoy+lock gate is
+    // the only thing that can flip the result to false.
+    @Test
+    public void testIsUserSwitcherEnabled_lockedDeviceWithDecoy_returnsFalse() {
+        forceUserSwitcherSettingEnabled();
+        addDecoyUser();
+        setKeyguardLocked(true);
+
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isFalse();
+    }
+
+    @Test
+    public void testIsUserSwitcherEnabled_unlockedDeviceWithDecoy_returnsRealValue() {
+        forceUserSwitcherSettingEnabled();
+        addDecoyUser();
+        setKeyguardLocked(false);
+
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isTrue();
+    }
+
+    @Test
+    public void testIsUserSwitcherEnabled_lockedDeviceWithoutDecoy_returnsRealValue() {
+        forceUserSwitcherSettingEnabled();
+        setKeyguardLocked(true);
+
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isTrue();
+    }
+
+    private void addDecoyUser() {
+        mUserManagerService.putUserInfo(new UserInfo(SOVEREIGNOS_DECOY_USER_ID, "Decoy User", null, 0,
+                UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY));
+    }
+
+    private void setKeyguardLocked(boolean locked) {
+        if (mMockWindowManagerInternal == null) {
+            mMockWindowManagerInternal = mock(WindowManagerInternal.class);
+            LocalServices.removeServiceForTest(WindowManagerInternal.class);
+            LocalServices.addService(WindowManagerInternal.class, mMockWindowManagerInternal);
+        }
+        when(mMockWindowManagerInternal.isKeyguardShowing()).thenReturn(locked);
+    }
+
+    private void forceUserSwitcherSettingEnabled() {
+        if (!mUserSwitcherSettingOverridden) {
+            mOriginalUserSwitcherEnabled = Settings.Global.getString(mContext.getContentResolver(),
+                    Settings.Global.USER_SWITCHER_ENABLED);
+            mUserSwitcherSettingOverridden = true;
+        }
+        Settings.Global.putInt(mContext.getContentResolver(),
+                Settings.Global.USER_SWITCHER_ENABLED, 1);
+    }
+
