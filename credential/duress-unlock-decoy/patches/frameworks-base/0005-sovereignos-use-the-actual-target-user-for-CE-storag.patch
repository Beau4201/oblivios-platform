From 2aa5180dc8cc6779f0eddd848e4d1d35844c6855 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 3 Sep 2026 00:58:45 +0200
Subject: [PATCH] sovereignos: use the actual target user for CE-storage checks
 in backup and storage

Squash of former patches:

- 0028 sovereignos: fix UserBackupManagerService using wrong Context for CE-storage check
- 0036 sovereignos: check the actual target user, not user 0, for volume-report gating
- 0037 sovereignos: initialize ExternalStorageService component on any user's unlock
- 0038 sovereignos: resolve ExternalStorageService as the actually-unlocking user
---
 .../backup/UserBackupManagerService.java      |  9 ++++++-
 .../android/server/StorageManagerService.java | 24 +++++++++++++++----
 .../storage/StorageSessionController.java     | 24 +++++++++++++++----
 3 files changed, 48 insertions(+), 9 deletions(-)

diff --git a/services/backup/java/com/android/server/backup/UserBackupManagerService.java b/services/backup/java/com/android/server/backup/UserBackupManagerService.java
index 185345635..d6ccd89d6 100644
--- a/services/backup/java/com/android/server/backup/UserBackupManagerService.java
+++ b/services/backup/java/com/android/server/backup/UserBackupManagerService.java
@@ -619,7 +619,14 @@ public class UserBackupManagerService {
                 backupManagerMonitorDumpsysUtils::deleteExpiredBMMEvents,
                 INITIALIZATION_DELAY_MILLIS);
 
-        mBackupPreferences = new UserBackupPreferences(mContext, mBaseStateDir);
+        // Use userContext (created above), not mContext: mContext.getSharedPreferences()
+        // checks CE-storage-unlocked state for mContext's own implicit user, which is only
+        // ever correct here because on every ordinary Android flow user 0 is already unlocked
+        // by the time any other user's backup service starts. SovereignOS's Duress Unlock decoy
+        // switch is the first path that starts a secondary user's backup service while user 0
+        // has never unlocked this boot, which throws IllegalStateException from
+        // ContextImpl.credentialProtectedStorageCheck() and crashes system_server fatally.
+        mBackupPreferences = new UserBackupPreferences(userContext, mBaseStateDir);
 
         // Power management
         mWakelock =
diff --git a/services/core/java/com/android/server/StorageManagerService.java b/services/core/java/com/android/server/StorageManagerService.java
index 5a9257b25..b2bd9d538 100644
--- a/services/core/java/com/android/server/StorageManagerService.java
+++ b/services/core/java/com/android/server/StorageManagerService.java
@@ -3936,10 +3936,26 @@ class StorageManagerService extends IStorageManager.Stub
             }
         }
 
-        // Report all volumes as unmounted until we've recorded that user 0 has unlocked. There
-        // are no guarantees that callers will see a consistent view of the volume before that
-        // point
-        final boolean systemUserUnlocked = isSystemUnlocked(UserHandle.USER_SYSTEM);
+        // Report all volumes as unmounted until we've recorded that this user has completed its
+        // own unlock sequence (mSystemUnlockedUsers, populated per-user by completeUnlockUser()
+        // -- despite the misleading name, this has been generic per-user tracking since at least
+        // 2019, not system(0)-specific). There are no guarantees that callers will see a
+        // consistent view of the volume before that point.
+        //
+        // This used to hardcode UserHandle.USER_SYSTEM regardless of which user's volumes were
+        // being listed. That was harmless on stock Android, where user 0 is always unlocked
+        // before any other user can become current. SovereignOS's Duress Unlock decoy switch breaks
+        // that assumption by design (the real profile must stay genuinely locked through a
+        // decoy switch, per ADR-073) -- see docs/devices/lynx-duress-decoy-storage-unmount-
+        // incident.md. With the old check, a decoy session's own already-unlocked emulated
+        // storage volume was permanently misreported as unmounted, crashing Settings' Storage
+        // screen (StorageAsyncLoader) with "Volume external_primary not found" and breaking real
+        // file access, whenever the owner's real credential had never been entered since boot.
+        // Checking the actual target user matches the already-generic per-user tracking this
+        // reads from, and matches this method's own sibling check just below (ceStorageUnlocked)
+        // and mkdirs()'s already-correct per-user-only check elsewhere in this file -- neither
+        // imposes a cross-user dependency on user 0 for a non-zero target user.
+        final boolean systemUserUnlocked = isSystemUnlocked(userId);
 
         final boolean userIsDemo;
         final boolean storagePermission;
diff --git a/services/core/java/com/android/server/storage/StorageSessionController.java b/services/core/java/com/android/server/storage/StorageSessionController.java
index 0a1271611..31f2c9222 100644
--- a/services/core/java/com/android/server/storage/StorageSessionController.java
+++ b/services/core/java/com/android/server/storage/StorageSessionController.java
@@ -272,8 +272,16 @@ public final class StorageSessionController {
      */
     public void onUnlockUser(int userId) throws ExternalStorageServiceException {
         Slog.i(TAG, "On user unlock " + userId);
-        if (userId == 0) {
-            initExternalStorageServiceComponent();
+        // mExternalStorageServiceComponent resolves a single, global component name (identical
+        // for every user, not per-user data), so this only needs to run once -- gating on
+        // "userId == 0" instead of "not yet initialized" assumed user 0 always unlocks first,
+        // true on stock Android but not under SovereignOS Duress Unlock, where a decoy switch must
+        // succeed even when user 0 has never unlocked this boot. With the old check, no user's
+        // storage session (including the decoy's own) could ever bind to the
+        // ExternalStorageService: StorageUserConnection.connectIfNeeded() throws "Not ready to
+        // bind" whenever getExternalStorageServiceComponentName() is still null.
+        if (mExternalStorageServiceComponent == null) {
+            initExternalStorageServiceComponent(userId);
         }
     }
 
@@ -358,7 +366,8 @@ public final class StorageSessionController {
         }
     }
 
-    private void initExternalStorageServiceComponent() throws ExternalStorageServiceException {
+    private void initExternalStorageServiceComponent(int userId)
+            throws ExternalStorageServiceException {
         Slog.i(TAG, "Initialialising...");
         ProviderInfo provider = mContext.getPackageManager().resolveContentProvider(
                 MediaStore.AUTHORITY, PackageManager.MATCH_DIRECT_BOOT_AWARE
@@ -371,7 +380,14 @@ public final class StorageSessionController {
         mExternalStorageServicePackageName = provider.applicationInfo.packageName;
         mExternalStorageServiceAppId = UserHandle.getAppId(provider.getUid());
 
-        ServiceInfo serviceInfo = resolveExternalStorageServiceAsUser(UserHandle.USER_SYSTEM);
+        // Resolve as the user that is actually unlocking, not the hardcoded UserHandle.USER_SYSTEM
+        // this used to pass regardless of caller. The component being resolved is the same
+        // system-wide MediaProvider service for every user, but resolveServiceAsUser()'s lookup
+        // itself depends on the given user being in a queryable state -- confirmed on real
+        // hardware: this call fails with "No valid ExternalStorageService component found" when
+        // resolved as user 0 while user 0 has never unlocked, even though the exact same lookup
+        // succeeds immediately when resolved as an already-unlocked non-zero user instead.
+        ServiceInfo serviceInfo = resolveExternalStorageServiceAsUser(userId);
         if (serviceInfo == null) {
             throw new ExternalStorageServiceException(
                     "No valid ExternalStorageService component found");
