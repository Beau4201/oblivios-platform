diff --git a/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java b/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
index 4be6b6f8..2d3880ce 100644
--- a/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
+++ b/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
@@ -91,11 +91,46 @@ public class DuressPasswordHelper {
 
         DuressCredential.validate(pin, CREDENTIAL_TYPE_PIN);
         DuressCredential.validate(password, CREDENTIAL_TYPE_PASSWORD);
+        refuseDecoyCredential(pin);
+        refuseDecoyCredential(password);
 
         // exception handling is delegated to the caller
         DuressCredentials.create(spManager, pin, password).save(lockSettingsStorage);
     }
 
+    /**
+     * ObliviOS: refuses a wipe PIN or password that unlocks the registered Duress Unlock decoy. Decoy
+     * routing replaces the verification response before onVerifyCredentialResult sees it, so such a
+     * credential would open the decoy and the wipe would never run; the decoy set-up refuses the
+     * reverse (DuressUnlockSetupActivity). The decoy's credential is stored only behind its
+     * protector, so this checks the candidate against that protector: one hardware attempt on the
+     * decoy per candidate of the decoy's own type (a candidate of the other type is refused before
+     * the hardware), like any wrong guess; the next decoy unlock resets it. A decoy that is
+     * missing or cannot be read is no decoy.
+     */
+    private void refuseDecoyCredential(LockscreenCredential candidate) {
+        if (candidate.isNone()) {
+            return;
+        }
+        final DecoyProfileState decoy = DecoyProfileState.maybeGet(lockSettingsStorage);
+        if (decoy == null) {
+            return;
+        }
+        final SyntheticPasswordManager.SyntheticPassword sp;
+        try {
+            sp = lockSettingsService.unlockSyntheticPasswordWithCredential(candidate,
+                    decoy.decoyUserId);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "The decoy could not be checked against the wipe credential", e);
+            return;
+        }
+        if (sp != null) {
+            sp.zeroize();
+            throw new IllegalArgumentException("the wipe credential must differ from the "
+                    + "second credential of Duress Unlock");
+        }
+    }
+
     protected boolean hasDuressCredentials(LockscreenCredential ownerCredential) {
         checkOwnerCredential(ownerCredential);
         return DuressCredentials.maybeGet(lockSettingsStorage) != null;
