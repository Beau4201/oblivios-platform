 .../locksettings/DecoyFingerHelper.java       | 43 ++++++++++++++++---
 .../locksettings/DecoyProfileHelper.java      | 13 +++++-
 .../locksettings/DuressPasswordHelper.java    | 35 +++++++++++++++
 .../server/wm/RootWindowContainer.java        |  3 +-
 5 files changed, 106 insertions(+), 10 deletions(-)

