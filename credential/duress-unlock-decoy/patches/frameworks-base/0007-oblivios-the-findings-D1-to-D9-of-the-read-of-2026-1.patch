-            final byte[] plain = SyntheticPasswordCrypto.decrypt(ownerSp.deriveDecoyFingerKey(),
-                    WRAP_PERSONALIZATION, state.wrapped);
+            final byte[] key = ownerSp.deriveDecoyFingerKey();
