From ad5159b135d36c5a7d78907038401b077e0446bb Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Wed, 16 Sep 2026 21:15:35 +0200
Subject: [PATCH 79/85] aegisos: unlock the returning user on a matched return
 credential

The decoy-to-owner return stranded the owner on the direct-boot
FallbackHome placeholder whenever the owner's credential had not been
entered since boot -- that is, in exactly the duress case the feature
exists for, where the first credential typed after boot is the decoy's.

Confirmed on hardware from the device's own event log: the switch back
completed (uc_switch_user 0, wm_resume_activity com.android.settings/
.FallbackHome), UserController logged uc_finish_user_unlocking for the
user and then emitted nothing further -- no ssm_user_unlocking, no
uc_finish_user_unlocked, no USER_UNLOCKED -- for four and three quarter
minutes, until a credential was finally entered through an ordinary
path. That is finishUserUnlocking returning false at its own
isCeStorageUnlocked guard, one line after the event it did log.

The cause is that verifyPrimaryCredentialNoRouting applied none of
doVerifyCredentialInner's credential-verified side effects --
unlockKeystore, unlockCeStorage, unlockUser, the StrongAuth clear -- and
zeroized the synthetic password instead. That was survivable only while
the return path still re-armed a bouncer, because that second prompt ran
the full verification and performed the unlock. Authorizing the second
prompt away removed the only thing that ever unlocked the user.

Applies those side effects here on a match. The credential has genuinely
matched this user's own primary protector at that point, so this is the
same authority an ordinary keyguard unlock exercises, not a new one, and
a non-matching credential still unlocks nothing.

Invoked outside the mSpManager lock, matching doVerifyCredentialInner's
own placement: onCredentialVerified makes binder calls out to
StorageManager and ActivityManager, and holding mSpManager across those
is a deadlock shape. Deliberately does not mirror
sendCredentialsOnUnlockIfRequired, which would hand the raw credential
to a DPC and to profiles tied to this lock; the accepted consequence is
that such a profile stays locked after a return and is challenged on its
next access.
---
 .../locksettings/LockSettingsService.java     | 89 ++++++++++++-------
 1 file changed, 59 insertions(+), 30 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index 87dde87b7400..0a42e62a1d9b 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -2909,8 +2909,10 @@ public class LockSettingsService extends ILockSettings.Stub {
 
     /**
      * Verifies credential against userId's primary LSKF-based protector, with the same rate
-     * limiting doVerifyCredentialInner applies, but without any of doVerifyCredentialInner's
-     * other side effects (decoy routing, repair-mode write, biometric lockout reset). Used by
+     * limiting doVerifyCredentialInner applies, and -- on a match -- the same credential-verified
+     * unlock side effects it applies (see onCredentialVerifiedInternal), but without
+     * doVerifyCredentialInner's other side effects (decoy routing, repair-mode write, biometric
+     * lockout reset, credential propagation to a DPC or tied profiles). Used by
      * ReturnToRealUserHelper to check a credential against the real owner's account without
      * re-entering doVerifyCredentialInner, which would re-trigger the forward decoy-routing
      * hook. See docs/superpowers/specs/2026-08-27-duress-real-user-quiescing-and-return-design
@@ -2918,35 +2920,62 @@ public class LockSettingsService extends ILockSettings.Stub {
      */
     VerifyCredentialResponse verifyPrimaryCredentialNoRouting(LockscreenCredential credential,
             int userId) {
-        synchronized (mSpManager) {
-            final long protectorId = getCurrentLskfBasedProtectorId(userId, Primary);
-            final LskfIdentifier lskfId = new LskfIdentifier(userId, protectorId);
-            SoftwareRateLimiterResult res = mSoftwareRateLimiter.apply(lskfId, credential);
-            switch (res.code) {
-                case SoftwareRateLimiterResult.CONTINUE_TO_HARDWARE:
-                    break;
-                case SoftwareRateLimiterResult.RATE_LIMITED:
-                    return VerifyCredentialResponse.fromTimeout(res.timeout);
-                case SoftwareRateLimiterResult.CREDENTIAL_TOO_SHORT:
-                    return VerifyCredentialResponse.credTooShort();
-                case SoftwareRateLimiterResult.DUPLICATE_WRONG_GUESS:
-                    return VerifyCredentialResponse.credAlreadyTried();
-                default:
-                    return VerifyCredentialResponse.fromError();
-            }
-            AuthenticationResult authResult = mSpManager.unlockLskfBasedProtector(
-                    getGateKeeperService(), protectorId, credential, Primary, userId,
-                    /* progressCallback= */ null);
-            try {
-                return reportResultToSoftwareRateLimiter(authResult.response, lskfId, credential);
-            } finally {
-                // Mirrors doVerifyCredentialInner's own cleanup: this method never consumes the
-                // synthetic password (unlike doVerifyCredentialInner, which derives keys from it
-                // before zeroizing), so it must be zeroized here instead of left to linger in
-                // the heap until GC.
-                if (authResult.syntheticPassword != null) {
-                    authResult.syntheticPassword.zeroize();
+        AuthenticationResult authResult = null;
+        try {
+            final VerifyCredentialResponse response;
+            synchronized (mSpManager) {
+                final long protectorId = getCurrentLskfBasedProtectorId(userId, Primary);
+                final LskfIdentifier lskfId = new LskfIdentifier(userId, protectorId);
+                SoftwareRateLimiterResult res = mSoftwareRateLimiter.apply(lskfId, credential);
+                switch (res.code) {
+                    case SoftwareRateLimiterResult.CONTINUE_TO_HARDWARE:
+                        break;
+                    case SoftwareRateLimiterResult.RATE_LIMITED:
+                        return VerifyCredentialResponse.fromTimeout(res.timeout);
+                    case SoftwareRateLimiterResult.CREDENTIAL_TOO_SHORT:
+                        return VerifyCredentialResponse.credTooShort();
+                    case SoftwareRateLimiterResult.DUPLICATE_WRONG_GUESS:
+                        return VerifyCredentialResponse.credAlreadyTried();
+                    default:
+                        return VerifyCredentialResponse.fromError();
                 }
+                authResult = mSpManager.unlockLskfBasedProtector(
+                        getGateKeeperService(), protectorId, credential, Primary, userId,
+                        /* progressCallback= */ null);
+                response = reportResultToSoftwareRateLimiter(authResult.response, lskfId,
+                        credential);
+            }
+            if (response.isMatched()) {
+                // AegisOS: apply the same credential-verified side effects doVerifyCredentialInner
+                // applies on a match -- unlockKeystore, unlockCeStorage, unlockUser and the
+                // StrongAuth clear. Omitting these is what stranded the owner on the return path:
+                // once the re-armed bouncer was authorized away, nothing else ever unlocked this
+                // user's CE storage, so UserController#finishUserUnlocking bailed at its own
+                // `if (!mInjector.isCeStorageUnlocked(userId)) return false` and the session sat
+                // on FallbackHome -- the direct-boot "starting" placeholder -- indefinitely.
+                // The credential has genuinely matched this user's own primary protector here, so
+                // this is the same authority an ordinary keyguard unlock exercises, not a new one.
+                //
+                // Deliberately invoked OUTSIDE the mSpManager lock, exactly as
+                // doVerifyCredentialInner invokes it: onCredentialVerified makes binder calls out
+                // to StorageManager and ActivityManager, and holding mSpManager across those is a
+                // system_server deadlock shape.
+                //
+                // Deliberately does NOT mirror doVerifyCredentialInner's
+                // sendCredentialsOnUnlockIfRequired: that hands the raw credential to a DPC and to
+                // profiles tied to this lock, which this path has no need for. Least privilege is
+                // preferred over parity here; the accepted consequence is that a profile tied to
+                // the owner's credential stays locked after a return and is challenged on its next
+                // access, rather than being unlocked implicitly.
+                onCredentialVerified(authResult.syntheticPassword,
+                        PasswordMetrics.computeForCredential(credential), userId, Primary);
+            }
+            return response;
+        } finally {
+            // Mirrors doVerifyCredentialInner's own cleanup: the synthetic password must not be
+            // left to linger in the heap until GC, whether or not it was consumed above.
+            if (authResult != null && authResult.syntheticPassword != null) {
+                authResult.syntheticPassword.zeroize();
             }
         }
     }
