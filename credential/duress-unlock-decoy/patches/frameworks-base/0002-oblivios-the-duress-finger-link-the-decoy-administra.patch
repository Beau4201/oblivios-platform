new file mode 100644
index 00000000..387be400
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
@@ -0,0 +1,58 @@
+package com.android.server.locksettings;
+
+/**
+ * ObliviOS: decides what a matched fingerprint does with respect to the Duress Unlock decoy.
+ * Free of Android types so it can be tested on the JVM. See
+ * docs/superpowers/specs/2026-11-04-duress-unlock-finger-design.md in the oblivios-foundation
+ * repository.
+ *
+ * <p>{@link #REJECT} exists so that a finger chosen as the duress finger can never fall through to
+ * the ordinary path: if the decoy cannot be reached, or the match does not come from the
+ * keyguard, the finger is treated as an unrecognised finger and never opens the real session or
+ * authenticates the real user's keystore.
+ */
+final class DecoyFingerPolicy {
+    static final int NO_FINGER = 0;
+    static final int USER_SYSTEM = 0;
+
+    /** Not the duress finger: the ordinary authentication path. */
+    static final int NONE = 0;
+    /** The duress finger at the keyguard with everything in place: switch to the decoy. */
+    static final int ROUTE = 1;
+    /** The duress finger, but it must not be accepted: an unrecognised finger. */
+    static final int REJECT = 2;
+
+    private DecoyFingerPolicy() {}
+
+    /**
+     * Whether {@code id} can be a finger's biometric id. The HAL gives each enrolment a random
+     * signed 32-bit id (lynx 2026110501 enumerated -799218825 and 1944844899), so a negative id is
+     * a valid finger; only {@link #NO_FINGER} is not.
+     */
+    static boolean isUsableFingerId(int id) {
+        return id != NO_FINGER;
+    }
+
+    static int decide(int userId, int storedFingerId, int matchedFingerId, boolean ownerIsKeyguard,
+            boolean decoyRegistered, boolean credentialCached, boolean biometricAllowed) {
+        if (userId != USER_SYSTEM || storedFingerId == NO_FINGER
+                || matchedFingerId != storedFingerId) {
+            return NONE;
+        }
+        if (!ownerIsKeyguard || !decoyRegistered || !credentialCached
+                || !biometricAllowed) {
+            return REJECT;
+        }
+        return ROUTE;
+    }
+
+    /**
+     * Whether the removal of an enrolled fingerprint ends the link to the decoy: only the removal of the
+     * linked finger of the real user. A removed finger whose biometric id the HAL later gives to a new
+     * enrolment would otherwise open the decoy.
+     */
+    static boolean shouldClearOnRemoval(int userId, int storedFingerId, int removedFingerId) {
+        return userId == USER_SYSTEM && storedFingerId != NO_FINGER
+                && removedFingerId == storedFingerId;
+    }
+}
