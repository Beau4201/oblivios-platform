+package com.android.server.locksettings;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+public class DecoyFingerCodecTest {
+    @Test
+    public void stateRoundTrip() {
+        final DecoyFingerCodec.State s =
+                DecoyFingerCodec.parseState(DecoyFingerCodec.formatState(42, new byte[] {1, 2, 3}));
+        assertNotNull(s);
+        assertEquals(42, s.fingerId);
+        assertArrayEquals(new byte[] {1, 2, 3}, s.wrapped);
+    }
+
+    @Test
+    public void stateRejectsOnlyFingerZero() {
+        assertNull(DecoyFingerCodec.parseState(DecoyFingerCodec.formatState(0, new byte[] {1})));
+    }
+
+    // The HAL gives a finger a random signed 32-bit id: lynx 2026110501 enumerated -799218825 and
+    // 1944844899. A negative id is a valid finger.
+    @Test
+    public void stateRoundTripsSignedIds() {
+        for (int id : new int[] {-799218825, 1944844899, -1, Integer.MIN_VALUE, Integer.MAX_VALUE}) {
+            final DecoyFingerCodec.State s = DecoyFingerCodec.parseState(
+                    DecoyFingerCodec.formatState(id, new byte[] {9}));
+            assertNotNull("id " + id, s);
+            assertEquals(id, s.fingerId);
+        }
+    }
+
+    @Test
+    public void stateRejectsFutureVersion() {
+        assertNull(DecoyFingerCodec.parseState("1:42:AQID"));
+    }
+
+    @Test
+    public void stateRejectsBadBase64() {
+        assertNull(DecoyFingerCodec.parseState("0:42:***"));
+    }
+
+    @Test
+    public void stateRejectsMissingParts() {
+        assertNull(DecoyFingerCodec.parseState("0:42"));
+        assertNull(DecoyFingerCodec.parseState("0"));
+        assertNull(DecoyFingerCodec.parseState(""));
+        assertNull(DecoyFingerCodec.parseState(null));
+    }
+
+    @Test
+    public void stateRejectsANonNumericId() {
+        assertNull(DecoyFingerCodec.parseState("0:abc:AQID"));
+    }
+
+    @Test
+    public void credentialRoundTripForAPin() {
+        final DecoyFingerCodec.Credential c = DecoyFingerCodec.decodeCredential(
+                DecoyFingerCodec.encodeCredential(3, "1234".getBytes()));
+        assertNotNull(c);
+        assertEquals(3, c.type);
+        assertArrayEquals("1234".getBytes(), c.credential);
+    }
+
+    @Test
+    public void credentialRoundTripForArbitraryBytes() {
+        final byte[] raw = new byte[128];
+        for (int i = 0; i < raw.length; i++) {
+            raw[i] = (byte) (i * 7 + 0xFF);
+        }
+        raw[0] = 0x00;
+        raw[1] = (byte) 0xFF;
+        final DecoyFingerCodec.Credential c = DecoyFingerCodec.decodeCredential(
+                DecoyFingerCodec.encodeCredential(4, raw));
+        assertNotNull(c);
+        assertEquals(4, c.type);
+        assertArrayEquals(raw, c.credential);
+    }
+
+    @Test
+    public void credentialRejectsAnEmptyBody() {
+        assertNull(DecoyFingerCodec.decodeCredential(new byte[] {3}));
+        assertNull(DecoyFingerCodec.decodeCredential(new byte[0]));
+        assertNull(DecoyFingerCodec.decodeCredential(null));
+    }
+
+    @Test
+    public void credentialRejectsATypeByteOutOfRange() {
+        assertNull(DecoyFingerCodec.decodeCredential(new byte[] {(byte) 0x80, 1}));
+    }
+
+    @Test
+    public void encodeRejectsATypeOutOfRange() {
+        for (int type : new int[] {-1, 128}) {
+            try {
+                DecoyFingerCodec.encodeCredential(type, new byte[] {1});
+                fail("type " + type + " accepted");
+            } catch (IllegalArgumentException expected) {
+                // expected
+            }
+        }
+    }
+}
