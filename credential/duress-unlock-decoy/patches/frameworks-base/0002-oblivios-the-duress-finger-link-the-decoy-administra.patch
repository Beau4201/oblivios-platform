+package com.android.server.locksettings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class DecoyFingerPolicyTest {
+    private static final int DURESS = 42;
+
+    private static int decide(int user, int stored, int matched, boolean keyguard,
+            boolean registered, boolean cached, boolean biometricOk) {
+        return DecoyFingerPolicy.decide(user, stored, matched, keyguard, registered, cached,
+                biometricOk);
+    }
+
+    @Test
+    public void duressFingerAtKeyguardRoutes() {
+        assertEquals(DecoyFingerPolicy.ROUTE, decide(0, DURESS, DURESS, true, true, true, true));
+    }
+
+    @Test
+    public void otherFingerIsOrdinary() {
+        assertEquals(DecoyFingerPolicy.NONE, decide(0, DURESS, 7, true, true, true, true));
+    }
+
+    @Test
+    public void noStoredFingerIsOrdinaryEvenForIdZero() {
+        assertEquals(DecoyFingerPolicy.NONE, decide(0, 0, 0, true, true, true, true));
+    }
+
+    @Test
+    public void otherUserIsOrdinary() {
+        assertEquals(DecoyFingerPolicy.NONE, decide(10, DURESS, DURESS, true, true, true, true));
+    }
+
+    @Test
+    public void duressFingerOutsideKeyguardIsRejected() {
+        assertEquals(DecoyFingerPolicy.REJECT,
+                decide(0, DURESS, DURESS, false, true, true, true));
+    }
+
+    @Test
+    public void duressFingerWithoutDecoyIsRejected() {
+        assertEquals(DecoyFingerPolicy.REJECT,
+                decide(0, DURESS, DURESS, true, false, true, true));
+    }
+
+    @Test
+    public void duressFingerWithoutCachedCredentialIsRejected() {
+        assertEquals(DecoyFingerPolicy.REJECT,
+                decide(0, DURESS, DURESS, true, true, false, true));
+    }
+
+    @Test
+    public void duressFingerWhileBiometricIsNotAllowedIsRejected() {
+        assertEquals(DecoyFingerPolicy.REJECT,
+                decide(0, DURESS, DURESS, true, true, true, false));
+    }
+
+    @Test
+    public void aRefusedDuressFingerNeverFallsThroughToTheOrdinaryPath() {
+        // The anti-goal: a refused duress finger must not open the real session.
+        for (int mask = 0; mask < 16; mask++) {
+            final boolean keyguard = (mask & 1) != 0;
+            final boolean registered = (mask & 2) != 0;
+            final boolean cached = (mask & 4) != 0;
+            final boolean biometricOk = (mask & 8) != 0;
+            final int d = decide(0, DURESS, DURESS, keyguard, registered, cached, biometricOk);
+            if (keyguard && registered && cached && biometricOk) {
+                assertEquals(DecoyFingerPolicy.ROUTE, d);
+            } else {
+                assertEquals(DecoyFingerPolicy.REJECT, d);
+            }
+        }
+    }
+
+    @Test
+    public void removingTheDuressFingerClearsTheLink() {
+        assertTrue(DecoyFingerPolicy.shouldClearOnRemoval(0, DURESS, DURESS));
+    }
+
+    @Test
+    public void removingAnotherFingerKeepsTheLink() {
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(0, DURESS, 7));
+    }
+
+    @Test
+    public void removalWithNoLinkClearsNothing() {
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(0, 0, 0));
+    }
+
+    @Test
+    public void removalOfAnotherUsersFingerKeepsTheLink() {
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(10, DURESS, DURESS));
+    }
+
+    @Test
+    public void everyNonZeroIdIsUsable() {
+        assertFalse(DecoyFingerPolicy.isUsableFingerId(0));
+        for (int id : new int[] {-799218825, 1944844899, -1, 1, Integer.MIN_VALUE, Integer.MAX_VALUE}) {
+            assertTrue("id " + id, DecoyFingerPolicy.isUsableFingerId(id));
+        }
+    }
+
+    @Test
+    public void negativeDuressFingerRoutesAndOnlyItsRemovalClearsTheLink() {
+        final int negative = -799218825;
+        assertEquals(DecoyFingerPolicy.ROUTE,
+                decide(0, negative, negative, true, true, true, true));
+        assertEquals(DecoyFingerPolicy.NONE,
+                decide(0, negative, 1944844899, true, true, true, true));
+        assertTrue(DecoyFingerPolicy.shouldClearOnRemoval(0, negative, negative));
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(0, negative, 1944844899));
+    }
+}
