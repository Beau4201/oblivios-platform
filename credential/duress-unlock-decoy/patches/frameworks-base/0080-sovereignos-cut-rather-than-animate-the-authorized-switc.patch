From 28c1dbb64bf819df1b7b2ee9b5196bf6b763a7ad Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 16 Sep 2026 21:15:35 +0200
Subject: [PATCH 82/89] sovereignos: cut rather than animate the authorized-switch
 dismissal

The proactive dismiss added for the authorized switch removed the need
for a user gesture but not the swipe itself: the owner reported the
device now swipes up by itself after the decoy PIN instead of landing on
the home screen the way an ordinary unlock does. The earlier claim that
this landed with "zero swipe" rested on logcat showing no gesture was
required; it never established that no swipe was rendered.

Confirmed on hardware for the flashed candidate, from the device's own
log during a real decoy switch:

  KeyguardViewMediator: keyguardGoingAway requested for userId: 10
  KeyguardViewMediator: queue processing message: START_KEYGUARD_EXIT_ANIM

The first line sits inside the branch taken only when the WM-state
refactor is off, and the exit-anim callback only arrives after a real
ActivityTaskManagerService#keyguardGoingAway -- so the flags argument
built in mKeyguardGoingAwayRunnable is live on this build, and that exit
animation is the swipe.

Adds KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS for that one
dismissal, the same flag stock AOSP already uses to make the keyguard cut
instead of animate. The keyguard still covers the whole transition, so
nothing of the outgoing user's screen is exposed; it simply stops
animating itself away once the incoming user's home is behind it. The
flag is consumed on use and cleared on an intervening switch, and it
gates animation only -- never whether a dismissal is permitted.

This addresses the rendered window animation. Whether SystemUI's own
lockscreen exit contributes further visible motion is not settled by this
change and needs a real hardware trial to judge.
---
 .../keyguard/KeyguardViewMediator.java        | 40 +++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index b8f814be4aa6..c596f6a8ce46 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -495,6 +495,30 @@ public class KeyguardViewMediator implements CoreStartable,
 
     private final Object mDismissToken = new Object();
 
+    /**
+     * SovereignOS: set when handleUserSwitchComplete's authorized branch is the thing that requested
+     * the upcoming keyguard dismissal, so mKeyguardGoingAwayRunnable can suppress the unlock
+     * window animation for it (see KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS there).
+     *
+     * Without this the keyguard, which is necessarily still showing across the switch (hiding it
+     * any earlier would expose the outgoing user's own screen -- switchToUserSilently suppresses
+     * the UserSwitchingDialog, so nothing covers the transition), animates itself away once the
+     * incoming user's home is behind it. That reads on screen as the lock screen swiping itself
+     * up, which an ordinary same-user unlock never does, so it is a tell in exactly the situation
+     * this feature exists for. Cutting instead of animating is the closest achievable match.
+     *
+     * Read and written only on the mHandler/mediator thread (handleUserSwitchComplete,
+     * handleBeforeUserSwitching and handleHide are all dispatched from it), and cleared on an
+     * intervening switch alongside the mDismissToken callbacks it belongs to.
+     *
+     * It is set immediately before a 0ms-delayed dismiss on that same thread, so in practice the
+     * next going-away is that dismiss. It is not proven impossible for some other unlock to reach
+     * mKeyguardGoingAwayRunnable first and consume it; the consequence if that ever happened is
+     * one unlock rendered without its window animation, which is cosmetic and carries no
+     * authorization -- the flag gates animation only, never whether a dismissal is permitted.
+     */
+    private boolean mAuthorizedSwitchDismissPending;
+
     // last known state of the cellular connection
     private final String mPhoneState = TelephonyManager.EXTRA_STATE_IDLE;
 
@@ -698,6 +722,9 @@ public class KeyguardViewMediator implements CoreStartable,
         Log.d(TAG, String.format("onBeforeUserSwitching %d", userId));
         synchronized (KeyguardViewMediator.this) {
             mHandler.removeCallbacksAndMessages(mDismissToken);
+            // SovereignOS: cancelled alongside the dismissal it belongs to, so a superseded switch
+            // cannot carry its animation suppression into an unrelated later unlock.
+            mAuthorizedSwitchDismissPending = false;
             mHandler.removeMessages(START_KEYGUARD_EXIT_ANIM);
             mHandler.removeMessages(DISMISS);
             mHandler.removeMessages(HIDE);
@@ -813,6 +840,12 @@ public class KeyguardViewMediator implements CoreStartable,
                     // unauthorized branch's already is (see removeCallbacksAndMessages(
                     // mDismissToken) above) if an intervening switch supersedes it before this
                     // runs.
+                    //
+                    // Marked so mKeyguardGoingAwayRunnable suppresses the unlock window animation
+                    // for this specific dismissal: the keyguard has been showing continuously
+                    // across the switch, so animating it away here renders as the lock screen
+                    // swiping itself up -- see mAuthorizedSwitchDismissPending.
+                    mAuthorizedSwitchDismissPending = true;
                     mHandler.postDelayed(
                             () -> dismiss(null /* callback */, null /* message */), mDismissToken,
                             0);
@@ -3367,6 +3400,13 @@ public class KeyguardViewMediator implements CoreStartable,
                     || mWakeAndUnlocking && !mWallpaperSupportsAmbientMode) {
                 flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
             }
+            // SovereignOS: an authorized-switch dismissal cuts rather than animates. The flag is
+            // consumed here so it applies to exactly one going-away, matching the single-use
+            // authorization that requested it. See mAuthorizedSwitchDismissPending.
+            if (mAuthorizedSwitchDismissPending) {
+                mAuthorizedSwitchDismissPending = false;
+                flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
+            }
             if (mKeyguardViewControllerLazy.get().isGoingToNotificationShade()
                     || mWakeAndUnlocking && mWallpaperSupportsAmbientMode) {
                 // When the wallpaper supports ambient mode, the scrim isn't fully opaque during
