@@ -16,6 +16,8 @@
 
 package com.android.server.locksettings;
 
+import static android.Manifest.permission.ACCESS_KEYGUARD_SECURE_STORAGE;
+
 import static com.android.internal.widget.LockPatternUtils.StrongAuthTracker.STRONG_AUTH_REQUIRED_AFTER_USER_LOCKDOWN;
 
 import android.app.ActivityManager;
@@ -60,17 +62,19 @@ class LockSettingsShellCommand extends ShellCommand {
     private final Context mContext;
     private final int mCallingPid;
     private final int mCallingUid;
+    private final LockSettingsStorage mLockSettingsStorage;
 
     private String mOld = "";
     private String mNew = "";
     private boolean mCaptureWeaverOps;
 
     LockSettingsShellCommand(LockPatternUtils lockPatternUtils, Context context, int callingPid,
-            int callingUid) {
+            int callingUid, LockSettingsStorage lockSettingsStorage) {
         mLockPatternUtils = lockPatternUtils;
         mCallingPid = callingPid;
         mCallingUid = callingUid;
         mContext = context;
+        mLockSettingsStorage = lockSettingsStorage;
     }
 
     @Override
@@ -91,6 +95,10 @@ class LockSettingsShellCommand extends ShellCommand {
             return handleClearDecoyProfile();
         }
 
+        if (cmd.equals("check-credential-routing-status")) {
+            return handleCheckCredentialRoutingStatus();
+        }
+
         if (cmd.equals("check-non-ce-storage-keys")) {
             return handleCheckNonCeStorageKeys();
         }
@@ -572,6 +580,34 @@ class LockSettingsShellCommand extends ShellCommand {
         return 0;
     }
 
+    /**
+     * Read-only diagnostic: describes the most recent seamless-switch fallback (if any), so the
+     * real owner can find out afterwards that a routing attempt fell back to the pre-seamless
+     * behavior. Unlike set-decoy-profile/clear-decoy-profile, this reads state rather than
+     * changing it, so it takes no owner-credential argument and must not prompt for one -- but it
+     * still enforces the same permission those commands are ultimately gated on
+     * (ACCESS_KEYGUARD_SECURE_STORAGE, matching LockSettingsService#checkReadPermission's own
+     * check), since this is otherwise the same class of privileged, system-only read.
+     */
+    private int handleCheckCredentialRoutingStatus() {
+        for (;;) {
+            String opt = getNextOption();
+            if (opt == null) {
+                break;
+            }
+            getErrPrintWriter().println("unknown option " + opt);
+            return -1;
+        }
+        if (getRemainingArgsCount() != 0) {
+            getErrPrintWriter().println("unknown arg: " + getNextArg());
+            return -1;
+        }
+
+        mContext.enforceCallingOrSelfPermission(ACCESS_KEYGUARD_SECURE_STORAGE, "LockSettingsRead");
+        getOutPrintWriter().println(DecoyRoutingFailureMarker.describe(mLockSettingsStorage));
+        return 0;
+    }
+
