From 9b8bc2db4600525f1482cdcfbc0d799a05cfc170 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 6 Sep 2026 18:59:19 +0200
Subject: [PATCH 36/85] aegisos: use owner's default-avatar color in
 SettingsLib.Utils#getUserIcon

Same defect as UserSettings#assignDefaultPhoto() and SystemUI's
UserIconProvider, present a third time in this shared helper -- used by
several real Settings screens (Running services, Battery usage, Storage,
About phone) that render a user's avatar independently of whether that
user's own Settings > Users row has ever assigned and persisted a
default photo first. Without this fix, whichever of these screens a
decoy session happens to visit first could still show the wrong,
identity-revealing color even with the other two call sites fixed.

Route the color computation through isMainForUiDisplay, matching the
established pattern; the icon's real persisted-photo lookup (user.iconPath
!= null, um.getUserIcon()) is untouched.
---
 .../SettingsLib/src/com/android/settingslib/Utils.java   | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/packages/SettingsLib/src/com/android/settingslib/Utils.java b/packages/SettingsLib/src/com/android/settingslib/Utils.java
index 65ab1b3d3403..da5acba0b203 100644
--- a/packages/SettingsLib/src/com/android/settingslib/Utils.java
+++ b/packages/SettingsLib/src/com/android/settingslib/Utils.java
@@ -211,10 +211,17 @@ public class Utils {
                 return new UserIconDrawable(iconSize).setIcon(icon).bake();
             }
         }
+        // The default icon's color is picked from a fixed palette by userId, so an AegisOS
+        // Duress Unlock decoy's own arbitrary real userId would otherwise produce a different
+        // color than what a genuine single, fresh-out-of-box owner (always userId 0) shows for
+        // the same "no custom photo yet" case -- reachable from this shared helper's own several
+        // real callers (Settings' Running services, Battery usage, Storage, About phone) whenever
+        // any of them renders before the decoy's own Settings > Users row ever has.
+        int colorSourceUserId = um.isMainForUiDisplay(user.id) ? UserHandle.USER_SYSTEM : user.id;
         return new UserIconDrawable(iconSize)
                 .setIconDrawable(
                         UserIcons.getDefaultUserIcon(
-                                context.getResources(), user.id, /* light= */ false))
+                                context.getResources(), colorSourceUserId, /* light= */ false))
                 .bake();
     }
 
