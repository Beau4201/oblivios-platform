From 58f223c29fa8d5d72ebaeb005f6026478ca3736a Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Mon, 7 Sep 2026 17:58:26 +0200
Subject: [PATCH 42/89] test: force user switcher setting on for pre-unlock
 concealment tests

Without this, the tests observed a false baseline for reasons unrelated
to decoy/lock state (this build's config_showUserSwitcherByDefault
resolves to false, and USER_SWITCHER_ENABLED is unset on a fresh
instrumented-test device), so they could not actually distinguish stock
behavior from the concealment gate.
---
 .../server/pm/UserManagerServiceTest.java     | 34 +++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java b/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
index 449527cc413f..cbd9075a86a0 100644
--- a/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
+++ b/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
@@ -34,6 +34,7 @@ import android.os.Parcelable;
 import android.os.UserHandle;
 import android.os.UserManager;
 import android.platform.test.annotations.Postsubmit;
+import android.provider.Settings;
 import android.util.AtomicFile;
 
 import androidx.test.InstrumentationRegistry;
@@ -66,6 +67,11 @@ public class UserManagerServiceTest {
     private UserManagerService mUserManagerService;
     // AegisOS: only non-null once a test calls setKeyguardLocked(); torn down unconditionally.
     private WindowManagerInternal mMockWindowManagerInternal;
+    // AegisOS: this device's real USER_SWITCHER_ENABLED value before a test overrides it via
+    // forceUserSwitcherSettingEnabled(), restored unconditionally in teardown. Null means the
+    // setting was unset (no row in Settings.Global) rather than explicitly 0.
+    private String mOriginalUserSwitcherEnabled;
+    private boolean mUserSwitcherSettingOverridden;
 
     @Before
     public void setup() throws Exception {
@@ -96,6 +102,13 @@ public class UserManagerServiceTest {
         // regardless of whether this test installed one, so it never leaks into another test.
         LocalServices.removeServiceForTest(WindowManagerInternal.class);
         mMockWindowManagerInternal = null;
+        // AegisOS: restore this real device's actual global setting, regardless of whether this
+        // test overrode it, so no test leaves permanent state behind on the real device.
+        if (mUserSwitcherSettingOverridden) {
+            Settings.Global.putString(mContext.getContentResolver(),
+                    Settings.Global.USER_SWITCHER_ENABLED, mOriginalUserSwitcherEnabled);
+            mUserSwitcherSettingOverridden = false;
+        }
     }
 
     @Test
@@ -217,8 +230,17 @@ public class UserManagerServiceTest {
 
     // AegisOS: pre-unlock concealment (isUserSwitcherEnabled must not advertise a second user
     // while the device is locked, but only when a decoy actually exists on the device).
+    //
+    // These tests force USER_SWITCHER_ENABLED on so the assertions below actually discriminate
+    // this code path: on a stock instrumented-test device this setting is otherwise unset, and
+    // this build's own config_showUserSwitcherByDefault resolves to false for it, which would
+    // make isUserSwitcherEnabled() return false regardless of decoy/lock state -- a test that
+    // could pass identically whether or not the concealment code exists proves nothing. Forcing
+    // the setting on establishes a known, deterministic "true" baseline so the decoy+lock gate is
+    // the only thing that can flip the result to false.
     @Test
     public void testIsUserSwitcherEnabled_lockedDeviceWithDecoy_returnsFalse() {
+        forceUserSwitcherSettingEnabled();
         addDecoyUser();
         setKeyguardLocked(true);
 
@@ -227,6 +249,7 @@ public class UserManagerServiceTest {
 
     @Test
     public void testIsUserSwitcherEnabled_unlockedDeviceWithDecoy_returnsRealValue() {
+        forceUserSwitcherSettingEnabled();
         addDecoyUser();
         setKeyguardLocked(false);
 
@@ -235,6 +258,7 @@ public class UserManagerServiceTest {
 
     @Test
     public void testIsUserSwitcherEnabled_lockedDeviceWithoutDecoy_returnsRealValue() {
+        forceUserSwitcherSettingEnabled();
         setKeyguardLocked(true);
 
         assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isTrue();
@@ -254,6 +278,16 @@ public class UserManagerServiceTest {
         when(mMockWindowManagerInternal.isKeyguardShowing()).thenReturn(locked);
     }
 
+    private void forceUserSwitcherSettingEnabled() {
+        if (!mUserSwitcherSettingOverridden) {
+            mOriginalUserSwitcherEnabled = Settings.Global.getString(mContext.getContentResolver(),
+                    Settings.Global.USER_SWITCHER_ENABLED);
+            mUserSwitcherSettingOverridden = true;
+        }
+        Settings.Global.putInt(mContext.getContentResolver(),
+                Settings.Global.USER_SWITCHER_ENABLED, 1);
+    }
+
     private static String runShellCommand(String cmd) throws Exception {
         return UiDevice.getInstance(InstrumentationRegistry.getInstrumentation())
                 .executeShellCommand(cmd);
-- 
