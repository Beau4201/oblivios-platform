From d6eba7f18b11bcfc74a20328471208e04cc6b8d1 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 17:34:45 +0100
Subject: [PATCH] oblivios: copy the owner's night mode to the decoy so the
 switch does not change the display configuration

---
 .../server/locksettings/DecoySettingsMirror.java      |  6 ++++++
 .../server/locksettings/DecoySettingsMirrorTest.java  | 11 +++++++++++
 2 files changed, 17 insertions(+)

diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
index 14930400..74c7f477 100644
--- a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -40,6 +40,12 @@ final class DecoySettingsMirror {
         "lock_screen_allow_private_notifications",
         "lock_screen_show_only_unseen_notifications",
         "sysui_qs_tiles",
+        // Measured on lynx 2026-11-13: the owner had dark mode and the decoy none, so the switch changed the
+        // display's CONFIG_UI_MODE (transition snapshot, relaunch of the launcher).
+        "ui_night_mode",
+        "ui_night_mode_custom_type",
+        "dark_theme_custom_start_time",
+        "dark_theme_custom_end_time",
     };
 
     interface Store {
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
index b7ecd1b4..18feba21 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -77,6 +77,17 @@ public class DecoySettingsMirrorTest {
         assertTrue(system.contains("accelerometer_rotation"));
     }
 
+    @Test
+    public void listCoversTheNightModeThatChangesTheConfigurationAtTheSwitch() {
+        // lynx 2026-11-13: the owner had ui_night_mode=2 and the decoy none, so the switch changed
+        // CONFIG_UI_MODE (a display configuration change under a transition snapshot, 17:08:42.754).
+        List<String> secure = java.util.Arrays.asList(DecoySettingsMirror.SECURE_KEYS);
+        assertTrue(secure.contains("ui_night_mode"));
+        assertTrue(secure.contains("ui_night_mode_custom_type"));
+        assertTrue(secure.contains("dark_theme_custom_start_time"));
+        assertTrue(secure.contains("dark_theme_custom_end_time"));
+    }
+
     @Test
     public void skipsAKeyThatIsAbsentAndLeavesTheDecoyValue() {
         FakeStore s = ownerWithEveryKey();
-- 
2.47.3

