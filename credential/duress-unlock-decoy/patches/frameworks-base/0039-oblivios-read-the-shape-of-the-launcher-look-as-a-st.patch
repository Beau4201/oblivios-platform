From c6cfd25c8387dcdc637e7f9143e86b3c14ba3355 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sat, 14 Nov 2026 22:39:40 +0100
Subject: [PATCH 39/45] oblivios: read the shape of the launcher look as a
 string, gate its warnings to debuggable builds and read the owner's look off
 the lock settings handler

---
 .../locksettings/DecoyLauncherLook.java       | 44 ++++++++++---------
 .../locksettings/DecoyProfileHelper.java      |  9 ++--
 .../locksettings/DecoySettingsMirror.java     | 25 +++++++++++
 .../locksettings/DecoySettingsMirrorTest.java | 24 ++++++++++
 4 files changed, 79 insertions(+), 23 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyLauncherLook.java b/services/core/java/com/android/server/locksettings/DecoyLauncherLook.java
index c6766677..f3431d2c 100644
--- a/services/core/java/com/android/server/locksettings/DecoyLauncherLook.java
+++ b/services/core/java/com/android/server/locksettings/DecoyLauncherLook.java
@@ -5,11 +5,10 @@ import android.content.ContentValues;
 import android.content.Context;
 import android.database.Cursor;
 import android.net.Uri;
+import android.os.Build;
 import android.os.UserHandle;
 import android.util.Slog;
 
-import java.util.Objects;
-
 /**
  * ObliviOS: the look of a user's Launcher3 home (themed icons, icon shape, hidden labels), read and
  * written through the launcher's own grid control provider, which accepts a caller that holds
@@ -48,7 +47,10 @@ final class DecoyLauncherLook {
             try (Cursor c = cr.query(Uri.parse(AUTHORITY + "/shape_options"), null, null, null,
                     null)) {
                 while (c != null && c.moveToNext()) {
-                    if (c.getInt(c.getColumnIndexOrThrow("is_default")) != 0) {
+                    // The launcher puts a Boolean in a MatrixCursor; across the binder it arrives as
+                    // the string "true", and getInt of that string is 0 (a row would never match).
+                    final String isDefault = c.getString(c.getColumnIndexOrThrow("is_default"));
+                    if ("true".equalsIgnoreCase(isDefault) || "1".equals(isDefault)) {
                         shape = c.getString(c.getColumnIndexOrThrow("shape_key"));
                         break;
                     }
@@ -59,11 +61,21 @@ final class DecoyLauncherLook {
             }
             return new DecoyLauncherLook(themed, hidden, shape);
         } catch (RuntimeException e) {
-            Slog.w(TAG, "Could not read the launcher look of user " + userId, e);
+            warn("Could not read the launcher look of user " + userId, e);
             return null;
         }
     }
 
+    /**
+     * Debuggable builds only: a warning that exists only for the decoy would show on a user build
+     * that a decoy is set up (the same reason as the stage logs of the window manager).
+     */
+    private static void warn(String message, RuntimeException e) {
+        if (Build.IS_DEBUGGABLE) {
+            Slog.w(TAG, message, e);
+        }
+    }
+
     /**
      * Writes this look to {@code userId}'s launcher, every part that differs from what the launcher
      * reports. Each write is a binder call into the launcher process of that user, so a look that
@@ -72,20 +84,23 @@ final class DecoyLauncherLook {
     void applyTo(Context context, int userId) {
         try {
             final ContentResolver cr = resolverOf(context, userId);
-            final DecoyLauncherLook current = read(context, userId);
-            if (current == null || current.themedIcons != themedIcons) {
+            final DecoyLauncherLook c = read(context, userId);
+            final int parts = DecoySettingsMirror.launcherLookParts(c != null,
+                    c != null && c.themedIcons, c != null && c.labelsHidden,
+                    c == null ? "" : c.shapeKey, themedIcons, labelsHidden, shapeKey);
+            if ((parts & DecoySettingsMirror.LOOK_THEME) != 0) {
                 writeBoolean(cr, "/icon_themed", themedIcons);
             }
-            if (current == null || current.labelsHidden != labelsHidden) {
+            if ((parts & DecoySettingsMirror.LOOK_LABELS) != 0) {
                 writeBoolean(cr, "/set_workspace_items_label_hidden", labelsHidden);
             }
-            if (!shapeKey.isEmpty() && (current == null || !shapeKey.equals(current.shapeKey))) {
+            if ((parts & DecoySettingsMirror.LOOK_SHAPE) != 0) {
                 final ContentValues v = new ContentValues();
                 v.put("shape_key", shapeKey);
                 cr.update(Uri.parse(AUTHORITY + "/shape"), v, null, null);
             }
         } catch (RuntimeException e) {
-            Slog.w(TAG, "Could not apply the launcher look to user " + userId, e);
+            warn("Could not apply the launcher look to user " + userId, e);
         }
     }
 
@@ -107,15 +122,4 @@ final class DecoyLauncherLook {
         v.put(BOOLEAN_VALUE, value);
         cr.update(Uri.parse(AUTHORITY + path), v, null, null);
     }
-
-    @Override
-    public boolean equals(Object o) {
-        return o instanceof DecoyLauncherLook l && l.themedIcons == themedIcons
-                && l.labelsHidden == labelsHidden && l.shapeKey.equals(shapeKey);
-    }
-
-    @Override
-    public int hashCode() {
-        return Objects.hash(themedIcons, labelsHidden, shapeKey);
-    }
 }
diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 92e51fab..e9255b34 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -170,10 +170,13 @@ class DecoyProfileHelper {
             mirrorOwnerSettingsToDecoy(UserHandle.USER_SYSTEM, decoyUserId);
             mirrorOwnerWallpaperToDecoy(UserHandle.USER_SYSTEM, decoyUserId);
             mirrorOwnerAutoConfirmToDecoy(UserHandle.USER_SYSTEM, decoyUserId);
-            // The owner's launcher is up while the device locks; the decoy's is not, so the look is
-            // only read here and written at the duress unlock (applyOwnerLookToDecoy).
-            mOwnerLook = DecoyLauncherLook.read(context, UserHandle.USER_SYSTEM);
         });
+        // The owner's launcher is up while the device locks; the decoy's is not, so the look is
+        // only read here and written at the duress unlock (applyOwnerLookToDecoy). Three binder
+        // calls into another process: on their own thread, not on the lock settings handler that
+        // also runs the duress switch.
+        new Thread(() -> mOwnerLook = DecoyLauncherLook.read(context, UserHandle.USER_SYSTEM),
+                "DecoyLauncherLookRead").start();
     }
 
     /**
diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
index f9326ab2..de1e862b 100644
--- a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -124,6 +124,31 @@ final class DecoySettingsMirror {
         return owner;
     }
 
+    static final int LOOK_THEME = 1;
+    static final int LOOK_LABELS = 2;
+    static final int LOOK_SHAPE = 4;
+
+    /**
+     * The parts of the owner's launcher look (see DecoyLauncherLook) to write to the decoy: those
+     * that differ from what its launcher reports, or all of them when that is unknown. The shape is
+     * written only when the owner's launcher reported one.
+     */
+    static int launcherLookParts(boolean currentKnown, boolean currentThemed,
+            boolean currentLabelsHidden, String currentShape, boolean themed, boolean labelsHidden,
+            String shape) {
+        int parts = 0;
+        if (!currentKnown || currentThemed != themed) {
+            parts |= LOOK_THEME;
+        }
+        if (!currentKnown || currentLabelsHidden != labelsHidden) {
+            parts |= LOOK_LABELS;
+        }
+        if (!shape.isEmpty() && (!currentKnown || !shape.equals(currentShape))) {
+            parts |= LOOK_SHAPE;
+        }
+        return parts;
+    }
+
     /** Copies every listed key from fromUserId to toUserId; returns the keys that could not be written. */
     static List<String> mirror(Store store, int fromUserId, int toUserId) {
         List<String> failed = new ArrayList<>();
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
index 92ec7b24..291e05ce 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -214,6 +214,30 @@ public class DecoySettingsMirrorTest {
         assertNull(DecoySettingsMirror.autoConfirmTarget(true, true, 6, 6));
     }
 
+    @Test
+    public void launcherLookWritesOnlyWhatDiffers() {
+        final int theme = DecoySettingsMirror.LOOK_THEME;
+        final int labels = DecoySettingsMirror.LOOK_LABELS;
+        final int shape = DecoySettingsMirror.LOOK_SHAPE;
+        // the decoy's launcher as it was found on the phone: nothing set
+        assertEquals(theme | labels | shape,
+                DecoySettingsMirror.launcherLookParts(true, false, false, "circle", true, true,
+                        "square"));
+        // equal look: nothing is written
+        assertEquals(0, DecoySettingsMirror.launcherLookParts(true, true, true, "square", true,
+                true, "square"));
+        // one part differs
+        assertEquals(labels, DecoySettingsMirror.launcherLookParts(true, true, false, "square",
+                true, true, "square"));
+        // the current look could not be read: everything is written
+        assertEquals(theme | labels | shape,
+                DecoySettingsMirror.launcherLookParts(false, false, false, "", true, true,
+                        "square"));
+        // no owner shape reported: the shape is never written
+        assertEquals(theme | labels, DecoySettingsMirror.launcherLookParts(false, false, false,
+                "", true, true, ""));
+    }
+
     @Test
     public void sameUserWritesNothing() {
         FakeStore s = ownerWithEveryKey();
