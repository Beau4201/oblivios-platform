From 2739f964fc821a162914ecfc66d5421eda1fb833 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 30 Aug 2026 18:35:33 +0200
Subject: [PATCH 26/89] sovereignos: fix getUsersForUiDisplay to key off current
 user, not caller

The decoy special-case checked UserHandle.getCallingUserId(), assuming
the caller's own identity reflects whether the decoy is active. That
assumption breaks for SystemUI's floating windows (the QS user
switcher, the power menu): they render under user 0's process
regardless of which user is actually foregrounded, so the check never
applied to them. Confirmed as a real, reproducible identity leak on
physical hardware: the QS footer 'Select user' dialog showed the real
Owner identity while a decoy session was active and unlocked
(mCurrentFocus=Window{... u0 Select user} while mFocusedApp correctly
showed the decoy's own launcher).

Fixed by keying off the device's actual current user instead, via the
existing getCurrentUserId() helper (ActivityManagerInternal-backed,
already used elsewhere in this class). This is a more robust primitive
than a per-call-site fix: it covers any future caller regardless of
which process renders it, rather than requiring every new UI surface
to somehow run in a per-user process to get correct filtering.
---
 .../android/server/pm/UserManagerService.java | 27 ++++++++++---------
 1 file changed, 15 insertions(+), 12 deletions(-)

diff --git a/services/core/java/com/android/server/pm/UserManagerService.java b/services/core/java/com/android/server/pm/UserManagerService.java
index 713392f685f7..d39bfe6d34a6 100644
--- a/services/core/java/com/android/server/pm/UserManagerService.java
+++ b/services/core/java/com/android/server/pm/UserManagerService.java
@@ -1746,27 +1746,30 @@ public class UserManagerService extends IUserManager.Stub {
     }
 
     /**
-     * Like {@link #getUsers(boolean)}, except when the calling user is an SovereignOS Duress
-     * Unlock decoy user, in which case only that user is returned. Every UI surface that
-     * displays "which users exist on this device" (the multi-user switcher, Settings' Storage
-     * screen, the power menu, etc.) must call this instead of {@link #getUsers(boolean)} --
-     * internal, non-display callers (e.g. RealUserQuiescer) must keep calling the real,
-     * unscoped {@link #getUsers(boolean)} directly. See
+     * Like {@link #getUsers(boolean)}, except when the device's actual current (foreground)
+     * user is an SovereignOS Duress Unlock decoy user, in which case only that user is returned.
+     * Every UI surface that displays "which users exist on this device" (the multi-user
+     * switcher, Settings' Storage screen, the power menu, etc.) must call this instead of
+     * {@link #getUsers(boolean)} -- internal, non-display callers (e.g. RealUserQuiescer) must
+     * keep calling the real, unscoped {@link #getUsers(boolean)} directly. Deliberately keys off
+     * the actual current user, not the Binder calling user: SystemUI's own floating windows call
+     * from user 0's process regardless of which user is foregrounded, so a calling-user check
+     * silently never applies this filter for them. See
      * docs/superpowers/specs/2026-08-28-duress-decoy-session-indistinguishability-design.md
      * in the sovereignos-foundation repository.
      */
     @Override
     public @NonNull List<UserInfo> getUsersForUiDisplay(boolean excludeDying) {
         checkCreateUsersPermission("query users for UI display");
-        int callingUserId = UserHandle.getCallingUserId();
-        UserInfo callingUserInfo;
+        int currentUserId = getCurrentUserId();
+        UserInfo currentUserInfo;
         synchronized (mUsersLock) {
-            callingUserInfo = getUserInfoLU(callingUserId);
+            currentUserInfo = getUserInfoLU(currentUserId);
         }
-        if (callingUserInfo != null
-                && UserManager.USER_TYPE_FULL_AEGISOS_DECOY.equals(callingUserInfo.userType)) {
+        if (currentUserInfo != null
+                && UserManager.USER_TYPE_FULL_AEGISOS_DECOY.equals(currentUserInfo.userType)) {
             List<UserInfo> result = new ArrayList<>(1);
-            result.add(callingUserInfo);
+            result.add(currentUserInfo);
             return result;
         }
         return getUsers(excludeDying);
