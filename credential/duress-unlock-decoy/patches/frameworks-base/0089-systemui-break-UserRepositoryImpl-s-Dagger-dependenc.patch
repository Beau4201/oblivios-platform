From e6f6b9363b83d5b44266fb377a648947a61e8907 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Fri, 18 Sep 2026 22:24:19 +0200
Subject: [PATCH 89/90] systemui: break UserRepositoryImpl's Dagger dependency
 cycle

Task 6's own KeyguardRepository injection created a real
Dagger/DependencyCycle: KeyguardRepositoryImpl -> KeyguardRepository ->
UserRepositoryImpl -> UserRepository -> SelectedUserInteractor ->
AssistManager -> Dependency -> back to KeyguardRepositoryImpl. This was
never caught because the component was never actually recompiled after
Task 6 landed (6 weeks of stale incremental Soong cache masked it).

keyguardRepository is only ever read lazily inside the _userSwitcherSettings
flow, never at construction time, so wrapping it in dagger.Lazy defers
resolution past graph construction and breaks the cycle without changing
any runtime behavior.
---
 .../user/data/repository/UserRepositoryImpl.kt         | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
index 9642b1f35450..8700ffa83828 100644
--- a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
+++ b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
@@ -50,6 +50,7 @@ import com.android.systemui.util.settings.GlobalSettings
 import com.android.systemui.util.settings.SettingsProxyExt.observerFlow
 import com.android.systemui.utils.coroutines.flow.conflatedCallbackFlow
 import com.android.systemui.utils.coroutines.flow.flatMapLatestConflated
+import dagger.Lazy
 import java.util.concurrent.atomic.AtomicBoolean
 import javax.inject.Inject
 import kotlinx.coroutines.CoroutineDispatcher
@@ -82,7 +83,12 @@ constructor(
     @Main private val mainDispatcher: CoroutineDispatcher,
     @Background private val backgroundDispatcher: CoroutineDispatcher,
     private val globalSettings: GlobalSettings,
-    private val keyguardRepository: KeyguardRepository,
+    // Lazy: KeyguardRepository's own construction graph transitively depends back on
+    // UserRepository (via SelectedUserInteractor -> AssistManager -> Dependency), so an eager
+    // dependency here creates a real Dagger dependency cycle. This is only ever read lazily
+    // inside the flow below (never at construction time), so deferring resolution to first
+    // use is both safe and sufficient to break the cycle.
+    private val keyguardRepository: Lazy<KeyguardRepository>,
     private val tracker: UserTracker,
     private val devicePolicyManager: DevicePolicyManager,
     private val broadcastDispatcher: BroadcastDispatcher,
@@ -105,7 +111,7 @@ constructor(
                 // of the three Settings.Global keys above ever being written, which would
                 // otherwise leave this StateFlow's cached value stale until an unrelated
                 // settings write happened to refresh it.
-                keyguardRepository.isKeyguardShowing.map { Unit },
+                keyguardRepository.get().isKeyguardShowing.map { Unit },
             )
             .onStart { emit(Unit) } // Forces an initial update.
             .map { getSettings() }
