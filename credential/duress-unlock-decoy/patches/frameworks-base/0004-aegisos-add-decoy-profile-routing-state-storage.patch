From 06d095860c48660bcc1a8c005f6bce52ca095578 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Wed, 26 Aug 2026 19:30:37 +0200
Subject: [PATCH] aegisos: add decoy profile routing state storage

---
 .../locksettings/DecoyProfileState.java       | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 services/core/java/com/android/server/locksettings/DecoyProfileState.java

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileState.java b/services/core/java/com/android/server/locksettings/DecoyProfileState.java
new file mode 100644
index 0000000..b4ab502
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileState.java
@@ -0,0 +1,58 @@
+package com.android.server.locksettings;
+
+import android.annotation.Nullable;
+import android.os.UserHandle;
+import android.util.Slog;
+
+/**
+ * Off/Registered(decoyUserId) routing state for AegisOS's duress-unlock decoy mechanism. See
+ * docs/superpowers/specs/2026-08-15-duress-keyguard-integration-design.md and
+ * docs/superpowers/specs/2026-08-21-duress-decoy-user-switch-design.md in the
+ * aegisos-foundation repository.
+ */
+class DecoyProfileState {
+    private static final String TAG = "DecoyProfileState";
+
+    final int decoyUserId;
+
+    private DecoyProfileState(int decoyUserId) {
+        this.decoyUserId = decoyUserId;
+    }
+
+    static DecoyProfileState create(int decoyUserId) {
+        return new DecoyProfileState(decoyUserId);
+    }
+
+    private static final String LOCK_SETTINGS_STORAGE_KEY = "decoy_profile_state";
+    private static final int LOCK_SETTINGS_STORAGE_USER_ID = UserHandle.USER_SYSTEM;
+    private static final int VERSION = 0;
+
+    void save(LockSettingsStorage lss) {
+        lss.setString(LOCK_SETTINGS_STORAGE_KEY, VERSION + ":" + decoyUserId,
+                LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+
+    @Nullable
+    static DecoyProfileState maybeGet(LockSettingsStorage lss) {
+        String s = lss.getString(LOCK_SETTINGS_STORAGE_KEY, null, LOCK_SETTINGS_STORAGE_USER_ID);
+        if (s == null) {
+            return null;
+        }
+        try {
+            String[] parts = s.split(":", 2);
+            int version = Integer.parseInt(parts[0]);
+            if (parts.length != 2 || version > VERSION) {
+                Slog.e(TAG, "Unrecognized decoy profile state version, treating as Off");
+                return null;
+            }
+            return new DecoyProfileState(Integer.parseInt(parts[1]));
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "Corrupt decoy profile state, treating as Off", e);
+            return null;
+        }
+    }
+
+    static void delete(LockSettingsStorage lss) {
+        lss.removeKey(LOCK_SETTINGS_STORAGE_KEY, LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+}
