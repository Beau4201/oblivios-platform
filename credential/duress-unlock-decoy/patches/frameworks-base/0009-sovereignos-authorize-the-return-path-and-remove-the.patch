             // holds a still-valid, not-yet-consumed authorization for exactly this purpose;
             // every other secure-user switch (including any switch this authorization was never
             // minted for) is unaffected and still re-arms the bouncer as before.
-            if (mLockPatternUtils.isSecure(userId)
-                    && !mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId)) {
-                // We are calling dismiss with a delay as there are race conditions in some
-                // scenarios caused by async layout listeners
-                mHandler.postDelayed(
-                        () -> dismiss(null /* callback */, null /* message */), mDismissToken, 500);
+            if (mLockPatternUtils.isSecure(userId)) {
+                // SovereignOS: the grant was already redeemed in handleBeforeUserSwitching, which had
+                // to know whether this switch was authorized before it could decide to leave the
+                // bouncer up. This reads that decision rather than redeeming a second time.
+                if (!mAuthorizedSwitchDismissPending) {
+                    // We are calling dismiss with a delay as there are race conditions in some
+                    // scenarios caused by async layout listeners
+                    mHandler.postDelayed(
+                            () -> dismiss(null /* callback */, null /* message */), mDismissToken,
+                            500);
+                } else {
+                    // SovereignOS: the automatic re-arm above was just skipped because this switch
+                    // was authorized, but nothing else drives the keyguard forward from here --
+                    // left alone, the device sits on a swipeable lock screen until the user's own
+                    // next gesture happens to request a bouncer, which is the one place the third
+                    // (active-dismiss) grant from the same mint gets redeemed (see
+                    // UserController#consumeDecoySwitchAuthorizationForActiveDismiss).
+                    // Proactively requesting the same dismiss here redeems that still-outstanding
+                    // grant immediately instead of leaving it to a gesture: it goes through the
+                    // identical showNextSecurityScreenOrFinish() chokepoint trust-agent and
+                    // biometric dismissals already use, gated on the same single-use,
+                    // credential-verified authorization this exact switch already earned -- not a
+                    // new dismiss authority, just triggering the existing one proactively.
+                    // Deliberately posted with a 0ms delay, unlike the unauthorized branch
+                    // above's 500ms: that delay exists to let a *freshly shown* bouncer's own
+                    // async layout listeners settle before it is interacted with (stock AOSP
+                    // behavior, predating this patch) -- this branch never shows a bouncer at
+                    // all, so that race does not apply, and a real same-user unlock (PIN typed
+                    // into an already-showing bouncer) is not held to any such delay either.
+                    // Still routed through postDelayed (not a bare post()), and still tagged
+                    // with mDismissToken, so this callback is cancellable the same way the
+                    // unauthorized branch's already is (see removeCallbacksAndMessages(
+                    // mDismissToken) above) if an intervening switch supersedes it before this
+                    // runs.
+                    //
+                    // The mark set in handleBeforeUserSwitching stays pending past this point:
+                    // it is consumed where the animation that would otherwise render is actually
+                    // selected, in KeyguardUnlockAnimationController#playCannedUnlockAnimation.
+                    mHandler.postDelayed(
+                            () -> dismiss(null /* callback */, null /* message */), mDismissToken,
+                            0);
+                }
             }
         }
         // We need to adjust the status bar in case there are race conditions where the
@@ -3338,6 +3421,19 @@ public class KeyguardViewMediator implements CoreStartable,
                     || mWakeAndUnlocking && !mWallpaperSupportsAmbientMode) {
                 flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
