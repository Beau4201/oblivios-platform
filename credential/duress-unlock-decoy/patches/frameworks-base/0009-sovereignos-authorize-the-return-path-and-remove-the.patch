         Log.d(TAG, String.format("onBeforeUserSwitching %d", userId));
         synchronized (KeyguardViewMediator.this) {
             mHandler.removeCallbacksAndMessages(mDismissToken);
+            // SovereignOS: the bouncer-skip grant is redeemed here, the earliest SystemUI-side point
+            // in the switch, rather than at handleUserSwitchComplete as it used to be, because
+            // the decision it gates has to be made now: whether the bouncer stays up across the
+            // switch (see the resetStateLocked call below). Assigned rather than merely cleared,
+            // so a switch that earns no grant also resets any stale mark from a superseded one.
+            mAuthorizedSwitchDismissPending = mLockPatternUtils.isSecure(userId)
+                    && mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
             mHandler.removeMessages(START_KEYGUARD_EXIT_ANIM);
             mHandler.removeMessages(DISMISS);
             mHandler.removeMessages(HIDE);
@@ -720,7 +750,24 @@ public class KeyguardViewMediator implements CoreStartable,
                     doKeyguardLocked(null);
                 }
             } else {
-                resetStateLocked();
+                // SovereignOS: on an authorized switch the bouncer is deliberately left up across the
+                // switch instead of being collapsed into the incoming user's lock screen.
+                //
+                // Hiding it drops primaryBouncerShowing, which
+                // FromPrimaryBouncerTransitionInteractor#listenForPrimaryBouncerNotShowing turns
+                // into a PRIMARY_BOUNCER -> LOCKSCREEN transition; the dismissal that follows then
+                // has to run a second, LOCKSCREEN -> GONE transition to get rid of what was just
+                // shown. Confirmed on hardware: 471ms of lock screen animating in, a pause, then
+                // 416ms of it animating away -- which is what reads as the device swiping itself
+                // up. An ordinary unlock goes PRIMARY_BOUNCER -> GONE in one step and never
+                // presents a lock screen at all, which is exactly what leaving the bouncer up
+                // reproduces here.
+                //
+                // The bouncer covers the screen at least as completely as the lock screen it
+                // replaces, so nothing of the outgoing user's session is exposed by this; it is
+                // also the surface the credential was just typed into, so it is what the user is
+                // already looking at.
+                resetStateLocked(/* hideBouncer= */ !mAuthorizedSwitchDismissPending);
             }
             resultCallback.run();
         }
