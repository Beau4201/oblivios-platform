@@ -2882,9 +2887,18 @@ public class UserControllerTest {
      * user-switch UI so the keyguard block in {@code continueStartUserInternal} is reachable at
      * all, then drives a real foreground {@code startUser()} call and waits for its handler work
      * to finish.
+     *
+     * <p>Also stubs {@code ActivityManagerInternal} as a {@code LocalServices}-registered mock:
+     * {@code startUserInternal}'s pre-existing (pre-dating this task, see patch {@code 0011})
+     * {@code LocalServices.getService(ActivityManagerInternal.class).unquiesceUserApps(userId)}
+     * call is unconditional for every genuine foreground switch and otherwise NPEs in this
+     * harness, since nothing else in this test class registers that service. Torn down
+     * unconditionally in {@code tearDown()} so it never leaks into another test.
      */
     private void startForegroundUser(@UserIdInt int userId) throws Exception {
         setUpUser(userId, DEFAULT_USER_FLAGS);
+        LocalServices.removeServiceForTest(ActivityManagerInternal.class);
+        LocalServices.addService(ActivityManagerInternal.class, mock(ActivityManagerInternal.class));
         mUserController.setInitialConfig(/* userSwitchUiEnabled= */ true,
                 /* maxRunningUsers= */ 3, /* delayUserDataLocking= */ false,
                 /* backgroundUserConsideredDispensableTimeSecs= */ -1,
