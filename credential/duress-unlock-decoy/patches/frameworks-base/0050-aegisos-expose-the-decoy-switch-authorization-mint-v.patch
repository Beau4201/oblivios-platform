From bbe0134976a439337cc84d4c4699d4389264b86a Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Tue, 8 Sep 2026 09:47:22 +0200
Subject: [PATCH] aegisos: expose the decoy switch authorization mint via
 ActivityManagerInternal

---
 core/java/android/app/ActivityManagerInternal.java       | 9 +++++++++
 .../com/android/server/am/ActivityManagerService.java    | 5 +++++
 2 files changed, 14 insertions(+)

diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index f8512e4..7af6dd4 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1506,6 +1506,15 @@ public abstract class ActivityManagerInternal {
      */
     public abstract boolean switchToUserSilently(int targetUserId);
 
+    /**
+     * Authorizes exactly one upcoming foreground switch to {@code targetUserId} to proceed without
+     * forcing the keyguard, for a caller that has just verified that user's own credential. The
+     * authorization is single-use and expires shortly. Returns false, minting nothing, if
+     * {@code targetUserId} is not an existing decoy-type user. See
+     * {@link com.android.server.am.UserController#authorizeDecoySwitchKeyguardSkip}.
+     */
+    public abstract boolean authorizeDecoySwitchKeyguardSkip(int targetUserId);
+
     /**
      * Best-effort freezes userId's app processes and installs a notification-suppression flag
      * for it. Returns whether the notification-suppression flag was installed (freeze failures
diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index a47cad7..4ca6f5c 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -17628,6 +17628,11 @@ public class ActivityManagerService extends IActivityManager.Stub
             return mUserController.switchToUserSilently(targetUserId);
         }
 
+        @Override
+        public boolean authorizeDecoySwitchKeyguardSkip(int targetUserId) {
+            return mUserController.authorizeDecoySwitchKeyguardSkip(targetUserId);
+        }
+
         @Override
         public boolean quiesceUserApps(int userId) {
             mRealUserQuiescer.quiesce(userId);
-- 
2.55.0

