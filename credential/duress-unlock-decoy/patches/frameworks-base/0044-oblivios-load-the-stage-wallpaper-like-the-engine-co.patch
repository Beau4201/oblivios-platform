From 857b41b32669dca1b6778379260fb46a6cfbaf1c Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 04:31:31 +0100
Subject: [PATCH 44/45] oblivios: load the stage wallpaper like the engine,
 cover the whole screen and keep the stage until the incoming home has drawn

---
 .../keyguard/AuthorizedSwitchStage.java       | 38 ++++++++++++++-----
 .../android/server/DecoyWallpaperHold.java    | 16 ++++++++
 .../server/wm/WallpaperController.java        | 14 +++++++
 3 files changed, 58 insertions(+), 10 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
index 8324cc5e..7dcd226c 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -5,8 +5,10 @@ import android.app.WallpaperManager;
 import android.content.Context;
 import android.graphics.Bitmap;
 import android.graphics.Color;
+import android.database.ContentObserver;
 import android.graphics.PixelFormat;
 import android.os.Handler;
+import android.provider.Settings;
 import android.util.Log;
 import android.view.View;
 import android.view.WindowManager;
@@ -30,18 +32,13 @@ import android.widget.ImageView;
  * notification shade, so the pad, the scrim and the rest of the keyguard's exit are drawn over it
  * and the keyguard policy does not hide it while the keyguard is showing. It asks for the
  * wallpaper too, so the window that holds the wallpaper layer is stable (see
- * com.android.server.DecoyWallpaperHold). It fades out after {@link #HOLD_MS}, when the wallpaper
- * layer has been up again for a while, and shows the wallpaper layer and the incoming home. Without
- * a bitmap (not loaded yet, or it failed) the window is empty and transparent and only holds the
- * wallpaper request.
- *
- * <p>shortcut: removed by a timer, not by the first draw of the incoming home; replace the timer by a
- * signal of the window manager when the home's first frame has to come earlier than {@link #HOLD_MS}.
+ * com.android.server.DecoyWallpaperHold). It stays until the window manager reports that\n * the incoming home has drawn (a counter in the secure settings, written by\n * com.android.server.wm.WallpaperController when an activity window becomes the wallpaper target),\n * then fades out over the home; {@link #FALLBACK_MS} ends it when no report comes. The wallpaper\n * layer under it is in a broken state until the home draws (the card), which is why it has to stay\n * that long. Without a bitmap (not loaded yet, or it failed) the window is empty and transparent\n * and only holds the wallpaper request.
  */
 public final class AuthorizedSwitchStage {
     private static final String TAG = "AuthorizedSwitchStage";
-    static final long HOLD_MS = 900L;
+    static final long FALLBACK_MS = 3_000L;
     static final long FADE_MS = 200L;
+    private static final String RELEASE_KEY = "oblivios_stage_release";
 
     private final Context mContext;
     private final Handler mHandler;
@@ -64,8 +61,11 @@ public final class AuthorizedSwitchStage {
         final int userId = ActivityManager.getCurrentUser();
         new Thread(() -> {
             try {
+                // FLAG_SYSTEM and returnDefault, the engine's own call (ImageWallpaper
+                // #loadWallpaperAndDrawFrameInternal). FLAG_LOCK with returnDefault gave the empty
+                // default image: the stage was black (lynx 2026-11-15, 30 fps frames).
                 mBitmap = mContext.getSystemService(WallpaperManager.class).getBitmapAsUser(
-                        userId, true /* hardware */, WallpaperManager.FLAG_LOCK,
+                        userId, true /* hardware */, WallpaperManager.FLAG_SYSTEM,
                         true /* returnDefault */);
             } catch (RuntimeException | OutOfMemoryError e) {
                 Log.w(TAG, "Could not load the wallpaper for the stage", e);
@@ -101,6 +101,11 @@ public final class AuthorizedSwitchStage {
                             | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                     bitmap != null ? PixelFormat.OPAQUE : PixelFormat.TRANSLUCENT);
             lp.privateFlags |= WindowManager.LayoutParams.SYSTEM_FLAG_SHOW_FOR_ALL_USERS;
+            // No insets and no cutout margin: the window covers the whole screen. With the default
+            // inset of the status bar a strip at the top stayed uncovered (lynx 2026-11-15).
+            lp.setFitInsetsTypes(0);
+            lp.layoutInDisplayCutoutMode =
+                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS;
             lp.setTitle("SwitchStage");
             try {
                 mContext.getSystemService(WindowManager.class).addView(view, lp);
@@ -109,10 +114,22 @@ public final class AuthorizedSwitchStage {
                 Log.w(TAG, "Could not add the stage window", e);
                 return;
             }
+            // The window manager writes this counter when the incoming home has drawn.
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(RELEASE_KEY), false, mReleaseObserver);
         }
-        mHandler.postDelayed(mFade, HOLD_MS);
+        // The timer is only the fallback for a release that never comes.
+        mHandler.postDelayed(mFade, FALLBACK_MS);
     }
 
+    private final ContentObserver mReleaseObserver = new ContentObserver(null) {
+        @Override
+        public void onChange(boolean selfChange) {
+            mHandler.removeCallbacks(mFade);
+            mHandler.post(AuthorizedSwitchStage.this::fadeOut);
+        }
+    };
+
     private void fadeOut() {
         if (mView == null) {
             return;
@@ -125,6 +142,7 @@ public final class AuthorizedSwitchStage {
     public void hide() {
         mHandler.removeCallbacks(mFade);
         mHandler.removeCallbacks(mRemove);
+        mContext.getContentResolver().unregisterContentObserver(mReleaseObserver);
         mBitmap = null;
         if (mView == null) {
             return;
diff --git a/services/core/java/com/android/server/DecoyWallpaperHold.java b/services/core/java/com/android/server/DecoyWallpaperHold.java
index e078073f..836ae968 100644
--- a/services/core/java/com/android/server/DecoyWallpaperHold.java
+++ b/services/core/java/com/android/server/DecoyWallpaperHold.java
@@ -27,9 +27,25 @@ public final class DecoyWallpaperHold {
         sActive = true;
     }
 
+    /**
+     * Called once, when the hold ends because the incoming home is the wallpaper target. The
+     * window manager sets it to write a counter that SystemUI's stage watches (see
+     * AuthorizedSwitchStage), the only signal between the two that needs no framework change.
+     */
+    public static void setReleaseSink(Runnable sink) {
+        sReleaseSink = sink;
+    }
+
+    private static volatile Runnable sReleaseSink;
+
     /** The incoming home is the wallpaper target, or the switch is over. */
     public static void end() {
+        final boolean wasActive = sActive;
         sActive = false;
+        final Runnable sink = sReleaseSink;
+        if (wasActive && sink != null) {
+            sink.run();
+        }
     }
 
     public static boolean isActive() {
diff --git a/services/core/java/com/android/server/wm/WallpaperController.java b/services/core/java/com/android/server/wm/WallpaperController.java
index eb1fc33f..18f7ce30 100644
--- a/services/core/java/com/android/server/wm/WallpaperController.java
+++ b/services/core/java/com/android/server/wm/WallpaperController.java
@@ -211,6 +211,20 @@ class WallpaperController {
     WallpaperController(WindowManagerService service, DisplayContent displayContent) {
         mService = service;
         mDisplayContent = displayContent;
+        // ObliviOS: tells SystemUI's stage of an authorized switch that the incoming home has
+        // drawn (see DecoyWallpaperHold). A counter in the owner's secure settings, written off the
+        // window manager lock: apps of the owner can already see a user switch by its broadcasts.
+        com.android.server.DecoyWallpaperHold.setReleaseSink(() ->
+                com.android.internal.os.BackgroundThread.getHandler().post(() -> {
+                    try {
+                        android.provider.Settings.Secure.putIntForUser(
+                                service.mContext.getContentResolver(), "oblivios_stage_release",
+                                (int) (android.os.SystemClock.elapsedRealtime() & 0x3fffffff),
+                                android.os.UserHandle.USER_SYSTEM);
+                    } catch (RuntimeException e) {
+                        // the stage falls back to its own timer
+                    }
+                }));
         Resources resources = service.mContext.getResources();
         mMinWallpaperScale =
                 resources.getFloat(com.android.internal.R.dimen.config_wallpaperMinScale);
-- 
