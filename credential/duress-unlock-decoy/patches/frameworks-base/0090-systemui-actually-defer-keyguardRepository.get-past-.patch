From f3f3c9ebc980b166b0a2d7e0966f65a69df5c6b4 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 20 Sep 2026 13:15:09 +0200
Subject: [PATCH 90/90] systemui: actually defer keyguardRepository.get() past
 construction

The previous fix (Lazy<KeyguardRepository>) only deferred *which*
instance Dagger hands back, not *when* .get() runs. Calling .get()
inline as a merge() argument still executes it synchronously inside
UserRepositoryImpl's own constructor, before Dagger's DoubleCheck
memoizes this singleton -- so the same cycle re-enters at runtime.
Confirmed on real hardware: SystemUI StackOverflowError, boot-loop.

Wrapping the access in flow { emitAll(...) } defers it to when
_userSwitcherSettings' stateIn coroutine actually runs, which is
scheduled (dispatched) rather than synchronous with the constructor
call stack, so it only executes after construction has completed and
Dagger has committed the memoized instance.
---
 .../data/repository/UserRepositoryImpl.kt     | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
index 8700ffa83828..7a0fb5f8c179 100644
--- a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
+++ b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
@@ -62,7 +62,9 @@ import kotlinx.coroutines.flow.MutableStateFlow
 import kotlinx.coroutines.flow.SharingStarted
 import kotlinx.coroutines.flow.StateFlow
 import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.emitAll
 import kotlinx.coroutines.flow.filterNotNull
+import kotlinx.coroutines.flow.flow
 import kotlinx.coroutines.flow.flowOf
 import kotlinx.coroutines.flow.flowOn
 import kotlinx.coroutines.flow.map
@@ -84,10 +86,11 @@ constructor(
     @Background private val backgroundDispatcher: CoroutineDispatcher,
     private val globalSettings: GlobalSettings,
     // Lazy: KeyguardRepository's own construction graph transitively depends back on
-    // UserRepository (via SelectedUserInteractor -> AssistManager -> Dependency), so an eager
-    // dependency here creates a real Dagger dependency cycle. This is only ever read lazily
-    // inside the flow below (never at construction time), so deferring resolution to first
-    // use is both safe and sufficient to break the cycle.
+    // UserRepository (via SelectedUserInteractor -> AssistManager -> Dependency). Lazy alone
+    // only defers *which instance* Dagger hands back, not *when* .get() executes -- it must
+    // also not be called until after this constructor returns (see the flow{} wrapper below),
+    // or Dagger's DoubleCheck memoization for this singleton hasn't committed yet and the same
+    // cycle recurses for real at runtime (confirmed via a real StackOverflowError on-device).
     private val keyguardRepository: Lazy<KeyguardRepository>,
     private val tracker: UserTracker,
     private val devicePolicyManager: DevicePolicyManager,
@@ -111,7 +114,13 @@ constructor(
                 // of the three Settings.Global keys above ever being written, which would
                 // otherwise leave this StateFlow's cached value stale until an unrelated
                 // settings write happened to refresh it.
-                keyguardRepository.get().isKeyguardShowing.map { Unit },
+                //
+                // flow{} (not a plain expression) is load-bearing: it defers
+                // keyguardRepository.get() until this flow is actually collected, which only
+                // happens once stateIn's coroutine actually runs -- after this constructor has
+                // already returned. Calling .get() directly here as a merge() argument would
+                // resolve it eagerly, during this very constructor, re-entering the cycle above.
+                flow { emitAll(keyguardRepository.get().isKeyguardShowing) }.map { Unit },
             )
             .onStart { emit(Unit) } // Forces an initial update.
             .map { getSettings() }
