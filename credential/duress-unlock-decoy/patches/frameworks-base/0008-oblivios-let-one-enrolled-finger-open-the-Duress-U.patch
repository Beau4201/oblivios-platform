         this.lockSettingsService = lockSettingsService;
         this.lockSettingsStorage = lockSettingsStorage;
         this.spManager = spManager;
         this.context = context;
+        this.decoyFingerHelper = decoyFingerHelper;
     }
 
     /**
@@ -223,13 +225,39 @@ class DecoyProfileHelper {
             return null;
         }
 
+        return mintAndSwitch(state.decoyUserId) ? VerifyCredentialResponse.OK : null;
+    }
+
+    /**
+     * ObliviOS: the Duress Unlock finger's route to the decoy. The decoy credential comes from
+     * the cache of {@link DecoyFingerHelper}, not from the keyguard. Returns true when the
+     * credential matched and the switch was initiated; false for no decoy, a mismatch (a stale
+     * link) or a switch that cannot start. The caller never falls back to the real session.
+     */
+    boolean routeToDecoyWithCredential(LockscreenCredential credential) {
+        final DecoyProfileState registered = DecoyProfileState.maybeGet(lockSettingsStorage);
+        if (registered == null || !decoyUserExists(registered.decoyUserId)) {
+            return false;
+        }
+        final VerifyCredentialResponse response = lockSettingsService.doVerifyCredentialInner(
+                credential, Primary, registered.decoyUserId, /* progressCallback= */ null,
+                /* flags= */ 0);
+        return response.isMatched() && mintAndSwitch(registered.decoyUserId);
+    }
+
+    /**
