diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java b/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java
new file mode 100644
index 0000000..f1ee61a
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java
@@ -0,0 +1,82 @@
+package com.android.server.locksettings;
+
+import java.util.Arrays;
+import java.util.Base64;
+
+/**
+ * ObliviOS: the stored form of the Duress Unlock finger link and of the decoy credential that
+ * is wrapped with it. Free of Android types so it can be tested on the JVM. See
+ * docs/superpowers/specs/2026-11-04-duress-unlock-finger-design.md in the oblivios-foundation
+ * repository.
+ */
+final class DecoyFingerCodec {
+    static final int VERSION = 0;
+
+    /** The stored finger link: the chosen finger's biometric id and the wrapped credential. */
+    static final class State {
+        final int fingerId;
+        final byte[] wrapped;
+
+        private State(int fingerId, byte[] wrapped) {
+            this.fingerId = fingerId;
+            this.wrapped = wrapped;
+        }
+    }
+
+    /** A decoy credential: its {@code LockPatternUtils} credential type and its bytes. */
+    static final class Credential {
+        final int type;
+        final byte[] credential;
+
+        private Credential(int type, byte[] credential) {
+            this.type = type;
+            this.credential = credential;
+        }
+    }
+
+    private DecoyFingerCodec() {}
+
+    static String formatState(int fingerId, byte[] wrapped) {
+        return VERSION + ":" + fingerId + ":" + Base64.getEncoder().encodeToString(wrapped);
+    }
+
+    /** Returns null for anything that is not a state this version wrote. */
+    static State parseState(String s) {
+        if (s == null) {
+            return null;
+        }
+        final String[] parts = s.split(":", 3);
+        if (parts.length != 3) {
+            return null;
+        }
+        try {
+            final int version = Integer.parseInt(parts[0]);
+            final int fingerId = Integer.parseInt(parts[1]);
+            if (version > VERSION || fingerId <= 0) {
+                return null;
+            }
+            return new State(fingerId, Base64.getDecoder().decode(parts[2]));
+        } catch (IllegalArgumentException e) {
+            // NumberFormatException is an IllegalArgumentException, as is a bad Base64 string
+            return null;
+        }
+    }
+
+    static byte[] encodeCredential(int type, byte[] credential) {
+        if (type < 0 || type > 127) {
+            throw new IllegalArgumentException("credential type out of range: " + type);
+        }
+        final byte[] out = new byte[credential.length + 1];
+        out[0] = (byte) type;
+        System.arraycopy(credential, 0, out, 1, credential.length);
+        return out;
+    }
+
+    /** Returns null for a missing, empty or malformed credential. */
+    static Credential decodeCredential(byte[] plain) {
+        if (plain == null || plain.length < 2 || plain[0] < 0) {
+            return null;
+        }
+        return new Credential(plain[0], Arrays.copyOfRange(plain, 1, plain.length));
+    }
+}
diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
new file mode 100644
index 0000000..c772923
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
@@ -0,0 +1,201 @@
+package com.android.server.locksettings;
+
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PASSWORD;
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PIN;
+
+import static java.nio.charset.StandardCharsets.ISO_8859_1;
+import static java.nio.charset.StandardCharsets.UTF_8;
+
+import android.annotation.Nullable;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import com.android.internal.widget.LockscreenCredential;
+import com.android.server.locksettings.SyntheticPasswordManager.SyntheticPassword;
+
+import java.nio.ByteBuffer;
+import java.nio.CharBuffer;
+import java.util.Arrays;
+
+/**
+ * ObliviOS: the link between one enrolled fingerprint of the real user and the Duress Unlock
+ * decoy. Stores the chosen finger's biometric id and the decoy credential wrapped under a key
+ * derived from the real user's synthetic password, and keeps the unwrapped credential in
+ * system_server memory from the moment the real credential is verified after boot. A finger carries no
+ * credential, so the decoy's storage can only be unlocked with this cached copy. See
+ * docs/superpowers/specs/2026-11-04-duress-unlock-finger-design.md in the oblivios-foundation
+ * repository.
+ *
+ * <p>The synthetic password of the real user does not change when the screen lock credential
+ * changes, so the wrapped blob survives a change of the screen lock. A change of the decoy
+ * credential makes the blob stale; Settings links the finger again in the same operation, and a
+ * stale blob makes the finger fail closed (the decoy credential check fails, see
+ * {@link DecoyProfileHelper#routeToDecoyWithCredential}).
+ */
+class DecoyFingerHelper {
+    private static final String TAG = "CredentialRoutingFingerHelper";
+
+    private static final String LOCK_SETTINGS_STORAGE_KEY = "decoy_finger_state";
+    private static final int LOCK_SETTINGS_STORAGE_USER_ID = UserHandle.USER_SYSTEM;
+    private static final byte[] WRAP_PERSONALIZATION = "decoy-finger-wrap".getBytes(UTF_8);
+
+    private final LockSettingsService lockSettingsService;
+    private final LockSettingsStorage lockSettingsStorage;
+
+    // Guarded by this.
+    @Nullable
+    private byte[] cachedPlain;
+
+    DecoyFingerHelper(LockSettingsService lockSettingsService,
+            LockSettingsStorage lockSettingsStorage) {
+        this.lockSettingsService = lockSettingsService;
+        this.lockSettingsStorage = lockSettingsStorage;
+    }
+
+    /**
+     * Links {@code biometricId} to the registered decoy. Returns false, storing nothing, when
+     * {@code decoyCredential} is not the decoy's credential.
+     */
+    boolean set(LockscreenCredential ownerCredential, LockscreenCredential decoyCredential,
+            int biometricId) {
+        lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
+        if (biometricId <= 0) {
+            throw new IllegalArgumentException("biometricId must be positive");
+        }
+        final int type = decoyCredential.getType();
+        if (type != CREDENTIAL_TYPE_PIN && type != CREDENTIAL_TYPE_PASSWORD) {
+            throw new IllegalArgumentException("the decoy credential must be a PIN or a password");
+        }
+        final DecoyProfileState state = DecoyProfileState.maybeGet(lockSettingsStorage);
+        if (state == null) {
+            throw new IllegalStateException("no decoy is registered");
+        }
+
+        // Checks the credential against the decoy's protector only: no storage unlock, no routing,
+        // no wipe hook.
+        final SyntheticPassword decoySp = lockSettingsService.unlockSyntheticPasswordWithCredential(
+                decoyCredential, state.decoyUserId);
+        if (decoySp == null) {
+            return false;
+        }
+        decoySp.zeroize();
+
+        final SyntheticPassword ownerSp = lockSettingsService.unlockSyntheticPasswordWithCredential(
+                ownerCredential, UserHandle.USER_SYSTEM);
+        if (ownerSp == null) {
+            throw new SecurityException("owner credential verification failed");
+        }
+        byte[] plain = null;
+        try {
+            plain = DecoyFingerCodec.encodeCredential(type, decoyCredential.getCredential());
+            final byte[] wrapped = SyntheticPasswordCrypto.encrypt(ownerSp.deriveDecoyFingerKey(),
+                    WRAP_PERSONALIZATION, plain);
+            if (wrapped == null) {
+                throw new IllegalStateException("the decoy credential could not be wrapped");
+            }
+            lockSettingsStorage.setString(LOCK_SETTINGS_STORAGE_KEY,
+                    DecoyFingerCodec.formatState(biometricId, wrapped),
+                    LOCK_SETTINGS_STORAGE_USER_ID);
+            setCache(plain);
+            return true;
+        } finally {
+            ownerSp.zeroize();
+            if (plain != null) {
+                Arrays.fill(plain, (byte) 0);
+            }
+        }
+    }
+
+    void clear(LockscreenCredential ownerCredential) {
+        lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
+        clearState();
+    }
+
+    /** Deletes the link and the cached credential. Needs no credential: system_server only. */
+    void clearState() {
+        lockSettingsStorage.removeKey(LOCK_SETTINGS_STORAGE_KEY, LOCK_SETTINGS_STORAGE_USER_ID);
+        synchronized (this) {
+            zeroCache();
+        }
+    }
+
+    /** The biometric id of the chosen finger, or {@link DecoyFingerPolicy#NO_FINGER}. */
+    int getFingerId(LockscreenCredential ownerCredential) {
+        lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
+        return getStoredFingerId();
+    }
+
+    /** Same as {@link #getFingerId} for system_server callers, which need no credential. */
+    int getStoredFingerId() {
+        final DecoyFingerCodec.State state = readState();
+        return state == null ? DecoyFingerPolicy.NO_FINGER : state.fingerId;
+    }
+
+    /**
+     * Called from the success branch of the real owner's credential check, while the synthetic
+     * password is still in hand. Unwraps the decoy credential into memory; a missing, corrupt or
+     * undecryptable blob leaves the cache empty, so the finger fails closed.
+     */
+    void onOwnerSyntheticPasswordUnlocked(SyntheticPassword ownerSp) {
+        final DecoyFingerCodec.State state = readState();
+        if (state == null) {
+            return;
+        }
+        final byte[] plain = SyntheticPasswordCrypto.decrypt(ownerSp.deriveDecoyFingerKey(),
+                WRAP_PERSONALIZATION, state.wrapped);
+        if (plain == null) {
+            Slog.w(TAG, "The decoy finger link could not be unwrapped");
+            return;
+        }
+        try {
+            setCache(plain);
+        } finally {
+            Arrays.fill(plain, (byte) 0);
+        }
+    }
+
+    synchronized boolean hasCachedCredential() {
+        return cachedPlain != null;
+    }
+
+    /** A new credential object from the cache, or null; the caller zeroizes it. */
+    @Nullable
+    synchronized LockscreenCredential cachedCredentialCopy() {
+        if (cachedPlain == null) {
+            return null;
+        }
+        final DecoyFingerCodec.Credential c = DecoyFingerCodec.decodeCredential(cachedPlain);
+        if (c == null) {
+            return null;
+        }
+        // LockscreenCredential keeps the low byte of every char, so the bytes map back to chars
+        // one to one.
+        final CharBuffer chars = ISO_8859_1.decode(ByteBuffer.wrap(c.credential));
+        try {
+            return c.type == CREDENTIAL_TYPE_PIN
+                    ? LockscreenCredential.createPin(chars)
+                    : LockscreenCredential.createPassword(chars);
+        } finally {
+            Arrays.fill(chars.array(), '\0');
+            Arrays.fill(c.credential, (byte) 0);
+        }
+    }
+
+    @Nullable
+    private DecoyFingerCodec.State readState() {
+        return DecoyFingerCodec.parseState(lockSettingsStorage.getString(
+                LOCK_SETTINGS_STORAGE_KEY, null, LOCK_SETTINGS_STORAGE_USER_ID));
+    }
+
+    private synchronized void setCache(byte[] plain) {
+        zeroCache();
+        cachedPlain = plain.clone();
+    }
+
+    private void zeroCache() {
+        if (cachedPlain != null) {
+            Arrays.fill(cachedPlain, (byte) 0);
+            cachedPlain = null;
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
new file mode 100644
index 0000000..59ff7de
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
@@ -0,0 +1,39 @@
+package com.android.server.locksettings;
+
+/**
+ * ObliviOS: decides what a matched fingerprint does with respect to the Duress Unlock decoy.
+ * Free of Android types so it can be tested on the JVM. See
+ * docs/superpowers/specs/2026-11-04-duress-unlock-finger-design.md in the oblivios-foundation
+ * repository.
+ *
+ * <p>{@link #REJECT} exists so that a finger chosen as the duress finger can never fall through to
+ * the ordinary path: if the decoy cannot be reached, or the match does not come from the
+ * keyguard, the finger is treated as an unrecognised finger and never opens the real session or
+ * authenticates the real user's keystore.
+ */
+final class DecoyFingerPolicy {
+    static final int NO_FINGER = 0;
+    static final int USER_SYSTEM = 0;
+
+    /** Not the duress finger: the ordinary authentication path. */
+    static final int NONE = 0;
+    /** The duress finger at the keyguard with everything in place: switch to the decoy. */
+    static final int ROUTE = 1;
+    /** The duress finger, but it must not be accepted: an unrecognised finger. */
+    static final int REJECT = 2;
+
+    private DecoyFingerPolicy() {}
+
+    static int decide(int userId, int storedFingerId, int matchedFingerId, boolean ownerIsKeyguard,
+            boolean decoyRegistered, boolean credentialCached, boolean biometricAllowed) {
+        if (userId != USER_SYSTEM || storedFingerId == NO_FINGER
+                || matchedFingerId != storedFingerId) {
+            return NONE;
+        }
+        if (!ownerIsKeyguard || !decoyRegistered || !credentialCached
+                || !biometricAllowed) {
+            return REJECT;
+        }
+        return ROUTE;
+    }
+}
