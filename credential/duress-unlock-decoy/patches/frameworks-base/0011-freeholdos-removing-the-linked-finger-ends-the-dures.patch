From 519f8dd5e06ff7b35ca7fccc214a2b262886cda7 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 5 Nov 2026 03:52:06 +0100
Subject: [PATCH] freeholdos: removing the linked finger ends the duress finger
 link

Review finding B8 (2026-11-04): the link between one enrolled fingerprint and the decoy (DecoyFingerHelper) kept the
biometric id after the owner removed that finger in Settings. If the HAL gives that id to a later enrolment, the new
finger would open the decoy instead of the real session.

FingerprintUtils.removeBiometricForUser, the one place both RemovalClient and the enumerate clean-up pass through,
now tells LockSettingsInternal.onFingerprintRemoved, which deletes the link and the cached credential when the removed
finger is the linked one of the real user (DecoyFingerPolicy.shouldClearOnRemoval, pure). A failure of the call never
fails the removal. DecoyFingerPolicyTest has four new cases; nine mutants of the rule are killed.
---
 .../sensors/fingerprint/FingerprintUtils.java | 15 +++++++++++++
 .../locksettings/DecoyFingerHelper.java       | 12 ++++++++++
 .../locksettings/DecoyFingerPolicy.java       | 10 +++++++++
 .../locksettings/LockSettingsInternal.java    |  6 +++++
 .../locksettings/LockSettingsService.java     |  5 +++++
 .../locksettings/DecoyFingerPolicyTest.java   | 22 +++++++++++++++++++
 6 files changed, 70 insertions(+)

diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/FingerprintUtils.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/FingerprintUtils.java
index b8c06c7..7f15013 100644
--- a/services/core/java/com/android/server/biometrics/sensors/fingerprint/FingerprintUtils.java
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/FingerprintUtils.java
@@ -32,10 +32,13 @@ import android.content.Context;
 import android.hardware.biometrics.fingerprint.V2_1.FingerprintError;
 import android.hardware.fingerprint.Fingerprint;
 import android.text.TextUtils;
+import android.util.Slog;
 import android.util.SparseArray;
 
 import com.android.internal.annotations.GuardedBy;
+import com.android.server.LocalServices;
 import com.android.server.biometrics.sensors.BiometricUtils;
+import com.android.server.locksettings.LockSettingsInternal;
 
 import java.util.List;
 
@@ -113,6 +116,18 @@ public class FingerprintUtils implements BiometricUtils<Fingerprint> {
     @Override
     public void removeBiometricForUser(Context context, int userId, int fingerId) {
         getStateForUser(context, userId).removeBiometric(fingerId);
+        // FreeholdOS: a removed finger ends the Duress Unlock finger link when it is the linked one, so that a
+        // new enrolment which the HAL gives the same biometric id is not the duress finger. A failure here
+        // must not fail the removal.
+        try {
+            final LockSettingsInternal lockSettings =
+                    LocalServices.getService(LockSettingsInternal.class);
+            if (lockSettings != null) {
+                lockSettings.onFingerprintRemoved(userId, fingerId);
+            }
+        } catch (RuntimeException e) {
+            Slog.e("FingerprintUtils", "Clearing the duress finger link failed", e);
+        }
     }
 
     @Override
diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
index 796a2b6..0717d73 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
@@ -119,6 +119,18 @@ class DecoyFingerHelper {
         }
     }
 
+    /**
+     * Called when an enrolled fingerprint is removed. Deletes the link when it is the linked finger, so that a
+     * new enrolment that gets the same biometric id from the HAL is not the duress finger. Needs no credential:
+     * system_server only.
+     */
+    void onFingerRemoved(int userId, int biometricId) {
+        if (DecoyFingerPolicy.shouldClearOnRemoval(userId, getStoredFingerId(), biometricId)) {
+            Slog.i(TAG, "The linked finger was removed: the decoy finger link is deleted");
+            clearState();
+        }
+    }
+
     /** The biometric id of the chosen finger, or {@link DecoyFingerPolicy#NO_FINGER}. */
     int getFingerId(LockscreenCredential ownerCredential) {
         lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
index 59ff7de..f7ae957 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
@@ -36,4 +36,14 @@ final class DecoyFingerPolicy {
         }
         return ROUTE;
     }
+
+    /**
+     * Whether the removal of an enrolled fingerprint ends the link to the decoy: only the removal of the
+     * linked finger of the real user. A removed finger whose biometric id the HAL later gives to a new
+     * enrolment would otherwise open the decoy.
+     */
+    static boolean shouldClearOnRemoval(int userId, int storedFingerId, int removedFingerId) {
+        return userId == USER_SYSTEM && storedFingerId != NO_FINGER
+                && removedFingerId == storedFingerId;
+    }
 }
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsInternal.java b/services/core/java/com/android/server/locksettings/LockSettingsInternal.java
index f5c2e81..a187b0a 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsInternal.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsInternal.java
@@ -240,4 +240,10 @@ public abstract class LockSettingsInternal {
      * freeholdos-foundation repository.
      */
     public abstract int routeDecoyFinger(int userId, int biometricId, boolean ownerIsKeyguard);
+
+    /**
+     * FreeholdOS: an enrolled fingerprint of {@code userId} was removed. Deletes the Duress Unlock finger
+     * link when {@code biometricId} is the linked finger. Called from system_server only.
+     */
+    public abstract void onFingerprintRemoved(int userId, int biometricId);
 }
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index e762064..16d546f 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -4453,6 +4453,11 @@ public class LockSettingsService extends ILockSettings.Stub {
     }
 
     private final class LocalService extends LockSettingsInternal {
+        @Override
+        public void onFingerprintRemoved(int userId, int biometricId) {
+            decoyFingerHelper.onFingerRemoved(userId, biometricId);
+        }
+
         @Override
         public int routeDecoyFinger(int userId, int biometricId, boolean ownerIsKeyguard) {
             final int decision = DecoyFingerPolicy.decide(userId,
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java
index 7c3ec72..f7a5e3a 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java
@@ -1,6 +1,8 @@
 package com.android.server.locksettings;
 
 import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
 
 import org.junit.Test;
 
@@ -73,4 +75,24 @@ public class DecoyFingerPolicyTest {
             }
         }
     }
+
+    @Test
+    public void removingTheDuressFingerClearsTheLink() {
+        assertTrue(DecoyFingerPolicy.shouldClearOnRemoval(0, DURESS, DURESS));
+    }
+
+    @Test
+    public void removingAnotherFingerKeepsTheLink() {
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(0, DURESS, 7));
+    }
+
+    @Test
+    public void removalWithNoLinkClearsNothing() {
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(0, 0, 0));
+    }
+
+    @Test
+    public void removalOfAnotherUsersFingerKeepsTheLink() {
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(10, DURESS, DURESS));
+    }
 }
