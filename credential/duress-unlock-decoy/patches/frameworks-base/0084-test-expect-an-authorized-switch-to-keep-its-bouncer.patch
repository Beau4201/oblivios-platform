From 6f6723a8052b2b4bf5e59344a63b0bb932e78727 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 17 Sep 2026 02:23:15 +0200
Subject: [PATCH 84/85] test: expect an authorized switch to keep its bouncer
 up

The bouncer-skip grant is now redeemed in handleBeforeUserSwitching
rather than at switch-complete, because the decision it gates has to be
made before the switch renders. Asserts the authorized switch resets
without hiding its bouncer and the ordinary secure-user switch still
hides its own, and moves the existing coverage to redeem at the new
point.
---
 .../keyguard/KeyguardViewMediatorTest.java    | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index 9c2c8c6a44a6..d49339206ba0 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -557,6 +557,10 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         processAllMessagesAndBgExecutorMessages();
         verify(beforeResult).run();
 
+        // AegisOS: the ADR-061 regression property for the bouncer-retention change -- an
+        // ordinary secure-user switch still collapses its bouncer exactly as before.
+        verify(mStatusBarKeyguardViewManager).reset(true);
+
         Runnable onSwitchResult = mock(Runnable.class);
         mViewMediator.handleUserSwitching(nextUserId, onSwitchResult);
         processAllMessagesAndBgExecutorMessages();
@@ -592,6 +596,12 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         processAllMessagesAndBgExecutorMessages();
         verify(beforeResult).run();
 
+        // AegisOS: the bouncer is left up across an authorized switch. Hiding it would drop
+        // primaryBouncerShowing, which FromPrimaryBouncerTransitionInteractor turns into a
+        // PRIMARY_BOUNCER -> LOCKSCREEN transition -- presenting the incoming user's lock screen
+        // only to animate it away again, which is what reads as the device swiping itself up.
+        verify(mStatusBarKeyguardViewManager).reset(false);
+
         Runnable onSwitchResult = mock(Runnable.class);
         mViewMediator.handleUserSwitching(nextUserId, onSwitchResult);
         processAllMessagesAndBgExecutorMessages();
@@ -632,6 +642,11 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
                 .thenReturn(true);
 
+        // The grant is redeemed here, not at switch-complete: handleBeforeUserSwitching has to
+        // know whether the switch is authorized before it can decide to leave the bouncer up.
+        mViewMediator.handleBeforeUserSwitching(nextUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+
         mViewMediator.handleUserSwitchComplete(nextUserId);
         processAllMessagesAndBgExecutorMessages();
 
@@ -671,6 +686,9 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
                 .thenReturn(false);
 
+        mViewMediator.handleBeforeUserSwitching(nextUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+
         mViewMediator.handleUserSwitchComplete(nextUserId);
         processAllMessagesAndBgExecutorMessages();
 
@@ -704,6 +722,11 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
                 .thenReturn(true);
 
+        // The grant is redeemed here, not at switch-complete: handleBeforeUserSwitching has to
+        // know whether the switch is authorized before it can decide to leave the bouncer up.
+        mViewMediator.handleBeforeUserSwitching(nextUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+
         mViewMediator.handleUserSwitchComplete(nextUserId);
         processAllMessagesAndBgExecutorMessages();
 
@@ -731,6 +754,9 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
                 .thenReturn(false);
 
+        mViewMediator.handleBeforeUserSwitching(nextUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+
         mViewMediator.handleUserSwitchComplete(nextUserId);
         processAllMessagesAndBgExecutorMessages();
 
@@ -755,6 +781,11 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
                 .thenReturn(true);
 
+        // The grant is redeemed here, not at switch-complete: handleBeforeUserSwitching has to
+        // know whether the switch is authorized before it can decide to leave the bouncer up.
+        mViewMediator.handleBeforeUserSwitching(nextUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+
         mViewMediator.handleUserSwitchComplete(nextUserId);
         processAllMessagesAndBgExecutorMessages();
 
