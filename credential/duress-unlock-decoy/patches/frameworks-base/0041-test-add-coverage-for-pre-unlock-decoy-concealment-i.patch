From 582a7ec39723dadde855098014c62a787d4dc20f Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Mon, 7 Sep 2026 13:47:26 +0200
Subject: [PATCH 41/43] test: add coverage for pre-unlock decoy concealment in
 isUserSwitcherEnabled

---
 .../server/pm/UserManagerServiceTest.java     | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java b/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
index 101ea6d81a16..449527cc413f 100644
--- a/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
+++ b/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
@@ -20,6 +20,9 @@ import static android.os.UserManager.DISALLOW_USER_SWITCH;
 
 import static com.google.common.truth.Truth.assertThat;
 
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
 import android.app.ActivityManager;
 import android.app.PropertyInvalidatedCache;
 import android.content.Context;
@@ -38,6 +41,7 @@ import androidx.test.runner.AndroidJUnit4;
 import androidx.test.uiautomator.UiDevice;
 
 import com.android.server.LocalServices;
+import com.android.server.wm.WindowManagerInternal;
 
 import org.junit.After;
 import org.junit.Before;
@@ -53,10 +57,15 @@ import java.util.Arrays;
 @RunWith(AndroidJUnit4.class)
 public class UserManagerServiceTest {
     private static String[] STRING_ARRAY = new String[] {"<tag", "<![CDATA["};
+    // AegisOS: arbitrary id distinct from the real current user set up in setup(), used only by
+    // the pre-unlock concealment tests below.
+    private static final int AEGISOS_DECOY_USER_ID = 10;
     private File restrictionsFile;
     private int tempUserId = UserHandle.USER_NULL;
     private final Context mContext = InstrumentationRegistry.getInstrumentation().getContext();
     private UserManagerService mUserManagerService;
+    // AegisOS: only non-null once a test calls setKeyguardLocked(); torn down unconditionally.
+    private WindowManagerInternal mMockWindowManagerInternal;
 
     @Before
     public void setup() throws Exception {
@@ -83,6 +92,10 @@ public class UserManagerServiceTest {
         if (tempUserId != UserHandle.USER_NULL) {
             UserManager.get(mContext).removeUser(tempUserId);
         }
+        // AegisOS: LocalServices is a static, process-wide registry; unregister the mock
+        // regardless of whether this test installed one, so it never leaks into another test.
+        LocalServices.removeServiceForTest(WindowManagerInternal.class);
+        mMockWindowManagerInternal = null;
     }
 
     @Test
@@ -202,6 +215,45 @@ public class UserManagerServiceTest {
                 .isFalse();
     }
 
+    // AegisOS: pre-unlock concealment (isUserSwitcherEnabled must not advertise a second user
+    // while the device is locked, but only when a decoy actually exists on the device).
+    @Test
+    public void testIsUserSwitcherEnabled_lockedDeviceWithDecoy_returnsFalse() {
+        addDecoyUser();
+        setKeyguardLocked(true);
+
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isFalse();
+    }
+
+    @Test
+    public void testIsUserSwitcherEnabled_unlockedDeviceWithDecoy_returnsRealValue() {
+        addDecoyUser();
+        setKeyguardLocked(false);
+
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isTrue();
+    }
+
+    @Test
+    public void testIsUserSwitcherEnabled_lockedDeviceWithoutDecoy_returnsRealValue() {
+        setKeyguardLocked(true);
+
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isTrue();
+    }
+
+    private void addDecoyUser() {
+        mUserManagerService.putUserInfo(new UserInfo(AEGISOS_DECOY_USER_ID, "Decoy User", null, 0,
+                UserManager.USER_TYPE_FULL_AEGISOS_DECOY));
+    }
+
+    private void setKeyguardLocked(boolean locked) {
+        if (mMockWindowManagerInternal == null) {
+            mMockWindowManagerInternal = mock(WindowManagerInternal.class);
+            LocalServices.removeServiceForTest(WindowManagerInternal.class);
+            LocalServices.addService(WindowManagerInternal.class, mMockWindowManagerInternal);
+        }
+        when(mMockWindowManagerInternal.isKeyguardShowing()).thenReturn(locked);
+    }
+
     private static String runShellCommand(String cmd) throws Exception {
         return UiDevice.getInstance(InstrumentationRegistry.getInstrumentation())
                 .executeShellCommand(cmd);
