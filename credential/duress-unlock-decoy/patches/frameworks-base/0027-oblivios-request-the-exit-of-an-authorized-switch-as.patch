From a33960499a2890fde3d23d7544b7b15d56ca9dcd Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 18:04:10 +0100
Subject: [PATCH] oblivios: request the exit of an authorized switch as soon as
 the switch is released and keep the ordinary unlock animation

---
 .../KeyguardUnlockAnimationController.kt      | 31 ++-------
 .../keyguard/KeyguardViewMediator.java        | 59 ++++++++++++----
 .../keyguard/KeyguardViewMediatorTest.java    | 67 +++++++++++++------
 3 files changed, 97 insertions(+), 60 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt
index 0e5995a0..3fe99d74 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt
@@ -691,33 +691,14 @@ constructor(
         Log.d(TAG, "playCannedUnlockAnimation")
         playingCannedUnlockAnimation = true
 
-        // ObliviOS: consumed here, at the last point of use, because this is where the animation
-        // that would otherwise render is chosen. See KeyguardViewMediator#
-        // mAuthorizedSwitchDismissPending.
-        val authorizedSwitchDismiss = keyguardViewMediator.get().consumeAuthorizedSwitchDismiss()
+        // ObliviOS: the mark of an authorized switch is still cleared here, at the last point of
+        // use, but it no longer selects a different animation: the exit of a duress unlock runs the
+        // ordinary one (owner ruling 2026-11-13). The cut that used to stand here showed the decoy
+        // home at once, where the ordinary unlock animates the home in (lynx video, 2026-11-13).
+        // See KeyguardViewMediator#mAuthorizedSwitchDismissPending.
+        keyguardViewMediator.get().consumeAuthorizedSwitchDismiss()
 
         when {
-            // ObliviOS: this exit was requested by an authorized decoy-direction switch, whose
-            // keyguard has been showing continuously across the switch -- hiding it any earlier
-            // would expose the outgoing user's screen, since switchToUserSilently suppresses the
-            // UserSwitchingDialog and nothing else covers the transition. Any canned animation
-            // here therefore renders as the lock screen moving itself off-screen, which an
-            // ordinary same-user unlock never does, so it is a tell in exactly the situation this
-            // feature exists for. Confirmed on hardware: the default branch below runs
-            // surfaceBehindEntryAnimator, which by its own contract scales and translates the
-            // window underneath the lockscreen -- that motion is the reported swipe.
-            //
-            // Shows the surface behind immediately and ends the remote animation, which is not a
-            // new mechanism: it is exactly what the isWakeAndUnlock branch below already does,
-            // for the same reason (a surface that should simply be there, not animated in).
-            authorizedSwitchDismiss -> {
-                Log.d(TAG, "playCannedUnlockAnimation, authorized switch dismiss")
-                setSurfaceBehindAppearAmount(1f)
-                keyguardViewMediator
-                    .get()
-                    .exitKeyguardAndFinishSurfaceBehindRemoteAnimation(false /* cancelled */)
-            }
-
             // If we're set up for in-window launcher animations, ask Launcher to play its in-window
             // canned animation.
             willUnlockWithInWindowLauncherAnimations -> {
diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 7e11092e..b7d3ea7e 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -518,6 +518,18 @@ public class KeyguardViewMediator implements CoreStartable,
      */
     private boolean mAuthorizedSwitchDismissPending;
 
+    /**
+     * ObliviOS: whether the dismissal of an authorized switch was already requested, right after
+     * the keyguard reset of handleBeforeUserSwitching, instead of at USER_SWITCH_COMPLETE (2.1 s
+     * after the credential check on a cold decoy, lynx 2026-11-13). The exit then starts while the
+     * switch is still running, and the unlock takes as long as an ordinary one. The window manager
+     * holds the going-away until the user change is applied (ActivityTaskManagerService#
+     * keyguardGoingAway), so an early exit can never uncover the outgoing user's windows. Reset with
+     * the mark above on every switch; keeps the later handlers from dismissing a second time, which
+     * would redeem nothing and could bring the bouncer back. Mediator thread only.
+     */
+    private boolean mAuthorizedSwitchDismissRequested;
+
     // last known state of the cellular connection
     private final String mPhoneState = TelephonyManager.EXTRA_STATE_IDLE;
 
@@ -728,6 +740,7 @@ public class KeyguardViewMediator implements CoreStartable,
             // so a switch that earns no grant also resets any stale mark from a superseded one.
             mAuthorizedSwitchDismissPending = mLockPatternUtils.isSecure(userId)
                     && mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
+            mAuthorizedSwitchDismissRequested = false;
             mHandler.removeMessages(START_KEYGUARD_EXIT_ANIM);
             mHandler.removeMessages(DISMISS);
             mHandler.removeMessages(HIDE);
@@ -770,6 +783,18 @@ public class KeyguardViewMediator implements CoreStartable,
                 resetStateLocked(/* hideBouncer= */ !mAuthorizedSwitchDismissPending);
             }
             resultCallback.run();
+            if (mAuthorizedSwitchDismissPending) {
+                // ObliviOS: the exit of an authorized switch starts here, as soon as the switch
+                // is released, not at USER_SWITCH_COMPLETE. On lynx 2026-11-13 the switch completed
+                // 2.1 s after the credential check (the cold decoy's services), so the bouncer
+                // exit ran after that and the unlock took 3 s against 0.8 s. The going-away of the
+                // keyguard is held by the window manager until the user change is applied, so this
+                // cannot uncover the outgoing user's windows. The same single-use dismissal that
+                // handleUserSwitchComplete requests, requested earlier.
+                mAuthorizedSwitchDismissRequested = true;
+                mHandler.postDelayed(
+                        () -> dismiss(null /* callback */, null /* message */), mDismissToken, 0);
+            }
         }
     }
 
@@ -786,6 +811,15 @@ public class KeyguardViewMediator implements CoreStartable,
                 dismiss(null, null);
                 waitForTransitionToBouncer(resultCallback);
             } else {
+                if (mAuthorizedSwitchDismissPending && !mAuthorizedSwitchDismissRequested) {
+                    // ObliviOS: the exit was not requested in handleBeforeUserSwitching (it is
+                    // there for every authorized switch; this is the fallback for a path that
+                    // reaches here without it).
+                    mAuthorizedSwitchDismissRequested = true;
+                    mHandler.postDelayed(
+                            () -> dismiss(null /* callback */, null /* message */), mDismissToken,
+                            0);
+                }
                 resultCallback.run();
             }
         }
@@ -833,7 +867,13 @@ public class KeyguardViewMediator implements CoreStartable,
                 // ObliviOS: the grant was already redeemed in handleBeforeUserSwitching, which had
                 // to know whether this switch was authorized before it could decide to leave the
                 // bouncer up. This reads that decision rather than redeeming a second time.
-                if (!mAuthorizedSwitchDismissPending) {
+                if (mAuthorizedSwitchDismissRequested) {
+                    // ObliviOS: the dismissal was requested in handleBeforeUserSwitching. The mark
+                    // itself may be gone already, consumed by the unlock animation of that exit, so
+                    // this has to read the request, not the mark, or it would dismiss a second time
+                    // as if the switch were not authorized.
+                    Log.d(TAG, "onUserSwitchComplete, authorized dismissal already requested");
+                } else if (!mAuthorizedSwitchDismissPending) {
                     // We are calling dismiss with a delay as there are race conditions in some
                     // scenarios caused by async layout listeners
                     mHandler.postDelayed(
@@ -3421,19 +3461,10 @@ public class KeyguardViewMediator implements CoreStartable,
                     || mWakeAndUnlocking && !mWallpaperSupportsAmbientMode) {
                 flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
             }
-            // ObliviOS: an authorized-switch dismissal cuts rather than animates. Deliberately
-            // read without consuming: on this build the going-away is merged into the user-switch
-            // transition and animated by the Shell's KeyguardTransitionHandler, which dispatches
-            // on TRANSIT_FLAG_KEYGUARD_GOING_AWAY alone and never reads this flag -- confirmed on
-            // hardware, where setting it alone left the swipe fully intact. The flag is still set
-            // because it is the semantically correct request for a dismissal that must not
-            // animate, and it is honoured on the non-Shell path; the dismissal that actually
-            // renders is suppressed where it is really played, in
-            // KeyguardUnlockAnimationController#playCannedUnlockAnimation, which consumes the
-            // pending mark via consumeAuthorizedSwitchDismiss().
-            if (mAuthorizedSwitchDismissPending) {
-                flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
-            }
+            // ObliviOS: an authorized-switch dismissal no longer asks for its window animations to
+            // be suppressed. The ordinary unlock runs them, and the exit of a duress unlock has to
+            // look the same (owner ruling 2026-11-13, margin 0.0 on every animation); the bouncer
+            // stays up across the switch, so the lock screen the cut was meant to hide is never shown.
             if (mKeyguardViewControllerLazy.get().isGoingToNotificationShade()
                     || mWakeAndUnlocking && mWallpaperSupportsAmbientMode) {
                 // When the wallpaper supports ambient mode, the scrim isn't fully opaque during
diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index 64153816..41d3747d 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -602,33 +602,61 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         // only to animate it away again, which is what reads as the device swiping itself up.
         verify(mStatusBarKeyguardViewManager).reset(false);
 
+        // ObliviOS: the dismissal of an authorized switch is requested right after the keyguard
+        // reset of handleBeforeUserSwitching, with no delay, so the exit starts while the switch is
+        // still running (the window manager holds the going-away until the user change is applied).
+        // The automatic bouncer re-arm never fires for an authorized grant, and dismiss() redeems the
+        // third (active-dismiss) grant of the mint without a swipe or a pause.
+        verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
+
         Runnable onSwitchResult = mock(Runnable.class);
         mViewMediator.handleUserSwitching(nextUserId, onSwitchResult);
         processAllMessagesAndBgExecutorMessages();
         verify(onSwitchResult).run();
-        verify(mStatusBarKeyguardViewManager, never()).dismissAndCollapse();
 
-        // ObliviOS: the authorized grant means the automatic bouncer *re-arm* above never fires
-        // (verified immediately above, before any delay), but dismiss() still runs once, with no
-        // delay (unlike the unauthorized case's 500ms, which exists only to let a freshly shown
-        // bouncer's own layout listeners settle -- not applicable here, since this branch never
-        // shows one) -- this is what redeems the still-outstanding third (active-dismiss) grant
-        // from the same mint, landing without a swipe or an artificial pause, instead of leaving
-        // that grant to be redeemed by chance on the user's own next gesture. This is the one
-        // call site both the outbound (owner-to-decoy) and return (decoy-to-owner) directions
-        // share, since consumeDecoySwitchAuthorizationForBouncerSkip is generic on target user
-        // id. moveTimeForward(600) still applies below even though the real delay is now 0, to
-        // keep this assertion structurally comparable to the unauthorized-case test above.
+        // Neither later handler may dismiss a second time: the grant is spent, and a second dismiss
+        // could bring the bouncer back. verify() without a count asserts exactly one call.
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        TestableLooper.get(this).moveTimeForward(600);
+        processAllMessagesAndBgExecutorMessages();
+
+        verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
+    }
+
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testAuthorizedSwitchDismissesOnceEvenWhenTheMarkIsConsumedBeforeSwitchComplete() {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(true);
+
+        mViewMediator.handleBeforeUserSwitching(nextUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+        verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
+
+        // The exit's own unlock animation consumes the mark before the switch completes (a cold
+        // decoy: the complete message arrives about a second later).
+        assertTrue(mViewMediator.consumeAuthorizedSwitchDismiss());
+
+        mViewMediator.handleUserSwitching(nextUserId, mock(Runnable.class));
         mViewMediator.handleUserSwitchComplete(nextUserId);
         TestableLooper.get(this).moveTimeForward(600);
         processAllMessagesAndBgExecutorMessages();
 
+        // Still exactly one dismissal: the later handlers read the request, not the spent mark.
         verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
     }
 
     @Test
     @TestableLooper.RunWithLooper(setAsMainLooper = true)
-    public void testAuthorizedSwitchDismissSuppressesUnlockWindowAnimation()
+    public void testAuthorizedSwitchDismissKeepsUnlockWindowAnimation()
             throws RemoteException {
         setCurrentUser(/* userId= */1099, /* isSecure= */true);
 
@@ -650,20 +678,17 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         mViewMediator.handleUserSwitchComplete(nextUserId);
         processAllMessagesAndBgExecutorMessages();
 
-        // ObliviOS: the keyguard has been showing continuously across the switch -- hiding it any
-        // earlier would expose the outgoing user's own screen, since switchToUserSilently
-        // suppresses the UserSwitchingDialog and nothing else covers the transition. Animating it
-        // away at this point therefore renders as the lock screen swiping itself up, which an
-        // ordinary same-user unlock never does and which is a tell in exactly the situation this
-        // feature exists for. The authorized dismissal must cut instead.
+        // ObliviOS: the authorized dismissal runs the ordinary unlock animation (owner ruling
+        // 2026-11-13, every animation equal to the ordinary unlock): the bouncer stays up across the
+        // switch, so the exit is the single PRIMARY_BOUNCER -> GONE step of an ordinary unlock and
+        // the window animations are not suppressed.
         reset(mActivityTaskManagerService);
         mViewMediator.hideLocked();
         processAllMessagesAndBgExecutorMessages();
 
         ArgumentCaptor<Integer> flagsCaptor = ArgumentCaptor.forClass(Integer.class);
         verify(mActivityTaskManagerService).keyguardGoingAway(flagsCaptor.capture());
-        assertEquals(KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS,
-                flagsCaptor.getValue() & KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS);
+        assertEquals(0, flagsCaptor.getValue() & KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS);
     }
 
     @Test
-- 
