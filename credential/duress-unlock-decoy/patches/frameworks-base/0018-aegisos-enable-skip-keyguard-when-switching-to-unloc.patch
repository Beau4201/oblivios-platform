From ebb58e3ccc2034c2685b889ceecbcd1830b382ef Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Fri, 28 Aug 2026 18:24:59 +0200
Subject: [PATCH] aegisos: enable
 skip-keyguard-when-switching-to-unlocked-users

---
 core/res/res/values/config.xml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index d7a4004a27d6..c3075f208261 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -3328,7 +3328,12 @@
          already has their credential-encrypted (CE) storage unlocked, and not require strong
          authentication. This will also force users to require strong authentication when switching
          away from them. -->
-    <bool name="config_multiuserSkipKeyguardWhenSwitchingToUnlockedUsers">false</bool>
+    <!-- AegisOS: enabled so a Duress Unlock decoy switch (whose credential was already verified
+         moments earlier by DecoyProfileHelper) doesn't re-lock the device and demand the same
+         PIN a second time. Device-wide effect for any user switch, not decoy-specific — see
+         docs/superpowers/specs/2026-08-28-duress-decoy-session-indistinguishability-design.md
+         in the aegisos-foundation repository. -->
+    <bool name="config_multiuserSkipKeyguardWhenSwitchingToUnlockedUsers">true</bool>
 
      <!-- Whether the UserSwitchingDialog should use the system wallpaper as the background during
           the user switching animation. -->
-- 
2.39.5

