From 9dbb2233128b30490ffae6cdb44a0942363f7f2d Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 04:00:29 +0100
Subject: [PATCH 43/45] oblivios: keep the stage window of an authorized switch
 shown while it is redrawn

---
 .../com/android/server/wm/WindowStateAnimator.java    | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/wm/WindowStateAnimator.java b/services/core/java/com/android/server/wm/WindowStateAnimator.java
index 27df6276..74e0b2a0 100644
--- a/services/core/java/com/android/server/wm/WindowStateAnimator.java
+++ b/services/core/java/com/android/server/wm/WindowStateAnimator.java
@@ -411,7 +411,16 @@ class WindowStateAnimator {
         mShownAlpha = mAlpha;
 
         if (!w.isOnScreen()) {
-            hide(t, "prepareSurfaceLocked");
+            // ObliviOS: SystemUI redraws the stage of an authorized switch when a theme overlay
+            // changes mid-exit (the window then counts as not drawn for about 90 ms: "Canceling
+            // draw, cancelDueToSync"), and hiding it showed the wallpaper layer or black under the
+            // exit. Its last frame is the same picture, so it stays up until the redraw arrives.
+            if (!(com.android.server.DecoyWallpaperHold.isActive()
+                    && w.mAttrs.type == android.view.WindowManager.LayoutParams
+                            .TYPE_STATUS_BAR_ADDITIONAL
+                    && "SwitchStage".contentEquals(w.mAttrs.getTitle()))) {
+                hide(t, "prepareSurfaceLocked");
+            }
             if (!w.mIsWallpaper) {
                 mWallpaperControllerLocked.hideWallpapers(w);
             }
-- 
