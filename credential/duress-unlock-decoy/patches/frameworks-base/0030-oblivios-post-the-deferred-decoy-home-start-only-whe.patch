From 3fce1a5b9e2a136afff86cf9340449ff4b46b229 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sat, 14 Nov 2026 15:01:34 +0100
Subject: [PATCH] oblivios: post the deferred decoy home start only when one is
 waiting, so an ordinary unlock posts nothing

---
 .../com/android/server/wm/ActivityTaskManagerService.java  | 7 +++++--
 .../java/com/android/server/wm/WindowManagerService.java   | 7 +++++++
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
index 651955c9..71a6cdcb 100644
--- a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
+++ b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
@@ -4308,8 +4308,11 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
                 // WindowManagerService#deferDecoyHomeStart). Not at once: the going-away can be
                 // merged into the user switch transition, which is still collecting for a moment,
                 // and a home started into it would bring back the wait for its first draw.
-                mH.postDelayed(mWindowManager::startDeferredDecoyHome,
-                        DEFERRED_DECOY_HOME_AFTER_GOING_AWAY_MS);
+                // Only when a home start is waiting: an ordinary unlock posts nothing.
+                if (mWindowManager.hasDeferredDecoyHome()) {
+                    mH.postDelayed(mWindowManager::startDeferredDecoyHome,
+                            DEFERRED_DECOY_HOME_AFTER_GOING_AWAY_MS);
+                }
 
                 final boolean foundResumed = wasNoResumed
                         && mTopApp != null && mTopApp.hasResumedActivity();
diff --git a/services/core/java/com/android/server/wm/WindowManagerService.java b/services/core/java/com/android/server/wm/WindowManagerService.java
index 3e8288d5..73e9007b 100644
--- a/services/core/java/com/android/server/wm/WindowManagerService.java
+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -4318,6 +4318,13 @@ public class WindowManagerService extends IWindowManager.Stub
         }
     }
 
+    /** ObliviOS: whether any home start is still deferred. */
+    boolean hasDeferredDecoyHome() {
+        synchronized (mGlobalLock) {
+            return mDeferredDecoyHomeUserId != UserHandle.USER_NULL;
+        }
+    }
+
     /** ObliviOS: whether the home start of {@code userId} is still deferred. */
     boolean isDecoyHomeDeferred(@UserIdInt int userId) {
         synchronized (mGlobalLock) {
-- 
2.47.3

