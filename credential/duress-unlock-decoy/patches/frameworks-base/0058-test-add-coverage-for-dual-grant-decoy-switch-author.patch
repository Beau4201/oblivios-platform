From 9dadf4735964dc14394c773c51e17b6fd479096c Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 03:58:09 +0200
Subject: [PATCH 1/3] test: add coverage for dual-grant decoy switch
 authorization consumption

---
 .../android/server/am/UserControllerTest.java | 95 +++++++++++++++++++
 1 file changed, 95 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
index 05da10ecc94b..5084ec03d186 100644
--- a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
@@ -2723,6 +2723,101 @@ public class UserControllerTest {
         assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
     }
 
+    // AegisOS: the bouncer-skip grant below is the second, independent single-use consumption
+    // point derived from the same mint as the forced-lock-skip grant above. See the class-level
+    // javadoc on mForcedLockSkipConsumed/mBouncerSkipConsumed in UserController for why one mint
+    // now supports two independent redemptions instead of one.
+
+    @Test
+    public void testDecoySwitchAuthorization_bouncerSkip_consumedOnceOnly() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_bouncerSkip_wrongUserIdDoesNotConsume() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_OTHER_USER_ID)).isFalse();
+        // The bouncer-skip grant must survive an attempt against the wrong id, not be silently
+        // burned.
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_bouncerSkip_expiredIsConsumedButNotHonoured() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_bouncerSkip_neverMintedIsNotHonoured() {
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_dualGrants_forcedLockThenBouncer_bothConsumedFromOneMint() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_dualGrants_bouncerThenForcedLock_bothConsumedFromOneMint() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_dualGrants_expiryAppliesToBothGrantsEvenIfOneAlreadyConsumedWithinWindow() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        // Consume the bouncer-skip grant right away, well inside the window.
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        // The forced-lock-skip grant is being consumed here for the first time, but the mint
+        // itself is now stale -- expiry is a property of the mint's own timestamp, not something
+        // reset independently per grant.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_dualGrants_reMintResetsBothGrants() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+
+        // A fresh mint always starts with fresh, unconsumed grants -- there is no way to "stack"
+        // a pending authorization across two mints.
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+    }
+
     @Test
     public void testForegroundSwitch_authorizedDecoy_doesNotForceKeyguard() throws Exception {
         setUserSecure(TEST_DECOY_USER_ID, true);
-- 
