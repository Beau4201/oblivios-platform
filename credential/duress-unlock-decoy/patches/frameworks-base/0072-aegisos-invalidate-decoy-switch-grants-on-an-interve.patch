From 540d4a0366f207523ee32415dd0d1d547c972c3f Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Fri, 11 Sep 2026 01:42:54 +0200
Subject: [PATCH 2/2] aegisos: invalidate decoy switch grants on an intervening
 switch

A review finding on Task 11c's active-dismiss grant found that
because it is redeemed only on user-driven interaction, it (and the
other two grants from the same mint) could remain outstanding for up
to their full 30-second window even after a second, distinct switch
event retargeted the device -- away from the already-authorized decoy
user id and back to it again -- through a route that never goes
through authorizeDecoySwitchKeyguardSkip's own credential check (the
lock-screen avatar switcher, or am switch-user over adb).

Add a monotonically-incrementing switch-sequence counter, advanced by
switchUser() and switchToUserSilently() every time a foreground switch
is actually initiated. A mint records the sequence value at the
moment it is made; the one switch it authorizes is given a single
exemption from advancing that value against its own mint (mint always
happens before its own switch is initiated, so the switch cannot be
identified any other way), but any switch after that -- to any user,
including a return to the same decoy id -- advances the sequence and
invalidates every grant still outstanding from that mint, exactly like
an expired mint: consumed-and-cleared, fails closed.
---
 .../com/android/server/am/UserController.java | 121 ++++++++++++++++--
 1 file changed, 109 insertions(+), 12 deletions(-)

diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index 16470a16afa9..36857406da07 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -526,11 +526,11 @@ class UserController implements Handler.Callback {
      * show a bouncer at all (e.g. on the user's first swipe) -- so one mint must be able to pay
      * out all three without any of them starving the others. The record is only fully cleared --
      * all three bits reset and mSwitchAuthorizedUserId reset to USER_NULL -- once all three
-     * grants have been redeemed, or once a redemption attempt finds the mint already expired,
-     * whichever happens first. This is deliberately not a general-purpose reusable flag: a fresh
-     * mint always overwrites the whole record, including all three bits, so there is still
-     * exactly one pending authorization possible at a time -- see
-     * authorizeDecoySwitchKeyguardSkip.
+     * grants have been redeemed, or once a redemption attempt finds the mint already expired or
+     * superseded by an intervening switch (see mSwitchAuthorizedAtSequence), whichever happens
+     * first. This is deliberately not a general-purpose reusable flag: a fresh mint always
+     * overwrites the whole record, including all three bits, so there is still exactly one
+     * pending authorization possible at a time -- see authorizeDecoySwitchKeyguardSkip.
      */
     @GuardedBy("mLock")
     private boolean mForcedLockSkipConsumed;
@@ -553,6 +553,51 @@ class UserController implements Handler.Callback {
     @GuardedBy("mLock")
     private boolean mActiveDismissConsumed;
 
+    /**
+     * AegisOS: monotonically-incrementing counter, advanced once for every foreground user
+     * switch actually initiated by switchUser()/switchToUserSilently() (see
+     * recordSwitchInitiatedLocked) -- never for a no-op switch to the already-current user, and
+     * never merely for a switch enqueued behind one already in progress (its own eventual
+     * dispatch, via endUserSwitch's re-entrant switchUser() call, is what actually advances this
+     * once it starts for real). Exists solely so the decoy switch authorization above can detect
+     * whether some OTHER switch has begun since the one it authorizes -- closing a review
+     * finding: an outstanding grant from an earlier mint must not survive a second,
+     * independently-unauthorized switch event, even one that later returns to the exact same
+     * already-authorized decoy user id (e.g. switching away from the decoy and back again
+     * through a route -- the lock-screen avatar switcher, or {@code am switch-user} over adb --
+     * that never goes through authorizeDecoySwitchKeyguardSkip's own real credential check). See
+     * mSwitchAuthorizedAtSequence and mAwaitingAuthorizedSwitch.
+     */
+    @GuardedBy("mLock")
+    private long mSwitchSequenceNumber;
+
+    /**
+     * AegisOS: the value of mSwitchSequenceNumber recorded the moment the current mint was made.
+     * Deliberately captured at mint time and never itself advanced for the mint's own authorized
+     * switch -- see mAwaitingAuthorizedSwitch for why the one switch this mint is for must not
+     * count as an "other" switch. A redemption of any of the three grants above is only honoured
+     * while mSwitchSequenceNumber still equals this value, i.e. no switch besides the one this
+     * mint authorizes has been initiated since the mint was made.
+     */
+    @GuardedBy("mLock")
+    private long mSwitchAuthorizedAtSequence;
+
+    /**
+     * AegisOS: true from the moment a mint is made until the one switch it authorizes has
+     * actually been initiated (see recordSwitchInitiatedLocked), then permanently false until
+     * the next mint. authorizeDecoySwitchKeyguardSkip always runs strictly before the switch it
+     * is for is ever initiated -- DecoyProfileHelper mints synchronously and only afterwards
+     * posts the real switchToUserSilently call -- so the switch-sequence number of "the switch
+     * this mint is for" genuinely isn't known yet at mint time. This flag grants that one,
+     * specific, still-pending switch a single exemption from bumping mSwitchSequenceNumber
+     * against its own mint, without exempting any switch that comes after it. A second switch to
+     * the same decoy id, once this flag is already false, is exactly the gap this mechanism
+     * exists to close: it bumps the sequence like any other switch and invalidates every
+     * outstanding grant from the earlier mint.
+     */
+    @GuardedBy("mLock")
+    private boolean mAwaitingAuthorizedSwitch;
+
     private final UserLifecycleListener mUserLifecycleListener = new UserLifecycleListener() {
         @Override
         public void onUserCreated(UserInfo user, Object token) {
@@ -2654,6 +2699,7 @@ class UserController implements Handler.Callback {
             }
             mTargetUserId = targetUserId;
             ActivityManager.invalidateGetCurrentUserIdCache();
+            recordSwitchInitiatedLocked(targetUserId);
             userSwitchUiEnabled = mUserSwitchUiEnabled;
         }
         if (userSwitchUiEnabled) {
@@ -2712,6 +2758,7 @@ class UserController implements Handler.Callback {
             }
             mTargetUserId = targetUserId;
             ActivityManager.invalidateGetCurrentUserIdCache();
+            recordSwitchInitiatedLocked(targetUserId);
         }
         sendStartUserSwitchFgMessage(targetUserId);
         return true;
@@ -2735,6 +2782,8 @@ class UserController implements Handler.Callback {
         synchronized (mLock) {
             mSwitchAuthorizedUserId = targetUserId;
             mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
+            mSwitchAuthorizedAtSequence = mSwitchSequenceNumber;
+            mAwaitingAuthorizedSwitch = true;
             // A fresh mint always starts all three grants unconsumed, even if the previous
             // mint's record (for what can structurally only ever be the same decoy id) was
             // never fully redeemed -- there is still only ever one pending authorization at a
@@ -2839,11 +2888,14 @@ class UserController implements Handler.Callback {
      * Matches userId and evaluates expiry against the mint's own timestamp -- expiry is a
      * property of the mint, not tracked separately per grant, so a grant redeemed for the first
      * time after the mint has already expired still returns false here even if another grant
-     * was already redeemed successfully within the window. Marks exactly the named grant
-     * consumed (a grant already consumed short-circuits to false without touching anything
-     * else) and fully clears the record -- all three bits and the authorized id -- once all
-     * three grants are consumed, or the instant any redemption attempt finds the mint expired,
-     * whichever comes first.
+     * was already redeemed successfully within the window. Also requires that no switch besides
+     * the one this mint authorizes has been initiated since the mint was made (see
+     * mSwitchAuthorizedAtSequence) -- an independent gate from expiry, evaluated the same way:
+     * both must hold for a redemption to be honoured. Marks exactly the named grant consumed (a
+     * grant already consumed short-circuits to false without touching anything else) and fully
+     * clears the record -- all three bits, the authorized id, and the sequence binding -- once
+     * all three grants are consumed, or the instant any redemption attempt finds the mint
+     * invalid (expired, or superseded by an intervening switch), whichever comes first.
      */
     @GuardedBy("mLock")
     private boolean consumeGrantLocked(int userId, DecoySwitchGrant grant) {
@@ -2856,16 +2908,61 @@ class UserController implements Handler.Callback {
         final long ageMillis = mInjector.elapsedRealtime() - mSwitchAuthorizedAtMillis;
         final boolean withinWindow =
                 ageMillis >= 0 && ageMillis <= DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS;
+        // AegisOS: an intervening switch -- to any user, not just this one, and even one that
+        // later returns to this exact user id -- advances mSwitchSequenceNumber past the value
+        // recorded at mint time. Treated exactly like expiry: honoured once, then never again.
+        // See mSwitchAuthorizedAtSequence and mAwaitingAuthorizedSwitch for why the mint's own
+        // authorized switch itself never counts as "intervening".
+        final boolean noInterveningSwitch = mSwitchAuthorizedAtSequence == mSwitchSequenceNumber;
+        final boolean valid = withinWindow && noInterveningSwitch;
         markGrantConsumedLocked(grant);
-        if (!withinWindow
+        if (!valid
                 || (mForcedLockSkipConsumed && mBouncerSkipConsumed && mActiveDismissConsumed)) {
             mSwitchAuthorizedUserId = UserHandle.USER_NULL;
             mSwitchAuthorizedAtMillis = 0L;
+            mSwitchAuthorizedAtSequence = 0L;
+            mAwaitingAuthorizedSwitch = false;
             mForcedLockSkipConsumed = false;
             mBouncerSkipConsumed = false;
             mActiveDismissConsumed = false;
         }
-        return withinWindow;
+        return valid;
+    }
+
+    /**
+     * AegisOS: records that a foreground switch to targetUserId has just been initiated. Must
+     * only be called from within the synchronized block that actually starts a switch
+     * (switchUser() and switchToUserSilently(), immediately after mTargetUserId is set) -- never
+     * for a no-op return to the already-current user, and never for a switch merely enqueued
+     * behind one already in flight (see mPendingTargetUserIds; its eventual dispatch re-enters
+     * switchUser() for real and calls this again then, when it actually starts). See
+     * mSwitchSequenceNumber and mAwaitingAuthorizedSwitch.
+     */
+    @GuardedBy("mLock")
+    private void recordSwitchInitiatedLocked(int targetUserId) {
+        if (mAwaitingAuthorizedSwitch && targetUserId == mSwitchAuthorizedUserId) {
+            // This is the one switch the outstanding mint is for -- consume its single
+            // exemption without advancing the sequence, so this mint's own later grant
+            // redemptions still match mSwitchAuthorizedAtSequence.
+            mAwaitingAuthorizedSwitch = false;
+            return;
+        }
+        mSwitchSequenceNumber++;
+    }
+
+    /**
+     * AegisOS: exercises the exact same switch-initiation bookkeeping switchUser() and
+     * switchToUserSilently() perform for a real switch (see recordSwitchInitiatedLocked),
+     * without needing to drive either method's full production machinery (doesUserSupportSwitchTo,
+     * UserManagerInternal, the handler thread, the user-switch-UI dialog, etc.) just to prove the
+     * decoy switch authorization's own intervening-switch detection. Never called from
+     * production code.
+     */
+    @VisibleForTesting
+    void noteForegroundSwitchInitiatedForTests(int targetUserId) {
+        synchronized (mLock) {
+            recordSwitchInitiatedLocked(targetUserId);
+        }
     }
 
     private void sendStartUserSwitchFgMessage(int targetUserId) {
