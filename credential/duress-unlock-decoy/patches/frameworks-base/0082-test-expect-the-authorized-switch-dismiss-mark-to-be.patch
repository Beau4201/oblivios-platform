From ad4c9b5b4ca07c317cf3e1d72cd2c6f6afa728ff Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Wed, 16 Sep 2026 22:07:51 +0200
Subject: [PATCH 82/85] test: expect the authorized-switch dismiss mark to be
 single-use

Covers the mark KeyguardUnlockAnimationController consumes to suppress
the canned unlock animation: set exactly once by the authorized branch,
never by an ordinary secure-user switch, and cleared by an intervening
switch so it cannot suppress the animation of an unrelated later exit.
---
 .../keyguard/KeyguardViewMediatorTest.java    | 83 +++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index cbc66df27a4e..9c2c8c6a44a6 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -683,6 +683,89 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         assertEquals(0, flagsCaptor.getValue() & KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS);
     }
 
+    /**
+     * AegisOS: the mark KeyguardUnlockAnimationController#playCannedUnlockAnimation consumes to
+     * suppress the canned unlock animation. Setting
+     * KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS alone was confirmed on hardware not to
+     * suppress it, because the going-away is merged into the user-switch transition and animated
+     * by the Shell's KeyguardTransitionHandler, which never reads that flag.
+     */
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testAuthorizedSwitchDismissIsConsumedExactlyOnce() {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(true);
+
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        processAllMessagesAndBgExecutorMessages();
+
+        // Single-use, matching the single-use authorization behind it: the exit it belongs to
+        // gets it, and nothing afterwards does.
+        assertTrue(mViewMediator.consumeAuthorizedSwitchDismiss());
+        assertFalse(mViewMediator.consumeAuthorizedSwitchDismiss());
+    }
+
+    /**
+     * AegisOS: the ADR-061 regression property for the animation suppression -- an ordinary
+     * secure-user switch must never mark a dismissal for it.
+     */
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testUnauthorizedSwitchNeverMarksDismissForAnimationSuppression() {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(false);
+
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        processAllMessagesAndBgExecutorMessages();
+
+        assertFalse(mViewMediator.consumeAuthorizedSwitchDismiss());
+    }
+
+    /**
+     * AegisOS: an intervening switch cancels the dismissal the mark belongs to, so it must not
+     * survive to suppress the animation of some later, unrelated exit.
+     */
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testInterveningSwitchClearsAuthorizedSwitchDismiss() {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(true);
+
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        processAllMessagesAndBgExecutorMessages();
+
+        int interveningUserId = 501;
+        setCurrentUser(interveningUserId, /* isSecure= */true);
+        mViewMediator.handleBeforeUserSwitching(interveningUserId, mock(Runnable.class));
+        processAllMessagesAndBgExecutorMessages();
+
+        assertFalse(mViewMediator.consumeAuthorizedSwitchDismiss());
+    }
+
     @Test
     @TestableLooper.RunWithLooper(setAsMainLooper = true)
     public void testUserSwitchToInsecureUserDismissesKeyguard() {
