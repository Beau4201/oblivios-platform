From 7650c66f2429646bed66e449194bcd8d25372b54 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 02:09:03 +0200
Subject: [PATCH 56/85] aegisos: stop an unused warm-started decoy on real
 credential match

onKeyguardLockedStateChanged warm-starts the registered decoy in the
background on the first keyguard lock but never stops it. Since the
keyguard fires on essentially every lock, the decoy ends up sitting
RUNNING_LOCKED for the rest of the boot session even when it is never
actually switched to, defeating warm-start's own reason for existing
over a permanently resident decoy.

Add DecoyProfileHelper#maybeStopUnusedWarmDecoy, called from
doVerifyCredentialInner right after the real owner's own primary
credential is confirmed matched for UserHandle.USER_SYSTEM. If the
warm-started target is running but is not the current foreground user,
stop it via IActivityManager#stopUserWithCallback -- the same real API
UserManagerService#stopUserForQuietMode already uses to stop a
background user cleanly. Dispatched on the handler, never inline on
the credential-verification thread.

This cannot race a genuine switched-to session: performDecoySwitch
only runs when the decoy's own credential matched, this method only
runs when the real owner's credential matched, and those are mutually
exclusive outcomes of the same verify call. UserController#stopUsersLU
also independently refuses to stop whichever user is currently in the
foreground, regardless of any caller-side check.
---
 .../locksettings/DecoyProfileHelper.java      | 59 +++++++++++++++++++
 .../locksettings/LockSettingsService.java     |  5 ++
 2 files changed, 64 insertions(+)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 833908ee3569..919d59ba1963 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -129,6 +129,65 @@ class DecoyProfileHelper {
         }
     }
 
+    /**
+     * Called from doVerifyCredentialInner immediately after the real owner's own primary
+     * credential is confirmed matched for UserHandle.USER_SYSTEM -- the signal that a decoy
+     * warm-started by onKeyguardLockedStateChanged, if any, was never actually needed this time.
+     * Without this, a decoy warm-started on the very first lock after boot would stay
+     * RUNNING_LOCKED for the rest of the boot session even when the owner just unlocks normally
+     * every time, defeating warm-start's own reason for existing over a permanently resident
+     * decoy (avoiding continuous battery/RAM cost). See "Warm start" in
+     * docs/superpowers/specs/2026-09-07-duress-decoy-seamless-unlock-design.md in the
+     * aegisos-foundation repository.
+     *
+     * <p>Dispatched onto the handler internally (mirrors maybeRouteToDecoy's own
+     * getHandler().post pattern), never inline on the credential-verification thread -- this
+     * runs after doVerifyCredentialInner has already computed its response, so nothing here can
+     * affect what the caller receives.
+     *
+     * <p>This can never race or interrupt a real, in-progress warm-started-then-switched-to
+     * session, for two independent reasons:
+     * <ul>
+     *   <li>By construction: a live session on the warm-started target is only ever reached via
+     *       performDecoySwitch, which runs when maybeRouteToDecoy's own doVerifyCredentialInner
+     *       call matched the decoy's credential. This method instead runs when the *real* owner's
+     *       credential matched. Those are two mutually exclusive outcomes of the same verify
+     *       call for UserHandle.USER_SYSTEM -- one credential cannot satisfy both at once, so this
+     *       method and a freshly switched-to session are never both reachable from the same
+     *       credential check.
+     *   <li>Independently, even if that reasoning were ever wrong: the current-foreground-user
+     *       check below refuses to stop the target if it is the current user, and
+     *       UserController#stopUsersLU -- the real code eventually reached through
+     *       IActivityManager#stopUserWithCallback below -- unconditionally refuses to stop
+     *       whichever user is currently in the foreground (returns USER_OP_IS_CURRENT) as a
+     *       built-in AOSP safety check, not something this class relies on being correct on its
+     *       own.
+     * </ul>
+     */
+    void maybeStopUnusedWarmDecoy() {
+        getHandler().post(() -> {
+            DecoyProfileState state = DecoyProfileState.maybeGet(lockSettingsStorage);
+            if (state == null) {
+                return;
+            }
+            ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+            if (ami == null || !ami.isUserRunning(state.decoyUserId, /* flags= */ 0)) {
+                // Never started, or already stopped -- nothing to do.
+                return;
+            }
+            if (ActivityManager.getCurrentUser() == state.decoyUserId) {
+                // A live foreground session -- never stop this.
+                return;
+            }
+            IActivityManager am = ActivityManager.getService();
+            try {
+                am.stopUserWithCallback(state.decoyUserId, /* callback= */ null);
+            } catch (RemoteException e) {
+                Slog.w(TAG, "Failed to stop unused warm-started credential-routing target", e);
+            }
+        });
+    }
+
     /**
      * Called from doVerifyCredentialInner immediately before it would otherwise return a
      * not-matched response for UserHandle.USER_SYSTEM under LockDomain.Primary. Returns a
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index 2d210cf43256..ace3a8f32966 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -2875,6 +2875,11 @@ public class LockSettingsService extends ILockSettings.Stub {
                                     .build();
                 }
                 sendCredentialsOnUnlockIfRequired(credential, userId, lockDomain);
+                if (userId == UserHandle.USER_SYSTEM && lockDomain == Primary) {
+                    // The real owner's own credential just matched -- reap a decoy that was
+                    // warm-started speculatively on keyguard-show but never actually switched to.
+                    decoyProfileHelper.maybeStopUnusedWarmDecoy();
+                }
             } else if (response.hasTimeout() && response.getTimeoutAsDuration().isPositive()) {
                 requireStrongAuth(STRONG_AUTH_REQUIRED_AFTER_LOCKOUT, userId);
             }
