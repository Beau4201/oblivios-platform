From 112d957204edd3c40dde88228495a8ab07ba02e0 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 12 Nov 2026 17:06:05 +0100
Subject: [PATCH] oblivios: mirror the decoy settings when the device locks and
 never copy custom tiles

Two review findings on the previous commit. A quick-settings tile list holds custom(package/service) entries naming apps of the owner, so only built-in tiles are copied. The copy ran before the switch, on the critical path of the duress unlock; it now runs when the keyguard locks, after the decoy is started, so it adds nothing to the unlock time.
---
 .../locksettings/DecoyProfileHelper.java      | 25 ++++++++++++-------
 .../locksettings/DecoySettingsMirror.java     | 23 ++++++++++++++++-
 .../locksettings/DecoySettingsMirrorTest.java | 19 ++++++++++++++
 3 files changed, 57 insertions(+), 10 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 1e8717c0..1f952c61 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -139,15 +139,23 @@ class DecoyProfileHelper {
             return;
         }
         ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
-        if (ami == null || ami.isUserRunning(state.decoyUserId, /* flags= */ 0)) {
+        if (ami == null) {
             return;
         }
-        IActivityManager am = ActivityManager.getService();
-        try {
-            am.startUserInBackground(state.decoyUserId);
-        } catch (RemoteException e) {
-            Slog.w(TAG, "Failed to start background credential-routing target", e);
+        if (!ami.isUserRunning(state.decoyUserId, /* flags= */ 0)) {
+            IActivityManager am = ActivityManager.getService();
+            try {
+                am.startUserInBackground(state.decoyUserId);
+            } catch (RemoteException e) {
+                Slog.w(TAG, "Failed to start background credential-routing target", e);
+                return;
+            }
         }
+        // ObliviOS: the owner's screen settings are copied here, when the device locks, not at the
+        // switch: the mirror stays off the critical path of the duress unlock (a few binder calls
+        // would add to a time that has to equal the ordinary one). The owner can change brightness
+        // from the lock screen's quick settings afterwards; that gap is measured in DUR-037.
+        mirrorOwnerSettingsToDecoy(UserHandle.USER_SYSTEM, state.decoyUserId);
     }
 
     /**
@@ -374,8 +382,8 @@ class DecoyProfileHelper {
     /**
      * ObliviOS: the owner's brightness, screen timeout, rotation and lock-screen toggles are
      * copied to the decoy before the switch to it, so the screen does not change at the switch
-     * (DUR-037). One way, owner to decoy; only runs on the decoy route, so a device without a
-     * matching decoy credential pays nothing. A refused write is logged by key, never thrown.
+     * (DUR-037). One way, owner to decoy; runs only when a decoy is registered, so a device without a
+     * decoy pays nothing. A refused write is logged by key, never thrown.
      */
     private void mirrorOwnerSettingsToDecoy(int realUserId, int decoyUserId) {
         final ContentResolver resolver = context.getContentResolver();
@@ -427,7 +435,6 @@ class DecoyProfileHelper {
         // A no-op for the typed credential, which waited before OK; the finger route is called on
         // the biometric callback thread and waits here, on this handler, instead.
         awaitDecoyUnlocked(decoyUserId);
-        mirrorOwnerSettingsToDecoy(realUserId, decoyUserId);
         ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
         if (ami == null || !ami.switchToUserSilently(decoyUserId)) {
             DecoyRoutingFailureMarker.record(lockSettingsStorage,
diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
index 0646c0ef..57401177 100644
--- a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -60,11 +60,32 @@ final class DecoySettingsMirror {
         return failed;
     }
 
+    /**
+     * What may be copied of a value, or null to skip the key. A quick-settings tile list holds
+     * "custom(package/service)" entries that name apps of the owner, so only the built-in tiles
+     * are copied: the decoy must never learn which apps the owner has installed.
+     */
+    private static String filter(String key, String value) {
+        if (value == null || !"sysui_qs_tiles".equals(key)) {
+            return value;
+        }
+        StringBuilder kept = new StringBuilder();
+        for (String tile : value.split(",")) {
+            if (!tile.isEmpty() && !tile.startsWith("custom(")) {
+                if (kept.length() > 0) {
+                    kept.append(',');
+                }
+                kept.append(tile);
+            }
+        }
+        return kept.length() == 0 ? null : kept.toString();
+    }
+
     private static void copy(Store store, String namespace, String[] keys, int fromUserId,
             int toUserId, List<String> failed) {
         for (String key : keys) {
             try {
-                String value = store.get(namespace, key, fromUserId);
+                String value = filter(key, store.get(namespace, key, fromUserId));
                 if (value != null) {
                     store.put(namespace, key, value, toUserId);
                 }
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
index f1aee6cd..758b8aa0 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -118,6 +118,25 @@ public class DecoySettingsMirrorTest {
         assertEquals("9", s.get(DecoySettingsMirror.SYSTEM, "screen_brightness", DECOY));
     }
 
+    @Test
+    public void customTilesOfTheOwnerAreNeverCopied() {
+        // A custom tile names an installed app of the owner; the decoy must not learn it.
+        FakeStore s = ownerWithEveryKey();
+        s.set(DecoySettingsMirror.SECURE, "sysui_qs_tiles", OWNER,
+                "wifi,custom(com.owner.private/.Tile),bt,custom(org.x/.Y)");
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertEquals("wifi,bt", s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
+    }
+
+    @Test
+    public void aTileListOfOnlyCustomTilesIsSkipped() {
+        FakeStore s = ownerWithEveryKey();
+        s.set(DecoySettingsMirror.SECURE, "sysui_qs_tiles", OWNER, "custom(com.owner.private/.Tile)");
+        s.set(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY, "decoy-own");
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertEquals("decoy-own", s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
+    }
+
     @Test
     public void sameUserWritesNothing() {
         FakeStore s = ownerWithEveryKey();
