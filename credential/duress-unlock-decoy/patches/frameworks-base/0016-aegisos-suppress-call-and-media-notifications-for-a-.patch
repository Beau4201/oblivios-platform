From: AegisOS Build <build@aegisos.local>
Date: Thu, 27 Aug 2026 08:49:33 +0200
Subject: [PATCH 16/89] aegisos: suppress call and media notifications for a
 duress-quiesced user

---
 .../server/notification/NotificationManagerService.java     | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/notification/NotificationManagerService.java b/services/core/java/com/android/server/notification/NotificationManagerService.java
index beda9c6b9757..c2a2c2cde5f9 100644
--- a/services/core/java/com/android/server/notification/NotificationManagerService.java
+++ b/services/core/java/com/android/server/notification/NotificationManagerService.java
@@ -10314,7 +10314,8 @@ public class NotificationManagerService extends SystemService {
             }
         }
 
-        if (mAmi.isUserQuiescedForDuress(userId)) {
+        boolean quiescedForDuress = mAmi.isUserQuiescedForDuress(userId);
+        if (quiescedForDuress) {
             isBlocked = true;
             if (DBG) {
                 Slog.e(TAG, "Suppressing notification from package " + pkg
@@ -10322,7 +10323,8 @@ public class NotificationManagerService extends SystemService {
             }
         }
 
-        if (isBlocked && !(n.isMediaNotification() || isCallNotification(pkg, uid, n))) {
+        if (isBlocked && (quiescedForDuress
+                || !(n.isMediaNotification() || isCallNotification(pkg, uid, n)))) {
             if (DBG) {
                 Slog.e(TAG, "Suppressing notification from package " + r.getSbn().getPackageName()
                         + " by user request.");
