From d8bac87cb4657cc7e9d08fbf7378fe39e55662ca Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@oblivios.local>
Date: Mon, 16 Nov 2026 03:25:00 +0100
Subject: [PATCH] oblivios: a recorded decoy routing failure is cleared at the
 next real unlock

Review D10. DecoyRoutingFailureMarker kept the time of every failed routing in
the lock settings of user 0, where nothing cleared it, so a forensic read after
a boot showed that and when a decoy switch ran. LockSettingsService now clears
it when the owner's own credential unlocks user 0 on the primary domain.
---
 .../server/locksettings/DecoyRoutingFailureMarker.java    | 8 ++++++++
 .../android/server/locksettings/LockSettingsService.java  | 2 ++
 2 files changed, 10 insertions(+)

diff --git a/services/core/java/com/android/server/locksettings/DecoyRoutingFailureMarker.java b/services/core/java/com/android/server/locksettings/DecoyRoutingFailureMarker.java
index 5264d70..1f72362 100644
--- a/services/core/java/com/android/server/locksettings/DecoyRoutingFailureMarker.java
+++ b/services/core/java/com/android/server/locksettings/DecoyRoutingFailureMarker.java
@@ -50,6 +50,14 @@ class DecoyRoutingFailureMarker {
                 LOCK_SETTINGS_STORAGE_USER_ID);
     }
 
+    /**
+     * Forgets the recorded failure. Called when the real owner's own credential unlocks the phone, so a marker
+     * does not outlive the next real unlock and leave a trace that a decoy switch ran (review D10).
+     */
+    static void clear(LockSettingsStorage lss) {
+        lss.removeKey(LOCK_SETTINGS_STORAGE_KEY, LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+
     /** Human-readable description of the most recently recorded failure, or its absence. */
     static String describe(LockSettingsStorage lss) {
         String s = lss.getString(LOCK_SETTINGS_STORAGE_KEY, null, LOCK_SETTINGS_STORAGE_USER_ID);
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index 42ea844..c8aefc1 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -2897,6 +2897,8 @@ public class LockSettingsService extends ILockSettings.Stub {
                     // ObliviOS: unwrap the decoy credential for the Duress Unlock finger while
                     // the synthetic password is still in hand.
                     decoyFingerHelper.onOwnerSyntheticPasswordUnlocked(authResult.syntheticPassword);
+                    // ObliviOS: a recorded routing failure does not outlive the next real unlock (D10).
+                    DecoyRoutingFailureMarker.clear(mStorage);
                 }
             } else if (response.hasTimeout() && response.getTimeoutAsDuration().isPositive()) {
                 requireStrongAuth(STRONG_AUTH_REQUIRED_AFTER_LOCKOUT, userId);
-- 
