From fdf578235be412bee87128fb2af03ac77255974c Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Wed, 4 Nov 2026 20:40:30 +0100
Subject: [PATCH] oblivios: a failure restoring the duress finger link never
 fails the owner's unlock

onOwnerSyntheticPasswordUnlocked runs inside doVerifyCredentialInner of the real owner with no try: an unexpected RuntimeException from the storage read or the key derivation would have failed the owner's own unlock on every attempt. The helper now catches it, leaves the cache empty (the finger fails closed) and logs.
---
 .../locksettings/DecoyFingerHelper.java       | 32 +++++++++++--------
 1 file changed, 19 insertions(+), 13 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
index c772923..796a2b6 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
@@ -137,20 +137,26 @@ class DecoyFingerHelper {
      * undecryptable blob leaves the cache empty, so the finger fails closed.
      */
     void onOwnerSyntheticPasswordUnlocked(SyntheticPassword ownerSp) {
-        final DecoyFingerCodec.State state = readState();
-        if (state == null) {
-            return;
-        }
-        final byte[] plain = SyntheticPasswordCrypto.decrypt(ownerSp.deriveDecoyFingerKey(),
-                WRAP_PERSONALIZATION, state.wrapped);
-        if (plain == null) {
-            Slog.w(TAG, "The decoy finger link could not be unwrapped");
-            return;
-        }
+        // This runs inside the real owner's credential check: whatever goes wrong here leaves the cache empty (the finger
+        // fails closed) and must never fail the owner's own unlock.
         try {
-            setCache(plain);
-        } finally {
-            Arrays.fill(plain, (byte) 0);
+            final DecoyFingerCodec.State state = readState();
+            if (state == null) {
+                return;
+            }
+            final byte[] plain = SyntheticPasswordCrypto.decrypt(ownerSp.deriveDecoyFingerKey(),
+                    WRAP_PERSONALIZATION, state.wrapped);
+            if (plain == null) {
+                Slog.w(TAG, "The decoy finger link could not be unwrapped");
+                return;
+            }
+            try {
+                setCache(plain);
+            } finally {
+                Arrays.fill(plain, (byte) 0);
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "The decoy finger link could not be restored", e);
         }
     }
 
-- 
