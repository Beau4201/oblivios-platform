From 0239f1adbfde3541d2e210a4a85f8760f3ec4ace Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 14:28:11 +0100
Subject: [PATCH] oblivios: the stage of an authorized switch follows the
 wallpaper zoom, so the hand-over to the real wallpaper has no jump

---
 .../keyguard/AuthorizedSwitchStage.java       | 39 +++++++++++++++++++
 .../NotificationShadeDepthController.kt       |  3 ++
 2 files changed, 42 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
index f05e7110..19dbec7a 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -59,6 +59,40 @@ public final class AuthorizedSwitchStage {
     private View mView;
     private WindowManager mStageWm;
 
+    /**
+     * The zoom the wallpaper layer has: the window manager scales it by lerp(min, max, 1 - zoomOut)
+     * (WallpaperController#zoomOutToScale), and SystemUI sends zoomOut from the blur of the shade
+     * (NotificationShadeDepthController#onZoomOutChanged), 1 with the pad up and 0 with the shade
+     * gone. The picture of the stage is the wallpaper at zoomOut 1; the real home is 10% larger
+     * (lynx 2026-11-15, frames: the stage picture scaled by 1.10 equals the home, mean error 7.1
+     * against 1.2), which showed as the background zooming in when the stage gave way. The stage
+     * follows the same value, so the hand-over has no jump.
+     */
+    private static volatile float sZoomOut = 1f;
+    private static volatile AuthorizedSwitchStage sShown;
+
+    /** Called by the depth controller on every zoom value it sends to the wallpaper. Main thread. */
+    public static void onZoomOut(float zoomOut) {
+        sZoomOut = zoomOut;
+        final AuthorizedSwitchStage stage = sShown;
+        if (stage != null) {
+            stage.applyZoom();
+        }
+    }
+
+    private void applyZoom() {
+        final View view = mView;
+        if (view == null) {
+            return;
+        }
+        final android.content.res.Resources res = mContext.getResources();
+        final float min = res.getFloat(com.android.internal.R.dimen.config_wallpaperMinScale);
+        final float max = res.getFloat(com.android.internal.R.dimen.config_wallpaperMaxScale);
+        final float scale = android.util.MathUtils.lerp(min, max, 1f - sZoomOut) / min;
+        view.setScaleX(scale);
+        view.setScaleY(scale);
+    }
+
     /**
      * The window manager of a window token of the stage's own. With the context of the keyguard the
      * stage got the token of SystemUI's other windows and was hidden together with the notification
@@ -151,6 +185,8 @@ public final class AuthorizedSwitchStage {
             try {
                 stageWindowManager().addView(view, lp);
                 mView = view;
+                sShown = this;
+                applyZoom();
             } catch (RuntimeException e) {
                 warn("Could not add the stage window", e);
                 return;
@@ -190,6 +226,9 @@ public final class AuthorizedSwitchStage {
             // not registered: the window was never added
         }
         mBitmap = null;
+        if (sShown == this) {
+            sShown = null;
+        }
         if (mView == null) {
             return;
         }
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt b/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt
index 65c93346..97cf0e3b 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt
@@ -370,6 +370,9 @@ constructor(
     private fun onZoomOutChanged(zoomOutFromShadeRadius: Float) {
         TrackTracer.instantForGroup("shade", "zoom_out", zoomOutFromShadeRadius)
         Log.v(TAG, "onZoomOutChanged $zoomOutFromShadeRadius")
+        // ObliviOS: the stage of an authorized switch draws the wallpaper itself and follows the
+        // zoom that the window manager applies to the wallpaper layer (AuthorizedSwitchStage).
+        com.android.systemui.keyguard.AuthorizedSwitchStage.onZoomOut(zoomOutFromShadeRadius)
         keyguardInteractor.setZoomOut(zoomOutFromShadeRadius)
     }
 
-- 
