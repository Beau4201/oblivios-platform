index 00000000..c6766677
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoyLauncherLook.java
@@ -0,0 +1,121 @@
+package com.android.server.locksettings;
+
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import java.util.Objects;
+
+/**
+ * ObliviOS: the look of a user's Launcher3 home (themed icons, icon shape, hidden labels), read and
+ * written through the launcher's own grid control provider, which accepts a caller that holds
+ * BIND_WALLPAPER (system_server does). The launcher keeps these values in its prefs file in
+ * credential-encrypted storage: that file is owned by the app (mode 660) and system_server has no
+ * DAC override, so it cannot edit the file, and the owner's prefs file is unreadable for it too.
+ *
+ * <p>The decoy home showed default icons where the owner's are themed and square with no labels, a
+ * difference a second person sees. The owner's look is read when the device locks (the owner's
+ * launcher is running) and written to the decoy after its storage is unlocked and before its home is
+ * started (see DecoyProfileHelper#applyOwnerLookToDecoy).
+ */
+final class DecoyLauncherLook {
+    private static final String TAG = "CredentialRoutingHelper";
+    private static final String AUTHORITY = "content://com.android.launcher3.grid_control";
+    private static final String BOOLEAN_VALUE = "boolean_value";
+
+    final boolean themedIcons;
+    final boolean labelsHidden;
+    /** The key of the icon shape, empty when the launcher reports none. */
+    final String shapeKey;
+
+    DecoyLauncherLook(boolean themedIcons, boolean labelsHidden, String shapeKey) {
+        this.themedIcons = themedIcons;
+        this.labelsHidden = labelsHidden;
+        this.shapeKey = shapeKey == null ? "" : shapeKey;
+    }
+
+    /** The look of {@code userId}'s launcher, or null when it cannot be read. */
+    static DecoyLauncherLook read(Context context, int userId) {
+        try {
+            final ContentResolver cr = resolverOf(context, userId);
+            final Boolean themed = readBoolean(cr, "/icon_themed");
+            final Boolean hidden = readBoolean(cr, "/workspace_items_label_hidden");
+            String shape = "";
+            try (Cursor c = cr.query(Uri.parse(AUTHORITY + "/shape_options"), null, null, null,
+                    null)) {
+                while (c != null && c.moveToNext()) {
+                    if (c.getInt(c.getColumnIndexOrThrow("is_default")) != 0) {
+                        shape = c.getString(c.getColumnIndexOrThrow("shape_key"));
+                        break;
+                    }
+                }
+            }
+            if (themed == null || hidden == null) {
+                return null;
+            }
+            return new DecoyLauncherLook(themed, hidden, shape);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not read the launcher look of user " + userId, e);
+            return null;
+        }
+    }
+
+    /**
+     * Writes this look to {@code userId}'s launcher, every part that differs from what the launcher
+     * reports. Each write is a binder call into the launcher process of that user, so a look that
+     * is already equal costs three reads and no write. A refused write is logged, never thrown.
+     */
+    void applyTo(Context context, int userId) {
+        try {
+            final ContentResolver cr = resolverOf(context, userId);
+            final DecoyLauncherLook current = read(context, userId);
+            if (current == null || current.themedIcons != themedIcons) {
+                writeBoolean(cr, "/icon_themed", themedIcons);
+            }
+            if (current == null || current.labelsHidden != labelsHidden) {
+                writeBoolean(cr, "/set_workspace_items_label_hidden", labelsHidden);
+            }
+            if (!shapeKey.isEmpty() && (current == null || !shapeKey.equals(current.shapeKey))) {
+                final ContentValues v = new ContentValues();
+                v.put("shape_key", shapeKey);
+                cr.update(Uri.parse(AUTHORITY + "/shape"), v, null, null);
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not apply the launcher look to user " + userId, e);
+        }
+    }
+
+    private static ContentResolver resolverOf(Context context, int userId) {
+        return context.createContextAsUser(UserHandle.of(userId), 0).getContentResolver();
+    }
+
+    private static Boolean readBoolean(ContentResolver cr, String path) {
+        try (Cursor c = cr.query(Uri.parse(AUTHORITY + path), null, null, null, null)) {
+            if (c == null || !c.moveToFirst()) {
+                return null;
+            }
+            return c.getInt(c.getColumnIndexOrThrow(BOOLEAN_VALUE)) != 0;
+        }
+    }
+
+    private static void writeBoolean(ContentResolver cr, String path, boolean value) {
+        final ContentValues v = new ContentValues();
+        v.put(BOOLEAN_VALUE, value);
+        cr.update(Uri.parse(AUTHORITY + path), v, null, null);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        return o instanceof DecoyLauncherLook l && l.themedIcons == themedIcons
+                && l.labelsHidden == labelsHidden && l.shapeKey.equals(shapeKey);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(themedIcons, labelsHidden, shapeKey);
+    }
+}
