+    boolean isDecoyLookPending(int userId) {
+        if (mDecoyLookPendingUserId != userId) {
+            return false;
+        }
+        final long age = mInjector.elapsedRealtime() - mDecoyLookPendingSinceMillis;
+        if (age < 0 || age > DECOY_LOOK_PENDING_MAX_MS) {
