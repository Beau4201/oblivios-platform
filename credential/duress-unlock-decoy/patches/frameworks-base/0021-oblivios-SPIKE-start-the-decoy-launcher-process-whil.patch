From e9ccee49646e695bea3a2d2269984d7385c9857a Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 12 Nov 2026 17:21:01 +0100
Subject: [PATCH] oblivios: SPIKE start the decoy launcher process while the
 decoy is locked

Throwaway spike of design B (docs/superpowers/specs/2026-11-12-duress-unlock-timing-design.md): when the keyguard locks, after the decoy is started, request the decoy's Launcher3 process through ActivityManagerInternal.startProcess so its runtime initialisation is paid before the duress credential, with the decoy's CE key still evicted. Logs under SpikeWarm. Not for the release series.
---
 .../locksettings/DecoyProfileHelper.java      | 41 +++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index dbe4167e..44f3367b 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -6,16 +6,21 @@ import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_NONE;
 import android.annotation.Nullable;
 import android.app.ActivityManager;
 import android.app.ActivityManagerInternal;
+import android.app.AppGlobals;
 import android.app.IActivityManager;
 import android.app.KeyguardManager;
+import android.content.ComponentName;
 import android.content.ContentResolver;
 import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
 import android.content.pm.UserInfo;
 import android.os.Binder;
 import android.os.Bundle;
 import android.os.Handler;
 import android.os.HandlerExecutor;
 import android.os.IProgressListener;
+import android.os.Process;
 import android.os.RemoteException;
 import android.os.SystemClock;
 import android.os.UserHandle;
@@ -43,6 +48,8 @@ import java.util.concurrent.TimeUnit;
  */
 class DecoyProfileHelper {
     private static final String TAG = "CredentialRoutingHelper";
+    private static final String SPIKE_TAG = "SpikeWarm";
+    private static final String SPIKE_LAUNCHER_PACKAGE = "com.android.launcher3";
 
     // Long enough for a decoy that is still booting from its warm start to unlock (0.5 s
     // measured on lynx for the unlock of a running decoy), short of the 7 to 8 s the
@@ -156,6 +163,7 @@ class DecoyProfileHelper {
         // would add to a time that has to equal the ordinary one). The owner can change brightness
         // from the lock screen's quick settings afterwards; that gap is measured in DUR-037.
         mirrorOwnerSettingsToDecoy(UserHandle.USER_SYSTEM, state.decoyUserId);
+        warmDecoyLauncherProcess(state.decoyUserId);
     }
 
     /**
@@ -373,6 +381,39 @@ class DecoyProfileHelper {
         }
     }
 
+    /**
+     * SPIKE (throwaway, design B of docs/superpowers/specs/2026-11-12-duress-unlock-timing-design.md):
+     * starts the decoy's Launcher3 process while the decoy is still RUNNING_LOCKED, so the runtime
+     * initialisation of the exec-spawned process (1.5 to 2.3 s) is paid before the duress
+     * credential, with the decoy's CE key still evicted. A process, not an activity: nothing of
+     * the decoy's files is read by this call. The spike measures whether the process survives a
+     * locked user and whether the later launch finds it warm; it logs under SpikeWarm.
+     */
+    private void warmDecoyLauncherProcess(int decoyUserId) {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final ApplicationInfo info = AppGlobals.getPackageManager().getApplicationInfo(
+                    SPIKE_LAUNCHER_PACKAGE,
+                    PackageManager.MATCH_DIRECT_BOOT_AWARE | PackageManager.MATCH_DIRECT_BOOT_UNAWARE,
+                    decoyUserId);
+            if (info == null) {
+                Slog.w(SPIKE_TAG, "no ApplicationInfo for the decoy launcher");
+                return;
+            }
+            final ActivityManagerInternal ami =
+                    LocalServices.getService(ActivityManagerInternal.class);
+            ami.startProcess(info.processName, info, /* knownToBeDead= */ false, /* isTop= */ false,
+                    "oblivios-decoy-warm", new ComponentName(info.packageName, "warm"),
+                    /* isPcc= */ false, Process.SYSTEM_UID, "system");
+            Slog.i(SPIKE_TAG, "requested the decoy launcher process, uid " + info.uid
+                    + " user " + decoyUserId);
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(SPIKE_TAG, "could not start the decoy launcher process", e);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
     /**
      * ObliviOS: the owner's brightness, screen timeout, rotation and lock-screen toggles are
      * copied to the decoy before the switch to it, so the screen does not change at the switch
-- 
