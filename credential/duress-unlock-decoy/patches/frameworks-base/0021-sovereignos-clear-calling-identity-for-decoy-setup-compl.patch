From 80d3a81908d96793a96b4bde4445bf28f8b4a5c4 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Fri, 28 Aug 2026 23:12:44 +0200
Subject: [PATCH 23/89] sovereignos: clear calling identity for decoy
 setup-complete write

---
 .../locksettings/DecoyProfileHelper.java      | 30 +++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 7c269365a586..e41e02a6054e 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -7,6 +7,7 @@ import android.annotation.Nullable;
 import android.app.ActivityManager;
 import android.app.ActivityManagerInternal;
 import android.content.Context;
+import android.os.Binder;
 import android.os.UserHandle;
 import android.provider.Settings;
 import android.util.Slog;
@@ -137,8 +138,33 @@ class DecoyProfileHelper {
         // You theming, the QS settings gear) purely on this one per-user flag. See
         // docs/superpowers/specs/2026-08-28-duress-decoy-session-indistinguishability-design.md
         // in the sovereignos-foundation repository.
-        Settings.Secure.putIntForUser(context.getContentResolver(),
-                Settings.Secure.USER_SETUP_COMPLETE, 1, decoyUserId);
+        //
+        // Settings.Secure.putIntForUser requires WRITE_SECURE_SETTINGS, which the original
+        // Binder caller of the setDecoyProfile AIDL method (e.g. the set-decoy-profile shell
+        // command's own caller) does not hold -- LockSettingsService#setDecoyProfile only
+        // enforces checkWritePermission() (LockSettingsWrite), a different, narrower permission.
+        // Run the write under this process's own system identity instead, mirroring the
+        // established clearCallingIdentity/restoreCallingIdentity pattern used throughout
+        // LockSettingsService.java (e.g. around line 2460).
+        final long token = Binder.clearCallingIdentity();
+        boolean setupComplete;
+        try {
+            setupComplete = Settings.Secure.putIntForUser(context.getContentResolver(),
+                    Settings.Secure.USER_SETUP_COMPLETE, 1, decoyUserId);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        if (!setupComplete) {
+            // Non-fatal: the decoy is still correctly registered and functional, just still
+            // distinguishable from a fully set-up profile until this is corrected. Registration
+            // itself must not be blocked by this write failing -- a duress mechanism that refuses
+            // to register at all because of an unrelated Settings-store hiccup is a worse outcome
+            // than a decoy that is briefly more distinguishable than intended.
+            Slog.w(TAG, "Settings.Secure.putIntForUser(USER_SETUP_COMPLETE) returned false for "
+                    + "decoy user " + decoyUserId + " -- the decoy profile is registered but may "
+                    + "still be distinguishable from a fully set-up profile until this is "
+                    + "retried");
+        }
         DecoyProfileState.create(decoyUserId).save(lockSettingsStorage);
     }
 
