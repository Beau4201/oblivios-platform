From c7fd3655c45d54b4d02d9e347b9486df2740d813 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 16 Sep 2026 22:07:51 +0200
Subject: [PATCH 84/89] sovereignos: suppress the canned unlock animation for an
 authorized switch

The previous attempt set KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS
and was confirmed on hardware to leave the swipe completely intact. The
reason, from the device's own log:

  WindowManagerShell: Combining kgGoAway into #11(OPEN|R|0x0) from setUser
  WindowManagerShell: start keyguard going-away transition, info = {id=11 ...}
  WindowManagerShell:  animated by com.android.wm.shell.keyguard.KeyguardTransitionHandler
  KeyguardUnlock: surfaceBehindEntryAnimator#onAnimationEnd

The going-away is merged into the user-switch transition and animated by
the Shell's KeyguardTransitionHandler, which dispatches on
TRANSIT_FLAG_KEYGUARD_GOING_AWAY alone and never reads the no-animation
flag -- there is no reference to it anywhere under
libs/WindowManager/Shell/src/com/android/wm/shell/keyguard/. The motion
that actually renders comes from surfaceBehindEntryAnimator, which by
its own contract scales and translates the window underneath the
lockscreen. That is the swipe.

Suppresses it where it is really selected, in playCannedUnlockAnimation,
by showing the surface behind immediately and ending the remote
animation. This is not a new mechanism: it is exactly what the adjacent
isWakeAndUnlock branch already does, for the same reason -- a surface
that should simply be there rather than be animated in.

The keyguard still covers the entire switch, so nothing of the outgoing
user's screen is exposed; it stops moving itself off-screen once the
incoming user's home is behind it. The mark is single-use and cleared by
an intervening switch, and gates animation only -- it never decides
whether a dismissal is permitted, which UserController's grants settle
before it is ever set.

The no-animation flag is still set, now without consuming the mark: it
remains the semantically correct request for a dismissal that must not
animate, and is honoured on the non-Shell path.
---
 .../KeyguardUnlockAnimationController.kt      | 26 +++++++++++++++
 .../keyguard/KeyguardViewMediator.java        | 32 ++++++++++++++++---
 2 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt
index 2e1ae2ffbe3e..a7fad029e244 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardUnlockAnimationController.kt
@@ -691,7 +691,33 @@ constructor(
         Log.d(TAG, "playCannedUnlockAnimation")
         playingCannedUnlockAnimation = true
 
+        // SovereignOS: consumed here, at the last point of use, because this is where the animation
+        // that would otherwise render is chosen. See KeyguardViewMediator#
+        // mAuthorizedSwitchDismissPending.
+        val authorizedSwitchDismiss = keyguardViewMediator.get().consumeAuthorizedSwitchDismiss()
+
         when {
+            // SovereignOS: this exit was requested by an authorized decoy-direction switch, whose
+            // keyguard has been showing continuously across the switch -- hiding it any earlier
+            // would expose the outgoing user's screen, since switchToUserSilently suppresses the
+            // UserSwitchingDialog and nothing else covers the transition. Any canned animation
+            // here therefore renders as the lock screen moving itself off-screen, which an
+            // ordinary same-user unlock never does, so it is a tell in exactly the situation this
+            // feature exists for. Confirmed on hardware: the default branch below runs
+            // surfaceBehindEntryAnimator, which by its own contract scales and translates the
+            // window underneath the lockscreen -- that motion is the reported swipe.
+            //
+            // Shows the surface behind immediately and ends the remote animation, which is not a
+            // new mechanism: it is exactly what the isWakeAndUnlock branch below already does,
+            // for the same reason (a surface that should simply be there, not animated in).
+            authorizedSwitchDismiss -> {
+                Log.d(TAG, "playCannedUnlockAnimation, authorized switch dismiss")
+                setSurfaceBehindAppearAmount(1f)
+                keyguardViewMediator
+                    .get()
+                    .exitKeyguardAndFinishSurfaceBehindRemoteAnimation(false /* cancelled */)
+            }
+
             // If we're set up for in-window launcher animations, ask Launcher to play its in-window
             // canned animation.
             willUnlockWithInWindowLauncherAnimations -> {
diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index c596f6a8ce46..1f0d955ce545 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -3400,11 +3400,17 @@ public class KeyguardViewMediator implements CoreStartable,
                     || mWakeAndUnlocking && !mWallpaperSupportsAmbientMode) {
                 flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
             }
-            // SovereignOS: an authorized-switch dismissal cuts rather than animates. The flag is
-            // consumed here so it applies to exactly one going-away, matching the single-use
-            // authorization that requested it. See mAuthorizedSwitchDismissPending.
+            // SovereignOS: an authorized-switch dismissal cuts rather than animates. Deliberately
+            // read without consuming: on this build the going-away is merged into the user-switch
+            // transition and animated by the Shell's KeyguardTransitionHandler, which dispatches
+            // on TRANSIT_FLAG_KEYGUARD_GOING_AWAY alone and never reads this flag -- confirmed on
+            // hardware, where setting it alone left the swipe fully intact. The flag is still set
+            // because it is the semantically correct request for a dismissal that must not
+            // animate, and it is honoured on the non-Shell path; the dismissal that actually
+            // renders is suppressed where it is really played, in
+            // KeyguardUnlockAnimationController#playCannedUnlockAnimation, which consumes the
+            // pending mark via consumeAuthorizedSwitchDismiss().
             if (mAuthorizedSwitchDismissPending) {
-                mAuthorizedSwitchDismissPending = false;
                 flags |= KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
             }
             if (mKeyguardViewControllerLazy.get().isGoingToNotificationShade()
@@ -4024,6 +4030,24 @@ public class KeyguardViewMediator implements CoreStartable,
      * Whether we have requested to show the surface behind the keyguard, even if it's not yet
      * visible due to IPC delay.
      */
+    /**
+     * SovereignOS: consumes the pending authorized-switch dismissal mark, returning whether this
+     * keyguard exit is the one an authorized decoy-direction switch requested. Consumed exactly
+     * once, so it applies to a single exit, matching the single-use authorization behind it --
+     * and consumed at the last point of use (the canned unlock animation) rather than earlier,
+     * since that is where the animation that would otherwise render is selected.
+     *
+     * Gates animation only. It never decides whether a dismissal is permitted; that is settled
+     * upstream by UserController's grants before this is ever set.
+     *
+     * @see #mAuthorizedSwitchDismissPending
+     */
+    boolean consumeAuthorizedSwitchDismiss() {
+        boolean pending = mAuthorizedSwitchDismissPending;
+        mAuthorizedSwitchDismissPending = false;
+        return pending;
+    }
+
     public boolean requestedShowSurfaceBehindKeyguard() {
         return mSurfaceBehindRemoteAnimationRequested;
     }
-- 
