From 48dbbb17a083a85ac2a85a51c74ddfe36de07f05 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 15:19:04 +0100
Subject: [PATCH] oblivios: the keyguard exit of an authorized switch tells the
 window manager at once, holds the views until the bouncer transition has
 finished and fades the shade out

---
 .../keyguard/KeyguardViewMediator.java        | 101 +++++++++++++++++-
 1 file changed, 97 insertions(+), 4 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 0ed45c85..aa720458 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -533,8 +533,51 @@ public class KeyguardViewMediator implements CoreStartable,
     /** ObliviOS: the wallpaper stage of an authorized switch; created on first use, main thread. */
     private AuthorizedSwitchStage mSwitchStage;
 
-    /** ObliviOS: how long the keyguard's exit of an authorized switch lasts, like an ordinary one. */
-    private static final long AUTHORIZED_EXIT_HOLD_MS = 450L;
+    /**
+     * ObliviOS: how long the keyguard's views of an authorized switch stay after the going-away: the
+     * bouncer to gone transition (scrim, blur, pad) runs 0.53 s (lynx 2026-11-15 logcat, started
+     * to finished 0.525 s), and a hide before it has finished leaves the scrim at a random
+     * brightness (51 to 76 percent of the final one in 4 unlocks) that then jumps to full.
+     */
+    private static final long AUTHORIZED_EXIT_HOLD_MS = 500L;
+
+    /** ObliviOS: the fade of the shade at the end of the held exit of an authorized switch. */
+    private static final long AUTHORIZED_EXIT_FADE_MS = 250L;
+
+    /**
+     * ObliviOS: the window manager has been told at once that the keyguard is gone for an
+     * authorized switch (see handleStartKeyguardExitAnimationInner), so the one call that would
+     * follow when the held exit ends is skipped. With the call held for 450 ms the incoming home
+     * could not draw behind the keyguard's views and appeared 0.3 s later (1.38 s against 1.06 s
+     * after the credential check on lynx 2026-11-15). Main thread.
+     */
+    private boolean mAuthorizedExitWmNotified;
+
+    /** ObliviOS: the root view of the shade while it fades out at the end of a held exit. */
+    private android.view.View mHeldExitFadeView;
+
+    /**
+     * ObliviOS: a held exit of an authorized switch that does not finish (the phone is locked again,
+     * another switch starts, the window manager cancels the exit) leaves the window manager believing
+     * that the keyguard is gone while this class still shows it. Tell the window manager that it is
+     * shown again, so the two cannot disagree (fail closed). Main thread.
+     */
+    private void restoreWmKeyguardShownAfterHeldExit(String reason) {
+        if (mHeldExitFadeView != null) {
+            // A fade of the shade that is still running is stopped and the shade is shown in full.
+            final android.view.View fading = mHeldExitFadeView;
+            mHeldExitFadeView = null;
+            fading.animate().cancel();
+            fading.setAlpha(1f);
+        }
+        if (!mAuthorizedExitWmNotified) {
+            return;
+        }
+        mAuthorizedExitWmNotified = false;
+        if (mShowing) {
+            updateActivityLockScreenState(true, mAodShowing, reason);
+        }
+    }
 
     // last known state of the cellular connection
     private final String mPhoneState = TelephonyManager.EXTRA_STATE_IDLE;
@@ -748,6 +791,7 @@ public class KeyguardViewMediator implements CoreStartable,
                     && mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
             mAuthorizedSwitchDismissRequested = false;
             AuthorizedSwitchExit.setActive(false);
+            restoreWmKeyguardShownAfterHeldExit("a switch began during a held exit");
             if (mAuthorizedSwitchDismissPending && Settings.Global.getInt(
                     mContext.getContentResolver(), "oblivios_duress_fast", 1) != 0) {
                 // ObliviOS: the stage keeps the wallpaper on screen behind the exit of this switch
@@ -3339,6 +3383,11 @@ public class KeyguardViewMediator implements CoreStartable,
         if (SceneContainerFlag.isEnabled()) {
             return;
         }
+        if (!showing && mAuthorizedExitWmNotified) {
+            // ObliviOS: sent already when the held exit of an authorized switch began.
+            mAuthorizedExitWmNotified = false;
+            return;
+        }
 
         mUiBgExecutor.execute(() -> {
             Log.d(TAG, "updateActivityLockScreenState(" + showing + ", " + aodShowing + ", "
@@ -3366,6 +3415,7 @@ public class KeyguardViewMediator implements CoreStartable,
         Trace.beginSection("KeyguardViewMediator#handleShow");
         // ObliviOS: the exit of an authorized switch is over once the keyguard is shown again.
         AuthorizedSwitchExit.setActive(false);
+        restoreWmKeyguardShownAfterHeldExit("handleShow during a held exit");
         // The wallpaper of the stage of a coming authorized switch is loaded now, off the main
         // thread (see AuthorizedSwitchStage).
         if (mSwitchStage == null) {
@@ -3807,14 +3857,55 @@ public class KeyguardViewMediator implements CoreStartable,
                 // keyguard's own exit waits.
                 final boolean heldExit = AuthorizedSwitchExit.isActive()
                         && (params.getApps() == null || params.getApps().length == 0);
+                if (heldExit && !KeyguardWmStateRefactor.isEnabled()) {
+                    // The window manager hears at once that the keyguard is gone, so the incoming
+                    // home can draw behind the keyguard's views while they finish.
+                    updateActivityLockScreenState(false, false, "authorized switch exit");
+                    mAuthorizedExitWmNotified = true;
+                }
                 if (!KeyguardWmStateRefactor.isEnabled()) {
                     // Handled directly in StatusBarKeyguardViewManager if enabled.
                     if (heldExit) {
                         mHandler.postDelayed(() -> {
-                            if (AuthorizedSwitchExit.isActive() && !mIsKeyguardExitAnimationCanceled) {
+                            if (!AuthorizedSwitchExit.isActive() || mIsKeyguardExitAnimationCanceled) {
+                                restoreWmKeyguardShownAfterHeldExit("held exit canceled");
+                                return;
+                            }
+                            // The shade fades out instead of going in one frame: its scrim still
+                            // darkened the picture by about 40% when the hold ended and the
+                            // picture jumped to full brightness (lynx 2026-11-15, mean luminance
+                            // per frame 53 then 91). The alpha is restored after the hide.
+                            final android.view.ViewRootImpl root = mKeyguardViewControllerLazy.get()
+                                    .getViewRootImpl();
+                            final android.view.View rootView = root != null ? root.getView() : null;
+                            if (rootView == null) {
                                 mKeyguardViewControllerLazy.get()
                                         .hide(params.startTime, params.fadeoutDuration);
+                                return;
                             }
+                            mHeldExitFadeView = rootView;
+                            rootView.animate().alpha(0f).setDuration(AUTHORIZED_EXIT_FADE_MS)
+                                    .setListener(new android.animation.AnimatorListenerAdapter() {
+                                        @Override
+                                        public void onAnimationCancel(
+                                                android.animation.Animator animation) {
+                                            rootView.setAlpha(1f);
+                                        }
+                                    })
+                                    .withEndAction(() -> {
+                                        mHeldExitFadeView = null;
+                                        if (!AuthorizedSwitchExit.isActive()
+                                                || mIsKeyguardExitAnimationCanceled) {
+                                            // The phone was locked again during the fade.
+                                            rootView.setAlpha(1f);
+                                            restoreWmKeyguardShownAfterHeldExit(
+                                                    "held exit canceled during the fade");
+                                            return;
+                                        }
+                                        mKeyguardViewControllerLazy.get()
+                                                .hide(params.startTime, params.fadeoutDuration);
+                                        rootView.post(() -> rootView.setAlpha(1f));
+                                    }).start();
                         }, AUTHORIZED_EXIT_HOLD_MS);
                     } else {
                         mKeyguardViewControllerLazy.get()
@@ -3900,9 +3991,11 @@ public class KeyguardViewMediator implements CoreStartable,
                         synchronized (KeyguardViewMediator.this) {
                             if (AuthorizedSwitchExit.isActive() && !mIsKeyguardExitAnimationCanceled) {
                                 onKeyguardExitFinished("remote animation disabled, held");
+                            } else {
+                                restoreWmKeyguardShownAfterHeldExit("held exit canceled");
                             }
                         }
-                    }, AUTHORIZED_EXIT_HOLD_MS);
+                    }, AUTHORIZED_EXIT_HOLD_MS + AUTHORIZED_EXIT_FADE_MS);
                 } else {
                     onKeyguardExitFinished("remote animation disabled");
                 }
-- 
