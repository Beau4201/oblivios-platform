From ef65610d1f1b7f854c29b1517a604954503d1704 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 5 Nov 2026 18:00:00 +0100
Subject: [PATCH] oblivios: choosing the duress finger works for every
 biometric id

First device run of the finger route (lynx 2026110501, DUR-027) failed for both enrolled fingers:

1. The HAL gives each enrolment a random signed 32-bit id (InternalEnumerateClient listed -799218825 and
   1944844899), but DecoyFingerHelper.set and DecoyFingerCodec.parseState rejected every id of 0 or below
   ("biometricId must be positive"), so about half of all fingers could never be chosen, and a stored negative id
   would have been read back as no link. Only 0 is the sentinel (DecoyFingerPolicy.NO_FINGER); the one rule is now
   DecoyFingerPolicy.isUsableFingerId and both places use it.
2. For a positive id, setDecoyFinger failed with "Credential is already zeroized":
   checkDecoyOwnerCredential ends in LockSettingsService.checkCredential, which zeroizes a credential that came
   over Binder, and set() then used the same owner credential for unlockSyntheticPasswordWithCredential. set() takes
   a copy first and zeroizes it itself.

The tests now accept signed ids (replacing the test that required the rejection), and six mutants of the id rules are
killed. The ordering fix in set() is Android code: parse-checked only, to be proved by DUR-027 on a built image.
---
 .../server/locksettings/DecoyFingerCodec.java |  2 +-
 .../locksettings/DecoyFingerHelper.java       | 19 ++++++++++++++++---
 .../locksettings/DecoyFingerPolicy.java       |  9 +++++++++
 .../locksettings/DecoyFingerCodecTest.java    | 15 +++++++++++++--
 .../locksettings/DecoyFingerPolicyTest.java   | 19 +++++++++++++++++++
 5 files changed, 58 insertions(+), 6 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java b/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java
index f1ee61a4ee88..7c9b2ee2b2a9 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerCodec.java
@@ -52,7 +52,7 @@ final class DecoyFingerCodec {
         try {
             final int version = Integer.parseInt(parts[0]);
             final int fingerId = Integer.parseInt(parts[1]);
-            if (version > VERSION || fingerId <= 0) {
+            if (version > VERSION || !DecoyFingerPolicy.isUsableFingerId(fingerId)) {
                 return null;
             }
             return new State(fingerId, Base64.getDecoder().decode(parts[2]));
diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
index 0717d73cc1a7..8d4a92747db8 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
@@ -58,9 +58,22 @@ class DecoyFingerHelper {
      */
     boolean set(LockscreenCredential ownerCredential, LockscreenCredential decoyCredential,
             int biometricId) {
-        lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
-        if (biometricId <= 0) {
-            throw new IllegalArgumentException("biometricId must be positive");
+        // checkDecoyOwnerCredential ends in LockSettingsService.checkCredential, which zeroizes a
+        // credential that came over Binder; the protector unlock below needs the owner credential
+        // again, so it gets a copy taken first (lynx 2026110501: "Credential is already zeroized").
+        final LockscreenCredential ownerCopy = ownerCredential.duplicate();
+        try {
+            lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
+            return setChecked(ownerCopy, decoyCredential, biometricId);
+        } finally {
+            ownerCopy.zeroize();
+        }
+    }
+
+    private boolean setChecked(LockscreenCredential ownerCredential,
+            LockscreenCredential decoyCredential, int biometricId) {
+        if (!DecoyFingerPolicy.isUsableFingerId(biometricId)) {
+            throw new IllegalArgumentException("biometricId must not be 0");
         }
         final int type = decoyCredential.getType();
         if (type != CREDENTIAL_TYPE_PIN && type != CREDENTIAL_TYPE_PASSWORD) {
diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
index f7ae9576ce56..c06c2006317b 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerPolicy.java
@@ -24,6 +24,15 @@ final class DecoyFingerPolicy {
 
     private DecoyFingerPolicy() {}
 
+    /**
+     * Whether {@code id} can be a finger's biometric id. The HAL gives each enrolment a random
+     * signed 32-bit id (lynx 2026110501 enumerated -799218825 and 1944844899), so a negative id is
+     * a valid finger; only {@link #NO_FINGER} is not.
+     */
+    static boolean isUsableFingerId(int id) {
+        return id != NO_FINGER;
+    }
+
     static int decide(int userId, int storedFingerId, int matchedFingerId, boolean ownerIsKeyguard,
             boolean decoyRegistered, boolean credentialCached, boolean biometricAllowed) {
         if (userId != USER_SYSTEM || storedFingerId == NO_FINGER
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerCodecTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerCodecTest.java
index 69c5b7e64d9a..af54470926b5 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerCodecTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerCodecTest.java
@@ -19,9 +19,20 @@ public class DecoyFingerCodecTest {
     }
 
     @Test
-    public void stateRejectsFingerZeroAndNegative() {
+    public void stateRejectsOnlyFingerZero() {
         assertNull(DecoyFingerCodec.parseState(DecoyFingerCodec.formatState(0, new byte[] {1})));
-        assertNull(DecoyFingerCodec.parseState(DecoyFingerCodec.formatState(-5, new byte[] {1})));
+    }
+
+    // The HAL gives a finger a random signed 32-bit id: lynx 2026110501 enumerated -799218825 and
+    // 1944844899. A negative id is a valid finger.
+    @Test
+    public void stateRoundTripsSignedIds() {
+        for (int id : new int[] {-799218825, 1944844899, -1, Integer.MIN_VALUE, Integer.MAX_VALUE}) {
+            final DecoyFingerCodec.State s = DecoyFingerCodec.parseState(
+                    DecoyFingerCodec.formatState(id, new byte[] {9}));
+            assertNotNull("id " + id, s);
+            assertEquals(id, s.fingerId);
+        }
     }
 
     @Test
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java
index f7a5e3ae70b9..ce4e533d2422 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoyFingerPolicyTest.java
@@ -95,4 +95,23 @@ public class DecoyFingerPolicyTest {
     public void removalOfAnotherUsersFingerKeepsTheLink() {
         assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(10, DURESS, DURESS));
     }
+
+    @Test
+    public void everyNonZeroIdIsUsable() {
+        assertFalse(DecoyFingerPolicy.isUsableFingerId(0));
+        for (int id : new int[] {-799218825, 1944844899, -1, 1, Integer.MIN_VALUE, Integer.MAX_VALUE}) {
+            assertTrue("id " + id, DecoyFingerPolicy.isUsableFingerId(id));
+        }
+    }
+
+    @Test
+    public void negativeDuressFingerRoutesAndOnlyItsRemovalClearsTheLink() {
+        final int negative = -799218825;
+        assertEquals(DecoyFingerPolicy.ROUTE,
+                decide(0, negative, negative, true, true, true, true));
+        assertEquals(DecoyFingerPolicy.NONE,
+                decide(0, negative, 1944844899, true, true, true, true));
+        assertTrue(DecoyFingerPolicy.shouldClearOnRemoval(0, negative, negative));
+        assertFalse(DecoyFingerPolicy.shouldClearOnRemoval(0, negative, 1944844899));
+    }
 }
