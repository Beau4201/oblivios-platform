+package com.android.server.am;
+
+import static android.testing.DexmakerShareClassLoaderRule.runWithDexmakerShareClassLoader;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import android.os.UserHandle;
+import android.platform.test.annotations.Presubmit;
+
+import androidx.test.filters.SmallTest;
+
+import com.android.server.am.psc.ProcessRecordInternal;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+
+/**
+ * Unit tests for {@link RealUserQuiescer#quiesce}, covering the per-process freeze-failure
+ * threshold that makes {@code DecoyRoutingFailureMarker.REASON_QUIESCE_FAILED} genuinely
+ * reachable: any single process failing to freeze counts as a quiesce failure (owner's explicit
+ * threshold, 2026-09-17) -- see docs/superpowers/specs/2026-09-17-duress-unlock-final-closure
+ * -design.md, Component 3, in the freeholdos-foundation repository.
+ *
+ * ProcessRecord/ProcessList are real AOSP classes, not designed for mocking: ProcessList is
+ * final (cannot be mocked or subclassed) and both ProcessRecordInternal#uid and #processName are
+ * public final fields set by ProcessRecord's own heavyweight constructor. Rather than running
+ * that constructor (which needs a fully wired ActivityTaskManagerService), this test constructs
+ * real, minimal ProcessList instances directly and uses reflection -- matching the existing
+ * setFieldValue precedent in this same package's AnrHelperTest/ProcessRecordTests -- to populate
+ * only the fields RealUserQuiescer#quiesce actually reads.
+ *
+ * Build/Install/Run:
+ *  atest FrameworksServicesTests:RealUserQuiescerTest
+ */
+@SmallTest
+@Presubmit
+public class RealUserQuiescerTest {
+
+    private ActivityManagerService mAm;
+    private ProcessList mProcessList;
+    private CachedAppOptimizer mCachedAppOptimizer;
+    private RealUserQuiescer mQuiescer;
+
+    @Before
+    public void setUp() throws Exception {
+        runWithDexmakerShareClassLoader(() -> {
+            try {
+                mAm = mock(ActivityManagerService.class);
+                setFinalField(ActivityManagerService.class, mAm, "mProcLock",
+                        new ActivityManagerProcLock());
+                mProcessList = new ProcessList();
+                setFinalField(ActivityManagerService.class, mAm, "mProcessList", mProcessList);
+                mCachedAppOptimizer = mock(CachedAppOptimizer.class);
+                mQuiescer = new RealUserQuiescer(mAm, mCachedAppOptimizer);
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+        });
+    }
+
+    @Test
+    public void quiesce_allProcessesFreezeCleanly_returnsTrue() {
+        // A freshly constructed ProcessList's own LRU list starts empty -- the simplest true
+        // case: nothing to fail.
+        assertThat(mQuiescer.quiesce(0)).isTrue();
+    }
+
+    @Test
+    public void quiesce_singleProcessThrowsOnFreeze_returnsFalse() throws Exception {
+        final int userId = 10;
+        ProcessRecord app = createMockProcessRecord(
+                userId * UserHandle.PER_USER_RANGE, "com.example.app");
+        getLruProcesses(mProcessList).add(app);
+        doThrow(new RuntimeException("frozen solid"))
+                .when(mCachedAppOptimizer).forceFreezeAppAsyncLSP(app);
+
+        assertThat(mQuiescer.quiesce(userId)).isFalse();
+        // The user is still marked quiesced despite the partial failure -- only the return value
+        // signals incomplete protection (see RealUserQuiescer#quiesce's own javadoc).
+        assertThat(mQuiescer.isQuiesced(userId)).isTrue();
+    }
+
+    @Test
+    public void quiesce_otherUsersProcess_isIgnoredAndReturnsTrue() throws Exception {
+        final int userId = 10;
+        ProcessRecord otherUsersApp = createMockProcessRecord(
+                11 * UserHandle.PER_USER_RANGE, "com.example.otheruser");
+        getLruProcesses(mProcessList).add(otherUsersApp);
+        doThrow(new RuntimeException("should never be called for this user"))
+                .when(mCachedAppOptimizer).forceFreezeAppAsyncLSP(otherUsersApp);
+
+        assertThat(mQuiescer.quiesce(userId)).isTrue();
+    }
+
+    /**
+     * {@link ProcessRecord} is package-private, so mocking it -- unlike the {@code public}
+     * {@link ActivityManagerService}/{@link CachedAppOptimizer} mocked in {@link #setUp} --
+     * requires the same {@code runWithDexmakerShareClassLoader} wrapper {@link #setUp} already
+     * uses, or dexmaker's generated proxy subclass is rejected as an inaccessible class at
+     * runtime (confirmed via a real on-device `atest` failure, not assumed).
+     */
+    private static ProcessRecord createMockProcessRecord(int uid, String processName)
+            throws Exception {
+        final ProcessRecord[] holder = new ProcessRecord[1];
+        runWithDexmakerShareClassLoader(() -> {
+            try {
+                ProcessRecord app = mock(ProcessRecord.class);
+                setFinalField(ProcessRecordInternal.class, app, "uid", uid);
+                setFinalField(ProcessRecordInternal.class, app, "processName", processName);
+                when(app.isPersistent()).thenReturn(false);
+                holder[0] = app;
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+        });
+        return holder[0];
+    }
+
+    @SuppressWarnings("unchecked")
+    private static ArrayList<ProcessRecord> getLruProcesses(ProcessList processList)
+            throws Exception {
+        Field field = ProcessList.class.getDeclaredField("mLruProcesses");
+        field.setAccessible(true);
+        return (ArrayList<ProcessRecord>) field.get(processList);
+    }
+
+    /**
+     * Sets a (possibly final) instance field via reflection. setAccessible(true) alone is
+     * insufficient for final fields on this toolchain -- the FINAL bit must also be cleared on
+     * the Field object's own "accessFlags" descriptor first, matching the exact precedent
+     * already established in this package (AnrHelperTest#setFieldValue,
+     * ProcessRecordTests#setFieldValue).
+     */
+    private static void setFinalField(Class<?> declaringClass, Object target, String fieldName,
+            Object value) throws Exception {
+        Field field = declaringClass.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        Field accessFlags = Field.class.getDeclaredField("accessFlags");
+        accessFlags.setAccessible(true);
+        accessFlags.setInt(field, accessFlags.getInt(field) & ~(Modifier.FINAL | Modifier.PRIVATE));
+        field.set(target, value);
+    }
+}
