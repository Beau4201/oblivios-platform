From 8c29443ff377792d1b587bd1be2d69bb3d8453ad Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 16 Sep 2026 21:15:35 +0200
Subject: [PATCH 79/89] test: expect the return-path credential check to unlock
 CE storage

verifyPrimaryCredentialNoRouting is the decoy-to-owner return path's own
credential check. It deliberately skipped every side effect of an
ordinary verification, including the CE-storage unlock, which was
survivable only while the return still re-armed a bouncer that performed
that unlock itself. Once that second prompt was authorized away, nothing
unlocked the owner at all.

Adds an unlock counter to FakeStorageManager (relative to the test's own
setup, not an assumed-zero baseline) and asserts both directions: a
matching credential unlocks the user's CE storage exactly once, and a
non-matching one unlocks nothing.
---
 .../locksettings/FakeStorageManager.java      | 12 ++++++
 .../LockSettingsServiceTests.java             | 37 +++++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/locksettings/FakeStorageManager.java b/services/tests/servicestests/src/com/android/server/locksettings/FakeStorageManager.java
index 1cb99f042acb..a7a3bd86c47f 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/FakeStorageManager.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/FakeStorageManager.java
@@ -25,6 +25,7 @@ import java.util.Arrays;
 public class FakeStorageManager {
 
     private final ArrayMap<Integer, byte[]> mUserSecrets = new ArrayMap<>();
+    private final ArrayMap<Integer, Integer> mCeStorageUnlockCounts = new ArrayMap<>();
 
     public void setCeStorageProtection(int userId, byte[] secret) {
         assertThat(mUserSecrets).doesNotContainKey(userId);
@@ -39,5 +40,16 @@ public class FakeStorageManager {
 
     public void unlockCeStorage(int userId, byte[] secret) {
         assertThat(mUserSecrets.get(userId)).isEqualTo(secret);
+        mCeStorageUnlockCounts.put(userId, getCeStorageUnlockCount(userId) + 1);
+    }
+
+    /**
+     * The number of times unlockCeStorage has been called for userId. Lets a test assert that a
+     * particular operation did or did not unlock a user's CE storage, relative to whatever the
+     * test's own setup already did, rather than against an assumed-zero baseline.
+     */
+    public int getCeStorageUnlockCount(int userId) {
+        Integer count = mCeStorageUnlockCounts.get(userId);
+        return count == null ? 0 : count;
     }
 }
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsServiceTests.java b/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsServiceTests.java
index 1a1a62740598..a02e5dba9ac2 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsServiceTests.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsServiceTests.java
@@ -635,6 +635,43 @@ public class LockSettingsServiceTests extends BaseLockSettingsServiceTests {
         verify(mRecoverableKeyStoreManager).lockScreenSecretAvailable(password, PRIMARY_USER_ID);
     }
 
+    /**
+     * SovereignOS: verifyPrimaryCredentialNoRouting is what the decoy-to-owner return path uses to
+     * check the owner's credential from inside a decoy session. It must apply the same CE-storage
+     * unlock an ordinary verification applies: with the return path's re-armed bouncer now
+     * authorized away, nothing downstream ever performs that unlock, and the owner's session is
+     * left stranded on the direct-boot FallbackHome placeholder because
+     * UserController#finishUserUnlocking bails on a still-locked CE storage.
+     */
+    @Test
+    public void testVerifyPrimaryCredentialNoRouting_onMatch_unlocksCeStorage() throws Exception {
+        final LockscreenCredential password = newPassword("password");
+        setCredential(PRIMARY_USER_ID, password);
+        final int unlocksBefore = mStorageManager.getCeStorageUnlockCount(PRIMARY_USER_ID);
+
+        assertTrue(mService.verifyPrimaryCredentialNoRouting(password, PRIMARY_USER_ID)
+                .isMatched());
+
+        assertEquals(unlocksBefore + 1, mStorageManager.getCeStorageUnlockCount(PRIMARY_USER_ID));
+    }
+
+    /**
+     * SovereignOS: the mirror of the above -- a credential that does not match must unlock nothing.
+     * This is the property that keeps the return path from being a way to unlock the owner's
+     * storage from a decoy session without the owner's actual credential.
+     */
+    @Test
+    public void testVerifyPrimaryCredentialNoRouting_onMismatch_doesNotUnlockCeStorage()
+            throws Exception {
+        setCredential(PRIMARY_USER_ID, newPassword("password"));
+        final int unlocksBefore = mStorageManager.getCeStorageUnlockCount(PRIMARY_USER_ID);
+
+        assertFalse(mService.verifyPrimaryCredentialNoRouting(newPassword("badpassword"),
+                PRIMARY_USER_ID).isMatched());
+
+        assertEquals(unlocksBefore, mStorageManager.getCeStorageUnlockCount(PRIMARY_USER_ID));
+    }
+
     @Test
     public void testVerifyCredential_secondaryPin_DoesNotSendCredentials() throws Exception {
         int userId = PRIMARY_USER_ID;
