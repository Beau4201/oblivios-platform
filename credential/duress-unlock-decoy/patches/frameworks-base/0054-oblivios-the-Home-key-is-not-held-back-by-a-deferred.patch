From 7bc79c21e815a7806addb02f46d2cb20c5c1dfd1 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 16:06:59 +0100
Subject: [PATCH 54/54] oblivios: the Home key is not held back by a deferred
 decoy home

Review finding D8, third part. isDecoyHomeDeferred made every home start of the decoy fail for up to 1.5 s, the Home key included.
---
 .../core/java/com/android/server/wm/RootWindowContainer.java   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/wm/RootWindowContainer.java b/services/core/java/com/android/server/wm/RootWindowContainer.java
index bdc7536ab43c..1a998ddb5c1e 100644
--- a/services/core/java/com/android/server/wm/RootWindowContainer.java
+++ b/services/core/java/com/android/server/wm/RootWindowContainer.java
@@ -1427,7 +1427,8 @@ class RootWindowContainer extends WindowContainer<DisplayContent>
         // WindowManagerService#startDeferredDecoyHome once the keyguard has gone away; any other
         // start in between (resuming the empty home task, for one) must not run it inside the
         // going-away transition, which would then wait for the cold launcher to draw.
-        if (mWmService.isDecoyHomeDeferred(userId)) {
+        // The Home key is the person's own request and is never held back by the deferral.
+        if (!fromHomeKey && mWmService.isDecoyHomeDeferred(userId)) {
             return false;
         }
         // Fallback to top focused display area if the provided one is invalid.
-- 
2.39.5

