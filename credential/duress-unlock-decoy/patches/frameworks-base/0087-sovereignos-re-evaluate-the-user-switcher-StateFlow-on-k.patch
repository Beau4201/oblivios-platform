--- a/packages/SystemUI/multivalentTests/src/com/android/systemui/user/data/repository/UserRepositoryImplTest.kt
+++ b/packages/SystemUI/multivalentTests/src/com/android/systemui/user/data/repository/UserRepositoryImplTest.kt
@@ -33,6 +33,7 @@ import com.android.systemui.Flags.FLAG_DO_NOT_USE_RUN_BLOCKING
 import com.android.systemui.SysuiTestCase
 import com.android.systemui.broadcast.broadcastDispatcher
 import com.android.systemui.coroutines.collectLastValue
+import com.android.systemui.keyguard.data.repository.fakeKeyguardRepository
 import com.android.systemui.kosmos.testDispatcher
 import com.android.systemui.kosmos.testScope
 import com.android.systemui.kosmos.useUnconfinedTestDispatcher
@@ -67,6 +68,7 @@ class UserRepositoryImplTest(flags: FlagsParameterization) : SysuiTestCase() {
     private val testDispatcher = kosmos.testDispatcher
     private val testScope = kosmos.testScope
     private val globalSettings = kosmos.fakeGlobalSettings
+    private val keyguardRepository = kosmos.fakeKeyguardRepository
     private val broadcastDispatcher = kosmos.broadcastDispatcher
     private val devicePolicyManager = kosmos.devicePolicyManager
     private val activityManager = kosmos.activityManager
@@ -121,6 +123,25 @@ class UserRepositoryImplTest(flags: FlagsParameterization) : SysuiTestCase() {
             job.cancel()
         }
 
+    @Test
+    fun userSwitcherSettings_reEvaluatesOnKeyguardTransition_withoutSettingsChange() =
+        testScope.runTest {
+            // Arrange: manager.isUserSwitcherEnabled() starts true (unlocked-equivalent).
+            whenever(manager.isUserSwitcherEnabled()).thenReturn(true)
+            underTest = create(testScope.backgroundScope)
+            val settings by collectLastValue(underTest.userSwitcherSettings)
+            assertThat(settings?.isUserSwitcherEnabled).isTrue()
+
+            // Act: the keyguard becomes showing, with zero Settings.Global writes -- this is
+            // what a duress-unlock decoy switch looks like from this StateFlow's perspective.
+            whenever(manager.isUserSwitcherEnabled()).thenReturn(false)
+            keyguardRepository.setKeyguardShowing(true)
+
+            // Assert: the cached value reflects the new keyguard state without any
+            // Settings.Global change having occurred.
+            assertThat(settings?.isUserSwitcherEnabled).isFalse()
+        }
+
     @Test
     fun userSwitcherSettings_isUserSwitcherEnabled_notInitialized() =
         testScope.runTest {
@@ -543,6 +564,7 @@ class UserRepositoryImplTest(flags: FlagsParameterization) : SysuiTestCase() {
             mainDispatcher = testDispatcher,
             backgroundDispatcher = testDispatcher,
             globalSettings = globalSettings,
+            keyguardRepository = keyguardRepository,
             tracker = tracker,
             broadcastDispatcher = broadcastDispatcher,
             devicePolicyManager = devicePolicyManager,
diff --git a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
index 562871ee77f9..9642b1f35450 100644
--- a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
+++ b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
@@ -40,6 +40,7 @@ import com.android.systemui.dagger.SysUISingleton
 import com.android.systemui.dagger.qualifiers.Application
 import com.android.systemui.dagger.qualifiers.Background
 import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.keyguard.data.repository.KeyguardRepository
 import com.android.systemui.res.R
 import com.android.systemui.settings.UserTracker
 import com.android.systemui.user.data.model.SelectedUserModel
@@ -64,6 +65,7 @@ import kotlinx.coroutines.flow.filterNotNull
 import kotlinx.coroutines.flow.flowOf
 import kotlinx.coroutines.flow.flowOn
 import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.merge
 import kotlinx.coroutines.flow.onEach
 import kotlinx.coroutines.flow.onStart
 import kotlinx.coroutines.flow.stateIn
@@ -80,6 +82,7 @@ constructor(
     @Main private val mainDispatcher: CoroutineDispatcher,
     @Background private val backgroundDispatcher: CoroutineDispatcher,
     private val globalSettings: GlobalSettings,
+    private val keyguardRepository: KeyguardRepository,
     private val tracker: UserTracker,
     private val devicePolicyManager: DevicePolicyManager,
     private val broadcastDispatcher: BroadcastDispatcher,
@@ -88,14 +91,21 @@ constructor(
 ) : UserRepository {
 
     private val _userSwitcherSettings: StateFlow<UserSwitcherSettingsModel> =
-        globalSettings
-            .observerFlow(
-                names =
-                    arrayOf(
-                        SETTING_SIMPLE_USER_SWITCHER,
-                        Settings.Global.ADD_USERS_WHEN_LOCKED,
-                        Settings.Global.USER_SWITCHER_ENABLED,
-                    )
+        merge(
+                globalSettings.observerFlow(
+                    names =
+                        arrayOf(
+                            SETTING_SIMPLE_USER_SWITCHER,
+                            Settings.Global.ADD_USERS_WHEN_LOCKED,
+                            Settings.Global.USER_SWITCHER_ENABLED,
+                        )
+                ),
+                // A keyguard showing-state transition (e.g. an SovereignOS Duress Unlock decoy
+                // switch) can change manager.isUserSwitcherEnabled()'s live result without any
+                // of the three Settings.Global keys above ever being written, which would
+                // otherwise leave this StateFlow's cached value stale until an unrelated
+                // settings write happened to refresh it.
+                keyguardRepository.isKeyguardShowing.map { Unit },
             )
             .onStart { emit(Unit) } // Forces an initial update.
             .map { getSettings() }
