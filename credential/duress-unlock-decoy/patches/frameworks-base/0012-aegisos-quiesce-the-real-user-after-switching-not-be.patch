From 1f4a79aabfa435a517e2862d18bfdfecd879aa80 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 27 Aug 2026 03:44:53 +0200
Subject: [PATCH 12/89] aegisos: quiesce the real user after switching, not
 before

---
 .../locksettings/DecoyProfileHelper.java      | 26 +++++++++----------
 1 file changed, 12 insertions(+), 14 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index ecfe7b391e60..5e8d134dc020 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -6,7 +6,6 @@ import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_NONE;
 import android.annotation.Nullable;
 import android.app.ActivityManager;
 import android.app.ActivityManagerInternal;
-import android.app.IActivityManager;
 import android.os.UserHandle;
 import android.util.Slog;
 
@@ -72,25 +71,24 @@ class DecoyProfileHelper {
 
     private boolean freezeAndSwitchToDecoy(int decoyUserId) {
         int realUserId = ActivityManager.getCurrentUser();
-        IActivityManager am = ActivityManager.getService();
-        try {
-            int stopResult = am.stopUserWithDelayedLocking(realUserId, /* callback= */ null);
-            if (stopResult != ActivityManager.USER_OP_SUCCESS) {
-                Slog.e(TAG, "Failed to initiate freeze of real user " + realUserId
-                        + ", result=" + stopResult);
-                return false;
-            }
-        } catch (Exception e) {
-            Slog.e(TAG, "Exception initiating freeze of real user " + realUserId, e);
-            return false;
-        }
-
         ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+
         boolean switching = ami.switchToUserSilently(decoyUserId);
         if (!switching) {
             Slog.e(TAG, "Failed to initiate silent switch to decoy user " + decoyUserId);
             return false;
         }
+
+        // Switch first, then quiesce the now-backgrounded real user -- a still-foreground
+        // process generally cannot be frozen, and AOSP's own stopUsersLU refuses to stop the
+        // current user for the same reason (UserController.java:1327). See
+        // docs/superpowers/specs/2026-08-27-duress-real-user-quiescing-and-return-design.md.
+        boolean suppressionInstalled = ami.quiesceUserApps(realUserId);
+        if (!suppressionInstalled) {
+            Slog.e(TAG, "Failed to install notification suppression for real user "
+                    + realUserId + " -- treating this attempt as not matched");
+            return false;
+        }
         return true;
     }
 
-- 
