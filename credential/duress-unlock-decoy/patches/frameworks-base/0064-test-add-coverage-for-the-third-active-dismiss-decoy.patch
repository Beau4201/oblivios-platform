From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 15:07:51 +0200
Subject: [PATCH 66/89] test: add coverage for the third (active-dismiss) decoy
 switch grant

RED: consumeDecoySwitchAuthorizationForActiveDismiss does not exist yet.
---
 .../android/server/am/UserControllerTest.java | 118 ++++++++++++++++++
 1 file changed, 118 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
index 5084ec03d186..fe72f6177375 100644
--- a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
@@ -2818,6 +2818,124 @@ public class UserControllerTest {
                 TEST_DECOY_USER_ID)).isTrue();
     }
 
+    // AegisOS: the active-dismiss grant below is the third, independent single-use consumption
+    // point derived from the same mint as the forced-lock-skip and bouncer-skip grants above.
+    // Unlike those two -- which fire deterministically, in order, moments apart during the
+    // switch itself -- this grant is redeemed later, whenever the decoy's own freshly-bound
+    // keyguard session first evaluates whether to show a bouncer at all (e.g. on the user's
+    // first swipe), which is why it cannot simply reuse either existing grant: both are
+    // routinely already spent by the time this one is needed. See KeyguardSecurityContainerController
+    // for the consumer.
+
+    @Test
+    public void testDecoySwitchAuthorization_activeDismiss_consumedOnceOnly() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_activeDismiss_wrongUserIdDoesNotConsume() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_OTHER_USER_ID)).isFalse();
+        // The active-dismiss grant must survive an attempt against the wrong id, not be
+        // silently burned.
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_activeDismiss_expiredIsConsumedButNotHonoured() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_activeDismiss_neverMintedIsNotHonoured() {
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_triGrants_allThreeConsumedFromOneMint() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+
+        // All three grants from this mint are now spent; the record is fully cleared, so every
+        // grant type reports false for a repeat attempt, not just the one just consumed.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_triGrants_activeDismissConsumedIndependentlyOfOthers() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        // Consuming only the active-dismiss grant -- exactly the shape of the real swipe-time
+        // redemption, which happens well after the other two are already spent -- must not
+        // disturb the other two, still pending from the same mint.
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_triGrants_expiryAppliesToAllGrantsEvenIfSomeAlreadyConsumedWithinWindow() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        // Consume two of the three grants right away, well inside the window -- mirroring the
+        // real forced-lock-skip and bouncer-skip redemptions, which both happen within
+        // milliseconds of the mint.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        // The active-dismiss grant is being consumed here for the first time, but the mint
+        // itself is now stale -- expiry is a property of the mint's own timestamp, not
+        // something reset independently per grant, and not something two earlier successful
+        // redemptions can paper over for the third.
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_triGrants_reMintResetsAllThreeGrants() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+
+        // A fresh mint always starts with fresh, unconsumed grants for all three -- there is no
+        // way to "stack" a pending authorization across two mints.
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(
+                TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(
+                TEST_DECOY_USER_ID)).isTrue();
+    }
+
     @Test
     public void testForegroundSwitch_authorizedDecoy_doesNotForceKeyguard() throws Exception {
         setUserSecure(TEST_DECOY_USER_ID, true);
