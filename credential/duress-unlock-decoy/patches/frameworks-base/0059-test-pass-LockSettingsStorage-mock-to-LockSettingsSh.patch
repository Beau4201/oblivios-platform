From 35e81a432723727554499ce2c9856ab0c34565d5 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 04:06:29 +0200
Subject: [PATCH 2/3] test: pass LockSettingsStorage mock to
 LockSettingsShellCommand constructor

Unrelated pre-existing compile break: the production constructor gained a
required LockSettingsStorage parameter (set-decoy-profile/
check-credential-routing-status work) but this test's own constructor call
was never updated, breaking compilation of the whole FrameworksServicesTests
module. Test-only change, no production code touched.
---
 .../server/locksettings/LockSettingsShellCommandTest.java      | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsShellCommandTest.java b/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsShellCommandTest.java
index e550a99a520b..66b544b3f7dd 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsShellCommandTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsShellCommandTest.java
@@ -84,6 +84,7 @@ public class LockSettingsShellCommandTest {
     private LockSettingsShellCommand mCommand;
 
     private @Mock LockPatternUtils mLockPatternUtils;
+    private @Mock LockSettingsStorage mLockSettingsStorage;
     private int mUserId;
     private final Binder mBinder = new Binder();
     private final ShellCallback mShellCallback = new ShellCallback();
@@ -96,7 +97,7 @@ public class LockSettingsShellCommandTest {
         final Context context = InstrumentationRegistry.getTargetContext();
         mUserId = ActivityManager.getCurrentUser();
         mCommand = new LockSettingsShellCommand(mLockPatternUtils, context, 0,
-                Process.SHELL_UID);
+                Process.SHELL_UID, mLockSettingsStorage);
         when(mLockPatternUtils.hasSecureLockScreen()).thenReturn(true);
     }
 
