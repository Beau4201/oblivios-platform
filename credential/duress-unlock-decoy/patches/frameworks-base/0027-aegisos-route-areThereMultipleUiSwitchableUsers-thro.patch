From 8f332749213c245d78cfcd6c6d052cf3907b0766 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 30 Aug 2026 19:49:44 +0200
Subject: [PATCH 29/89] aegisos: route areThereMultipleUiSwitchableUsers
 through getUsersForUiDisplay

This private helper gates isUserSwitcherEnabled(), which in turn
controls the status bar's multi-user avatar icon
(KeyguardStatusBarView#mMultiUserAvatar) -- observed directly on
physical hardware during this session. It used the raw getUsers(true),
so a device-wide 2+ user count would surface the icon even during an
AegisOS Duress Unlock decoy session. Currently masked only as an
accidental side effect of the decoy type's own default restriction set
not setting DISALLOW_ADD_USER, not because this method was ever fixed
-- a dormant landmine, found during an exhaustive audit of every
getUsers()-style call site.

Fixed by routing through getUsersForUiDisplay(true), the same
decoy-aware primitive every other Component B fix in this feature
uses, so the icon can never leak regardless of future restriction
defaults.
---
 .../com/android/server/pm/UserManagerService.java | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/pm/UserManagerService.java b/services/core/java/com/android/server/pm/UserManagerService.java
index d39bfe6d34a6..e01d78f4349d 100644
--- a/services/core/java/com/android/server/pm/UserManagerService.java
+++ b/services/core/java/com/android/server/pm/UserManagerService.java
@@ -3453,9 +3453,20 @@ public class UserManagerService extends IUserManager.Stub {
                 || areThereMultipleUiSwitchableUsers(); // There are switchable users
     }
 
-    /** Returns true if there is more than one human user that can be switched to via the UI. */
+    /**
+     * Returns true if there is more than one human user that can be switched to via the UI.
+     *
+     * <p>Uses {@link #getUsersForUiDisplay} rather than the raw {@link #getUsers(boolean)}: this
+     * result gates the status bar's multi-user avatar icon
+     * ({@code KeyguardStatusBarView#mMultiUserAvatar}), which must never itself become a tell
+     * that an AegisOS Duress Unlock decoy session isn't the only profile on the device. It was
+     * previously masked only as a side effect of the decoy user type's own default restriction
+     * set not setting {@code DISALLOW_ADD_USER} (the other half of this method's caller,
+     * {@link #isUserSwitcherEnabled}, short-circuits before reaching this method in that case) —
+     * a coincidence, not a fix, that a future restriction-default change could silently undo.
+     */
     private boolean areThereMultipleUiSwitchableUsers() {
-        List<UserInfo> aliveUsers = getUsers(/* excludeDying= */ true);
+        List<UserInfo> aliveUsers = getUsersForUiDisplay(/* excludeDying= */ true);
         boolean isAnyAliveUser = false;
         for (UserInfo userInfo : aliveUsers) {
             if (userInfo.isUiSwitchableHumanUser()) {
