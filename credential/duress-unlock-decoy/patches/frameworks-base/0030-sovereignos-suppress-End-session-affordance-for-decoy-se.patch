From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 3 Sep 2026 03:54:50 +0200
Subject: [PATCH 32/89] sovereignos: suppress End session affordance for decoy
 session

---
 .../core/java/com/android/server/pm/UserManagerService.java   | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/services/core/java/com/android/server/pm/UserManagerService.java b/services/core/java/com/android/server/pm/UserManagerService.java
index 77fc0786edf3..47e1b34155d4 100644
--- a/services/core/java/com/android/server/pm/UserManagerService.java
+++ b/services/core/java/com/android/server/pm/UserManagerService.java
@@ -3466,6 +3466,10 @@ public class UserManagerService extends IUserManager.Stub {
             return UserManager.LOGOUTABILITY_STATUS_CANNOT_LOGOUT_SYSTEM_USER;
         }
 
+        if (isMainForUiDisplay(userId)) {
+            return UserManager.LOGOUTABILITY_STATUS_CANNOT_LOGOUT_SYSTEM_USER;
+        }
+
         if (getUserSwitchability(userId) != UserManager.SWITCHABILITY_STATUS_OK) {
             return UserManager.LOGOUTABILITY_STATUS_CANNOT_SWITCH;
         }
