From 7477bc952ea45a7fbd0e4b88c022a47523a8e716 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 16:06:58 +0100
Subject: [PATCH 50/54] oblivios: the warm decoy and the lock-time copies run
 only in the owner's session, and the wait for the decoy's unlock does not
 spin

Review findings D1 and D4 (docs/reviews/2026-11-duress-unlock-code-review.md). onKeyguardLockedStateChanged also ran while the decoy was on screen and wrote the owner's brightness, dark mode, volume and wallpaper files over the decoy's live ones, and read the launcher look of the frozen user 0. awaitDecoyUnlocked spun until its deadline when the latch had fired but the user was not yet unlocking.
---
 .../server/locksettings/DecoyProfileHelper.java     | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 8dfe2e013527..7c9452e4d3f3 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -148,6 +148,13 @@ class DecoyProfileHelper {
         if (state == null) {
             return;
         }
+        // ObliviOS: only the owner's own session warms the decoy and copies the owner's look to it.
+        // While the decoy is on screen the mirrors below would write the owner's values over what
+        // the person in the decoy changed (brightness, dark mode, volume: an ordinary phone keeps
+        // them), and the look read would call the frozen launcher of user 0.
+        if (ActivityManager.getCurrentUser() != UserHandle.USER_SYSTEM) {
+            return;
+        }
         ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
         if (ami == null) {
             return;
@@ -412,7 +419,11 @@ class DecoyProfileHelper {
                 return;
             }
             try {
-                unlocked.await(Math.min(left, 50), TimeUnit.MILLISECONDS);
+                // A latch that has fired returns at once; if the user is still not unlocking then,
+                // wait on the clock instead of spinning until the deadline.
+                if (unlocked.await(Math.min(left, 50), TimeUnit.MILLISECONDS)) {
+                    SystemClock.sleep(Math.min(left, 20));
+                }
             } catch (InterruptedException e) {
                 Thread.currentThread().interrupt();
                 return;
-- 
