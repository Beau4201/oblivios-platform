diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
new file mode 100644
index 00000000..0646c0ef
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -0,0 +1,76 @@
+package com.android.server.locksettings;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * ObliviOS: copies the owner's display and lock-screen settings to the Duress decoy user, one way,
+ * so that the screen does not change brightness, time out, rotate or lay out the lock screen
+ * differently when the switch to the decoy happens (a second person could see the step). Free of
+ * Android types so it can be tested on the JVM; DecoyProfileHelper supplies a Store over
+ * Settings.System and Settings.Secure.
+ *
+ * <p>The owner's values are only read. A key the owner does not have is skipped (the decoy keeps
+ * its own value), and a refused write is reported, never thrown, so the credential path that
+ * calls this cannot fail on it.
+ */
+final class DecoySettingsMirror {
+    static final String SYSTEM = "system";
+    static final String SECURE = "secure";
+
+    /** Measured on lynx 2026-11-12: these differed between the owner and the decoy. */
+    static final String[] SYSTEM_KEYS = {
+        "screen_brightness",
+        "screen_brightness_float",
+        "screen_brightness_mode",
+        "screen_auto_brightness_adj",
+        "screen_off_timeout",
+        "accelerometer_rotation",
+        "user_rotation",
+    };
+
+    static final String[] SECURE_KEYS = {
+        "lockscreen_show_controls",
+        "lockscreen_show_wallet",
+        "lock_screen_show_qr_code_scanner",
+        "lock_screen_show_notifications",
+        "lock_screen_allow_private_notifications",
+        "lock_screen_show_only_unseen_notifications",
+        "sysui_qs_tiles",
+    };
+
+    interface Store {
+        /** The value of the key for the user, or null when it is not set. */
+        String get(String namespace, String key, int userId);
+
+        /** Writes the value; may throw when the write is refused. */
+        void put(String namespace, String key, String value, int userId);
+    }
+
+    private DecoySettingsMirror() {}
+
+    /** Copies every listed key from fromUserId to toUserId; returns the keys that could not be written. */
+    static List<String> mirror(Store store, int fromUserId, int toUserId) {
+        List<String> failed = new ArrayList<>();
+        if (fromUserId == toUserId) {
+            return failed;
+        }
+        copy(store, SYSTEM, SYSTEM_KEYS, fromUserId, toUserId, failed);
+        copy(store, SECURE, SECURE_KEYS, fromUserId, toUserId, failed);
+        return failed;
+    }
+
+    private static void copy(Store store, String namespace, String[] keys, int fromUserId,
+            int toUserId, List<String> failed) {
+        for (String key : keys) {
+            try {
+                String value = store.get(namespace, key, fromUserId);
+                if (value != null) {
+                    store.put(namespace, key, value, toUserId);
+                }
+            } catch (RuntimeException e) {
+                failed.add(key);
+            }
+        }
+    }
+}
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
new file mode 100644
index 00000000..f1aee6cd
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -0,0 +1,127 @@
+package com.android.server.locksettings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public class DecoySettingsMirrorTest {
+    private static final int OWNER = 0;
+    private static final int DECOY = 12;
+
+    /** Fake settings store; records every write. */
+    private static final class FakeStore implements DecoySettingsMirror.Store {
+        final Map<String, String> values = new HashMap<>();
+        final List<String> writes = new ArrayList<>();
+        String failingKey;
+
+        private static String id(String ns, String key, int userId) {
+            return ns + "/" + key + "/" + userId;
+        }
+
+        @Override
+        public String get(String ns, String key, int userId) {
+            return values.get(id(ns, key, userId));
+        }
+
+        @Override
+        public void put(String ns, String key, String value, int userId) {
+            if (key.equals(failingKey)) {
+                throw new SecurityException("refused " + key);
+            }
+            writes.add(id(ns, key, userId));
+            values.put(id(ns, key, userId), value);
+        }
+
+        void set(String ns, String key, int userId, String value) {
+            values.put(id(ns, key, userId), value);
+        }
+    }
+
+    private static FakeStore ownerWithEveryKey() {
+        FakeStore s = new FakeStore();
+        for (String k : DecoySettingsMirror.SYSTEM_KEYS) {
+            s.set(DecoySettingsMirror.SYSTEM, k, OWNER, "owner-" + k);
+        }
+        for (String k : DecoySettingsMirror.SECURE_KEYS) {
+            s.set(DecoySettingsMirror.SECURE, k, OWNER, "owner-" + k);
+        }
+        return s;
+    }
+
+    @Test
+    public void mirrorsEveryKeyFromOwnerToDecoy() {
+        FakeStore s = ownerWithEveryKey();
+        List<String> failed = DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertTrue(failed.isEmpty());
+        for (String k : DecoySettingsMirror.SYSTEM_KEYS) {
+            assertEquals("owner-" + k, s.get(DecoySettingsMirror.SYSTEM, k, DECOY));
+        }
+        for (String k : DecoySettingsMirror.SECURE_KEYS) {
+            assertEquals("owner-" + k, s.get(DecoySettingsMirror.SECURE, k, DECOY));
+        }
+    }
+
+    @Test
+    public void listCoversBrightnessAndTimeoutThatTheOwnerSaw() {
+        List<String> system = java.util.Arrays.asList(DecoySettingsMirror.SYSTEM_KEYS);
+        assertTrue(system.contains("screen_brightness"));
+        assertTrue(system.contains("screen_off_timeout"));
+        assertTrue(system.contains("accelerometer_rotation"));
+    }
+
+    @Test
+    public void skipsAKeyThatIsAbsentAndLeavesTheDecoyValue() {
+        FakeStore s = ownerWithEveryKey();
+        s.values.remove("system/screen_off_timeout/" + OWNER);
+        s.set(DecoySettingsMirror.SYSTEM, "screen_off_timeout", DECOY, "decoy-own");
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertEquals("decoy-own", s.get(DecoySettingsMirror.SYSTEM, "screen_off_timeout", DECOY));
+        assertFalse(s.writes.contains("system/screen_off_timeout/" + DECOY));
+    }
+
+    @Test
+    public void ownerValuesAreNeverWritten() {
+        FakeStore s = ownerWithEveryKey();
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        for (String w : s.writes) {
+            assertTrue(w, w.endsWith("/" + DECOY));
+        }
+    }
+
+    @Test
+    public void aFailingPutDoesNotStopTheRestAndIsReported() {
+        FakeStore s = ownerWithEveryKey();
+        s.failingKey = "screen_brightness";
+        List<String> failed = DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertEquals(java.util.Collections.singletonList("screen_brightness"), failed);
+        assertEquals("owner-screen_off_timeout",
+                s.get(DecoySettingsMirror.SYSTEM, "screen_off_timeout", DECOY));
+        assertEquals("owner-sysui_qs_tiles",
+                s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
+        assertNull(s.get(DecoySettingsMirror.SYSTEM, "screen_brightness", DECOY));
+    }
+
+    @Test
+    public void copiesTheNewValueAfterTheOwnerChangedIt() {
+        FakeStore s = ownerWithEveryKey();
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        s.set(DecoySettingsMirror.SYSTEM, "screen_brightness", OWNER, "9");
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertEquals("9", s.get(DecoySettingsMirror.SYSTEM, "screen_brightness", DECOY));
+    }
+
+    @Test
+    public void sameUserWritesNothing() {
+        FakeStore s = ownerWithEveryKey();
+        assertTrue(DecoySettingsMirror.mirror(s, OWNER, OWNER).isEmpty());
+        assertTrue(s.writes.isEmpty());
+    }
+}
