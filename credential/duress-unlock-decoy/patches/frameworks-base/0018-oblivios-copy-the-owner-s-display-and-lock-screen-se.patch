+    private void mirrorOwnerSettingsToDecoy(int realUserId, int decoyUserId) {
+        final ContentResolver resolver = context.getContentResolver();
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final List<String> failed = DecoySettingsMirror.mirror(
+                    new DecoySettingsMirror.Store() {
+                        @Override
+                        public String get(String namespace, String key, int userId) {
+                            return DecoySettingsMirror.SYSTEM.equals(namespace)
+                                    ? Settings.System.getStringForUser(resolver, key, userId)
+                                    : Settings.Secure.getStringForUser(resolver, key, userId);
+                        }
+
+                        @Override
+                        public void put(String namespace, String key, String value, int userId) {
+                            final boolean written = DecoySettingsMirror.SYSTEM.equals(namespace)
+                                    ? Settings.System.putStringForUser(resolver, key, value, userId)
+                                    : Settings.Secure.putStringForUser(resolver, key, value, userId);
+                            if (!written) {
+                                throw new IllegalStateException("not written: " + key);
+                            }
+                        }
+                    }, realUserId, decoyUserId);
+            if (!failed.isEmpty()) {
+                Slog.w(TAG, "Could not mirror settings to the routing target: " + failed);
+            }
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
