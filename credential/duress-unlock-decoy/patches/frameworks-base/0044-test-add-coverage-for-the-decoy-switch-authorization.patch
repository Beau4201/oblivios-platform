+    // AegisOS: Component B's one-shot decoy switch authorization store. See ADR-061 in the
+    // aegisos-foundation repository for why this is a distinct, narrowly-scoped mechanism rather
+    // than a reuse of AOSP's generic skipKeyguardWhenSwitchingToUnlockedUsers condition.
+
+    @Test
+    public void testDecoySwitchAuthorization_consumedOnceOnly() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_wrongUserIdDoesNotConsume() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_OTHER_USER_ID)).isFalse();
+        // The authorization must survive an attempt against the wrong id, not be silently burned.
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isTrue();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_notMintedForNonDecoyUser() {
+        assertThat(mUserController.authorizeDecoySwitchKeyguardSkip(TEST_ORDINARY_USER_ID))
+                .isFalse();
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_ORDINARY_USER_ID))
+                .isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_expiredIsConsumedButNotHonoured() {
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+        advanceElapsedRealtimeBy(UserController.DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS + 1);
+
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
+    @Test
+    public void testDecoySwitchAuthorization_neverMintedIsNotHonoured() {
+        assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
+    }
+
