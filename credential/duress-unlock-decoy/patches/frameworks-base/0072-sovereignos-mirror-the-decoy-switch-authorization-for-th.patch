From ef56ae25eca1aa5387e4b1a49eb1359966226db7 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 16 Sep 2026 01:27:42 +0200
Subject: [PATCH 74/89] sovereignos: mirror the decoy switch authorization for the
 return path

ReturnToRealUserHelper.maybeRouteToRealUser matched the real owner's
credential and switched back via a bare switchToUserSilently, with no
authorization mint at all -- unlike the outbound (owner-to-decoy)
direction, which needed three single-use grants across five sub-cycles
(ADR-085) before a single credential entry actually held. The return
path inherited none of that protection, so UserController's forced
lockNow() and SystemUI's own re-armed bouncer both demanded the same
credential a second time.

Adds authorizeRealUserSwitchKeyguardSkip, a mirror of
authorizeDecoySwitchKeyguardSkip that always targets
UserHandle.USER_SYSTEM and checks the caller is a genuine decoy rather
than checking the target is one. It draws from and pays out the same
one-shot, three-grant record, so every existing
consumeDecoySwitchAuthorizationFor* call site -- already generic on
target user id -- needs no change. ReturnToRealUserHelper now mints
this authorization and, matching DecoyProfileHelper's own established
pattern, defers the actual switch to the handler instead of calling it
inline, avoiding the same forced-lockNow()-vs-bouncer-dismissal race
DecoyProfileHelper already had to avoid.
---
 .../android/app/ActivityManagerInternal.java  | 10 +++++
 .../server/am/ActivityManagerService.java     |  5 +++
 .../com/android/server/am/UserController.java | 31 +++++++++++++
 .../locksettings/ReturnToRealUserHelper.java  | 44 ++++++++++++++++---
 4 files changed, 85 insertions(+), 5 deletions(-)

diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index f2d4b0828a15..e882cc2a6676 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1515,6 +1515,16 @@ public abstract class ActivityManagerInternal {
      */
     public abstract boolean authorizeDecoySwitchKeyguardSkip(int targetUserId);
 
+    /**
+     * The return-direction mirror of {@link #authorizeDecoySwitchKeyguardSkip}: authorizes
+     * exactly one upcoming foreground switch to {@code UserHandle.USER_SYSTEM} to proceed without
+     * forcing the keyguard, for a caller that has just verified the real owner's own credential
+     * from within a decoy session. The authorization is single-use and expires shortly. Returns
+     * false, minting nothing, if {@code callerUserId} is not an existing decoy-type user. See
+     * {@link com.android.server.am.UserController#authorizeRealUserSwitchKeyguardSkip}.
+     */
+    public abstract boolean authorizeRealUserSwitchKeyguardSkip(int callerUserId);
+
     /**
      * Consumes, at most once, the bouncer-skip half of an existing decoy-switch authorization for
      * {@code userId}, if one was minted (via {@link #authorizeDecoySwitchKeyguardSkip}) and has
diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index 38b9e047fa16..7966b12bcc9e 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -17633,6 +17633,11 @@ public class ActivityManagerService extends IActivityManager.Stub
             return mUserController.authorizeDecoySwitchKeyguardSkip(targetUserId);
         }
 
+        @Override
+        public boolean authorizeRealUserSwitchKeyguardSkip(int callerUserId) {
+            return mUserController.authorizeRealUserSwitchKeyguardSkip(callerUserId);
+        }
+
         @Override
         public boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId) {
             return mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index 36857406da07..932ebba5201d 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -2795,6 +2795,37 @@ class UserController implements Handler.Callback {
         return true;
     }
 
+    /**
+     * SovereignOS: the return-direction mirror of authorizeDecoySwitchKeyguardSkip, always targeting
+     * UserHandle.USER_SYSTEM. Rejects any call where callerUserId is not an existing decoy-type
+     * user: the same ADR-064-motivated check as the outbound mint, inverted -- the direction
+     * being minted FROM must be genuinely earned by a real decoy-session credential match, not
+     * assumed from the caller's own claim. Draws from and pays out the exact same one-shot,
+     * three-grant record as authorizeDecoySwitchKeyguardSkip (there is still only ever one
+     * pending authorization at a time, and the two directions are never concurrent), so every
+     * existing consumeDecoySwitchAuthorizationFor* call site needs no change to honour it.
+     *
+     * @return true if an authorization was minted.
+     */
+    boolean authorizeRealUserSwitchKeyguardSkip(int callerUserId) {
+        UserManagerInternal umi = mInjector.getUserManagerInternal();
+        UserInfo callerInfo = umi == null ? null : umi.getUserInfo(callerUserId);
+        if (callerInfo == null
+                || !UserManager.USER_TYPE_FULL_AEGISOS_DECOY.equals(callerInfo.userType)) {
+            return false;
+        }
+        synchronized (mLock) {
+            mSwitchAuthorizedUserId = UserHandle.USER_SYSTEM;
+            mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
+            mSwitchAuthorizedAtSequence = mSwitchSequenceNumber;
+            mAwaitingAuthorizedSwitch = true;
+            mForcedLockSkipConsumed = false;
+            mBouncerSkipConsumed = false;
+            mActiveDismissConsumed = false;
+        }
+        return true;
+    }
+
     /**
      * SovereignOS: identifies which of the three independent single-use grants derived from one
      * mint a consumeGrantLocked call is redeeming. See mForcedLockSkipConsumed's javadoc for why
diff --git a/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java b/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
index 59badfe018ac..7dd679d22ac6 100644
--- a/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
+++ b/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
@@ -2,6 +2,7 @@ package com.android.server.locksettings;
 
 import android.annotation.Nullable;
 import android.app.ActivityManagerInternal;
+import android.os.Handler;
 import android.os.UserHandle;
 import android.util.Slog;
 
@@ -32,7 +33,7 @@ class ReturnToRealUserHelper {
      * Called from doVerifyCredentialInner immediately before it would otherwise return a
      * not-matched response for the currently registered decoy user under LockDomain.Primary.
      * Returns a synthesized matched response if the credential matches the real owner's own
-     * primary credential and the switch back was successfully initiated; otherwise returns
+     * primary credential and the switch back was successfully authorized; otherwise returns
      * null, meaning the caller should return its own original not-matched response unchanged.
      */
     @Nullable
@@ -48,13 +49,46 @@ class ReturnToRealUserHelper {
             return null;
         }
 
+        // Mint the same one-shot, three-grant authorization the outbound direction already
+        // proved out on physical hardware (ADR-085): without it, UserController's forced
+        // lockNow() and SystemUI's own re-armed bouncer both demand this exact credential a
+        // second time moments later -- the mint is what UserController#consumeDecoySwitchAuthorization
+        // and its two SystemUI-side siblings check for, and they are already generic on target
+        // user id, so no call site downstream of the mint needs to change for this direction.
         ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
-        boolean switching = ami.switchToUserSilently(UserHandle.USER_SYSTEM);
-        if (!switching) {
-            Slog.e(TAG, "Real owner credential matched but switch back could not be initiated"
-                    + " -- treating this attempt as not matched");
+        if (ami == null || !ami.authorizeRealUserSwitchKeyguardSkip(userId)) {
             return null;
         }
+
+        // Perform the switch after this response has been delivered, not inline: doing it
+        // inline races UserController's forced lockNow() against the dismissal of the very
+        // bouncer the credential was just typed into, which re-shows a live bouncer and demands
+        // the same credential a second time -- the exact race DecoyProfileHelper.maybeRouteToDecoy
+        // already avoids by posting, mirrored here for the same reason.
+        getHandler().post(this::performRealUserSwitch);
         return VerifyCredentialResponse.OK;
     }
+
+    /**
+     * Runs on the handler, after maybeRouteToRealUser's response has already been delivered. Any
+     * failure here can no longer flip that response -- it falls back to the pre-fix behavior
+     * instead (the real session is still reached, via a second credential prompt) rather than
+     * failing closed: the credential already genuinely matched, so a hard failure here would
+     * strand the owner behind a session they just proved they own.
+     */
+    private void performRealUserSwitch() {
+        ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+        if (ami == null || !ami.switchToUserSilently(UserHandle.USER_SYSTEM)) {
+            Slog.e(TAG, "Real owner credential matched but switch back could not be initiated"
+                    + " -- treating this attempt as not matched");
+        }
+    }
+
+    /**
+     * LockSettingsService's own dedicated-ServiceThread handler, reused here rather than adding
+     * a new dependency, matching DecoyProfileHelper's own getHandler().
+     */
+    private Handler getHandler() {
+        return lockSettingsService.mHandler;
+    }
 }
