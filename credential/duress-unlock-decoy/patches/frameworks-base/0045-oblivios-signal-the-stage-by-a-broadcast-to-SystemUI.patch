From d1c9886a9a1d1394c1f7d8d36a86c787f2a46cd0 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 04:34:22 +0100
Subject: [PATCH 45/45] oblivios: signal the stage by a broadcast to SystemUI
 only, not a persisted setting, and gate its warnings to debuggable builds

---
 .../keyguard/AuthorizedSwitchStage.java       | 50 ++++++++++++++-----
 .../android/server/DecoyWallpaperHold.java    |  4 +-
 .../server/wm/WallpaperController.java        | 15 +++---
 3 files changed, 48 insertions(+), 21 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
index 7dcd226c..e75e3963 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -5,10 +5,12 @@ import android.app.WallpaperManager;
 import android.content.Context;
 import android.graphics.Bitmap;
 import android.graphics.Color;
-import android.database.ContentObserver;
+import android.content.BroadcastReceiver;
+import android.content.Intent;
+import android.content.IntentFilter;
 import android.graphics.PixelFormat;
+import android.os.Build;
 import android.os.Handler;
-import android.provider.Settings;
 import android.util.Log;
 import android.view.View;
 import android.view.WindowManager;
@@ -32,13 +34,20 @@ import android.widget.ImageView;
  * notification shade, so the pad, the scrim and the rest of the keyguard's exit are drawn over it
  * and the keyguard policy does not hide it while the keyguard is showing. It asks for the
  * wallpaper too, so the window that holds the wallpaper layer is stable (see
- * com.android.server.DecoyWallpaperHold). It stays until the window manager reports that\n * the incoming home has drawn (a counter in the secure settings, written by\n * com.android.server.wm.WallpaperController when an activity window becomes the wallpaper target),\n * then fades out over the home; {@link #FALLBACK_MS} ends it when no report comes. The wallpaper\n * layer under it is in a broken state until the home draws (the card), which is why it has to stay\n * that long. Without a bitmap (not loaded yet, or it failed) the window is empty and transparent\n * and only holds the wallpaper request.
+ * com.android.server.DecoyWallpaperHold). It stays until the window manager reports that
+ * the incoming home has drawn (a broadcast to this package only, sent by
+ * com.android.server.wm.WallpaperController when an activity window becomes the wallpaper target;
+ * nothing is persisted and no app can receive it), then fades out over the home;
+ * {@link #FALLBACK_MS} ends it when no report comes. The wallpaper layer under it is in a broken
+ * state until the home draws (the card), which is why it has to stay that long. Without a bitmap
+ * (not loaded yet, or it failed) the window is empty and transparent and only holds the wallpaper
+ * request.
  */
 public final class AuthorizedSwitchStage {
     private static final String TAG = "AuthorizedSwitchStage";
     static final long FALLBACK_MS = 3_000L;
     static final long FADE_MS = 200L;
-    private static final String RELEASE_KEY = "oblivios_stage_release";
+    private static final String RELEASE_ACTION = "com.android.systemui.STAGE_RELEASE";
 
     private final Context mContext;
     private final Handler mHandler;
@@ -47,6 +56,16 @@ public final class AuthorizedSwitchStage {
     private volatile Bitmap mBitmap;
     private View mView;
 
+    /**
+     * Debuggable builds only: a warning that exists only for the decoy would show on a user build
+     * that a decoy is set up (the same reason as the stage logs of the window manager).
+     */
+    private static void warn(String message, Throwable e) {
+        if (Build.IS_DEBUGGABLE) {
+            Log.w(TAG, message, e);
+        }
+    }
+
     public AuthorizedSwitchStage(Context context, Handler handler) {
         mContext = context;
         mHandler = handler;
@@ -68,7 +87,7 @@ public final class AuthorizedSwitchStage {
                         userId, true /* hardware */, WallpaperManager.FLAG_SYSTEM,
                         true /* returnDefault */);
             } catch (RuntimeException | OutOfMemoryError e) {
-                Log.w(TAG, "Could not load the wallpaper for the stage", e);
+                warn("Could not load the wallpaper for the stage", e);
                 mBitmap = null;
             }
         }, "SwitchStagePreload").start();
@@ -111,20 +130,21 @@ public final class AuthorizedSwitchStage {
                 mContext.getSystemService(WindowManager.class).addView(view, lp);
                 mView = view;
             } catch (RuntimeException e) {
-                Log.w(TAG, "Could not add the stage window", e);
+                warn("Could not add the stage window", e);
                 return;
             }
-            // The window manager writes this counter when the incoming home has drawn.
-            mContext.getContentResolver().registerContentObserver(
-                    Settings.Secure.getUriFor(RELEASE_KEY), false, mReleaseObserver);
+            // The window manager sends this broadcast when the incoming home has drawn. The
+            // receiver is not exported: no app can send it, and no app receives it.
+            mContext.registerReceiver(mReleaseReceiver,
+                    new IntentFilter(RELEASE_ACTION), Context.RECEIVER_NOT_EXPORTED);
         }
         // The timer is only the fallback for a release that never comes.
         mHandler.postDelayed(mFade, FALLBACK_MS);
     }
 
-    private final ContentObserver mReleaseObserver = new ContentObserver(null) {
+    private final BroadcastReceiver mReleaseReceiver = new BroadcastReceiver() {
         @Override
-        public void onChange(boolean selfChange) {
+        public void onReceive(Context context, Intent intent) {
             mHandler.removeCallbacks(mFade);
             mHandler.post(AuthorizedSwitchStage.this::fadeOut);
         }
@@ -142,7 +162,11 @@ public final class AuthorizedSwitchStage {
     public void hide() {
         mHandler.removeCallbacks(mFade);
         mHandler.removeCallbacks(mRemove);
-        mContext.getContentResolver().unregisterContentObserver(mReleaseObserver);
+        try {
+            mContext.unregisterReceiver(mReleaseReceiver);
+        } catch (IllegalArgumentException e) {
+            // not registered: the window was never added
+        }
         mBitmap = null;
         if (mView == null) {
             return;
@@ -150,7 +174,7 @@ public final class AuthorizedSwitchStage {
         try {
             mContext.getSystemService(WindowManager.class).removeViewImmediate(mView);
         } catch (RuntimeException e) {
-            Log.w(TAG, "Could not remove the stage window", e);
+            warn("Could not remove the stage window", e);
         }
         mView = null;
     }
diff --git a/services/core/java/com/android/server/DecoyWallpaperHold.java b/services/core/java/com/android/server/DecoyWallpaperHold.java
index 836ae968..78ed7b7e 100644
--- a/services/core/java/com/android/server/DecoyWallpaperHold.java
+++ b/services/core/java/com/android/server/DecoyWallpaperHold.java
@@ -29,8 +29,8 @@ public final class DecoyWallpaperHold {
 
     /**
      * Called once, when the hold ends because the incoming home is the wallpaper target. The
-     * window manager sets it to write a counter that SystemUI's stage watches (see
-     * AuthorizedSwitchStage), the only signal between the two that needs no framework change.
+     * window manager sets it to send SystemUI's stage a broadcast (see AuthorizedSwitchStage), the
+     * signal between the two that needs no framework change and leaves nothing on disk.
      */
     public static void setReleaseSink(Runnable sink) {
         sReleaseSink = sink;
diff --git a/services/core/java/com/android/server/wm/WallpaperController.java b/services/core/java/com/android/server/wm/WallpaperController.java
index 18f7ce30..b70fb5c1 100644
--- a/services/core/java/com/android/server/wm/WallpaperController.java
+++ b/services/core/java/com/android/server/wm/WallpaperController.java
@@ -212,15 +212,18 @@ class WallpaperController {
         mService = service;
         mDisplayContent = displayContent;
         // ObliviOS: tells SystemUI's stage of an authorized switch that the incoming home has
-        // drawn (see DecoyWallpaperHold). A counter in the owner's secure settings, written off the
-        // window manager lock: apps of the owner can already see a user switch by its broadcasts.
+        // drawn (see DecoyWallpaperHold). A broadcast to SystemUI's package only: it is not
+        // persisted anywhere and no app can receive it (the receiver is not exported), so it leaves
+        // no trace that a duress switch happened. A persisted settings key was the first version
+        // and was refused in review: its presence in the secure settings proves a switch. Sent off
+        // the window manager lock.
         com.android.server.DecoyWallpaperHold.setReleaseSink(() ->
                 com.android.internal.os.BackgroundThread.getHandler().post(() -> {
                     try {
-                        android.provider.Settings.Secure.putIntForUser(
-                                service.mContext.getContentResolver(), "oblivios_stage_release",
-                                (int) (android.os.SystemClock.elapsedRealtime() & 0x3fffffff),
-                                android.os.UserHandle.USER_SYSTEM);
+                        service.mContext.sendBroadcastAsUser(
+                                new android.content.Intent("com.android.systemui.STAGE_RELEASE")
+                                        .setPackage("com.android.systemui"),
+                                android.os.UserHandle.SYSTEM);
                     } catch (RuntimeException e) {
                         // the stage falls back to its own timer
                     }
