From ae91efc39bb57af15f4fbf96c817d6a939dc153d Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sat, 14 Nov 2026 21:27:25 +0100
Subject: [PATCH] oblivios: do not kill the decoy's packages at the start of
 the switch back, its home is the stage of the exit

stopPreviousUserApps killed the decoy launcher 0.18 s into the return switch while the keyguard exit was animating over it; the log showed a black screen and a cut-off wallpaper corner after it (lynx 2026111401). The stop of the switch still ends the decoy after the switch has completed.
---
 .../com/android/server/am/UserController.java  | 10 ++++++++++
 .../android/server/am/UserControllerTest.java  | 18 ++++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index 107f78a7..0091e6b5 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -732,6 +732,16 @@ class UserController implements Handler.Callback {
         if (fromUserId == UserHandle.USER_SYSTEM) {
             return false;
         }
+        // ObliviOS: the decoy session stays on screen while the exit of the switch back plays: the
+        // keyguard going-away is animated over its home screen until the owner's home has drawn
+        // again. Killing its packages at the start of the switch removed that home, and with it the
+        // stage of the animation, 0.2 s into the exit (lynx 2026-11-14: the decoy launcher killed at
+        // +0.18 s, a black screen and a cut-off wallpaper corner followed). The stop of the switch
+        // (stopUserOnSwitchIfEnforced) still ends the decoy, after the switch has completed.
+        final UserInfo fromUser = getUserInfo(fromUserId);
+        if (fromUser != null && UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(fromUser.userType)) {
+            return false;
+        }
         return isStopUserOnSwitchEnabled();
     }
 
diff --git a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
index 130f6ca3..7616f007 100644
--- a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
@@ -1934,6 +1934,24 @@ public class UserControllerTest {
                 .isEarlyPackageKillEnabledForUserSwitch(SYSTEM_USER_ID, TEST_USER_ID1));
     }
 
+    @Test
+    public void testEarlyPackageKillEnabledForUserSwitch_notWhenLeavingTheDecoy() {
+        mUserController.setInitialConfig(/* userSwitchUiEnabled= */ true,
+                /* maxRunningUsers= */ 4, /* delayUserDataLocking= */ true,
+                /* backgroundUserConsideredDispensableTimeSecs= */
+                -1, /* skipKeyguardWhenSwitchingToUnlockedUsers= */ false,
+                /* hideUserSwitchingUiDuringSetup= */ false);
+        // The same switch is early-killed for an ordinary user (the enabled test above) and not
+        // for the decoy: its home screen is the stage of the exit of the switch back.
+        setUpUser(TEST_USER_ID, DEFAULT_USER_FLAGS, /* preCreated= */ false,
+                UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY);
+
+        assertFalse(mUserController
+                .isEarlyPackageKillEnabledForUserSwitch(TEST_USER_ID, SYSTEM_USER_ID));
+        assertFalse(mUserController
+                .isEarlyPackageKillEnabledForUserSwitch(TEST_USER_ID, TEST_USER_ID1));
+    }
+
     @Test
     public void testEarlyPackageKillEnabledForUserSwitch_stopUserOnSwitchModeOn() {
         mUserController.setInitialConfig(/* userSwitchUiEnabled= */ true,
-- 
