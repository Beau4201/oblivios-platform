--- a/packages/SystemUI/src/com/android/systemui/keyguard/ui/viewmodel/PrimaryBouncerToGoneTransitionViewModel.kt
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/ui/viewmodel/PrimaryBouncerToGoneTransitionViewModel.kt
@@ -20,6 +20,7 @@ import android.util.MathUtils
 import com.android.systemui.Flags
 import com.android.systemui.bouncer.domain.interactor.PrimaryBouncerInteractor
 import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.keyguard.AuthorizedSwitchExit
 import com.android.systemui.keyguard.domain.interactor.FromPrimaryBouncerTransitionInteractor.Companion.TO_GONE_DURATION
 import com.android.systemui.keyguard.domain.interactor.FromPrimaryBouncerTransitionInteractor.Companion.TO_GONE_SHORT_DURATION
 import com.android.systemui.keyguard.domain.interactor.KeyguardDismissActionInteractor
@@ -81,7 +82,23 @@ constructor(
                     MathUtils.lerp(startAlpha, 0f, it)
                 }
             },
-            onFinish = { 1f },
+            // ObliviOS: for an authorized switch the stack stays hidden when this transition ends.
+            // It ends 500 ms after SystemUI calls going-away; the window manager starts the exit of
+            // a switch later than that, so raising the alpha here showed the stack, a card for a few
+            // frames and at times stuck, over the empty stage until the keyguard hid (lynx
+            // 2026-11-13). The shade alpha takes over once the status bar state is SHADE, see
+            // SharedNotificationContainerViewModel#keyguardAlpha. An ordinary unlock is unchanged.
+            onFinish = {
+                if (
+                    AuthorizedSwitchExit.isActive() &&
+                        !willRunDismissFromKeyguard &&
+                        !leaveShadeOpen
+                ) {
+                    0f
+                } else {
+                    1f
+                }
+            },
         )
     }
 
