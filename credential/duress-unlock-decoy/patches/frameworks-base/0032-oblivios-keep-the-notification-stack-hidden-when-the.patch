diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchExit.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchExit.java
new file mode 100644
index 00000000..b117abe6
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchExit.java
@@ -0,0 +1,30 @@
+package com.android.systemui.keyguard;
+
+/**
+ * ObliviOS: whether the keyguard exit now running belongs to an authorized switch (the Duress
+ * decoy, in either direction). It is set when the dismissal of such a switch is requested and
+ * cleared when the next switch starts or the keyguard is shown again.
+ *
+ * <p>Read by the notification alpha of the bouncer-to-gone transitions: for an ordinary unlock the
+ * stack's alpha is raised to 1 when the transition ends, as upstream has it and as this class
+ * leaves it; for an authorized switch the window manager starts the exit later than the 500 ms of
+ * that transition, so the raise would show the stack over an empty stage. The ordinary unlock is
+ * never changed.
+ *
+ * <p>shortcut: a process-wide static flag instead of an injected interactor, because SystemUI has
+ * one keyguard and the two view models would otherwise need a new constructor argument and test
+ * fixtures; replace it when more than this one reader needs the mark.
+ */
+public final class AuthorizedSwitchExit {
+    private static volatile boolean sActive;
+
+    private AuthorizedSwitchExit() {}
+
+    public static void setActive(boolean active) {
+        sActive = active;
+    }
+
+    public static boolean isActive() {
+        return sActive;
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 6aa7f16f..7d3f26d9 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -741,6 +741,7 @@ public class KeyguardViewMediator implements CoreStartable,
             mAuthorizedSwitchDismissPending = mLockPatternUtils.isSecure(userId)
                     && mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
             mAuthorizedSwitchDismissRequested = false;
+            AuthorizedSwitchExit.setActive(false);
             mHandler.removeMessages(START_KEYGUARD_EXIT_ANIM);
             mHandler.removeMessages(DISMISS);
             mHandler.removeMessages(HIDE);
@@ -793,6 +794,7 @@ public class KeyguardViewMediator implements CoreStartable,
                 // cannot uncover the outgoing user's windows. The same single-use dismissal that
                 // handleUserSwitchComplete requests, requested earlier.
                 mAuthorizedSwitchDismissRequested = true;
+                AuthorizedSwitchExit.setActive(true);
                 mHandler.postDelayed(
                         () -> dismiss(null /* callback */, null /* message */), mDismissToken, 0);
             }
@@ -3342,6 +3344,8 @@ public class KeyguardViewMediator implements CoreStartable,
      */
     private void handleShow(Bundle options) {
         Trace.beginSection("KeyguardViewMediator#handleShow");
+        // ObliviOS: the exit of an authorized switch is over once the keyguard is shown again.
+        AuthorizedSwitchExit.setActive(false);
         try {
             handleShowInner(options);
         } finally {
