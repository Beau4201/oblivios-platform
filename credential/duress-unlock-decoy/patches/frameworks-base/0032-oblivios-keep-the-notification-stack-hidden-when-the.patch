                 }
             },
-            onFinish = { 1f },
+            // ObliviOS: hidden at the end of an authorized switch; the reason is at
+            // PrimaryBouncerToGoneTransitionViewModel#notificationAlpha.
+            onFinish = { if (AuthorizedSwitchExit.isActive() && !leaveShadeOpen) 0f else 1f },
