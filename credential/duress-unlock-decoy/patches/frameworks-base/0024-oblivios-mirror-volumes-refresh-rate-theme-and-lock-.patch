From dad2a93dc3410813658e3ae4f9d1df9df34cf608 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 17:45:16 +0100
Subject: [PATCH] oblivios: mirror volumes, refresh rate, theme and lock screen
 values the decoy lacked

---
 .../locksettings/DecoySettingsMirror.java     | 68 ++++++++++++++++---
 .../locksettings/DecoySettingsMirrorTest.java | 39 +++++++++++
 2 files changed, 98 insertions(+), 9 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
index 74c7f477..1a3b48c8 100644
--- a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -21,17 +21,52 @@ final class DecoySettingsMirror {
     static final String SYSTEM = "system";
     static final String SECURE = "secure";
 
-    /** Measured on lynx 2026-11-12: these differed between the owner and the decoy. */
-    static final String[] SYSTEM_KEYS = {
-        "screen_brightness",
-        "screen_brightness_float",
-        "screen_brightness_mode",
-        "screen_auto_brightness_adj",
-        "screen_off_timeout",
-        "accelerometer_rotation",
-        "user_rotation",
+    private static final String[] VOLUME_STREAMS = {
+        "alarm", "ring", "notification", "system", "music", "voice", "bluetooth_sco",
+        "accessibility", "dtmf",
     };
 
+    private static final String[] VOLUME_DEVICES = {
+        "", "_speaker", "_earpiece", "_headset", "_headphone", "_bt_a2dp", "_bt_sco",
+        "_hearing_aid", "_usb_headset",
+    };
+
+    /**
+     * Measured on lynx 2026-11-12 and 2026-11-13: these differed between the owner and the decoy,
+     * and each one is something a second person can see or hear at the switch (brightness, timeout,
+     * rotation, volume steps, refresh rate, touches, fonts, clock format). A key the owner does not
+     * have is skipped, so the volume list can be generous about streams and devices.
+     */
+    static final String[] SYSTEM_KEYS = systemKeys();
+
+    private static String[] systemKeys() {
+        List<String> keys = new ArrayList<>(java.util.Arrays.asList(
+                "screen_brightness",
+                "screen_brightness_float",
+                "screen_brightness_mode",
+                "screen_auto_brightness_adj",
+                "screen_off_timeout",
+                "accelerometer_rotation",
+                "user_rotation",
+                "mode_ringer_streams_affected",
+                "peak_refresh_rate",
+                "min_refresh_rate",
+                "show_touches",
+                "hide_rotation_lock_toggle_for_accessibility",
+                "font_scale",
+                "time_12_24",
+                "haptic_feedback_enabled",
+                "sound_effects_enabled",
+                "lockscreen_sounds_enabled",
+                "vibrate_when_ringing"));
+        for (String stream : VOLUME_STREAMS) {
+            for (String device : VOLUME_DEVICES) {
+                keys.add("volume_" + stream + device);
+            }
+        }
+        return keys.toArray(new String[0]);
+    }
+
     static final String[] SECURE_KEYS = {
         "lockscreen_show_controls",
         "lockscreen_show_wallet",
@@ -46,6 +81,21 @@ final class DecoySettingsMirror {
         "ui_night_mode_custom_type",
         "dark_theme_custom_start_time",
         "dark_theme_custom_end_time",
+        // The theme source and style (a small JSON of colour settings, no package of an app).
+        "theme_customization_overlay_packages",
+        // Measured on lynx 2026-11-13: owner-only values of the lock screen, status bar and launcher.
+        "immersive_mode_confirmations",
+        "hush_gesture_used",
+        "launcher_taskbar_education_showing",
+        "doze_pulse_on_double_tap",
+        "doze_tap_gesture",
+        "doze_always_on",
+        "sysui_do_not_disturb",
+        "clock_seconds",
+        "icon_blacklist",
+        "adaptive_sleep",
+        "notification_history_enabled",
+        "mirror_built_in_display",
     };
 
     interface Store {
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
index 18feba21..259a4d69 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -88,6 +88,45 @@ public class DecoySettingsMirrorTest {
         assertTrue(secure.contains("dark_theme_custom_end_time"));
     }
 
+    @Test
+    public void listCoversTheVolumesAndSettingsThatDifferedOnTheDevice() {
+        // lynx 2026-11-13: volume_music 5 against 8, volume_system 7 against 5, volume_voice,
+        // mode_ringer_streams_affected 422 against 166, peak_refresh_rate, show_touches.
+        List<String> system = java.util.Arrays.asList(DecoySettingsMirror.SYSTEM_KEYS);
+        for (String k : new String[] {"volume_music", "volume_music_speaker", "volume_music_bt_a2dp",
+                "volume_system", "volume_voice", "volume_voice_earpiece", "volume_ring_speaker",
+                "volume_alarm", "volume_notification", "mode_ringer_streams_affected",
+                "peak_refresh_rate", "show_touches", "font_scale", "time_12_24"}) {
+            assertTrue(k, system.contains(k));
+        }
+        List<String> secure = java.util.Arrays.asList(DecoySettingsMirror.SECURE_KEYS);
+        for (String k : new String[] {"immersive_mode_confirmations", "hush_gesture_used",
+                "launcher_taskbar_education_showing", "doze_tap_gesture", "clock_seconds",
+                "icon_blacklist", "mirror_built_in_display"}) {
+            assertTrue(k, secure.contains(k));
+        }
+    }
+
+    @Test
+    public void listCoversTheThemeSettingTheDecoyLacked() {
+        // lynx 2026-11-13: the decoy's theme setting had no theme_style, SystemUI logged a JSON
+        // failure at the switch and re-evaluated the theme, which relaunched the home (0.79 s).
+        assertTrue(java.util.Arrays.asList(DecoySettingsMirror.SECURE_KEYS)
+                .contains("theme_customization_overlay_packages"));
+    }
+
+    @Test
+    public void identifiersAndAccountsOfTheOwnerAreNeverOnTheList() {
+        // These would tie the decoy to the owner's device or accounts; the decoy keeps its own.
+        List<String> all = new ArrayList<>(java.util.Arrays.asList(DecoySettingsMirror.SYSTEM_KEYS));
+        all.addAll(java.util.Arrays.asList(DecoySettingsMirror.SECURE_KEYS));
+        for (String k : new String[] {"android_id", "bluetooth_address", "autofill_service",
+                "credential_service", "credential_service_primary", "ringtone", "alarm_alert",
+                "notification_sound", "audio_device_inventory", "always_on_vpn_app"}) {
+            assertFalse(k, all.contains(k));
+        }
+    }
+
     @Test
     public void skipsAKeyThatIsAbsentAndLeavesTheDecoyValue() {
         FakeStore s = ownerWithEveryKey();
-- 
2.47.3

