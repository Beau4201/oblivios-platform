+    /**
+     * SovereignOS: mints the one-shot authorization described on mSwitchAuthorizedUserId. Rejects any
+     * target that is not an existing decoy-type user: every identity-concealment fix in this
+     * feature keys off UserInfo.userType, so a wrong-typed target would switch correctly while
+     * silently receiving none of them (ADR-064 found exactly that class of gap).
+     *
+     * @return true if an authorization was minted.
+     */
+    boolean authorizeDecoySwitchKeyguardSkip(int targetUserId) {
+        UserManagerInternal umi = mInjector.getUserManagerInternal();
+        UserInfo targetInfo = umi == null ? null : umi.getUserInfo(targetUserId);
+        if (targetInfo == null
+                || !UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(targetInfo.userType)) {
+            return false;
+        }
+        synchronized (mLock) {
+            mSwitchAuthorizedUserId = targetUserId;
+            mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
+        }
+        return true;
+    }
+
+    /**
+     * SovereignOS: consumes an authorization for userId. An authorization matching userId is always
+     * cleared, whether or not it was still valid, so an expired one can never be reused. An
+     * authorization for a different user is left intact.
+     */
+    @VisibleForTesting
+    boolean consumeDecoySwitchAuthorization(int userId) {
+        synchronized (mLock) {
+            if (mSwitchAuthorizedUserId == UserHandle.USER_NULL
+                    || mSwitchAuthorizedUserId != userId) {
+                return false;
+            }
+            final long ageMillis = mInjector.elapsedRealtime() - mSwitchAuthorizedAtMillis;
+            mSwitchAuthorizedUserId = UserHandle.USER_NULL;
+            mSwitchAuthorizedAtMillis = 0L;
+            return ageMillis >= 0 && ageMillis <= DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS;
+        }
+    }
