new file mode 100644
index 000000000000..4aeb1e0b71da
--- /dev/null
+++ b/frameworks/base/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
@@ -0,0 +1,60 @@
+package com.android.server.locksettings;
+
+import android.annotation.Nullable;
+import android.app.ActivityManagerInternal;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import com.android.internal.widget.LockscreenCredential;
+import com.android.internal.widget.VerifyCredentialResponse;
+import com.android.server.LocalServices;
+
+/**
+ * The mirror image of DecoyProfileHelper: routes a failed credential check for the currently
+ * registered decoy user back to the real owner (UserHandle.USER_SYSTEM), if the entered
+ * credential matches the real owner's own primary credential. See
+ * docs/superpowers/specs/2026-08-27-duress-real-user-quiescing-and-return-design.md in the
+ * aegisos-foundation repository.
+ */
+class ReturnToRealUserHelper {
+    private static final String TAG = "ReturnToRealUserHelper";
+
+    private final LockSettingsService lockSettingsService;
+    private final LockSettingsStorage lockSettingsStorage;
+
+    ReturnToRealUserHelper(LockSettingsService lockSettingsService,
+            LockSettingsStorage lockSettingsStorage) {
+        this.lockSettingsService = lockSettingsService;
+        this.lockSettingsStorage = lockSettingsStorage;
+    }
+
+    /**
+     * Called from doVerifyCredentialInner immediately before it would otherwise return a
+     * not-matched response for the currently registered decoy user under LockDomain.Primary.
+     * Returns a synthesized matched response if the credential matches the real owner's own
+     * primary credential and the switch back was successfully initiated; otherwise returns
+     * null, meaning the caller should return its own original not-matched response unchanged.
+     */
+    @Nullable
+    VerifyCredentialResponse maybeRouteToRealUser(LockscreenCredential credential, int userId) {
+        DecoyProfileState state = DecoyProfileState.maybeGet(lockSettingsStorage);
+        if (state == null || state.decoyUserId != userId) {
+            return null;
+        }
+
+        VerifyCredentialResponse response = lockSettingsService.verifyPrimaryCredentialNoRouting(
+                credential, UserHandle.USER_SYSTEM);
+        if (!response.isMatched()) {
+            return null;
+        }
+
+        ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+        boolean switching = ami.switchToUserSilently(UserHandle.USER_SYSTEM);
+        if (!switching) {
+            Slog.e(TAG, "Real owner credential matched but switch back could not be initiated"
+                    + " -- treating this attempt as not matched");
+            return null;
+        }
+        return VerifyCredentialResponse.OK;
+    }
+}
