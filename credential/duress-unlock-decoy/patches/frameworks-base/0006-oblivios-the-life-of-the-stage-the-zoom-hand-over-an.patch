From 0e0c22c7f256ebc843cc44bbde8e29deddbb85c9 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 14:23:21 +0100
Subject: [PATCH] oblivios: the life of the stage, the zoom hand-over and the
 length and end of the keyguard exit

Squash of former patches:

- 0046 oblivios: give the stage window of an authorized switch a window token of its own, so it is not hidden with the notification shade
- 0047 oblivios: the stage of an authorized switch follows the wallpaper zoom, so the hand-over to the real wallpaper has no jump
- 0048 oblivios: the keyguard exit of an authorized switch lasts as long as an ordinary one, so the pad, the scrim, the blur and the zoom are not cut
- 0049 oblivios: the keyguard exit of an authorized switch tells the window manager at once, holds the views until the bouncer transition has finished and fades the shade out
---
 .../keyguard/AuthorizedSwitchStage.java       |  65 ++++++++-
 .../keyguard/KeyguardViewMediator.java        | 130 +++++++++++++++++-
 .../NotificationShadeDepthController.kt       |   3 +
 3 files changed, 193 insertions(+), 5 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
index e75e3963..19dbec7a 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -9,9 +9,11 @@ import android.content.BroadcastReceiver;
 import android.content.Intent;
 import android.content.IntentFilter;
 import android.graphics.PixelFormat;
+import android.hardware.display.DisplayManager;
 import android.os.Build;
 import android.os.Handler;
 import android.util.Log;
+import android.view.Display;
 import android.view.View;
 import android.view.WindowManager;
 import android.widget.ImageView;
@@ -55,6 +57,60 @@ public final class AuthorizedSwitchStage {
     private final Runnable mRemove = this::hide;
     private volatile Bitmap mBitmap;
     private View mView;
+    private WindowManager mStageWm;
+
+    /**
+     * The zoom the wallpaper layer has: the window manager scales it by lerp(min, max, 1 - zoomOut)
+     * (WallpaperController#zoomOutToScale), and SystemUI sends zoomOut from the blur of the shade
+     * (NotificationShadeDepthController#onZoomOutChanged), 1 with the pad up and 0 with the shade
+     * gone. The picture of the stage is the wallpaper at zoomOut 1; the real home is 10% larger
+     * (lynx 2026-11-15, frames: the stage picture scaled by 1.10 equals the home, mean error 7.1
+     * against 1.2), which showed as the background zooming in when the stage gave way. The stage
+     * follows the same value, so the hand-over has no jump.
+     */
+    private static volatile float sZoomOut = 1f;
+    private static volatile AuthorizedSwitchStage sShown;
+
+    /** Called by the depth controller on every zoom value it sends to the wallpaper. Main thread. */
+    public static void onZoomOut(float zoomOut) {
+        sZoomOut = zoomOut;
+        final AuthorizedSwitchStage stage = sShown;
+        if (stage != null) {
+            stage.applyZoom();
+        }
+    }
+
+    private void applyZoom() {
+        final View view = mView;
+        if (view == null) {
+            return;
+        }
+        final android.content.res.Resources res = mContext.getResources();
+        final float min = res.getFloat(com.android.internal.R.dimen.config_wallpaperMinScale);
+        final float max = res.getFloat(com.android.internal.R.dimen.config_wallpaperMaxScale);
+        final float scale = android.util.MathUtils.lerp(min, max, 1f - sZoomOut) / min;
+        view.setScaleX(scale);
+        view.setScaleY(scale);
+    }
+
+    /**
+     * The window manager of a window token of the stage's own. With the context of the keyguard the
+     * stage got the token of SystemUI's other windows and was hidden together with the notification
+     * shade when the keyguard's exit ended, 0.45 to 0.55 s after it was added, before the incoming
+     * home had drawn (lynx 2026-11-15, layer samples: the stage layer "hidden by parent or layer
+     * flag" in the sample in which the shade layer left). A window of its own token stays until it
+     * is removed.
+     */
+    private WindowManager stageWindowManager() {
+        if (mStageWm == null) {
+            final Display display = mContext.getSystemService(DisplayManager.class)
+                    .getDisplay(Display.DEFAULT_DISPLAY);
+            mStageWm = mContext.createWindowContext(display,
+                    WindowManager.LayoutParams.TYPE_STATUS_BAR_ADDITIONAL, null /* options */)
+                    .getSystemService(WindowManager.class);
+        }
+        return mStageWm;
+    }
 
     /**
      * Debuggable builds only: a warning that exists only for the decoy would show on a user build
@@ -127,8 +183,10 @@ public final class AuthorizedSwitchStage {
                     WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS;
             lp.setTitle("SwitchStage");
             try {
-                mContext.getSystemService(WindowManager.class).addView(view, lp);
+                stageWindowManager().addView(view, lp);
                 mView = view;
+                sShown = this;
+                applyZoom();
             } catch (RuntimeException e) {
                 warn("Could not add the stage window", e);
                 return;
@@ -168,11 +226,14 @@ public final class AuthorizedSwitchStage {
             // not registered: the window was never added
         }
         mBitmap = null;
+        if (sShown == this) {
+            sShown = null;
+        }
         if (mView == null) {
             return;
         }
         try {
-            mContext.getSystemService(WindowManager.class).removeViewImmediate(mView);
+            stageWindowManager().removeViewImmediate(mView);
         } catch (RuntimeException e) {
             warn("Could not remove the stage window", e);
         }
diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 95350e97..aa720458 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -533,6 +533,52 @@ public class KeyguardViewMediator implements CoreStartable,
     /** ObliviOS: the wallpaper stage of an authorized switch; created on first use, main thread. */
     private AuthorizedSwitchStage mSwitchStage;
 
+    /**
+     * ObliviOS: how long the keyguard's views of an authorized switch stay after the going-away: the
+     * bouncer to gone transition (scrim, blur, pad) runs 0.53 s (lynx 2026-11-15 logcat, started
+     * to finished 0.525 s), and a hide before it has finished leaves the scrim at a random
+     * brightness (51 to 76 percent of the final one in 4 unlocks) that then jumps to full.
+     */
+    private static final long AUTHORIZED_EXIT_HOLD_MS = 500L;
+
+    /** ObliviOS: the fade of the shade at the end of the held exit of an authorized switch. */
+    private static final long AUTHORIZED_EXIT_FADE_MS = 250L;
+
+    /**
+     * ObliviOS: the window manager has been told at once that the keyguard is gone for an
+     * authorized switch (see handleStartKeyguardExitAnimationInner), so the one call that would
+     * follow when the held exit ends is skipped. With the call held for 450 ms the incoming home
+     * could not draw behind the keyguard's views and appeared 0.3 s later (1.38 s against 1.06 s
+     * after the credential check on lynx 2026-11-15). Main thread.
+     */
+    private boolean mAuthorizedExitWmNotified;
+
+    /** ObliviOS: the root view of the shade while it fades out at the end of a held exit. */
+    private android.view.View mHeldExitFadeView;
+
+    /**
+     * ObliviOS: a held exit of an authorized switch that does not finish (the phone is locked again,
+     * another switch starts, the window manager cancels the exit) leaves the window manager believing
+     * that the keyguard is gone while this class still shows it. Tell the window manager that it is
+     * shown again, so the two cannot disagree (fail closed). Main thread.
+     */
+    private void restoreWmKeyguardShownAfterHeldExit(String reason) {
+        if (mHeldExitFadeView != null) {
+            // A fade of the shade that is still running is stopped and the shade is shown in full.
+            final android.view.View fading = mHeldExitFadeView;
+            mHeldExitFadeView = null;
+            fading.animate().cancel();
+            fading.setAlpha(1f);
+        }
+        if (!mAuthorizedExitWmNotified) {
+            return;
+        }
+        mAuthorizedExitWmNotified = false;
+        if (mShowing) {
+            updateActivityLockScreenState(true, mAodShowing, reason);
+        }
+    }
+
     // last known state of the cellular connection
     private final String mPhoneState = TelephonyManager.EXTRA_STATE_IDLE;
 
@@ -745,6 +791,7 @@ public class KeyguardViewMediator implements CoreStartable,
                     && mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
             mAuthorizedSwitchDismissRequested = false;
             AuthorizedSwitchExit.setActive(false);
+            restoreWmKeyguardShownAfterHeldExit("a switch began during a held exit");
             if (mAuthorizedSwitchDismissPending && Settings.Global.getInt(
                     mContext.getContentResolver(), "oblivios_duress_fast", 1) != 0) {
                 // ObliviOS: the stage keeps the wallpaper on screen behind the exit of this switch
@@ -3336,6 +3383,11 @@ public class KeyguardViewMediator implements CoreStartable,
         if (SceneContainerFlag.isEnabled()) {
             return;
         }
+        if (!showing && mAuthorizedExitWmNotified) {
+            // ObliviOS: sent already when the held exit of an authorized switch began.
+            mAuthorizedExitWmNotified = false;
+            return;
+        }
 
         mUiBgExecutor.execute(() -> {
             Log.d(TAG, "updateActivityLockScreenState(" + showing + ", " + aodShowing + ", "
@@ -3363,6 +3415,7 @@ public class KeyguardViewMediator implements CoreStartable,
         Trace.beginSection("KeyguardViewMediator#handleShow");
         // ObliviOS: the exit of an authorized switch is over once the keyguard is shown again.
         AuthorizedSwitchExit.setActive(false);
+        restoreWmKeyguardShownAfterHeldExit("handleShow during a held exit");
         // The wallpaper of the stage of a coming authorized switch is loaded now, off the main
         // thread (see AuthorizedSwitchStage).
         if (mSwitchStage == null) {
@@ -3795,10 +3848,69 @@ public class KeyguardViewMediator implements CoreStartable,
                         createInteractionJankMonitorConf(
                                 CUJ_LOCKSCREEN_UNLOCK_ANIMATION, "RemoteAnimationDisabled"));
 
+                // ObliviOS: an authorized switch has no app behind the keyguard here (the incoming
+                // home has not drawn), so the ordinary exit, the surface animation of about 447 ms
+                // with the keyguard on screen until it ends, ran for 17 ms and the pad, the scrim,
+                // the blur and the wallpaper zoom were cut after 0.2 s of their 0.5 s (lynx
+                // 2026-11-15, logcat: "Keyguard exit without a corresponding app to show"). The
+                // window manager's callback below still goes out at once; only the end of the
+                // keyguard's own exit waits.
+                final boolean heldExit = AuthorizedSwitchExit.isActive()
+                        && (params.getApps() == null || params.getApps().length == 0);
+                if (heldExit && !KeyguardWmStateRefactor.isEnabled()) {
+                    // The window manager hears at once that the keyguard is gone, so the incoming
+                    // home can draw behind the keyguard's views while they finish.
+                    updateActivityLockScreenState(false, false, "authorized switch exit");
+                    mAuthorizedExitWmNotified = true;
+                }
                 if (!KeyguardWmStateRefactor.isEnabled()) {
                     // Handled directly in StatusBarKeyguardViewManager if enabled.
-                    mKeyguardViewControllerLazy.get()
-                            .hide(params.startTime, params.fadeoutDuration);
+                    if (heldExit) {
+                        mHandler.postDelayed(() -> {
+                            if (!AuthorizedSwitchExit.isActive() || mIsKeyguardExitAnimationCanceled) {
+                                restoreWmKeyguardShownAfterHeldExit("held exit canceled");
+                                return;
+                            }
+                            // The shade fades out instead of going in one frame: its scrim still
+                            // darkened the picture by about 40% when the hold ended and the
+                            // picture jumped to full brightness (lynx 2026-11-15, mean luminance
+                            // per frame 53 then 91). The alpha is restored after the hide.
+                            final android.view.ViewRootImpl root = mKeyguardViewControllerLazy.get()
+                                    .getViewRootImpl();
+                            final android.view.View rootView = root != null ? root.getView() : null;
+                            if (rootView == null) {
+                                mKeyguardViewControllerLazy.get()
+                                        .hide(params.startTime, params.fadeoutDuration);
+                                return;
+                            }
+                            mHeldExitFadeView = rootView;
+                            rootView.animate().alpha(0f).setDuration(AUTHORIZED_EXIT_FADE_MS)
+                                    .setListener(new android.animation.AnimatorListenerAdapter() {
+                                        @Override
+                                        public void onAnimationCancel(
+                                                android.animation.Animator animation) {
+                                            rootView.setAlpha(1f);
+                                        }
+                                    })
+                                    .withEndAction(() -> {
+                                        mHeldExitFadeView = null;
+                                        if (!AuthorizedSwitchExit.isActive()
+                                                || mIsKeyguardExitAnimationCanceled) {
+                                            // The phone was locked again during the fade.
+                                            rootView.setAlpha(1f);
+                                            restoreWmKeyguardShownAfterHeldExit(
+                                                    "held exit canceled during the fade");
+                                            return;
+                                        }
+                                        mKeyguardViewControllerLazy.get()
+                                                .hide(params.startTime, params.fadeoutDuration);
+                                        rootView.post(() -> rootView.setAlpha(1f));
+                                    }).start();
+                        }, AUTHORIZED_EXIT_HOLD_MS);
+                    } else {
+                        mKeyguardViewControllerLazy.get()
+                                .hide(params.startTime, params.fadeoutDuration);
+                    }
                 }
 
                 // TODO(bc-animation): When remote animation is enabled for keyguard exit animation,
@@ -3874,7 +3986,19 @@ public class KeyguardViewMediator implements CoreStartable,
                     anim.start();
                 });
 
-                onKeyguardExitFinished("remote animation disabled");
+                if (heldExit) {
+                    mHandler.postDelayed(() -> {
+                        synchronized (KeyguardViewMediator.this) {
+                            if (AuthorizedSwitchExit.isActive() && !mIsKeyguardExitAnimationCanceled) {
+                                onKeyguardExitFinished("remote animation disabled, held");
+                            } else {
+                                restoreWmKeyguardShownAfterHeldExit("held exit canceled");
+                            }
+                        }
+                    }, AUTHORIZED_EXIT_HOLD_MS + AUTHORIZED_EXIT_FADE_MS);
+                } else {
+                    onKeyguardExitFinished("remote animation disabled");
+                }
             }
         }
     }
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt b/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt
index 65c93346..97cf0e3b 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShadeDepthController.kt
@@ -370,6 +370,9 @@ constructor(
     private fun onZoomOutChanged(zoomOutFromShadeRadius: Float) {
         TrackTracer.instantForGroup("shade", "zoom_out", zoomOutFromShadeRadius)
         Log.v(TAG, "onZoomOutChanged $zoomOutFromShadeRadius")
