From e15abc1a26ffa79563ec6665c20fda337d6d94f6 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Mon, 7 Sep 2026 18:58:50 +0200
Subject: [PATCH] aegisos: rename decoy-identifying log tags and messages to
 neutral text

---
 .../java/com/android/server/am/RealUserQuiescer.java   |  2 +-
 .../server/locksettings/DecoyProfileHelper.java        | 10 +++++-----
 .../android/server/locksettings/DecoyProfileState.java |  6 +++---
 .../server/locksettings/ReturnToRealUserHelper.java    |  2 +-
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/services/core/java/com/android/server/am/RealUserQuiescer.java b/services/core/java/com/android/server/am/RealUserQuiescer.java
index 0946e3a55cad..dbc15d113689 100644
--- a/services/core/java/com/android/server/am/RealUserQuiescer.java
+++ b/services/core/java/com/android/server/am/RealUserQuiescer.java
@@ -19,7 +19,7 @@ import java.util.Set;
  * isQuiesced() directly via ActivityManagerInternal.
  */
 class RealUserQuiescer {
-    private static final String TAG = "RealUserQuiescer";
+    private static final String TAG = "SessionQuiescer";
 
     private final ActivityManagerService mAm;
     private final CachedAppOptimizer mCachedAppOptimizer;
diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 9f445630fdcd..568e50f8b07e 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -28,7 +28,7 @@ import com.android.server.pm.UserManagerInternal;
  * aegisos-foundation repository.
  */
 class DecoyProfileHelper {
-    private static final String TAG = "DecoyProfileHelper";
+    private static final String TAG = "CredentialRoutingHelper";
 
     private final LockSettingsService lockSettingsService;
     private final LockSettingsStorage lockSettingsStorage;
@@ -71,8 +71,8 @@ class DecoyProfileHelper {
         }
 
         if (!freezeAndSwitchToDecoy(state.decoyUserId)) {
-            Slog.e(TAG, "Decoy credential matched but freeze/switch could not be initiated -- "
-                    + "treating this attempt as not matched");
+            Slog.e(TAG, "Target-user credential matched but freeze/switch could not be "
+                    + "initiated -- treating this attempt as not matched");
             return null;
         }
         return VerifyCredentialResponse.OK;
@@ -84,7 +84,7 @@ class DecoyProfileHelper {
 
         boolean switching = ami.switchToUserSilently(decoyUserId);
         if (!switching) {
-            Slog.e(TAG, "Failed to initiate silent switch to decoy user " + decoyUserId);
+            Slog.e(TAG, "Failed to initiate silent switch to target user " + decoyUserId);
             return false;
         }
 
@@ -186,7 +186,7 @@ class DecoyProfileHelper {
             // to register at all because of an unrelated Settings-store hiccup is a worse outcome
             // than a decoy that is briefly more distinguishable than intended.
             Slog.w(TAG, "Settings.Secure.putIntForUser(USER_SETUP_COMPLETE) returned false for "
-                    + "decoy user " + decoyUserId + " -- the decoy profile is registered but may "
+                    + "target user " + decoyUserId + " -- the profile is registered but may "
                     + "still be distinguishable from a fully set-up profile until this is "
                     + "retried");
         }
diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileState.java b/services/core/java/com/android/server/locksettings/DecoyProfileState.java
index b4ab5022277c..2270fe21b538 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileState.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileState.java
@@ -11,7 +11,7 @@ import android.util.Slog;
  * aegisos-foundation repository.
  */
 class DecoyProfileState {
-    private static final String TAG = "DecoyProfileState";
+    private static final String TAG = "CredentialRoutingState";
 
     final int decoyUserId;
 
@@ -42,12 +42,12 @@ class DecoyProfileState {
             String[] parts = s.split(":", 2);
             int version = Integer.parseInt(parts[0]);
             if (parts.length != 2 || version > VERSION) {
-                Slog.e(TAG, "Unrecognized decoy profile state version, treating as Off");
+                Slog.e(TAG, "Unrecognized routing state version, treating as Off");
                 return null;
             }
             return new DecoyProfileState(Integer.parseInt(parts[1]));
         } catch (RuntimeException e) {
-            Slog.e(TAG, "Corrupt decoy profile state, treating as Off", e);
+            Slog.e(TAG, "Corrupt routing state, treating as Off", e);
             return null;
         }
     }
diff --git a/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java b/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
index 4aeb1e0b71da..59badfe018ac 100644
--- a/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
+++ b/services/core/java/com/android/server/locksettings/ReturnToRealUserHelper.java
@@ -17,7 +17,7 @@ import com.android.server.LocalServices;
  * aegisos-foundation repository.
  */
 class ReturnToRealUserHelper {
-    private static final String TAG = "ReturnToRealUserHelper";
+    private static final String TAG = "SessionReturnHelper";
 
     private final LockSettingsService lockSettingsService;
     private final LockSettingsStorage lockSettingsStorage;
-- 
2.39.5

