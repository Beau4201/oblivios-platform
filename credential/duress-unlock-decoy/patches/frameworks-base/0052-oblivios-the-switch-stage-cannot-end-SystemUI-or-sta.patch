From 6a0f670e4fe6583fa506166f07452330035619d2 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 16:06:58 +0100
Subject: [PATCH 52/54] oblivios: the switch stage cannot end SystemUI or stay
 up when its receiver fails, and decodes one wallpaper at a time

Review findings D5 and D6. show() registered its release receiver after adding the window; a registerReceiver failure threw on the main thread and left the window without the fallback timer. preload() started a decode of the full wallpaper at every keyguard show, so two could run at once.
---
 .../keyguard/AuthorizedSwitchStage.java       | 22 ++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
index 19dbec7acd28..46cb8a74acb6 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -18,6 +18,8 @@ import android.view.View;
 import android.view.WindowManager;
 import android.widget.ImageView;
 
+import java.util.concurrent.atomic.AtomicBoolean;
+
 /**
  * ObliviOS: the stage of an authorized switch (the Duress decoy, in either direction): one window
  * under the keyguard that shows the wallpaper itself for the first part of the exit, so that the
@@ -56,6 +58,7 @@ public final class AuthorizedSwitchStage {
     private final Runnable mFade = this::fadeOut;
     private final Runnable mRemove = this::hide;
     private volatile Bitmap mBitmap;
+    private final AtomicBoolean mPreloading = new AtomicBoolean();
     private View mView;
     private WindowManager mStageWm;
 
@@ -133,6 +136,11 @@ public final class AuthorizedSwitchStage {
      * until the stage has been shown, so a switch finds it ready.
      */
     public void preload() {
+        // One decode at a time: the keyguard is shown at every lock, and two decodes of the full
+        // wallpaper at once cost memory that SystemUI does not need. The next lock loads again.
+        if (!mPreloading.compareAndSet(false, true)) {
+            return;
+        }
         final int userId = ActivityManager.getCurrentUser();
         new Thread(() -> {
             try {
@@ -145,6 +153,8 @@ public final class AuthorizedSwitchStage {
             } catch (RuntimeException | OutOfMemoryError e) {
                 warn("Could not load the wallpaper for the stage", e);
                 mBitmap = null;
+            } finally {
+                mPreloading.set(false);
             }
         }, "SwitchStagePreload").start();
     }
@@ -192,9 +202,15 @@ public final class AuthorizedSwitchStage {
                 return;
             }
             // The window manager sends this broadcast when the incoming home has drawn. The
-            // receiver is not exported: no app can send it, and no app receives it.
-            mContext.registerReceiver(mReleaseReceiver,
-                    new IntentFilter(RELEASE_ACTION), Context.RECEIVER_NOT_EXPORTED);
+            // receiver is not exported: no app can send it, and no app receives it. A receiver that
+            // cannot be registered must neither end SystemUI here nor leave the window without a
+            // way out: the fallback timer below removes the stage then.
+            try {
+                mContext.registerReceiver(mReleaseReceiver,
+                        new IntentFilter(RELEASE_ACTION), Context.RECEIVER_NOT_EXPORTED);
+            } catch (RuntimeException e) {
+                warn("Could not register the release receiver of the stage", e);
+            }
         }
         // The timer is only the fallback for a release that never comes.
         mHandler.postDelayed(mFade, FALLBACK_MS);
