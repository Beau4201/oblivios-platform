From 87f79157bd48dbef7ebfa55e47e2cf57b71be72b Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 20 Sep 2026 18:27:21 +0200
Subject: [PATCH] sovereignos: fix RealUserQuiescerTest checked-exception compile
 error

setFinalField() declares throws Exception but was called directly inside
the Runnable lambda passed to runWithDexmakerShareClassLoader(), whose
functional interface (java.lang.Runnable) does not permit checked
exceptions. Wrap the calls in try/catch and rethrow unchecked, matching
the existing idiom used elsewhere for this exact JUnit rule.

Never caught before because atest never actually compiled this test
target until now.
---
 .../server/am/RealUserQuiescerTest.java        | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java b/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java
index ee31da4..9213d00 100644
--- a/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java
@@ -52,13 +52,17 @@ public class RealUserQuiescerTest {
     @Before
     public void setUp() throws Exception {
         runWithDexmakerShareClassLoader(() -> {
-            mAm = mock(ActivityManagerService.class);
-            setFinalField(ActivityManagerService.class, mAm, "mProcLock",
-                    new ActivityManagerProcLock());
-            mProcessList = new ProcessList();
-            setFinalField(ActivityManagerService.class, mAm, "mProcessList", mProcessList);
-            mCachedAppOptimizer = mock(CachedAppOptimizer.class);
-            mQuiescer = new RealUserQuiescer(mAm, mCachedAppOptimizer);
+            try {
+                mAm = mock(ActivityManagerService.class);
+                setFinalField(ActivityManagerService.class, mAm, "mProcLock",
+                        new ActivityManagerProcLock());
+                mProcessList = new ProcessList();
+                setFinalField(ActivityManagerService.class, mAm, "mProcessList", mProcessList);
+                mCachedAppOptimizer = mock(CachedAppOptimizer.class);
+                mQuiescer = new RealUserQuiescer(mAm, mCachedAppOptimizer);
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
         });
     }
 
-- 
