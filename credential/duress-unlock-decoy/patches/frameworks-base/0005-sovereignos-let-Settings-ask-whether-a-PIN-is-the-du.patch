From: sovereignos <sovereignos@localhost>
Date: Wed, 7 Oct 2026 06:12:52 +0200
Subject: [PATCH 5/5] sovereignos: let Settings ask whether a PIN is the duress
 wipe PIN

A Duress Unlock decoy PIN equal to the wipe PIN is silently preferred by
decoy routing, so the wipe would never run. Settings cannot check this
itself: the wipe credential is only verifiable inside system_server and a
failed checkCredential would start the wipe or the decoy switch.

Adds ILockSettings#isDuressWipeCredential(ownerCredential, candidate),
appended last so no transaction code shifts. It needs the write
permission and the owner credential and runs no wipe and no routing.
---
 .../android/internal/widget/ILockSettings.aidl   |  1 +
 .../internal/widget/LockPatternUtils.java        | 15 +++++++++++++++
 .../locksettings/DuressPasswordHelper.java       | 16 ++++++++++++++++
 .../server/locksettings/LockSettingsService.java | 15 +++++++++++++++
 4 files changed, 47 insertions(+)

diff --git a/core/java/com/android/internal/widget/ILockSettings.aidl b/core/java/com/android/internal/widget/ILockSettings.aidl
index 3f3f170..52d0e7d 100644
--- a/core/java/com/android/internal/widget/ILockSettings.aidl
+++ b/core/java/com/android/internal/widget/ILockSettings.aidl
@@ -121,4 +121,5 @@ interface ILockSettings {
     void clearDecoyProfile(in LockscreenCredential ownerCredential);
     boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId);
     boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId);
+    boolean isDuressWipeCredential(in LockscreenCredential ownerCredential, in LockscreenCredential candidate);
 }
diff --git a/core/java/com/android/internal/widget/LockPatternUtils.java b/core/java/com/android/internal/widget/LockPatternUtils.java
index 6eda7f7..efabccd 100644
--- a/core/java/com/android/internal/widget/LockPatternUtils.java
+++ b/core/java/com/android/internal/widget/LockPatternUtils.java
@@ -2323,6 +2323,21 @@ public class LockPatternUtils {
         }
     }
 
+    /**
+     * SovereignOS: whether {@code candidate} equals the configured duress wipe PIN or password.
+     * Lets the Duress Unlock set-up screen refuse a decoy PIN that decoy routing would let
+     * shadow the wipe. Requires the owner credential, like {@link #hasDuressCredentials}. Runs no
+     * wipe and no decoy routing, unlike {@code checkCredential}.
+     */
+    public boolean isDuressWipeCredential(@NonNull LockscreenCredential ownerCredential,
+            @NonNull LockscreenCredential candidate) {
+        try {
+            return getLockSettings().isDuressWipeCredential(ownerCredential, candidate);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
     public void setDecoyProfile(@NonNull LockscreenCredential ownerCredential, int decoyUserId) {
         try {
             getLockSettings().setDecoyProfile(ownerCredential, decoyUserId);
diff --git a/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java b/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
index 10359d7..cbe6140 100644
--- a/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
+++ b/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
@@ -105,6 +105,22 @@ public class DuressPasswordHelper {
         return DuressCredentials.maybeGet(lockSettingsStorage) != null;
     }
 
+    /**
+     * SovereignOS: whether {@code candidate} is the configured wipe PIN or password. A Duress
+     * Unlock decoy PIN equal to the wipe PIN would make decoy routing replace the verification
+     * response before onVerifyCredentialResult sees it, so the wipe would never run. The caller
+     * must prove it knows the owner credential, so this is not an oracle for anyone else. It runs
+     * the same isDuressCredential check as the wipe hook, with no side effect.
+     */
+    protected boolean isDuressWipeCredential(LockscreenCredential ownerCredential,
+            LockscreenCredential candidate) {
+        Objects.requireNonNull(ownerCredential, "ownerCredential");
+        Objects.requireNonNull(candidate, "candidate");
+
+        checkOwnerCredential(ownerCredential);
+        return isDuressCredential(candidate);
+    }
+
     private boolean isDuressCredential(LockscreenCredential credential) {
         int credentialType = credential.getType();
         switch (credentialType) {
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index 4a781d3..858907e 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -4608,6 +4608,21 @@ public class LockSettingsService extends ILockSettings.Stub {
         return duressPasswordHelper.hasDuressCredentials(ownerCredential);
     }
 
+    // SovereignOS: write permission, not the read one, because the answer reveals whether a guess
+    // is the wipe credential. See DuressPasswordHelper#isDuressWipeCredential.
+    @Override
+    public boolean isDuressWipeCredential(LockscreenCredential ownerCredential,
+            LockscreenCredential candidate) {
+        checkWritePermission();
+        try {
+            return duressPasswordHelper.isDuressWipeCredential(ownerCredential, candidate);
+        } finally {
+            // The candidate is a typed PIN in clear; do not leave it in this process's heap.
+            LockscreenCredential.zeroizeIfFromParcel(candidate);
+            LockscreenCredential.zeroizeIfFromParcel(ownerCredential);
+        }
+    }
+
     @Override
     public void setDecoyProfile(LockscreenCredential ownerCredential, int decoyUserId) {
         checkWritePermission();
