From 98263b5cdd275d6a1b05df5b4626afeedf3d40c2 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 15:09:39 +0200
Subject: [PATCH 67/85] aegisos: expose the decoy switch active-dismiss
 authorization to SystemUI

Pure delegation bridge (ActivityManagerInternal -> ActivityManagerService
-> ILockSettings -> LockSettingsService -> LockPatternUtils), mirroring
the existing bouncer-skip bridge exactly. No decision logic added at
any layer; the one real decision (does a matching, unexpired,
unconsumed grant exist) lives entirely in UserController.consumeGrantLocked.
---
 .../android/app/ActivityManagerInternal.java  | 13 ++++++++++
 .../internal/widget/ILockSettings.aidl        |  1 +
 .../internal/widget/LockPatternUtils.java     | 25 +++++++++++++++++++
 .../server/am/ActivityManagerService.java     |  5 ++++
 .../locksettings/LockSettingsService.java     | 14 +++++++++++
 5 files changed, 58 insertions(+)

diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index 42aa26f0e8da..f2d4b0828a15 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1525,6 +1525,19 @@ public abstract class ActivityManagerInternal {
      */
     public abstract boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId);
 
+    /**
+     * Consumes, at most once, the active-dismiss third of an existing decoy-switch authorization
+     * for {@code userId}, if one was minted (via {@link #authorizeDecoySwitchKeyguardSkip}) and
+     * has not expired or already been consumed by this same third. Returns false if no such
+     * authorization exists. This is a pure read/consume of already-minted state -- it cannot
+     * itself authorize anything. Unlike {@link #consumeDecoySwitchAuthorizationForBouncerSkip},
+     * which is consumed moments after the switch completes, this is consumed later, only when
+     * the decoy's own freshly-bound keyguard session first evaluates whether to show a bouncer
+     * at all. See
+     * {@link com.android.server.am.UserController#consumeDecoySwitchAuthorizationForActiveDismiss}.
+     */
+    public abstract boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId);
+
     /**
      * Best-effort freezes userId's app processes and installs a notification-suppression flag
      * for it. Returns whether the notification-suppression flag was installed (freeze failures
diff --git a/core/java/com/android/internal/widget/ILockSettings.aidl b/core/java/com/android/internal/widget/ILockSettings.aidl
index 7a858d13773c..3f3f170d37c1 100644
--- a/core/java/com/android/internal/widget/ILockSettings.aidl
+++ b/core/java/com/android/internal/widget/ILockSettings.aidl
@@ -120,4 +120,5 @@ interface ILockSettings {
     void setDecoyProfile(in LockscreenCredential ownerCredential, int decoyUserId);
     void clearDecoyProfile(in LockscreenCredential ownerCredential);
     boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId);
+    boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId);
 }
diff --git a/core/java/com/android/internal/widget/LockPatternUtils.java b/core/java/com/android/internal/widget/LockPatternUtils.java
index ea13d2b1474a..432467c7f660 100644
--- a/core/java/com/android/internal/widget/LockPatternUtils.java
+++ b/core/java/com/android/internal/widget/LockPatternUtils.java
@@ -1693,6 +1693,31 @@ public class LockPatternUtils {
         }
     }
 
+    /**
+     * AegisOS: consumes, at most once, the active-dismiss third of an existing decoy-switch
+     * authorization for {@code userId}. This is a genuine single-use state mutation in
+     * system_server, not an idempotent read, so it is deliberately never cached (unlike
+     * {@link #isSecure(int)} above). On any doubt -- including a RemoteException, which normally
+     * means system_server died, or a SecurityException from a permission misconfiguration --
+     * this fails closed and returns false, since the only effect of a false return is that the
+     * caller still requires an ordinary credential entry. See
+     * {@link com.android.server.am.UserController#consumeDecoySwitchAuthorizationForActiveDismiss}.
+     */
+    public boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId) {
+        try {
+            return getLockSettings().consumeDecoySwitchAuthorizationForActiveDismiss(userId);
+        } catch (RemoteException | SecurityException e) {
+            // Deliberately worded without naming the mechanism -- this log line is reachable
+            // from a decoy session. Fails closed: the caller still requires an ordinary
+            // credential entry. SecurityException is caught alongside RemoteException so a
+            // permission misconfiguration on the service side degrades to the same fail-closed
+            // behavior as every other branch of this check, instead of propagating uncaught
+            // into the keyguard's own call site.
+            Log.e(TAG, "failed to check active-dismiss authorization for switch", e);
+            return false;
+        }
+    }
+
     /**
      * @see StrongAuthTracker#isBiometricAllowedForUser(int)
      */
diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index 575a48a5a385..38b9e047fa16 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -17638,6 +17638,11 @@ public class ActivityManagerService extends IActivityManager.Stub
             return mUserController.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
         }
 
+        @Override
+        public boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId) {
+            return mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(userId);
+        }
+
         @Override
         public boolean quiesceUserApps(int userId) {
             mRealUserQuiescer.quiesce(userId);
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index a80902e77cef..87dde87b7400 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -4605,6 +4605,20 @@ public class LockSettingsService extends ILockSettings.Stub {
         return ami != null && ami.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
     }
 
+    /**
+     * AegisOS: pure delegation to the ActivityManagerInternal bridge over
+     * UserController's own decoy switch authorization store -- see
+     * ActivityManagerInternal#consumeDecoySwitchAuthorizationForActiveDismiss. This is a
+     * single-use state mutation in system_server, never an idempotent read, so it must never
+     * be cached by a caller.
+     */
+    @Override
+    public boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId) {
+        checkHavePermission();
+        ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+        return ami != null && ami.consumeDecoySwitchAuthorizationForActiveDismiss(userId);
+    }
+
     Context getContext() {
         return mContext;
     }
