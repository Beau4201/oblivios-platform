From a34966f48fa9258162e7f5f27d4ecc61eddb6892 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Fri, 28 Aug 2026 19:43:44 +0200
Subject: [PATCH 20/89] aegisos: route SystemUI user-switcher and power-menu
 through getUsersForUiDisplay

---
 .../android/systemui/globalactions/GlobalActionsDialogLite.java | 2 +-
 .../android/systemui/user/data/repository/UserRepositoryImpl.kt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java b/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java
index dc11e240c285..f7abefefeb22 100644
--- a/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java
+++ b/packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java
@@ -1567,7 +1567,7 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
 
     private void addUserActions(List<Action> actions, UserInfo currentUser) {
         if (mUserManager.isUserSwitcherEnabled()) {
-            List<UserInfo> users = mUserManager.getUsers();
+            List<UserInfo> users = mUserManager.getUsersForUiDisplay(true);
             for (final UserInfo user : users) {
                 if (user.isUiSwitchableHumanUser()) {
                     boolean isCurrentUser = currentUser == null
diff --git a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
index c0b5286381b6..f236b3b6dd57 100644
--- a/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
+++ b/packages/SystemUI/src/com/android/systemui/user/data/repository/UserRepositoryImpl.kt
@@ -264,7 +264,7 @@ constructor(
     override fun refreshUsers() {
         applicationScope.launch {
             _userInfos.value =
-                withContext(backgroundDispatcher) { manager.aliveUsers }
+                withContext(backgroundDispatcher) { manager.getUsersForUiDisplay(true) }
                     // Users should be sorted by ascending creation time.
                     .sortedBy { it.creationTime }
                     // The guest user is always last, regardless of creation time.
