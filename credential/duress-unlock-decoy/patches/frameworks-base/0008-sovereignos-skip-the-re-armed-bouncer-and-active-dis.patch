@@ -759,6 +759,81 @@ class KeyguardSecurityContainerControllerTest : SysuiTestCase() {
         Assert.assertFalse(finish)
     }
 
+    // SovereignOS: the active-dismiss grant lets a decoy switch's freshly-bound keyguard session
+    // finish without a fresh credential entry, exactly once, only when
+    // UserController.consumeDecoySwitchAuthorizationForActiveDismiss(targetUserId) reports a
+    // still-valid, not-yet-consumed grant minted moments ago from that user's own genuine
+    // credential check. It sits in this same if/else-if decision chain as the pre-existing
+    // trust/biometric branches above and is subject to exactly the same downstream SIM PIN and
+    // secure-lock-device checks -- it does not bypass either, it only substitutes for the
+    // authenticated=true case as the reason finish can become true.
+
+    @Test
+    @DisableSceneContainer
+    fun showNextSecurityScreenOrFinish_authorizedDecoyActiveDismiss_finishesWithoutAuthentication() {
+        whenever(keyguardUpdateMonitor.forceIsDismissibleIsKeepingDeviceUnlocked())
+            .thenReturn(false)
+        whenever(keyguardUpdateMonitor.getUserHasTrust(TARGET_USER_ID)).thenReturn(false)
+        whenever(keyguardUpdateMonitor.getUserUnlockedWithBiometric(TARGET_USER_ID))
+            .thenReturn(false)
+        whenever(lockPatternUtils.consumeDecoySwitchAuthorizationForActiveDismiss(TARGET_USER_ID))
+            .thenReturn(true)
+        underTest.showSecurityScreen(SecurityMode.PIN)
+
+        // WHEN a pre-check is made before ever rendering a bouncer for this user (dismiss(int)
+        // always calls with authenticated=false -- this is the real shape of the swipe-time
+        // pre-check in PrimaryBouncerInteractor#show, not a simulated credential entry).
+        val finish = underTest.dismiss(TARGET_USER_ID)
+
+        // THEN keyguard finishes without ever asking for a credential.
+        Assert.assertTrue(finish)
+        verify(viewMediatorCallback).keyguardDone(TARGET_USER_ID)
+    }
+
+    @Test
+    @DisableSceneContainer
+    fun showNextSecurityScreenOrFinish_unauthorizedActiveDismiss_stillRequiresCredential() {
+        // GIVEN no active-dismiss grant was ever minted for this user (the ADR-061 regression
+        // shape: an ordinary secondary-user switch, or any switch this authorization was never
+        // minted for).
+        whenever(keyguardUpdateMonitor.forceIsDismissibleIsKeepingDeviceUnlocked())
+            .thenReturn(false)
+        whenever(keyguardUpdateMonitor.getUserHasTrust(TARGET_USER_ID)).thenReturn(false)
+        whenever(keyguardUpdateMonitor.getUserUnlockedWithBiometric(TARGET_USER_ID))
+            .thenReturn(false)
+        whenever(lockPatternUtils.consumeDecoySwitchAuthorizationForActiveDismiss(TARGET_USER_ID))
+            .thenReturn(false)
+        underTest.showSecurityScreen(SecurityMode.PIN)
+
+        val finish = underTest.dismiss(TARGET_USER_ID)
+
+        // THEN keyguard does not finish -- the ordinary bouncer is (re)shown, an actual
+        // credential is still required.
+        Assert.assertFalse(finish)
+        verify(viewMediatorCallback, never()).keyguardDone(anyInt())
+    }
+
+    @Test
+    @DisableSceneContainer
+    fun showNextSecurityScreenOrFinish_authorizedDecoyActiveDismiss_stillRequiresSimPin() {
+        // GIVEN the active-dismiss grant is authorized (mirrors an authorized decoy switch)
+        whenever(lockPatternUtils.consumeDecoySwitchAuthorizationForActiveDismiss(TARGET_USER_ID))
+            .thenReturn(true)
+
+        // WHEN SIMPIN is the next required screen
+        whenever(keyguardSecurityModel.getSecurityMode(TARGET_USER_ID))
+            .thenReturn(SecurityMode.SimPin)
+
+        // WHEN a request is made to dismiss
+        underTest.dismiss(TARGET_USER_ID)
+
+        // THEN we will show the SIM PIN screen, not silently finish -- the active-dismiss grant
+        // does not bypass a genuinely required SIM PIN/PUK screen, exactly like the pre-existing
+        // trust-based grant proven by
+        // showNextSecurityScreenOrFinish_calledWithNoAuthentication_butRequiresSimPin above.
+        verify(viewFlipperController).getSecurityView(eq(SecurityMode.SimPin), any(), any())
+    }
+
     @Test
     @DisableSceneContainer
     @EnableFlags(FLAG_SECURE_LOCK_DEVICE)
