From af110dd68a2cc6ac3a901e127812785477d16c89 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 10 Sep 2026 15:08:47 +0200
Subject: [PATCH 67/89] sovereignos: split the decoy switch authorization into
 three single-use grants

Adds consumeDecoySwitchAuthorizationForActiveDismiss, a third
independent single-use grant derived from the same credential-verified
mint as the existing forced-lock-skip and bouncer-skip grants. The
existing two grants are consumed deterministically during and
immediately after the switch; this one is redeemed later, only when
the decoy's own freshly-bound keyguard session first evaluates
whether to show a bouncer, so it cannot reuse either existing grant
without starving whichever one is checked second.

GREEN: consumeDecoySwitchAuthorizationForActiveDismiss now exists.
---
 .../com/android/server/am/UserController.java | 142 ++++++++++++++----
 1 file changed, 109 insertions(+), 33 deletions(-)

diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index 489663aa7fd5..16470a16afa9 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -517,16 +517,20 @@ class UserController implements Handler.Callback {
 
     /**
      * SovereignOS: whether the forced-keyguard-lock-skip grant from the current mint has already
-     * been redeemed. This and mBouncerSkipConsumed are two independent single-use grants derived
-     * from the one mint above -- UserController's own internal switch path consumes the former
-     * (see consumeDecoySwitchAuthorization) strictly before SystemUI's keyguard mediator ever
-     * gets a chance to ask for the latter, roughly 500ms later, so one mint must be able to pay
-     * out both without either one starving the other. The record is only fully cleared -- both
-     * bits reset and mSwitchAuthorizedUserId reset to USER_NULL -- once both grants have been
-     * redeemed, or once a redemption attempt finds the mint already expired, whichever happens
-     * first. This is deliberately not a general-purpose reusable flag: a fresh mint always
-     * overwrites the whole record, including both bits, so there is still exactly one pending
-     * authorization possible at a time -- see authorizeDecoySwitchKeyguardSkip.
+     * been redeemed. This, mBouncerSkipConsumed and mActiveDismissConsumed are three independent
+     * single-use grants derived from the one mint above -- UserController's own internal switch
+     * path consumes the first (see consumeDecoySwitchAuthorization) strictly before SystemUI's
+     * keyguard mediator ever gets a chance to ask for the second, roughly 500ms later, and
+     * SystemUI's own keyguard security container only gets a chance to ask for the third later
+     * still, whenever the decoy's own freshly-bound keyguard session first evaluates whether to
+     * show a bouncer at all (e.g. on the user's first swipe) -- so one mint must be able to pay
+     * out all three without any of them starving the others. The record is only fully cleared --
+     * all three bits reset and mSwitchAuthorizedUserId reset to USER_NULL -- once all three
+     * grants have been redeemed, or once a redemption attempt finds the mint already expired,
+     * whichever happens first. This is deliberately not a general-purpose reusable flag: a fresh
+     * mint always overwrites the whole record, including all three bits, so there is still
+     * exactly one pending authorization possible at a time -- see
+     * authorizeDecoySwitchKeyguardSkip.
      */
     @GuardedBy("mLock")
     private boolean mForcedLockSkipConsumed;
@@ -538,6 +542,17 @@ class UserController implements Handler.Callback {
     @GuardedBy("mLock")
     private boolean mBouncerSkipConsumed;
 
+    /**
+     * SovereignOS: whether the SystemUI-side active-dismiss grant from the current mint has already
+     * been redeemed. See mForcedLockSkipConsumed. Unlike the other two grants, which are always
+     * redeemed (attempted) deterministically during and immediately after the switch itself,
+     * this one is redeemed later and only if the user actually interacts with the decoy's own
+     * keyguard session before the mint expires -- see
+     * consumeDecoySwitchAuthorizationForActiveDismiss.
+     */
+    @GuardedBy("mLock")
+    private boolean mActiveDismissConsumed;
+
     private final UserLifecycleListener mUserLifecycleListener = new UserLifecycleListener() {
         @Override
         public void onUserCreated(UserInfo user, Object token) {
@@ -2720,26 +2735,40 @@ class UserController implements Handler.Callback {
         synchronized (mLock) {
             mSwitchAuthorizedUserId = targetUserId;
             mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
-            // A fresh mint always starts both grants unconsumed, even if the previous mint's
-            // record (for what can structurally only ever be the same decoy id) was never fully
-            // redeemed -- there is still only ever one pending authorization at a time.
+            // A fresh mint always starts all three grants unconsumed, even if the previous
+            // mint's record (for what can structurally only ever be the same decoy id) was
+            // never fully redeemed -- there is still only ever one pending authorization at a
+            // time.
             mForcedLockSkipConsumed = false;
             mBouncerSkipConsumed = false;
+            mActiveDismissConsumed = false;
         }
         return true;
     }
 
+    /**
+     * SovereignOS: identifies which of the three independent single-use grants derived from one
+     * mint a consumeGrantLocked call is redeeming. See mForcedLockSkipConsumed's javadoc for why
+     * one mint pays out three grants instead of one.
+     */
+    private enum DecoySwitchGrant {
+        FORCED_LOCK_SKIP,
+        BOUNCER_SKIP,
+        ACTIVE_DISMISS,
+    }
+
     /**
      * SovereignOS: consumes the forced-keyguard-lock-skip grant for userId from the current mint. An
      * authorization matching userId is always marked consumed, whether or not it was still
      * valid, so an expired one can never be reused. An authorization for a different user, or a
      * grant that was already consumed, is left intact. See consumeGrantLocked for the shared
-     * two-grant bookkeeping this and consumeDecoySwitchAuthorizationForBouncerSkip both use.
+     * multi-grant bookkeeping this and the other two consumeDecoySwitchAuthorizationFor* methods
+     * both use.
      */
     @VisibleForTesting
     boolean consumeDecoySwitchAuthorization(int userId) {
         synchronized (mLock) {
-            return consumeGrantLocked(userId, /* forcedLockGrant= */ true);
+            return consumeGrantLocked(userId, DecoySwitchGrant.FORCED_LOCK_SKIP);
         }
     }
 
@@ -2748,46 +2777,93 @@ class UserController implements Handler.Callback {
      * mint consumeDecoySwitchAuthorization draws its own grant from. Independent and single-use:
      * a caller that already redeemed this exact grant, or the wrong userId, gets false and
      * touches nothing. See consumeDecoySwitchAuthorization's own javadoc and
-     * mForcedLockSkipConsumed for why one mint pays out two grants instead of one.
+     * mForcedLockSkipConsumed for why one mint pays out three grants instead of one.
      */
     @VisibleForTesting
     boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId) {
         synchronized (mLock) {
-            return consumeGrantLocked(userId, /* forcedLockGrant= */ false);
+            return consumeGrantLocked(userId, DecoySwitchGrant.BOUNCER_SKIP);
+        }
+    }
+
+    /**
+     * SovereignOS: consumes the SystemUI-side active-dismiss grant for userId from the same mint the
+     * other two consumeDecoySwitchAuthorizationFor* methods draw their own grants from.
+     * Independent and single-use, exactly like the other two: a caller that already redeemed
+     * this exact grant, or the wrong userId, gets false and touches nothing. Unlike the other
+     * two -- which are always attempted, deterministically, during and immediately after the
+     * switch -- this grant is redeemed later, only if and when the decoy's own freshly-bound
+     * keyguard session first evaluates whether to show a bouncer at all (see
+     * KeyguardSecurityContainerController#showNextSecurityScreenOrFinish), so it must be a
+     * genuinely separate, independently-trackable grant rather than a second consumption of
+     * either existing one -- both of those are routinely already spent well before this point.
+     * See mForcedLockSkipConsumed for why one mint pays out three grants instead of one.
+     */
+    @VisibleForTesting
+    boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId) {
+        synchronized (mLock) {
+            return consumeGrantLocked(userId, DecoySwitchGrant.ACTIVE_DISMISS);
+        }
+    }
+
+    @GuardedBy("mLock")
+    private boolean isGrantConsumedLocked(DecoySwitchGrant grant) {
+        switch (grant) {
+            case FORCED_LOCK_SKIP:
+                return mForcedLockSkipConsumed;
+            case BOUNCER_SKIP:
+                return mBouncerSkipConsumed;
+            case ACTIVE_DISMISS:
+                return mActiveDismissConsumed;
+        }
+        throw new AssertionError("unreachable: " + grant);
+    }
+
+    @GuardedBy("mLock")
+    private void markGrantConsumedLocked(DecoySwitchGrant grant) {
+        switch (grant) {
+            case FORCED_LOCK_SKIP:
+                mForcedLockSkipConsumed = true;
+                break;
+            case BOUNCER_SKIP:
+                mBouncerSkipConsumed = true;
+                break;
+            case ACTIVE_DISMISS:
+                mActiveDismissConsumed = true;
+                break;
         }
     }
 
     /**
-     * SovereignOS: shared single-use consumption logic for both grants derived from one mint. Matches
-     * userId and evaluates expiry against the mint's own timestamp -- expiry is a property of the
-     * mint, not tracked separately per grant, so a grant redeemed for the first time after the
-     * mint has already expired still returns false here even if the other grant was already
-     * redeemed successfully within the window. Marks exactly the named grant consumed (a grant
-     * already consumed short-circuits to false without touching anything else) and fully clears
-     * the record -- both bits and the authorized id -- once both grants are consumed, or the
-     * instant any redemption attempt finds the mint expired, whichever comes first.
+     * SovereignOS: shared single-use consumption logic for all three grants derived from one mint.
+     * Matches userId and evaluates expiry against the mint's own timestamp -- expiry is a
+     * property of the mint, not tracked separately per grant, so a grant redeemed for the first
+     * time after the mint has already expired still returns false here even if another grant
+     * was already redeemed successfully within the window. Marks exactly the named grant
+     * consumed (a grant already consumed short-circuits to false without touching anything
+     * else) and fully clears the record -- all three bits and the authorized id -- once all
+     * three grants are consumed, or the instant any redemption attempt finds the mint expired,
+     * whichever comes first.
      */
     @GuardedBy("mLock")
-    private boolean consumeGrantLocked(int userId, boolean forcedLockGrant) {
+    private boolean consumeGrantLocked(int userId, DecoySwitchGrant grant) {
         if (mSwitchAuthorizedUserId == UserHandle.USER_NULL || mSwitchAuthorizedUserId != userId) {
             return false;
         }
-        if (forcedLockGrant ? mForcedLockSkipConsumed : mBouncerSkipConsumed) {
+        if (isGrantConsumedLocked(grant)) {
             return false;
         }
         final long ageMillis = mInjector.elapsedRealtime() - mSwitchAuthorizedAtMillis;
         final boolean withinWindow =
                 ageMillis >= 0 && ageMillis <= DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS;
-        if (forcedLockGrant) {
-            mForcedLockSkipConsumed = true;
-        } else {
-            mBouncerSkipConsumed = true;
-        }
-        if (!withinWindow || (mForcedLockSkipConsumed && mBouncerSkipConsumed)) {
+        markGrantConsumedLocked(grant);
+        if (!withinWindow
+                || (mForcedLockSkipConsumed && mBouncerSkipConsumed && mActiveDismissConsumed)) {
             mSwitchAuthorizedUserId = UserHandle.USER_NULL;
             mSwitchAuthorizedAtMillis = 0L;
             mForcedLockSkipConsumed = false;
             mBouncerSkipConsumed = false;
+            mActiveDismissConsumed = false;
         }
         return withinWindow;
     }
