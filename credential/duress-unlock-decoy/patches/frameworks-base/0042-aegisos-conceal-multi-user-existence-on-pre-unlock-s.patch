 import libcore.io.IoUtils;
 
@@ -3452,6 +3453,17 @@ public class UserManagerService extends IUserManager.Stub {
             return false;
         }
 
+        // AegisOS: a locked device must not advertise that it has more than one user, on any
+        // surface, including the real owner's own. A coercer holding the locked device is an
+        // earlier and more common point in the duress scenario than one holding a decoy session:
+        // if the lock screen shows two profiles, the mechanism is defeated before it is invoked.
+        // Gated on a decoy actually existing so a device without one is bit-for-bit stock, and
+        // the owner keeps lock-screen switching if they ever create an ordinary second user.
+        // Display-only: user creation and user switching do not consult this method.
+        if (hasDecoyUser() && isDeviceCurrentlyLocked()) {
+            return false;
+        }
+
         boolean multiUserSettingOn = Settings.Global.getInt(mContext.getContentResolver(),
                 Settings.Global.USER_SWITCHER_ENABLED,
                 getContextResources().getBoolean(com.android.internal
@@ -3463,6 +3475,38 @@ public class UserManagerService extends IUserManager.Stub {
                 && multiUserSettingOn;
     }
 
+    /**
+     * AegisOS: true if any non-removing user on this device is of the decoy type. Read from this
+     * service's own user list, so this adds no cross-service dependency.
+     */
+    private boolean hasDecoyUser() {
+        synchronized (mUsersLock) {
+            for (int i = mUsers.size() - 1; i >= 0; i--) {
+                UserInfo ui = mUsers.valueAt(i).info;
+                if (ui != null && !mRemovingUserIds.get(ui.id)
+                        && UserManager.USER_TYPE_FULL_AEGISOS_DECOY.equals(ui.userType)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * AegisOS: true while the device is locked. Deliberately queried outside mUsersLock -- see
+     * this plan's Task 1 findings for the lock-ordering analysis behind that.
+     */
+    private boolean isDeviceCurrentlyLocked() {
+        WindowManagerInternal wmInternal =
+                LocalServices.getService(WindowManagerInternal.class);
+        if (wmInternal == null) {
+            // Called before WindowManagerService has published its local service: too early for
+            // a keyguard to be showing, so this cannot be a pre-unlock surface.
+            return false;
+        }
+        return wmInternal.isKeyguardShowing();
+    }
+
