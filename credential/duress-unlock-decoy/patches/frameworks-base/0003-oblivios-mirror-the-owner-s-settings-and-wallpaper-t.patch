diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
new file mode 100644
index 00000000..1a3b48c8
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -0,0 +1,160 @@
+package com.android.server.locksettings;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Pattern;
+
+/**
+ * ObliviOS: copies the owner's display and lock-screen settings to the Duress decoy user, one way,
+ * so that the screen does not change brightness, time out, rotate or lay out the lock screen
+ * differently when the switch to the decoy happens (a second person could see the step). Free of
+ * Android types so it can be tested on the JVM; DecoyProfileHelper supplies a Store over
+ * Settings.System and Settings.Secure.
+ *
+ * <p>The owner's values are only read. A key the owner does not have is skipped (the decoy keeps
+ * its own value), and a refused write is reported, never thrown, so the credential path that
+ * calls this cannot fail on it.
+ */
+final class DecoySettingsMirror {
+    private static final Pattern BUILT_IN_TILE = Pattern.compile("[a-z0-9_]+");
+
+    static final String SYSTEM = "system";
+    static final String SECURE = "secure";
+
+    private static final String[] VOLUME_STREAMS = {
+        "alarm", "ring", "notification", "system", "music", "voice", "bluetooth_sco",
+        "accessibility", "dtmf",
+    };
+
+    private static final String[] VOLUME_DEVICES = {
+        "", "_speaker", "_earpiece", "_headset", "_headphone", "_bt_a2dp", "_bt_sco",
+        "_hearing_aid", "_usb_headset",
+    };
+
+    /**
+     * Measured on lynx 2026-11-12 and 2026-11-13: these differed between the owner and the decoy,
+     * and each one is something a second person can see or hear at the switch (brightness, timeout,
+     * rotation, volume steps, refresh rate, touches, fonts, clock format). A key the owner does not
+     * have is skipped, so the volume list can be generous about streams and devices.
+     */
+    static final String[] SYSTEM_KEYS = systemKeys();
+
+    private static String[] systemKeys() {
+        List<String> keys = new ArrayList<>(java.util.Arrays.asList(
+                "screen_brightness",
+                "screen_brightness_float",
+                "screen_brightness_mode",
+                "screen_auto_brightness_adj",
+                "screen_off_timeout",
+                "accelerometer_rotation",
+                "user_rotation",
+                "mode_ringer_streams_affected",
+                "peak_refresh_rate",
+                "min_refresh_rate",
+                "show_touches",
+                "hide_rotation_lock_toggle_for_accessibility",
+                "font_scale",
+                "time_12_24",
+                "haptic_feedback_enabled",
+                "sound_effects_enabled",
+                "lockscreen_sounds_enabled",
+                "vibrate_when_ringing"));
+        for (String stream : VOLUME_STREAMS) {
+            for (String device : VOLUME_DEVICES) {
+                keys.add("volume_" + stream + device);
+            }
+        }
+        return keys.toArray(new String[0]);
+    }
+
+    static final String[] SECURE_KEYS = {
+        "lockscreen_show_controls",
+        "lockscreen_show_wallet",
+        "lock_screen_show_qr_code_scanner",
+        "lock_screen_show_notifications",
+        "lock_screen_allow_private_notifications",
+        "lock_screen_show_only_unseen_notifications",
+        "sysui_qs_tiles",
+        // Measured on lynx 2026-11-13: the owner had dark mode and the decoy none, so the switch changed the
+        // display's CONFIG_UI_MODE (transition snapshot, relaunch of the launcher).
+        "ui_night_mode",
+        "ui_night_mode_custom_type",
+        "dark_theme_custom_start_time",
+        "dark_theme_custom_end_time",
+        // The theme source and style (a small JSON of colour settings, no package of an app).
+        "theme_customization_overlay_packages",
+        // Measured on lynx 2026-11-13: owner-only values of the lock screen, status bar and launcher.
+        "immersive_mode_confirmations",
+        "hush_gesture_used",
+        "launcher_taskbar_education_showing",
+        "doze_pulse_on_double_tap",
+        "doze_tap_gesture",
+        "doze_always_on",
+        "sysui_do_not_disturb",
+        "clock_seconds",
+        "icon_blacklist",
+        "adaptive_sleep",
+        "notification_history_enabled",
+        "mirror_built_in_display",
+    };
+
+    interface Store {
+        /** The value of the key for the user, or null when it is not set. */
+        String get(String namespace, String key, int userId);
+
+        /** Writes the value; may throw when the write is refused. */
+        void put(String namespace, String key, String value, int userId);
+    }
+
+    private DecoySettingsMirror() {}
+
+    /** Copies every listed key from fromUserId to toUserId; returns the keys that could not be written. */
+    static List<String> mirror(Store store, int fromUserId, int toUserId) {
+        List<String> failed = new ArrayList<>();
+        if (fromUserId == toUserId) {
+            return failed;
+        }
+        copy(store, SYSTEM, SYSTEM_KEYS, fromUserId, toUserId, failed);
+        copy(store, SECURE, SECURE_KEYS, fromUserId, toUserId, failed);
+        return failed;
+    }
+
+    /**
+     * What may be copied of a value, or null to skip the key. A quick-settings tile list can hold
+     * entries that name apps of the owner, so only built-in tile names are copied: the decoy must
+     * never learn which apps the owner has installed.
+     */
+    private static String filter(String key, String value) {
+        if (value == null || !"sysui_qs_tiles".equals(key)) {
+            return value;
+        }
+        StringBuilder kept = new StringBuilder();
+        for (String entry : value.split(",")) {
+            // Allowlist, not a prefix check: a built-in tile is a plain lower-case name. Anything
+            // with a parenthesis, slash or dot (custom(...), intent(...), a component name) can name
+            // an app of the owner, whatever its spelling.
+            String tile = entry.trim();
+            if (BUILT_IN_TILE.matcher(tile).matches()) {
+                if (kept.length() > 0) {
+                    kept.append(',');
+                }
+                kept.append(tile);
+            }
+        }
+        return kept.length() == 0 ? null : kept.toString();
+    }
+
+    private static void copy(Store store, String namespace, String[] keys, int fromUserId,
+            int toUserId, List<String> failed) {
+        for (String key : keys) {
+            try {
+                String value = filter(key, store.get(namespace, key, fromUserId));
+                if (value != null) {
+                    store.put(namespace, key, value, toUserId);
+                }
+            } catch (RuntimeException e) {
+                failed.add(key);
+            }
+        }
+    }
+}
