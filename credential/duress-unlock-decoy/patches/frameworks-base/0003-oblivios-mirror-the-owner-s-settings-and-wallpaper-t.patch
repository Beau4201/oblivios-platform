+    /**
+     * SPIKE (throwaway, design B of docs/superpowers/specs/2026-11-12-duress-unlock-timing-design.md):
+     * starts the decoy's Launcher3 process while the decoy is still RUNNING_LOCKED, so the runtime
+     * initialisation of the exec-spawned process (1.5 to 2.3 s) is paid before the duress
+     * credential, with the decoy's CE key still evicted. A process, not an activity: nothing of
+     * the decoy's files is read by this call. The spike measures whether the process survives a
+     * locked user and whether the later launch finds it warm; it logs under SpikeWarm.
+     */
+    private void warmDecoyLauncherProcess(int decoyUserId) {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final ApplicationInfo info = AppGlobals.getPackageManager().getApplicationInfo(
+                    SPIKE_LAUNCHER_PACKAGE,
+                    PackageManager.MATCH_DIRECT_BOOT_AWARE | PackageManager.MATCH_DIRECT_BOOT_UNAWARE,
+                    decoyUserId);
+            if (info == null) {
+                Slog.w(SPIKE_TAG, "no ApplicationInfo for the decoy launcher");
+                return;
+            }
+            final ActivityManagerInternal ami =
+                    LocalServices.getService(ActivityManagerInternal.class);
+            ami.startProcess(info.processName, info, /* knownToBeDead= */ false, /* isTop= */ false,
+                    "oblivios-decoy-warm", new ComponentName(info.packageName, "warm"),
+                    /* isPcc= */ false, Process.SYSTEM_UID, "system");
+            Slog.i(SPIKE_TAG, "requested the decoy launcher process, uid " + info.uid
+                    + " user " + decoyUserId);
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(SPIKE_TAG, "could not start the decoy launcher process", e);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    /**
+     * ObliviOS: the owner's brightness, screen timeout, rotation and lock-screen toggles are
+     * copied to the decoy before the switch to it, so the screen does not change at the switch
+     * (DUR-037). One way, owner to decoy; runs only when a decoy is registered, so a device without a
+     * decoy pays nothing. A refused write is logged by key, never thrown.
+     */
+    private void mirrorOwnerSettingsToDecoy(int realUserId, int decoyUserId) {
+        final ContentResolver resolver = context.getContentResolver();
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final List<String> failed = DecoySettingsMirror.mirror(
+                    new DecoySettingsMirror.Store() {
+                        @Override
+                        public String get(String namespace, String key, int userId) {
+                            return DecoySettingsMirror.SYSTEM.equals(namespace)
+                                    ? Settings.System.getStringForUser(resolver, key, userId)
+                                    : Settings.Secure.getStringForUser(resolver, key, userId);
+                        }
+
+                        @Override
+                        public void put(String namespace, String key, String value, int userId) {
+                            final boolean written = DecoySettingsMirror.SYSTEM.equals(namespace)
+                                    ? Settings.System.putStringForUser(resolver, key, value, userId)
+                                    : Settings.Secure.putStringForUser(resolver, key, value, userId);
+                            if (!written) {
+                                throw new IllegalStateException("not written: " + key);
+                            }
+                        }
+                    }, realUserId, decoyUserId);
+            if (!failed.isEmpty()) {
+                Slog.w(TAG, "Could not mirror settings to the routing target: " + failed);
+            }
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    // The wallpaper ids last copied, per owner wallpaper kind, and the decoy they went to: the copy is
+    // skipped while neither the owner's wallpaper nor the decoy user changed. Handler thread only.
+    private int mirroredWallpaperUserId = UserHandle.USER_NULL;
+    private int mirroredSystemWallpaperId = -1;
+    private int mirroredLockWallpaperId = -1;
+
+    /**
+     * ObliviOS: the owner's home and lock screen wallpaper is copied to the decoy when the device
+     * locks, so the decoy's home screen is not a black one the owner's is not (a second person can
+     * see it, and the theme colours derive from it). Runs on the handler, never on the switch path;
+     * a live wallpaper or any refused step leaves the decoy as it was and is only logged.
+     */
+    private void mirrorOwnerWallpaperToDecoy(int realUserId, int decoyUserId) {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final WallpaperManager owner = context
+                    .createContextAsUser(UserHandle.of(realUserId), 0)
+                    .getSystemService(WallpaperManager.class);
+            final WallpaperManager decoy = context
+                    .createContextAsUser(UserHandle.of(decoyUserId), 0)
+                    .getSystemService(WallpaperManager.class);
+            if (owner == null || decoy == null) {
+                return;
+            }
+            if (mirroredWallpaperUserId != decoyUserId) {
+                mirroredWallpaperUserId = decoyUserId;
+                mirroredSystemWallpaperId = -1;
+                mirroredLockWallpaperId = -1;
+            }
+            final int systemId = owner.getWallpaperId(WallpaperManager.FLAG_SYSTEM);
+            if (systemId > 0 && systemId != mirroredSystemWallpaperId
+                    && copyWallpaper(owner, decoy, WallpaperManager.FLAG_SYSTEM)) {
+                mirroredSystemWallpaperId = systemId;
+            }
+            // -1 while the lock screen shares the system wallpaper, which then needs no copy.
+            final int lockId = owner.getWallpaperId(WallpaperManager.FLAG_LOCK);
+            if (lockId > 0 && lockId != mirroredLockWallpaperId
+                    && copyWallpaper(owner, decoy, WallpaperManager.FLAG_LOCK)) {
+                mirroredLockWallpaperId = lockId;
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not mirror the wallpaper to the routing target", e);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    private static boolean copyWallpaper(WallpaperManager owner, WallpaperManager decoy, int which) {
+        final ParcelFileDescriptor pfd = owner.getWallpaperFile(which);
+        if (pfd == null) {
+            return false; // a live wallpaper has no image to copy
+        }
+        try (InputStream in = new ParcelFileDescriptor.AutoCloseInputStream(pfd)) {
+            return decoy.setStream(in, /* visibleCropHint= */ null, /* allowBackup= */ false,
+                    which) > 0;
+        } catch (IOException | RuntimeException e) {
+            Slog.w(TAG, "Could not copy the wallpaper (" + which + ")", e);
+            return false;
+        }
+    }
+
