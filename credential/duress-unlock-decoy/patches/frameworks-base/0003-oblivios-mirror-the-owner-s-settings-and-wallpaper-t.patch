+package com.android.server.locksettings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public class DecoySettingsMirrorTest {
+    private static final int OWNER = 0;
+    private static final int DECOY = 12;
+
+    /** Fake settings store; records every write. */
+    private static final class FakeStore implements DecoySettingsMirror.Store {
+        final Map<String, String> values = new HashMap<>();
+        final List<String> writes = new ArrayList<>();
+        String failingKey;
+
+        private static String id(String ns, String key, int userId) {
+            return ns + "/" + key + "/" + userId;
+        }
+
+        @Override
+        public String get(String ns, String key, int userId) {
+            return values.get(id(ns, key, userId));
+        }
+
+        @Override
+        public void put(String ns, String key, String value, int userId) {
+            if (key.equals(failingKey)) {
+                throw new SecurityException("refused " + key);
+            }
+            writes.add(id(ns, key, userId));
+            values.put(id(ns, key, userId), value);
+        }
+
+        void set(String ns, String key, int userId, String value) {
+            values.put(id(ns, key, userId), value);
+        }
+    }
+
+    private static FakeStore ownerWithEveryKey() {
+        FakeStore s = new FakeStore();
+        for (String k : DecoySettingsMirror.SYSTEM_KEYS) {
+            s.set(DecoySettingsMirror.SYSTEM, k, OWNER, "owner_" + k);
+        }
+        for (String k : DecoySettingsMirror.SECURE_KEYS) {
+            s.set(DecoySettingsMirror.SECURE, k, OWNER, "owner_" + k);
+        }
+        return s;
+    }
+
+    @Test
+    public void mirrorsEveryKeyFromOwnerToDecoy() {
+        FakeStore s = ownerWithEveryKey();
+        List<String> failed = DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertTrue(failed.isEmpty());
+        for (String k : DecoySettingsMirror.SYSTEM_KEYS) {
+            assertEquals("owner_" + k, s.get(DecoySettingsMirror.SYSTEM, k, DECOY));
+        }
+        for (String k : DecoySettingsMirror.SECURE_KEYS) {
+            assertEquals("owner_" + k, s.get(DecoySettingsMirror.SECURE, k, DECOY));
+        }
+    }
+
+    @Test
+    public void listCoversBrightnessAndTimeoutThatTheOwnerSaw() {
+        List<String> system = java.util.Arrays.asList(DecoySettingsMirror.SYSTEM_KEYS);
+        assertTrue(system.contains("screen_brightness"));
+        assertTrue(system.contains("screen_off_timeout"));
+        assertTrue(system.contains("accelerometer_rotation"));
+    }
+
+    @Test
+    public void listCoversTheNightModeThatChangesTheConfigurationAtTheSwitch() {
+        // lynx 2026-11-13: the owner had ui_night_mode=2 and the decoy none, so the switch changed
+        // CONFIG_UI_MODE (a display configuration change under a transition snapshot, 17:08:42.754).
+        List<String> secure = java.util.Arrays.asList(DecoySettingsMirror.SECURE_KEYS);
+        assertTrue(secure.contains("ui_night_mode"));
+        assertTrue(secure.contains("ui_night_mode_custom_type"));
+        assertTrue(secure.contains("dark_theme_custom_start_time"));
+        assertTrue(secure.contains("dark_theme_custom_end_time"));
+    }
+
+    @Test
+    public void listCoversTheVolumesAndSettingsThatDifferedOnTheDevice() {
+        // lynx 2026-11-13: volume_music 5 against 8, volume_system 7 against 5, volume_voice,
+        // mode_ringer_streams_affected 422 against 166, peak_refresh_rate, show_touches.
+        List<String> system = java.util.Arrays.asList(DecoySettingsMirror.SYSTEM_KEYS);
+        for (String k : new String[] {"volume_music", "volume_music_speaker", "volume_music_bt_a2dp",
+                "volume_system", "volume_voice", "volume_voice_earpiece", "volume_ring_speaker",
+                "volume_alarm", "volume_notification", "mode_ringer_streams_affected",
+                "peak_refresh_rate", "show_touches", "font_scale", "time_12_24"}) {
+            assertTrue(k, system.contains(k));
