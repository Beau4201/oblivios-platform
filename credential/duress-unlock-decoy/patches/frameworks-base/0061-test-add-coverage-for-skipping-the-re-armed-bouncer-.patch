From ea48c5c38ed8e06b14062b0471a7082fda913dc6 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 06:53:59 +0200
Subject: [PATCH 61/85] test: add coverage for skipping the re-armed bouncer on
 an authorized decoy switch

---
 .../keyguard/KeyguardViewMediatorTest.java    | 75 +++++++++++++++++++
 1 file changed, 75 insertions(+)

diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index cd8efade4443..0d284395b8b7 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -532,6 +532,81 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
     }
 
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testUserSwitchToUnauthorizedSecureUserStillShowsBouncer() {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        // Setup keyguard
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        // An ordinary secure-user switch: no authorization was ever minted for this target, so
+        // the primitive returns false, exactly like an unmocked call would by default. This is
+        // the ADR-061 regression property at this layer: nothing about this new check may let an
+        // otherwise-ordinary secure-user switch skip the bouncer.
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(false);
+
+        Runnable beforeResult = mock(Runnable.class);
+        mViewMediator.handleBeforeUserSwitching(nextUserId, beforeResult);
+        processAllMessagesAndBgExecutorMessages();
+        verify(beforeResult).run();
+
+        Runnable onSwitchResult = mock(Runnable.class);
+        mViewMediator.handleUserSwitching(nextUserId, onSwitchResult);
+        processAllMessagesAndBgExecutorMessages();
+        verify(onSwitchResult).run();
+        verify(mStatusBarKeyguardViewManager, never()).dismissAndCollapse();
+
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        TestableLooper.get(this).moveTimeForward(600);
+        processAllMessagesAndBgExecutorMessages();
+
+        verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
+    }
+
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testUserSwitchToAuthorizedDecoyUserSkipsBouncer() {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        // Setup keyguard
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        // A switch to a target whose credential was just verified elsewhere and whose bouncer-
+        // skip grant is still valid and unconsumed.
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(true);
+
+        Runnable beforeResult = mock(Runnable.class);
+        mViewMediator.handleBeforeUserSwitching(nextUserId, beforeResult);
+        processAllMessagesAndBgExecutorMessages();
+        verify(beforeResult).run();
+
+        Runnable onSwitchResult = mock(Runnable.class);
+        mViewMediator.handleUserSwitching(nextUserId, onSwitchResult);
+        processAllMessagesAndBgExecutorMessages();
+        verify(onSwitchResult).run();
+        verify(mStatusBarKeyguardViewManager, never()).dismissAndCollapse();
+
+        // Unlike testUserSwitchToSecureUserShowsBouncer, the authorized grant means the
+        // otherwise-unconditional post-switch dismiss()/bouncer re-arm must never fire, even
+        // after the same 500ms delay elapses.
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        TestableLooper.get(this).moveTimeForward(600);
+        processAllMessagesAndBgExecutorMessages();
+
+        verify(mStatusBarKeyguardViewManager, never()).dismissAndCollapse();
+    }
+
     @Test
     @TestableLooper.RunWithLooper(setAsMainLooper = true)
     public void testUserSwitchToInsecureUserDismissesKeyguard() {
