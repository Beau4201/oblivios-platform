+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -810,6 +810,7 @@ public class LockSettingsService extends ILockSettings.Stub {
         LocalServices.addService(LockSettingsInternal.class, new LocalService());
 
         duressPasswordHelper = injector.getDuressPasswordHelper(this, mStorage, mSpManager);
+        decoyProfileHelper = new DecoyProfileHelper(this, mStorage, mSpManager);
     }
 
     private void updateActivatedEncryptionNotifications(String reason) {
@@ -2779,7 +2780,7 @@ public class LockSettingsService extends ILockSettings.Stub {
         }
     }
 
-    private VerifyCredentialResponse doVerifyCredentialInner(LockscreenCredential credential,
+    VerifyCredentialResponse doVerifyCredentialInner(LockscreenCredential credential,
             LockDomain lockDomain, int userId, ICheckCredentialProgressCallback progressCallback,
             @LockPatternUtils.VerifyFlag int flags) {
         if (credential == null || credential.isNone()) {
@@ -3327,7 +3328,7 @@ public class LockSettingsService extends ILockSettings.Stub {
         }
     }
 
-    private synchronized IGateKeeperService getGateKeeperService() {
+    synchronized IGateKeeperService getGateKeeperService() {
         if (mGateKeeperService != null) {
             return mGateKeeperService;
         }
@@ -4487,6 +4488,7 @@ public class LockSettingsService extends ILockSettings.Stub {
     }
 
     private final DuressPasswordHelper duressPasswordHelper;
+    private final DecoyProfileHelper decoyProfileHelper;
 
     @Override
     public void setDuressCredentials(LockscreenCredential ownerCredential,
@@ -4510,6 +4512,18 @@ public class LockSettingsService extends ILockSettings.Stub {
         return duressPasswordHelper.hasDuressCredentials(ownerCredential);
     }
 
+    @Override
+    public void setDecoyProfile(LockscreenCredential ownerCredential, int decoyUserId) {
+        checkWritePermission();
+        decoyProfileHelper.setDecoyProfile(ownerCredential, decoyUserId);
+    }
+
+    @Override
+    public void clearDecoyProfile(LockscreenCredential ownerCredential) {
+        checkWritePermission();
+        decoyProfileHelper.clearDecoyProfile(ownerCredential);
+    }
+
     Context getContext() {
         return mContext;
     }
