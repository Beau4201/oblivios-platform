diff --git a/services/core/java/com/android/server/DecoyLookGate.java b/services/core/java/com/android/server/DecoyLookGate.java
new file mode 100644
index 00000000..2d7f7bdb
--- /dev/null
+++ b/services/core/java/com/android/server/DecoyLookGate.java
@@ -0,0 +1,46 @@
+package com.android.server;
+
+import android.os.SystemClock;
+import android.os.UserHandle;
+
+/**
+ * ObliviOS: whether the launcher look of a decoy-type user is still being written after an
+ * authorized switch to it (DecoyProfileHelper writes it, the window manager holds the decoy's home
+ * start until it is done). A static in services.jar, not a method of ActivityManagerInternal: that
+ * class lives in framework.jar, which a module build of services does not replace, so a method
+ * added there is a NoSuchMethodError on a phone that has the module build (lynx 2026-11-15, the
+ * duress PIN crashed system_server). Self-expiring, so a writer that never reports back holds the
+ * home start for at most {@link #MAX_MS}.
+ */
+public final class DecoyLookGate {
+    public static final long MAX_MS = 1_500L;
+
+    private static volatile int sUserId = UserHandle.USER_NULL;
+    private static volatile long sSinceMillis;
+
+    private DecoyLookGate() {}
+
+    /** The look of {@code userId} is about to be written. */
+    public static void begin(int userId) {
+        sSinceMillis = SystemClock.elapsedRealtime();
+        sUserId = userId;
+    }
+
+    /** The look is written, or could not be; the home may start. */
+    public static void end() {
+        sUserId = UserHandle.USER_NULL;
+    }
+
+    /** Whether the look of {@code userId} is still being written (and has not run out). */
+    public static boolean isPending(int userId) {
+        if (sUserId != userId) {
+            return false;
+        }
+        final long age = SystemClock.elapsedRealtime() - sSinceMillis;
+        if (age < 0 || age > MAX_MS) {
+            sUserId = UserHandle.USER_NULL;
+            return false;
+        }
+        return true;
+    }
+}
diff --git a/services/core/java/com/android/server/DecoyWallpaperHold.java b/services/core/java/com/android/server/DecoyWallpaperHold.java
new file mode 100644
index 00000000..78ed7b7e
--- /dev/null
+++ b/services/core/java/com/android/server/DecoyWallpaperHold.java
@@ -0,0 +1,62 @@
+package com.android.server;
+
+import android.os.SystemClock;
+
+/**
+ * ObliviOS: while an authorized switch to or from the Duress decoy is under way, the window manager
+ * does not hide the wallpaper because the window that wants it (SystemUI's stage, or the keyguard)
+ * is momentarily not on screen. Without this the wallpaper layer went away for 0.2 to 0.7 s after
+ * the exit of the keyguard, between the end of the exit and the first frame of the incoming home
+ * (lynx 2026-11-15, protolog: "Hiding wallpaper ... from Window{SwitchStage}" by
+ * WindowStateAnimator#prepareSurfaceLocked, when SystemUI redrew the stage after a theme overlay
+ * change and the window counted as not drawn). A static in services.jar for the same reason as
+ * {@link DecoyLookGate}. Self-expiring after {@link #MAX_MS}, and ended when an activity window
+ * (the incoming home) has become the wallpaper target.
+ */
+public final class DecoyWallpaperHold {
+    public static final long MAX_MS = 4_000L;
+
+    private static volatile boolean sActive;
+    private static volatile long sSinceMillis;
+
+    private DecoyWallpaperHold() {}
+
+    /** An authorized switch has been minted. */
+    public static void begin() {
+        sSinceMillis = SystemClock.elapsedRealtime();
+        sActive = true;
+    }
+
+    /**
+     * Called once, when the hold ends because the incoming home is the wallpaper target. The
+     * window manager sets it to send SystemUI's stage a broadcast (see AuthorizedSwitchStage), the
+     * signal between the two that needs no framework change and leaves nothing on disk.
+     */
+    public static void setReleaseSink(Runnable sink) {
+        sReleaseSink = sink;
+    }
+
+    private static volatile Runnable sReleaseSink;
+
+    /** The incoming home is the wallpaper target, or the switch is over. */
+    public static void end() {
+        final boolean wasActive = sActive;
+        sActive = false;
+        final Runnable sink = sReleaseSink;
+        if (wasActive && sink != null) {
+            sink.run();
+        }
+    }
+
+    public static boolean isActive() {
+        if (!sActive) {
+            return false;
+        }
+        final long age = SystemClock.elapsedRealtime() - sSinceMillis;
+        if (age < 0 || age > MAX_MS) {
+            sActive = false;
+            return false;
+        }
+        return true;
+    }
+}
