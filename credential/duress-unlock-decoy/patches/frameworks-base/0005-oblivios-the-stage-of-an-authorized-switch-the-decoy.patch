diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
new file mode 100644
index 00000000..e75e3963
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -0,0 +1,181 @@
+package com.android.systemui.keyguard;
+
+import android.app.ActivityManager;
+import android.app.WallpaperManager;
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Color;
+import android.content.BroadcastReceiver;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.PixelFormat;
+import android.os.Build;
+import android.os.Handler;
+import android.util.Log;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.ImageView;
+
+/**
+ * ObliviOS: the stage of an authorized switch (the Duress decoy, in either direction): one window
+ * under the keyguard that shows the wallpaper itself for the first part of the exit, so that the
+ * exit never runs over a black screen.
+ *
+ * <p>Why the wallpaper layer cannot be relied on at a switch (lynx 2026-11-15, 30 fps frames, layer
+ * samples and protolog): the wallpaper service of the other user is bound at the switch and the
+ * layer is gone for 0.10 to 0.16 s while the PIN pad is still up (pad over black); the engine's
+ * surface is laid out again during the exit and shows for a few frames at its native size, a card
+ * over the top 63% of the screen with black below; and the exit transition of a switch holds only the
+ * wallpaper, no app, so nothing else is on screen. This window does not depend on any of that: it
+ * draws the wallpaper bitmap that the engine draws (same call, same crop), scaled to fill the
+ * screen like the window manager scales the engine's surface, over black.
+ *
+ * <p>It sits at the layer of the additional status bar, above the status bar and below the
+ * notification shade, so the pad, the scrim and the rest of the keyguard's exit are drawn over it
+ * and the keyguard policy does not hide it while the keyguard is showing. It asks for the
+ * wallpaper too, so the window that holds the wallpaper layer is stable (see
+ * com.android.server.DecoyWallpaperHold). It stays until the window manager reports that
+ * the incoming home has drawn (a broadcast to this package only, sent by
+ * com.android.server.wm.WallpaperController when an activity window becomes the wallpaper target;
+ * nothing is persisted and no app can receive it), then fades out over the home;
+ * {@link #FALLBACK_MS} ends it when no report comes. The wallpaper layer under it is in a broken
+ * state until the home draws (the card), which is why it has to stay that long. Without a bitmap
+ * (not loaded yet, or it failed) the window is empty and transparent and only holds the wallpaper
+ * request.
+ */
+public final class AuthorizedSwitchStage {
+    private static final String TAG = "AuthorizedSwitchStage";
+    static final long FALLBACK_MS = 3_000L;
+    static final long FADE_MS = 200L;
+    private static final String RELEASE_ACTION = "com.android.systemui.STAGE_RELEASE";
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final Runnable mFade = this::fadeOut;
+    private final Runnable mRemove = this::hide;
+    private volatile Bitmap mBitmap;
+    private View mView;
+
+    /**
+     * Debuggable builds only: a warning that exists only for the decoy would show on a user build
+     * that a decoy is set up (the same reason as the stage logs of the window manager).
+     */
+    private static void warn(String message, Throwable e) {
+        if (Build.IS_DEBUGGABLE) {
+            Log.w(TAG, message, e);
+        }
+    }
+
+    public AuthorizedSwitchStage(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+    }
+
+    /**
+     * Loads the wallpaper bitmap of the current user on a thread of its own, for the next switch.
+     * Called when the keyguard is shown; the decode is off the main thread and the result is kept
+     * until the stage has been shown, so a switch finds it ready.
+     */
+    public void preload() {
+        final int userId = ActivityManager.getCurrentUser();
+        new Thread(() -> {
+            try {
+                // FLAG_SYSTEM and returnDefault, the engine's own call (ImageWallpaper
+                // #loadWallpaperAndDrawFrameInternal). FLAG_LOCK with returnDefault gave the empty
+                // default image: the stage was black (lynx 2026-11-15, 30 fps frames).
+                mBitmap = mContext.getSystemService(WallpaperManager.class).getBitmapAsUser(
+                        userId, true /* hardware */, WallpaperManager.FLAG_SYSTEM,
+                        true /* returnDefault */);
+            } catch (RuntimeException | OutOfMemoryError e) {
+                warn("Could not load the wallpaper for the stage", e);
+                mBitmap = null;
+            }
+        }, "SwitchStagePreload").start();
+    }
+
+    /** Adds the window, or keeps it a while longer when it is already there. Main thread. */
+    public void show() {
+        mHandler.removeCallbacks(mFade);
+        mHandler.removeCallbacks(mRemove);
+        final Bitmap bitmap = mBitmap;
+        if (mView == null) {
+            final View view;
+            if (bitmap != null) {
+                final ImageView image = new ImageView(mContext);
+                image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+                image.setBackgroundColor(Color.BLACK);
+                image.setImageBitmap(bitmap);
+                view = image;
+            } else {
+                view = new View(mContext);
+            }
+            final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.TYPE_STATUS_BAR_ADDITIONAL,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                            | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                            | WindowManager.LayoutParams.FLAG_SHOW_WALLPAPER
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+                    bitmap != null ? PixelFormat.OPAQUE : PixelFormat.TRANSLUCENT);
+            lp.privateFlags |= WindowManager.LayoutParams.SYSTEM_FLAG_SHOW_FOR_ALL_USERS;
+            // No insets and no cutout margin: the window covers the whole screen. With the default
+            // inset of the status bar a strip at the top stayed uncovered (lynx 2026-11-15).
+            lp.setFitInsetsTypes(0);
+            lp.layoutInDisplayCutoutMode =
+                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS;
+            lp.setTitle("SwitchStage");
+            try {
+                mContext.getSystemService(WindowManager.class).addView(view, lp);
+                mView = view;
+            } catch (RuntimeException e) {
+                warn("Could not add the stage window", e);
+                return;
+            }
+            // The window manager sends this broadcast when the incoming home has drawn. The
+            // receiver is not exported: no app can send it, and no app receives it.
+            mContext.registerReceiver(mReleaseReceiver,
+                    new IntentFilter(RELEASE_ACTION), Context.RECEIVER_NOT_EXPORTED);
+        }
+        // The timer is only the fallback for a release that never comes.
+        mHandler.postDelayed(mFade, FALLBACK_MS);
+    }
+
+    private final BroadcastReceiver mReleaseReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            mHandler.removeCallbacks(mFade);
+            mHandler.post(AuthorizedSwitchStage.this::fadeOut);
+        }
+    };
+
+    private void fadeOut() {
+        if (mView == null) {
+            return;
+        }
+        mView.animate().alpha(0f).setDuration(FADE_MS).start();
+        mHandler.postDelayed(mRemove, FADE_MS + 50L);
+    }
+
+    /** Removes the window and drops the bitmap. Main thread. */
+    public void hide() {
+        mHandler.removeCallbacks(mFade);
+        mHandler.removeCallbacks(mRemove);
+        try {
+            mContext.unregisterReceiver(mReleaseReceiver);
+        } catch (IllegalArgumentException e) {
+            // not registered: the window was never added
+        }
+        mBitmap = null;
+        if (mView == null) {
+            return;
+        }
+        try {
+            mContext.getSystemService(WindowManager.class).removeViewImmediate(mView);
+        } catch (RuntimeException e) {
+            warn("Could not remove the stage window", e);
+        }
+        mView = null;
+    }
+}
