From 1844964e56045c297d44ffdc7cd076cf447a6c54 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 16:06:58 +0100
Subject: [PATCH 51/54] oblivios: the decoy finger link zeroizes its wrap key
 and a restore cannot refill the cache after a change of the link

Review finding D7. deriveDecoyFingerKey() results stayed in the heap; a restore of the cache that read the link before a clear could fill the cache after it (the stored link was gone, so the finger did not route, but the decoy credential stayed in memory).
---
 .../locksettings/DecoyFingerHelper.java       | 43 ++++++++++++++++---
 1 file changed, 38 insertions(+), 5 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
index 8a8465c0767d..9ce81b4d1b1c 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
@@ -46,6 +46,10 @@ class DecoyFingerHelper {
     @Nullable
     private byte[] cachedPlain;
 
+    // Guarded by this. Advanced by every change of the link (set, clear), so a restore of the cache
+    // that read the stored link before the change cannot fill the cache after it.
+    private int linkGeneration;
+
     DecoyFingerHelper(LockSettingsService lockSettingsService,
             LockSettingsStorage lockSettingsStorage) {
         this.lockSettingsService = lockSettingsService;
@@ -89,10 +93,12 @@ class DecoyFingerHelper {
             throw new SecurityException("owner credential verification failed");
         }
         byte[] plain = null;
+        byte[] key = null;
         try {
             plain = DecoyFingerCodec.encodeCredential(type, decoyCredential.getCredential());
-            final byte[] wrapped = SyntheticPasswordCrypto.encrypt(ownerSp.deriveDecoyFingerKey(),
-                    WRAP_PERSONALIZATION, plain);
+            key = ownerSp.deriveDecoyFingerKey();
+            final byte[] wrapped = SyntheticPasswordCrypto.encrypt(key, WRAP_PERSONALIZATION,
+                    plain);
             if (wrapped == null) {
                 throw new IllegalStateException("the decoy credential could not be wrapped");
             }
@@ -106,6 +112,9 @@ class DecoyFingerHelper {
             if (plain != null) {
                 Arrays.fill(plain, (byte) 0);
             }
+            if (key != null) {
+                Arrays.fill(key, (byte) 0);
+            }
         }
     }
 
@@ -118,6 +127,7 @@ class DecoyFingerHelper {
     void clearState() {
         lockSettingsStorage.removeKey(LOCK_SETTINGS_STORAGE_KEY, LOCK_SETTINGS_STORAGE_USER_ID);
         synchronized (this) {
+            linkGeneration++;
             zeroCache();
         }
     }
@@ -155,18 +165,26 @@ class DecoyFingerHelper {
         // This runs inside the real owner's credential check: whatever goes wrong here leaves the cache empty (the finger
         // fails closed) and must never fail the owner's own unlock.
         try {
+            // The generation is read before the state: a change of the link in between (a clear, a
+            // new link) makes the restore below drop its result instead of refilling the cache.
+            final int generation = linkGeneration();
             final DecoyFingerCodec.State state = readState();
             if (state == null) {
                 return;
             }
-            final byte[] plain = SyntheticPasswordCrypto.decrypt(ownerSp.deriveDecoyFingerKey(),
-                    WRAP_PERSONALIZATION, state.wrapped);
+            final byte[] key = ownerSp.deriveDecoyFingerKey();
+            final byte[] plain;
+            try {
+                plain = SyntheticPasswordCrypto.decrypt(key, WRAP_PERSONALIZATION, state.wrapped);
+            } finally {
+                Arrays.fill(key, (byte) 0);
+            }
             if (plain == null) {
                 Slog.w(TAG, "The decoy finger link could not be unwrapped");
                 return;
             }
             try {
-                setCache(plain);
+                restoreCache(plain, generation);
             } finally {
                 Arrays.fill(plain, (byte) 0);
             }
@@ -208,7 +226,22 @@ class DecoyFingerHelper {
                 LOCK_SETTINGS_STORAGE_KEY, null, LOCK_SETTINGS_STORAGE_USER_ID));
     }
 
+    /** A new link: the cache holds its credential, and a restore that started earlier is void. */
     private synchronized void setCache(byte[] plain) {
+        linkGeneration++;
+        zeroCache();
+        cachedPlain = plain.clone();
+    }
+
+    private synchronized int linkGeneration() {
+        return linkGeneration;
+    }
+
+    /** Fills the cache from the stored link, unless the link changed since {@code generation}. */
+    private synchronized void restoreCache(byte[] plain, int generation) {
+        if (generation != linkGeneration) {
+            return;
+        }
         zeroCache();
         cachedPlain = plain.clone();
     }
-- 
