From c098453da81585118a48153ae9ea7170648b621f Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Fri, 28 Aug 2026 22:59:35 +0200
Subject: [PATCH 22/89] sovereignos: mark decoy user setup-complete at registration
 time

---
 .../server/locksettings/DecoyProfileHelper.java  | 16 +++++++++++++++-
 .../server/locksettings/LockSettingsService.java |  2 +-
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 5e8d134dc020..7c269365a586 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -6,7 +6,9 @@ import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_NONE;
 import android.annotation.Nullable;
 import android.app.ActivityManager;
 import android.app.ActivityManagerInternal;
+import android.content.Context;
 import android.os.UserHandle;
+import android.provider.Settings;
 import android.util.Slog;
 
 import com.android.internal.widget.LockPatternUtils;
@@ -27,12 +29,15 @@ class DecoyProfileHelper {
     private final LockSettingsService lockSettingsService;
     private final LockSettingsStorage lockSettingsStorage;
     private final SyntheticPasswordManager spManager;
+    private final Context context;
 
     DecoyProfileHelper(LockSettingsService lockSettingsService,
-            LockSettingsStorage lockSettingsStorage, SyntheticPasswordManager spManager) {
+            LockSettingsStorage lockSettingsStorage, SyntheticPasswordManager spManager,
+            Context context) {
         this.lockSettingsService = lockSettingsService;
         this.lockSettingsStorage = lockSettingsStorage;
         this.spManager = spManager;
+        this.context = context;
     }
 
     /**
@@ -125,6 +130,15 @@ class DecoyProfileHelper {
         if (decoyUserId == UserHandle.USER_SYSTEM) {
             throw new IllegalArgumentException("decoyUserId must not be the real user");
         }
+        // Mark the decoy as having completed first-use setup. A freshly created secondary user
+        // has never run Android's own SetupWizard, which -- confirmed via real source this
+        // session -- gates several unrelated, non-admin-gated SystemUI behaviors (screenshot and
+        // clipboard overlays, full-screen call/alarm intents, the status-bar alarm icon, Material
+        // You theming, the QS settings gear) purely on this one per-user flag. See
+        // docs/superpowers/specs/2026-08-28-duress-decoy-session-indistinguishability-design.md
+        // in the sovereignos-foundation repository.
+        Settings.Secure.putIntForUser(context.getContentResolver(),
+                Settings.Secure.USER_SETUP_COMPLETE, 1, decoyUserId);
         DecoyProfileState.create(decoyUserId).save(lockSettingsStorage);
     }
 
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index 7e54f1434832..9adb7623fbfa 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -810,7 +810,7 @@ public class LockSettingsService extends ILockSettings.Stub {
         LocalServices.addService(LockSettingsInternal.class, new LocalService());
 
         duressPasswordHelper = injector.getDuressPasswordHelper(this, mStorage, mSpManager);
-        decoyProfileHelper = new DecoyProfileHelper(this, mStorage, mSpManager);
+        decoyProfileHelper = new DecoyProfileHelper(this, mStorage, mSpManager, mContext);
         returnToRealUserHelper = new ReturnToRealUserHelper(this, mStorage);
     }
 
-- 
