From 48412145aa595fbe2854808d4bc3f12b9502e5b3 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Fri, 28 Aug 2026 19:00:31 +0200
Subject: [PATCH 19/89] sovereignos: add UserManager.getUsersForUiDisplay for decoy
 session UI filtering

---
 core/java/android/os/IUserManager.aidl        |  1 +
 core/java/android/os/UserManager.java         | 17 ++++++++++++
 .../android/server/pm/UserManagerService.java | 27 +++++++++++++++++++
 3 files changed, 45 insertions(+)

diff --git a/core/java/android/os/IUserManager.aidl b/core/java/android/os/IUserManager.aidl
index 24c4f50ffe0c..b40400f45bf8 100644
--- a/core/java/android/os/IUserManager.aidl
+++ b/core/java/android/os/IUserManager.aidl
@@ -66,6 +66,7 @@ interface IUserManager {
     int getCommunalProfileId();
     int getPreviousUserToEnterForeground();
     List<UserInfo> getUsers(boolean excludeDying);
+    List<UserInfo> getUsersForUiDisplay(boolean excludeDying);
     List<UserInfo> getProfiles(int userId, boolean enabledOnly);
     int[] getProfileIds(int userId, boolean enabledOnly);
     boolean isUserTypeSupportedIncludingSystem(in String userType);
diff --git a/core/java/android/os/UserManager.java b/core/java/android/os/UserManager.java
index 60e51af2b009..75e272fcd8a1 100644
--- a/core/java/android/os/UserManager.java
+++ b/core/java/android/os/UserManager.java
@@ -5258,6 +5258,23 @@ public class UserManager {
         }
     }
 
+    /**
+     * @hide
+     * @see IUserManager#getUsersForUiDisplay(boolean)
+     */
+    @UnsupportedAppUsage
+    @RequiresPermission(anyOf = {
+            android.Manifest.permission.MANAGE_USERS,
+            android.Manifest.permission.CREATE_USERS
+    })
+    public @NonNull List<UserInfo> getUsersForUiDisplay(boolean excludeDying) {
+        try {
+            return mService.getUsersForUiDisplay(excludeDying);
+        } catch (RemoteException re) {
+            throw re.rethrowFromSystemServer();
+        }
+    }
+
     /**
      * Returns information for all users on this device, based on the filtering parameters.
      *
diff --git a/services/core/java/com/android/server/pm/UserManagerService.java b/services/core/java/com/android/server/pm/UserManagerService.java
index c95eade32890..713392f685f7 100644
--- a/services/core/java/com/android/server/pm/UserManagerService.java
+++ b/services/core/java/com/android/server/pm/UserManagerService.java
@@ -1745,6 +1745,33 @@ public class UserManagerService extends IUserManager.Stub {
         return getUsers(filter, mNameConverter);
     }
 
+    /**
+     * Like {@link #getUsers(boolean)}, except when the calling user is an SovereignOS Duress
+     * Unlock decoy user, in which case only that user is returned. Every UI surface that
+     * displays "which users exist on this device" (the multi-user switcher, Settings' Storage
+     * screen, the power menu, etc.) must call this instead of {@link #getUsers(boolean)} --
+     * internal, non-display callers (e.g. RealUserQuiescer) must keep calling the real,
+     * unscoped {@link #getUsers(boolean)} directly. See
+     * docs/superpowers/specs/2026-08-28-duress-decoy-session-indistinguishability-design.md
+     * in the sovereignos-foundation repository.
+     */
+    @Override
+    public @NonNull List<UserInfo> getUsersForUiDisplay(boolean excludeDying) {
+        checkCreateUsersPermission("query users for UI display");
+        int callingUserId = UserHandle.getCallingUserId();
+        UserInfo callingUserInfo;
+        synchronized (mUsersLock) {
+            callingUserInfo = getUserInfoLU(callingUserId);
+        }
+        if (callingUserInfo != null
+                && UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(callingUserInfo.userType)) {
+            List<UserInfo> result = new ArrayList<>(1);
+            result.add(callingUserInfo);
+            return result;
+        }
+        return getUsers(excludeDying);
+    }
+
     // Used by cmd users
     // TODO(b/419086491): remove once user_filter_refactoring flag is ramped  up
     /**
-- 
