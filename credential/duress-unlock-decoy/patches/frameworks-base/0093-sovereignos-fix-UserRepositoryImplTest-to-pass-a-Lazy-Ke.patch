From 40dd0f215768b6a870133efde2957babebbdc94c Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 20 Sep 2026 19:30:44 +0200
Subject: [PATCH] sovereignos: fix UserRepositoryImplTest to pass a
 Lazy<KeyguardRepository>

Task 6's Dagger-cycle fix (f3f3c9ebc980) changed UserRepositoryImpl's
constructor to take Lazy<KeyguardRepository> instead of a plain
KeyguardRepository, but this test's own create() helper was never
updated to match -- never caught because SystemUiRoboTests was never
actually compiled via atest until now. Wrap with dagger.Lazy { ... },
matching the existing idiom already used in this same package
(CustomizationProviderTest.kt).
---
 .../systemui/user/data/repository/UserRepositoryImplTest.kt     | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/SystemUI/multivalentTests/src/com/android/systemui/user/data/repository/UserRepositoryImplTest.kt b/packages/SystemUI/multivalentTests/src/com/android/systemui/user/data/repository/UserRepositoryImplTest.kt
index c47feed..e385001 100644
--- a/packages/SystemUI/multivalentTests/src/com/android/systemui/user/data/repository/UserRepositoryImplTest.kt
+++ b/packages/SystemUI/multivalentTests/src/com/android/systemui/user/data/repository/UserRepositoryImplTest.kt
@@ -564,7 +564,7 @@ class UserRepositoryImplTest(flags: FlagsParameterization) : SysuiTestCase() {
             mainDispatcher = testDispatcher,
             backgroundDispatcher = testDispatcher,
             globalSettings = globalSettings,
-            keyguardRepository = keyguardRepository,
+            keyguardRepository = dagger.Lazy { keyguardRepository },
             tracker = tracker,
             broadcastDispatcher = broadcastDispatcher,
             devicePolicyManager = devicePolicyManager,
-- 
2.55.0

