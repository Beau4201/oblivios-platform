From 2a25610f1bbee6fc10f2bc64091c00be6a18336b Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Wed, 4 Nov 2026 20:41:47 +0100
Subject: [PATCH] oblivios: a match of the duress finger does not reset the
 real user's fingerprint lockout

The success branch of AuthenticationClient called resetLockoutTimeBound with the hardware token also for a match that was routed to the decoy, although the route exists so that the duress finger leaves the real user's fingerprint and keystore state alone. Found by the automated review of the commit; the token was already withheld from the keystore.
---
 .../server/biometrics/sensors/AuthenticationClient.java      | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/biometrics/sensors/AuthenticationClient.java b/services/core/java/com/android/server/biometrics/sensors/AuthenticationClient.java
index becb1bf..4d546ea 100644
--- a/services/core/java/com/android/server/biometrics/sensors/AuthenticationClient.java
+++ b/services/core/java/com/android/server/biometrics/sensors/AuthenticationClient.java
@@ -269,7 +269,10 @@ public abstract class AuthenticationClient<T, O extends AuthenticateOptions>
 
             // For BP, BiometricService will add the authToken to Keystore.
             if (!isBiometricPrompt()) {
-                if (mIsStrongBiometric) {
+                // ObliviOS: the duress finger is a match that must leave the real user's fingerprint state alone, so it
+                // does not clear the lockout counter either (a coercer could otherwise keep the counter at zero between
+                // wrong guesses).
+                if (mIsStrongBiometric && !routedToDecoy) {
                     // It would be preferable to withhold this until second factor has succeeded,
                     // but being time bound adds difficulty.
                     mBiometricManager.resetLockoutTimeBound(getToken(),
