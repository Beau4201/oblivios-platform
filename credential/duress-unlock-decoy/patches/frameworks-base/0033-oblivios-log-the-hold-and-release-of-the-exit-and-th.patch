From 78ddedfdb2b5495b59268c99f47174ff9691247f Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sat, 14 Nov 2026 15:19:46 +0100
Subject: [PATCH] oblivios: log the hold and release of the exit and the
 deferral of the home for the timing rows

---
 .../android/systemui/keyguard/KeyguardViewMediator.java    | 1 +
 .../com/android/server/wm/ActivityTaskManagerService.java  | 7 +++++++
 .../java/com/android/server/wm/WindowManagerService.java   | 2 ++
 3 files changed, 10 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 7d3f26d9..cfa22917 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -795,6 +795,7 @@ public class KeyguardViewMediator implements CoreStartable,
                 // handleUserSwitchComplete requests, requested earlier.
                 mAuthorizedSwitchDismissRequested = true;
                 AuthorizedSwitchExit.setActive(true);
+                Log.d(TAG, "onBeforeUserSwitching, exit requested at the start of the switch");
                 mHandler.postDelayed(
                         () -> dismiss(null /* callback */, null /* message */), mDismissToken, 0);
             }
diff --git a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
index 71a6cdcb..92ee0f77 100644
--- a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
+++ b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
@@ -4243,6 +4243,8 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
     private boolean mKeyguardGoingAwayHeld;
     @GuardedBy("mGlobalLock")
     private int mHeldKeyguardGoingAwayFlags;
+    @GuardedBy("mGlobalLock")
+    private long mKeyguardGoingAwayHeldSinceMs;
     private static final long HELD_KEYGUARD_GOING_AWAY_MAX_MS = 2_000L;
     private static final long DEFERRED_DECOY_HOME_AFTER_GOING_AWAY_MS = 150L;
     private final Runnable mReleaseHeldKeyguardGoingAway = this::releaseHeldKeyguardGoingAway;
@@ -4260,6 +4262,9 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
             }
             mKeyguardGoingAwayHeld = false;
             flags = mHeldKeyguardGoingAwayFlags;
+            // The stage times of the exit, for the timing rows; the wording names no mechanism.
+            Slog.i(TAG, "Exit released after "
+                    + (SystemClock.uptimeMillis() - mKeyguardGoingAwayHeldSinceMs) + " ms");
             mH.removeCallbacks(mReleaseHeldKeyguardGoingAway);
         }
         // A hold that ran out clears the in-flight mark too, or the call below would be held again.
@@ -4282,6 +4287,8 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
                 if (mAmInternal.isDecoySwitchInFlight()) {
                     mKeyguardGoingAwayHeld = true;
                     mHeldKeyguardGoingAwayFlags = flags;
+                    mKeyguardGoingAwayHeldSinceMs = SystemClock.uptimeMillis();
+                    Slog.i(TAG, "Exit held");
                     mH.removeCallbacks(mReleaseHeldKeyguardGoingAway);
                     mH.postDelayed(mReleaseHeldKeyguardGoingAway, HELD_KEYGUARD_GOING_AWAY_MAX_MS);
                     return;
diff --git a/services/core/java/com/android/server/wm/WindowManagerService.java b/services/core/java/com/android/server/wm/WindowManagerService.java
index 73e9007b..d2ff694c 100644
--- a/services/core/java/com/android/server/wm/WindowManagerService.java
+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -4292,6 +4292,7 @@ public class WindowManagerService extends IWindowManager.Stub
             if (mAtmService.mKeyguardController.isKeyguardShowing(DEFAULT_DISPLAY)) {
                 mDeferredDecoyHomeUserId = userId;
                 mDeferredDecoyHomeReason = reason;
+                Slog.i(TAG, "Home start deferred");
                 mH.removeCallbacks(mStartDeferredDecoyHome);
                 mH.postDelayed(mStartDeferredDecoyHome, DEFERRED_DECOY_HOME_MAX_MS);
                 return;
@@ -4314,6 +4315,7 @@ public class WindowManagerService extends IWindowManager.Stub
             mH.removeCallbacks(mStartDeferredDecoyHome);
         }
         if (mAtmService.mAmInternal.getCurrentUserId() == userId) {
+            Slog.i(TAG, "Home start after the deferral");
             mAtmService.mInternal.startHomeActivity(userId, reason + ",deferred");
         }
     }
-- 
2.47.3

