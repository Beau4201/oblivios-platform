+package com.android.server.locksettings;
+
+import static com.android.internal.widget.LockDomain.Primary;
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_NONE;
+
+import android.annotation.Nullable;
+import android.app.ActivityManager;
+import android.app.ActivityManagerInternal;
+import android.app.IActivityManager;
+import android.app.KeyguardManager;
+import android.content.Context;
+import android.content.pm.UserInfo;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.HandlerExecutor;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.util.Slog;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.internal.widget.VerifyCredentialResponse;
+import com.android.server.LocalServices;
+import com.android.server.pm.UserManagerInternal;
+
+/**
+ * Routes a failed primary-keyguard credential check for the real user (UserHandle.USER_SYSTEM)
+ * to ObliviOS's registered decoy user, if any, at symmetric cost whether or not a decoy is
+ * registered. See docs/superpowers/specs/2026-08-15-duress-keyguard-integration-design.md and
+ * docs/superpowers/specs/2026-08-21-duress-decoy-user-switch-design.md in the
+ * oblivios-foundation repository.
+ */
+class DecoyProfileHelper {
+    private static final String TAG = "CredentialRoutingHelper";
+
+    private final LockSettingsService lockSettingsService;
+    private final LockSettingsStorage lockSettingsStorage;
+    private final SyntheticPasswordManager spManager;
+    private final Context context;
+
+    // Registered against KeyguardManager, not stored as a lambda inline at the registration call
+    // site -- KeyguardManager#removeKeyguardLockedStateListener needs the same instance back,
+    // even though nothing in this class currently unregisters it.
+    private final KeyguardManager.KeyguardLockedStateListener keyguardLockedStateListener =
+            this::onKeyguardLockedStateChanged;
+
+    DecoyProfileHelper(LockSettingsService lockSettingsService,
+            LockSettingsStorage lockSettingsStorage, SyntheticPasswordManager spManager,
+            Context context) {
+        this.lockSettingsService = lockSettingsService;
+        this.lockSettingsStorage = lockSettingsStorage;
+        this.spManager = spManager;
+        this.context = context;
+    }
+
+    /**
+     * Called from LockSettingsService#systemReady(). Registered here, not in the constructor:
+     * LockSettingsService is constructed well before WindowManagerService (the real backing of
+     * KeyguardManager#addKeyguardLockedStateListener) is guaranteed ready, and
+     * UserManagerService's own use of this exact listener type (for private-space auto-lock)
+     * follows the same pattern of registering it from a later lifecycle point, never from its
+     * own constructor.
+     *
+     * <p>SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE is signature-protected; system_server holds it
+     * implicitly, the same way UserManagerService's own registration of this exact listener type
+     * does not separately declare or request it.
+     */
+    void onSystemReady() {
+        KeyguardManager keyguardManager = context.getSystemService(KeyguardManager.class);
+        if (keyguardManager == null) {
+            return;
+        }
+        try {
+            keyguardManager.addKeyguardLockedStateListener(
+                    new HandlerExecutor(getHandler()), keyguardLockedStateListener);
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "Failed to register keyguard locked state listener", e);
+        }
+    }
+
+    /**
+     * Dispatched via HandlerExecutor, so this always runs on the Task 1 handler
+     * (lockSettingsService.mHandler), never inline on whatever thread WindowManagerService's own
+     * callback originates from.
+     *
+     * <p>Warm-starts a registered decoy into the background the moment the keyguard appears, so
+     * a later credential-triggered switch has less work left to do. This is deliberately not the
+     * same thing as unlocking the decoy's storage ahead of its own credential -- confirmed
+     * against real source, not assumed:
+     * <ul>
+     *   <li>{@code UserController#finishUserUnlocking} refuses to advance a user past
+     *       {@code STATE_RUNNING_LOCKED} unless CE storage is already unlocked
+     *       ("If the user's CE storage hasn't been unlocked yet, we cannot proceed.").
+     *   <li>The one automatic unlock attempt a background start triggers,
+     *       {@code LockPatternUtils#unlockUserKeyIfUnsecured} ->
+     *       {@code LockSettingsService#unlockUserKeyIfUnsecured}, bails out for any user that
+     *       {@code isUserSecure()} -- true for a registered decoy always, since it authenticates
+     *       with its own credential by construction.
+     * </ul>
+     * So a warm-started decoy lands in, and stays in, {@code RUNNING_LOCKED} until its own
+     * credential is actually verified.
+     *
+     * <p>{@code ActivityManagerInternal} (used everywhere else in this class) has no plain
+     * background-start method, only {@code startUserInBackgroundTemporarily} (auto-stops the
+     * user, wrong shape here) -- {@code IActivityManager#startUserInBackground} is the real
+     * primitive, called the same way {@code UserManagerService} itself already does for a
+     * different background-start case (pre-created-user initialization,
+     * {@code UserManagerService.java}, "starting pre-created user").
+     */
+    private void onKeyguardLockedStateChanged(boolean isKeyguardLocked) {
+        if (!isKeyguardLocked) {
+            return;
+        }
+        DecoyProfileState state = DecoyProfileState.maybeGet(lockSettingsStorage);
+        if (state == null) {
+            return;
+        }
+        ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+        if (ami == null || ami.isUserRunning(state.decoyUserId, /* flags= */ 0)) {
+            return;
+        }
+        IActivityManager am = ActivityManager.getService();
+        try {
+            am.startUserInBackground(state.decoyUserId);
+        } catch (RemoteException e) {
+            Slog.w(TAG, "Failed to start background credential-routing target", e);
+        }
+    }
+
+    /**
+     * Called from doVerifyCredentialInner immediately after the real owner's own primary
+     * credential is confirmed matched for UserHandle.USER_SYSTEM -- the signal that a decoy
+     * warm-started by onKeyguardLockedStateChanged, if any, was never actually needed this time.
+     * Without this, a decoy warm-started on the very first lock after boot would stay
+     * RUNNING_LOCKED for the rest of the boot session even when the owner just unlocks normally
+     * every time, defeating warm-start's own reason for existing over a permanently resident
+     * decoy (avoiding continuous battery/RAM cost). See "Warm start" in
+     * docs/superpowers/specs/2026-09-07-duress-decoy-seamless-unlock-design.md in the
+     * oblivios-foundation repository.
+     *
+     * <p>Dispatched onto the handler internally (mirrors maybeRouteToDecoy's own
+     * getHandler().post pattern), never inline on the credential-verification thread -- this
+     * runs after doVerifyCredentialInner has already computed its response, so nothing here can
+     * affect what the caller receives.
+     *
+     * <p>This can never race or interrupt a real, in-progress warm-started-then-switched-to
+     * session, for two independent reasons:
+     * <ul>
+     *   <li>By construction: a live session on the warm-started target is only ever reached via
+     *       performDecoySwitch, which runs when maybeRouteToDecoy's own doVerifyCredentialInner
+     *       call matched the decoy's credential. This method instead runs when the *real* owner's
+     *       credential matched. Those are two mutually exclusive outcomes of the same verify
+     *       call for UserHandle.USER_SYSTEM -- one credential cannot satisfy both at once, so this
+     *       method and a freshly switched-to session are never both reachable from the same
+     *       credential check.
+     *   <li>Independently, even if that reasoning were ever wrong: the current-foreground-user
+     *       check below refuses to stop the target if it is the current user, and
+     *       UserController#stopUsersLU -- the real code eventually reached through
+     *       IActivityManager#stopUserWithCallback below -- unconditionally refuses to stop
+     *       whichever user is currently in the foreground (returns USER_OP_IS_CURRENT) as a
+     *       built-in AOSP safety check, not something this class relies on being correct on its
+     *       own.
+     * </ul>
+     */
+    void maybeStopUnusedWarmDecoy() {
+        getHandler().post(() -> {
+            DecoyProfileState state = DecoyProfileState.maybeGet(lockSettingsStorage);
+            if (state == null) {
+                return;
+            }
+            ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+            if (ami == null || !ami.isUserRunning(state.decoyUserId, /* flags= */ 0)) {
+                // Never started, or already stopped -- nothing to do.
+                return;
+            }
+            if (ActivityManager.getCurrentUser() == state.decoyUserId) {
+                // A live foreground session -- never stop this.
+                return;
+            }
+            IActivityManager am = ActivityManager.getService();
+            try {
+                am.stopUserWithCallback(state.decoyUserId, /* callback= */ null);
+            } catch (RemoteException e) {
+                Slog.w(TAG, "Failed to stop unused warm-started credential-routing target", e);
+            }
+        });
+    }
+
+    /**
+     * Called from doVerifyCredentialInner immediately before it would otherwise return a
+     * not-matched response for UserHandle.USER_SYSTEM under LockDomain.Primary. Returns a
+     * synthesized matched response if a registered decoy's own credential matches and the
+     * freeze+switch sequence was successfully initiated; otherwise returns null, meaning the
+     * caller should return its own original not-matched response unchanged.
+     */
+    @Nullable
+    VerifyCredentialResponse maybeRouteToDecoy(LockscreenCredential credential) {
+        final DecoyProfileState registered = DecoyProfileState.maybeGet(lockSettingsStorage);
+        // ObliviOS: the registration outlives the decoy user it names -- nothing clears it when
+        // that user is removed. Verifying against a user that no longer exists throws
+        // IllegalArgumentException("Unknown special user id N") out of the rate limiter's stats
+        // write (a removed user has no protector, so its LskfIdentifier reads as a special
+        // credential), and that propagates through checkCredential into SystemUI, which crashes
+        // on every first wrong PIN. A missing or partial (being removed) decoy is treated exactly
+        // like no decoy at all, including the equivalent-cost dummy check below.
+        final DecoyProfileState state =
+                registered != null && decoyUserExists(registered.decoyUserId) ? registered : null;
+        if (state == null) {
+            // No decoy registered -- pay the equivalent-cost dummy check anyway, so a failed
+            // real-credential attempt costs the same whether or not a decoy exists.
+            spManager.verifySpecialUserCredential(LockPatternUtils.USER_DURESS_DUMMY,
+                    lockSettingsService.getGateKeeperService(), credential,
+                    /* progressCallback= */ null);
+            return null;
+        }
+
+        VerifyCredentialResponse response = lockSettingsService.doVerifyCredentialInner(
+                credential, Primary, state.decoyUserId, /* progressCallback= */ null,
+                /* flags= */ 0);
+        if (!response.isMatched()) {
+            return null;
+        }
+
+        // Everything that can be established synchronously is established before OK is
+        // returned, so the caller's "the credential was accepted" is still gated on a switch
+        // that can start. The mint itself is structurally unreachable from any other entry
+        // point -- see ActivityManagerInternal#authorizeDecoySwitchKeyguardSkip.
+        ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+        if (ami == null || !ami.authorizeDecoySwitchKeyguardSkip(state.decoyUserId)) {
+            return null;
+        }
+
+        // Perform the switch after this response has been delivered, not inline: doing it
+        // inline races UserController's forced lockNow() against the dismissal of the very
+        // bouncer the credential was just typed into, which re-shows a live bouncer and demands
+        // the same credential a second time. realUserId is captured here, before posting, while
+        // the current user is still the real one -- reading it inside the posted runnable would
+        // instead race the switch itself.
+        final int realUserId = ActivityManager.getCurrentUser();
+        getHandler().post(() -> performDecoySwitch(state.decoyUserId, realUserId));
+        return VerifyCredentialResponse.OK;
+    }
+
+    private static boolean decoyUserExists(int decoyUserId) {
+        UserInfo info =
+                LocalServices.getService(UserManagerInternal.class).getUserInfo(decoyUserId);
+        return info != null && !info.partial;
+    }
+
+    /**
+     * Runs on the handler, after maybeRouteToDecoy's response has already been delivered. Any
+     * failure here can no longer flip that response -- it falls back to the pre-seamless
+     * behavior instead (the routed-to session is still reached, via a second credential prompt)
+     * rather than failing closed: the one moment this mechanism exists for is coercion, and a
+     * credential that appears not to work is a worse outcome than an inelegant one that does.
+     * Failures are recorded via DecoyRoutingFailureMarker so they remain visible to the real
+     * owner afterwards, even though the caller of maybeRouteToDecoy never sees them.
+     */
+    private void performDecoySwitch(int decoyUserId, int realUserId) {
+        ActivityManagerInternal ami = LocalServices.getService(ActivityManagerInternal.class);
+        if (ami == null || !ami.switchToUserSilently(decoyUserId)) {
+            DecoyRoutingFailureMarker.record(lockSettingsStorage,
+                    DecoyRoutingFailureMarker.REASON_SWITCH_NOT_STARTED);
+            return;
+        }
+
+        // Switch first, then quiesce the now-backgrounded real user -- a still-foreground
+        // process generally cannot be frozen, and AOSP's own stopUsersLU refuses to stop the
+        // current user for the same reason (UserController.java:1327). See
+        // docs/superpowers/specs/2026-08-27-duress-real-user-quiescing-and-return-design.md.
+        if (!ami.quiesceUserApps(realUserId)) {
+            DecoyRoutingFailureMarker.record(lockSettingsStorage,
+                    DecoyRoutingFailureMarker.REASON_QUIESCE_FAILED);
+        }
+    }
+
+    /**
+     * LockSettingsService's own dedicated-ServiceThread handler, reused here rather than adding
+     * a new dependency -- FgThread has zero usages anywhere in this package. See
+     * docs/devices/lynx-duress-decoy-prelock-audit.md ("Task 1 findings", Finding 3).
+     */
+    private Handler getHandler() {
+        return lockSettingsService.mHandler;
+    }
+
+    /**
+     * Re-verifies the real owner's own primary credential before any admin operation on decoy
+     * routing state -- mirrors DuressPasswordHelper.checkOwnerCredential exactly
+     * (DuressPasswordHelper.java:64-78). This is the real security boundary: the AIDL method
+     * this eventually backs is Binder-exposed, so a caller's own local pre-check (e.g. the shell
+     * command's) must never be trusted as sufficient on its own.
+     */
+    private void checkOwnerCredential(LockscreenCredential ownerCredential) {
+        int userId = UserHandle.USER_SYSTEM;
+        if (lockSettingsService.getCredentialType(userId) == CREDENTIAL_TYPE_NONE) {
+            if (!ownerCredential.isNone()) {
+                throw new IllegalArgumentException("!ownerCredential.isNone()");
+            }
+        } else {
+            VerifyCredentialResponse response = lockSettingsService.checkCredential(
+                    ownerCredential, Primary, userId, null);
+            if (!response.isMatched()) {
+                throw new SecurityException("owner credential verification failed; " + response);
+            }
+        }
+    }
+
+    void setDecoyProfile(LockscreenCredential ownerCredential, int decoyUserId) {
+        checkOwnerCredential(ownerCredential);
+        // A decoy pointing at the real user would make maybeRouteToDecoy's call into
+        // doVerifyCredentialInner(decoyUserId) indistinguishable from the very call that reached
+        // this decoy routing in the first place -- if the caller re-enters maybeRouteToDecoy on
+        // every not-matched USER_SYSTEM/Primary check (Task 5's wiring), that is unbounded
+        // recursion, not just a nonsensical configuration. Reject it here, at the only place
+        // decoyUserId is ever persisted, rather than relying solely on a future call-site guard.
+        if (decoyUserId == UserHandle.USER_SYSTEM) {
+            throw new IllegalArgumentException("decoyUserId must not be the real user");
+        }
+        // getUsersForUiDisplay (UserManagerService) and every Component B call site that
+        // consumes it key identity-leak filtering purely off UserInfo.userType, not off whether
+        // an id happens to be registered here -- an ordinary secondary user registered as "the
+        // decoy" (e.g. an operator who hits USER_TYPE_FULL_OBLIVIOS_DECOY's own max-count-of-one
+        // cap, confirmed real on physical hardware, and reaches for pm create-user with no
+        // --user-type instead) would still route and switch correctly via maybeRouteToDecoy, but
+        // every Component B/C fix in this plan would silently not apply to that session: found
+        // during this plan's own closing whole-branch review, independently confirmed against
+        // this file's real branch content before being fixed here.
+        UserManagerInternal umi = LocalServices.getService(UserManagerInternal.class);
+        UserInfo decoyInfo = umi.getUserInfo(decoyUserId);
+        if (decoyInfo == null
+                || !UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(decoyInfo.userType)) {
+            throw new IllegalArgumentException(
+                    "decoyUserId must be an existing " + UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY
+                            + " user");
+        }
+        DecoyProfileState.create(decoyUserId).save(lockSettingsStorage);
+
+        // Mark the decoy as having completed first-use setup. A freshly created secondary user
+        // has never run Android's own SetupWizard, which -- confirmed via real source this
+        // session -- gates several unrelated, non-admin-gated SystemUI behaviors (screenshot and
+        // clipboard overlays, full-screen call/alarm intents, the status-bar alarm icon, Material
+        // You theming, the QS settings gear) purely on this one per-user flag. See
+        // docs/superpowers/specs/2026-08-28-duress-decoy-session-indistinguishability-design.md
+        // in the oblivios-foundation repository. Runs after DecoyProfileState is saved, not
+        // before: if this write fails partway, the decoy is still correctly registered and
+        // functional (see the non-fatal handling below), whereas the reverse order could mark a
+        // user permanently setup-complete before its registration was actually durable.
+        //
+        // Settings.Secure.putIntForUser requires WRITE_SECURE_SETTINGS, which the original
+        // Binder caller of the setDecoyProfile AIDL method (e.g. the set-decoy-profile shell
+        // command's own caller) does not hold -- LockSettingsService#setDecoyProfile only
+        // enforces checkWritePermission() (LockSettingsWrite), a different, narrower permission.
+        // Run the write under this process's own system identity instead, mirroring the
+        // established clearCallingIdentity/restoreCallingIdentity pattern used throughout
+        // LockSettingsService.java (e.g. around line 2460).
+        final long token = Binder.clearCallingIdentity();
+        boolean setupComplete;
+        try {
+            setupComplete = Settings.Secure.putIntForUser(context.getContentResolver(),
+                    Settings.Secure.USER_SETUP_COMPLETE, 1, decoyUserId);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        if (!setupComplete) {
+            // Non-fatal: the decoy is still correctly registered and functional, just still
+            // distinguishable from a fully set-up profile until this is corrected. Registration
+            // itself must not be blocked by this write failing -- a duress mechanism that refuses
+            // to register at all because of an unrelated Settings-store hiccup is a worse outcome
+            // than a decoy that is briefly more distinguishable than intended.
+            Slog.w(TAG, "Settings.Secure.putIntForUser(USER_SETUP_COMPLETE) returned false for "
+                    + "target user " + decoyUserId + " -- the profile is registered but may "
+                    + "still be distinguishable from a fully set-up profile until this is "
+                    + "retried");
+        }
+    }
+
+    void clearDecoyProfile(LockscreenCredential ownerCredential) {
+        checkOwnerCredential(ownerCredential);
+        DecoyProfileState.delete(lockSettingsStorage);
+    }
+}
