@@ -0,0 +1,83 @@
+package com.android.server.locksettings;
+
+import android.os.UserHandle;
+import android.util.Slog;
+
+import java.time.Instant;
+
+/**
+ * Records why the seamless credential-routing switch fell back to the pre-seamless behavior (a
+ * second credential prompt) after the caller's response had already been sent. This can only
+ * happen on the path where the response has already been returned as matched -- see
+ * DecoyProfileHelper.performDecoySwitch -- so it exists purely to make an otherwise-silent
+ * failure visible to the real owner afterwards, not to change any runtime decision.
+ *
+ * Local, system-only state: written to and read from the real user's own DE storage
+ * (UserHandle.USER_SYSTEM), the same storage DecoyProfileState already uses. Not readable from a
+ * routed-to session, and not surfaced in any UI reachable from one -- LockSettingsStorage's
+ * per-user keys are scoped by user id, and nothing outside this package and its shell-command
+ * entry point ever reads this key.
+ *
+ * See docs/superpowers/specs/2026-09-07-duress-decoy-seamless-unlock-design.md in the
+ * oblivios-foundation repository ("Failure path").
+ */
+class DecoyRoutingFailureMarker {
+    private static final String TAG = "CredentialRoutingFailureMarker";
+
+    static final int REASON_SWITCH_NOT_STARTED = 1;
+    static final int REASON_QUIESCE_FAILED = 2;
+
+    private static final String LOCK_SETTINGS_STORAGE_KEY = "decoy_routing_failure_marker";
+    private static final int LOCK_SETTINGS_STORAGE_USER_ID = UserHandle.USER_SYSTEM;
+    private static final int VERSION = 0;
+
+    private DecoyRoutingFailureMarker() {
+    }
+
+    /**
+     * Records that the seamless switch fell back to the pre-seamless behavior, and why.
+     * Overwrites any previously recorded failure -- only the most recent one is kept, matching
+     * DecoyProfileState's own single-entry storage pattern.
+     */
+    static void record(LockSettingsStorage lss, int reason) {
+        if (reason != REASON_SWITCH_NOT_STARTED && reason != REASON_QUIESCE_FAILED) {
+            throw new IllegalArgumentException("Unknown reason: " + reason);
+        }
+        lss.setString(LOCK_SETTINGS_STORAGE_KEY,
+                VERSION + ":" + reason + ":" + System.currentTimeMillis(),
+                LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+
+    /** Human-readable description of the most recently recorded failure, or its absence. */
+    static String describe(LockSettingsStorage lss) {
+        String s = lss.getString(LOCK_SETTINGS_STORAGE_KEY, null, LOCK_SETTINGS_STORAGE_USER_ID);
+        if (s == null) {
+            return "No credential routing failure recorded.";
+        }
+        try {
+            String[] parts = s.split(":", 3);
+            int version = Integer.parseInt(parts[0]);
+            if (parts.length != 3 || version > VERSION) {
+                return "Unrecognized credential routing failure marker (unknown version).";
+            }
+            int reason = Integer.parseInt(parts[1]);
+            long whenMillis = Long.parseLong(parts[2]);
+            return "Credential routing failure recorded: " + describeReason(reason) + " at "
+                    + Instant.ofEpochMilli(whenMillis) + ".";
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "Corrupt credential routing failure marker, ignoring", e);
+            return "Corrupt credential routing failure marker.";
+        }
+    }
+
+    private static String describeReason(int reason) {
+        switch (reason) {
+            case REASON_SWITCH_NOT_STARTED:
+                return "the session switch could not be started";
+            case REASON_QUIESCE_FAILED:
+                return "the previous session could not be quiesced after switching";
+            default:
+                return "unknown reason " + reason;
+        }
+    }
+}
