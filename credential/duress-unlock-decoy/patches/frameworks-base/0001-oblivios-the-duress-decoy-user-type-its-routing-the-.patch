diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index cc9a8b09..6a71a7a7 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1498,4 +1498,77 @@ public abstract class ActivityManagerInternal {
     }
 
     public abstract ProcessRecordSnapshot getProcessRecordByPid(int pid);
+
+    /**
+     * Switches to the given user without showing the user-switch UI dialog. See
+     * {@link com.android.server.am.UserController#switchToUserSilently}.
+     */
+    public abstract boolean switchToUserSilently(int targetUserId);
+
+    /**
+     * Authorizes exactly one upcoming foreground switch to {@code targetUserId} to proceed without
+     * forcing the keyguard, for a caller that has just verified that user's own credential. The
+     * authorization is single-use and expires shortly. Returns false, minting nothing, if
+     * {@code targetUserId} is not an existing decoy-type user. See
+     * {@link com.android.server.am.UserController#authorizeDecoySwitchKeyguardSkip}.
+     */
+    public abstract boolean authorizeDecoySwitchKeyguardSkip(int targetUserId);
+
+    /**
+     * The return-direction mirror of {@link #authorizeDecoySwitchKeyguardSkip}: authorizes
+     * exactly one upcoming foreground switch to {@code UserHandle.USER_SYSTEM} to proceed without
+     * forcing the keyguard, for a caller that has just verified the real owner's own credential
+     * from within a decoy session. The authorization is single-use and expires shortly. Returns
+     * false, minting nothing, if {@code callerUserId} is not an existing decoy-type user. See
+     * {@link com.android.server.am.UserController#authorizeRealUserSwitchKeyguardSkip}.
+     */
+    public abstract boolean authorizeRealUserSwitchKeyguardSkip(int callerUserId);
+
+    /**
+     * Consumes, at most once, the bouncer-skip half of an existing decoy-switch authorization for
+     * {@code userId}, if one was minted (via {@link #authorizeDecoySwitchKeyguardSkip}) and has
+     * not expired or already been consumed by this same half. Returns false if no such
+     * authorization exists. This is a pure read/consume of already-minted state -- it cannot
+     * itself authorize anything. See
+     * {@link com.android.server.am.UserController#consumeDecoySwitchAuthorizationForBouncerSkip}.
+     */
+    public abstract boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId);
+
+    /**
+     * Consumes, at most once, the active-dismiss third of an existing decoy-switch authorization
+     * for {@code userId}, if one was minted (via {@link #authorizeDecoySwitchKeyguardSkip}) and
+     * has not expired or already been consumed by this same third. Returns false if no such
+     * authorization exists. This is a pure read/consume of already-minted state -- it cannot
+     * itself authorize anything. Unlike {@link #consumeDecoySwitchAuthorizationForBouncerSkip},
+     * which is consumed moments after the switch completes, this is consumed later, only when
+     * the decoy's own freshly-bound keyguard session first evaluates whether to show a bouncer
+     * at all. See
+     * {@link com.android.server.am.UserController#consumeDecoySwitchAuthorizationForActiveDismiss}.
+     */
+    public abstract boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId);
+
+    /**
+     * Best-effort freezes userId's app processes and marks it quiesced for notification
+     * suppression (consulted separately via isUserQuiescedForDuress(), unaffected by the return
+     * value below). Returns whether every eligible process was successfully handed to the
+     * freezer -- any single process failing to freeze counts as a failure (owner's explicit
+     * threshold, see docs/superpowers/specs/2026-09-17-duress-unlock-final-closure-design.md,
+     * Component 3, in the oblivios-foundation repository). userId is still marked quiesced
+     * regardless of this return value; callers must treat a false return as a soft signal to
+     * record for later visibility, never as a reason to block or unwind a user switch that has
+     * already happened.
+     */
+    public abstract boolean quiesceUserApps(int userId);
+
+    /**
+     * Best-effort unfreezes userId's app processes and clears its notification-suppression
+     * flag. Always safe to call, including for a user that was never quiesced. Never blocks.
+     */
+    public abstract void unquiesceUserApps(int userId);
+
+    /**
+     * Returns whether userId is currently quiesced (see quiesceUserApps). Consulted by
+     * NotificationManagerService before posting a notification.
+     */
+    public abstract boolean isUserQuiescedForDuress(int userId);
 }
