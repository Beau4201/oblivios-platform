From afc9ac07440ea1076e9e87f1139ede23d662f8f0 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 5 Nov 2026 18:08:44 +0100
Subject: [PATCH] oblivios: the decoy administration accepts only the owner's
 own credential

The checks that guard the decoy administration (DecoyProfileHelper.checkOwnerCredential, and the same code in
DuressPasswordHelper.checkOwnerCredential) verified the owner with LockSettingsService.checkCredential for
USER_SYSTEM. A credential that does not match the owner reaches maybeRouteToDecoy there: the decoy credential
matched the decoy, the phone was switched to the decoy, and the check reported a match. The decoy credential
therefore passed as the owner's for clearDecoyProfile, setDecoyProfile, clearDecoyFinger, getDecoyFingerId and the
duress password calls (found by the automated review of the finger fix, read in LockSettingsService.java and
DecoyProfileHelper.java; exploitability from the decoy session was not tested).

LockSettingsService.isOwnerCredential follows the rate-limited part of doVerifyCredentialInner (software rate
limiter keyed on the owner's protector, hardware check, report of the result, strong auth after a lockout) and
leaves out the routing, the switch, the wipe hook and the storage unlock; the credential is not consumed. The
keyguard and the Settings confirmation screens keep the wipe hook. As a side effect DecoyFingerHelper.set no
longer needs a copy of the owner credential: the check does not zeroize it any more.

Type-checked against the prebuilt framework and services jars of the build tree: the 16 errors of the unchanged
files (missing aconfig flags, libcore) are the same before and after, and a broken symbol in a copy is reported.
No host test can reach this code; the proof is DUR-032 on a built image.
---
 .../locksettings/DecoyFingerHelper.java       | 18 ++-------
 .../locksettings/DecoyProfileHelper.java      | 11 +++---
 .../locksettings/DuressPasswordHelper.java    | 12 ++----
 .../locksettings/LockSettingsService.java     | 37 +++++++++++++++++++
 4 files changed, 50 insertions(+), 28 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
index 8d4a92747db8..8ab009a89cdf 100644
--- a/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyFingerHelper.java
@@ -58,20 +58,10 @@ class DecoyFingerHelper {
      */
     boolean set(LockscreenCredential ownerCredential, LockscreenCredential decoyCredential,
             int biometricId) {
-        // checkDecoyOwnerCredential ends in LockSettingsService.checkCredential, which zeroizes a
-        // credential that came over Binder; the protector unlock below needs the owner credential
-        // again, so it gets a copy taken first (lynx 2026110501: "Credential is already zeroized").
-        final LockscreenCredential ownerCopy = ownerCredential.duplicate();
-        try {
-            lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
-            return setChecked(ownerCopy, decoyCredential, biometricId);
-        } finally {
-            ownerCopy.zeroize();
-        }
-    }
-
-    private boolean setChecked(LockscreenCredential ownerCredential,
-            LockscreenCredential decoyCredential, int biometricId) {
+        // The owner check does not consume the credential (isOwnerCredential, not checkCredential,
+        // which zeroizes a Binder credential: lynx 2026110501 "Credential is already zeroized"),
+        // so it is used again for the protector unlock below.
+        lockSettingsService.checkDecoyOwnerCredential(ownerCredential);
         if (!DecoyFingerPolicy.isUsableFingerId(biometricId)) {
             throw new IllegalArgumentException("biometricId must not be 0");
         }
diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 654af4866b48..a956acb46e0f 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -326,12 +326,11 @@ class DecoyProfileHelper {
             if (!ownerCredential.isNone()) {
                 throw new IllegalArgumentException("!ownerCredential.isNone()");
             }
-        } else {
-            VerifyCredentialResponse response = lockSettingsService.checkCredential(
-                    ownerCredential, Primary, userId, null);
-            if (!response.isMatched()) {
-                throw new SecurityException("owner credential verification failed; " + response);
-            }
+        } else if (!lockSettingsService.isOwnerCredential(ownerCredential)) {
+            // ObliviOS: not checkCredential, which routes a decoy credential to the decoy and
+            // reports a match (the decoy credential would pass as the owner's) and zeroizes the
+            // credential that DecoyFingerHelper.set uses again.
+            throw new SecurityException("owner credential verification failed");
         }
     }
 
