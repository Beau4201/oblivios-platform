diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index 16d546f2954c..e73291717991 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -3634,6 +3634,43 @@ public class LockSettingsService extends ILockSettings.Stub {
         }
     }
 
+    /**
+     * ObliviOS: whether {@code credential} is the real owner's own screen lock credential. It
+     * follows the rate-limited part of {@link #doVerifyCredentialInner} (the software rate limiter
+     * keyed on the owner's protector, the hardware check, the report of the result, the strong
+     * auth requirement after a lockout) and leaves out the rest of it: no decoy routing, no user
+     * switch, no wipe hook, no unlock of the storage, and the credential is not consumed
+     * (checkCredential zeroizes a Binder credential). A decoy credential is therefore not accepted
+     * as the owner's, which it was while the administration checks went through checkCredential:
+     * that routes a decoy credential to the decoy and reports a match. The keyguard and the
+     * Settings confirmation screens keep the wipe hook; only this internal re-check does not.
+     */
+    boolean isOwnerCredential(LockscreenCredential credential) {
+        synchronized (mSpManager) {
+            final int userId = UserHandle.USER_SYSTEM;
+            final long protectorId = getCurrentLskfBasedProtectorId(userId, Primary);
+            final LskfIdentifier lskfId = new LskfIdentifier(userId, protectorId);
+            if (mSoftwareRateLimiter.apply(lskfId, credential).code
+                    != SoftwareRateLimiterResult.CONTINUE_TO_HARDWARE) {
+                return false;
+            }
+            final AuthenticationResult authResult = mSpManager.unlockLskfBasedProtector(
+                    getGateKeeperService(), protectorId, credential, Primary, userId, null);
+            try {
+                final VerifyCredentialResponse response = reportResultToSoftwareRateLimiter(
+                        authResult.response, lskfId, credential);
+                if (response.hasTimeout() && response.getTimeoutAsDuration().isPositive()) {
+                    requireStrongAuth(STRONG_AUTH_REQUIRED_AFTER_LOCKOUT, userId);
+                }
+                return response.isMatched();
+            } finally {
+                if (authResult.syntheticPassword != null) {
+                    authResult.syntheticPassword.zeroize();
+                }
+            }
+        }
+    }
+
     @VisibleForTesting
     long getCurrentLskfBasedProtectorId(int userId, LockDomain lockDomain) {
         String keySuffix = getCurrentProtectorKeySuffix(lockDomain);
