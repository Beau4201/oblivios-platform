 /**
- * ObliviOS: the stage of an authorized switch (the Duress decoy, in either direction): one empty
- * window that asks for the wallpaper, so that the wallpaper layer stays on screen behind the
- * keyguard's exit while the incoming user's home has not drawn yet.
+ * ObliviOS: the stage of an authorized switch (the Duress decoy, in either direction): one window
+ * under the keyguard that shows the wallpaper itself for the first part of the exit, so that the
+ * exit never runs over a black screen.
  *
- * <p>The window manager shows the wallpaper layer only while a window wants it. In an ordinary
- * unlock the home screen is that window. At a switch the incoming user's home is a cold launcher
- * that draws 0.7 s after it starts, after the exit has ended, so nothing wanted the wallpaper and
- * the exit ran over a black screen (lynx 2026-11-14: {@code wm_wallpaper_surface [0,0,null]}).
- * With this window the exit animates the real wallpaper as it does for an ordinary unlock (the
- * background dims, the pad flies up, the colour returns), and the home draws over it when it is
- * ready. The window draws nothing, so it is also the wrong place for a tell: nothing in it can
- * differ from an ordinary unlock.
+ * <p>Why the wallpaper layer cannot be relied on at a switch (lynx 2026-11-15, 30 fps frames, layer
+ * samples and protolog): the wallpaper service of the other user is bound at the switch and the
+ * layer is gone for 0.10 to 0.16 s while the PIN pad is still up (pad over black); the engine's
+ * surface is laid out again during the exit and shows for a few frames at its native size, a card
+ * over the top 63% of the screen with black below; and the exit transition of a switch holds only the
+ * wallpaper, no app, so nothing else is on screen. This window does not depend on any of that: it
+ * draws the wallpaper bitmap that the engine draws (same call, same crop), scaled to fill the
+ * screen like the window manager scales the engine's surface, over black.
  *
- * <p>It sits at the layer of the status bar sub panel, above the notification shade, so the
- * keyguard policy does not hide it while the keyguard is showing ({@code WindowState#
- * canBeHiddenByKeyguard}), and is shown to every user. It is removed after {@link #HOLD_MS}.
+ * <p>It sits at the layer of the additional status bar, above the status bar and below the
+ * notification shade, so the pad, the scrim and the rest of the keyguard's exit are drawn over it
+ * and the keyguard policy does not hide it while the keyguard is showing. It asks for the
+ * wallpaper too, so the window that holds the wallpaper layer is stable (see
+ * com.android.server.DecoyWallpaperHold). It fades out after {@link #HOLD_MS}, when the wallpaper
+ * layer has been up again for a while, and shows the wallpaper layer and the incoming home. Without
+ * a bitmap (not loaded yet, or it failed) the window is empty and transparent and only holds the
+ * wallpaper request.
  *
- * <p>shortcut: removed by a timer, not by the first draw of the incoming home; the window is empty
- * and not touchable, so staying a little too long shows nothing. Replace the timer by a signal of
- * the window manager if a window that stays for 3 s ever matters.
+ * <p>shortcut: removed by a timer, not by the first draw of the incoming home; replace the timer by a
+ * signal of the window manager when the home's first frame has to come earlier than {@link #HOLD_MS}.
  */
 public final class AuthorizedSwitchStage {
     private static final String TAG = "AuthorizedSwitchStage";
-    static final long HOLD_MS = 3_000L;
+    static final long HOLD_MS = 900L;
+    static final long FADE_MS = 200L;
 
     private final Context mContext;
     private final Handler mHandler;
+    private final Runnable mFade = this::fadeOut;
     private final Runnable mRemove = this::hide;
+    private volatile Bitmap mBitmap;
     private View mView;
 
     public AuthorizedSwitchStage(Context context, Handler handler) {
@@ -43,21 +55,51 @@ public final class AuthorizedSwitchStage {
         mHandler = handler;
     }
 
+    /**
+     * Loads the wallpaper bitmap of the current user on a thread of its own, for the next switch.
+     * Called when the keyguard is shown; the decode is off the main thread and the result is kept
+     * until the stage has been shown, so a switch finds it ready.
+     */
+    public void preload() {
+        final int userId = ActivityManager.getCurrentUser();
+        new Thread(() -> {
+            try {
+                mBitmap = mContext.getSystemService(WallpaperManager.class).getBitmapAsUser(
+                        userId, true /* hardware */, WallpaperManager.FLAG_LOCK,
+                        true /* returnDefault */);
+            } catch (RuntimeException | OutOfMemoryError e) {
+                Log.w(TAG, "Could not load the wallpaper for the stage", e);
+                mBitmap = null;
+            }
+        }, "SwitchStagePreload").start();
+    }
+
     /** Adds the window, or keeps it a while longer when it is already there. Main thread. */
     public void show() {
+        mHandler.removeCallbacks(mFade);
         mHandler.removeCallbacks(mRemove);
+        final Bitmap bitmap = mBitmap;
         if (mView == null) {
-            final View view = new View(mContext);
+            final View view;
+            if (bitmap != null) {
+                final ImageView image = new ImageView(mContext);
+                image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+                image.setBackgroundColor(Color.BLACK);
+                image.setImageBitmap(bitmap);
+                view = image;
+            } else {
+                view = new View(mContext);
+            }
             final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
                     WindowManager.LayoutParams.MATCH_PARENT,
                     WindowManager.LayoutParams.MATCH_PARENT,
-                    WindowManager.LayoutParams.TYPE_STATUS_BAR_SUB_PANEL,
+                    WindowManager.LayoutParams.TYPE_STATUS_BAR_ADDITIONAL,
                     WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                             | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                             | WindowManager.LayoutParams.FLAG_SHOW_WALLPAPER
                             | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
                             | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
-                    PixelFormat.TRANSLUCENT);
+                    bitmap != null ? PixelFormat.OPAQUE : PixelFormat.TRANSLUCENT);
             lp.privateFlags |= WindowManager.LayoutParams.SYSTEM_FLAG_SHOW_FOR_ALL_USERS;
             lp.setTitle("SwitchStage");
             try {
@@ -68,12 +110,22 @@ public final class AuthorizedSwitchStage {
                 return;
             }
         }
-        mHandler.postDelayed(mRemove, HOLD_MS);
+        mHandler.postDelayed(mFade, HOLD_MS);
+    }
+
+    private void fadeOut() {
+        if (mView == null) {
+            return;
+        }
+        mView.animate().alpha(0f).setDuration(FADE_MS).start();
+        mHandler.postDelayed(mRemove, FADE_MS + 50L);
     }
 
-    /** Removes the window. Main thread. */
+    /** Removes the window and drops the bitmap. Main thread. */
     public void hide() {
+        mHandler.removeCallbacks(mFade);
         mHandler.removeCallbacks(mRemove);
+        mBitmap = null;
         if (mView == null) {
             return;
         }
