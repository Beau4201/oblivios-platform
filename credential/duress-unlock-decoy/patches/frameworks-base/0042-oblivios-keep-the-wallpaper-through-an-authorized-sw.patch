diff --git a/services/core/java/com/android/server/DecoyWallpaperHold.java b/services/core/java/com/android/server/DecoyWallpaperHold.java
new file mode 100644
index 00000000..e078073f
--- /dev/null
+++ b/services/core/java/com/android/server/DecoyWallpaperHold.java
@@ -0,0 +1,46 @@
+package com.android.server;
+
+import android.os.SystemClock;
+
+/**
+ * ObliviOS: while an authorized switch to or from the Duress decoy is under way, the window manager
+ * does not hide the wallpaper because the window that wants it (SystemUI's stage, or the keyguard)
+ * is momentarily not on screen. Without this the wallpaper layer went away for 0.2 to 0.7 s after
+ * the exit of the keyguard, between the end of the exit and the first frame of the incoming home
+ * (lynx 2026-11-15, protolog: "Hiding wallpaper ... from Window{SwitchStage}" by
+ * WindowStateAnimator#prepareSurfaceLocked, when SystemUI redrew the stage after a theme overlay
+ * change and the window counted as not drawn). A static in services.jar for the same reason as
+ * {@link DecoyLookGate}. Self-expiring after {@link #MAX_MS}, and ended when an activity window
+ * (the incoming home) has become the wallpaper target.
+ */
+public final class DecoyWallpaperHold {
+    public static final long MAX_MS = 4_000L;
+
+    private static volatile boolean sActive;
+    private static volatile long sSinceMillis;
+
+    private DecoyWallpaperHold() {}
+
+    /** An authorized switch has been minted. */
+    public static void begin() {
+        sSinceMillis = SystemClock.elapsedRealtime();
+        sActive = true;
+    }
+
+    /** The incoming home is the wallpaper target, or the switch is over. */
+    public static void end() {
+        sActive = false;
+    }
+
+    public static boolean isActive() {
+        if (!sActive) {
+            return false;
+        }
+        final long age = SystemClock.elapsedRealtime() - sSinceMillis;
+        if (age < 0 || age > MAX_MS) {
+            sActive = false;
+            return false;
+        }
+        return true;
+    }
+}
