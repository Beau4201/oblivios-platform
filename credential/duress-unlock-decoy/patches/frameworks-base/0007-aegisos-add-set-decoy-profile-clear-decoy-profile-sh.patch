 .../LockSettingsShellCommand.java             | 89 +++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/services/core/java/com/android/server/locksettings/LockSettingsShellCommand.java b/services/core/java/com/android/server/locksettings/LockSettingsShellCommand.java
index 3b812762af98..7f09af6fc6c7 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsShellCommand.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsShellCommand.java
@@ -83,6 +83,14 @@ class LockSettingsShellCommand extends ShellCommand {
             return handleSetDuressCredentials();
         }
 
+        if (cmd.equals("set-decoy-profile")) {
+            return handleSetDecoyProfile();
+        }
+
+        if (cmd.equals("clear-decoy-profile")) {
+            return handleClearDecoyProfile();
+        }
+
         if (cmd.equals("check-non-ce-storage-keys")) {
             return handleCheckNonCeStorageKeys();
         }
@@ -483,6 +491,87 @@ class LockSettingsShellCommand extends ShellCommand {
         return 0;
     }
 
+    private int handleSetDecoyProfile() {
+        String ownerCredential = null;
+
+        for (;;) {
+            String opt = getNextOption();
+            if (opt == null) {
+                break;
+            }
+            switch (opt) {
+                case "--owner-credential":
+                    ownerCredential = getNextArgRequired();
+                    break;
+                default:
+                    getErrPrintWriter().println("unknown option " + opt);
+                    return -1;
+            }
+        }
+
+        if (ownerCredential == null) {
+            getErrPrintWriter().println("missing --owner-credential value");
+            return -1;
+        }
+        if (getRemainingArgsCount() != 1) {
+            getErrPrintWriter().println("expected exactly one arg: <decoyUserId>");
+            return -1;
+        }
+        int decoyUserId;
+        try {
+            decoyUserId = Integer.parseInt(getNextArg());
+        } catch (NumberFormatException e) {
+            getErrPrintWriter().println("<decoyUserId> must be an integer");
+            return -1;
+        }
+
+        mCurrentUserId = UserHandle.USER_SYSTEM;
+        mOld = ownerCredential;
+        if (!checkCredential()) {
+            return -1;
+        }
+
+        mLockPatternUtils.setDecoyProfile(getOldCredential(), decoyUserId);
+        return 0;
+    }
+
+    private int handleClearDecoyProfile() {
+        String ownerCredential = null;
+
+        for (;;) {
+            String opt = getNextOption();
+            if (opt == null) {
+                break;
+            }
+            switch (opt) {
+                case "--owner-credential":
+                    ownerCredential = getNextArgRequired();
+                    break;
+                default:
+                    getErrPrintWriter().println("unknown option " + opt);
+                    return -1;
+            }
+        }
+
+        if (ownerCredential == null) {
+            getErrPrintWriter().println("missing --owner-credential value");
+            return -1;
+        }
+        if (getRemainingArgsCount() != 0) {
+            getErrPrintWriter().println("unknown arg: " + getNextArg());
+            return -1;
+        }
+
+        mCurrentUserId = UserHandle.USER_SYSTEM;
+        mOld = ownerCredential;
+        if (!checkCredential()) {
+            return -1;
+        }
+
+        mLockPatternUtils.clearDecoyProfile(getOldCredential());
+        return 0;
+    }
+
