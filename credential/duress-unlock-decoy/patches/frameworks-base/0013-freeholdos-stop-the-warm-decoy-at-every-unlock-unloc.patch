+    /**
+     * FreeholdOS: makes sure the decoy is started and unlocked before the switch to it begins.
+     * Its credential-encrypted storage is already open at this point: the decoy credential was
+     * verified a moment ago and doVerifyCredentialInner opened it. A decoy that is not running,
+     * or still booting from the warm start of onKeyguardLockedStateChanged, would otherwise be
+     * switched to while UserController still counts it as locked; the package manager then
+     * resolves only direct-boot-aware home activities, the switch lands on Settings' FallbackHome
+     * (the wallpaper, then "Phone is starting..." after 2 s), and the decoy unlocks only once
+     * that placeholder goes idle (ActivityTaskSupervisor#activityIdleInternal ->
+     * UserController#finishUserSwitch). Starting it here in the background unlocks it at once
+     * (UserController#finishUserBoot -> maybeUnlockUser), so the switch resolves the launcher.
+     *
+     * <p>Bounded: after DECOY_UNLOCK_WAIT_MS the switch goes ahead as before. The wait polls the
+     * running state as well as the listener, because a listener added to a start whose unlock
+     * already finished is never called back.
+     */
+    private static void awaitDecoyUnlocked(int decoyUserId) {
+        final ActivityManagerInternal ami =
+                LocalServices.getService(ActivityManagerInternal.class);
+        if (ami == null || ami.isUserRunning(decoyUserId, ActivityManager.FLAG_AND_UNLOCKED)) {
+            return;
+        }
+        final CountDownLatch unlocked = new CountDownLatch(1);
+        final IProgressListener listener = new IProgressListener.Stub() {
+            @Override
+            public void onStarted(int id, Bundle extras) {
+            }
+
+            @Override
+            public void onProgress(int id, int progress, Bundle extras) {
+            }
+
+            @Override
+            public void onFinished(int id, Bundle extras) {
+                unlocked.countDown();
+            }
+        };
+        final long token = Binder.clearCallingIdentity();
+        try {
+            ActivityManager.getService().startUserInBackgroundWithListener(decoyUserId, listener);
+        } catch (RemoteException e) {
+            Slog.w(TAG, "Failed to start the routing target before the switch", e);
+            return;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        final long deadline = SystemClock.uptimeMillis() + DECOY_UNLOCK_WAIT_MS;
+        while (!ami.isUserRunning(decoyUserId, ActivityManager.FLAG_AND_UNLOCKED)) {
+            final long left = deadline - SystemClock.uptimeMillis();
+            if (left <= 0) {
+                Slog.w(TAG, "Routing target not unlocked after " + DECOY_UNLOCK_WAIT_MS
+                        + " ms; switching anyway");
+                return;
+            }
+            try {
+                unlocked.await(Math.min(left, 50), TimeUnit.MILLISECONDS);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+    }
+
