@@ -17674,6 +17674,21 @@ public class ActivityManagerService extends IActivityManager.Stub
             return mUserController.consumeDecoySwitchAuthorizationForActiveDismiss(userId);
         }
 
+        @Override
+        public boolean isDecoySwitchInFlight() {
+            return mUserController.isDecoySwitchInFlight();
+        }
+
+        @Override
+        public boolean consumeDecoyHomeDeferral(int userId) {
+            return mUserController.consumeDecoyHomeDeferral(userId);
+        }
+
+        @Override
