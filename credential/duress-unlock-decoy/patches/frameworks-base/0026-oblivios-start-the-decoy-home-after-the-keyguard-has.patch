From f3eb1983635be7bcadd779ca3d7f2d720e9cb3f5 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 18:04:09 +0100
Subject: [PATCH] oblivios: start the decoy home after the keyguard has gone
 away and hold the going-away until the user change is applied

---
 .../android/app/ActivityManagerInternal.java  | 23 +++++++
 .../server/am/ActivityManagerService.java     | 15 +++++
 .../com/android/server/am/UserController.java | 65 ++++++++++++++++++
 .../server/wm/ActivityTaskManagerService.java | 45 +++++++++++++
 .../server/wm/RootWindowContainer.java        |  7 ++
 .../server/wm/WindowManagerService.java       | 66 ++++++++++++++++++-
 6 files changed, 220 insertions(+), 1 deletion(-)

diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index 6a71a7a7..ca7c8893 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1547,6 +1547,29 @@ public abstract class ActivityManagerInternal {
      */
     public abstract boolean consumeDecoySwitchAuthorizationForActiveDismiss(int userId);
 
+    /**
+     * Whether an authorized decoy switch (either direction) has been minted and the window manager
+     * has not yet applied its user change. The window manager holds the keyguard's going-away while
+     * this is true, so an exit that SystemUI starts early cannot show the outgoing user's windows.
+     * Self-expiring. See {@link com.android.server.am.UserController#isDecoySwitchInFlight}.
+     */
+    public abstract boolean isDecoySwitchInFlight();
+
+    /**
+     * True exactly once for the authorized switch to the decoy-type user {@code userId} that
+     * skipped the keyguard: the window manager then starts that user's home after the keyguard has
+     * gone away instead of inside the switch transition. See
+     * {@link com.android.server.am.UserController#consumeDecoyHomeDeferral}.
+     */
+    public abstract boolean consumeDecoyHomeDeferral(int userId);
+
+    /**
+     * Called by the window manager once it has applied the user change of a switch, so a held
+     * going-away of the keyguard can proceed. See
+     * {@link com.android.server.am.UserController#onDecoySwitchApplied}.
+     */
+    public abstract void onDecoySwitchApplied();
+
     /**
      * Best-effort freezes userId's app processes and marks it quiesced for notification
      * suppression (consulted separately via isUserQuiescedForDuress(), unaffected by the return
diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
