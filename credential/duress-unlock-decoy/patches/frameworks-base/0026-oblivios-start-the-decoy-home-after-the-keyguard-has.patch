             return mRealUserQuiescer.quiesce(userId);
diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index 9b312c30..db3e53a3 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -553,6 +553,28 @@ class UserController implements Handler.Callback {
     @GuardedBy("mLock")
     private boolean mActiveDismissConsumed;
 
+    /**
+     * ObliviOS: the user an authorized decoy switch (either direction) is heading for, from the
+     * mint until the window manager has applied the user change (onDecoySwitchApplied), or until
+     * DECOY_SWITCH_IN_FLIGHT_MAX_MS has passed. While it is set the keyguard's going-away is held
+     * (ActivityTaskManagerService#keyguardGoingAway), so a dismissal that SystemUI requests early,
+     * to start the exit animation of the unlock while the switch is still running, can never
+     * uncover the outgoing user's windows. Volatile and read without mLock: the window manager
+     * reads it under its own lock, and taking mLock there would invert the lock order.
+     */
+    private volatile int mDecoySwitchInFlightUserId = UserHandle.USER_NULL;
+    private volatile long mDecoySwitchInFlightSinceMillis;
+
+    /**
+     * ObliviOS: set when an authorized switch to a decoy-type user skipped the keyguard, read once
+     * by the window manager (consumeDecoyHomeDeferral) when it brings that user to the foreground:
+     * the decoy's home is then started after the keyguard has gone away, not inside the user
+     * switch transition, so the exit of the unlock does not wait for a cold launcher to draw.
+     */
+    private volatile int mDecoyHomeDeferralUserId = UserHandle.USER_NULL;
+
+    static final long DECOY_SWITCH_IN_FLIGHT_MAX_MS = 5_000L;
+
     /**
      * ObliviOS: monotonically-incrementing counter, advanced once for every foreground user
      * switch actually initiated by switchUser()/switchToUserSilently() (see
@@ -2461,6 +2483,9 @@ class UserController implements Handler.Callback {
                         // credential a second time. Deliberately worded without naming the
                         // mechanism -- this log line is reachable from a decoy session.
                         Slogf.i(TAG, "Skipping keyguard for an authorized switch");
+                        if (UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(userInfo.userType)) {
+                            mDecoyHomeDeferralUserId = userId;
+                        }
                     } else if (skipKeyguardWhenSwitchingToUnlockedUsers
                             && mInjector.isCeStorageUnlocked(userId)
                             && mLockPatternUtils.isTrustAllowedForUser(userId)) {
@@ -2823,6 +2848,8 @@ class UserController implements Handler.Callback {
             mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
             mSwitchAuthorizedAtSequence = mSwitchSequenceNumber;
             mAwaitingAuthorizedSwitch = true;
+            mDecoySwitchInFlightUserId = targetUserId;
+            mDecoySwitchInFlightSinceMillis = mSwitchAuthorizedAtMillis;
             // A fresh mint always starts all three grants unconsumed, even if the previous
             // mint's record (for what can structurally only ever be the same decoy id) was
             // never fully redeemed -- there is still only ever one pending authorization at a
@@ -2858,6 +2885,8 @@ class UserController implements Handler.Callback {
             mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
             mSwitchAuthorizedAtSequence = mSwitchSequenceNumber;
             mAwaitingAuthorizedSwitch = true;
+            mDecoySwitchInFlightUserId = UserHandle.USER_SYSTEM;
+            mDecoySwitchInFlightSinceMillis = mSwitchAuthorizedAtMillis;
             mForcedLockSkipConsumed = false;
             mBouncerSkipConsumed = false;
             mActiveDismissConsumed = false;
@@ -2925,6 +2954,42 @@ class UserController implements Handler.Callback {
         }
     }
 
+    /**
+     * ObliviOS: whether an authorized decoy switch has been minted and the window manager has not
+     * yet applied its user change (see mDecoySwitchInFlightUserId). Self-expiring, so a switch that
+     * never starts cannot hold the keyguard's going-away for longer than
+     * DECOY_SWITCH_IN_FLIGHT_MAX_MS.
+     */
+    boolean isDecoySwitchInFlight() {
+        final int user = mDecoySwitchInFlightUserId;
+        if (user == UserHandle.USER_NULL) {
+            return false;
+        }
+        final long age = mInjector.elapsedRealtime() - mDecoySwitchInFlightSinceMillis;
+        if (age < 0 || age > DECOY_SWITCH_IN_FLIGHT_MAX_MS) {
+            mDecoySwitchInFlightUserId = UserHandle.USER_NULL;
+            return false;
+        }
+        return true;
+    }
+
+    /**
+     * ObliviOS: true exactly once for the switch that skipped the keyguard for decoy-type
+     * {@code userId} (see mDecoyHomeDeferralUserId); false for every other switch.
+     */
+    boolean consumeDecoyHomeDeferral(int userId) {
+        if (mDecoyHomeDeferralUserId != userId) {
+            return false;
+        }
+        mDecoyHomeDeferralUserId = UserHandle.USER_NULL;
+        return true;
+    }
+
+    /** ObliviOS: the window manager applied the user change; the going-away no longer waits. */
+    void onDecoySwitchApplied() {
+        mDecoySwitchInFlightUserId = UserHandle.USER_NULL;
+    }
+
     @GuardedBy("mLock")
     private boolean isGrantConsumedLocked(DecoySwitchGrant grant) {
         switch (grant) {
diff --git a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
index 51f16802..83eab412 100644
--- a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
+++ b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
@@ -4237,6 +4237,35 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
         }
     }
 
+    // ObliviOS: a going-away of the keyguard that arrived while an authorized decoy switch was in
+    // flight, held until the window manager has applied the user change (see keyguardGoingAway).
+    @GuardedBy("mGlobalLock")
+    private boolean mKeyguardGoingAwayHeld;
+    @GuardedBy("mGlobalLock")
+    private int mHeldKeyguardGoingAwayFlags;
+    private static final long HELD_KEYGUARD_GOING_AWAY_MAX_MS = 2_000L;
+    private final Runnable mReleaseHeldKeyguardGoingAway = this::releaseHeldKeyguardGoingAway;
+
+    /**
+     * ObliviOS: runs the going-away that keyguardGoingAway held, once the user change is applied
+     * (WindowManagerService#moveUserToForeground) or the hold has run out. A no-op when nothing is
+     * held.
+     */
+    void releaseHeldKeyguardGoingAway() {
+        final int flags;
+        synchronized (mGlobalLock) {
+            if (!mKeyguardGoingAwayHeld) {
+                return;
+            }
+            mKeyguardGoingAwayHeld = false;
+            flags = mHeldKeyguardGoingAwayFlags;
+            mH.removeCallbacks(mReleaseHeldKeyguardGoingAway);
+        }
+        // A hold that ran out clears the in-flight mark too, or the call below would be held again.
+        mAmInternal.onDecoySwitchApplied();
+        keyguardGoingAway(flags);
+    }
+
     @Override
     public void keyguardGoingAway(int flags) {
         mAmInternal.enforceCallingPermission(CONTROL_KEYGUARD, "unlock keyguard");
@@ -4244,6 +4273,18 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
         final long token = Binder.clearCallingIdentity();
         try {
             synchronized (mGlobalLock) {
+                // ObliviOS: SystemUI starts the exit of an authorized decoy switch while the switch
+                // is still running, to make the unlock as fast as an ordinary one. Until the window
+                // manager has applied the user change the outgoing user's windows are still the ones
+                // a going-away would uncover, so it waits here, at most
+                // HELD_KEYGUARD_GOING_AWAY_MAX_MS, and runs when the change is applied.
+                if (mAmInternal.isDecoySwitchInFlight()) {
+                    mKeyguardGoingAwayHeld = true;
+                    mHeldKeyguardGoingAwayFlags = flags;
+                    mH.removeCallbacks(mReleaseHeldKeyguardGoingAway);
+                    mH.postDelayed(mReleaseHeldKeyguardGoingAway, HELD_KEYGUARD_GOING_AWAY_MAX_MS);
+                    return;
+                }
                 boolean isPowerModePreApplied = false;
                 if (mPowerModeReasons == 0) {
                     startPowerMode(POWER_MODE_REASON_START_ACTIVITY);
@@ -4261,6 +4302,10 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
                 final boolean wasNoResumed = mTopApp == null || !mTopApp.hasResumedActivity();
 
                 mKeyguardController.keyguardGoingAway(flags);
+                // ObliviOS: the going-away transition exists now; the home an authorized decoy
+                // switch deferred starts after it, as its own transition (see
+                // WindowManagerService#deferDecoyHomeStart).
+                mH.post(mWindowManager::startDeferredDecoyHome);
 
                 final boolean foundResumed = wasNoResumed
                         && mTopApp != null && mTopApp.hasResumedActivity();
diff --git a/services/core/java/com/android/server/wm/RootWindowContainer.java b/services/core/java/com/android/server/wm/RootWindowContainer.java
index d4d14a9a..bdc7536a 100644
--- a/services/core/java/com/android/server/wm/RootWindowContainer.java
+++ b/services/core/java/com/android/server/wm/RootWindowContainer.java
@@ -1423,6 +1423,13 @@ class RootWindowContainer extends WindowContainer<DisplayContent>
      */
     boolean startHomeOnTaskDisplayArea(int userId, String reason, TaskDisplayArea taskDisplayArea,
             boolean allowInstrumenting, boolean fromHomeKey, boolean onTop) {
+        // ObliviOS: the home of an authorized decoy switch is started by
+        // WindowManagerService#startDeferredDecoyHome once the keyguard has gone away; any other
+        // start in between (resuming the empty home task, for one) must not run it inside the
+        // going-away transition, which would then wait for the cold launcher to draw.
+        if (mWmService.isDecoyHomeDeferred(userId)) {
+            return false;
+        }
         // Fallback to top focused display area if the provided one is invalid.
         if (taskDisplayArea == null) {
             final Task rootTask = getTopDisplayFocusedRootTask();
diff --git a/services/core/java/com/android/server/wm/WindowManagerService.java b/services/core/java/com/android/server/wm/WindowManagerService.java
index 3673b58c..07bcc356 100644
--- a/services/core/java/com/android/server/wm/WindowManagerService.java
+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -4251,11 +4251,75 @@ public class WindowManagerService extends IWindowManager.Stub
      */
     public void moveUserToForeground(@UserIdInt int newUserId, UserState uss, String reason) {
         boolean homeInFront = mAtmService.mInternal.switchUser(newUserId, uss);
-        if (homeInFront) {
+        final ActivityManagerInternal ami = mAtmService.mAmInternal;
+        if (homeInFront && ami.consumeDecoyHomeDeferral(newUserId)) {
+            deferDecoyHomeStart(newUserId, reason);
+        } else if (homeInFront) {
             mAtmService.mInternal.startHomeActivity(newUserId, reason);
         } else {
             mAtmService.mInternal.resumeTopActivities(false /* scheduleIdle */);
         }
+        // ObliviOS: the user change is applied, so a going-away of the keyguard that was held for
+        // an authorized decoy switch (ActivityTaskManagerService#keyguardGoingAway) can run.
+        ami.onDecoySwitchApplied();
+        mAtmService.releaseHeldKeyguardGoingAway();
+    }
+
+    // ObliviOS: the user whose home start is deferred behind the keyguard's going-away (see
+    // deferDecoyHomeStart), and why.
+    @GuardedBy("mGlobalLock")
+    private int mDeferredDecoyHomeUserId = UserHandle.USER_NULL;
+    @GuardedBy("mGlobalLock")
+    private String mDeferredDecoyHomeReason;
+    private static final long DEFERRED_DECOY_HOME_MAX_MS = 1_500L;
+    private final Runnable mStartDeferredDecoyHome = this::startDeferredDecoyHome;
+
+    /**
+     * ObliviOS: an authorized switch to the decoy starts the decoy's home after the keyguard has
+     * gone away, not inside the user switch transition. A transition waits for the first draw of
+     * every activity it starts, and the decoy's launcher needs about 0.75 s for it (lynx
+     * 2026-11-13), so the exit of the unlock, queued behind that transition, ended 1.6 s after the
+     * credential check instead of 0.8 s. Without the home the transition has nothing to wait for,
+     * the exit shows the decoy's wallpaper, and the home loads in behind it. Started at once when
+     * the keyguard is not showing (no going-away is coming), and never later than
+     * DEFERRED_DECOY_HOME_MAX_MS.
+     */
+    private void deferDecoyHomeStart(@UserIdInt int userId, String reason) {
+        synchronized (mGlobalLock) {
+            if (mAtmService.mKeyguardController.isKeyguardShowing(DEFAULT_DISPLAY)) {
+                mDeferredDecoyHomeUserId = userId;
+                mDeferredDecoyHomeReason = reason;
+                mH.removeCallbacks(mStartDeferredDecoyHome);
+                mH.postDelayed(mStartDeferredDecoyHome, DEFERRED_DECOY_HOME_MAX_MS);
+                return;
+            }
+        }
+        mAtmService.mInternal.startHomeActivity(userId, reason);
+    }
+
+    /** ObliviOS: starts the home that deferDecoyHomeStart held back, once. */
+    void startDeferredDecoyHome() {
+        final int userId;
+        final String reason;
+        synchronized (mGlobalLock) {
+            if (mDeferredDecoyHomeUserId == UserHandle.USER_NULL) {
+                return;
+            }
+            userId = mDeferredDecoyHomeUserId;
+            reason = mDeferredDecoyHomeReason;
+            mDeferredDecoyHomeUserId = UserHandle.USER_NULL;
+            mH.removeCallbacks(mStartDeferredDecoyHome);
+        }
+        if (mAtmService.mAmInternal.getCurrentUserId() == userId) {
+            mAtmService.mInternal.startHomeActivity(userId, reason + ",deferred");
+        }
+    }
+
+    /** ObliviOS: whether the home start of {@code userId} is still deferred. */
+    boolean isDecoyHomeDeferred(@UserIdInt int userId) {
+        synchronized (mGlobalLock) {
+            return mDeferredDecoyHomeUserId == userId;
+        }
     }
 
     /* Called by WindowState */
