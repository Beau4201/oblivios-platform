Date: Tue, 10 Nov 2026 13:15:28 +0100
Subject: [PATCH 12/13] oblivios: hold back BOOT_COMPLETED of a background
 Duress decoy

A decoy warm-started while the device is locked unlocks at once (its
storage stays open after a stop, delayed locking) and BOOT_COMPLETED
then starts about 30 boot receivers: 38 processes and 2.0 GB PSS on
lynx while locked. Only the launcher has to be warm for the switch.
The broadcast is sent once the decoy is the foreground user and its
home screen has gone idle (finishUserSwitch).
---
 .../com/android/server/am/UserController.java | 39 +++++++++++++++++++
 .../java/com/android/server/am/UserState.java |  7 ++++
 2 files changed, 46 insertions(+)

diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index 4a4c1113..90d7059a 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -717,11 +717,32 @@ class UserController implements Handler.Callback {
         // This call holds the AM lock so we post to the handler.
         mHandler.post(() -> {
             finishUserBoot(uss);
+            sendDeferredBootCompleted(uss);
             startProfiles();
             stopExcessRunningUsers();
         });
     }
 
+    /**
+     * ObliviOS: sends the BOOT_COMPLETED that finishUserUnlockedCompleted held back for a
+     * background Duress decoy, now that the decoy is in the foreground and its home screen has
+     * gone idle. A start that was stopped in between has its own, new UserState, so a stale mark
+     * never fires.
+     */
+    private void sendDeferredBootCompleted(UserState uss) {
+        synchronized (mLock) {
+            if (!uss.bootCompletedDeferred
+                    || mStartedUsers.get(uss.mHandle.getIdentifier()) != uss) {
+                return;
+            }
+            uss.bootCompletedDeferred = false;
+        }
+        final UserInfo userInfo = getUserInfo(uss.mHandle.getIdentifier());
+        if (userInfo != null) {
+            sendBootCompletedBroadcast(userInfo);
+        }
+    }
+
     /** Adds a user to mUserLru, moving it to the end of the list if it was already present. */
     private void addUserToUserLru(@UserIdInt int userId) {
         synchronized (mLock) {
@@ -1184,6 +1205,24 @@ class UserController implements Handler.Callback {
 
         mHandler.obtainMessage(USER_UNLOCKED_MSG, userId, 0).sendToTarget();
 
+        // ObliviOS: a Duress decoy that comes up in the background (warm-started while the
+        // device is locked) gets its BOOT_COMPLETED only once it becomes the foreground user, in
+        // finishUserSwitch. Sent here it starts every boot receiver of the decoy, about 30 app
+        // processes and 1.6 GB on lynx, all held while the device sits locked; only the launcher
+        // has to be warm for the switch.
+        synchronized (mLock) {
+            if (UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(userInfo.userType)
+                    && getCurrentOrTargetUserIdLU() != userId) {
+                uss.bootCompletedDeferred = true;
+                Slogf.i(TAG, "Deferring BOOT_COMPLETED of background user #" + userId);
+                return;
+            }
+        }
+        sendBootCompletedBroadcast(userInfo);
+    }
+
+    private void sendBootCompletedBroadcast(UserInfo userInfo) {
+        final int userId = userInfo.id;
         Slogf.i(TAG, "Posting BOOT_COMPLETED user #" + userId);
         // Do not report secondary users, runtime restarts or first boot/upgrade
         if (userId == UserHandle.USER_SYSTEM
diff --git a/services/core/java/com/android/server/am/UserState.java b/services/core/java/com/android/server/am/UserState.java
index a84e3556..d542a9d1 100644
--- a/services/core/java/com/android/server/am/UserState.java
+++ b/services/core/java/com/android/server/am/UserState.java
@@ -56,6 +56,13 @@ public final class UserState {
     public int lastState = STATE_BOOTING;
     public boolean switching;
 
+    /**
+     * ObliviOS: BOOT_COMPLETED was held back for this start of a Duress decoy user that came up
+     * in the background; it is sent once the decoy becomes the foreground user. Tied to this
+     * UserState, so a stop discards it. Guarded by UserController.mLock.
+     */
+    public boolean bootCompletedDeferred;
+
     /** Callback for key eviction. */
     public interface KeyEvictedCallback {
         /** Invoked when the key is evicted. */
