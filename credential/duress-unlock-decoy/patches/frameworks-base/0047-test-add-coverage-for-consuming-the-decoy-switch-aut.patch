Subject: [PATCH] test: add coverage for consuming the decoy switch
 authorization

---
 .../android/server/am/UserControllerTest.java | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
index cbce72b..1cf6e1b 100644
--- a/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/UserControllerTest.java
@@ -2718,6 +2718,25 @@ public class UserControllerTest {
         assertThat(mUserController.consumeDecoySwitchAuthorization(TEST_DECOY_USER_ID)).isFalse();
     }
 
+    @Test
+    public void testForegroundSwitch_authorizedDecoy_doesNotForceKeyguard() throws Exception {
+        setUserSecure(TEST_DECOY_USER_ID, true);
+        mUserController.authorizeDecoySwitchKeyguardSkip(TEST_DECOY_USER_ID);
+
+        startForegroundUser(TEST_DECOY_USER_ID);
+
+        verify(mInjector, never()).lockDeviceNowAndWaitForKeyguardShown();
+    }
+
+    @Test
+    public void testForegroundSwitch_unauthorizedSecureUser_forcesKeyguard() throws Exception {
+        setUserSecure(TEST_ORDINARY_USER_ID, true);
+
+        startForegroundUser(TEST_ORDINARY_USER_ID);
+
+        verify(mInjector).lockDeviceNowAndWaitForKeyguardShown();
+    }
+
     private void setUpAndStartUserInBackground(int userId) throws Exception {
         setUpUser(userId, DEFAULT_USER_FLAGS);
         mUserController.startUser(userId, USER_START_MODE_BACKGROUND);
@@ -2846,6 +2865,36 @@ public class UserControllerTest {
         mInjector.advanceElapsedRealtimeBy(millis);
     }
 
+    /**
+     * AegisOS: stubs whether userId's keyguard reports the device as secure -- the
+     * {@code mInjector.getKeyguardManager().isDeviceSecure(userId)} check that gates the
+     * consumption point in {@code continueStartUserInternal}.
+     */
+    private void setUserSecure(@UserIdInt int userId, boolean secure) {
+        when(mInjector.mKeyguardManagerMock.isDeviceSecure(userId)).thenReturn(secure);
+    }
+
+    /**
+     * AegisOS: registers userId as a genuine, startable full user with {@code mUserManagerMock}
+     * (the mock {@code UserController#getUserInfo()} queries via {@code startUser()}'s own flow --
+     * distinct from {@code mUserManagerInternalMock}, which
+     * {@code registerUserManagerInternalUserInfo()} above registers with instead), enables
+     * user-switch UI so the keyguard block in {@code continueStartUserInternal} is reachable at
+     * all, then drives a real foreground {@code startUser()} call and waits for its handler work
+     * to finish.
+     */
+    private void startForegroundUser(@UserIdInt int userId) throws Exception {
+        setUpUser(userId, DEFAULT_USER_FLAGS);
+        mUserController.setInitialConfig(/* userSwitchUiEnabled= */ true,
+                /* maxRunningUsers= */ 3, /* delayUserDataLocking= */ false,
+                /* backgroundUserConsideredDispensableTimeSecs= */ -1,
+                /* skipKeyguardWhenSwitchingToUnlockedUsers= */ false,
+                /* hideUserSwitchingUiDuringSetup= */ false);
+
+        mUserController.startUser(userId, USER_START_MODE_FOREGROUND);
+        waitForHandlerToComplete(mInjector.mHandler, HANDLER_WAIT_TIME_MS);
+    }
+
