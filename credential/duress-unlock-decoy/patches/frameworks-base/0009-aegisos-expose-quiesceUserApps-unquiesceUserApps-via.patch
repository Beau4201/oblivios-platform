From 35dee8ebff7436851e92b970705f2cf92337e47c Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 27 Aug 2026 03:05:47 +0200
Subject: [PATCH 09/89] aegisos: expose quiesceUserApps/unquiesceUserApps via
 ActivityManagerInternal

---
 .../android/app/ActivityManagerInternal.java  | 20 +++++++++++++++++++
 .../server/am/ActivityManagerService.java     | 20 +++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index e3017d3ce3aa..f8512e48fb22 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -1505,4 +1505,24 @@ public abstract class ActivityManagerInternal {
      * {@link com.android.server.am.UserController#switchToUserSilently}.
      */
     public abstract boolean switchToUserSilently(int targetUserId);
+
+    /**
+     * Best-effort freezes userId's app processes and installs a notification-suppression flag
+     * for it. Returns whether the notification-suppression flag was installed (freeze failures
+     * never affect this return value -- see docs/superpowers/specs/2026-08-27
+     * -duress-real-user-quiescing-and-return-design.md's asymmetric error-handling rule).
+     */
+    public abstract boolean quiesceUserApps(int userId);
+
+    /**
+     * Best-effort unfreezes userId's app processes and clears its notification-suppression
+     * flag. Always safe to call, including for a user that was never quiesced. Never blocks.
+     */
+    public abstract void unquiesceUserApps(int userId);
+
+    /**
+     * Returns whether userId is currently quiesced (see quiesceUserApps). Consulted by
+     * NotificationManagerService before posting a notification.
+     */
+    public abstract boolean isUserQuiescedForDuress(int userId);
 }
diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index d6edae37ab27..a47cad7a6fa3 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -744,6 +744,8 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     /** Service for optimizing resource usage from background apps. */
     private CachedAppOptimizer mCachedAppOptimizer;
+    /** Freezes/unfreezes a user's app processes for AegisOS's duress decoy mechanism. */
+    final RealUserQuiescer mRealUserQuiescer;
     OomAdjuster mOomAdjuster;
     @GuardedBy("this")
     ProcessStateController mProcessStateController;
@@ -2604,6 +2606,7 @@ public class ActivityManagerService extends IActivityManager.Stub
         mPhantomProcessList = new PhantomProcessList(this);
 
         mCachedAppOptimizer = new CachedAppOptimizer(this);
+        mRealUserQuiescer = new RealUserQuiescer(this, mCachedAppOptimizer);
         mProcessStateController = new ProcessStateController
                 .Builder(mProcessList, activeUids, oomConstants, new OomAdjusterCallback())
                 .setHandlerThread(handlerThread)
@@ -2680,6 +2683,7 @@ public class ActivityManagerService extends IActivityManager.Stub
         mPhantomProcessList = new PhantomProcessList(this);
         final Looper activityTaskLooper = DisplayThread.get().getLooper();
         mCachedAppOptimizer = new CachedAppOptimizer(this);
+        mRealUserQuiescer = new RealUserQuiescer(this, mCachedAppOptimizer);
         mProcessStateController = new ProcessStateController
                 .Builder(mProcessList, activeUids, oomConstants, new OomAdjusterCallback())
                 .setLockObject(this)
@@ -17624,6 +17628,22 @@ public class ActivityManagerService extends IActivityManager.Stub
             return mUserController.switchToUserSilently(targetUserId);
         }
 
+        @Override
+        public boolean quiesceUserApps(int userId) {
+            mRealUserQuiescer.quiesce(userId);
+            return true;
+        }
+
+        @Override
+        public void unquiesceUserApps(int userId) {
+            mRealUserQuiescer.unquiesce(userId);
+        }
+
+        @Override
+        public boolean isUserQuiescedForDuress(int userId) {
+            return mRealUserQuiescer.isQuiesced(userId);
+        }
+
         @Override
         public List<PendingIntentStats> getPendingIntentStats() {
             return mPendingIntentController.dumpPendingIntentStatsForStatsd();
-- 
2.39.5

