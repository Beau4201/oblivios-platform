From 30f5cd594a92abf6691ac0d31ad821ee8fac4564 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 20 Sep 2026 19:12:35 +0200
Subject: [PATCH] sovereignos: mock ProcessRecord under the shared dexmaker
 classloader

Both real-hardware-failing tests created their ProcessRecord mock
outside runWithDexmakerShareClassLoader(). ProcessRecord is
package-private (unlike the public ActivityManagerService/
CachedAppOptimizer already mocked inside that wrapper in setUp()), so
dexmaker's generated proxy subclass was rejected at runtime as an
inaccessible class -- confirmed by a real atest run on physical/emulator
hardware, not assumed. Fix: build the mock inside the same
share-classloader wrapper via a small helper, matching the wrapper's own
documented purpose ("allows mocking package-private methods").
---
 .../server/am/RealUserQuiescerTest.java       | 39 +++++++++++++------
 1 file changed, 28 insertions(+), 11 deletions(-)

diff --git a/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java b/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java
index 9213d00..5bf5cfd 100644
--- a/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java
+++ b/services/tests/servicestests/src/com/android/server/am/RealUserQuiescerTest.java
@@ -76,11 +76,8 @@ public class RealUserQuiescerTest {
     @Test
     public void quiesce_singleProcessThrowsOnFreeze_returnsFalse() throws Exception {
         final int userId = 10;
-        ProcessRecord app = mock(ProcessRecord.class);
-        setFinalField(ProcessRecordInternal.class, app, "uid",
-                userId * UserHandle.PER_USER_RANGE);
-        setFinalField(ProcessRecordInternal.class, app, "processName", "com.example.app");
-        when(app.isPersistent()).thenReturn(false);
+        ProcessRecord app = createMockProcessRecord(
+                userId * UserHandle.PER_USER_RANGE, "com.example.app");
         getLruProcesses(mProcessList).add(app);
         doThrow(new RuntimeException("frozen solid"))
                 .when(mCachedAppOptimizer).forceFreezeAppAsyncLSP(app);
@@ -94,12 +91,8 @@ public class RealUserQuiescerTest {
     @Test
     public void quiesce_otherUsersProcess_isIgnoredAndReturnsTrue() throws Exception {
         final int userId = 10;
-        ProcessRecord otherUsersApp = mock(ProcessRecord.class);
-        setFinalField(ProcessRecordInternal.class, otherUsersApp, "uid",
-                11 * UserHandle.PER_USER_RANGE);
-        setFinalField(ProcessRecordInternal.class, otherUsersApp, "processName",
-                "com.example.otheruser");
-        when(otherUsersApp.isPersistent()).thenReturn(false);
+        ProcessRecord otherUsersApp = createMockProcessRecord(
+                11 * UserHandle.PER_USER_RANGE, "com.example.otheruser");
         getLruProcesses(mProcessList).add(otherUsersApp);
         doThrow(new RuntimeException("should never be called for this user"))
                 .when(mCachedAppOptimizer).forceFreezeAppAsyncLSP(otherUsersApp);
@@ -107,6 +100,30 @@ public class RealUserQuiescerTest {
         assertThat(mQuiescer.quiesce(userId)).isTrue();
     }
 
+    /**
+     * {@link ProcessRecord} is package-private, so mocking it -- unlike the {@code public}
+     * {@link ActivityManagerService}/{@link CachedAppOptimizer} mocked in {@link #setUp} --
+     * requires the same {@code runWithDexmakerShareClassLoader} wrapper {@link #setUp} already
+     * uses, or dexmaker's generated proxy subclass is rejected as an inaccessible class at
+     * runtime (confirmed via a real on-device `atest` failure, not assumed).
+     */
+    private static ProcessRecord createMockProcessRecord(int uid, String processName)
+            throws Exception {
+        final ProcessRecord[] holder = new ProcessRecord[1];
+        runWithDexmakerShareClassLoader(() -> {
+            try {
+                ProcessRecord app = mock(ProcessRecord.class);
+                setFinalField(ProcessRecordInternal.class, app, "uid", uid);
+                setFinalField(ProcessRecordInternal.class, app, "processName", processName);
+                when(app.isPersistent()).thenReturn(false);
+                holder[0] = app;
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+        });
+        return holder[0];
+    }
+
     @SuppressWarnings("unchecked")
     private static ArrayList<ProcessRecord> getLruProcesses(ProcessList processList)
             throws Exception {
