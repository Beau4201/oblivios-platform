Subject: [PATCH 08/89] aegisos: add RealUserQuiescer for duress decoy
 freeze/unfreeze

---
 .../android/server/am/RealUserQuiescer.java   | 94 +++++++++++++++++++
 1 file changed, 94 insertions(+)
 create mode 100644 services/core/java/com/android/server/am/RealUserQuiescer.java

diff --git a/services/core/java/com/android/server/am/RealUserQuiescer.java b/services/core/java/com/android/server/am/RealUserQuiescer.java
new file mode 100644
index 000000000000..0946e3a55cad
--- /dev/null
+++ b/services/core/java/com/android/server/am/RealUserQuiescer.java
@@ -0,0 +1,94 @@
+package com.android.server.am;
+
+import android.os.UserHandle;
+import android.util.ArraySet;
+import android.util.Slog;
+
+import java.util.Set;
+
+/**
+ * Freezes and unfreezes a given user's app processes, and tracks which users are currently
+ * quiesced. Used by AegisOS's duress-unlock decoy mechanism to approximate "stop this user"
+ * for user 0 (UserHandle.USER_SYSTEM), which AOSP's UserController.stopUsersLU refuses to do
+ * unconditionally -- confirmed via real source, services/core/java/com/android/server/am
+ * /UserController.java:1323-1324. See docs/superpowers/specs/2026-08-27-duress-real-user
+ * -quiescing-and-return-design.md in the aegisos-foundation repository.
+ *
+ * Freezing is always best-effort: a process that resists freezing is logged, not escalated.
+ * This class does not touch notification state; NotificationManagerService consults
+ * isQuiesced() directly via ActivityManagerInternal.
+ */
+class RealUserQuiescer {
+    private static final String TAG = "RealUserQuiescer";
+
+    private final ActivityManagerService mAm;
+    private final CachedAppOptimizer mCachedAppOptimizer;
+    private final Set<Integer> mQuiescedUserIds = new ArraySet<>();
+
+    RealUserQuiescer(ActivityManagerService am, CachedAppOptimizer cachedAppOptimizer) {
+        mAm = am;
+        mCachedAppOptimizer = cachedAppOptimizer;
+    }
+
+    /**
+     * Freezes userId's currently-running, non-persistent app processes (best-effort) and marks
+     * userId as quiesced. Callers should invoke this only after userId has actually stopped
+     * being the foreground user -- a still-foreground process generally cannot be frozen.
+     */
+    void quiesce(int userId) {
+        synchronized (mAm) {
+            synchronized (mAm.mProcLock) {
+                for (ProcessRecord app : mAm.mProcessList.getLruProcessesLOSP()) {
+                    if (UserHandle.getUserId(app.uid) != userId || app.isPersistent()) {
+                        continue;
+                    }
+                    try {
+                        mCachedAppOptimizer.forceFreezeAppAsyncLSP(app);
+                    } catch (RuntimeException e) {
+                        Slog.e(TAG, "Failed to freeze process " + app.processName
+                                + " for quiesced user " + userId, e);
+                    }
+                }
+            }
+        }
+        synchronized (mQuiescedUserIds) {
+            mQuiescedUserIds.add(userId);
+        }
+    }
+
+    /**
+     * Unfreezes userId's currently-frozen app processes. Always safe to call, including for a
+     * user that was never quiesced (no-op). Never throws.
+     */
+    void unquiesce(int userId) {
+        boolean wasQuiesced;
+        synchronized (mQuiescedUserIds) {
+            wasQuiesced = mQuiescedUserIds.remove(userId);
+        }
+        if (!wasQuiesced) {
+            return;
+        }
+        synchronized (mAm) {
+            synchronized (mAm.mProcLock) {
+                for (ProcessRecord app : mAm.mProcessList.getLruProcessesLOSP()) {
+                    if (UserHandle.getUserId(app.uid) != userId) {
+                        continue;
+                    }
+                    try {
+                        mCachedAppOptimizer.unfreezeAppLSP(app,
+                                CachedAppOptimizer.UNFREEZE_REASON_SHELL);
+                    } catch (RuntimeException e) {
+                        Slog.e(TAG, "Failed to unfreeze process " + app.processName
+                                + " for user " + userId, e);
+                    }
+                }
+            }
+        }
+    }
+
+    boolean isQuiesced(int userId) {
+        synchronized (mQuiescedUserIds) {
+            return mQuiescedUserIds.contains(userId);
+        }
+    }
+}
