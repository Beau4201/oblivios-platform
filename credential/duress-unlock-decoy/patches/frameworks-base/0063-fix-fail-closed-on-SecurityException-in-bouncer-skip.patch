From 713127e073b3558cce51d9457ff7e88f2394563c Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 10:34:13 +0200
Subject: [PATCH 65/89] fix: fail closed on SecurityException in bouncer-skip
 authorization check

consumeDecoySwitchAuthorizationForBouncerSkip only caught RemoteException
around the Binder call, breaking the otherwise-consistent fail-closed
pattern: every other branch (null service, no grant, expired grant,
wrong user) returns false, but a SecurityException from a permission
misconfiguration on the service side would have propagated uncaught into
the keyguard's own call site. Catch it alongside RemoteException so it
degrades to the same safe behavior -- the bouncer is shown again, never
bypassed.
---
 .../com/android/internal/widget/LockPatternUtils.java | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/core/java/com/android/internal/widget/LockPatternUtils.java b/core/java/com/android/internal/widget/LockPatternUtils.java
index 6f56ce412615..ea13d2b1474a 100644
--- a/core/java/com/android/internal/widget/LockPatternUtils.java
+++ b/core/java/com/android/internal/widget/LockPatternUtils.java
@@ -1673,16 +1673,21 @@ public class LockPatternUtils {
      * authorization for {@code userId}. This is a genuine single-use state mutation in
      * system_server, not an idempotent read, so it is deliberately never cached (unlike
      * {@link #isSecure(int)} above). On any doubt -- including a RemoteException, which normally
-     * means system_server died -- this fails closed and returns false, since the only effect of
-     * a false return is that the ordinary bouncer is (re)shown. See
+     * means system_server died, or a SecurityException from a permission misconfiguration --
+     * this fails closed and returns false, since the only effect of a false return is that the
+     * ordinary bouncer is (re)shown. See
      * {@link com.android.server.am.UserController#consumeDecoySwitchAuthorizationForBouncerSkip}.
      */
     public boolean consumeDecoySwitchAuthorizationForBouncerSkip(int userId) {
         try {
             return getLockSettings().consumeDecoySwitchAuthorizationForBouncerSkip(userId);
-        } catch (RemoteException e) {
+        } catch (RemoteException | SecurityException e) {
             // Deliberately worded without naming the mechanism -- this log line is reachable
             // from a decoy session. Fails closed: the caller still shows its ordinary bouncer.
+            // SecurityException is caught alongside RemoteException so a permission
+            // misconfiguration on the service side degrades to the same fail-closed behavior
+            // as every other branch of this check, instead of propagating uncaught into the
+            // keyguard's own call site.
             Log.e(TAG, "failed to check bouncer-skip authorization for switch", e);
             return false;
         }
