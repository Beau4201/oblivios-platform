From 2775d716886ad7af926e7edbace0e7dd3b1c9e13 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 18:06:15 +0100
Subject: [PATCH] oblivios: do not wait for the decoy's unlock to finish before
 the duress switch, and start its home 150 ms after the going-away

---
 .../locksettings/DecoyProfileHelper.java      | 31 ++++++++++++++-----
 .../locksettings/LockSettingsService.java     | 20 +++++++++---
 .../server/wm/ActivityTaskManagerService.java |  8 +++--
 3 files changed, 45 insertions(+), 14 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 0ea9006c..5704682c 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -270,9 +270,7 @@ class DecoyProfileHelper {
             return null;
         }
 
-        VerifyCredentialResponse response = lockSettingsService.doVerifyCredentialInner(
-                credential, Primary, state.decoyUserId, /* progressCallback= */ null,
-                /* flags= */ 0);
+        VerifyCredentialResponse response = verifyDecoyCredential(credential, state.decoyUserId);
         if (!response.isMatched()) {
             return null;
         }
@@ -294,12 +292,28 @@ class DecoyProfileHelper {
         if (registered == null || !decoyUserExists(registered.decoyUserId)) {
             return false;
         }
-        final VerifyCredentialResponse response = lockSettingsService.doVerifyCredentialInner(
-                credential, Primary, registered.decoyUserId, /* progressCallback= */ null,
-                /* flags= */ 0);
+        final VerifyCredentialResponse response =
+                verifyDecoyCredential(credential, registered.decoyUserId);
         return response.isMatched() && mintAndSwitch(registered.decoyUserId);
     }
 
+    /**
+     * ObliviOS: verifies the decoy credential, and unlocks the decoy's storage on a match, without
+     * waiting for the decoy's unlock to finish (see LockSettingsService#mDecoyUnlockDoesNotWait).
+     * The duress unlock takes 0.33 s less for it, and that time is what the unlock has to save to
+     * equal an ordinary one.
+     */
+    private VerifyCredentialResponse verifyDecoyCredential(LockscreenCredential credential,
+            int decoyUserId) {
+        lockSettingsService.mDecoyUnlockDoesNotWait.set(Boolean.TRUE);
+        try {
+            return lockSettingsService.doVerifyCredentialInner(credential, Primary, decoyUserId,
+                    /* progressCallback= */ null, /* flags= */ 0);
+        } finally {
+            lockSettingsService.mDecoyUnlockDoesNotWait.remove();
+        }
+    }
+
     /**
      * The part of the routing that follows a matched decoy credential, shared by the typed
      * credential and the finger. The mint stays in this class: no other class calls
@@ -345,7 +359,8 @@ class DecoyProfileHelper {
     private static void awaitDecoyUnlocked(int decoyUserId) {
         final ActivityManagerInternal ami =
                 LocalServices.getService(ActivityManagerInternal.class);
-        if (ami == null || ami.isUserRunning(decoyUserId, ActivityManager.FLAG_AND_UNLOCKED)) {
+        if (ami == null || ami.isUserRunning(decoyUserId,
+                ActivityManager.FLAG_AND_UNLOCKING_OR_UNLOCKED)) {
             return;
         }
         final CountDownLatch unlocked = new CountDownLatch(1);
@@ -373,7 +388,7 @@ class DecoyProfileHelper {
             Binder.restoreCallingIdentity(token);
         }
         final long deadline = SystemClock.uptimeMillis() + DECOY_UNLOCK_WAIT_MS;
-        while (!ami.isUserRunning(decoyUserId, ActivityManager.FLAG_AND_UNLOCKED)) {
+        while (!ami.isUserRunning(decoyUserId, ActivityManager.FLAG_AND_UNLOCKING_OR_UNLOCKED)) {
             final long left = deadline - SystemClock.uptimeMillis();
             if (left <= 0) {
                 Slog.w(TAG, "Routing target not unlocked after " + DECOY_UNLOCK_WAIT_MS
diff --git a/services/core/java/com/android/server/locksettings/LockSettingsService.java b/services/core/java/com/android/server/locksettings/LockSettingsService.java
index eb88c3cb..42ea8444 100644
--- a/services/core/java/com/android/server/locksettings/LockSettingsService.java
+++ b/services/core/java/com/android/server/locksettings/LockSettingsService.java
@@ -1838,6 +1838,16 @@ public class LockSettingsService extends ILockSettings.Stub {
      * can end up calling into other system services to process user unlock request (via
      * {@link com.android.server.SystemServiceManager#unlockUser} </em>
      */
+    /**
+     * ObliviOS: set by DecoyProfileHelper on its own thread around the verification of the decoy
+     * credential: unlockUser then returns as soon as the unlock has started, not when it has
+     * finished. The finish takes 0.33 s more on lynx (service callbacks, storage preparation)
+     * and nothing in the duress unlock needs it: the switch to the decoy starts at once, and its
+     * home is started after the keyguard has gone away, by when the user is unlocking, which is
+     * all the package manager needs to resolve the launcher instead of the FallbackHome.
+     */
+    final ThreadLocal<Boolean> mDecoyUnlockDoesNotWait = new ThreadLocal<>();
+
     private void unlockUser(@UserIdInt int userId) {
         // TODO: make this method fully async so we can update UI with progress strings
         final boolean alreadyUnlocked = mUserManager.isUserUnlockingOrUnlocked(userId);
@@ -1866,10 +1876,12 @@ public class LockSettingsService extends ILockSettings.Stub {
             throw e.rethrowAsRuntimeException();
         }
 
-        try {
-            latch.await(15, TimeUnit.SECONDS);
-        } catch (InterruptedException e) {
-            Thread.currentThread().interrupt();
+        if (!Boolean.TRUE.equals(mDecoyUnlockDoesNotWait.get())) {
+            try {
+                latch.await(15, TimeUnit.SECONDS);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
         }
 
         if (isCredentialShareableWithParent(userId)) {
diff --git a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
index 83eab412..651955c9 100644
--- a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
+++ b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
@@ -4244,6 +4244,7 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
     @GuardedBy("mGlobalLock")
     private int mHeldKeyguardGoingAwayFlags;
     private static final long HELD_KEYGUARD_GOING_AWAY_MAX_MS = 2_000L;
+    private static final long DEFERRED_DECOY_HOME_AFTER_GOING_AWAY_MS = 150L;
     private final Runnable mReleaseHeldKeyguardGoingAway = this::releaseHeldKeyguardGoingAway;
 
     /**
@@ -4304,8 +4305,11 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
                 mKeyguardController.keyguardGoingAway(flags);
                 // ObliviOS: the going-away transition exists now; the home an authorized decoy
                 // switch deferred starts after it, as its own transition (see
-                // WindowManagerService#deferDecoyHomeStart).
-                mH.post(mWindowManager::startDeferredDecoyHome);
+                // WindowManagerService#deferDecoyHomeStart). Not at once: the going-away can be
+                // merged into the user switch transition, which is still collecting for a moment,
+                // and a home started into it would bring back the wait for its first draw.
+                mH.postDelayed(mWindowManager::startDeferredDecoyHome,
+                        DEFERRED_DECOY_HOME_AFTER_GOING_AWAY_MS);
 
                 final boolean foundResumed = wasNoResumed
                         && mTopApp != null && mTopApp.hasResumedActivity();
-- 
2.47.3

