+    /**
+     * True when the current session is an SovereignOS Duress Unlock decoy user. The decoy is an
+     * ordinary secondary profile, so it fails the main-user check above like any other
+     * secondary user by default -- but a decoy session is meant to be indistinguishable from a
+     * normal single-owner phone, so this tile is exempted too. Reuses
+     * {@link UserManager#getUsersForUiDisplay}, the same identity-aware primitive every other
+     * Component B fix in this feature uses: when the calling user is the decoy, that call
+     * returns a singleton list containing only the caller's own {@link UserInfo}.
+     */
+    private boolean isDecoySession() {
+        List<UserInfo> usersForUiDisplay = mUserManager.getUsersForUiDisplay(true);
+        return usersForUiDisplay.size() == 1
+                && UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(
+                        usersForUiDisplay.get(0).userType);
     }
 
     @Nullable
