@@ -332,7 +332,11 @@ public class UninstallAlertDialogFragment extends DialogFragment implements
      * calculation.
      */
     private boolean isSingleUser(UserManager userManager) {
-        final int userCount = userManager.getUserCount();
+        // getUsersForUiDisplay(true) is getUserCount()'s own semantics (getUsers().size(),
+        // here with dying users excluded) plus SovereignOS Duress Unlock decoy-session filtering,
+        // so this dialog reads "uninstall this app?" rather than "...for all users?" during a
+        // decoy session, matching what a genuine single-user phone would show.
+        final int userCount = userManager.getUsersForUiDisplay(true).size();
         return userCount == 1 || (UserManager.isHeadlessSystemUserMode() && userCount == 2);
     }
 }
