From b398dfb00d16475bd9f32ff284ce0f3ad9c96567 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Fri, 13 Nov 2026 18:07:55 +0100
Subject: [PATCH] oblivios: a global setting turns the fast duress unlock off
 for a comparison, consume the home deferral with every switch

---
 .../keyguard/KeyguardViewMediator.java        | 12 ++-----
 .../keyguard/KeyguardViewMediatorTest.java    |  1 -
 .../com/android/server/am/UserController.java | 32 ++++++++++++++++---
 .../locksettings/DecoyProfileHelper.java      | 12 ++++++-
 .../server/wm/WindowManagerService.java       |  5 ++-
 5 files changed, 44 insertions(+), 18 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index b7d3ea7e..6aa7f16f 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -783,7 +783,8 @@ public class KeyguardViewMediator implements CoreStartable,
                 resetStateLocked(/* hideBouncer= */ !mAuthorizedSwitchDismissPending);
             }
             resultCallback.run();
-            if (mAuthorizedSwitchDismissPending) {
+            if (mAuthorizedSwitchDismissPending && Settings.Global.getInt(
+                    mContext.getContentResolver(), "oblivios_duress_fast", 1) != 0) {
                 // ObliviOS: the exit of an authorized switch starts here, as soon as the switch
                 // is released, not at USER_SWITCH_COMPLETE. On lynx 2026-11-13 the switch completed
                 // 2.1 s after the credential check (the cold decoy's services), so the bouncer
@@ -811,15 +812,6 @@ public class KeyguardViewMediator implements CoreStartable,
                 dismiss(null, null);
                 waitForTransitionToBouncer(resultCallback);
             } else {
-                if (mAuthorizedSwitchDismissPending && !mAuthorizedSwitchDismissRequested) {
-                    // ObliviOS: the exit was not requested in handleBeforeUserSwitching (it is
-                    // there for every authorized switch; this is the fallback for a path that
-                    // reaches here without it).
-                    mAuthorizedSwitchDismissRequested = true;
-                    mHandler.postDelayed(
-                            () -> dismiss(null /* callback */, null /* message */), mDismissToken,
-                            0);
-                }
                 resultCallback.run();
             }
         }
diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index 41d3747d..35b4967a 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -645,7 +645,6 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         // decoy: the complete message arrives about a second later).
         assertTrue(mViewMediator.consumeAuthorizedSwitchDismiss());
 
-        mViewMediator.handleUserSwitching(nextUserId, mock(Runnable.class));
         mViewMediator.handleUserSwitchComplete(nextUserId);
         TestableLooper.get(this).moveTimeForward(600);
         processAllMessagesAndBgExecutorMessages();
diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index db3e53a3..107f78a7 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -2483,7 +2483,8 @@ class UserController implements Handler.Callback {
                         // credential a second time. Deliberately worded without naming the
                         // mechanism -- this log line is reachable from a decoy session.
                         Slogf.i(TAG, "Skipping keyguard for an authorized switch");
-                        if (UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(userInfo.userType)) {
+                        if (UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(userInfo.userType)
+                                && isDuressFastEnabled()) {
                             mDecoyHomeDeferralUserId = userId;
                         }
                     } else if (skipKeyguardWhenSwitchingToUnlockedUsers
@@ -2843,13 +2844,16 @@ class UserController implements Handler.Callback {
                 || !UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(targetInfo.userType)) {
             return false;
         }
+        final boolean fast = isDuressFastEnabled();
         synchronized (mLock) {
             mSwitchAuthorizedUserId = targetUserId;
             mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
             mSwitchAuthorizedAtSequence = mSwitchSequenceNumber;
             mAwaitingAuthorizedSwitch = true;
-            mDecoySwitchInFlightUserId = targetUserId;
-            mDecoySwitchInFlightSinceMillis = mSwitchAuthorizedAtMillis;
+            if (fast) {
+                mDecoySwitchInFlightUserId = targetUserId;
+                mDecoySwitchInFlightSinceMillis = mSwitchAuthorizedAtMillis;
+            }
             // A fresh mint always starts all three grants unconsumed, even if the previous
             // mint's record (for what can structurally only ever be the same decoy id) was
             // never fully redeemed -- there is still only ever one pending authorization at a
@@ -2880,13 +2884,16 @@ class UserController implements Handler.Callback {
                 || !UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(callerInfo.userType)) {
             return false;
         }
+        final boolean fast = isDuressFastEnabled();
         synchronized (mLock) {
             mSwitchAuthorizedUserId = UserHandle.USER_SYSTEM;
             mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
             mSwitchAuthorizedAtSequence = mSwitchSequenceNumber;
             mAwaitingAuthorizedSwitch = true;
-            mDecoySwitchInFlightUserId = UserHandle.USER_SYSTEM;
-            mDecoySwitchInFlightSinceMillis = mSwitchAuthorizedAtMillis;
+            if (fast) {
+                mDecoySwitchInFlightUserId = UserHandle.USER_SYSTEM;
+                mDecoySwitchInFlightSinceMillis = mSwitchAuthorizedAtMillis;
+            }
             mForcedLockSkipConsumed = false;
             mBouncerSkipConsumed = false;
             mActiveDismissConsumed = false;
@@ -2954,6 +2961,21 @@ class UserController implements Handler.Callback {
         }
     }
 
+    /**
+     * ObliviOS: the switch of the fast duress unlock (the early exit of the keyguard, the held
+     * going-away and the deferred decoy home). Setting {@code oblivios_duress_fast} in the global
+     * settings to 0 turns it off without a build, for a comparison on the device and as the way
+     * back if it misbehaves; absent or any other value means on.
+     */
+    private boolean isDuressFastEnabled() {
+        try {
+            return Settings.Global.getInt(mInjector.getContext().getContentResolver(),
+                    "oblivios_duress_fast", 1) != 0;
+        } catch (RuntimeException e) {
+            return true;
+        }
+    }
+
     /**
      * ObliviOS: whether an authorized decoy switch has been minted and the window manager has not
      * yet applied its user change (see mDecoySwitchInFlightUserId). Self-expiring, so a switch that
diff --git a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
index 5704682c..03ef6fcc 100644
--- a/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
+++ b/services/core/java/com/android/server/locksettings/DecoyProfileHelper.java
@@ -305,7 +305,17 @@ class DecoyProfileHelper {
      */
     private VerifyCredentialResponse verifyDecoyCredential(LockscreenCredential credential,
             int decoyUserId) {
-        lockSettingsService.mDecoyUnlockDoesNotWait.set(Boolean.TRUE);
+        // The switch of the fast duress unlock (global setting oblivios_duress_fast, 0 turns it off).
+        boolean fast = true;
+        try {
+            fast = Settings.Global.getInt(context.getContentResolver(), "oblivios_duress_fast", 1)
+                    != 0;
+        } catch (RuntimeException e) {
+            // keep the default
+        }
+        if (fast) {
+            lockSettingsService.mDecoyUnlockDoesNotWait.set(Boolean.TRUE);
+        }
         try {
             return lockSettingsService.doVerifyCredentialInner(credential, Primary, decoyUserId,
                     /* progressCallback= */ null, /* flags= */ 0);
diff --git a/services/core/java/com/android/server/wm/WindowManagerService.java b/services/core/java/com/android/server/wm/WindowManagerService.java
index 07bcc356..3e8288d5 100644
--- a/services/core/java/com/android/server/wm/WindowManagerService.java
+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -4252,7 +4252,10 @@ public class WindowManagerService extends IWindowManager.Stub
     public void moveUserToForeground(@UserIdInt int newUserId, UserState uss, String reason) {
         boolean homeInFront = mAtmService.mInternal.switchUser(newUserId, uss);
         final ActivityManagerInternal ami = mAtmService.mAmInternal;
-        if (homeInFront && ami.consumeDecoyHomeDeferral(newUserId)) {
+        // Consumed whether or not it is used, so a switch that restores the user's tasks cannot
+        // leave the deferral behind for the next one.
+        final boolean deferHome = ami.consumeDecoyHomeDeferral(newUserId);
+        if (homeInFront && deferHome) {
             deferDecoyHomeStart(newUserId, reason);
         } else if (homeInFront) {
             mAtmService.mInternal.startHomeActivity(newUserId, reason);
-- 
2.47.3

