From: beau4201 <beau.ten.berge@gmail.com>
Date: Sat, 14 Nov 2026 22:26:54 +0100
Subject: [PATCH 37/45] oblivios: keep the wallpaper on screen behind the exit
 of an authorized switch with an empty stage window

---
 .../keyguard/AuthorizedSwitchStage.java       | 87 +++++++++++++++++++
 .../keyguard/KeyguardViewMediator.java        | 12 +++
 2 files changed, 99 insertions(+)
 create mode 100644 packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
new file mode 100644
index 00000000..3c018d55
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/AuthorizedSwitchStage.java
@@ -0,0 +1,87 @@
+package com.android.systemui.keyguard;
+
+import android.content.Context;
+import android.graphics.PixelFormat;
+import android.os.Handler;
+import android.util.Log;
+import android.view.View;
+import android.view.WindowManager;
+
+/**
+ * ObliviOS: the stage of an authorized switch (the Duress decoy, in either direction): one empty
+ * window that asks for the wallpaper, so that the wallpaper layer stays on screen behind the
+ * keyguard's exit while the incoming user's home has not drawn yet.
+ *
+ * <p>The window manager shows the wallpaper layer only while a window wants it. In an ordinary
+ * unlock the home screen is that window. At a switch the incoming user's home is a cold launcher
+ * that draws 0.7 s after it starts, after the exit has ended, so nothing wanted the wallpaper and
+ * the exit ran over a black screen (lynx 2026-11-14: {@code wm_wallpaper_surface [0,0,null]}).
+ * With this window the exit animates the real wallpaper as it does for an ordinary unlock (the
+ * background dims, the pad flies up, the colour returns), and the home draws over it when it is
+ * ready. The window draws nothing, so it is also the wrong place for a tell: nothing in it can
+ * differ from an ordinary unlock.
+ *
+ * <p>It sits at the layer of the status bar sub panel, above the notification shade, so the
+ * keyguard policy does not hide it while the keyguard is showing ({@code WindowState#
+ * canBeHiddenByKeyguard}), and is shown to every user. It is removed after {@link #HOLD_MS}.
+ *
+ * <p>shortcut: removed by a timer, not by the first draw of the incoming home; the window is empty
+ * and not touchable, so staying a little too long shows nothing. Replace the timer by a signal of
+ * the window manager if a window that stays for 3 s ever matters.
+ */
+public final class AuthorizedSwitchStage {
+    private static final String TAG = "AuthorizedSwitchStage";
+    static final long HOLD_MS = 3_000L;
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final Runnable mRemove = this::hide;
+    private View mView;
+
+    public AuthorizedSwitchStage(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+    }
+
+    /** Adds the window, or keeps it a while longer when it is already there. Main thread. */
+    public void show() {
+        mHandler.removeCallbacks(mRemove);
+        if (mView == null) {
+            final View view = new View(mContext);
+            final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.TYPE_STATUS_BAR_SUB_PANEL,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                            | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                            | WindowManager.LayoutParams.FLAG_SHOW_WALLPAPER
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+                    PixelFormat.TRANSLUCENT);
+            lp.privateFlags |= WindowManager.LayoutParams.SYSTEM_FLAG_SHOW_FOR_ALL_USERS;
+            lp.setTitle("SwitchStage");
+            try {
+                mContext.getSystemService(WindowManager.class).addView(view, lp);
+                mView = view;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Could not add the stage window", e);
+                return;
+            }
+        }
+        mHandler.postDelayed(mRemove, HOLD_MS);
+    }
+
+    /** Removes the window. Main thread. */
+    public void hide() {
+        mHandler.removeCallbacks(mRemove);
+        if (mView == null) {
+            return;
+        }
+        try {
+            mContext.getSystemService(WindowManager.class).removeViewImmediate(mView);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Could not remove the stage window", e);
+        }
+        mView = null;
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 167cdf3a..aa4fc0cb 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -530,6 +530,9 @@ public class KeyguardViewMediator implements CoreStartable,
      */
     private boolean mAuthorizedSwitchDismissRequested;
 
+    /** ObliviOS: the wallpaper stage of an authorized switch; created on first use, main thread. */
+    private AuthorizedSwitchStage mSwitchStage;
+
     // last known state of the cellular connection
     private final String mPhoneState = TelephonyManager.EXTRA_STATE_IDLE;
 
@@ -742,6 +745,15 @@ public class KeyguardViewMediator implements CoreStartable,
                     && mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(userId);
             mAuthorizedSwitchDismissRequested = false;
             AuthorizedSwitchExit.setActive(false);
+            if (mAuthorizedSwitchDismissPending && Settings.Global.getInt(
+                    mContext.getContentResolver(), "oblivios_duress_fast", 1) != 0) {
+                // ObliviOS: the stage keeps the wallpaper on screen behind the exit of this switch
+                // (see AuthorizedSwitchStage). Posted, so the window is added off this lock.
+                if (mSwitchStage == null) {
+                    mSwitchStage = new AuthorizedSwitchStage(mContext, mHandler);
+                }
+                mHandler.post(mSwitchStage::show);
+            }
             mHandler.removeMessages(START_KEYGUARD_EXIT_ANIM);
             mHandler.removeMessages(DISMISS);
             mHandler.removeMessages(HIDE);
