From 54e391ba3bf99d1ab811e401cd939e6de8133c88 Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 30 Aug 2026 19:37:05 +0200
Subject: [PATCH 28/89] aegisos: fix uninstall dialogs' single-user check to
 use getUsersForUiDisplay

Three call sites (handheld/UninstallAlertDialogFragment.java,
television/UninstallAlertFragment.java,
v2/model/UninstallRepository.kt) each had their own isSingleUser()
helper keyed off the raw UserManager#getUserCount()/userCount, which
picks between single-user and multi-user uninstall confirmation text.
Found during an exhaustive audit of every getUsers()-style call site.

Fixed by using getUsersForUiDisplay(true).size() at all three, which
is getUserCount()'s own semantics (getUsers().size(), here with dying
users excluded) plus AegisOS Duress Unlock decoy-session filtering.
---
 .../handheld/UninstallAlertDialogFragment.java              | 6 +++++-
 .../packageinstaller/television/UninstallAlertFragment.java | 4 +++-
 .../packageinstaller/v2/model/UninstallRepository.kt        | 4 +++-
 3 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/packages/PackageInstaller/src/com/android/packageinstaller/handheld/UninstallAlertDialogFragment.java b/packages/PackageInstaller/src/com/android/packageinstaller/handheld/UninstallAlertDialogFragment.java
index 0e6785794611..28c275d6e6da 100644
--- a/packages/PackageInstaller/src/com/android/packageinstaller/handheld/UninstallAlertDialogFragment.java
+++ b/packages/PackageInstaller/src/com/android/packageinstaller/handheld/UninstallAlertDialogFragment.java
@@ -332,7 +332,11 @@ public class UninstallAlertDialogFragment extends DialogFragment implements
      * calculation.
      */
     private boolean isSingleUser(UserManager userManager) {
-        final int userCount = userManager.getUserCount();
+        // getUsersForUiDisplay(true) is getUserCount()'s own semantics (getUsers().size(),
+        // here with dying users excluded) plus AegisOS Duress Unlock decoy-session filtering,
+        // so this dialog reads "uninstall this app?" rather than "...for all users?" during a
+        // decoy session, matching what a genuine single-user phone would show.
+        final int userCount = userManager.getUsersForUiDisplay(true).size();
         return userCount == 1 || (UserManager.isHeadlessSystemUserMode() && userCount == 2);
     }
 }
diff --git a/packages/PackageInstaller/src/com/android/packageinstaller/television/UninstallAlertFragment.java b/packages/PackageInstaller/src/com/android/packageinstaller/television/UninstallAlertFragment.java
index cc2e3a600a7a..d12ec52968c4 100644
--- a/packages/PackageInstaller/src/com/android/packageinstaller/television/UninstallAlertFragment.java
+++ b/packages/PackageInstaller/src/com/android/packageinstaller/television/UninstallAlertFragment.java
@@ -131,7 +131,9 @@ public class UninstallAlertFragment extends GuidedStepFragment {
      * Returns whether there is only one user on this device.
      */
     private boolean isSingleUser(UserManager userManager) {
-        final int userCount = userManager.getUserCount();
+        // See the sibling handheld/UninstallAlertDialogFragment.java's own isSingleUser() for
+        // why getUsersForUiDisplay(true) replaces getUserCount() here.
+        final int userCount = userManager.getUsersForUiDisplay(true).size();
         return userCount == 1 || (UserManager.isHeadlessSystemUserMode() && userCount == 2);
     }
 }
diff --git a/packages/PackageInstaller/src/com/android/packageinstaller/v2/model/UninstallRepository.kt b/packages/PackageInstaller/src/com/android/packageinstaller/v2/model/UninstallRepository.kt
index aad5071a77fe..9995b8451d54 100644
--- a/packages/PackageInstaller/src/com/android/packageinstaller/v2/model/UninstallRepository.kt
+++ b/packages/PackageInstaller/src/com/android/packageinstaller/v2/model/UninstallRepository.kt
@@ -374,7 +374,9 @@ class UninstallRepository(private val context: Context) {
      * so it's not be considered in the calculation.
      */
     private fun isSingleUserOnDevice(): Boolean {
-        val userCount = userManager!!.userCount
+        // See the sibling handheld/UninstallAlertDialogFragment.java's own isSingleUser() for
+        // why getUsersForUiDisplay(true) replaces the raw userCount property here.
+        val userCount = userManager!!.getUsersForUiDisplay(true).size
         return userCount == 1 || (UserManager.isHeadlessSystemUserMode() && userCount == 2)
     }
 
