From 0dbac84aba38b952ef77906b2d353ad3729d4d84 Mon Sep 17 00:00:00 2001
From: ObliviOS Build <build@localhost>
Date: Tue, 3 Nov 2026 16:05:56 +0100
Subject: [PATCH] oblivios: never offer user switching on a locked device

isUserSwitcherEnabled returned false on a locked device only when a
decoy user existed. A grab lock followed by a switch from the lock
screen to a second user without a secure lock screen made init's
auto-reboot receive on_device_unlocked and stop the 60 second restart
(GRB-017, lynx 2026110203). Drop the decoy condition and the helper
that only served it, so the switcher is hidden on every locked
device, on every surface that already routes through this method.
---
 .../android/server/pm/UserManagerService.java | 24 ++++---------------
 .../server/pm/UserManagerServiceTest.java     | 14 ++++++++---
 2 files changed, 15 insertions(+), 23 deletions(-)

diff --git a/services/core/java/com/android/server/pm/UserManagerService.java b/services/core/java/com/android/server/pm/UserManagerService.java
index 61896ab..0ac68ed 100644
--- a/services/core/java/com/android/server/pm/UserManagerService.java
+++ b/services/core/java/com/android/server/pm/UserManagerService.java
@@ -3457,10 +3457,11 @@ public class UserManagerService extends IUserManager.Stub {
         // surface, including the real owner's own. A coercer holding the locked device is an
         // earlier and more common point in the duress scenario than one holding a decoy session:
         // if the lock screen shows two profiles, the mechanism is defeated before it is invoked.
-        // Gated on a decoy actually existing so a device without one is bit-for-bit stock, and
-        // the owner keeps lock-screen switching if they ever create an ordinary second user.
+        // Not gated on a decoy existing: switching users from a locked screen is never offered,
+        // because a switch to a user without a secure lock screen reports the device unlocked
+        // to init's auto-reboot, which cancels the 60 second restart that a grab lock armed.
         // Display-only: user creation and user switching do not consult this method.
-        if (hasDecoyUser() && isDeviceCurrentlyLocked()) {
+        if (isDeviceCurrentlyLocked()) {
             return false;
         }
 
@@ -3475,23 +3476,6 @@ public class UserManagerService extends IUserManager.Stub {
                 && multiUserSettingOn;
     }
 
-    /**
-     * ObliviOS: true if any non-removing user on this device is of the decoy type. Read from this
-     * service's own user list, so this adds no cross-service dependency.
-     */
-    private boolean hasDecoyUser() {
-        synchronized (mUsersLock) {
-            for (int i = mUsers.size() - 1; i >= 0; i--) {
-                UserInfo ui = mUsers.valueAt(i).info;
-                if (ui != null && !mRemovingUserIds.get(ui.id)
-                        && UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(ui.userType)) {
-                    return true;
-                }
-            }
-        }
-        return false;
-    }
-
     /**
      * ObliviOS: true while the device is locked. Deliberately queried outside mUsersLock -- see
      * this plan's Task 1 findings for the lock-ordering analysis behind that.
diff --git a/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java b/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
index 8658b4e..d0c7a8f 100644
--- a/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
+++ b/services/tests/servicestests/src/com/android/server/pm/UserManagerServiceTest.java
@@ -229,14 +229,14 @@ public class UserManagerServiceTest {
     }
 
     // ObliviOS: pre-unlock concealment (isUserSwitcherEnabled must not advertise a second user
-    // while the device is locked, but only when a decoy actually exists on the device).
+    // while the device is locked, with or without a decoy on the device).
     //
     // These tests force USER_SWITCHER_ENABLED on so the assertions below actually discriminate
     // this code path: on a stock instrumented-test device this setting is otherwise unset, and
     // this build's own config_showUserSwitcherByDefault resolves to false for it, which would
     // make isUserSwitcherEnabled() return false regardless of decoy/lock state -- a test that
     // could pass identically whether or not the concealment code exists proves nothing. Forcing
-    // the setting on establishes a known, deterministic "true" baseline so the decoy+lock gate is
+    // the setting on establishes a known, deterministic "true" baseline so the lock gate is
     // the only thing that can flip the result to false.
     @Test
     public void testIsUserSwitcherEnabled_lockedDeviceWithDecoy_returnsFalse() {
@@ -257,10 +257,18 @@ public class UserManagerServiceTest {
     }
 
     @Test
-    public void testIsUserSwitcherEnabled_lockedDeviceWithoutDecoy_returnsRealValue() {
+    public void testIsUserSwitcherEnabled_lockedDeviceWithoutDecoy_returnsFalse() {
         forceUserSwitcherSettingEnabled();
         setKeyguardLocked(true);
 
+        assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isFalse();
+    }
+
+    @Test
+    public void testIsUserSwitcherEnabled_unlockedDeviceWithoutDecoy_returnsRealValue() {
+        forceUserSwitcherSettingEnabled();
+        setKeyguardLocked(false);
+
         assertThat(mUserManagerService.isUserSwitcherEnabled(UserHandle.USER_SYSTEM)).isTrue();
     }
 
