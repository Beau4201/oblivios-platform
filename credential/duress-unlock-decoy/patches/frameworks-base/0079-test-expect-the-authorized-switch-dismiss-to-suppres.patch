From c6ea366fd8943e50ba657131e40a6ae1f200c4b0 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Wed, 16 Sep 2026 21:15:35 +0200
Subject: [PATCH 81/89] test: expect the authorized-switch dismiss to suppress
 the unlock animation

The authorized branch of handleUserSwitchComplete proactively dismisses
the keyguard so the switch lands without waiting on a user gesture. But
the keyguard has been showing continuously across the switch -- hiding it
any earlier would expose the outgoing user's own screen, since
switchToUserSilently suppresses the UserSwitchingDialog and nothing else
covers the transition -- so that dismissal animates it away, which
renders on screen as the lock screen swiping itself up. An ordinary
same-user unlock never shows that, making it a tell in exactly the
situation this feature exists for.

Asserts the authorized dismissal requests keyguardGoingAway with
KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS, and that an ordinary
secure-user switch still keeps the stock animation -- the ADR-061
regression property, mirrored for this change.
---
 .../keyguard/KeyguardViewMediatorTest.java    | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
index 0e4d5476ab99..cbc66df27a4e 100644
--- a/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
+++ b/packages/SystemUI/tests/src/com/android/systemui/keyguard/KeyguardViewMediatorTest.java
@@ -17,6 +17,7 @@
 package com.android.systemui.keyguard;
 
 import static android.provider.Settings.Secure.LOCK_SCREEN_LOCK_AFTER_TIMEOUT;
+import static android.view.WindowManagerPolicyConstants.KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS;
 import static android.view.WindowManagerPolicyConstants.OFF_BECAUSE_OF_TIMEOUT;
 import static android.view.WindowManagerPolicyConstants.OFF_BECAUSE_OF_USER;
 
@@ -615,6 +616,73 @@ public class KeyguardViewMediatorTest extends SysuiTestCase {
         verify(mStatusBarKeyguardViewManager).dismissAndCollapse();
     }
 
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testAuthorizedSwitchDismissSuppressesUnlockWindowAnimation()
+            throws RemoteException {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        // Setup keyguard
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(true);
+
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        processAllMessagesAndBgExecutorMessages();
+
+        // SovereignOS: the keyguard has been showing continuously across the switch -- hiding it any
+        // earlier would expose the outgoing user's own screen, since switchToUserSilently
+        // suppresses the UserSwitchingDialog and nothing else covers the transition. Animating it
+        // away at this point therefore renders as the lock screen swiping itself up, which an
+        // ordinary same-user unlock never does and which is a tell in exactly the situation this
+        // feature exists for. The authorized dismissal must cut instead.
+        reset(mActivityTaskManagerService);
+        mViewMediator.hideLocked();
+        processAllMessagesAndBgExecutorMessages();
+
+        ArgumentCaptor<Integer> flagsCaptor = ArgumentCaptor.forClass(Integer.class);
+        verify(mActivityTaskManagerService).keyguardGoingAway(flagsCaptor.capture());
+        assertEquals(KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS,
+                flagsCaptor.getValue() & KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS);
+    }
+
+    @Test
+    @TestableLooper.RunWithLooper(setAsMainLooper = true)
+    public void testUnauthorizedSwitchDismissKeepsUnlockWindowAnimation()
+            throws RemoteException {
+        setCurrentUser(/* userId= */1099, /* isSecure= */true);
+
+        // Setup keyguard
+        mViewMediator.onSystemReady();
+        processAllMessagesAndBgExecutorMessages();
+        mViewMediator.setShowingLocked(true, "");
+
+        // The ADR-061 regression property at this layer, mirrored for the animation change:
+        // an ordinary secure-user switch, for which no authorization was ever minted, must keep
+        // the stock unlock window animation. Suppression is reachable only from the authorized
+        // branch.
+        int nextUserId = 500;
+        setCurrentUser(nextUserId, /* isSecure= */true);
+        when(mLockPatternUtils.consumeDecoySwitchAuthorizationForBouncerSkip(nextUserId))
+                .thenReturn(false);
+
+        mViewMediator.handleUserSwitchComplete(nextUserId);
+        processAllMessagesAndBgExecutorMessages();
+
+        reset(mActivityTaskManagerService);
+        mViewMediator.hideLocked();
+        processAllMessagesAndBgExecutorMessages();
+
+        ArgumentCaptor<Integer> flagsCaptor = ArgumentCaptor.forClass(Integer.class);
+        verify(mActivityTaskManagerService).keyguardGoingAway(flagsCaptor.capture());
+        assertEquals(0, flagsCaptor.getValue() & KEYGUARD_GOING_AWAY_FLAG_NO_WINDOW_ANIMATIONS);
+    }
+
