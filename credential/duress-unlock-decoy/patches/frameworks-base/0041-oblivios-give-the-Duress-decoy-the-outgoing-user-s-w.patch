From 8626e61e34cd9679157d0ba6510ccbe17a579c77 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 03:45:56 +0100
Subject: [PATCH 41/45] oblivios: give the Duress decoy the outgoing user's
 wallpaper colours until its own arrive, so its theme follows the wallpaper

---
 .../theme/ThemeOverlayController.java         | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java b/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java
index 92b5d4df..34e001d2 100644
--- a/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java
+++ b/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java
@@ -134,6 +134,8 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
 
     private final ThemeOverlayApplier mThemeManager;
     private final UserManager mUserManager;
+    /** ObliviOS: the user before the last switch; see the user tracker callback. Main thread. */
+    private int mPreviousUserId = UserHandle.USER_NULL;
     private final BroadcastDispatcher mBroadcastDispatcher;
     private final Executor mBgExecutor;
     private final SecureSettings mSecureSettings;
@@ -260,6 +262,23 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
                 return;
             }
 
+            // ObliviOS: the colours of the Duress decoy's wallpaper never arrive here. The window
+            // manager's wallpaper service keeps them from the copied wallpaper_info.xml, so the
+            // engine's report equals what it has and is not sent on, and the colours are only read
+            // by the callback above when they change. Without them the decoy's theme is built from
+            // no colours (the default blue) where the owner's is built from the wallpaper (lynx
+            // 2026-11-15, the owner's report). The decoy shows the owner's wallpaper (copied by the
+            // lock settings), so the outgoing user's colours are the right ones until its own
+            // arrive. Only for a decoy-type user, and only while it has none.
+            if (mCurrentColors.get(newUser) == null) {
+                final UserInfo incoming = mUserManager.getUserInfo(newUser);
+                final WallpaperColors outgoing = mCurrentColors.get(mPreviousUserId);
+                if (incoming != null && outgoing != null
+                        && UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(incoming.userType)) {
+                    mCurrentColors.put(newUser, outgoing);
+                }
+            }
+            mPreviousUserId = newUser;
             if (DEBUG) Log.d(TAG, "Updating overlays for user switch / profile added.");
             reevaluateSystemTheme(true /* forceReload */);
         }
@@ -529,6 +548,7 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
             return;
         }
 
+        mPreviousUserId = mUserTracker.getUserId();
         mUserTracker.addCallback(mUserTrackerCallback, mMainExecutor);
         mDeviceProvisionedController.addCallback(mDeviceProvisionedListener);
 
-- 
