From c72089461e7bfaa2ad43eacf6862036a2d402630 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Thu, 12 Nov 2026 17:09:38 +0100
Subject: [PATCH] oblivios: copy only plain built-in tile names to the decoy

Review finding on the tile filter: a prefix check on custom( lets entries through by spelling (leading space, capitals, intent( forms, component names). The tile list is now filtered by an allowlist, trimmed entries that are plain lower-case names only.
---
 .../locksettings/DecoySettingsMirror.java     | 17 ++++++++++----
 .../locksettings/DecoySettingsMirrorTest.java | 23 ++++++++++++++-----
 2 files changed, 29 insertions(+), 11 deletions(-)

diff --git a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
index 57401177..14930400 100644
--- a/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
+++ b/services/core/java/com/android/server/locksettings/DecoySettingsMirror.java
@@ -2,6 +2,7 @@ package com.android.server.locksettings;
 
 import java.util.ArrayList;
 import java.util.List;
+import java.util.regex.Pattern;
 
 /**
  * ObliviOS: copies the owner's display and lock-screen settings to the Duress decoy user, one way,
@@ -15,6 +16,8 @@ import java.util.List;
  * calls this cannot fail on it.
  */
 final class DecoySettingsMirror {
+    private static final Pattern BUILT_IN_TILE = Pattern.compile("[a-z0-9_]+");
+
     static final String SYSTEM = "system";
     static final String SECURE = "secure";
 
@@ -61,17 +64,21 @@ final class DecoySettingsMirror {
     }
 
     /**
-     * What may be copied of a value, or null to skip the key. A quick-settings tile list holds
-     * "custom(package/service)" entries that name apps of the owner, so only the built-in tiles
-     * are copied: the decoy must never learn which apps the owner has installed.
+     * What may be copied of a value, or null to skip the key. A quick-settings tile list can hold
+     * entries that name apps of the owner, so only built-in tile names are copied: the decoy must
+     * never learn which apps the owner has installed.
      */
     private static String filter(String key, String value) {
         if (value == null || !"sysui_qs_tiles".equals(key)) {
             return value;
         }
         StringBuilder kept = new StringBuilder();
-        for (String tile : value.split(",")) {
-            if (!tile.isEmpty() && !tile.startsWith("custom(")) {
+        for (String entry : value.split(",")) {
+            // Allowlist, not a prefix check: a built-in tile is a plain lower-case name. Anything
+            // with a parenthesis, slash or dot (custom(...), intent(...), a component name) can name
+            // an app of the owner, whatever its spelling.
+            String tile = entry.trim();
+            if (BUILT_IN_TILE.matcher(tile).matches()) {
                 if (kept.length() > 0) {
                     kept.append(',');
                 }
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
index 758b8aa0..b7ecd1b4 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -48,10 +48,10 @@ public class DecoySettingsMirrorTest {
     private static FakeStore ownerWithEveryKey() {
         FakeStore s = new FakeStore();
         for (String k : DecoySettingsMirror.SYSTEM_KEYS) {
-            s.set(DecoySettingsMirror.SYSTEM, k, OWNER, "owner-" + k);
+            s.set(DecoySettingsMirror.SYSTEM, k, OWNER, "owner_" + k);
         }
         for (String k : DecoySettingsMirror.SECURE_KEYS) {
-            s.set(DecoySettingsMirror.SECURE, k, OWNER, "owner-" + k);
+            s.set(DecoySettingsMirror.SECURE, k, OWNER, "owner_" + k);
         }
         return s;
     }
@@ -62,10 +62,10 @@ public class DecoySettingsMirrorTest {
         List<String> failed = DecoySettingsMirror.mirror(s, OWNER, DECOY);
         assertTrue(failed.isEmpty());
         for (String k : DecoySettingsMirror.SYSTEM_KEYS) {
-            assertEquals("owner-" + k, s.get(DecoySettingsMirror.SYSTEM, k, DECOY));
+            assertEquals("owner_" + k, s.get(DecoySettingsMirror.SYSTEM, k, DECOY));
         }
         for (String k : DecoySettingsMirror.SECURE_KEYS) {
-            assertEquals("owner-" + k, s.get(DecoySettingsMirror.SECURE, k, DECOY));
+            assertEquals("owner_" + k, s.get(DecoySettingsMirror.SECURE, k, DECOY));
         }
     }
 
@@ -102,9 +102,9 @@ public class DecoySettingsMirrorTest {
         s.failingKey = "screen_brightness";
         List<String> failed = DecoySettingsMirror.mirror(s, OWNER, DECOY);
         assertEquals(java.util.Collections.singletonList("screen_brightness"), failed);
-        assertEquals("owner-screen_off_timeout",
+        assertEquals("owner_screen_off_timeout",
                 s.get(DecoySettingsMirror.SYSTEM, "screen_off_timeout", DECOY));
-        assertEquals("owner-sysui_qs_tiles",
+        assertEquals("owner_sysui_qs_tiles",
                 s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
         assertNull(s.get(DecoySettingsMirror.SYSTEM, "screen_brightness", DECOY));
     }
@@ -137,6 +137,17 @@ public class DecoySettingsMirrorTest {
         assertEquals("decoy-own", s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
     }
 
+    @Test
+    public void onlyPlainBuiltInTileNamesAreCopiedWhateverTheSpelling() {
+        // Spaces, capitals and other spec forms must not get an owner's app through a prefix check.
+        FakeStore s = ownerWithEveryKey();
+        s.set(DecoySettingsMirror.SECURE, "sysui_qs_tiles", OWNER,
+                "wifi, Custom(com.owner.private/.Tile),CUSTOM(org.x/.Y), custom(a/.B),"
+                        + "intent(com.owner.private),bt, cell ,com.owner.private/.Tile");
+        DecoySettingsMirror.mirror(s, OWNER, DECOY);
+        assertEquals("wifi,bt,cell", s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
+    }
+
     @Test
     public void sameUserWritesNothing() {
         FakeStore s = ownerWithEveryKey();
-- 
