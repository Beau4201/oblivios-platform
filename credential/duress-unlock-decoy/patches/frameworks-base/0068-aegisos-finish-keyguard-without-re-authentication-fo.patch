From 7e17d9a1999d808959d17334e4e912a068cd0fbc Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Thu, 10 Sep 2026 15:10:53 +0200
Subject: [PATCH 70/89] aegisos: finish keyguard without re-authentication for
 an authorized decoy switch

showNextSecurityScreenOrFinish's pre-check (dismiss(int), called before
any bouncer is rendered) now also finishes for a user whose credential
was genuinely verified moments ago by a caller holding a still-valid,
not-yet-consumed active-dismiss authorization for exactly that user.
This sits alongside the existing trust/biometric branches in the same
decision chain and is subject to the same downstream SIM PIN and
secure-lock-device checks; it substitutes only for the authenticated
flag, never for those. This closes the residual gap left after the
bouncer-skip fix: the decoy's own freshly-bound keyguard session no
longer demands a second credential entry on the user's first swipe.

GREEN: the pre-check now consumes the third grant.
---
 .../KeyguardSecurityContainerController.java      | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityContainerController.java b/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityContainerController.java
index 74faef905c0f..eed64b9d19e4 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityContainerController.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityContainerController.java
@@ -994,6 +994,21 @@ public class KeyguardSecurityContainerController extends ViewController<Keyguard
             finish = true;
             eventSubtype = BOUNCER_DISMISS_BIOMETRIC;
             uiEvent = BouncerUiEvent.BOUNCER_DISMISS_BIOMETRIC;
+        } else if (!authenticated
+                && mLockPatternUtils.consumeDecoySwitchAuthorizationForActiveDismiss(
+                        targetUserId)) {
+            // AegisOS: this is a pre-check made before any bouncer has been shown to this user
+            // (authenticated is only ever true here after a real credential was typed into an
+            // already-showing bouncer, which cannot happen for the same request this pre-check
+            // is answering), and it only ever returns true for a user whose own credential was
+            // genuinely verified moments ago by a caller holding a still-valid, not-yet-consumed
+            // authorization for exactly this purpose -- see
+            // UserController#consumeDecoySwitchAuthorizationForActiveDismiss. Every other
+            // pre-check (including any this authorization was never minted for) is unaffected
+            // and still requires a real credential exactly as before. Deliberately does not set
+            // eventSubtype/uiEvent -- unlike the branches above, this one is reachable from a
+            // decoy session and should not create a new, mechanism-identifying metric.
+            finish = true;
         } else if (SecurityMode.None == getCurrentSecurityMode()) {
             SecurityMode securityMode = mSecurityModel.getSecurityMode(targetUserId);
             if (SecurityMode.None == securityMode) {
