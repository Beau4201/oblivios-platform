From 3937168868531f6d9cc0cdc303883b124ee49da3 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Mon, 7 Sep 2026 19:33:50 +0200
Subject: [PATCH 46/89] sovereignos: implement the decoy switch authorization store

---
 .../com/android/server/am/UserController.java | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/services/core/java/com/android/server/am/UserController.java b/services/core/java/com/android/server/am/UserController.java
index da4bb2c5e82d..f65ace17bb52 100644
--- a/services/core/java/com/android/server/am/UserController.java
+++ b/services/core/java/com/android/server/am/UserController.java
@@ -496,6 +496,25 @@ class UserController implements Handler.Callback {
     @GuardedBy("mLock")
     private final ArraySet<Integer> mDoNotAbortShutdownUserIds = new ArraySet<>();
 
+    /**
+     * SovereignOS: how long a minted switch authorization stays honourable. Generous enough for a
+     * slow cold user start, short enough that a stale one is never load-bearing.
+     */
+    static final long DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS = 30_000L;
+
+    /**
+     * SovereignOS: one-shot authorization to skip the forced keyguard lock for exactly one foreground
+     * switch, minted only where a credential for the target user has genuinely just been
+     * verified. Deliberately not AOSP's generic isCeStorageUnlocked/isTrustAllowedForUser
+     * condition, which is reachable from any caller of switchUser and was found to be a
+     * device-wide keyguard bypass -- see ADR-061 in the sovereignos-foundation repository.
+     */
+    @GuardedBy("mLock")
+    private int mSwitchAuthorizedUserId = UserHandle.USER_NULL;
+
+    @GuardedBy("mLock")
+    private long mSwitchAuthorizedAtMillis;
+
     private final UserLifecycleListener mUserLifecycleListener = new UserLifecycleListener() {
         @Override
         public void onUserCreated(UserInfo user, Object token) {
@@ -2654,6 +2673,47 @@ class UserController implements Handler.Callback {
         return true;
     }
 
+    /**
+     * SovereignOS: mints the one-shot authorization described on mSwitchAuthorizedUserId. Rejects any
+     * target that is not an existing decoy-type user: every identity-concealment fix in this
+     * feature keys off UserInfo.userType, so a wrong-typed target would switch correctly while
+     * silently receiving none of them (ADR-064 found exactly that class of gap).
+     *
+     * @return true if an authorization was minted.
+     */
+    boolean authorizeDecoySwitchKeyguardSkip(int targetUserId) {
+        UserManagerInternal umi = mInjector.getUserManagerInternal();
+        UserInfo targetInfo = umi == null ? null : umi.getUserInfo(targetUserId);
+        if (targetInfo == null
+                || !UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(targetInfo.userType)) {
+            return false;
+        }
+        synchronized (mLock) {
+            mSwitchAuthorizedUserId = targetUserId;
+            mSwitchAuthorizedAtMillis = mInjector.elapsedRealtime();
+        }
+        return true;
+    }
+
+    /**
+     * SovereignOS: consumes an authorization for userId. An authorization matching userId is always
+     * cleared, whether or not it was still valid, so an expired one can never be reused. An
+     * authorization for a different user is left intact.
+     */
+    @VisibleForTesting
+    boolean consumeDecoySwitchAuthorization(int userId) {
+        synchronized (mLock) {
+            if (mSwitchAuthorizedUserId == UserHandle.USER_NULL
+                    || mSwitchAuthorizedUserId != userId) {
+                return false;
+            }
+            final long ageMillis = mInjector.elapsedRealtime() - mSwitchAuthorizedAtMillis;
+            mSwitchAuthorizedUserId = UserHandle.USER_NULL;
+            mSwitchAuthorizedAtMillis = 0L;
+            return ageMillis >= 0 && ageMillis <= DECOY_SWITCH_AUTHORIZATION_TIMEOUT_MS;
+        }
+    }
+
     private void sendStartUserSwitchFgMessage(int targetUserId) {
         mHandler.removeMessages(START_USER_SWITCH_FG_MSG);
         mHandler.sendMessage(mHandler.obtainMessage(START_USER_SWITCH_FG_MSG, targetUserId, 0));
