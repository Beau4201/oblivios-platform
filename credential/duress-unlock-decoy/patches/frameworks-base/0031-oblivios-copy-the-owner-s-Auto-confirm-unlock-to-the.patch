--- a/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/DecoySettingsMirrorTest.java
@@ -198,6 +198,22 @@ public class DecoySettingsMirrorTest {
         assertEquals("wifi,bt,cell", s.get(DecoySettingsMirror.SECURE, "sysui_qs_tiles", DECOY));
     }
 
+    @Test
+    public void autoConfirmIsSwitchedOnOnlyForADecoyPinOfTheSameKnownLength() {
+        assertEquals(Boolean.TRUE, DecoySettingsMirror.autoConfirmTarget(true, false, 6, 6));
+        // The keyguard submits at the owner's length: another decoy length could never be submitted.
+        assertNull(DecoySettingsMirror.autoConfirmTarget(true, false, 6, 8));
+        assertNull(DecoySettingsMirror.autoConfirmTarget(true, false, -1, -1));
+        assertNull(DecoySettingsMirror.autoConfirmTarget(true, false, 6, -1));
+    }
+
+    @Test
+    public void autoConfirmFollowsTheOwnerWhenSwitchedOffAndStaysWhenEqual() {
+        assertEquals(Boolean.FALSE, DecoySettingsMirror.autoConfirmTarget(false, true, 6, 8));
+        assertNull(DecoySettingsMirror.autoConfirmTarget(false, false, 6, 6));
+        assertNull(DecoySettingsMirror.autoConfirmTarget(true, true, 6, 6));
+    }
+
