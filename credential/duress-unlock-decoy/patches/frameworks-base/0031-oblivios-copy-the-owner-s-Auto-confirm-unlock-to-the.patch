+    /**
+     * ObliviOS: the owner's Auto confirm unlock is copied to the decoy when the device locks. It is a
+     * per-user lock setting, so the decoy's lock screen asked for Enter where the owner's submits at the
+     * PIN length, which a second person sees. It is copied only when both PINs have the same known
+     * length: the keyguard submits at the owner's length, so a decoy PIN of another length could never be
+     * submitted whole (the set-up screen refuses that), and then the decoy is left as it was. Switching
+     * it off follows the owner at once. Handler thread only; a refused read or write is only logged.
+     */
+    private void mirrorOwnerAutoConfirmToDecoy(int realUserId, int decoyUserId) {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final String key = LockPatternUtils.AUTO_PIN_CONFIRM;
+            final boolean owner = lockSettingsService.getBoolean(key, false, realUserId);
+            final boolean decoy = lockSettingsService.getBoolean(key, false, decoyUserId);
+            final Boolean target = DecoySettingsMirror.autoConfirmTarget(owner, decoy,
+                    lockSettingsService.getPinLength(realUserId, Primary),
+                    lockSettingsService.getPinLength(decoyUserId, Primary));
+            if (target != null) {
+                lockSettingsService.setBoolean(key, target, decoyUserId);
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not mirror Auto confirm to the routing target", e);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
