+package com.android.server.locksettings;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+public class DecoyWallpaperFilesTest {
+    @Rule public TemporaryFolder tmp = new TemporaryFolder();
+
+    private File owner() throws IOException {
+        return tmp.newFolder("owner");
+    }
+
+    private File decoy() throws IOException {
+        return tmp.newFolder("decoy");
+    }
+
+    private static void write(File dir, String name, String text, long mtime) throws IOException {
+        File f = new File(dir, name);
+        Files.write(f.toPath(), text.getBytes(StandardCharsets.UTF_8));
+        assertTrue(f.setLastModified(mtime));
+    }
+
+    private static String read(File dir, String name) throws IOException {
+        return new String(Files.readAllBytes(new File(dir, name).toPath()), StandardCharsets.UTF_8);
+    }
+
+    @Test
+    public void copiesEveryFileTheOwnerHas() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper_orig", "orig", 1000);
+        write(o, "wallpaper", "crop", 1000);
+        write(o, "wallpaper_info.xml", "info", 1000);
+
+        assertEquals(3, DecoyWallpaperFiles.copy(o, d));
+
+        assertEquals("orig", read(d, "wallpaper_orig"));
+        assertEquals("crop", read(d, "wallpaper"));
+        assertEquals("info", read(d, "wallpaper_info.xml"));
+        assertFalse(new File(d, "wallpaper_lock").exists());
+    }
+
+    @Test
+    public void copiesTheMetadataLast() {
+        String[] names = DecoyWallpaperFiles.NAMES;
+        // A copy cut short must never leave metadata that names an image the decoy does not have.
+        assertEquals("wallpaper_info.xml", names[names.length - 1]);
+    }
+
+    @Test
+    public void skipsFilesThatDidNotChange() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "crop", 1000);
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+
+        assertEquals(0, DecoyWallpaperFiles.copy(o, d));
+    }
+
+    @Test
+    public void copiesAgainWhenTheOwnerChangedTheImage() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "old", 1000);
+        DecoyWallpaperFiles.copy(o, d);
+
+        write(o, "wallpaper", "new", 2000);
+
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+        assertEquals("new", read(d, "wallpaper"));
+    }
+
+    @Test
+    public void copiesAgainWhenOnlyTheSizeDiffers() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "old", 1000);
+        DecoyWallpaperFiles.copy(o, d);
+
+        write(o, "wallpaper", "longer", 1000);
+
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+        assertEquals("longer", read(d, "wallpaper"));
+    }
+
+    @Test
+    public void removesALockWallpaperTheOwnerNoLongerHas() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "crop", 1000);
+        write(o, "wallpaper_lock", "lock", 1000);
+        DecoyWallpaperFiles.copy(o, d);
+        assertTrue(new File(d, "wallpaper_lock").exists());
+
+        assertTrue(new File(o, "wallpaper_lock").delete());
+
+        assertEquals(1, DecoyWallpaperFiles.copy(o, d));
+        assertFalse(new File(d, "wallpaper_lock").exists());
+        assertEquals("crop", read(d, "wallpaper"));
+    }
+
+    @Test
+    public void leavesNoTemporaryFileBehind() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(o, "wallpaper", "crop", 1000);
+
+        DecoyWallpaperFiles.copy(o, d);
+
+        String[] names = d.list();
+        java.util.Arrays.sort(names);
+        assertArrayEquals(new String[] {"wallpaper"}, names);
+    }
+
+    @Test
+    public void leavesTheDecoyAloneWhenTheOwnerHasNoWallpaperFiles() throws IOException {
+        File o = owner();
+        File d = decoy();
+        write(d, "wallpaper", "keep", 1000);
+        write(d, "wallpaper_info.xml", "keep", 1000);
+
+        // Removing the decoy's copies would be a change of the decoy the owner never made: only a
+        // lock wallpaper the owner had and dropped is removed (above), and that needs a copy first.
+        assertEquals(0, DecoyWallpaperFiles.copy(o, d));
+        assertEquals("keep", read(d, "wallpaper"));
+    }
+}
