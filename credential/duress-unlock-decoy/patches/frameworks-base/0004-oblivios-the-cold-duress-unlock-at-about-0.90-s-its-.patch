+    /** The files, the metadata last: a copy cut short never names an image the decoy lacks. */
+    static final String[] NAMES = {
+        "wallpaper_orig", "wallpaper", "wallpaper_lock_orig", "wallpaper_lock", "wallpaper_info.xml"
+    };
+
+    /** The lock screen files exist only while the owner has a separate lock screen wallpaper. */
+    private static final String[] LOCK_NAMES = {"wallpaper_lock_orig", "wallpaper_lock"};
+
+    private DecoyWallpaperFiles() {}
+
+    /**
