@@ -0,0 +1,30 @@
+package com.android.systemui.keyguard;
+
+/**
+ * ObliviOS: whether the keyguard exit now running belongs to an authorized switch (the Duress
+ * decoy, in either direction). It is set when the dismissal of such a switch is requested and
+ * cleared when the next switch starts or the keyguard is shown again.
+ *
+ * <p>Read by the notification alpha of the bouncer-to-gone transitions: for an ordinary unlock the
+ * stack's alpha is raised to 1 when the transition ends, as upstream has it and as this class
+ * leaves it; for an authorized switch the window manager starts the exit later than the 500 ms of
+ * that transition, so the raise would show the stack over an empty stage. The ordinary unlock is
+ * never changed.
+ *
+ * <p>shortcut: a process-wide static flag instead of an injected interactor, because SystemUI has
+ * one keyguard and the two view models would otherwise need a new constructor argument and test
+ * fixtures; replace it when more than this one reader needs the mark.
+ */
+public final class AuthorizedSwitchExit {
+    private static volatile boolean sActive;
+
+    private AuthorizedSwitchExit() {}
+
+    public static void setActive(boolean active) {
+        sActive = active;
+    }
+
+    public static boolean isActive() {
+        return sActive;
+    }
+}
