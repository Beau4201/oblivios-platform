From adbbb7c377a983785166fce7c4c25c5c7ea45c07 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Fri, 28 Aug 2026 22:47:02 +0200
Subject: [PATCH] sovereignos: hide real-user identity from the Multiuser
 widget for the decoy session

Squash of former patches:

- 0001 sovereignos: hide Switch User widget action when nothing else is visible
- 0002 sovereignos: route UsersRepository#getUsers() through getUsersForUiDisplay
- 0003 sovereignos: use owner's default-avatar color for a decoy in the widget
- 0004 sovereignos: hide non-current users from the widget's grid when switcher disabled
---
 .../multiuser/widget/data/ImageRepository.kt    | 15 +++++++++++++--
 .../multiuser/widget/data/UsersRepository.kt    | 17 ++++++++++++++++-
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/Widget/src/main/java/com/android/multiuser/widget/data/ImageRepository.kt b/Widget/src/main/java/com/android/multiuser/widget/data/ImageRepository.kt
index e6f2419..7c9db87 100644
--- a/Widget/src/main/java/com/android/multiuser/widget/data/ImageRepository.kt
+++ b/Widget/src/main/java/com/android/multiuser/widget/data/ImageRepository.kt
@@ -25,8 +25,19 @@ import com.android.multiuser.widget.R
 class ImageRepository(val userManager: UserManager?, val resources: Resources) {
 
 suspend fun getAvatar(userId: Int): Bitmap = userManager?.getUserIcon(userId)
-    ?: UserIcons.getDefaultUserIcon(resources, userId, false)
-        .let { UserIcons.convertToBitmapAtUserIconSize(resources, it) }
+    ?: run {
+        // The default icon's color is picked from a fixed palette by userId, so an SovereignOS
+        // Duress Unlock decoy's own arbitrary real userId would otherwise produce a different
+        // color than what a genuine single, fresh-out-of-box owner (always userId 0) shows.
+        val colorSourceUserId =
+            if (userManager?.isMainForUiDisplay(userId) == true) {
+                android.os.UserHandle.USER_SYSTEM
+            } else {
+                userId
+            }
+        UserIcons.getDefaultUserIcon(resources, colorSourceUserId, false)
+            .let { UserIcons.convertToBitmapAtUserIconSize(resources, it) }
+    }
 
 
     suspend fun getContentDescription(userName: String, isCurrent: Boolean): String {
diff --git a/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt b/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt
index ea61256..77cec4a 100644
--- a/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt
+++ b/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt
@@ -38,9 +38,21 @@ class UsersRepository(private val userManager: UserManager?,
             // This ensures the error layout is shown in the UI.
             return listOf()
         }
-        var userInfoList = userManager.getAliveUsers()
+        // getUsersForUiDisplay(true) is getAliveUsers()'s own semantics plus SovereignOS Duress
+        // Unlock decoy-session filtering, matching this class's own checkUserSwitchRestrictions()
+        // below -- without it, every real user's name/avatar loads into memory here regardless
+        // of who is actually current, relying only on incidental filtering elsewhere in this
+        // widget to avoid rendering it during a decoy session.
+        var userInfoList = userManager.getUsersForUiDisplay(true)
 
+        // Drop every non-current-user entry when the platform switcher itself is disabled --
+        // matching BaseUserSwitcherAdapter.kt's own "(isUserSwitcherEnabled || isCurrent)"
+        // pattern. Without this, the switcher being disabled (e.g. by UserManagerService's
+        // own pre-unlock concealment gate) only hid this widget's tappability, never its
+        // render list: every real user's name/avatar would still be drawn on-screen.
+        val switcherEnabled = userManager.isUserSwitcherEnabled(true)
         return userInfoList
+            .filter { userInfo: UserInfo -> switcherEnabled || userInfo.id == currentUserId }
             .map { userInfo: UserInfo ->
                 User(
                     id = userInfo.id,
@@ -106,6 +118,9 @@ class UsersRepository(private val userManager: UserManager?,
         if (!userManager.isUserSwitcherEnabled(true)) {
             return UserSwitchRestrictions.DISABLED
         }
+        if (userManager.getUsersForUiDisplay(true /* excludeDying */).size <= 1) {
+            return UserSwitchRestrictions.DISABLED
+        }
         return UserSwitchRestrictions.NONE
     }
 
