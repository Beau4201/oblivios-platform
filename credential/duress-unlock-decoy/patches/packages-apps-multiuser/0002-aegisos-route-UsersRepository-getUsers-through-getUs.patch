From 13340a1ba34388f522203198650ddd6e70ab14be Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 30 Aug 2026 19:53:20 +0200
Subject: [PATCH] aegisos: route UsersRepository#getUsers() through
 getUsersForUiDisplay

The Multiuser widget's own data layer called the raw
UserManager#getAliveUsers(), unlike its sibling
checkUserSwitchRestrictions() in the same file (already migrated).
Every real user's name/avatar loaded into memory on every widget
refresh, currently withheld from rendering only by an incidental
filter elsewhere in this widget (CurrentUserStateUseCase.kt) -- access
control by accident, not design. Found during an exhaustive audit of
every getUsers()-style call site.

Fixed by using getUsersForUiDisplay(true), matching the sibling method
in this same class.
---
 .../com/android/multiuser/widget/data/UsersRepository.kt   | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt b/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt
index b57d63e..fcffb2f 100644
--- a/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt
+++ b/Widget/src/main/java/com/android/multiuser/widget/data/UsersRepository.kt
@@ -38,7 +38,12 @@ class UsersRepository(private val userManager: UserManager?,
             // This ensures the error layout is shown in the UI.
             return listOf()
         }
-        var userInfoList = userManager.getAliveUsers()
+        // getUsersForUiDisplay(true) is getAliveUsers()'s own semantics plus AegisOS Duress
+        // Unlock decoy-session filtering, matching this class's own checkUserSwitchRestrictions()
+        // below -- without it, every real user's name/avatar loads into memory here regardless
+        // of who is actually current, relying only on incidental filtering elsewhere in this
+        // widget to avoid rendering it during a decoy session.
+        var userInfoList = userManager.getUsersForUiDisplay(true)
 
         return userInfoList
             .map { userInfo: UserInfo ->
-- 
