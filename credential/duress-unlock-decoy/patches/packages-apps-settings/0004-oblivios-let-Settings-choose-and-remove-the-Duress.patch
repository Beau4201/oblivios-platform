+package com.android.settings.security;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class DuressUnlockFingerFlowTest {
+    private static final class FakeOps implements DuressUnlockFingerFlow.Ops<String> {
+        int[] enrolled = {5, 6};
+        int linked;
+        String wrongCredential;
+        final List<String> calls = new ArrayList<>();
+
+        @Override
+        public int[] enrolledFingerIds() {
+            return enrolled;
+        }
+
+        @Override
+        public int linkedFingerId() {
+            return linked;
+        }
+
+        @Override
+        public void link(String decoyCredential, int fingerId) throws Exception {
+            if (decoyCredential.equals(wrongCredential)) {
+                throw new DuressUnlockFingerFlow.WrongSecondCredentialException();
+            }
+            calls.add("link:" + decoyCredential + ":" + fingerId);
+            linked = fingerId;
+        }
+
+        @Override
+        public void unlink() {
+            calls.add("unlink");
+            linked = 0;
+        }
+    }
+
+    private final FakeOps ops = new FakeOps();
+    private final DuressUnlockFingerFlow<String> flow = new DuressUnlockFingerFlow<>(ops);
+
+    @Test
+    public void canChooseNeedsTwoEnrolledFingers() {
+        ops.enrolled = new int[] {};
+        assertFalse(flow.canChoose());
+        ops.enrolled = new int[] {5};
+        assertFalse(flow.canChoose());
+        ops.enrolled = new int[] {5, 6};
+        assertTrue(flow.canChoose());
+    }
+
+    @Test
+    public void chooseLinksTheChosenFinger() throws Exception {
+        flow.choose("1234", 6);
+        assertEquals(List.of("link:1234:6"), ops.calls);
+    }
+
+    @Test
+    public void chooseWithOneEnrolledFingerThrowsAndLinksNothing() throws Exception {
+        ops.enrolled = new int[] {5};
+        try {
+            flow.choose("1234", 5);
+            fail("a single enrolled finger was accepted");
+        } catch (DuressUnlockFingerFlow.NeedsSecondFingerException expected) {
+            // expected
+        }
+        assertTrue(ops.calls.isEmpty());
+    }
+
+    @Test
+    public void chooseOfAFingerThatIsNotEnrolledThrowsAndLinksNothing() throws Exception {
+        try {
+            flow.choose("1234", 9);
+            fail("a finger that is not enrolled was accepted");
+        } catch (DuressUnlockFingerFlow.NotEnrolledException expected) {
+            // expected
+        }
+        assertTrue(ops.calls.isEmpty());
+    }
+
+    @Test
+    public void aWrongDecoyCredentialPropagatesAndLeavesTheLinkAlone() throws Exception {
+        ops.linked = 5;
+        ops.wrongCredential = "0000";
+        try {
+            flow.choose("0000", 6);
+            fail("a wrong credential was accepted");
+        } catch (DuressUnlockFingerFlow.WrongSecondCredentialException expected) {
+            // expected
+        }
+        assertEquals(5, ops.linked);
+        assertTrue(ops.calls.isEmpty());
+    }
+
+    @Test
+    public void effectiveLinkedFingerIsNoneWhenTheLinkedIdIsNotEnrolled() {
+        ops.linked = 9;
+        assertEquals(DuressUnlockFingerFlow.NO_FINGER, flow.effectiveLinkedFinger());
+        ops.linked = 6;
+        assertEquals(6, flow.effectiveLinkedFinger());
+        ops.linked = 0;
+        assertEquals(DuressUnlockFingerFlow.NO_FINGER, flow.effectiveLinkedFinger());
+    }
+
+    @Test
+    public void relinkAfterCredentialChangeLinksTheNewCredentialToTheSameFinger() throws Exception {
+        ops.linked = 6;
+        flow.relinkAfterCredentialChange("5678");
+        assertEquals(List.of("link:5678:6"), ops.calls);
+    }
+
+    @Test
+    public void relinkWithAStaleLinkUnlinks() throws Exception {
+        ops.linked = 9;
+        flow.relinkAfterCredentialChange("5678");
+        assertEquals(List.of("unlink"), ops.calls);
+    }
+
+    @Test
+    public void relinkWithNoLinkDoesNothing() throws Exception {
+        ops.linked = 0;
+        flow.relinkAfterCredentialChange("5678");
+        assertTrue(ops.calls.isEmpty());
+    }
+
+    @Test
+    public void removeUnlinks() throws Exception {
+        ops.linked = 6;
+        flow.remove();
+        assertEquals(List.of("unlink"), ops.calls);
+    }
+}
