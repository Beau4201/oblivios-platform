diff --git a/src/com/android/settings/security/DuressUnlockFingerActivity.java b/src/com/android/settings/security/DuressUnlockFingerActivity.java
new file mode 100644
index 0000000..05060c1
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockFingerActivity.java
@@ -0,0 +1,255 @@
+package com.android.settings.security;
+
+import android.app.AlertDialog;
+import android.hardware.fingerprint.Fingerprint;
+import android.os.Bundle;
+import android.text.InputType;
+import android.text.TextUtils;
+import android.util.Log;
+import android.view.View;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.settings.R;
+import com.google.android.setupdesign.GlifRecyclerLayout;
+import com.google.android.setupdesign.items.IItem;
+import com.google.android.setupdesign.items.Item;
+import com.google.android.setupdesign.items.ItemGroup;
+import com.google.android.setupdesign.items.RecyclerItemAdapter;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * ObliviOS: choose which enrolled finger opens the Duress Unlock profile. Lists the owner's
+ * fingers; touching one asks for the second PIN or password and links the finger to it. The
+ * rules are in {@link DuressUnlockFingerFlow}. Only the system user can open it, so a Duress
+ * Unlock decoy session cannot. See
+ * docs/superpowers/specs/2026-11-04-duress-unlock-finger-design.md in the
+ * oblivios-foundation repository, section 8.
+ */
+public class DuressUnlockFingerActivity extends DuressPasswordActivity
+        implements RecyclerItemAdapter.OnItemSelectedListener {
+    private static final String TAG = DuressUnlockFingerActivity.class.getSimpleName();
+    static final String EXTRA_USER_CREDENTIAL = "user_credential";
+
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private GlifRecyclerLayout layout;
+    private String noun;
+    private boolean working;
+    private List<Fingerprint> fingers = List.of();
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!getUser().isSystem()) {
+            finish();
+            return;
+        }
+
+        noun = getString(DuressUnlockSetupActivity.nounRes(getOwner()));
+        layout = new GlifRecyclerLayout(this);
+        layout.setIcon(getDrawable(R.drawable.ic_lock));
+        layout.setHeaderText(R.string.duress_unlock_finger_title);
+        adjustDescriptionStyle(layout);
+        setContentView(layout);
+    }
+
+    // Do not cancel on stop while the work runs: the process must not become a cached one.
+    @Override
+    protected boolean hasUserCredential() {
+        return !working;
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        executor.shutdown();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        if (isFinishing()) {
+            return;
+        }
+        refresh();
+    }
+
+    private DuressUnlockFingerOps newOps() {
+        return new DuressUnlockFingerOps(getApplicationContext(), getLockPatternUtils(), getOwner());
+    }
+
+    /** Reads the linked finger off the main thread (it checks the owner credential), then lists. */
+    private void refresh() {
+        final DuressUnlockFingerOps ops = newOps();
+        final List<Fingerprint> enrolled = ops.enrolledFingers();
+        executor.execute(() -> {
+            int linked = DuressUnlockFingerFlow.NO_FINGER;
+            try {
+                linked = new DuressUnlockFingerFlow<>(ops).effectiveLinkedFinger();
+            } catch (RuntimeException e) {
+                Log.e(TAG, "reading the duress finger failed", e);
+            }
+            final int fLinked = linked;
+            runOnUiThread(() -> {
+                if (!isFinishing() && !isDestroyed()) {
+                    showFingers(enrolled, fLinked);
+                }
+            });
+        });
+    }
+
+    private void showFingers(List<Fingerprint> enrolled, int linked) {
+        fingers = enrolled;
+        final boolean canChoose = enrolled.size() >= 2;
+        layout.setDescriptionText(canChoose
+                ? getString(R.string.duress_unlock_finger_description)
+                : getString(R.string.duress_unlock_finger_needs_second));
+        var g = new ItemGroup();
+        if (canChoose) {
+            for (int i = 0; i < enrolled.size(); i++) {
+                final Fingerprint f = enrolled.get(i);
+                var item = new Item();
+                item.setId(i);
+                item.setTitle(fingerName(f, i));
+                item.setIcon(getDrawable(f.getBiometricId() == linked
+                        ? R.drawable.ic_check_24dp : R.drawable.ic_fingerprint_24dp));
+                g.addChild(item);
+            }
+        }
+        var adapter = new RecyclerItemAdapter(g);
+        adapter.setOnItemSelectedListener(this);
+        layout.setAdapter(adapter);
+    }
+
+    private String fingerName(Fingerprint f, int index) {
+        final CharSequence name = f.getName();
+        return TextUtils.isEmpty(name)
+                ? getString(R.string.duress_unlock_finger_unnamed, index + 1) : name.toString();
+    }
+
+    // RecyclerItemAdapter.OnItemSelectedListener
+    @Override
+    public void onItemSelected(IItem iitem) {
+        if (working) {
+            return;
+        }
+        final int index = ((Item) iitem).getId();
+        if (index < 0 || index >= fingers.size()) {
+            return;
+        }
+        askCredential(fingers.get(index).getBiometricId(), false);
+    }
+
+    private void askCredential(int fingerId, boolean wrong) {
+        final boolean asPassword = decoyIsPassword();
+        final EditText input = new EditText(this);
+        input.setImportantForAutofill(View.IMPORTANT_FOR_AUTOFILL_NO);
+        input.setInputType(asPassword
+                ? InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD
+                : InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        input.setHint(getString(R.string.duress_unlock_finger_credential_hint, noun));
+        if (wrong) {
+            input.setError(getString(R.string.duress_unlock_finger_error_wrong, noun));
+        }
+        final int pad = (int) (24 * getResources().getDisplayMetrics().density);
+        final FrameLayout frame = new FrameLayout(this);
+        frame.setPadding(pad, pad / 2, pad, 0);
+        frame.addView(input);
+
+        var d = new AlertDialog.Builder(this);
+        d.setTitle(getString(R.string.duress_unlock_finger_credential_title, noun));
+        d.setView(frame);
+        d.setNegativeButton(R.string.duress_pwd_cancel_button, null);
+        d.setPositiveButton(R.string.duress_unlock_finger_choose_button, (dialog, which) -> {
+            final String text = input.getText().toString();
+            input.getText().clear();
+            save(fingerId, asPassword
+                    ? LockscreenCredential.createPassword(text)
+                    : LockscreenCredential.createPin(text));
+        });
+        d.show();
+    }
+
+    private void save(int fingerId, LockscreenCredential decoyCredential) {
+        working = true;
+        final DuressUnlockFingerOps ops = newOps();
+        executor.execute(() -> {
+            boolean wrong = false;
+            boolean needsSecond = false;
+            Exception failure = null;
+            try {
+                new DuressUnlockFingerFlow<>(ops).choose(decoyCredential, fingerId);
+            } catch (DuressUnlockFingerFlow.WrongSecondCredentialException e) {
+                wrong = true;
+            } catch (DuressUnlockFingerFlow.NeedsSecondFingerException
+                    | DuressUnlockFingerFlow.NotEnrolledException e) {
+                needsSecond = true;
+            } catch (Exception e) {
+                Log.e(TAG, "choosing the duress finger failed", e);
+                failure = e;
+            } finally {
+                decoyCredential.zeroize();
+            }
+            final boolean fWrong = wrong;
+            final boolean fNeedsSecond = needsSecond;
+            final Exception fFailure = failure;
+            runOnUiThread(() -> onWorkDone(fingerId, fWrong, fNeedsSecond, fFailure));
+        });
+    }
+
+    private void onWorkDone(int fingerId, boolean wrong, boolean needsSecond,
+            @Nullable Exception failure) {
+        working = false;
+        if (!wrong && !needsSecond && failure == null) {
+            // The application context: this activity may be gone by now.
+            Toast.makeText(getApplicationContext(), R.string.duress_unlock_finger_chosen,
+                    Toast.LENGTH_LONG).show();
+            if (!isDestroyed()) {
+                finish();
+            }
+            return;
+        }
+        if (isDestroyed() || isFinishing()) {
+            if (failure != null) {
+                Toast.makeText(getApplicationContext(),
+                        getString(R.string.duress_unlock_finger_save_error, failure.toString()),
+                        Toast.LENGTH_LONG).show();
+            }
+            return;
+        }
+        if (wrong) {
+            askCredential(fingerId, true);
+            return;
+        }
+        var d = new AlertDialog.Builder(this);
+        d.setMessage(needsSecond
+                ? getString(R.string.duress_unlock_finger_needs_second)
+                : getString(R.string.duress_unlock_finger_save_error, failure.toString()));
+        d.setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null);
+        d.show();
+        refresh();
+    }
+
+    private boolean decoyIsPassword() {
+        final LockPatternUtils lockPatternUtils = getLockPatternUtils();
+        final int userId = new DuressUnlockOps(getApplicationContext(), lockPatternUtils, getOwner())
+                .findDecoyUserId();
+        return userId != DuressUnlockFlow.NO_USER && lockPatternUtils.getCredentialTypeForUser(userId)
+                == LockPatternUtils.CREDENTIAL_TYPE_PASSWORD;
+    }
+
+    private LockscreenCredential getOwner() {
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        return Objects.requireNonNull(owner, EXTRA_USER_CREDENTIAL);
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockFingerFlow.java b/src/com/android/settings/security/DuressUnlockFingerFlow.java
