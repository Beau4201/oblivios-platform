index 0000000..cd52c94
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockFingerFlow.java
@@ -0,0 +1,110 @@
+package com.android.settings.security;
+
+/**
+ * ObliviOS: the rules for choosing, relinking and removing the Duress Unlock finger, free of
+ * Android types so they can be tested on the JVM. {@code C} is the credential type
+ * (LockscreenCredential in the app). See
+ * docs/superpowers/specs/2026-11-04-duress-unlock-finger-design.md in the
+ * oblivios-foundation repository, sections 4 and 8.
+ */
+final class DuressUnlockFingerFlow<C> {
+    /** The value of {@link Ops#linkedFingerId} when no finger is linked. */
+    static final int NO_FINGER = 0;
+
+    /** Fewer than two fingers are enrolled: the duress finger must differ from the ordinary one. */
+    static final class NeedsSecondFingerException extends Exception {
+        NeedsSecondFingerException() {
+            super("a second enrolled finger is needed");
+        }
+    }
+
+    /** The chosen finger is not among the enrolled fingers. */
+    static final class NotEnrolledException extends Exception {
+        NotEnrolledException() {
+            super("the finger is not enrolled");
+        }
+    }
+
+    /** The second PIN or password given to {@link Ops#link} was wrong. */
+    static final class WrongSecondCredentialException extends Exception {
+        WrongSecondCredentialException() {
+            super("the second credential is wrong");
+        }
+    }
+
+    interface Ops<C> {
+        /** The biometric ids of the enrolled fingers of the owner. */
+        int[] enrolledFingerIds();
+
+        /** The linked finger's id, or {@link #NO_FINGER}. */
+        int linkedFingerId();
+
+        /**
+         * Links the finger to the decoy.
+         *
+         * @throws WrongSecondCredentialException if {@code decoyCredential} does not match
+         */
+        void link(C decoyCredential, int fingerId) throws Exception;
+
+        /** Removes the link; must succeed when nothing is linked. */
+        void unlink() throws Exception;
+    }
+
+    private final Ops<C> ops;
+
+    DuressUnlockFingerFlow(Ops<C> ops) {
+        this.ops = ops;
+    }
+
+    boolean canChoose() {
+        return ops.enrolledFingerIds().length >= 2;
+    }
+
+    /**
+     * The linked finger when it is still enrolled, else {@link #NO_FINGER}. A deleted finger leaves
+     * its id behind; the screen must show no duress finger then.
+     */
+    int effectiveLinkedFinger() {
+        final int linked = ops.linkedFingerId();
+        return linked != NO_FINGER && isEnrolled(linked) ? linked : NO_FINGER;
+    }
+
+    void choose(C decoyCredential, int fingerId) throws Exception {
+        if (!canChoose()) {
+            throw new NeedsSecondFingerException();
+        }
+        if (!isEnrolled(fingerId)) {
+            throw new NotEnrolledException();
+        }
+        ops.link(decoyCredential, fingerId);
+    }
+
+    void remove() throws Exception {
+        ops.unlink();
+    }
+
+    /**
+     * Links the same finger to the changed decoy credential, which makes the stored link current
+     * again. A link whose finger is no longer enrolled is removed instead; with no link nothing
+     * happens.
+     */
+    void relinkAfterCredentialChange(C newCredential) throws Exception {
+        final int finger = effectiveLinkedFinger();
+        if (finger == NO_FINGER) {
+            if (ops.linkedFingerId() != NO_FINGER) {
+                ops.unlink();
+            }
+            return;
+        }
+        ops.link(newCredential, finger);
+    }
+
+    private boolean isEnrolled(int fingerId) {
+        for (int id : ops.enrolledFingerIds()) {
+            if (id == fingerId) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockFingerOps.java b/src/com/android/settings/security/DuressUnlockFingerOps.java
new file mode 100644
index 0000000..ecad94c
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockFingerOps.java
@@ -0,0 +1,64 @@
+package com.android.settings.security;
+
+import android.content.Context;
+import android.hardware.fingerprint.Fingerprint;
+import android.hardware.fingerprint.FingerprintManager;
+import android.os.UserHandle;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+
+import java.util.List;
+
+/**
+ * ObliviOS: the Android side of {@link DuressUnlockFingerFlow}. {@code linkedFingerId},
+ * {@code link} and {@code unlink} check the owner credential in system_server (a key stretch), so
+ * they must run off the main thread.
+ */
+final class DuressUnlockFingerOps implements DuressUnlockFingerFlow.Ops<LockscreenCredential> {
+    private final FingerprintManager fingerprintManager;
+    private final LockPatternUtils lockPatternUtils;
+    private final LockscreenCredential ownerCredential;
+
+    DuressUnlockFingerOps(Context context, LockPatternUtils lockPatternUtils,
+            LockscreenCredential ownerCredential) {
+        this.fingerprintManager = context.getSystemService(FingerprintManager.class);
+        this.lockPatternUtils = lockPatternUtils;
+        this.ownerCredential = ownerCredential;
+    }
+
+    /** The owner's enrolled fingers in the order the system lists them; empty without hardware. */
+    List<Fingerprint> enrolledFingers() {
+        if (fingerprintManager == null || !fingerprintManager.isHardwareDetected()) {
+            return List.of();
+        }
+        final List<Fingerprint> fingers =
+                fingerprintManager.getEnrolledFingerprints(UserHandle.USER_SYSTEM);
+        return fingers == null ? List.of() : fingers;
+    }
+
+    @Override
+    public int[] enrolledFingerIds() {
+        return enrolledFingers().stream().mapToInt(Fingerprint::getBiometricId).toArray();
+    }
+
+    @Override
+    public int linkedFingerId() {
+        return lockPatternUtils.getDecoyFingerId(ownerCredential);
+    }
+
+    @Override
+    public void link(LockscreenCredential decoyCredential, int fingerId)
+            throws DuressUnlockFingerFlow.WrongSecondCredentialException {
+        // The decoy credential is checked against the decoy's own protector in system_server, never
+        // through checkCredential, which would run the wipe hook and decoy routing on it.
+        if (!lockPatternUtils.setDecoyFinger(ownerCredential, decoyCredential, fingerId)) {
+            throw new DuressUnlockFingerFlow.WrongSecondCredentialException();
+        }
+    }
+
+    @Override
+    public void unlink() {
+        lockPatternUtils.clearDecoyFinger(ownerCredential);
+    }
+}
