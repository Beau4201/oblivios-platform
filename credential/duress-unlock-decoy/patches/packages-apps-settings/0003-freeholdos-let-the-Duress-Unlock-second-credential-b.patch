+    /**
+     * True when the decoy's credential is a PIN or a password of another type than the screen lock:
+     * the keyguard then types the lock's type and the decoy never matches.
+     */
+    private boolean decoyTypeDiffers(DuressUnlockOps ops) {
+        final int decoyType = getLockPatternUtils().getCredentialTypeForUser(ops.findDecoyUserId());
+        final int ownerType = userCredential.isPassword()
+                ? LockPatternUtils.CREDENTIAL_TYPE_PASSWORD : LockPatternUtils.CREDENTIAL_TYPE_PIN;
+        return (decoyType == LockPatternUtils.CREDENTIAL_TYPE_PIN
+                || decoyType == LockPatternUtils.CREDENTIAL_TYPE_PASSWORD) && decoyType != ownerType;
+    }
