From 573708d3d513aa7972c674ec49015e12a4d92d3a Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 6 Sep 2026 18:21:28 +0200
Subject: [PATCH] sovereignos: use owner's default-avatar color for a decoy's own
 icon

UserSettings#assignDefaultPhoto() persisted a default avatar bitmap
colored via UserIcons.getDefaultUserIcon(resources, userId, ...), which
picks from a fixed 8-color palette by userId % 8. A decoy's own real
userId is arbitrary, so its persisted default avatar consistently comes
out a different color than what a genuine single, fresh-out-of-box
owner (always userId 0) would show -- observed directly on this
project's own test device as red (owner, userId 0) vs blue (decoy,
userId 10 % 8 == 2), a real, standalone identity tell independent of
anything the getUsersForUiDisplay/isMainForUiDisplay leak-audit work
already covers.

Route the color computation (not the icon's real target userId) through
isMainForUiDisplay so a decoy's own persisted avatar always matches
what the device's actual primary user slot would show.
---
 src/com/android/settings/users/UserSettings.java | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/com/android/settings/users/UserSettings.java b/src/com/android/settings/users/UserSettings.java
index f6cf6a58136..ecf8b35168a 100644
--- a/src/com/android/settings/users/UserSettings.java
+++ b/src/com/android/settings/users/UserSettings.java
@@ -1968,7 +1968,12 @@ public class UserSettings extends SettingsPreferenceFragment
             return false;
         }
         UserManager um = (UserManager) context.getSystemService(Context.USER_SERVICE);
-        Bitmap bitmap = getDefaultUserIconAsBitmap(context.getResources(), userId);
+        // The default icon's color is picked from a fixed palette by userId, so a decoy's own
+        // arbitrary real userId would otherwise always produce a different color than what a
+        // genuine single, fresh-out-of-box owner (always userId 0) shows -- an identity tell
+        // independent of anything getUsersForUiDisplay/isMainForUiDisplay already hide.
+        int colorSourceUserId = um.isMainForUiDisplay(userId) ? UserHandle.USER_SYSTEM : userId;
+        Bitmap bitmap = getDefaultUserIconAsBitmap(context.getResources(), colorSourceUserId);
         um.setUserIcon(userId, bitmap);
 
         return true;
