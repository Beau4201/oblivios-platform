From ba48c74ea6825edd5c01b5738a35b8aeea849e38 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 30 Aug 2026 06:41:47 +0200
Subject: [PATCH] sovereignos: route WifiUtils#isCurrentUserNetworkOwner through
 getUsersForUiDisplay

Task 8's own Component D migration covered Utils#hasMultipleUsers and
WifiConfigController2#mIsMultiUser but missed this call site, despite
the design doc naming it explicitly alongside the other two. Found
during the plan's closing whole-branch review, confirmed against real
source (userCount == getUserCount(), unfiltered) before fixing. Same
getUsersForUiDisplay(false) pattern as the other two sites.
---
 src/com/android/settings/wifi/WifiUtils.java | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/com/android/settings/wifi/WifiUtils.java b/src/com/android/settings/wifi/WifiUtils.java
index ab0b53f..2616b9c 100644
--- a/src/com/android/settings/wifi/WifiUtils.java
+++ b/src/com/android/settings/wifi/WifiUtils.java
@@ -384,7 +384,13 @@ public class WifiUtils extends com.android.settingslib.wifi.WifiUtils {
         }
 
         UserManager userManager = context.getSystemService(UserManager.class);
-        int userCount = userManager.getUserCount();
+        // sovereignos: getUsersForUiDisplay, not getUserCount -- a decoy session must see itself as
+        // the sole user of this network, matching the other Component B/D call sites in this
+        // package (Utils#hasMultipleUsers, WifiConfigController2#mIsMultiUser). Found missing
+        // during this plan's closing whole-branch review: with the unfiltered getUserCount(),
+        // a network created by the real owner before the decoy existed showed as not-owned-by-
+        // -the-current-user in a decoy session, a real ownership-based multi-user tell.
+        int userCount = userManager.getUsersForUiDisplay(false /* excludeDying */).size();
         int currentUserId = Process.myUserHandle().getIdentifier();
         int creatorUserId = config.getCreatorUserId();
 
-- 
2.55.0

