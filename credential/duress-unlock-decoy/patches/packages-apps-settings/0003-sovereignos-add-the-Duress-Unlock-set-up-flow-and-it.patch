From 9e55d98fe458d7969fa5b239e9ced7d09c537acf Mon Sep 17 00:00:00 2001
From: sovereignos <sovereignos@localhost>
Date: Wed, 7 Oct 2026 06:13:02 +0200
Subject: [PATCH] sovereignos: add the Duress Unlock set-up flow and its tests

Orders the set-up, change and remove steps of the decoy without Android
types so it runs on the JVM: create, start without a credential, set the
PIN, stop with delayed locking, register last; a failed set-up unregisters
and removes the user; remove clears the registration before the user.
---
 .../settings/security/DuressUnlockFlow.java   | 110 +++++++++
 .../security/DuressUnlockFlowTest.java        | 224 ++++++++++++++++++
 2 files changed, 334 insertions(+)
 create mode 100644 src/com/android/settings/security/DuressUnlockFlow.java
 create mode 100644 tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java

diff --git a/src/com/android/settings/security/DuressUnlockFlow.java b/src/com/android/settings/security/DuressUnlockFlow.java
new file mode 100644
index 00000000000..ef9fe9b393e
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockFlow.java
@@ -0,0 +1,110 @@
+package com.android.settings.security;
+
+/**
+ * SovereignOS: the order of the Duress Unlock set-up, change and remove operations, free of
+ * Android types so it can be tested on the JVM. {@code C} is the credential type
+ * (LockscreenCredential in the app). See
+ * docs/superpowers/specs/2026-10-07-duress-unlock-settings-ui-design.md in the
+ * sovereignos-foundation repository, section 3.
+ */
+final class DuressUnlockFlow<C> {
+    static final int NO_USER = -1;
+
+    /** The current decoy PIN given to {@link Ops#setDecoyPin} was wrong. */
+    static final class WrongCurrentPinException extends Exception {
+        WrongCurrentPinException() {
+            super("current decoy PIN is wrong");
+        }
+    }
+
+    interface Ops<C> {
+        /** The id of the live decoy-type user, or {@link #NO_USER}. */
+        int findDecoyUserId();
+
+        int createDecoyUser() throws Exception;
+
+        /** Starts the user in the background and returns once its storage is unlocked. */
+        void startDecoyUnlocked(int userId) throws Exception;
+
+        /**
+         * Sets the user's PIN. {@code current} is null while the user has no credential yet.
+         *
+         * @throws WrongCurrentPinException if {@code current} does not match
+         */
+        void setDecoyPin(int userId, C current, C newPin) throws Exception;
+
+        void stopDecoy(int userId) throws Exception;
+
+        void register(int userId) throws Exception;
+
+        /** Clears the registration; must succeed when nothing is registered. */
+        void unregister() throws Exception;
+
+        void removeUser(int userId) throws Exception;
+    }
+
+    private final Ops<C> ops;
+
+    DuressUnlockFlow(Ops<C> ops) {
+        this.ops = ops;
+    }
+
+    boolean hasDecoy() {
+        return ops.findDecoyUserId() != NO_USER;
+    }
+
+    /**
+     * Creates the decoy, gives it {@code pin} and registers it. Registering is the last step; any
+     * failure removes the registration and the user again, so no half set-up state is left.
+     */
+    void setUp(C pin) throws Exception {
+        if (hasDecoy()) {
+            throw new IllegalStateException("a decoy already exists");
+        }
+        final int userId = ops.createDecoyUser();
+        try {
+            ops.startDecoyUnlocked(userId);
+            ops.setDecoyPin(userId, null, pin);
+            ops.stopDecoy(userId);
+            ops.register(userId);
+        } catch (Exception e) {
+            try {
+                ops.unregister();
+            } catch (Exception suppressed) {
+                e.addSuppressed(suppressed);
+            }
+            try {
+                ops.removeUser(userId);
+            } catch (Exception suppressed) {
+                e.addSuppressed(suppressed);
+            }
+            throw e;
+        }
+    }
+
+    /**
+     * Replaces the decoy's PIN and registers it again, which is a no-op for a registered decoy and
+     * completes an interrupted set-up. A wrong {@code current} changes nothing.
+     */
+    void changePin(C current, C newPin) throws Exception {
+        final int userId = ops.findDecoyUserId();
+        if (userId == NO_USER) {
+            throw new IllegalStateException("no decoy exists");
+        }
+        ops.setDecoyPin(userId, current, newPin);
+        ops.register(userId);
+    }
+
+    /**
+     * Clears the registration first, then removes the user. Never the other way round: a
+     * registration that outlives its user crashed SystemUI once (frameworks-base 0011). If
+     * clearing fails the user is kept.
+     */
+    void remove() throws Exception {
+        final int userId = ops.findDecoyUserId();
+        ops.unregister();
+        if (userId != NO_USER) {
+            ops.removeUser(userId);
+        }
+    }
+}
diff --git a/tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java b/tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java
new file mode 100644
index 00000000000..875db689cd7
--- /dev/null
+++ b/tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java
@@ -0,0 +1,224 @@
+package com.android.settings.security;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public class DuressUnlockFlowTest {
+    private static class FakeOps implements DuressUnlockFlow.Ops<String> {
+        final List<String> calls = new ArrayList<>();
+        int userId = DuressUnlockFlow.NO_USER;
+        String failAt;
+        String pinOfUser;
+
+        private void step(String name) throws Exception {
+            calls.add(name);
+            if (name.equals(failAt)) {
+                throw new Exception("fail " + name);
+            }
+        }
+
+        @Override public int findDecoyUserId() { return userId; }
+        @Override public int createDecoyUser() throws Exception {
+            step("create");
+            userId = 10;
+            return 10;
+        }
+        @Override public void startDecoyUnlocked(int id) throws Exception { step("start"); }
+        @Override public void setDecoyPin(int id, String current, String newPin) throws Exception {
+            calls.add("setPin(" + current + "," + newPin + ")");
+            if ("setPin".equals(failAt)) throw new Exception("fail setPin");
+            if (!java.util.Objects.equals(current, pinOfUser)) {
+                throw new DuressUnlockFlow.WrongCurrentPinException();
+            }
+            pinOfUser = newPin;
+        }
+        @Override public void stopDecoy(int id) throws Exception { step("stop"); }
+        @Override public void register(int id) throws Exception { step("register"); }
+        @Override public void unregister() throws Exception { step("unregister"); }
+        @Override public void removeUser(int id) throws Exception {
+            step("remove");
+            userId = DuressUnlockFlow.NO_USER;
+        }
+    }
+
+    @Test
+    public void setUpRunsTheStepsInOrderAndRegistersLast() throws Exception {
+        FakeOps ops = new FakeOps();
+        new DuressUnlockFlow<>(ops).setUp("1234");
+        assertEquals(Arrays.asList("create", "start", "setPin(null,1234)", "stop", "register"),
+                ops.calls);
+        assertEquals("1234", ops.pinOfUser);
+    }
+
+    @Test
+    public void setUpRefusesWhenADecoyExists() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        try {
+            new DuressUnlockFlow<>(ops).setUp("1234");
+            fail();
+        } catch (IllegalStateException expected) {
+            assertTrue(ops.calls.isEmpty());
+        }
+    }
+
+    @Test
+    public void everyFailedSetUpStepUnregistersThenRemovesTheUser() throws Exception {
+        for (String failAt : new String[] {"start", "setPin", "stop", "register"}) {
+            FakeOps ops = new FakeOps();
+            ops.failAt = failAt;
+            try {
+                new DuressUnlockFlow<>(ops).setUp("1234");
+                fail(failAt);
+            } catch (Exception expected) {
+                assertEquals(failAt, "fail " + failAt, expected.getMessage());
+            }
+            int n = ops.calls.size();
+            assertEquals(failAt, Arrays.asList("unregister", "remove"),
+                    ops.calls.subList(n - 2, n));
+            assertEquals(failAt, DuressUnlockFlow.NO_USER, ops.userId);
+        }
+    }
+
+    @Test
+    public void aFailedCreateLeavesNothingToRollBack() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.failAt = "create";
+        try {
+            new DuressUnlockFlow<>(ops).setUp("1234");
+            fail();
+        } catch (Exception expected) {
+            assertEquals(Arrays.asList("create"), ops.calls);
+        }
+    }
+
+    @Test
+    public void aFailedRollbackStillRunsBothStepsAndKeepsTheFirstError() throws Exception {
+        FakeOps failing = new FakeOps() {
+            @Override public void register(int id) throws Exception { throw new Exception("first"); }
+            @Override public void unregister() throws Exception {
+                calls.add("unregister");
+                throw new Exception("second");
+            }
+        };
+        try {
+            new DuressUnlockFlow<>(failing).setUp("1234");
+            fail();
+        } catch (Exception e) {
+            assertEquals("first", e.getMessage());
+            assertEquals(1, e.getSuppressed().length);
+            assertEquals("remove", failing.calls.get(failing.calls.size() - 1));
+        }
+    }
+
+    @Test
+    public void changePinSetsThePinThenRegistersAgain() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.pinOfUser = "1234";
+        new DuressUnlockFlow<>(ops).changePin("1234", "5678");
+        assertEquals(Arrays.asList("setPin(1234,5678)", "register"), ops.calls);
+        assertEquals("5678", ops.pinOfUser);
+    }
+
+    @Test
+    public void aWrongCurrentPinChangesAndRemovesNothing() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.pinOfUser = "1234";
+        try {
+            new DuressUnlockFlow<>(ops).changePin("0000", "5678");
+            fail();
+        } catch (DuressUnlockFlow.WrongCurrentPinException expected) {
+            assertEquals(Arrays.asList("setPin(0000,5678)"), ops.calls);
+            assertEquals(10, ops.userId);
+        }
+    }
+
+    @Test
+    public void changePinWithoutADecoyFails() throws Exception {
+        FakeOps ops = new FakeOps();
+        try {
+            new DuressUnlockFlow<>(ops).changePin("1234", "5678");
+            fail();
+        } catch (IllegalStateException expected) {
+            assertTrue(ops.calls.isEmpty());
+        }
+    }
+
+    @Test
+    public void removeUnregistersBeforeItRemovesTheUser() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        new DuressUnlockFlow<>(ops).remove();
+        assertEquals(Arrays.asList("unregister", "remove"), ops.calls);
+    }
+
+    @Test
+    public void removeWithoutAUserStillClearsTheRegistration() throws Exception {
+        FakeOps ops = new FakeOps();
+        new DuressUnlockFlow<>(ops).remove();
+        assertEquals(Arrays.asList("unregister"), ops.calls);
+    }
+
+    @Test
+    public void aFailedUnregisterKeepsTheUser() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.failAt = "unregister";
+        try {
+            new DuressUnlockFlow<>(ops).remove();
+            fail();
+        } catch (Exception expected) {
+            assertEquals(Arrays.asList("unregister"), ops.calls);
+            assertEquals(10, ops.userId);
+        }
+    }
+
+    @Test
+    public void aFailedUserRemovalIsReportedAndTheRegistrationStaysCleared() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.failAt = "remove";
+        try {
+            new DuressUnlockFlow<>(ops).remove();
+            fail();
+        } catch (Exception expected) {
+            assertEquals("fail remove", expected.getMessage());
+            assertEquals(Arrays.asList("unregister", "remove"), ops.calls);
+            assertEquals(10, ops.userId);
+        }
+    }
+
+    @Test
+    public void aFailedRegisterAfterAChangedPinIsReported() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.pinOfUser = "1234";
+        ops.failAt = "register";
+        try {
+            new DuressUnlockFlow<>(ops).changePin("1234", "5678");
+            fail();
+        } catch (Exception expected) {
+            assertEquals("fail register", expected.getMessage());
+            assertEquals("5678", ops.pinOfUser);
+        }
+    }
+
+    @Test
+    public void changePinWithoutACurrentPinCompletesADecoyThatHasNone() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        new DuressUnlockFlow<>(ops).changePin(null, "5678");
+        assertEquals(Arrays.asList("setPin(null,5678)", "register"), ops.calls);
+        assertEquals("5678", ops.pinOfUser);
+    }
+}
-- 
