+package com.android.settings.safetycenter.ui;
+
+import android.content.Context;
+import android.content.Intent;
+import android.text.TextUtils;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.ext.ExtSettingControllerHelper;
+import com.android.settings.security.DuressUnlockMainActivity;
+
+/**
+ * SovereignOS: the Duress Unlock row on the Device unlock page. Available for the system user
+ * only, exactly like the Duress password row, so a Duress Unlock decoy session never shows it
+ * and search never offers it there.
+ */
+public class DuressUnlockPrefController extends BasePreferenceController {
+
+    public DuressUnlockPrefController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return ExtSettingControllerHelper.getGlobalSettingAvailability(mContext);
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return super.handlePreferenceTreeClick(preference);
+        }
+        mContext.startActivity(new Intent(mContext, DuressUnlockMainActivity.class));
+        return true;
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockMainActivity.java b/src/com/android/settings/security/DuressUnlockMainActivity.java
new file mode 100644
index 00000000000..91fd5f951e0
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockMainActivity.java
@@ -0,0 +1,231 @@
+package com.android.settings.security;
+
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.os.Bundle;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.Nullable;
+import androidx.annotation.StringRes;
+
+import com.android.internal.widget.LockscreenCredential;
+import com.android.settings.R;
+import com.android.settings.password.ChooseLockSettingsHelper;
+import com.google.android.setupdesign.GlifRecyclerLayout;
+import com.google.android.setupdesign.items.IItem;
+import com.google.android.setupdesign.items.Item;
+import com.google.android.setupdesign.items.ItemGroup;
+import com.google.android.setupdesign.items.RecyclerItemAdapter;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+import static java.util.Objects.requireNonNull;
+
+/**
+ * SovereignOS: main Duress Unlock screen. Confirms the owner credential, then lists the actions
+ * for the current state. Same structure as {@link DuressPasswordMainActivity}. Only the system
+ * user can open it, so a Duress Unlock decoy session cannot.
+ */
+public class DuressUnlockMainActivity extends DuressPasswordActivity
+        implements RecyclerItemAdapter.OnItemSelectedListener {
+    private static final String TAG = DuressUnlockMainActivity.class.getSimpleName();
+    private static final String KEY_USER_CREDENTIAL = "user_credential";
+    private static final String KEY_HAS_ASKED_FOR_USER_CREDENTIALS = "asked_for_user_credentials";
+
+    static final int REQ_CODE_OBTAIN_USER_CREDENTIALS = 1;
+    static final int REQ_CODE_SETUP = 2;
+
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private GlifRecyclerLayout layout;
+    private LockscreenCredential userCredential;
+    private boolean askedForUserCredentials;
+    private boolean removing;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!getUser().isSystem()) {
+            finish();
+            return;
+        }
+
+        var layout = new GlifRecyclerLayout(this);
+        this.layout = layout;
+        layout.setIcon(getDrawable(R.drawable.ic_lock));
+        layout.setHeaderText(R.string.duress_unlock_title);
+        adjustDescriptionStyle(layout);
+        layout.setDescriptionText(R.string.duress_unlock_description);
+
+        setContentView(layout);
+
+        if (savedInstanceState != null) {
+            userCredential = savedInstanceState.getParcelable(KEY_USER_CREDENTIAL, LockscreenCredential.class);
+            askedForUserCredentials = savedInstanceState.getBoolean(KEY_HAS_ASKED_FOR_USER_CREDENTIALS);
+        }
+    }
+
+    @Override
+    protected boolean hasUserCredential() {
+        return userCredential != null && !userCredential.isNone();
+    }
+
+    @Override
+    protected void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        outState.putParcelable(KEY_USER_CREDENTIAL, userCredential);
+        outState.putBoolean(KEY_HAS_ASKED_FOR_USER_CREDENTIALS, askedForUserCredentials);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        executor.shutdown();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        if (isFinishing()) {
+            return;
+        }
+
+        if (userCredential == null) {
+            if (!getLockPatternUtils().isSecure(getUserId())) {
+                userCredential = LockscreenCredential.createNone();
+            } else if (!askedForUserCredentials) {
+                var b = new ChooseLockSettingsHelper.Builder(this);
+                b.setRequestCode(REQ_CODE_OBTAIN_USER_CREDENTIALS);
+                b.setReturnCredentials(true);
+                b.setForegroundOnly(true);
+                b.show();
+                askedForUserCredentials = true;
+            }
+        }
+
+        updateActionList();
+    }
+
+    private DuressUnlockOps newOps() {
+        return new DuressUnlockOps(getApplicationContext(), getLockPatternUtils(), userCredential);
+    }
+
+    private void updateActionList() {
+        if (userCredential == null) {
+            Log.d(TAG, "no userCredential, skipping updateActionList");
+            return;
+        }
+
+        var g = new ItemGroup();
+        if (userCredential.isPin()) {
+            layout.setDescriptionText(R.string.duress_unlock_description);
+            if (new DuressUnlockFlow<>(newOps()).hasDecoy()) {
+                g.addChild(createItem(R.string.duress_unlock_action_change, R.drawable.ic_edit));
+                g.addChild(createItem(R.string.duress_unlock_action_remove, R.drawable.ic_delete));
+            } else {
+                g.addChild(createItem(R.string.duress_unlock_action_setup, R.drawable.ic_add_24dp));
+            }
+        } else {
+            // A password, a pattern or no lock: Duress Unlock supports only a PIN for now.
+            layout.setDescriptionText(R.string.duress_unlock_needs_pin);
+        }
+
+        var adapter = new RecyclerItemAdapter(g);
+        adapter.setOnItemSelectedListener(this);
+        layout.setAdapter(adapter);
+    }
+
+    private Item createItem(@StringRes int title, @DrawableRes int icon) {
+        var i = new Item();
+        i.setId(title);
+        i.setTitle(getText(title));
+        i.setIcon(getDrawable(icon));
+        return i;
+    }
+
+    // RecyclerItemAdapter.OnItemSelectedListener
+    @Override
+    public void onItemSelected(IItem iitem) {
+        if (removing) {
+            return;
+        }
+        int id = ((Item) iitem).getId();
+
+        if (id == R.string.duress_unlock_action_setup || id == R.string.duress_unlock_action_change) {
+            var i = new Intent(this, DuressUnlockSetupActivity.class);
+            i.putExtra(DuressUnlockSetupActivity.EXTRA_USER_CREDENTIAL, userCredential);
+            i.putExtra(DuressUnlockSetupActivity.EXTRA_CHANGE,
+                    id == R.string.duress_unlock_action_change);
+            allowNextOnStop = true;
+            startActivityForResult(i, REQ_CODE_SETUP);
+        } else if (id == R.string.duress_unlock_action_remove) {
+            var b = new AlertDialog.Builder(this);
+            b.setTitle(R.string.duress_unlock_remove_title);
+            b.setMessage(R.string.duress_unlock_remove_message);
+            b.setNegativeButton(R.string.duress_pwd_cancel_button, null);
+            b.setPositiveButton(R.string.duress_unlock_remove_button, (dialog, which) -> remove());
+            b.show();
+        }
+    }
+
+    private void remove() {
+        removing = true;
+        final DuressUnlockOps ops = newOps();
+        executor.execute(() -> {
+            Exception failure = null;
+            try {
+                new DuressUnlockFlow<>(ops).remove();
+            } catch (Exception e) {
+                Log.e(TAG, "remove failed", e);
+                failure = e;
+            }
+            final Exception f = failure;
+            runOnUiThread(() -> {
+                removing = false;
+                if (isFinishing() || isDestroyed()) {
+                    // The screen is gone: a toast is the only way left to report the outcome.
+                    Toast.makeText(getApplicationContext(),
+                            f == null ? getString(R.string.duress_unlock_toast_removed)
+                                    : getString(R.string.duress_unlock_remove_error, f.toString()),
+                            Toast.LENGTH_LONG).show();
+                    return;
+                }
+                if (f == null) {
+                    Toast.makeText(this, R.string.duress_unlock_toast_removed, Toast.LENGTH_LONG).show();
+                } else {
+                    var d = new AlertDialog.Builder(this);
+                    d.setMessage(getString(R.string.duress_unlock_remove_error, f.toString()));
+                    d.setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null);
+                    d.show();
+                }
+                updateActionList();
+            });
+        });
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (requestCode == REQ_CODE_SETUP) {
+            if (resultCode == RESULT_CANCELED) {
+                finish();
+            }
+            return;
+        }
+
+        if (requestCode != REQ_CODE_OBTAIN_USER_CREDENTIALS) {
+            throw new IllegalStateException(Integer.toString(resultCode));
+        }
+
+        if (resultCode != RESULT_OK) {
+            finish();
+            return;
+        }
+
+        requireNonNull(data, "data");
+        var credential = data.getParcelableExtra(ChooseLockSettingsHelper.EXTRA_KEY_PASSWORD, LockscreenCredential.class);
+        requireNonNull(credential, "no returned credential");
+        userCredential = credential;
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockOps.java b/src/com/android/settings/security/DuressUnlockOps.java
new file mode 100644
index 00000000000..9d9f069ee76
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockOps.java
@@ -0,0 +1,125 @@
+package com.android.settings.security;
+
+import android.app.ActivityManager;
+import android.content.Context;
+import android.content.pm.UserInfo;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.os.UserManager;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+
+import java.util.concurrent.TimeoutException;
+
+/**
+ * SovereignOS: the Android side of {@link DuressUnlockFlow}. Must run off the main thread: it
+ * waits for the decoy's storage to unlock. It never passes a candidate PIN to checkCredential,
+ * which would run the wipe hook and decoy routing on it.
+ */
+final class DuressUnlockOps implements DuressUnlockFlow.Ops<LockscreenCredential> {
+    /** A new user's first start prepares its storage; the decoy design pays that cost here. */
+    private static final long UNLOCK_TIMEOUT_MS = 120_000;
+    private static final long UNLOCK_POLL_MS = 500;
+
+    private final UserManager userManager;
+    private final LockPatternUtils lockPatternUtils;
+    private final LockscreenCredential ownerCredential;
+
+    DuressUnlockOps(Context context, LockPatternUtils lockPatternUtils,
+            LockscreenCredential ownerCredential) {
+        this.userManager = context.getSystemService(UserManager.class);
+        this.lockPatternUtils = lockPatternUtils;
+        this.ownerCredential = ownerCredential;
+    }
+
+    @Override
+    public int findDecoyUserId() {
+        // getAliveUsers: a user being removed must not count as a decoy
+        for (UserInfo info : userManager.getAliveUsers()) {
+            if (UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(info.userType)) {
+                return info.id;
+            }
+        }
+        return DuressUnlockFlow.NO_USER;
+    }
+
+    @Override
+    public int createDecoyUser() {
+        UserInfo info = userManager.createUser(null, UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY, 0);
+        if (info == null) {
+            throw new IllegalStateException("the decoy user could not be created");
+        }
+        return info.id;
+    }
+
+    @Override
+    public void startDecoyUnlocked(int userId) throws Exception {
+        try {
+            if (!ActivityManager.getService().startUserInBackground(userId)) {
+                throw new IllegalStateException("the decoy user did not start");
+            }
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+        // A new user has no credential, so its storage unlocks at its first start.
+        final long deadline = SystemClock.elapsedRealtime() + UNLOCK_TIMEOUT_MS;
+        while (!userManager.isUserUnlocked(userId)) {
+            if (SystemClock.elapsedRealtime() > deadline) {
+                throw new TimeoutException("the decoy storage did not unlock");
+            }
+            Thread.sleep(UNLOCK_POLL_MS);
+        }
+    }
+
+    @Override
+    public void setDecoyPin(int userId, LockscreenCredential current,
+            LockscreenCredential newPin) throws Exception {
+        final LockscreenCredential saved =
+                current != null ? current : LockscreenCredential.createNone();
+        try {
+            // setLockCredential checks the old credential itself, without the wipe hook or
+            // decoy routing, so a wrong current PIN is refused with no side effect.
+            if (!lockPatternUtils.setLockCredential(newPin, saved, userId)) {
+                if (current != null) {
+                    throw new DuressUnlockFlow.WrongCurrentPinException();
+                }
+                throw new IllegalStateException("the decoy PIN could not be set");
+            }
+        } finally {
+            if (current == null) {
+                saved.zeroize();
+            }
+        }
+    }
+
+    @Override
+    public void stopDecoy(int userId) {
+        try {
+            // Delayed locking keeps the decoy's storage key, as the user switch design expects.
+            final int result = ActivityManager.getService().stopUserWithDelayedLocking(userId, null);
+            if (result != ActivityManager.USER_OP_SUCCESS) {
+                throw new IllegalStateException("the decoy user did not stop: " + result);
+            }
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    @Override
+    public void register(int userId) {
+        lockPatternUtils.setDecoyProfile(ownerCredential, userId);
+    }
+
+    @Override
+    public void unregister() {
+        lockPatternUtils.clearDecoyProfile(ownerCredential);
+    }
+
+    @Override
+    public void removeUser(int userId) {
+        if (!userManager.removeUser(userId)) {
+            throw new IllegalStateException("the decoy user could not be removed");
+        }
+    }
+}
