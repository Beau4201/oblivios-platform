+package com.android.settings.security;
+
+import android.app.AlertDialog;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.view.inputmethod.EditorInfo;
+import android.widget.EditText;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.internal.widget.PasswordValidationError;
+import com.android.settings.R;
+import com.android.settings.password.ChooseLockPassword;
+import com.android.settings.password.ChooseLockPassword.ChooseLockPasswordFragment.PasswordValidationErrorConverter;
+import com.google.android.setupcompat.template.FooterBarMixin;
+import com.google.android.setupcompat.template.FooterButton;
+import com.google.android.setupdesign.GlifLayout;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * SovereignOS: set up or change the Duress Unlock second PIN. The work after the checks runs on a
+ * worker thread that does not depend on this activity. While it runs the screen is kept on and
+ * the base class does not cancel on stop, so the process stays in the foreground; an interrupted
+ * set-up (a process kill) leaves a decoy user that the main screen's Change PIN or Remove repairs.
+ */
+public class DuressUnlockSetupActivity extends DuressPasswordActivity
+        implements TextView.OnEditorActionListener {
+    static final String TAG = DuressUnlockSetupActivity.class.getSimpleName();
+    static final String EXTRA_USER_CREDENTIAL = "user_credential";
+    static final String EXTRA_CHANGE = "change";
+
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private boolean isChange;
+    private boolean needsCurrent;
+    private boolean working;
+    private GlifLayout layout;
+    private EditText currentInput;
+    private EditText pinInput;
+    private EditText confirmInput;
+    private View form;
+    private View progress;
+    private FooterButton primaryButton;
+    private FooterButton secondaryButton;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!getUser().isSystem()) {
+            finish();
+            return;
+        }
+
+        setContentView(R.layout.duress_unlock_setup);
+
+        isChange = getIntent().getBooleanExtra(EXTRA_CHANGE, false);
+        // A decoy left without a credential by an interrupted set-up has no current PIN to ask for.
+        needsCurrent = isChange && decoyHasCredential();
+        layout = requireViewById(R.id.glif_layout);
+        form = requireViewById(R.id.duress_unlock_form);
+        progress = requireViewById(R.id.duress_unlock_progress);
+        currentInput = requireViewById(R.id.duress_unlock_current_pin);
+        pinInput = requireViewById(R.id.duress_unlock_pin);
+        confirmInput = requireViewById(R.id.duress_unlock_pin_confirmation);
+
+        layout.setHeaderText(isChange
+                ? R.string.duress_unlock_change_title : R.string.duress_unlock_setup_title);
+        adjustDescriptionStyle(layout);
+        if (needsCurrent) {
+            currentInput.setVisibility(View.VISIBLE);
+        }
+        if (isChange) {
+            pinInput.setHint(R.string.duress_unlock_hint_new_change);
+            confirmInput.setHint(R.string.duress_unlock_hint_confirm_change);
+        }
+
+        FooterBarMixin footerBar = layout.getMixin(FooterBarMixin.class);
+        {
+            var b = new FooterButton.Builder(this);
+            b.setText(isChange
+                    ? R.string.duress_unlock_button_change : R.string.duress_unlock_button_setup);
+            b.setButtonType(FooterButton.ButtonType.DONE);
+            b.setListener(v -> save());
+            b.setTheme(com.google.android.setupdesign.R.style.SudGlifButton_Primary);
+            primaryButton = b.build();
+            footerBar.setPrimaryButton(primaryButton);
+        }
+        {
+            var b = new FooterButton.Builder(this);
+            b.setText(R.string.duress_pwd_cancel_button);
+            b.setButtonType(FooterButton.ButtonType.CANCEL);
+            b.setListener(v -> finish());
+            b.setTheme(com.google.android.setupdesign.R.style.SudGlifButton_Secondary);
+            secondaryButton = b.build();
+            footerBar.setSecondaryButton(secondaryButton);
+        }
+        confirmInput.setOnEditorActionListener(this);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        executor.shutdown();
+    }
+
+    // Do not cancel on stop while the work runs: the process must not become a cached one.
+    @Override
+    protected boolean hasUserCredential() {
+        return !working;
+    }
+
+    private boolean decoyHasCredential() {
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        Objects.requireNonNull(owner, EXTRA_USER_CREDENTIAL);
+        final LockPatternUtils lockPatternUtils = getLockPatternUtils();
+        final int userId =
+                new DuressUnlockOps(getApplicationContext(), lockPatternUtils, owner)
+                        .findDecoyUserId();
+        return userId == DuressUnlockFlow.NO_USER || lockPatternUtils.isSecure(userId);
+    }
+
+    // TextView.OnEditorActionListener
+    @Override
+    public boolean onEditorAction(TextView v, int actionId, KeyEvent event) {
+        if (actionId != EditorInfo.IME_ACTION_DONE) {
+            return false;
+        }
+        save();
+        return true;
+    }
+
+    private void save() {
+        if (working) {
+            return;
+        }
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        Objects.requireNonNull(owner, EXTRA_USER_CREDENTIAL);
+
+        final LockscreenCredential pin = LockscreenCredential.createPin(pinInput.getText().toString());
+        boolean ok = checkPin(pin, owner);
+        ok &= checkConfirmation();
+        if (needsCurrent) {
+            ok &= checkCurrentPresent();
+        }
+        if (!ok) {
+            pin.zeroize();
+            return;
+        }
+        final LockscreenCredential current = needsCurrent
+                ? LockscreenCredential.createPin(currentInput.getText().toString()) : null;
+
+        showWorking();
+        final LockPatternUtils lockPatternUtils = getLockPatternUtils();
+        final DuressUnlockOps ops =
+                new DuressUnlockOps(getApplicationContext(), lockPatternUtils, owner);
+        final boolean change = isChange;
+        executor.execute(() -> {
+            boolean sameAsWipe = false;
+            boolean wrongCurrent = false;
+            Exception failure = null;
+            try {
+                // Slow (a key stretch) and the answer is the owner's own: run it here, not on the
+                // main thread, and never through checkCredential.
+                if (lockPatternUtils.isDuressWipeCredential(owner, pin)) {
+                    sameAsWipe = true;
+                } else if (change) {
+                    new DuressUnlockFlow<>(ops).changePin(current, pin);
+                } else {
+                    new DuressUnlockFlow<>(ops).setUp(pin);
+                }
+            } catch (DuressUnlockFlow.WrongCurrentPinException e) {
+                wrongCurrent = true;
+            } catch (Exception e) {
+                Log.e(TAG, "Duress Unlock save failed", e);
+                failure = e;
+            } finally {
+                pin.zeroize();
+                if (current != null) {
+                    current.zeroize();
+                }
+            }
+            final boolean fSameAsWipe = sameAsWipe;
+            final boolean fWrongCurrent = wrongCurrent;
+            final Exception fFailure = failure;
+            runOnUiThread(() -> onWorkDone(change, fSameAsWipe, fWrongCurrent, fFailure));
+        });
+    }
+
+    private void onWorkDone(boolean change, boolean sameAsWipe, boolean wrongCurrent,
+            @Nullable Exception failure) {
+        if (failure == null && !sameAsWipe && !wrongCurrent) {
+            // The application context: this activity may be gone by now.
+            Toast.makeText(getApplicationContext(),
+                    change ? R.string.duress_unlock_toast_changed : R.string.duress_unlock_toast_set_up,
+                    Toast.LENGTH_LONG).show();
+            if (!isDestroyed()) {
+                finish();
+            }
+            return;
+        }
+        if (isDestroyed()) {
+            // The screen is gone (for example the screen was turned off): say so, there is no
+            // other way to learn that the work failed.
+            if (failure != null) {
+                Toast.makeText(getApplicationContext(),
+                        getString(R.string.duress_unlock_save_error, failure.toString()),
+                        Toast.LENGTH_LONG).show();
+            }
+            return;
+        }
+        showForm();
+        if (sameAsWipe) {
+            pinInput.setError(getText(R.string.duress_unlock_error_same_as_wipe));
+        } else if (wrongCurrent) {
+            currentInput.setError(getText(R.string.duress_unlock_error_wrong_current));
+        } else {
+            var d = new AlertDialog.Builder(this);
+            d.setMessage(getString(R.string.duress_unlock_save_error, failure.toString()));
+            d.setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null);
+            d.show();
+        }
+    }
+
+    private void showWorking() {
+        working = true;
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        layout.setHeaderText(R.string.duress_unlock_working_title);
+        form.setVisibility(View.GONE);
+        progress.setVisibility(View.VISIBLE);
+        primaryButton.setEnabled(false);
+        secondaryButton.setEnabled(false);
+    }
+
+    private void showForm() {
+        working = false;
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        layout.setHeaderText(isChange
+                ? R.string.duress_unlock_change_title : R.string.duress_unlock_setup_title);
+        progress.setVisibility(View.GONE);
+        form.setVisibility(View.VISIBLE);
+        primaryButton.setEnabled(true);
+        secondaryButton.setEnabled(true);
+    }
+
+    private boolean checkPin(LockscreenCredential candidate, LockscreenCredential owner) {
+        List<PasswordValidationError> errors = LockPatternUtils.validateDuressCredential(candidate);
+        CharSequence error = null;
+        if (!errors.isEmpty()) {
+            var converter = new PasswordValidationErrorConverter(this, candidate.isPassword(),
+                    ChooseLockPassword.ChooseLockPasswordFragment.ProfileType.None, errors);
+            error = String.join("\n", converter.convertErrorCodeToMessages());
+        } else if (candidate.equals(owner)) {
+            error = getText(R.string.duress_unlock_error_same_as_lock);
+        } else if (getLockPatternUtils().isAutoPinConfirmEnabled(UserHandle.USER_SYSTEM)
+                && candidate.size() != owner.size()) {
+            // The keyguard submits at the owner's PIN length and hides Enter; a decoy PIN of
+            // another length would never be submitted whole.
+            error = getText(R.string.duress_unlock_error_length_auto_confirm);
+        }
+        pinInput.setError(error);
+        return error == null;
+    }
+
+    private boolean checkConfirmation() {
+        boolean same = pinInput.getText().toString().equals(confirmInput.getText().toString());
+        confirmInput.setError(same ? null : getText(R.string.lockpassword_confirm_pins_dont_match));
+        return same;
+    }
+
+    private boolean checkCurrentPresent() {
+        boolean present = currentInput.getText().length() > 0;
+        currentInput.setError(present ? null : getText(R.string.duress_unlock_error_wrong_current));
+        return present;
+    }
+}
