From 195738a1ca67d6b43cc8dec760d76c1a82432bdb Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 30 Aug 2026 19:41:04 +0200
Subject: [PATCH] aegisos: fix Wi-Fi shared badge/dialog and factory-reset
 warning to use getUsersForUiDisplay

Three sibling call sites using the raw UserManager#getUserCount():
WifiEntryPreference's 'shared' badge (displaySharedIcon()),
WifiDetailPreferenceController2's 'forget shared network'
confirmation dialog, and MainClear's 'other users present on this
device' factory-reset warning. Same bug class as the already-fixed
WifiUtils/WifiConfigController2 call sites and the uninstall dialogs.
Found during an exhaustive audit of every getUsers()-style call site.

Fixed all three by using getUsersForUiDisplay(true).size(), which is
getUserCount()'s own semantics (getUsers().size(), here with dying
users excluded) plus AegisOS Duress Unlock decoy-session filtering.
---
 src/com/android/settings/MainClear.java                     | 5 ++++-
 src/com/android/settings/wifi/WifiEntryPreference.java      | 5 ++++-
 .../wifi/details2/WifiDetailPreferenceController2.java      | 6 +++++-
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/com/android/settings/MainClear.java b/src/com/android/settings/MainClear.java
index f9f440194a8..eb955900c2a 100644
--- a/src/com/android/settings/MainClear.java
+++ b/src/com/android/settings/MainClear.java
@@ -665,8 +665,11 @@ public class MainClear extends InstrumentedFragment implements OnGlobalLayoutLis
             contents.setVisibility(View.VISIBLE);
         }
         // Checking for all other users and their profiles if any.
+        // getUsersForUiDisplay(true) is getUserCount()'s own semantics plus AegisOS Duress
+        // Unlock decoy-session filtering: without it, this warning would leak that another
+        // real user exists on the device during a decoy session.
         View otherUsers = mContentView.findViewById(R.id.other_users_present);
-        final boolean hasOtherUsers = (um.getUserCount() - profilesSize) > 0;
+        final boolean hasOtherUsers = (um.getUsersForUiDisplay(true).size() - profilesSize) > 0;
         otherUsers.setVisibility(hasOtherUsers ? View.VISIBLE : View.GONE);
     }
 
diff --git a/src/com/android/settings/wifi/WifiEntryPreference.java b/src/com/android/settings/wifi/WifiEntryPreference.java
index b2e14693352..5f48cae133b 100644
--- a/src/com/android/settings/wifi/WifiEntryPreference.java
+++ b/src/com/android/settings/wifi/WifiEntryPreference.java
@@ -171,8 +171,11 @@ public class WifiEntryPreference extends RestrictedPreference implements
             return false;
         }
 
+        // getUsersForUiDisplay(true) is getUserCount()'s own semantics plus AegisOS Duress
+        // Unlock decoy-session filtering: without it, this "shared" badge would leak that
+        // another real user exists on the device during a decoy session.
         UserManager userManager = getContext().getSystemService(UserManager.class);
-        if (userManager.getUserCount() <= 1) {
+        if (userManager.getUsersForUiDisplay(true).size() <= 1) {
             return false;
         }
 
diff --git a/src/com/android/settings/wifi/details2/WifiDetailPreferenceController2.java b/src/com/android/settings/wifi/details2/WifiDetailPreferenceController2.java
index 532de3f9e71..7e578ba0430 100644
--- a/src/com/android/settings/wifi/details2/WifiDetailPreferenceController2.java
+++ b/src/com/android/settings/wifi/details2/WifiDetailPreferenceController2.java
@@ -911,7 +911,11 @@ public class WifiDetailPreferenceController2 extends AbstractPreferenceControlle
             return;
         } else if (WifiUtils.isWifiMultiuserEnabled()
                         && mWifiEntry.isSharedWithOtherUsers()
-                        && mUserManager.getUserCount() > 1) {
+                        // getUsersForUiDisplay(true) is getUserCount()'s own semantics plus
+                        // AegisOS Duress Unlock decoy-session filtering: without it, this
+                        // "affects other users" dialog would leak that another real user
+                        // exists on the device during a decoy session.
+                        && mUserManager.getUsersForUiDisplay(true).size() > 1) {
             showConfirmForgetDialog(
                     R.string.wifi_forget_dialog_title,
                     mContext.getString(
