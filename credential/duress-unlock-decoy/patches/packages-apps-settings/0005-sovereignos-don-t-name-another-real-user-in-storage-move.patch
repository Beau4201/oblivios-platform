From fcbfa430a14b79b01fdea0aeaaaa449670950fc5 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Sun, 30 Aug 2026 19:27:36 +0200
Subject: [PATCH] sovereignos: don't name another real user in storage move/migrate
 dialogs

StorageWizardMigrateConfirm and StorageWizardMoveConfirm both iterate
every real user to unlock their CE storage before a storage
move/migrate can proceed -- that enumeration is unchanged, it's a real
functional requirement, not a display list. But the dialog shown for
an already-secured locked user named that user directly
(storage_wizard_move_unlock), reachable from within an SovereignOS Duress
Unlock decoy's own Settings if the real owner's storage happens to be
locked. Found during an exhaustive audit of every getUsers()-style
call site.

Fixed by keeping the real getUsers() loop (needed for migration
correctness) but showing a new, generic string
(storage_wizard_move_unlock_generic) instead of the real user's name
whenever the current session is the decoy, checked via the same
getUsersForUiDisplay-backed pattern used elsewhere in this feature.
---
 res/values/strings.xml                        |  2 ++
 .../StorageWizardMigrateConfirm.java          | 25 +++++++++++++++---
 .../deviceinfo/StorageWizardMoveConfirm.java  | 26 ++++++++++++++++---
 3 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/res/values/strings.xml b/res/values/strings.xml
index 55de29a749a..043122fc077 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -3890,6 +3890,8 @@
 
     <!-- Body of lock screen challenge message explaining that the given user must be unlocked before data can be moved [CHAR LIMIT=64] -->
     <string name="storage_wizard_move_unlock">To move data you need to unlock user <xliff:g id="app" example="Joey">^1</xliff:g>.</string>
+    <!-- Same as storage_wizard_move_unlock, without naming the user: shown instead during an SovereignOS Duress Unlock decoy session, since naming another real user here would defeat the decoy session's own indistinguishability [CHAR LIMIT=64] -->
+    <string name="storage_wizard_move_unlock_generic">To move data you need to unlock another user on this device.</string>
 
     <!-- Title of wizard step showing app move progress [CHAR LIMIT=32] -->
     <string name="storage_wizard_move_progress_title">Moving <xliff:g id="app" example="Calculator">^1</xliff:g>\u2026</string>
diff --git a/src/com/android/settings/deviceinfo/StorageWizardMigrateConfirm.java b/src/com/android/settings/deviceinfo/StorageWizardMigrateConfirm.java
index 0b886572ffa..bde8f877965 100644
--- a/src/com/android/settings/deviceinfo/StorageWizardMigrateConfirm.java
+++ b/src/com/android/settings/deviceinfo/StorageWizardMigrateConfirm.java
@@ -35,6 +35,7 @@ import com.android.settings.R;
 import com.android.settings.overlay.FeatureFactory;
 import com.android.settings.password.ChooseLockSettingsHelper;
 
+import java.util.List;
 import java.util.Objects;
 
 public class StorageWizardMigrateConfirm extends StorageWizardBase {
@@ -99,8 +100,12 @@ public class StorageWizardMigrateConfirm extends StorageWizardBase {
     public void onNavigateNext(View view) {
         // Ensure that all users are unlocked so that we can move their data
         final LockPatternUtils lpu = new LockPatternUtils(this);
+        final UserManager userManager = getSystemService(UserManager.class);
         if (StorageManager.isFileEncrypted()) {
-            for (UserInfo user : getSystemService(UserManager.class).getUsers()) {
+            // Iterates every real user (not just the SovereignOS decoy, if any) since migration
+            // genuinely needs each one's CE storage unlocked -- only the dialog text below is
+            // decoy-aware, not this enumeration.
+            for (UserInfo user : userManager.getUsers()) {
                 if (StorageManager.isCeStorageUnlocked(user.id)) {
                     continue;
                 }
@@ -111,8 +116,10 @@ public class StorageWizardMigrateConfirm extends StorageWizardBase {
                 } else {
                     Log.d(TAG, "Secured user " + user.id + " is currently locked; requesting "
                             + "manual unlock");
-                    final CharSequence description = TextUtils.expandTemplate(
-                            getText(R.string.storage_wizard_move_unlock), user.name);
+                    final CharSequence description = isDecoySession(userManager)
+                            ? getText(R.string.storage_wizard_move_unlock_generic)
+                            : TextUtils.expandTemplate(
+                                    getText(R.string.storage_wizard_move_unlock), user.name);
                     final ChooseLockSettingsHelper.Builder builder =
                             new ChooseLockSettingsHelper.Builder(this);
                     builder.setRequestCode(REQUEST_CREDENTIAL)
@@ -162,6 +169,18 @@ public class StorageWizardMigrateConfirm extends StorageWizardBase {
         finishAffinity();
     }
 
+    /**
+     * True when the current session is an SovereignOS Duress Unlock decoy user, in which case
+     * naming another real user in this wizard's unlock-request dialog would defeat the decoy
+     * session's own indistinguishability.
+     */
+    private boolean isDecoySession(UserManager userManager) {
+        List<UserInfo> usersForUiDisplay = userManager.getUsersForUiDisplay(true);
+        return usersForUiDisplay.size() == 1
+                && UserManager.USER_TYPE_FULL_SOVEREIGNOS_DECOY.equals(
+                        usersForUiDisplay.get(0).userType);
+    }
+
     @Override
     protected void onActivityResult(int requestCode, int resultCode, Intent data) {
         if (requestCode == REQUEST_CREDENTIAL) {
diff --git a/src/com/android/settings/deviceinfo/StorageWizardMoveConfirm.java b/src/com/android/settings/deviceinfo/StorageWizardMoveConfirm.java
