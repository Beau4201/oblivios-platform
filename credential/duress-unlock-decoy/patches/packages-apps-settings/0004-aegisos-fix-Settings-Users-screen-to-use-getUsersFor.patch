From ab4b0a932a049f5a3c484c72139dd81ff5661e4b Mon Sep 17 00:00:00 2001
From: AegisOS Build <build@aegisos.local>
Date: Sun, 30 Aug 2026 19:22:15 +0200
Subject: [PATCH] aegisos: fix Settings Users screen to use
 getUsersForUiDisplay

updateUserList() called the raw UserManager#getAliveUsers() (itself
just getUsers(excludeDying=true)), gated only on
UserManager.supportsMultipleUsers(), not admin status -- reachable
from a non-admin AegisOS Duress Unlock decoy session. Listed the real
owner's name as a preference and allowed switching to it directly.
Found during an exhaustive audit of every getUsers()-style call site.

Fixed by using getUsersForUiDisplay(true), which is exactly
getAliveUsers()'s own semantics (confirmed via source:
getAliveUsers() literally returns getUsers(true)) plus decoy-aware
filtering, matching every other Component B fix in this feature.
---
 src/com/android/settings/users/UserSettings.java | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/com/android/settings/users/UserSettings.java b/src/com/android/settings/users/UserSettings.java
index f90431ae9c8..6eee3513104 100644
--- a/src/com/android/settings/users/UserSettings.java
+++ b/src/com/android/settings/users/UserSettings.java
@@ -1346,7 +1346,11 @@ public class UserSettings extends SettingsPreferenceFragment
         List<UserInfo> users;
         // Only human users that can be UI-switched to should show up here.
         // e.g. Managed profiles appear under Accounts Settings instead
-        users = mUserManager.getAliveUsers().stream()
+        // getUsersForUiDisplay(true) is getAliveUsers()'s own exact semantics
+        // (getUsers(excludeDying=true)) plus AegisOS Duress Unlock decoy-session filtering:
+        // this screen is reachable by a non-admin decoy user, so a raw getAliveUsers() would
+        // list the real owner's name and let them switch to it.
+        users = mUserManager.getUsersForUiDisplay(true).stream()
                 .filter(UserInfo::isUiSwitchableHumanUser)
                 .collect(Collectors.toList());
 
