From 69945953b93cfd808bdb4222bf80d648fcbc4456 Mon Sep 17 00:00:00 2001
From: beau4201 <beau.ten.berge@gmail.com>
Date: Sun, 15 Nov 2026 16:09:19 +0100
Subject: [PATCH] oblivios: Duress Unlock warns when a decoy PIN no longer has
 the owner's length under Auto confirm, and the screens drop the owner
 credential

Review findings D3 and D9. With Auto confirm unlock on the keyguard submits at the owner's PIN length and hides Enter, so a decoy PIN of another length (after a later change of the screen lock) is never submitted; the main screen now says so, like it does for a changed lock type. DuressUnlockMainActivity kept the owner credential in its saved instance state; it now survives a configuration change in memory only, and the three screens zeroize their copy when they are really gone, after the queued work that uses it.
---
 res/values/strings_oblivios.xml               |  1 +
 .../security/DuressUnlockFingerActivity.java  |  7 +++
 .../security/DuressUnlockMainActivity.java    | 51 +++++++++++++++----
 .../security/DuressUnlockSetupActivity.java   |  7 +++
 4 files changed, 55 insertions(+), 11 deletions(-)

diff --git a/res/values/strings_oblivios.xml b/res/values/strings_oblivios.xml
index 00867879939..bee62bd3690 100644
--- a/res/values/strings_oblivios.xml
+++ b/res/values/strings_oblivios.xml
@@ -13,6 +13,7 @@ Nothing on the screen tells anyone that Duress Unlock is on. To return to your o
 This hides your data from someone looking at the phone. It does not protect the storage against forensic analysis of the device."</string>
     <string name="duress_unlock_needs_credential">Duress Unlock needs a PIN or a password as your screen lock. Set one under Screen lock first.</string>
     <string name="duress_unlock_type_changed">Your screen lock is now a %1$s, but the second one still has the old type. It does not open the profile until you change it.</string>
+    <string name="duress_unlock_length_changed">Auto confirm unlock is on and the second %1$s has another length than your screen lock, so it can no longer be entered. Change it to the length of your screen lock.</string>
     <string name="duress_unlock_noun_pin">PIN</string>
     <string name="duress_unlock_noun_password">password</string>
     <string name="duress_unlock_action_setup">Set up Duress Unlock</string>
diff --git a/src/com/android/settings/security/DuressUnlockFingerActivity.java b/src/com/android/settings/security/DuressUnlockFingerActivity.java
index 84a1add8c79..10e9c858d19 100644
--- a/src/com/android/settings/security/DuressUnlockFingerActivity.java
+++ b/src/com/android/settings/security/DuressUnlockFingerActivity.java
@@ -71,6 +71,13 @@ public class DuressUnlockFingerActivity extends DuressPasswordActivity
     @Override
     protected void onDestroy() {
         super.onDestroy();
+        // A screen that is really gone drops its copy of the owner credential, after the queued
+        // work that uses it (the single thread runs the tasks in order).
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        if (!isChangingConfigurations() && owner != null) {
+            executor.execute(owner::zeroize);
+        }
         executor.shutdown();
     }
 
