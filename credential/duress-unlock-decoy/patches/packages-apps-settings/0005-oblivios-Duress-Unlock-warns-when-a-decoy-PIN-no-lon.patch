@@ -140,6 +140,13 @@ public class DuressUnlockSetupActivity extends DuressPasswordActivity
     @Override
     protected void onDestroy() {
         super.onDestroy();
+        // A screen that is really gone drops its copy of the owner credential, after the queued
+        // work that uses it (the single thread runs the tasks in order).
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        if (!isChangingConfigurations() && owner != null) {
+            executor.execute(owner::zeroize);
+        }
         executor.shutdown();
     }
 
