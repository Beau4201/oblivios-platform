@@ -33,8 +34,6 @@ import static java.util.Objects.requireNonNull;
 public class DuressUnlockMainActivity extends DuressPasswordActivity
         implements RecyclerItemAdapter.OnItemSelectedListener {
     private static final String TAG = DuressUnlockMainActivity.class.getSimpleName();
-    private static final String KEY_USER_CREDENTIAL = "user_credential";
-    private static final String KEY_HAS_ASKED_FOR_USER_CREDENTIALS = "asked_for_user_credentials";
 
     static final int REQ_CODE_OBTAIN_USER_CREDENTIALS = 1;
     static final int REQ_CODE_SETUP = 2;
@@ -66,27 +65,34 @@ public class DuressUnlockMainActivity extends DuressPasswordActivity
 
         setContentView(layout);
 
-        if (savedInstanceState != null) {
-            userCredential = savedInstanceState.getParcelable(KEY_USER_CREDENTIAL, LockscreenCredential.class);
-            askedForUserCredentials = savedInstanceState.getBoolean(KEY_HAS_ASKED_FOR_USER_CREDENTIALS);
+        // The owner credential survives a configuration change in memory only (see
+        // onRetainNonConfigurationInstance), never in the saved instance state; after a process
+        // death the screen asks for it again.
+        final Object retained = getLastNonConfigurationInstance();
+        if (retained instanceof LockscreenCredential) {
+            userCredential = (LockscreenCredential) retained;
         }
     }
 
     @Override
-    protected boolean hasUserCredential() {
-        return userCredential != null && !userCredential.isNone();
+    public Object onRetainNonConfigurationInstance() {
+        return userCredential;
     }
 
     @Override
-    protected void onSaveInstanceState(Bundle outState) {
-        super.onSaveInstanceState(outState);
-        outState.putParcelable(KEY_USER_CREDENTIAL, userCredential);
-        outState.putBoolean(KEY_HAS_ASKED_FOR_USER_CREDENTIALS, askedForUserCredentials);
+    protected boolean hasUserCredential() {
+        return userCredential != null && !userCredential.isNone();
     }
 
     @Override
     protected void onDestroy() {
         super.onDestroy();
+        // A screen that is really gone drops the owner credential, after the queued work that
+        // uses it (the single thread runs the tasks in order); one that only restarts keeps it.
+        final LockscreenCredential credential = userCredential;
+        if (!isChangingConfigurations() && credential != null) {
+            executor.execute(credential::zeroize);
+        }
         executor.shutdown();
     }
 
@@ -161,6 +167,8 @@ public class DuressUnlockMainActivity extends DuressPasswordActivity
             if (new DuressUnlockFlow<>(ops).hasDecoy()) {
                 if (decoyTypeDiffers(ops)) {
                     layout.setDescriptionText(getString(R.string.duress_unlock_type_changed, noun));
+                } else if (decoyLengthDiffers(ops)) {
+                    layout.setDescriptionText(getString(R.string.duress_unlock_length_changed, noun));
                 }
                 g.addChild(createItem(R.string.duress_unlock_action_change, R.drawable.ic_edit));
                 g.addChild(createItem(R.string.duress_unlock_action_finger,
@@ -195,6 +203,27 @@ public class DuressUnlockMainActivity extends DuressPasswordActivity
                 || decoyType == LockPatternUtils.CREDENTIAL_TYPE_PASSWORD) && decoyType != ownerType;
     }
 
+    /**
+     * True when Auto confirm unlock is on and the decoy's PIN has another length than the owner's:
+     * the keyguard submits at the owner's length and hides Enter, so the decoy PIN is never
+     * submitted. The set-up refuses such a pair; this catches the one that a later change of the
+     * screen lock (Auto confirm turned on, a PIN of another length) makes.
+     */
+    private boolean decoyLengthDiffers(DuressUnlockOps ops) {
+        final LockPatternUtils utils = getLockPatternUtils();
+        if (!userCredential.isPin() || !utils.isAutoPinConfirmEnabled(UserHandle.USER_SYSTEM)) {
+            return false;
+        }
+        final int decoyUserId = ops.findDecoyUserId();
+        if (decoyUserId == DuressUnlockFlow.NO_USER
+                || utils.getCredentialTypeForUser(decoyUserId)
+                        != LockPatternUtils.CREDENTIAL_TYPE_PIN) {
+            return false;
+        }
+        final int decoyLength = utils.getPinLength(decoyUserId);
+        return decoyLength > 0 && decoyLength != userCredential.size();
+    }
+
     private Item createItem(@StringRes int title, @DrawableRes int icon) {
         var i = new Item();
         i.setId(title);
