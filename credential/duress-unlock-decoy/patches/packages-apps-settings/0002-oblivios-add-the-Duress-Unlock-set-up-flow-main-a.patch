+package com.android.settings.safetycenter.ui;
+
+import android.content.Context;
+import android.content.Intent;
+import android.text.TextUtils;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.ext.ExtSettingControllerHelper;
+import com.android.settings.security.DuressUnlockMainActivity;
+
+/**
+ * ObliviOS: the Duress Unlock row on the Device unlock page. Available for the system user
+ * only, exactly like the Duress password row, so a Duress Unlock decoy session never shows it
+ * and search never offers it there.
+ */
+public class DuressUnlockPrefController extends BasePreferenceController {
+
+    public DuressUnlockPrefController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return ExtSettingControllerHelper.getGlobalSettingAvailability(mContext);
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return super.handlePreferenceTreeClick(preference);
+        }
+        mContext.startActivity(new Intent(mContext, DuressUnlockMainActivity.class));
+        return true;
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockFlow.java b/src/com/android/settings/security/DuressUnlockFlow.java
new file mode 100644
index 0000000..ef9fe9b
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockFlow.java
@@ -0,0 +1,110 @@
+package com.android.settings.security;
+
+/**
+ * ObliviOS: the order of the Duress Unlock set-up, change and remove operations, free of
+ * Android types so it can be tested on the JVM. {@code C} is the credential type
+ * (LockscreenCredential in the app). See
+ * docs/superpowers/specs/2026-10-07-duress-unlock-settings-ui-design.md in the
+ * oblivios-foundation repository, section 3.
+ */
+final class DuressUnlockFlow<C> {
+    static final int NO_USER = -1;
+
+    /** The current decoy PIN given to {@link Ops#setDecoyPin} was wrong. */
+    static final class WrongCurrentPinException extends Exception {
+        WrongCurrentPinException() {
+            super("current decoy PIN is wrong");
+        }
+    }
+
+    interface Ops<C> {
+        /** The id of the live decoy-type user, or {@link #NO_USER}. */
+        int findDecoyUserId();
+
+        int createDecoyUser() throws Exception;
+
+        /** Starts the user in the background and returns once its storage is unlocked. */
+        void startDecoyUnlocked(int userId) throws Exception;
+
+        /**
+         * Sets the user's PIN. {@code current} is null while the user has no credential yet.
+         *
+         * @throws WrongCurrentPinException if {@code current} does not match
+         */
+        void setDecoyPin(int userId, C current, C newPin) throws Exception;
+
+        void stopDecoy(int userId) throws Exception;
+
+        void register(int userId) throws Exception;
+
+        /** Clears the registration; must succeed when nothing is registered. */
+        void unregister() throws Exception;
+
+        void removeUser(int userId) throws Exception;
+    }
+
+    private final Ops<C> ops;
+
+    DuressUnlockFlow(Ops<C> ops) {
+        this.ops = ops;
+    }
+
+    boolean hasDecoy() {
+        return ops.findDecoyUserId() != NO_USER;
+    }
+
+    /**
+     * Creates the decoy, gives it {@code pin} and registers it. Registering is the last step; any
+     * failure removes the registration and the user again, so no half set-up state is left.
+     */
+    void setUp(C pin) throws Exception {
+        if (hasDecoy()) {
+            throw new IllegalStateException("a decoy already exists");
+        }
+        final int userId = ops.createDecoyUser();
+        try {
+            ops.startDecoyUnlocked(userId);
+            ops.setDecoyPin(userId, null, pin);
+            ops.stopDecoy(userId);
+            ops.register(userId);
+        } catch (Exception e) {
+            try {
+                ops.unregister();
+            } catch (Exception suppressed) {
+                e.addSuppressed(suppressed);
+            }
+            try {
+                ops.removeUser(userId);
+            } catch (Exception suppressed) {
+                e.addSuppressed(suppressed);
+            }
+            throw e;
+        }
+    }
+
+    /**
+     * Replaces the decoy's PIN and registers it again, which is a no-op for a registered decoy and
+     * completes an interrupted set-up. A wrong {@code current} changes nothing.
+     */
+    void changePin(C current, C newPin) throws Exception {
+        final int userId = ops.findDecoyUserId();
+        if (userId == NO_USER) {
+            throw new IllegalStateException("no decoy exists");
+        }
+        ops.setDecoyPin(userId, current, newPin);
+        ops.register(userId);
+    }
+
+    /**
+     * Clears the registration first, then removes the user. Never the other way round: a
+     * registration that outlives its user crashed SystemUI once (frameworks-base 0011). If
+     * clearing fails the user is kept.
+     */
+    void remove() throws Exception {
+        final int userId = ops.findDecoyUserId();
+        ops.unregister();
+        if (userId != NO_USER) {
+            ops.removeUser(userId);
+        }
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockMainActivity.java b/src/com/android/settings/security/DuressUnlockMainActivity.java
new file mode 100644
index 0000000..91fd5f9
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockMainActivity.java
@@ -0,0 +1,231 @@
+package com.android.settings.security;
+
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.os.Bundle;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.Nullable;
+import androidx.annotation.StringRes;
+
+import com.android.internal.widget.LockscreenCredential;
+import com.android.settings.R;
+import com.android.settings.password.ChooseLockSettingsHelper;
+import com.google.android.setupdesign.GlifRecyclerLayout;
+import com.google.android.setupdesign.items.IItem;
+import com.google.android.setupdesign.items.Item;
+import com.google.android.setupdesign.items.ItemGroup;
+import com.google.android.setupdesign.items.RecyclerItemAdapter;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+import static java.util.Objects.requireNonNull;
+
+/**
+ * ObliviOS: main Duress Unlock screen. Confirms the owner credential, then lists the actions
+ * for the current state. Same structure as {@link DuressPasswordMainActivity}. Only the system
+ * user can open it, so a Duress Unlock decoy session cannot.
+ */
+public class DuressUnlockMainActivity extends DuressPasswordActivity
+        implements RecyclerItemAdapter.OnItemSelectedListener {
+    private static final String TAG = DuressUnlockMainActivity.class.getSimpleName();
+    private static final String KEY_USER_CREDENTIAL = "user_credential";
+    private static final String KEY_HAS_ASKED_FOR_USER_CREDENTIALS = "asked_for_user_credentials";
+
+    static final int REQ_CODE_OBTAIN_USER_CREDENTIALS = 1;
+    static final int REQ_CODE_SETUP = 2;
+
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private GlifRecyclerLayout layout;
+    private LockscreenCredential userCredential;
+    private boolean askedForUserCredentials;
+    private boolean removing;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!getUser().isSystem()) {
+            finish();
+            return;
+        }
+
+        var layout = new GlifRecyclerLayout(this);
+        this.layout = layout;
+        layout.setIcon(getDrawable(R.drawable.ic_lock));
+        layout.setHeaderText(R.string.duress_unlock_title);
+        adjustDescriptionStyle(layout);
+        layout.setDescriptionText(R.string.duress_unlock_description);
+
+        setContentView(layout);
+
+        if (savedInstanceState != null) {
+            userCredential = savedInstanceState.getParcelable(KEY_USER_CREDENTIAL, LockscreenCredential.class);
+            askedForUserCredentials = savedInstanceState.getBoolean(KEY_HAS_ASKED_FOR_USER_CREDENTIALS);
+        }
+    }
+
+    @Override
+    protected boolean hasUserCredential() {
+        return userCredential != null && !userCredential.isNone();
+    }
+
+    @Override
+    protected void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        outState.putParcelable(KEY_USER_CREDENTIAL, userCredential);
+        outState.putBoolean(KEY_HAS_ASKED_FOR_USER_CREDENTIALS, askedForUserCredentials);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        executor.shutdown();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        if (isFinishing()) {
+            return;
+        }
+
+        if (userCredential == null) {
+            if (!getLockPatternUtils().isSecure(getUserId())) {
+                userCredential = LockscreenCredential.createNone();
+            } else if (!askedForUserCredentials) {
+                var b = new ChooseLockSettingsHelper.Builder(this);
+                b.setRequestCode(REQ_CODE_OBTAIN_USER_CREDENTIALS);
+                b.setReturnCredentials(true);
+                b.setForegroundOnly(true);
+                b.show();
+                askedForUserCredentials = true;
+            }
+        }
+
+        updateActionList();
+    }
+
+    private DuressUnlockOps newOps() {
+        return new DuressUnlockOps(getApplicationContext(), getLockPatternUtils(), userCredential);
+    }
+
+    private void updateActionList() {
+        if (userCredential == null) {
+            Log.d(TAG, "no userCredential, skipping updateActionList");
+            return;
+        }
+
+        var g = new ItemGroup();
+        if (userCredential.isPin()) {
+            layout.setDescriptionText(R.string.duress_unlock_description);
+            if (new DuressUnlockFlow<>(newOps()).hasDecoy()) {
+                g.addChild(createItem(R.string.duress_unlock_action_change, R.drawable.ic_edit));
+                g.addChild(createItem(R.string.duress_unlock_action_remove, R.drawable.ic_delete));
+            } else {
+                g.addChild(createItem(R.string.duress_unlock_action_setup, R.drawable.ic_add_24dp));
+            }
+        } else {
+            // A password, a pattern or no lock: Duress Unlock supports only a PIN for now.
+            layout.setDescriptionText(R.string.duress_unlock_needs_pin);
+        }
+
+        var adapter = new RecyclerItemAdapter(g);
+        adapter.setOnItemSelectedListener(this);
+        layout.setAdapter(adapter);
+    }
+
+    private Item createItem(@StringRes int title, @DrawableRes int icon) {
+        var i = new Item();
+        i.setId(title);
+        i.setTitle(getText(title));
+        i.setIcon(getDrawable(icon));
+        return i;
+    }
+
+    // RecyclerItemAdapter.OnItemSelectedListener
+    @Override
+    public void onItemSelected(IItem iitem) {
+        if (removing) {
+            return;
+        }
+        int id = ((Item) iitem).getId();
+
+        if (id == R.string.duress_unlock_action_setup || id == R.string.duress_unlock_action_change) {
+            var i = new Intent(this, DuressUnlockSetupActivity.class);
+            i.putExtra(DuressUnlockSetupActivity.EXTRA_USER_CREDENTIAL, userCredential);
+            i.putExtra(DuressUnlockSetupActivity.EXTRA_CHANGE,
+                    id == R.string.duress_unlock_action_change);
+            allowNextOnStop = true;
+            startActivityForResult(i, REQ_CODE_SETUP);
+        } else if (id == R.string.duress_unlock_action_remove) {
+            var b = new AlertDialog.Builder(this);
+            b.setTitle(R.string.duress_unlock_remove_title);
+            b.setMessage(R.string.duress_unlock_remove_message);
+            b.setNegativeButton(R.string.duress_pwd_cancel_button, null);
+            b.setPositiveButton(R.string.duress_unlock_remove_button, (dialog, which) -> remove());
+            b.show();
+        }
+    }
+
+    private void remove() {
+        removing = true;
+        final DuressUnlockOps ops = newOps();
+        executor.execute(() -> {
+            Exception failure = null;
+            try {
+                new DuressUnlockFlow<>(ops).remove();
+            } catch (Exception e) {
+                Log.e(TAG, "remove failed", e);
+                failure = e;
+            }
+            final Exception f = failure;
+            runOnUiThread(() -> {
+                removing = false;
+                if (isFinishing() || isDestroyed()) {
+                    // The screen is gone: a toast is the only way left to report the outcome.
+                    Toast.makeText(getApplicationContext(),
+                            f == null ? getString(R.string.duress_unlock_toast_removed)
+                                    : getString(R.string.duress_unlock_remove_error, f.toString()),
+                            Toast.LENGTH_LONG).show();
+                    return;
+                }
+                if (f == null) {
+                    Toast.makeText(this, R.string.duress_unlock_toast_removed, Toast.LENGTH_LONG).show();
+                } else {
+                    var d = new AlertDialog.Builder(this);
+                    d.setMessage(getString(R.string.duress_unlock_remove_error, f.toString()));
+                    d.setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null);
+                    d.show();
+                }
+                updateActionList();
+            });
+        });
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (requestCode == REQ_CODE_SETUP) {
+            if (resultCode == RESULT_CANCELED) {
+                finish();
+            }
+            return;
+        }
+
+        if (requestCode != REQ_CODE_OBTAIN_USER_CREDENTIALS) {
+            throw new IllegalStateException(Integer.toString(resultCode));
+        }
+
+        if (resultCode != RESULT_OK) {
+            finish();
+            return;
+        }
+
+        requireNonNull(data, "data");
+        var credential = data.getParcelableExtra(ChooseLockSettingsHelper.EXTRA_KEY_PASSWORD, LockscreenCredential.class);
+        requireNonNull(credential, "no returned credential");
+        userCredential = credential;
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockOps.java b/src/com/android/settings/security/DuressUnlockOps.java
new file mode 100644
index 0000000..9d9f069
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockOps.java
@@ -0,0 +1,125 @@
+package com.android.settings.security;
+
+import android.app.ActivityManager;
+import android.content.Context;
+import android.content.pm.UserInfo;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.os.UserManager;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+
+import java.util.concurrent.TimeoutException;
+
+/**
+ * ObliviOS: the Android side of {@link DuressUnlockFlow}. Must run off the main thread: it
+ * waits for the decoy's storage to unlock. It never passes a candidate PIN to checkCredential,
+ * which would run the wipe hook and decoy routing on it.
+ */
+final class DuressUnlockOps implements DuressUnlockFlow.Ops<LockscreenCredential> {
+    /** A new user's first start prepares its storage; the decoy design pays that cost here. */
+    private static final long UNLOCK_TIMEOUT_MS = 120_000;
+    private static final long UNLOCK_POLL_MS = 500;
+
+    private final UserManager userManager;
+    private final LockPatternUtils lockPatternUtils;
+    private final LockscreenCredential ownerCredential;
+
+    DuressUnlockOps(Context context, LockPatternUtils lockPatternUtils,
+            LockscreenCredential ownerCredential) {
+        this.userManager = context.getSystemService(UserManager.class);
+        this.lockPatternUtils = lockPatternUtils;
+        this.ownerCredential = ownerCredential;
+    }
+
+    @Override
+    public int findDecoyUserId() {
+        // getAliveUsers: a user being removed must not count as a decoy
+        for (UserInfo info : userManager.getAliveUsers()) {
+            if (UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY.equals(info.userType)) {
+                return info.id;
+            }
+        }
+        return DuressUnlockFlow.NO_USER;
+    }
+
+    @Override
+    public int createDecoyUser() {
+        UserInfo info = userManager.createUser(null, UserManager.USER_TYPE_FULL_OBLIVIOS_DECOY, 0);
+        if (info == null) {
+            throw new IllegalStateException("the decoy user could not be created");
+        }
+        return info.id;
+    }
+
+    @Override
+    public void startDecoyUnlocked(int userId) throws Exception {
+        try {
+            if (!ActivityManager.getService().startUserInBackground(userId)) {
+                throw new IllegalStateException("the decoy user did not start");
+            }
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+        // A new user has no credential, so its storage unlocks at its first start.
+        final long deadline = SystemClock.elapsedRealtime() + UNLOCK_TIMEOUT_MS;
+        while (!userManager.isUserUnlocked(userId)) {
+            if (SystemClock.elapsedRealtime() > deadline) {
+                throw new TimeoutException("the decoy storage did not unlock");
+            }
+            Thread.sleep(UNLOCK_POLL_MS);
+        }
+    }
+
+    @Override
+    public void setDecoyPin(int userId, LockscreenCredential current,
+            LockscreenCredential newPin) throws Exception {
+        final LockscreenCredential saved =
+                current != null ? current : LockscreenCredential.createNone();
+        try {
+            // setLockCredential checks the old credential itself, without the wipe hook or
+            // decoy routing, so a wrong current PIN is refused with no side effect.
+            if (!lockPatternUtils.setLockCredential(newPin, saved, userId)) {
+                if (current != null) {
+                    throw new DuressUnlockFlow.WrongCurrentPinException();
+                }
+                throw new IllegalStateException("the decoy PIN could not be set");
+            }
+        } finally {
+            if (current == null) {
+                saved.zeroize();
+            }
+        }
+    }
+
+    @Override
+    public void stopDecoy(int userId) {
+        try {
+            // Delayed locking keeps the decoy's storage key, as the user switch design expects.
+            final int result = ActivityManager.getService().stopUserWithDelayedLocking(userId, null);
+            if (result != ActivityManager.USER_OP_SUCCESS) {
+                throw new IllegalStateException("the decoy user did not stop: " + result);
+            }
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    @Override
+    public void register(int userId) {
+        lockPatternUtils.setDecoyProfile(ownerCredential, userId);
+    }
+
+    @Override
+    public void unregister() {
+        lockPatternUtils.clearDecoyProfile(ownerCredential);
+    }
+
+    @Override
+    public void removeUser(int userId) {
+        if (!userManager.removeUser(userId)) {
+            throw new IllegalStateException("the decoy user could not be removed");
+        }
+    }
+}
diff --git a/src/com/android/settings/security/DuressUnlockSetupActivity.java b/src/com/android/settings/security/DuressUnlockSetupActivity.java
new file mode 100644
index 0000000..a775c77
--- /dev/null
+++ b/src/com/android/settings/security/DuressUnlockSetupActivity.java
@@ -0,0 +1,288 @@
+package com.android.settings.security;
+
+import android.app.AlertDialog;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.view.inputmethod.EditorInfo;
+import android.widget.EditText;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.internal.widget.PasswordValidationError;
+import com.android.settings.R;
+import com.android.settings.password.ChooseLockPassword;
+import com.android.settings.password.ChooseLockPassword.ChooseLockPasswordFragment.PasswordValidationErrorConverter;
+import com.google.android.setupcompat.template.FooterBarMixin;
+import com.google.android.setupcompat.template.FooterButton;
+import com.google.android.setupdesign.GlifLayout;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * ObliviOS: set up or change the Duress Unlock second PIN. The work after the checks runs on a
+ * worker thread that does not depend on this activity. While it runs the screen is kept on and
+ * the base class does not cancel on stop, so the process stays in the foreground; an interrupted
+ * set-up (a process kill) leaves a decoy user that the main screen's Change PIN or Remove repairs.
+ */
+public class DuressUnlockSetupActivity extends DuressPasswordActivity
+        implements TextView.OnEditorActionListener {
+    static final String TAG = DuressUnlockSetupActivity.class.getSimpleName();
+    static final String EXTRA_USER_CREDENTIAL = "user_credential";
+    static final String EXTRA_CHANGE = "change";
+
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private boolean isChange;
+    private boolean needsCurrent;
+    private boolean working;
+    private GlifLayout layout;
+    private EditText currentInput;
+    private EditText pinInput;
+    private EditText confirmInput;
+    private View form;
+    private View progress;
+    private FooterButton primaryButton;
+    private FooterButton secondaryButton;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!getUser().isSystem()) {
+            finish();
+            return;
+        }
+
+        setContentView(R.layout.duress_unlock_setup);
+
+        isChange = getIntent().getBooleanExtra(EXTRA_CHANGE, false);
+        // A decoy left without a credential by an interrupted set-up has no current PIN to ask for.
+        needsCurrent = isChange && decoyHasCredential();
+        layout = requireViewById(R.id.glif_layout);
+        form = requireViewById(R.id.duress_unlock_form);
+        progress = requireViewById(R.id.duress_unlock_progress);
+        currentInput = requireViewById(R.id.duress_unlock_current_pin);
+        pinInput = requireViewById(R.id.duress_unlock_pin);
+        confirmInput = requireViewById(R.id.duress_unlock_pin_confirmation);
+
+        layout.setHeaderText(isChange
+                ? R.string.duress_unlock_change_title : R.string.duress_unlock_setup_title);
+        adjustDescriptionStyle(layout);
+        if (needsCurrent) {
+            currentInput.setVisibility(View.VISIBLE);
+        }
+        if (isChange) {
+            pinInput.setHint(R.string.duress_unlock_hint_new_change);
+            confirmInput.setHint(R.string.duress_unlock_hint_confirm_change);
+        }
+
+        FooterBarMixin footerBar = layout.getMixin(FooterBarMixin.class);
+        {
+            var b = new FooterButton.Builder(this);
+            b.setText(isChange
+                    ? R.string.duress_unlock_button_change : R.string.duress_unlock_button_setup);
+            b.setButtonType(FooterButton.ButtonType.DONE);
+            b.setListener(v -> save());
+            b.setTheme(com.google.android.setupdesign.R.style.SudGlifButton_Primary);
+            primaryButton = b.build();
+            footerBar.setPrimaryButton(primaryButton);
+        }
+        {
+            var b = new FooterButton.Builder(this);
+            b.setText(R.string.duress_pwd_cancel_button);
+            b.setButtonType(FooterButton.ButtonType.CANCEL);
+            b.setListener(v -> finish());
+            b.setTheme(com.google.android.setupdesign.R.style.SudGlifButton_Secondary);
+            secondaryButton = b.build();
+            footerBar.setSecondaryButton(secondaryButton);
+        }
+        confirmInput.setOnEditorActionListener(this);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        executor.shutdown();
+    }
+
+    // Do not cancel on stop while the work runs: the process must not become a cached one.
+    @Override
+    protected boolean hasUserCredential() {
+        return !working;
+    }
+
+    private boolean decoyHasCredential() {
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        Objects.requireNonNull(owner, EXTRA_USER_CREDENTIAL);
+        final LockPatternUtils lockPatternUtils = getLockPatternUtils();
+        final int userId =
+                new DuressUnlockOps(getApplicationContext(), lockPatternUtils, owner)
+                        .findDecoyUserId();
+        return userId == DuressUnlockFlow.NO_USER || lockPatternUtils.isSecure(userId);
+    }
+
+    // TextView.OnEditorActionListener
+    @Override
+    public boolean onEditorAction(TextView v, int actionId, KeyEvent event) {
+        if (actionId != EditorInfo.IME_ACTION_DONE) {
+            return false;
+        }
+        save();
+        return true;
+    }
+
+    private void save() {
+        if (working) {
+            return;
+        }
+        final LockscreenCredential owner =
+                getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL, LockscreenCredential.class);
+        Objects.requireNonNull(owner, EXTRA_USER_CREDENTIAL);
+
+        final LockscreenCredential pin = LockscreenCredential.createPin(pinInput.getText().toString());
+        boolean ok = checkPin(pin, owner);
+        ok &= checkConfirmation();
+        if (needsCurrent) {
+            ok &= checkCurrentPresent();
+        }
+        if (!ok) {
+            pin.zeroize();
+            return;
+        }
+        final LockscreenCredential current = needsCurrent
+                ? LockscreenCredential.createPin(currentInput.getText().toString()) : null;
+
+        showWorking();
+        final LockPatternUtils lockPatternUtils = getLockPatternUtils();
+        final DuressUnlockOps ops =
+                new DuressUnlockOps(getApplicationContext(), lockPatternUtils, owner);
+        final boolean change = isChange;
+        executor.execute(() -> {
+            boolean sameAsWipe = false;
+            boolean wrongCurrent = false;
+            Exception failure = null;
+            try {
+                // Slow (a key stretch) and the answer is the owner's own: run it here, not on the
+                // main thread, and never through checkCredential.
+                if (lockPatternUtils.isDuressWipeCredential(owner, pin)) {
+                    sameAsWipe = true;
+                } else if (change) {
+                    new DuressUnlockFlow<>(ops).changePin(current, pin);
+                } else {
+                    new DuressUnlockFlow<>(ops).setUp(pin);
+                }
+            } catch (DuressUnlockFlow.WrongCurrentPinException e) {
+                wrongCurrent = true;
+            } catch (Exception e) {
+                Log.e(TAG, "Duress Unlock save failed", e);
+                failure = e;
+            } finally {
+                pin.zeroize();
+                if (current != null) {
+                    current.zeroize();
+                }
+            }
+            final boolean fSameAsWipe = sameAsWipe;
+            final boolean fWrongCurrent = wrongCurrent;
+            final Exception fFailure = failure;
+            runOnUiThread(() -> onWorkDone(change, fSameAsWipe, fWrongCurrent, fFailure));
+        });
+    }
+
+    private void onWorkDone(boolean change, boolean sameAsWipe, boolean wrongCurrent,
+            @Nullable Exception failure) {
+        if (failure == null && !sameAsWipe && !wrongCurrent) {
+            // The application context: this activity may be gone by now.
+            Toast.makeText(getApplicationContext(),
+                    change ? R.string.duress_unlock_toast_changed : R.string.duress_unlock_toast_set_up,
+                    Toast.LENGTH_LONG).show();
+            if (!isDestroyed()) {
+                finish();
+            }
+            return;
+        }
+        if (isDestroyed()) {
+            // The screen is gone (for example the screen was turned off): say so, there is no
+            // other way to learn that the work failed.
+            if (failure != null) {
+                Toast.makeText(getApplicationContext(),
+                        getString(R.string.duress_unlock_save_error, failure.toString()),
+                        Toast.LENGTH_LONG).show();
+            }
+            return;
+        }
+        showForm();
+        if (sameAsWipe) {
+            pinInput.setError(getText(R.string.duress_unlock_error_same_as_wipe));
+        } else if (wrongCurrent) {
+            currentInput.setError(getText(R.string.duress_unlock_error_wrong_current));
+        } else {
+            var d = new AlertDialog.Builder(this);
+            d.setMessage(getString(R.string.duress_unlock_save_error, failure.toString()));
+            d.setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null);
+            d.show();
+        }
+    }
+
+    private void showWorking() {
+        working = true;
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        layout.setHeaderText(R.string.duress_unlock_working_title);
+        form.setVisibility(View.GONE);
+        progress.setVisibility(View.VISIBLE);
+        primaryButton.setEnabled(false);
+        secondaryButton.setEnabled(false);
+    }
+
+    private void showForm() {
+        working = false;
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        layout.setHeaderText(isChange
+                ? R.string.duress_unlock_change_title : R.string.duress_unlock_setup_title);
+        progress.setVisibility(View.GONE);
+        form.setVisibility(View.VISIBLE);
+        primaryButton.setEnabled(true);
+        secondaryButton.setEnabled(true);
+    }
+
+    private boolean checkPin(LockscreenCredential candidate, LockscreenCredential owner) {
+        List<PasswordValidationError> errors = LockPatternUtils.validateDuressCredential(candidate);
+        CharSequence error = null;
+        if (!errors.isEmpty()) {
+            var converter = new PasswordValidationErrorConverter(this, candidate.isPassword(),
+                    ChooseLockPassword.ChooseLockPasswordFragment.ProfileType.None, errors);
+            error = String.join("\n", converter.convertErrorCodeToMessages());
+        } else if (candidate.equals(owner)) {
+            error = getText(R.string.duress_unlock_error_same_as_lock);
+        } else if (getLockPatternUtils().isAutoPinConfirmEnabled(UserHandle.USER_SYSTEM)
+                && candidate.size() != owner.size()) {
+            // The keyguard submits at the owner's PIN length and hides Enter; a decoy PIN of
+            // another length would never be submitted whole.
+            error = getText(R.string.duress_unlock_error_length_auto_confirm);
+        }
+        pinInput.setError(error);
+        return error == null;
+    }
+
+    private boolean checkConfirmation() {
+        boolean same = pinInput.getText().toString().equals(confirmInput.getText().toString());
+        confirmInput.setError(same ? null : getText(R.string.lockpassword_confirm_pins_dont_match));
+        return same;
+    }
+
+    private boolean checkCurrentPresent() {
+        boolean present = currentInput.getText().length() > 0;
+        currentInput.setError(present ? null : getText(R.string.duress_unlock_error_wrong_current));
+        return present;
+    }
+}
diff --git a/tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java b/tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java
new file mode 100644
index 0000000..875db68
--- /dev/null
+++ b/tests/robotests/src/com/android/settings/security/DuressUnlockFlowTest.java
@@ -0,0 +1,224 @@
+package com.android.settings.security;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public class DuressUnlockFlowTest {
+    private static class FakeOps implements DuressUnlockFlow.Ops<String> {
+        final List<String> calls = new ArrayList<>();
+        int userId = DuressUnlockFlow.NO_USER;
+        String failAt;
+        String pinOfUser;
+
+        private void step(String name) throws Exception {
+            calls.add(name);
+            if (name.equals(failAt)) {
+                throw new Exception("fail " + name);
+            }
+        }
+
+        @Override public int findDecoyUserId() { return userId; }
+        @Override public int createDecoyUser() throws Exception {
+            step("create");
+            userId = 10;
+            return 10;
+        }
+        @Override public void startDecoyUnlocked(int id) throws Exception { step("start"); }
+        @Override public void setDecoyPin(int id, String current, String newPin) throws Exception {
+            calls.add("setPin(" + current + "," + newPin + ")");
+            if ("setPin".equals(failAt)) throw new Exception("fail setPin");
+            if (!java.util.Objects.equals(current, pinOfUser)) {
+                throw new DuressUnlockFlow.WrongCurrentPinException();
+            }
+            pinOfUser = newPin;
+        }
+        @Override public void stopDecoy(int id) throws Exception { step("stop"); }
+        @Override public void register(int id) throws Exception { step("register"); }
+        @Override public void unregister() throws Exception { step("unregister"); }
+        @Override public void removeUser(int id) throws Exception {
+            step("remove");
+            userId = DuressUnlockFlow.NO_USER;
+        }
+    }
+
+    @Test
+    public void setUpRunsTheStepsInOrderAndRegistersLast() throws Exception {
+        FakeOps ops = new FakeOps();
+        new DuressUnlockFlow<>(ops).setUp("1234");
+        assertEquals(Arrays.asList("create", "start", "setPin(null,1234)", "stop", "register"),
+                ops.calls);
+        assertEquals("1234", ops.pinOfUser);
+    }
+
+    @Test
+    public void setUpRefusesWhenADecoyExists() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        try {
+            new DuressUnlockFlow<>(ops).setUp("1234");
+            fail();
+        } catch (IllegalStateException expected) {
+            assertTrue(ops.calls.isEmpty());
+        }
+    }
+
+    @Test
+    public void everyFailedSetUpStepUnregistersThenRemovesTheUser() throws Exception {
+        for (String failAt : new String[] {"start", "setPin", "stop", "register"}) {
+            FakeOps ops = new FakeOps();
+            ops.failAt = failAt;
+            try {
+                new DuressUnlockFlow<>(ops).setUp("1234");
+                fail(failAt);
+            } catch (Exception expected) {
+                assertEquals(failAt, "fail " + failAt, expected.getMessage());
+            }
+            int n = ops.calls.size();
+            assertEquals(failAt, Arrays.asList("unregister", "remove"),
+                    ops.calls.subList(n - 2, n));
+            assertEquals(failAt, DuressUnlockFlow.NO_USER, ops.userId);
+        }
+    }
+
+    @Test
+    public void aFailedCreateLeavesNothingToRollBack() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.failAt = "create";
+        try {
+            new DuressUnlockFlow<>(ops).setUp("1234");
+            fail();
+        } catch (Exception expected) {
+            assertEquals(Arrays.asList("create"), ops.calls);
+        }
+    }
+
+    @Test
+    public void aFailedRollbackStillRunsBothStepsAndKeepsTheFirstError() throws Exception {
+        FakeOps failing = new FakeOps() {
+            @Override public void register(int id) throws Exception { throw new Exception("first"); }
+            @Override public void unregister() throws Exception {
+                calls.add("unregister");
+                throw new Exception("second");
+            }
+        };
+        try {
+            new DuressUnlockFlow<>(failing).setUp("1234");
+            fail();
+        } catch (Exception e) {
+            assertEquals("first", e.getMessage());
+            assertEquals(1, e.getSuppressed().length);
+            assertEquals("remove", failing.calls.get(failing.calls.size() - 1));
+        }
+    }
+
+    @Test
+    public void changePinSetsThePinThenRegistersAgain() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.pinOfUser = "1234";
+        new DuressUnlockFlow<>(ops).changePin("1234", "5678");
+        assertEquals(Arrays.asList("setPin(1234,5678)", "register"), ops.calls);
+        assertEquals("5678", ops.pinOfUser);
+    }
+
+    @Test
+    public void aWrongCurrentPinChangesAndRemovesNothing() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.pinOfUser = "1234";
+        try {
+            new DuressUnlockFlow<>(ops).changePin("0000", "5678");
+            fail();
+        } catch (DuressUnlockFlow.WrongCurrentPinException expected) {
+            assertEquals(Arrays.asList("setPin(0000,5678)"), ops.calls);
+            assertEquals(10, ops.userId);
+        }
+    }
+
+    @Test
+    public void changePinWithoutADecoyFails() throws Exception {
+        FakeOps ops = new FakeOps();
+        try {
+            new DuressUnlockFlow<>(ops).changePin("1234", "5678");
+            fail();
+        } catch (IllegalStateException expected) {
+            assertTrue(ops.calls.isEmpty());
+        }
+    }
+
+    @Test
+    public void removeUnregistersBeforeItRemovesTheUser() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        new DuressUnlockFlow<>(ops).remove();
+        assertEquals(Arrays.asList("unregister", "remove"), ops.calls);
+    }
+
+    @Test
+    public void removeWithoutAUserStillClearsTheRegistration() throws Exception {
+        FakeOps ops = new FakeOps();
+        new DuressUnlockFlow<>(ops).remove();
+        assertEquals(Arrays.asList("unregister"), ops.calls);
+    }
+
+    @Test
+    public void aFailedUnregisterKeepsTheUser() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.failAt = "unregister";
+        try {
+            new DuressUnlockFlow<>(ops).remove();
+            fail();
+        } catch (Exception expected) {
+            assertEquals(Arrays.asList("unregister"), ops.calls);
+            assertEquals(10, ops.userId);
+        }
+    }
+
+    @Test
+    public void aFailedUserRemovalIsReportedAndTheRegistrationStaysCleared() throws Exception {
+        FakeOps ops = new FakeOps();
+        ops.userId = 10;
+        ops.failAt = "remove";
+        try {
+            new DuressUnlockFlow<>(ops).remove();
+            fail();
