From 885b048dd3c80cefb4e47dde2332abb058edad47 Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 3 Sep 2026 04:06:01 +0200
Subject: [PATCH] sovereignos: label the decoy's own row as Owner in Settings >
 Users

---
 src/com/android/settings/users/UserSettings.java | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/com/android/settings/users/UserSettings.java b/src/com/android/settings/users/UserSettings.java
index 6eee3513104..f6cf6a58136 100644
--- a/src/com/android/settings/users/UserSettings.java
+++ b/src/com/android/settings/users/UserSettings.java
@@ -1392,7 +1392,7 @@ public class UserSettings extends SettingsPreferenceFragment
             if (pref == null) {
                 continue;
             }
-            if (user.isMain()) {
+            if (user.isMain() || mUserManager.isMainForUiDisplay(user.id)) {
                 pref.setSummary(R.string.user_owner);
             } else if (user.isAdmin()) {
                 pref.setSummary(R.string.user_admin);
