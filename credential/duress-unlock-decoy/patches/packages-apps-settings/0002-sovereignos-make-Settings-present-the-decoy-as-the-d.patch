From dc789e4ae9655af8bc321ce40fbe0d8646fdaacf Mon Sep 17 00:00:00 2001
From: SovereignOS Build <build@sovereignos.local>
Date: Thu, 3 Sep 2026 04:06:01 +0200
Subject: [PATCH] sovereignos: make Settings present the decoy as the device
 owner

Squash of former patches:

- 0008 sovereignos: label the decoy's own row as Owner in Settings > Users
- 0009 sovereignos: show the owner's device-admin policy text to the decoy
- 0010 sovereignos: use owner's default-avatar color for a decoy's own icon
---
 .../specialaccess/deviceadmin/DeviceAdminAdd.java        | 3 ++-
 src/com/android/settings/users/UserSettings.java         | 9 +++++++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/com/android/settings/applications/specialaccess/deviceadmin/DeviceAdminAdd.java b/src/com/android/settings/applications/specialaccess/deviceadmin/DeviceAdminAdd.java
index ab1d73e..a351527 100644
--- a/src/com/android/settings/applications/specialaccess/deviceadmin/DeviceAdminAdd.java
+++ b/src/com/android/settings/applications/specialaccess/deviceadmin/DeviceAdminAdd.java
@@ -799,7 +799,8 @@ public class DeviceAdminAdd extends CollapsingToolbarBaseActivity {
 
     private void addDeviceAdminPolicies(boolean showDescription) {
         if (!mAdminPoliciesInitialized) {
-            boolean isAdminUser = UserManager.get(this).isAdminUser();
+            boolean isAdminUser = UserManager.get(this).isAdminUser()
+                    || UserManager.get(this).isMainForUiDisplay(UserHandle.myUserId());
             for (DeviceAdminInfo.PolicyInfo pi : mDeviceAdmin.getUsedPolicies()) {
                 int descriptionId = isAdminUser ? pi.description : pi.descriptionForSecondaryUsers;
                 int labelId = isAdminUser ? pi.label : pi.labelForSecondaryUsers;
diff --git a/src/com/android/settings/users/UserSettings.java b/src/com/android/settings/users/UserSettings.java
index 9b77594..95d4c31 100644
--- a/src/com/android/settings/users/UserSettings.java
+++ b/src/com/android/settings/users/UserSettings.java
@@ -1392,7 +1392,7 @@ public class UserSettings extends SettingsPreferenceFragment
             if (pref == null) {
                 continue;
             }
-            if (user.isMain()) {
+            if (user.isMain() || mUserManager.isMainForUiDisplay(user.id)) {
                 pref.setSummary(R.string.user_owner);
             } else if (user.isAdmin()) {
                 pref.setSummary(R.string.user_admin);
@@ -1968,7 +1968,12 @@ public class UserSettings extends SettingsPreferenceFragment
             return false;
         }
         UserManager um = (UserManager) context.getSystemService(Context.USER_SERVICE);
-        Bitmap bitmap = getDefaultUserIconAsBitmap(context.getResources(), userId);
+        // The default icon's color is picked from a fixed palette by userId, so a decoy's own
+        // arbitrary real userId would otherwise always produce a different color than what a
+        // genuine single, fresh-out-of-box owner (always userId 0) shows -- an identity tell
+        // independent of anything getUsersForUiDisplay/isMainForUiDisplay already hide.
+        int colorSourceUserId = um.isMainForUiDisplay(userId) ? UserHandle.USER_SYSTEM : userId;
+        Bitmap bitmap = getDefaultUserIconAsBitmap(context.getResources(), colorSourceUserId);
         um.setUserIcon(userId, bitmap);
 
         return true;
