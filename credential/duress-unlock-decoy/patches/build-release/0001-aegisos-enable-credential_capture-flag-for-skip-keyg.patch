From: AegisOS Build <build@aegisos.local>
Date: Fri, 28 Aug 2026 18:30:59 +0200
Subject: [PATCH] aegisos: enable credential_capture flag for
 skip-keyguard-when-switching-to-unlocked-users

---
 .../credential_capture_flag_values.textproto                | 6 ++++++
 1 file changed, 6 insertions(+)
 create mode 100644 aconfig/trunk_staging/android.multiuser/credential_capture_flag_values.textproto

diff --git a/aconfig/trunk_staging/android.multiuser/credential_capture_flag_values.textproto b/aconfig/trunk_staging/android.multiuser/credential_capture_flag_values.textproto
new file mode 100644
index 000000000..28a0d4cc5
--- /dev/null
+++ b/aconfig/trunk_staging/android.multiuser/credential_capture_flag_values.textproto
@@ -0,0 +1,6 @@
+flag_value {
+  package: "android.multiuser"
+  name: "credential_capture"
+  state: ENABLED
+  permission: READ_WRITE
+}
